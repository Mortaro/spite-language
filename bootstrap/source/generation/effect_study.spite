var shape = Analysis.AstShape()
var recorded: FunctionEffects? = null
var calls = List<EffectCall>()
var parameters = List<String>()
var local_sources = Dictionary<String>()
var local_classes = Dictionary<String>()
var local_elements = Dictionary<String>()
var local_types = Dictionary<String>()
var in_constructor = false
var class_name = ""
var table: CallEffects? = null

func EffectStudy(effects: FunctionEffects, studied_class: String, effects_table: CallEffects) {
    recorded = effects
    calls = effects.calls
    class_name = studied_class
    table = effects_table
}

func take_parameters(declared: List<Syntax.Statements.Parameter>) {
    var index = 0
    while index < declared.count() {
        var parameter = declared[index]
        parameters.append(parameter.name)
        crash table
        crash parameter.type_reference
        var parameter_class = table.type_class_name(parameter.type_reference, class_name)
        local_classes[parameter.name] = parameter_class
        local_types[parameter.name] = parameter_class
        var parameter_element = table.element_class_name(parameter.type_reference, class_name)
        local_elements[parameter.name] = parameter_element
        index = index + 1
    }
}

func study_block(statements: List<Syntax.Statements.Statement>) {
    statements.each(study_statement)
}

func study_statement(statement: Syntax.Statements.Statement) {
    switch statement {
        Syntax.Statements.VariableDeclaration: study_declaration(statement)
        Syntax.Statements.AssignmentStatement: study_assignment(statement)
        Syntax.Statements.IfStatement: {
            study_optional(statement.condition)
            study_block(statement.then_branch)
            study_block(statement.else_branch)
        }
        Syntax.Statements.WhileStatement: {
            study_optional(statement.condition)
            study_block(statement.body)
        }
        Syntax.Statements.SwitchStatement: {
            study_optional(statement.subject)
            statement.cases.each(study_case)
        }
        Syntax.Statements.AssertStatement: study_optional(statement.value)
        Syntax.Statements.ReturnStatement: {
            study_optional(statement.value)
            take_optional(statement.value)
        }
        Syntax.Statements.ExpressionStatement: study_optional(statement.value)
        _: return
    }
}

func study_case(switch_case: Syntax.Statements.SwitchCase) {
    study_block(switch_case.body)
}

func study_optional(expression: Syntax.Expressions.Expression?) {
    assert expression
    study_expression(expression)
}

func study_declaration(declaration: Syntax.Statements.VariableDeclaration) {
    crash declaration.value
    study_expression(declaration.value)
    take_value(declaration.value)
    var source = classify(declaration.value)
    local_sources[declaration.name] = source
    crash table
    var declared_class = table.declared_class_name(declaration, class_name)
    if declared_class.is_empty() {
        declared_class = returned_class(declaration.value)
    }
    local_classes[declaration.name] = declared_class
    var declared_element = table.declared_element_name(declaration, class_name)
    if declared_element.is_empty() {
        declared_element = literal_element(declaration.value)
    }
    local_elements[declaration.name] = declared_element
}

func literal_element(value: Syntax.Expressions.Expression): String {
    var listed = shape.as_list_literal(value)
    if not listed or listed.elements.is_empty() {
        return ""
    }
    crash listed.elements[0].value
    return owner_class(listed.elements[0].value)
}

func returned_class(value: Syntax.Expressions.Expression): String {
    var called = shape.as_call(value)
    if not called {
        return ""
    }
    crash called.callee
    var member = shape.as_member(called.callee)
    if not member {
        return ""
    }
    crash member.object
    var receiver_class = owner_class(member.object)
    crash table
    var found = table.return_classes["{receiver_class}#{member.name}"]
    if not found {
        return ""
    }
    return found
}

func study_assignment(assignment: Syntax.Statements.AssignmentStatement) {
    crash assignment.target
    crash assignment.value
    study_expression(assignment.target)
    study_expression(assignment.value)
    take_value(assignment.value)
    var target_name = shape.as_identifier(assignment.target)
    if target_name {
        if parameters.contains(target_name.name) or local_sources.has(target_name.name) {
            var source = classify(assignment.value)
            local_sources[target_name.name] = source
            return
        }
        assert not in_constructor
        add_key("field:{class_name}#{target_name.name}")
        add_release_key(class_name, target_name.name)
        return
    }
    if shape.as_index(assignment.target) {
        add_key("release")
    }
    var target_member = shape.as_member(assignment.target)
    assert target_member
    crash target_member.object
    var owner = owner_class(target_member.object)
    add_key("field:{owner}#{target_member.name}")
    add_release_key(owner, target_member.name)
    crash recorded
    recorded.member_writes.append("{owner}#{target_member.name}")
}

func study_expressions(expressions: List<Syntax.Expressions.Expression>) {
    expressions.each(study_expression)
}

func study_expression(expression: Syntax.Expressions.Expression) {
    switch expression {
        Syntax.Expressions.CallExpression: study_call(expression)
        Syntax.Expressions.GenericCallExpression: study_construction(expression)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            study_expression(expression.left)
            study_expression(expression.right)
        }
        Syntax.Expressions.UnaryExpression: study_optional(expression.operand)
        Syntax.Expressions.MemberExpression: {
            study_optional(expression.object)
            record_member_read(expression)
        }
        Syntax.Expressions.IndexExpression: {
            study_optional(expression.object)
            study_optional(expression.index)
        }
        Syntax.Expressions.ListLiteralExpression: expression.elements.each(study_element)
        Syntax.Expressions.ObjectLiteralExpression: expression.fields.each(study_field)
        _: return
    }
}

func record_member_read(member: Syntax.Expressions.MemberExpression) {
    crash member.object
    crash recorded
    var owner = owner_class(member.object)
    recorded.member_reads.append("{owner}#{member.name}")
}

func study_element(element: Syntax.Expressions.ListElement) {
    study_optional(element.value)
    take_optional(element.value)
}

func take_optional(expression: Syntax.Expressions.Expression?) {
    assert expression
    take_value(expression)
}

func take_value(expression: Syntax.Expressions.Expression) {
    crash recorded
    var identifier = shape.as_identifier(expression)
    if identifier {
        if not parameters.contains(identifier.name) and not local_sources.has(identifier.name) {
            recorded.taken.append("{class_name}#{identifier.name}")
        }
        return
    }
    var member = shape.as_member(expression)
    assert member
    crash member.object
    var owner = owner_class(member.object)
    recorded.taken.append("{owner}#{member.name}")
}

func study_field(field: Syntax.Expressions.ObjectField) {
    study_optional(field.value)
}

func study_construction(construction: Syntax.Expressions.GenericCallExpression) {
    crash construction.callee
    study_expressions(construction.arguments)
    construction.arguments.each(take_value)
    var argument_keys = classified(construction.arguments)
    crash table
    var constructed = table.class_identity(construction.callee, class_name)
    var constructor_name = called_name(construction.callee)
    var effect_call = EffectCall(constructed, constructor_name, argument_keys)
    calls.append(effect_call)
}

func study_call(call: Syntax.Expressions.CallExpression) {
    crash call.callee
    study_expressions(call.arguments)
    call.arguments.each(take_value)
    var argument_keys = classified(call.arguments)
    var callee_identifier = shape.as_identifier(call.callee)
    if callee_identifier {
        if parameters.contains(callee_identifier.name) or local_sources.has(callee_identifier.name) {
            add_key("field:*")
            add_key("shrink:*")
            add_key("grow:*")
            add_key("release")
            return
        }
        var callee_class = class_name
        crash table
        if table.names_a_class(callee_identifier.name) {
            callee_class = table.class_identity(call.callee, class_name)
        }
        var effect_call = EffectCall(callee_class, callee_identifier.name, argument_keys)
        calls.append(effect_call)
        return
    }
    var member = shape.as_member(call.callee)
    if member {
        study_method_call(member, call.callee, argument_keys)
        return
    }
    study_expression(call.callee)
    add_key("field:*")
    add_key("shrink:*")
    add_key("grow:*")
    add_key("release")
}

func study_method_call(
    member: Syntax.Expressions.MemberExpression,
    callee: Syntax.Expressions.Expression,
    argument_keys: List<String>,
) {
    crash member.object
    study_expression(member.object)
    if member.name == "call_function" {
        add_key("field:*")
        add_key("shrink:*")
        add_key("grow:*")
        add_key("release")
        return
    }
    if member.name == "release_value" {
        add_key("release")
    }
    if is_shrinking(member.name) {
        var shrunk = classify(member.object)
        add_key(shrunk)
    }
    if is_growing(member.name) {
        var grown = classify(member.object)
        var grown_key = growing_key(grown)
        add_key(grown_key)
    }
    if reads_allocator(member.object) {
        crash table
        var allocators = table.allocator_classes()
        var allocator_index = 0
        while allocator_index < allocators.count() {
            var allocator_call = EffectCall(allocators[allocator_index], member.name, argument_keys)
            calls.append(allocator_call)
            allocator_index = allocator_index + 1
        }
        return
    }
    var receiver_class = owner_class(member.object)
    crash table
    var constructs = table.names_a_class(member.name)
    if constructs {
        receiver_class = table.class_identity(callee, class_name)
    }
    var effect_call = EffectCall(receiver_class, member.name, argument_keys)
    if receiver_class == "*" and not constructs {
        mark_dispatch(effect_call, member.object)
    }
    calls.append(effect_call)
}

func reads_allocator(receiver: Syntax.Expressions.Expression): Boolean {
    var read = shape.as_member(receiver)
    if not read or read.name != "allocator" {
        return false
    }
    crash read.object
    var described = shape.as_member(read.object)
    if described {
        return described.name == "memory"
    }
    var own = shape.as_identifier(read.object)
    if not own or own.name != "memory" {
        return false
    }
    if parameters.contains("memory") or local_sources.has("memory") or local_classes.has("memory") {
        return false
    }
    crash table
    return not table.plain_fields.has("{class_name}#memory") and not table.counted_field_names.has("memory")
}

func mark_dispatch(effect_call: EffectCall, receiver: Syntax.Expressions.Expression) {
    var named = shape.as_identifier(receiver)
    var element = false
    var indexed = shape.as_index(receiver)
    if indexed {
        crash indexed.object
        named = shape.as_identifier(indexed.object)
        element = true
    }
    assert named and not local_sources.has(named.name)
    var position = parameter_position(named.name)
    assert position >= 0
    effect_call.dispatch_parameter = position
    effect_call.dispatch_element = element
}

func keep_parameters(declared: List<Syntax.Statements.Parameter>, body: List<Syntax.Statements.Statement>) {
    crash recorded
    recorded.functions_studied = recorded.functions_studied + 1
    var index = 0
    while index < declared.count() {
        var parameter = declared[index]
        if parameter.is_variadic {
            recorded.variadic_position = index
        }
        var uses = ParameterUses(parameter.name, parameters)
        uses.study(body)
        var position_text: String = index
        if not uses.assigned {
            recorded.kept_values[position_text] = true
        }
        if uses.list_kept {
            recorded.kept_lists[position_text] = true
        }
        index = index + 1
    }
}

func owner_class(expression: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(expression)
    if identifier {
        if local_classes[identifier.name] {
            return known_or_any(local_classes[identifier.name])
        }
        if local_sources.has(identifier.name) {
            return "*"
        }
        return field_class(class_name, identifier.name)
    }
    var member = shape.as_member(expression)
    if member {
        crash member.object
        var object_class = owner_class(member.object)
        if object_class == "*" {
            return type_attribute_class(member.object, member.name)
        }
        return field_class(object_class, member.name)
    }
    var binary = shape.as_binary(expression)
    if binary {
        crash binary.left
        return owner_class(binary.left)
    }
    var indexed = shape.as_index(expression)
    if indexed {
        crash indexed.object
        return element_owner(indexed.object)
    }
    var constructed = shape.as_generic_call(expression)
    if constructed {
        crash constructed.callee
        crash table
        var constructed_class = table.class_identity(constructed.callee, class_name)
        return known_or_any(constructed_class)
    }
    var called = shape.as_call(expression)
    if called {
        return call_owner(called)
    }
    return "*"
}

func element_owner(listed: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(listed)
    if identifier {
        if local_elements[identifier.name] {
            return known_or_any(local_elements[identifier.name])
        }
        if parameters.contains(identifier.name) or local_sources.has(identifier.name) {
            return "*"
        }
        return element_class(class_name, identifier.name)
    }
    var member = shape.as_member(listed)
    if member {
        crash member.object
        var object_class = owner_class(member.object)
        if object_class != "*" {
            return element_class(object_class, member.name)
        }
    }
    return "*"
}

func element_class(owner: String, field: String): String {
    crash table
    var found = table.element_classes["{owner}#{field}"]
    if found {
        return known_or_any(found)
    }
    return "*"
}

func call_owner(called: Syntax.Expressions.CallExpression): String {
    crash called.callee
    crash table
    var callee_identifier = shape.as_identifier(called.callee)
    if callee_identifier {
        if table.names_a_class(callee_identifier.name) {
            var called_class = table.class_identity(called.callee, class_name)
            return known_or_any(called_class)
        }
        if parameters.contains(callee_identifier.name) or local_sources.has(callee_identifier.name) {
            return "*"
        }
        return returned_owner(class_name, callee_identifier.name)
    }
    var member = shape.as_member(called.callee)
    if not member {
        return "*"
    }
    if table.names_a_class(member.name) {
        var constructed_class = table.class_identity(called.callee, class_name)
        return known_or_any(constructed_class)
    }
    crash member.object
    var receiver_class = owner_class(member.object)
    if receiver_class == "*" {
        return "*"
    }
    return returned_owner(receiver_class, member.name)
}

func returned_owner(owner: String, name: String): String {
    crash table
    var found = table.return_classes["{owner}#{name}"]
    if found {
        return known_or_any(found)
    }
    return "*"
}

func field_class(owner: String, field: String): String {
    crash table
    var found = table.field_classes["{owner}#{field}"]
    if found {
        return known_or_any(found)
    }
    return "*"
}

func type_attribute_class(object: Syntax.Expressions.Expression, name: String): String {
    var identifier = shape.as_identifier(object)
    if not identifier {
        return "*"
    }
    var type_name = local_types[identifier.name]
    if not type_name {
        return "*"
    }
    crash table
    var found = table.type_field_classes["{type_name}#{name}"]
    if not found {
        return "*"
    }
    return known_or_any(found)
}

func known_or_any(found_class: String): String {
    crash table
    if table.class_names.has(found_class) {
        return found_class
    }
    return "*"
}

func classified(expressions: List<Syntax.Expressions.Expression>): List<String> {
    var expression_keys = List<String>()
    var expression_keys_index = 0
    while expression_keys_index < expressions.count() {
        var expression_keys_item = classify(expressions[expression_keys_index])
        expression_keys.append(expression_keys_item)
        expression_keys_index = expression_keys_index + 1
    }
    return expression_keys
}

func classify(expression: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(expression)
    if identifier {
        var position = parameter_position(identifier.name)
        if position >= 0 {
            return "parameter:{position}"
        }
        if local_sources[identifier.name] {
            return local_sources[identifier.name]
        }
        return "shrink:{class_name}#{identifier.name}"
    }
    var member = shape.as_member(expression)
    if member {
        crash member.object
        var owner = owner_class(member.object)
        return "shrink:{owner}#{member.name}"
    }
    var indexed = shape.as_index(expression)
    if indexed {
        crash indexed.object
        var collection_key = classify(indexed.object)
        return element_key(collection_key)
    }
    return "fresh"
}

func element_key(collection_key: String): String {
    if not collection_key.starts_with("shrink:") or collection_key == "shrink:*" {
        return "shrink:*"
    }
    return "{collection_key}[]"
}

func parameter_position(name: String): Integer {
    var position = 0
    while position < parameters.count() {
        if parameters[position] == name {
            return position
        }
        position = position + 1
    }
    return -1
}

func called_name(callee: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(callee)
    if identifier {
        return identifier.name
    }
    var member = shape.as_member(callee)
    if not member {
        return ""
    }
    return member.name
}

func is_shrinking(name: String): Boolean {
    var shrinking = [
        "clear"
        "remove_at"
        "remove_first"
        "remove_last"
        "remove_swapping"
        "remove"
        "truncate"
        "swap"
    ]
    return shrinking.contains(name) or name.starts_with("remove_where")
}

func is_growing(name: String): Boolean {
    var growing = ["append", "prepend", "insert", "reserve", "make_room", "_make_room", "_reserve_exactly"]
    return growing.contains(name)
}

func growing_key(key: String): String {
    var key_length = key.length()
    if key.starts_with("shrink:") {
        return "grow:{key.slice(7, key_length)}"
    }
    if not key.starts_with("parameter:") {
        return ""
    }
    return "grow:{key}"
}

func add_release_key(owner: String, field: String) {
    crash table
    assert not table.plain_fields.has("{owner}#{field}")
    assert owner != "*" or table.counted_field_names.has(field)
    add_key("release")
}

func add_key(key: String) {
    assert key != "fresh" and not key.is_empty()
    crash recorded
    recorded.add(key)
}
