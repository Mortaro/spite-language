var pieces = List<String>()
var piece_names = List<String>()
var kept = List<Bool>()
var functions = Dictionary<Int>()
var waiting = List<Int>()
var in_comment = false

func shake(roots: String, body: String): String {
    split_pieces(body)
    keep_named_in(roots)
    var index = 0
    while index < pieces.count() {
        var name = piece_names[index]
        crash name
        if name.is_empty() {
            keep_named_in(pieces[index])
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var next = waiting.last()
        waiting.remove_last()
        crash pieces[next]
        keep_named_in(pieces[next])
    }
    var result = List<String>()
    index = 0
    while index < kept.count() {
        if kept[index] {
            var piece = pieces[index]
            crash piece
            result.append(piece)
        }
        index = index + 1
    }
    return result.join("\n")
}

func kept_prototypes(prototypes: String): String {
    var result = List<String>()
    var lines = prototypes.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var name = declared_name(line)
        if name.is_empty() or is_kept_name(name) {
            result.append(line)
        }
        index = index + 1
    }
    return result.join("\n")
}

func is_kept_name(name: String): Bool {
    if functions[name] {
        return kept[functions[name]] == true
    }
    return true
}

func split_pieces(body: String) {
    var lines = body.split("\n")
    var depth = 0
    var current = List<String>()
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        current.append(line)
        depth = depth + depth_change(line)
        if depth <= 0 {
            depth = 0
            add_piece(current)
            current = List<String>()
        }
        index = index + 1
    }
    if not current.is_empty() {
        add_piece(current)
    }
}

func add_piece(lines: List<String>) {
    crash lines[0]
    var name = defined_name(lines[0])
    if not name.is_empty() and functions.has(name) {
        name = ""
    }
    if not name.is_empty() {
        functions[name] = pieces.count()
    }
    pieces.append(lines.join("\n"))
    piece_names.append(name)
    kept.append(name.is_empty())
}

func defined_name(line: String): String {
    var trimmed = line.trim()
    if not trimmed.ends_with("\{") or trimmed.starts_with("#") or trimmed.starts_with("typedef") {
        return ""
    }
    var open = trimmed.index_of("(")
    var equals = trimmed.index_of("=")
    if open <= 0 or equals >= 0 and equals < open {
        return ""
    }
    return name_before(trimmed, open)
}

func declared_name(line: String): String {
    var trimmed = line.trim()
    if not trimmed.ends_with(");") or trimmed.starts_with("#") or trimmed.starts_with("typedef") {
        return ""
    }
    var open = trimmed.index_of("(")
    if open <= 0 {
        return ""
    }
    return name_before(trimmed, open)
}

func name_before(text: String, end: Int): String {
    var start = end
    while start > 0 and is_name_code(text.code_at(start - 1)) {
        start = start - 1
    }
    return text.slice(start, end)
}

func is_name_code(code: Int): Bool {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func depth_change(line: String): Int {
    var change = 0
    var quote = 0
    var index = 0
    while index < line.length() {
        var code = line.code_at(index)
        if in_comment {
            if code == 42 and line.code_at(index + 1) == 47 {
                in_comment = false
                index = index + 1
            }
        } else if quote != 0 {
            if code == 92 {
                index = index + 1
            } else if code == quote {
                quote = 0
            }
        } else if code == 34 or code == 39 {
            quote = code
        } else if code == 47 and line.code_at(index + 1) == 47 {
            return change
        } else if code == 47 and line.code_at(index + 1) == 42 {
            in_comment = true
            index = index + 1
        } else if code == 123 {
            change = change + 1
        } else if code == 125 {
            change = change - 1
        }
        index = index + 1
    }
    return change
}

func keep_named_in(text: String) {
    var quote = 0
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        if quote != 0 {
            if code == 92 {
                index = index + 1
            } else if code == quote {
                quote = 0
            }
            index = index + 1
        } else if code == 34 or code == 39 {
            quote = code
            index = index + 1
        } else if code == 47 and text.code_at(index + 1) == 42 {
            index = comment_end(text, index + 2)
        } else if code == 47 and text.code_at(index + 1) == 47 {
            index = line_end(text, index)
        } else if is_name_code(code) {
            var start = index
            while index < text.length() and is_name_code(text.code_at(index)) {
                index = index + 1
            }
            keep_function(text.slice(start, index))
        } else {
            index = index + 1
        }
    }
}

func comment_end(text: String, start: Int): Int {
    var index = start
    while index < text.length() {
        if text.code_at(index) == 42 and text.code_at(index + 1) == 47 {
            return index + 2
        }
        index = index + 1
    }
    return index
}

func line_end(text: String, start: Int): Int {
    var index = start
    while index < text.length() and text.code_at(index) != 10 {
        index = index + 1
    }
    return index
}

func keep_function(name: String) {
    assert functions[name]
    if kept[functions[name]] == false {
        kept[functions[name]] = true
        waiting.append(functions[name])
    }
}
