var pieces = List<String>()
var piece_names = List<String>()
var kept = List<Boolean>()
var slot_names = List<String>()
var slot_positions = List<Integer>()
var waiting = List<Integer>()
var in_comment = false
var watched_names = List<String>()
var first_watched = -1
var names_types = false
var next_same = List<Integer>()
var type_piece_count = 0
var guard_names = List<String>()
var guard_lines = List<String>()
var shaken_macros = Dictionary<Boolean>()

func shake(roots: String, body: String): String {
    split_pieces(body)
    keep_named_in(roots)
    watch_names()
    var index = 0
    while index < pieces.count() {
        var name = piece_names[index]
        crash name
        if name.is_empty() {
            keep_named_in(pieces[index])
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var next = waiting.last()
        crash next
        waiting.remove_last()
        crash pieces[next]
        keep_named_in(pieces[next])
    }
    var result = List<String>()
    index = 0
    while index < kept.count() and (first_watched < 0 or index < first_watched) {
        if kept[index] == true {
            var piece = pieces[index]
            crash piece
            result.append(piece)
        }
        index = index + 1
    }
    return result.join("\n")
}

func shake_program(types: String, prototypes: String, main_function: String, body: String): String {
    names_types = true
    reserve_slots("{types}\n{body}")
    split_pieces(types)
    type_piece_count = pieces.count()
    split_pieces(body)
    var body_piece_end = pieces.count()
    keep_named_in(main_function)
    add_undefined_prototypes(prototypes)
    watch_names()
    var index = 0
    while index < pieces.count() {
        var name = piece_names[index]
        crash name
        if name.is_empty() {
            keep_named_in(pieces[index])
        }
        index = index + 1
    }
    keep_waiting()
    keep_guarded()
    return kept_text(type_piece_count, body_piece_end)
}

func keep_waiting() {
    while not waiting.is_empty() {
        var next = waiting.last()
        crash next
        waiting.remove_last()
        crash pieces[next]
        keep_named_in(pieces[next])
    }
}

func keep_guarded() {
    var applied = List<Boolean>()
    while applied.count() < guard_names.count() {
        applied.append(false)
    }
    var settled = false
    while not settled {
        settled = true
        var index = 0
        while index < guard_names.count() {
            var guard = guard_names[index]
            if applied[index] == false and is_kept_name(guard) {
                applied.set_at(index, true)
                crash guard_lines[index]
                var line = guard_lines[index]
                keep_named_in(line)
                keep_waiting()
                settled = false
            }
            index = index + 1
        }
    }
}

func kept_types(): String {
    return kept_text(0, type_piece_count)
}

func kept_text(start: Integer, end: Integer): String {
    var result = List<String>()
    var index = start
    while index < end {
        if kept[index] == true {
            var piece = pieces[index]
            crash piece
            result.append(piece)
        }
        index = index + 1
    }
    return result.join("\n")
}

func add_undefined_prototypes(prototypes: String) {
    var lines = prototypes.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var name = declared_name(line)
        var name_length = name.length()
        if name.is_empty() {
            keep_named_in(line)
        } else if find_function(name, 0, name_length) < 0 {
            var pieces_count = pieces.count()
            add_function(name, pieces_count)
            pieces.append(line)
            piece_names.append(name)
            next_same.append(-1)
            kept.append(false)
        }
        index = index + 1
    }
}

func watch_names() {
    first_watched = pieces.count()
    var index = 0
    while index < watched_names.count() {
        var name = watched_names[index]
        var name_length = name.length()
        if find_function(name, 0, name_length) < 0 {
            var pieces_count = pieces.count()
            add_function(name, pieces_count)
            pieces.append("")
            piece_names.append(name)
            kept.append(false)
        }
        index = index + 1
    }
}

func kept_watched_names(): List<String> {
    var result = List<String>()
    var index = 0
    while index < watched_names.count() {
        var name = watched_names[index]
        if is_kept_name(name) {
            result.append(name)
        }
        index = index + 1
    }
    return result
}

func kept_prototypes(prototypes: String): String {
    var result = List<String>()
    var lines = prototypes.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var name = declared_name(line)
        if name.is_empty() or is_kept_name(name) {
            result.append(line)
        }
        index = index + 1
    }
    return result.join("\n")
}

func is_kept_name(name: String): Boolean {
    var name_length = name.length()
    var position = find_function(name, 0, name_length)
    if position < 0 {
        return true
    }
    return kept[position] == true
}

func reserve_slots(text: String) {
    var lines = text.split("\n")
    var capacity = 1024
    while capacity < lines.count() * 2 {
        capacity = capacity * 2
    }
    while slot_names.count() < capacity {
        slot_names.append("")
        slot_positions.append(-1)
    }
}

func split_pieces(body: String) {
    if slot_names.is_empty() {
        reserve_slots(body)
    }
    var lines = body.split("\n")
    var depth = 0
    var current = List<String>()
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        current.append(line)
        depth = depth + depth_change(line)
        if depth <= 0 {
            depth = 0
            add_piece(current)
            current = List<String>()
        }
        index = index + 1
    }
    if not current.is_empty() {
        add_piece(current)
    }
}

func add_piece(lines: List<String>) {
    crash lines[0]
    var name = piece_name(lines[0])
    var name_length = name.length()
    var pieces_count = pieces.count()
    var same = -1
    if not name.is_empty() {
        same = find_function(name, 0, name_length)
    }
    if same >= 0 and not names_types {
        name = ""
    } else if same >= 0 {
        while same < next_same.count() and next_same[same] >= 0 {
            same = next_same[same]
        }
        next_same.set_at(same, pieces_count)
    } else if not name.is_empty() {
        add_function(name, pieces_count)
    }
    var joined_lines = lines.join("\n")
    pieces.append(joined_lines)
    piece_names.append(name)
    next_same.append(-1)
    var name_is_empty = name.is_empty()
    kept.append(name_is_empty)
}

func piece_name(line: String): String {
    if not names_types {
        return defined_name(line)
    }
    var trimmed = line.trim()
    var trimmed_length = trimmed.length()
    if trimmed.starts_with("typedef struct ") and trimmed.ends_with(";") and trimmed.index_of("\{") < 0 {
        return name_before(trimmed, trimmed_length - 1)
    }
    if trimmed.starts_with("struct ") and trimmed.ends_with("\{") {
        var words = trimmed.slice(7, trimmed_length - 1)
        var name = words.trim()
        assert name.index_of(" ") < 0
        return name
    }
    if trimmed.starts_with("static ") and (trimmed.ends_with(";") or trimmed.ends_with("\{")) {
        var variable = static_variable_name(trimmed)
        if not variable.is_empty() {
            return variable
        }
    }
    if trimmed.ends_with("}") {
        return one_line_defined_name(trimmed)
    }
    if trimmed.starts_with("#define ") {
        return shaken_macro_name(trimmed)
    }
    return defined_name(line)
}

func shaken_macro_name(trimmed: String): String {
    var open = trimmed.index_of("(")
    assert open > 8
    var name = trimmed.slice(8, open)
    assert shaken_macros.has(name)
    return name
}

func static_variable_name(trimmed: String): String {
    var end = trimmed.length() - 1
    var equals = trimmed.index_of("=")
    if equals > 0 {
        end = equals
    }
    var head = trimmed.slice(0, end)
    assert head.index_of("(") < 0
    var bracket = head.index_of("[")
    if bracket > 0 {
        head = head.slice(0, bracket)
    }
    var name = head.trim()
    var name_length = name.length()
    return name_before(name, name_length)
}

func one_line_defined_name(trimmed: String): String {
    assert not trimmed.starts_with("#") and not trimmed.starts_with("typedef") and not trimmed.starts_with("static")
    var brace = trimmed.index_of("\{")
    assert brace > 0
    var signature = trimmed.slice(0, brace)
    var head = signature.trim()
    assert head.ends_with(")")
    return name_of_signature(head)
}

func defined_name(line: String): String {
    var trimmed = line.trim()
    assert trimmed.ends_with("\{") and not trimmed.starts_with("#") and not trimmed.starts_with("typedef")
    return name_of_signature(trimmed)
}

func name_of_signature(trimmed: String): String {
    var open = trimmed.index_of("(")
    var equals = trimmed.index_of("=")
    assert open > 0 and (equals < 0 or equals >= open)
    return name_before(trimmed, open)
}

func declared_name(line: String): String {
    var trimmed = line.trim()
    assert trimmed.ends_with(");") and not trimmed.starts_with("#") and not trimmed.starts_with("typedef")
    var open = trimmed.index_of("(")
    assert open > 0
    return name_before(trimmed, open)
}

func name_before(text: String, end: Integer): String {
    var start = end
    var code = text.code_at(start - 1)
    while start > 0 and is_name_code(code) {
        start = start - 1
        code = text.code_at(start - 1)
    }
    return text.slice(start, end)
}

func is_name_code(code: Integer): Boolean {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func depth_change(line: String): Integer {
    var change = 0
    var quote = 0
    var index = 0
    while index < line.length() {
        var code = line.code_at(index)
        if in_comment {
            if code == 42 and line.code_at(index + 1) == 47 {
                in_comment = false
                index = index + 1
            }
        } else if quote != 0 and code == 92 {
            index = index + 1
        } else if quote != 0 {
            if code == quote {
                quote = 0
            }
        } else if code == 34 or code == 39 {
            quote = code
        } else if code == 47 and line.code_at(index + 1) == 47 {
            return change
        } else if code == 47 and line.code_at(index + 1) == 42 {
            in_comment = true
            index = index + 1
        } else if code == 123 {
            change = change + 1
        } else if code == 125 {
            change = change - 1
        }
        index = index + 1
    }
    return change
}

func keep_named_in(text: String) {
    var quote = 0
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        if quote != 0 and code == 92 {
            index = index + 2
        } else if quote != 0 {
            if code == quote {
                quote = 0
            }
            index = index + 1
        } else if code == 34 or code == 39 {
            quote = code
            index = index + 1
        } else if code == 47 and text.code_at(index + 1) == 42 {
            index = comment_end(text, index + 2)
        } else if code == 47 and text.code_at(index + 1) == 47 {
            index = line_end(text, index)
        } else if is_name_code(code) {
            var start = index
            var name_code = text.code_at(index)
            while index < text.length() and is_name_code(name_code) {
                index = index + 1
                name_code = text.code_at(index)
            }
            var function = find_function(text, start, index)
            keep_function(function)
        } else {
            index = index + 1
        }
    }
}

func comment_end(text: String, start: Integer): Integer {
    var index = start
    while index < text.length() {
        if text.code_at(index) == 42 and text.code_at(index + 1) == 47 {
            return index + 2
        }
        index = index + 1
    }
    return index
}

func line_end(text: String, start: Integer): Integer {
    var index = start
    while index < text.length() and text.code_at(index) != 10 {
        index = index + 1
    }
    return index
}

func keep_function(position: Integer) {
    assert position >= 0
    if kept[position] == false {
        kept[position] = true
        waiting.append(position)
        if position < next_same.count() {
            var same = next_same[position]
            if same >= 0 {
                keep_function(same)
            }
        }
    }
}

func slot_of(text: String, start: Integer, end: Integer): Integer {
    var hash: Long = 0
    var index = start
    while index < end {
        hash = (hash * 31 + text.code_at(index)) % 1000000007
        index = index + 1
    }
    return hash % slot_names.count()
}

func add_function(name: String, position: Integer) {
    var name_length = name.length()
    var slot = slot_of(name, 0, name_length)
    while slot_positions[slot] != -1 {
        slot = (slot + 1) % slot_names.count()
    }
    slot_names[slot] = name
    slot_positions[slot] = position
}

func find_function(text: String, start: Integer, end: Integer): Integer {
    var slot = slot_of(text, start, end)
    while slot_positions[slot] != -1 {
        if same_name(slot_names[slot], text, start, end) {
            crash slot_positions[slot]
            return slot_positions[slot]
        }
        slot = (slot + 1) % slot_names.count()
    }
    return -1
}

func same_name(name: String?, text: String, start: Integer, end: Integer): Boolean {
    crash name
    assert name.length() == end - start
    var index = 0
    while index < name.length() {
        assert name.code_at(index) == text.code_at(start + index)
        index = index + 1
    }
    return true
}
