var shape = Analysis.AstShape()
var lent_parameters = List<String>()
var read_lists = List<String>()
var foreign_libraries = List<String>()

func frame_candidates(statements: List<Syntax.Statements.Statement>): List<String> {
    var names = List<String>()
    var index = 0
    while index < statements.count() {
        var declaration = shape.as_variable_declaration(statements[index])
        if declaration {
            var receiver = allocating_receiver(declaration)
            if not receiver.is_empty() and is_freed_later(declaration.name, receiver, statements, index + 1) and stays_in_frame(declaration.name, receiver, statements, index + 1) {
                var key = frame_key(declaration)
                names.append(key)
            }
        }
        index = index + 1
    }
    return names
}

func allocating_receiver(declaration: Syntax.Statements.VariableDeclaration): String {
    crash declaration.value
    var allocation = shape.as_call(declaration.value)
    if not allocation {
        return ""
    }
    crash allocation.callee
    var allocating = shape.as_member(allocation.callee)
    if not allocating {
        return ""
    }
    if allocating.name != "allocate" or allocation.arguments.count() != 1 {
        return ""
    }
    crash allocating.object
    var receiver = shape.as_identifier(allocating.object)
    if not receiver {
        return ""
    }
    return receiver.name
}

func freed_name(statement: Syntax.Statements.Statement, receiver: String): String {
    var expression_statement = shape.as_expression_statement(statement)
    if not expression_statement {
        return ""
    }
    crash expression_statement.value
    return memory_argument(expression_statement.value, receiver, "free")
}

func frame_key(declaration: Syntax.Statements.VariableDeclaration): String {
    return "{declaration.name}@{declaration.line}"
}

func memory_argument(expression: Syntax.Expressions.Expression, receiver: String, function_name: String): String {
    var call = shape.as_call(expression)
    if not call {
        return ""
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return ""
    }
    if member.name != function_name or call.arguments.count() != 1 {
        return ""
    }
    crash member.object
    var called_on = shape.as_identifier(member.object)
    if not called_on {
        return ""
    }
    var argument = shape.as_identifier(call.arguments[0])
    if not argument {
        return ""
    }
    if called_on.name != receiver {
        return ""
    }
    return argument.name
}

func is_freed_later(
    name: String,
    receiver: String,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
): Boolean {
    var index = start
    while index < statements.count() {
        if freed_name(statements[index], receiver) == name {
            return true
        }
        index = index + 1
    }
    return false
}

func stays_in_frame(
    name: String,
    receiver: String,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
): Boolean {
    var index = start
    while index < statements.count() {
        if not statement_keeps_in_frame(name, receiver, statements[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func block_keeps_in_frame(name: String, receiver: String, statements: List<Syntax.Statements.Statement>): Boolean {
    return stays_in_frame(name, receiver, statements, 0)
}

func statement_keeps_in_frame(name: String, receiver: String, statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            return statement.name != name and receiver != statement.name and expression_keeps_in_frame(name, receiver, statement.value, false)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var assigned = shape.as_identifier(statement.target)
            if assigned {
                if assigned.name == name or assigned.name == receiver {
                    return false
                }
            }
            return expression_keeps_in_frame(name, receiver, statement.target, false) and expression_keeps_in_frame(name, receiver, statement.value, false)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return expression_keeps_in_frame(name, receiver, statement.value, false)
        }
        Syntax.Statements.ReturnStatement: {
            if not statement.value {
                return false
            }
            return expression_keeps_in_frame(name, receiver, statement.value, false)
        }
        Syntax.Statements.AssertStatement: {
            if not statement.value {
                return false
            }
            return expression_keeps_in_frame(name, receiver, statement.value, false)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            return expression_keeps_in_frame(name, receiver, statement.condition, false) and block_keeps_in_frame(name, receiver, statement.then_branch) and block_keeps_in_frame(name, receiver, statement.else_branch)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            return expression_keeps_in_frame(name, receiver, statement.condition, false) and block_keeps_in_frame(name, receiver, statement.body)
        }
        Syntax.Statements.SwitchStatement: {
            crash statement.subject
            if not expression_keeps_in_frame(name, receiver, statement.subject, false) {
                return false
            }
            var case_index = 0
            while case_index < statement.cases.count() {
                if not block_keeps_in_frame(name, receiver, statement.cases[case_index].body) {
                    return false
                }
                case_index = case_index + 1
            }
            return true
        }
        _: return false
    }
}

func expression_keeps_in_frame(
    name: String,
    receiver: String,
    expression: Syntax.Expressions.Expression,
    lent: Boolean,
): Boolean {
    switch expression {
        Syntax.Expressions.IdentifierExpression: return lent or expression.name != name
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            return expression_keeps_in_frame(name, receiver, expression.left, lent) and expression_keeps_in_frame(name, receiver, expression.right, lent)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return expression_keeps_in_frame(name, receiver, expression.operand, lent)
        }
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var lends = lends_address(expression.callee, receiver)
            var index = 0
            while index < expression.arguments.count() {
                var argument_lent = lends or lent_to_own_function(expression.callee, index)
                if not expression_keeps_in_frame(name, receiver, expression.arguments[index], argument_lent) {
                    return false
                }
                index = index + 1
            }
            var at_address = shape.as_member(expression.callee)
            if at_address and is_address_primitive(at_address.name) {
                crash at_address.object
                return expression_keeps_in_frame(name, receiver, at_address.object, true)
            }
            return expression_keeps_in_frame(name, receiver, expression.callee, false)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return expression_keeps_in_frame(name, receiver, expression.object, false)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            return expression_keeps_in_frame(name, receiver, expression.object, false) and expression_keeps_in_frame(name, receiver, expression.index, false)
        }
        Syntax.Expressions.GenericCallExpression: {
            var generic_index = 0
            while generic_index < expression.arguments.count() {
                if not expression_keeps_in_frame(name, receiver, expression.arguments[generic_index], false) {
                    return false
                }
                generic_index = generic_index + 1
            }
            return true
        }
        Syntax.Expressions.ListLiteralExpression: {
            var element_index = 0
            while element_index < expression.elements.count() {
                var element_value = expression.elements[element_index].value
                crash element_value
                if not expression_keeps_in_frame(name, receiver, element_value, false) {
                    return false
                }
                element_index = element_index + 1
            }
            return true
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var field_index = 0
            while field_index < expression.fields.count() {
                var field_value = expression.fields[field_index].value
                crash field_value
                if not expression_keeps_in_frame(name, receiver, field_value, false) {
                    return false
                }
                field_index = field_index + 1
            }
            return true
        }
        _: return true
    }
}

func lent_to_own_function(callee: Syntax.Expressions.Expression, index: Integer): Boolean {
    var called = shape.as_identifier(callee)
    if not called {
        return false
    }
    return lent_parameters.contains("{called.name}#{index}")
}

func study_lent_parameters(
    names: List<String>,
    parameter_lists: List<List<String>>,
    bodies: List<List<Syntax.Statements.Statement>>,
) {
    lent_parameters = List<String>()
    var changed = true
    while changed {
        changed = false
        var index = 0
        while index < names.count() {
            crash parameter_lists[index]
            crash bodies[index]
            var function_name = names[index]
            var parameters = parameter_lists[index]
            var body = bodies[index]
            if study_function_parameters(function_name, parameters, body) {
                changed = true
            }
            index = index + 1
        }
    }
}

func study_function_parameters(
    function_name: String,
    parameters: List<String>,
    body: List<Syntax.Statements.Statement>,
): Boolean {
    var added = false
    var index = 0
    while index < parameters.count() {
        var key = "{function_name}#{index}"
        var parameter = parameters[index]
        if not parameter.is_empty() and not lent_parameters.contains(key) and stays_in_frame(parameter, "", body, 0) {
            lent_parameters.append(key)
            added = true
        }
        index = index + 1
    }
    return added
}

func lends_address(callee: Syntax.Expressions.Expression, receiver: String): Boolean {
    var member = shape.as_member(callee)
    if not member {
        return false
    }
    if is_address_primitive(member.name) {
        return true
    }
    var typed = ["read_value", "write_value", "release_value", "swap_values"]
    if typed.contains(member.name) {
        return true
    }
    crash member.object
    var called_on = shape.as_identifier(member.object)
    if not called_on {
        return false
    }
    if foreign_libraries.contains(called_on.name) {
        return true
    }
    return called_on.name == receiver and member.name == "free"
}

func is_address_primitive(name: String): Boolean {
    var primitives = [
        "read_byte"
        "read_integer"
        "read_long"
        "read_double"
        "read_short"
        "read_unsigned_short"
        "read_unsigned_integer"
        "read_float"
        "write_byte"
        "write_integer"
        "write_long"
        "write_double"
        "write_short"
        "write_unsigned_short"
        "write_unsigned_integer"
        "write_float"
        "copy_to"
        "compare_bytes"
        "text"
    ]
    return primitives.contains(name)
}

func study_read_lists(
    names: List<String>,
    parameter_lists: List<List<String>>,
    bodies: List<List<Syntax.Statements.Statement>>,
): List<String> {
    read_lists = List<String>()
    var changed = true
    while changed {
        changed = false
        var index = 0
        while index < names.count() {
            crash parameter_lists[index]
            crash bodies[index]
            var function_name = names[index]
            var parameters = parameter_lists[index]
            var body = bodies[index]
            if study_read_list_parameters(function_name, parameters, body) {
                changed = true
            }
            index = index + 1
        }
    }
    return read_lists
}

func study_read_list_parameters(
    function_name: String,
    parameters: List<String>,
    body: List<Syntax.Statements.Statement>,
): Boolean {
    var added = false
    var index = 0
    while index < parameters.count() {
        var key = "{function_name}#{index}"
        var parameter = parameters[index]
        if not parameter.is_empty() and not read_lists.contains(key) and block_only_reads(parameter, body) {
            read_lists.append(key)
            added = true
        }
        index = index + 1
    }
    return added
}

func block_only_reads(name: String, statements: List<Syntax.Statements.Statement>): Boolean {
    var index = 0
    while index < statements.count() {
        if not statement_only_reads(name, statements[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func statement_only_reads(name: String, statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            return statement.name != name and expression_only_reads(name, statement.value)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            if written_through(name, statement.target) {
                return false
            }
            return expression_only_reads(name, statement.target) and expression_only_reads(name, statement.value)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return expression_only_reads(name, statement.value)
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                return expression_only_reads(name, statement.value)
            }
            return true
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            return expression_only_reads(name, statement.value)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            return expression_only_reads(name, statement.condition) and block_only_reads(name, statement.then_branch) and block_only_reads(name, statement.else_branch)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            return expression_only_reads(name, statement.condition) and block_only_reads(name, statement.body)
        }
        _: return false
    }
}

func written_through(name: String, target: Syntax.Expressions.Expression): Boolean {
    var assigned = shape.as_identifier(target)
    if assigned {
        return assigned.name == name
    }
    var indexed = shape.as_index(target)
    if not indexed {
        return false
    }
    crash indexed.object
    var indexed_list = shape.as_identifier(indexed.object)
    if not indexed_list {
        return false
    }
    return indexed_list.name == name
}

func expression_only_reads(name: String, expression: Syntax.Expressions.Expression): Boolean {
    switch expression {
        Syntax.Expressions.IdentifierExpression: return expression.name != name
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            return expression_only_reads(name, expression.left) and expression_only_reads(name, expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return expression_only_reads(name, expression.operand)
        }
        Syntax.Expressions.CallExpression: return call_only_reads(name, expression)
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return expression_only_reads(name, expression.object)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            if not names_list(name, expression.object) and not expression_only_reads(name, expression.object) {
                return false
            }
            return expression_only_reads(name, expression.index)
        }
        Syntax.Expressions.GenericCallExpression: return expressions_only_read(name, expression.arguments)
        Syntax.Expressions.ListLiteralExpression: return elements_only_read(name, expression.elements)
        Syntax.Expressions.StringLiteralExpression: return true
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.NullLiteral: return true
        _: return false
    }
}

func expressions_only_read(name: String, expressions: List<Syntax.Expressions.Expression>): Boolean {
    var index = 0
    while index < expressions.count() {
        if not expression_only_reads(name, expressions[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func elements_only_read(name: String, elements: List<Syntax.Expressions.ListElement>): Boolean {
    var index = 0
    while index < elements.count() {
        var element_value = elements[index].value
        crash element_value
        if not expression_only_reads(name, element_value) {
            return false
        }
        index = index + 1
    }
    return true
}

func names_list(name: String, expression: Syntax.Expressions.Expression): Boolean {
    var named = shape.as_identifier(expression)
    if not named {
        return false
    }
    return named.name == name
}

func call_only_reads(name: String, call: Syntax.Expressions.CallExpression): Boolean {
    crash call.callee
    var member = shape.as_member(call.callee)
    var read_on_list = false
    if member {
        crash member.object
        read_on_list = names_list(name, member.object)
        if read_on_list and not is_list_read(member.name) {
            return false
        }
    }
    if not read_on_list {
        if not expression_only_reads(name, call.callee) {
            return false
        }
    }
    var own = shape.as_identifier(call.callee)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if names_list(name, argument) {
            if not own {
                return false
            }
            if not read_lists.contains("{own.name}#{index}") {
                return false
            }
        } else if not expression_only_reads(name, argument) {
            return false
        }
        index = index + 1
    }
    return true
}

func is_list_read(name: String): Boolean {
    var reads = ["count", "is_empty", "get_at", "find_at", "first", "last", "contains", "join"]
    return reads.contains(name)
}
