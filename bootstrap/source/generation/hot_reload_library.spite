var host_names = List<String>()
var host_prototypes = Dictionary<String>()
var host_slots = Dictionary<String>()
var host_classes = List<String>()
var host_class_identities = List<String>()
var host_layouts = Dictionary<String>()
var host_fields = Dictionary<String>()
var running_fields = Dictionary<String>()
var host_key_sites = Dictionary<Analysis.SpiteType>()
var host_facts = ProgramFacts()
var host_variants = List<String>()
var host_instances = List<String>()
var host_literals = List<String>()
var host_waiting = List<String>()
var host_slot_owners = Dictionary<String>()
var split_done = false
var host_members = Dictionary<String>()
var host_declared = Dictionary<String>()
var library_bodies = List<String>()
var library_body_names = List<String>()
var host_hashes = Dictionary<String>()
var stale_pieces = List<String>()
var running_breakpoints = List<String>()
var host_snapshot = Dictionary<String>()
var program_shaker = TreeShaker()
var program_prototypes = Dictionary<String>()
var program_prototype_text = ""
var generation = 0
var running_hashes = Dictionary<String>()
var installed = List<String>()
var added = List<String>()
var removed = List<String>()

func record_host(prototype_text: String, bodies: String, constants: Dictionary<String>) {
    var shaker = TreeShaker()
    shaker.split_pieces(bodies)
    var piece_index = 0
    while piece_index < shaker.pieces.count() {
        crash shaker.piece_names[piece_index]
        var piece_name = shaker.piece_names[piece_index]
        if not piece_name.is_empty() {
            var piece = shaker.pieces[piece_index]
            host_hashes[piece_name] = piece_hash(piece, constants)
        }
        piece_index = piece_index + 1
    }
    var lines = prototype_text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        var name = function_name(line, shaker)
        if not name.is_empty() and not host_prototypes.has(name) {
            host_names.append(name)
            host_prototypes[name] = line
        }
        index = index + 1
    }
}

func function_name(line: String, shaker: TreeShaker): String {
    if not line.ends_with(");") or not line.contains("(") or line.starts_with("#") or line.starts_with("typedef") {
        return ""
    }
    if line.starts_with("static") {
        return ""
    }
    var name = shaker.declared_name(line)
    var name_length = name.length()
    if name_length <= 0 or shaker.find_function(name, 0, name_length) < 0 {
        return ""
    }
    return name
}

func symbol_table(): String {
    var entries = List<String>()
    var index = 0
    while index < host_names.count() {
        entries.append("\{ \"{host_names[index]}\", (void*)&{host_names[index]} }")
        index = index + 1
    }
    entries.append("\{ 0, 0 }")
    return "typedef struct SpiteHotSymbol \{ const char* name; void* address; } SpiteHotSymbol;\nstatic const SpiteHotSymbol spite_hot_symbols[] = \{ {entries.join(", ")} };\nstatic void* spite_hot_find(const char* name) \{\nfor (int64_t index = 0; spite_hot_symbols[index].name != 0; index = index + 1) \{\nif (strcmp(spite_hot_symbols[index].name, name) == 0) return spite_hot_symbols[index].address;\n}\nreturn 0;\n}"
}

func host_manifest(
    slot_names: List<String>,
    slot_displays: List<String>,
    class_names: List<String>,
    class_identities: List<String>,
    typedefs: List<String>,
): String {
    var lines = List<String>()
    var index = 0
    while index < host_names.count() {
        var name = host_names[index]
        crash host_prototypes[name]
        lines.append("function {name} {host_prototypes[name]}")
        index = index + 1
    }
    index = 0
    while index < slot_names.count() and index < slot_displays.count() {
        lines.append("slot {slot_names[index]} {slot_displays[index]}")
        index = index + 1
    }
    index = 0
    while index < class_names.count() and index < class_identities.count() {
        lines.append("class {class_names[index]}\t{class_identities[index]}")
        index = index + 1
    }
    var hashed = host_hashes.keys()
    index = 0
    while index < hashed.count() {
        var hashed_name = hashed[index]
        crash host_hashes[hashed_name]
        lines.append("hash {hashed_name} {host_hashes[hashed_name]}")
        index = index + 1
    }
    index = 0
    while index < typedefs.count() {
        var written_typedef = typedefs[index]
        var name = layout_name(written_typedef)
        if not name.is_empty() {
            lines.append("layout {name} {written_typedef.replace("\n", " ")}")
        }
        index = index + 1
    }
    return lines.join("\n")
}

func baseline_lines(
    host_text: String,
    typedefs: List<String>,
    class_names: List<String>,
    class_identities: List<String>,
    constants: Dictionary<String>,
): List<String> {
    var lines = List<String>()
    var host_lines = host_text.split("\n")
    var index = 0
    while index < host_lines.count() {
        var line = host_lines[index]
        if line.starts_with("function ") or line.starts_with("slot ") {
            lines.append(line)
        }
        index = index + 1
    }
    index = 0
    while index < class_names.count() and index < class_identities.count() {
        lines.append("class {class_names[index]}\t{class_identities[index]}")
        index = index + 1
    }
    index = 0
    while index < program_shaker.pieces.count() {
        var name = program_shaker.piece_names[index]
        crash name
        if not name.is_empty() {
            var hash = piece_hash(program_shaker.pieces[index], constants)
            lines.append("hash {name} {hash}")
        }
        index = index + 1
    }
    index = 0
    while index < typedefs.count() {
        var written_typedef = typedefs[index]
        var name = layout_name(written_typedef)
        if not name.is_empty() {
            lines.append("layout {name} {written_typedef.replace("\n", " ")}")
        }
        index = index + 1
    }
    return lines
}

func layout_name(text: String): String {
    if text.starts_with("struct ") {
        var words = text.split(" ")
        crash words[1]
        return words[1]
    }
    if not text.starts_with("typedef enum") {
        return ""
    }
    var text_lines = text.split("\n")
    var last_line = text_lines.last()
    crash last_line
    return last_line.replace("}", "").replace(";", "").trim()
}

func read_host(text: String) {
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var space = line.index_of(" ")
        if space > 0 {
            var line_length = line.length()
            var kind = line.slice(0, space)
            var rest = line.slice(space + 1, line_length)
            read_host_line(kind, rest)
        }
        index = index + 1
    }
}

func read_host_line(kind: String, rest: String) {
    var space = rest.index_of(" ")
    var rest_length = rest.length()
    if kind == "class" {
        var class_tab = rest.index_of("\t")
        crash class_tab > 0
        var class_name = rest.slice(0, class_tab)
        var identity = rest.slice(class_tab + 1, rest_length)
        host_classes.append(class_name)
        host_class_identities.append(identity)
    } else if kind == "slot" and space > 0 {
        var name = rest.slice(0, space)
        host_slots[name] = rest.slice(space + 1, rest_length)
    } else if kind == "function" and space > 0 {
        var name = rest.slice(0, space)
        host_names.append(name)
        host_prototypes[name] = rest.slice(space + 1, rest_length)
    } else if kind == "fields" and space > 0 {
        var class_name = rest.slice(0, space)
        host_fields[class_name] = rest.slice(space + 1, rest_length)
    } else if kind == "layout" and space > 0 {
        var name = rest.slice(0, space)
        host_layouts[name] = rest.slice(space + 1, rest_length)
    } else if kind == "hash" and space > 0 {
        var hashed_name = rest.slice(0, space)
        host_hashes[hashed_name] = rest.slice(space + 1, rest_length)
    } else if kind == "owner" and space > 0 {
        var owned_slot = rest.slice(0, space)
        host_slot_owners[owned_slot] = rest.slice(space + 1, rest_length)
    } else if kind == "declared" {
        var declared_tab = rest.index_of("\t")
        crash declared_tab > 0
        host_declared[rest.slice(0, declared_tab)] = rest.slice(declared_tab + 1, rest_length)
    } else if kind == "members" {
        var member_tab = rest.index_of("\t")
        crash member_tab > 0
        host_members[rest.slice(0, member_tab)] = rest.slice(member_tab + 1, rest_length)
    } else if kind == "waits" {
        host_waiting.append(rest)
    } else if kind == "literal" {
        host_literals.append(rest)
    } else if kind == "instance" {
        host_instances.append(rest)
    } else if kind == "variant" {
        host_variants.append(rest)
    } else if kind == "fact" {
        host_facts.read_line(rest)
    } else if kind == "snapshot" {
        var tab = rest.index_of("\t")
        crash tab > 0
        host_snapshot[rest.slice(tab + 1, rest_length)] = rest.slice(0, tab)
    } else if kind == "key" and space > 0 {
        var label = rest.slice(0, space)
        var key_type = number_key_type(label)
        crash key_type
        host_key_sites[rest.slice(space + 1, rest_length)] = key_type
    }
}

func number_key_type(label: String): Analysis.SpiteType? {
    switch label {
        "Tiny": return scalar_key('tiny_kind')
        "Byte": return scalar_key('byte_kind')
        "Short": return scalar_key('short_kind')
        "UnsignedShort": return scalar_key('unsigned_short_kind')
        "Integer": return scalar_key('integer_kind')
        "UnsignedInteger": return scalar_key('unsigned_integer_kind')
        "Long": return scalar_key('long_kind')
        "UnsignedLong": return scalar_key('unsigned_long_kind')
        _: return null
    }
}

func scalar_key(kind: Analysis.Types.NumericKind): Analysis.SpiteType {
    var key_type: Analysis.SpiteType = Analysis.Types.ScalarType(kind)
    return key_type
}

func read_state(text: String) {
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        var words = line.split(" ")
        if words.count() == 2 and words[0] == "generation" {
            var written_generation = words[1].to_integer()
            crash written_generation
            generation = written_generation
        } else if words.count() >= 3 and words[0] == "fields" {
            var line_length = line.length()
            var signature_start = words[0].length() + words[1].length() + 2
            var class_name = words[1]
            running_fields[class_name] = line.slice(signature_start, line_length)
        } else if words.count() >= 3 and words[0] == "breakpoint" {
            var line_length = line.length()
            var site = line.slice(11, line_length)
            running_breakpoints.append(site)
        } else if words.count() >= 3 and words[0] == "file" {
            var line_length = line.length()
            var path_start = words[0].length() + words[1].length() + 2
            var path = line.slice(path_start, line_length)
            running_hashes[path] = words[1]
        }
        index = index + 1
    }
}

func state_text(next_generation: Integer, paths: List<String>, hashes: List<String>): String {
    var lines = List<String>()
    lines.append("generation {next_generation}")
    var index = 0
    while index < paths.count() and index < hashes.count() {
        lines.append("file {hashes[index]} {paths[index]}")
        index = index + 1
    }
    return lines.join("\n")
}

func hash_of(text: String): String {
    var hash: Long = 7
    var index = 0
    var text_length = text.length()
    while index < text_length {
        var code = text.code_at(index)
        hash = (hash * 31 + code) % 4294967291
        index = index + 1
    }
    return hash
}

func is_changed(path: String, hash: String): Boolean {
    if running_hashes[path] {
        return running_hashes[path] != hash
    }
    return true
}

func host_enum_numbers(c_name: String): Dictionary<Integer> {
    var numbers = Dictionary<Integer>()
    var layout = host_layouts[c_name]
    if not layout {
        return numbers
    }
    var entries = layout.split(",")
    var index = 0
    while index < entries.count() {
        var entry = entries[index].replace("typedef enum \{", "").trim()
        var equals = entry.index_of(" = ")
        var prefix = "{c_name}_"
        if equals > 0 and entry.starts_with(prefix) {
            var prefix_length = prefix.length()
            var name = entry.slice(prefix_length, equals)
            var entry_length = entry.length()
            var number = entry.slice(equals + 3, entry_length).trim().to_integer()
            if number {
                numbers[name] = number
            }
        }
        index = index + 1
    }
    return numbers
}

func layout_problem(typedefs: List<String>, moving: List<String>): String {
    var changed = List<String>()
    var index = 0
    while index < typedefs.count() {
        var written_typedef = typedefs[index]
        var name = layout_name(written_typedef)
        var stable_enum = written_typedef.starts_with("typedef enum")
        if host_layouts[name] and not moving.contains(name) and not stable_enum {
            var layout = written_typedef.replace("\n", " ")
            var class_name = name.replace("_", ".")
            if host_layouts[name] != layout {
                changed.append(class_name)
            }
        }
        index = index + 1
    }
    if changed.is_empty() {
        return ""
    }
    return "the attributes of {changed.join(", ")} changed, and the running program's instances were made with the old ones: restart the program to change a class's attributes or enums, or undo that part of the change to reload the rest"
}

func new_prototypes(prototype_text: String, shaker: TreeShaker): Dictionary<String> {
    var prototypes = Dictionary<String>()
    var lines = prototype_text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        var name = function_name(line, shaker)
        if name.is_empty() {
            name = running_declared_name(line, shaker)
        }
        if not name.is_empty() and not prototypes.has(name) {
            prototypes[name] = line
        }
        index = index + 1
    }
    return prototypes
}

func running_declared_name(line: String, shaker: TreeShaker): String {
    if not line.ends_with(");") or line.starts_with("#") or line.starts_with("typedef") or line.starts_with("static") {
        return ""
    }
    var name = shaker.declared_name(line)
    if name.is_empty() or host_prototypes[name] != line {
        return ""
    }
    return name
}

func is_bound(name: String, prototypes: Dictionary<String>, local_names: Dictionary<String>): Boolean {
    var running = host_prototypes[name]
    var prototype = prototypes[name]
    if not running or not prototype {
        return false
    }
    return running == prototype and not local_names.has(name) and not name.starts_with("spite_foreign_library_")
}

func split_program(prototype_text: String, bodies: String) {
    split_done = true
    program_shaker = TreeShaker()
    program_shaker.split_pieces(bodies)
    program_prototypes = new_prototypes(prototype_text, program_shaker)
    program_prototype_text = prototype_text
}

func piece_hash(piece: String, constants: Dictionary<String>): String {
    var renamed = Dictionary<String>()
    var hash: UnsignedLong = 1469598103934665603
    var piece_length = piece.length()
    var index = 0
    while index < piece_length {
        var code = piece.code_at(index)
        if is_name_code(code) {
            var start = index
            var name_code = code
            while index < piece_length and is_name_code(name_code) {
                index = index + 1
                name_code = piece.code_at(index)
            }
            hash = mixed_name(hash, piece, start, index, constants, renamed)
        } else {
            hash = hash.bits_exclusive_or(code) * 1099511628211
            index = index + 1
        }
    }
    return hash.to_string()
}

func mixed_name(
    hash: UnsignedLong,
    piece: String,
    start: Integer,
    end: Integer,
    constants: Dictionary<String>,
    renamed: Dictionary<String>,
): UnsignedLong {
    var generated = piece.code_at(start) == 115 and end - start > 7 and piece.matches_at("spite_", start)
    if generated and holds_digit(piece, start + 6, end) {
        var token = piece.slice(start, end)
        var stable = stable_name(token, constants, renamed)
        return mixed_text(hash, stable)
    }
    var mixed = hash
    var position = start
    while position < end {
        var name_code = piece.code_at(position)
        mixed = mixed.bits_exclusive_or(name_code) * 1099511628211
        position = position + 1
    }
    return mixed
}

func holds_digit(piece: String, start: Integer, end: Integer): Boolean {
    var position = start
    while position < end {
        var code = piece.code_at(position)
        if is_digit_code(code) {
            return true
        }
        position = position + 1
    }
    return false
}

func stable_name(token: String, constants: Dictionary<String>, renamed: Dictionary<String>): String {
    if constants[token] {
        return "\"{constants[token]}\""
    }
    if not renamed.has(token) {
        renamed[token] = "spite_#{renamed.count()}"
    }
    crash renamed[token]
    return renamed[token]
}

func mixed_text(hash: UnsignedLong, text: String): UnsignedLong {
    var mixed = hash
    var text_length = text.length()
    var index = 0
    while index < text_length {
        var code = text.code_at(index)
        mixed = mixed.bits_exclusive_or(code) * 1099511628211
        index = index + 1
    }
    return mixed
}

func is_name_code(code: Integer): Boolean {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func is_digit_code(code: Integer): Boolean {
    return code >= 48 and code <= 57
}

func changed_bodies(constants: Dictionary<String>): List<String> {
    var changed = List<String>()
    var index = 0
    while index < program_shaker.pieces.count() {
        crash program_shaker.piece_names[index]
        var name = program_shaker.piece_names[index]
        if not name.is_empty() and host_hashes.has(name) {
            var piece = program_shaker.pieces[index]
            if host_hashes[name] != piece_hash(piece, constants) {
                changed.append(name)
            }
        }
        index = index + 1
    }
    return changed
}

func library_hashes(constants: Dictionary<String>): Dictionary<String> {
    var hashes = Dictionary<String>()
    var index = 0
    while index < library_bodies.count() {
        crash library_body_names[index]
        var name = library_body_names[index]
        var body = library_bodies[index]
        var hash = piece_hash(body, constants)
        var name_length = name.length()
        if name.starts_with("spite_") and holds_digit(name, 6, name_length) {
            var occurrence = 0
            while hashes.has("numbered {hash} {occurrence}") {
                occurrence = occurrence + 1
            }
            hashes["numbered {hash} {occurrence}"] = hash
        } else {
            hashes[name] = hash
        }
        index = index + 1
    }
    return hashes
}

func local_program_text(): String {
    var local = List<String>()
    var index = 0
    while index < program_shaker.pieces.count() {
        var name = program_shaker.piece_names[index]
        crash name
        var bound = not name.is_empty() and host_prototypes.has(name) and host_prototypes[name] == program_prototypes[name]
        if not name.is_empty() and not bound {
            local.append(program_shaker.pieces[index])
        }
        index = index + 1
    }
    return local.join("\n")
}

func changed_signatures(slot_names: List<String>, slot_owners: List<String>, rebuilt: List<String>): List<String> {
    var changed = List<String>()
    var index = 0
    while index < slot_names.count() and index < slot_owners.count() {
        var name = slot_names[index]
        var added_later = not host_slots.has(name)
        if rebuilt.contains(slot_owners[index]) and (added_later or host_prototypes[name] != program_prototypes[name]) {
            changed.append(name)
        }
        index = index + 1
    }
    return changed
}

func callers_of(
    changed: List<String>,
    slot_names: List<String>,
    slot_owners: List<String>,
    rebuilt: List<String>,
): List<String> {
    var callers = List<String>()
    var index = 0
    while index < slot_names.count() and index < slot_owners.count() {
        var owner = slot_owners[index]
        var hot_name = "{slot_names[index]}___hot"
        var hot_name_length = hot_name.length()
        var position = program_shaker.find_function(hot_name, 0, hot_name_length)
        if position >= 0 and not rebuilt.contains(owner) and not callers.contains(owner) {
            crash program_shaker.pieces[position]
            if mentions_any(program_shaker.pieces[position], changed) {
                callers.append(owner)
            }
        }
        index = index + 1
    }
    return callers
}

func mentions_any(text: String, names: List<String>): Boolean {
    var index = 0
    while index < names.count() {
        if text.contains("{names[index]}(") {
            return true
        }
        index = index + 1
    }
    return false
}

func library(
    builder: CodeBuilder,
    slot_names: List<String>,
    slot_owners: List<String>,
    rebuilt: List<String>,
    local_only: List<String>,
): String {
    var shaker = program_shaker
    var prototypes = program_prototypes
    var prototype_text = program_prototype_text
    var local_names = Dictionary<String>()
    var roots = List<Integer>()
    var index = 0
    while index < slot_names.count() and index < slot_owners.count() {
        var name = slot_names[index]
        var hot_name = "{name}___hot"
        var hot_name_length = hot_name.length()
        var position = shaker.find_function(hot_name, 0, hot_name_length)
        var running = host_prototypes[name]
        if rebuilt.contains(slot_owners[index]) and position >= 0 and host_slots.has(name) and running == prototypes[name] {
            local_names[hot_name] = hot_name
            installed.append(name)
            roots.append(position)
        } else if rebuilt.contains(slot_owners[index]) and not host_slots.has(name) {
            added.append(name)
        }
        index = index + 1
    }
    index = 0
    while index < local_only.count() {
        var local_name = local_only[index]
        local_names[local_name] = local_name
        index = index + 1
    }
    var migration_position = shaker.find_function("spite_migrate_all", 0, 17)
    var migrates = migration_position >= 0
    if migrates {
        roots.append(migration_position)
    }
    var running_slots = host_slots.keys()
    index = 0
    while index < running_slots.count() {
        var running_slot = running_slots[index]
        var owner_rebuilt = owner_is_rebuilt(running_slot, rebuilt)
        if owner_rebuilt and not slot_names.contains(running_slot) {
            crash host_slots[running_slot]
            removed.append(host_slots[running_slot])
        }
        index = index + 1
    }
    var bound = List<Boolean>()
    add_host_pieces(shaker, prototypes)
    index = 0
    while index < shaker.pieces.count() {
        crash shaker.piece_names[index]
        var name = shaker.piece_names[index]
        var binds = not name.is_empty() and is_bound(name, prototypes, local_names)
        bound.append(binds)
        shaker.kept[index] = name.is_empty() or counts_memory(name)
        index = index + 1
    }
    index = 0
    while index < roots.count() {
        shaker.keep_function(roots[index])
        index = index + 1
    }
    var redirected = List<String>()
    while not shaker.waiting.is_empty() {
        var next = shaker.waiting.remove_last()
        crash next
        crash shaker.piece_names[next]
        crash shaker.pieces[next]
        if bound[next] == true {
            redirected.append(shaker.piece_names[next])
        } else {
            shaker.keep_named_in(shaker.pieces[next])
            var hot_name = "{shaker.piece_names[next]}___hot"
            var hot_name_length = hot_name.length()
            var hot_position = shaker.find_function(hot_name, 0, hot_name_length)
            if hot_position >= 0 {
                shaker.keep_function(hot_position)
            }
        }
    }
    var roots = List<String>()
    index = 0
    while index < builder.slot_lines.count() and index < builder.slot_names.count() {
        var name = builder.slot_names[index]
        var name_length = name.length()
        var position = shaker.find_function(name, 0, name_length)
        if position >= 0 and shaker.kept[position] == true and bound[position] == false {
            roots.append(builder.slot_lines[index])
        }
        index = index + 1
    }
    index = 0
    while index < redirected.count() {
        var name = redirected[index]
        roots.append("static __typeof__({name})* spite_host_{name} = 0;\n#define {name} (*spite_host_{name})")
        index = index + 1
    }
    index = 0
    while index < shaker.pieces.count() {
        crash shaker.piece_names[index]
        var name = shaker.piece_names[index]
        var local = not name.is_empty() and not counts_memory(name)
        if local and shaker.kept[index] == true and bound[index] == false {
            roots.append(shaker.pieces[index])
            library_bodies.append(shaker.pieces[index])
            library_body_names.append(name)
        }
        index = index + 1
    }
    var bind_code = bind_function(redirected, migrates)
    roots.append(bind_code)
    var root_text = roots.join("\n")
    var joined_typedefs = builder.typedefs.join("\n")
    var typedef_shaker = TreeShaker()
    var typedef_text = builder.guarded_types(joined_typedefs, typedef_shaker, true)
    var declaration_shaker = TreeShaker()
    declaration_shaker.shaken_macros = builder.shaken_macros
    declaration_shaker.shake_declarations(typedef_text, prototype_text, root_text)
    var parts = List<String>()
    parts.append("#define SPITE_RELOADED")
    if builder.threads {
        parts.append("#define SPITE_THREADS")
    }
    var kept_types = declaration_shaker.kept_types()
    parts.append(kept_types)
    var kept_prototypes = declaration_shaker.kept_prototypes(prototype_text)
    parts.append(kept_prototypes)
    parts.append(root_text)
    return "{parts.join("\n")}\n"
}

func add_host_pieces(shaker: TreeShaker, prototypes: Dictionary<String>) {
    var index = 0
    while index < host_names.count() {
        var name = host_names[index]
        var name_length = name.length()
        if prototypes[name] and host_prototypes[name] == prototypes[name] and shaker.find_function(name, 0, name_length) < 0 {
            var position = shaker.pieces.count()
            shaker.add_function(name, position)
            shaker.pieces.append("")
            shaker.piece_names.append(name)
            shaker.next_same.append(-1)
            shaker.kept.append(false)
        }
        index = index + 1
    }
}

func owner_is_rebuilt(slot: String, rebuilt: List<String>): Boolean {
    if not host_slot_owners[slot] {
        return true
    }
    return rebuilt.contains(host_slot_owners[slot])
}

func counts_memory(name: String): Boolean {
    return name.starts_with("spite_debug_") or name.starts_with("spite_allocation_table")
}

func bind_function(redirected: List<String>, migrates: Boolean): String {
    var lines = List<String>()
    lines.append("#ifdef _WIN32")
    lines.append("__declspec(dllexport)")
    lines.append("#else")
    lines.append("__attribute__((visibility(\"default\")))")
    lines.append("#endif")
    lines.append("const char* spite_reload_bind(void* (*find)(const char*), int32_t (*install)(const char*, void*)) \{")
    lines.append("spite_host_realloc = (void* (*)(void*, size_t))find(\"spite_hot_realloc\");")
    lines.append("spite_host_free = (void (*)(void*))find(\"spite_hot_free\");")
    lines.append("if (spite_host_realloc == 0 || spite_host_free == 0) return \"spite_hot_realloc\";")
    var index = 0
    while index < redirected.count() {
        var name = redirected[index]
        lines.append(
            "spite_host_{name} = (__typeof__(spite_host_{name}))find(\"{name}\"); if (spite_host_{name} == 0) return \"{name}\";",
        )
        index = index + 1
    }
    index = 0
    while index < installed.count() {
        var checked = installed[index]
        lines.append("if (install(\"{checked}\", 0) == 0) return \"{checked}\";")
        index = index + 1
    }
    index = 0
    while index < installed.count() {
        var name = installed[index]
        lines.append("install(\"{name}\", (void*)&{name}___hot);")
        index = index + 1
    }
    if migrates {
        lines.append("return spite_migrate_all();")
    } else {
        lines.append("return 0;")
    }
    lines.append("}")
    return lines.join("\n")
}
