var edge_callers = List<String>()
var edge_callees = List<String>()
var edge_keys = Dictionary<Boolean>()
var shape_callers = List<String>()
var shape_callees = List<String>()
var counted = -1
var callers_of = Dictionary<List<String>>()
var indexed_calls = 0
var indexed_values = 0
var waits = Dictionary<Boolean>()
var answers = Dictionary<Boolean>()
var asked_names = List<String>()
var asked_texts = List<String>()
var asked_paths = List<String>()
var asked_lines = List<Integer>()
var asked_owners = List<String>()
var asked_functions = List<String>()

func add_edge(caller: String, callee: String) {
    var key = "{caller} {callee}"
    if not edge_keys.has(key) {
        edge_keys.set(key, true)
        edge_callers.append(caller)
        edge_callees.append(callee)
    }
}

func add_shape_edge(caller: String, callee: String) {
    shape_callers.append(caller)
    shape_callees.append(callee)
}

func settle(call_callers: List<String>, call_callees: List<String>, seeds: List<String>) {
    var size = call_callers.count() + edge_callers.count() + shape_callers.count() + seeds.count()
    assert size != counted
    counted = size
    waits = Dictionary<Boolean>()
    indexed_calls = add_reverse_edges(callers_of, call_callers, call_callees, indexed_calls)
    indexed_values = add_reverse_edges(callers_of, edge_callers, edge_callees, indexed_values)
    var shape_callers_of = Dictionary<List<String>>()
    add_reverse_edges(shape_callers_of, shape_callers, shape_callees, 0)
    var pending = List<String>()
    var index = 0
    while index < seeds.count() {
        var seed = seeds[index]
        if not waits.has(seed) {
            waits.set(seed, true)
            pending.append(seed)
        }
        index = index + 1
    }
    while not pending.is_empty() {
        var name = pending.remove_last()
        crash name
        wake_callers(callers_of[name], pending)
        wake_callers(shape_callers_of[name], pending)
    }
}

func wake_callers(callers: List<String>?, pending: List<String>) {
    assert callers
    var index = 0
    while index < callers.count() {
        var caller = callers[index]
        if not waits.has(caller) {
            waits.set(caller, true)
            pending.append(caller)
        }
        index = index + 1
    }
}

func add_reverse_edges(
    reverse: Dictionary<List<String>>,
    callers: List<String>,
    callees: List<String>,
    first: Integer,
): Integer {
    var index = first
    while index < callers.count() {
        crash callees[index]
        var callee = callees[index]
        if not reverse.has(callee) {
            var fresh = List<String>()
            reverse[callee] = fresh
        }
        var caller = callers[index]
        var listed = reverse[callee]
        crash listed
        listed.append(caller)
        index = index + 1
    }
    return index
}

func may_wait(name: String): Boolean {
    return waits.has(name)
}

func answer(name: String, text: String, path: String, line: Integer, owner: String, function: String): Boolean {
    if answers.has(name) {
        return answers[name] == true
    }
    var answered = waits.has(name)
    answers.set(name, answered)
    asked_names.append(name)
    asked_texts.append(text)
    asked_paths.append(path)
    asked_lines.append(line)
    asked_owners.append(owner)
    asked_functions.append(function)
    return answered
}

func first_changed_answer(): Integer {
    var index = 0
    while index < asked_names.count() {
        var name = asked_names[index]
        if answers[name] == true != waits.has(name) {
            return index
        }
        index = index + 1
    }
    return -1
}
