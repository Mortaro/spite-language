var reasons = Dictionary<String, String>()
var settled = Dictionary<String, Boolean>()
var studied = Dictionary<String, Boolean>()
var studying = Dictionary<String, Boolean>()
var round_keys = List<String>()
var grew = false

func answer(generator: Generator, owner: Analysis.ClassInfo, function: Analysis.FunctionInfo, slot: String): Boolean {
    grew = true
    while grew {
        grew = false
        studied = Dictionary<String, Boolean>()
        round_keys.clear()
        summarize(generator, owner, function)
    }
    var index = 0
    while index < round_keys.count() {
        var round_key = round_keys[index]
        settled[round_key] = true
        index = index + 1
    }
    return writes(function.c_name, slot)
}

func summarize(generator: Generator, owner: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var key = function.c_name
    assert not settled.has(key) and not studied.has(key) and not studying.has(key)
    studying[key] = true
    round_keys.append(key)
    if function.has_body {
        var study = ParameterWriteStudy(generator, this, owner, function)
        study.run()
    } else {
        summarize_supplied(function)
    }
    studying.remove(key)
    studied[key] = true
}

func summarize_supplied(function: Analysis.FunctionInfo) {
    record(function.c_name, "r:this", "returns it")
    var returned_index = 0
    while returned_index < function.parameters.count() {
        record(function.c_name, "r:{returned_index}", "returns it")
        returned_index = returned_index + 1
    }
    var writing = [
        "resize"
        "free"
        "copy_to"
        "exchange_long"
        "write_long_atomically"
        "add_long_atomically"
        "compare_and_swap_long"
        "write_value"
        "release_value"
        "write_item"
        "copy_item"
        "release_item"
        "release_work"
        "step_frame"
        "_start_frame"
        "_release_box"
        "assign"
        "call_function"
        "call_with_text"
        "install"
        "close_library"
    ]
    var reason = "'{function.name}' writes the memory it is handed"
    if not writing.contains(function.name) and not function.name.starts_with("write_") {
        assert not reads_only(function.name)
        reason = "'{function.name}' is supplied by the compiler, and nothing proves it leaves what it is handed unchanged"
    }
    record(function.c_name, "this", reason)
    var index = 0
    while index < function.parameters.count() {
        var slot: String = index
        record(function.c_name, slot, reason)
        index = index + 1
    }
}

func reads_only(name: String): Boolean {
    var reading = [
        "_box_of"
        "_want_check_point"
        "address"
        "allocate"
        "bits_and"
        "bits_exclusive_or"
        "bits_inverted"
        "bits_or"
        "block_bytes"
        "buffer_memory"
        "build_arguments"
        "class_descriptions"
        "class_names"
        "code_at"
        "compare_bytes"
        "compiler"
        "entry_address"
        "enum_names"
        "find_symbol"
        "get"
        "held_class"
        "held_memory"
        "item_at"
        "item_bytes"
        "item_start"
        "leading_zero_count"
        "live_allocations"
        "live_bytes"
        "loaded_folders"
        "open"
        "open_library"
        "program_file"
        "schema"
        "set_bit_count"
        "shifted_left"
        "shifted_right"
        "singletons"
        "stored_memory"
        "text"
        "to_type"
        "trailing_zero_count"
        "value_attributes"
        "value_bits"
        "value_bytes"
        "value_functions"
        "watcher_entry"
    ]
    return reading.contains(name) or name.starts_with("read_")
}

func record(key: String, slot: String, reason: String) {
    var slot_key = "{key}#{slot}"
    assert not reasons.has(slot_key)
    reasons[slot_key] = reason
    grew = true
}

func writes(key: String, slot: String): Boolean {
    return reasons.has("{key}#{slot}")
}

func reason_of(key: String, slot: String): String {
    var found = reasons["{key}#{slot}"]
    crash found
    return found
}
