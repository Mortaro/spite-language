var parent: Scope? = null
var entry_names = List<String>()
var entry_types = List<Analysis.SpiteType>()
var entry_used = List<Boolean>()
var entry_lines = List<Integer>()
var entry_checked = List<Boolean>()
var entry_parameters = List<Boolean>()
var override_names = List<String>()
var override_codes = List<String>()
var owned = List<OwnedLocal>()
var narrowed_paths = List<String>()
var bound_paths = List<String>()
var bound_reasons = List<String>()
var range_only_paths = List<String>()
var is_loop = false
var rebindings = 0
var paths_read_from_outside = List<String>()
var borrow_names = List<String>()
var borrow_sources = List<String>()
var row_names = List<String>()
var row_sources = List<String>()
var row_paths = List<String>()
var counted_keys = List<String>()
var counted_items = List<String>()

func Scope(starting_parent: Scope?) {
    parent = starting_parent
}

func declare_row(name: String, spite_type: Analysis.SpiteType, sources: String, paths: List<String>) {
    declare_borrowed(name, spite_type, sources)
    row_names.append(name)
    row_sources.append(sources)
    var joined_paths = paths.join("\n")
    row_paths.append(joined_paths)
}

func paths_of_row(name: String): List<String> {
    var index = row_names.count() - 1
    while index >= 0 {
        if row_names[index] == name {
            crash row_paths[index]
            var joined_paths = row_paths[index]
            if joined_paths.is_empty() {
                return List<String>()
            }
            return joined_paths.split("\n")
        }
        index = index - 1
    }
    assert not entry_names.contains(name)
    assert parent
    return parent.paths_of_row(name)
}

func row_source(name: String): String {
    var index = row_names.count() - 1
    while index >= 0 {
        if row_names[index] == name {
            crash row_sources[index]
            return row_sources[index]
        }
        index = index - 1
    }
    assert not entry_names.contains(name)
    assert parent
    return parent.row_source(name)
}

func count_items(key: String, items: String) {
    counted_keys.append(key)
    counted_items.append(items)
}

func counted_items_of(key: String): String {
    var index = counted_keys.count() - 1
    while index >= 0 {
        if counted_keys[index] == key {
            crash counted_items[index]
            return counted_items[index]
        }
        index = index - 1
    }
    assert parent
    return parent.counted_items_of(key)
}

func declare(name: String, spite_type: Analysis.SpiteType) {
    entry_names.append(name)
    entry_types.append(spite_type)
    entry_used.append(false)
    entry_lines.append(0)
    entry_checked.append(false)
    entry_parameters.append(false)
}

func declare_checked(name: String, spite_type: Analysis.SpiteType, line: Integer) {
    declare(name, spite_type)
    entry_lines[entry_lines.count() - 1] = line
    entry_checked[entry_checked.count() - 1] = true
}

func check_last(line: Integer) {
    entry_lines[entry_lines.count() - 1] = line
    entry_checked[entry_checked.count() - 1] = true
}

func check_last_parameter(line: Integer) {
    check_last(line)
    entry_parameters[entry_parameters.count() - 1] = true
}

func mark_used(name: String) {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            entry_used[index] = true
        }
        index = index - 1
    }
    assert parent
    parent.mark_used(name)
}

func forget_owned(name: String) {
    var index = owned.count() - 1
    while index >= 0 {
        crash owned[index]
        if owned[index].name == name {
            owned.remove_at(index)
        }
        index = index - 1
    }
}

func declare_borrowed(name: String, spite_type: Analysis.SpiteType, source: String) {
    declare(name, spite_type)
    borrow_names.append(name)
    borrow_sources.append(source)
}

func borrow_source(name: String): String {
    var index = borrow_names.count() - 1
    while index >= 0 {
        if borrow_names[index] == name {
            crash borrow_sources[index]
            return borrow_sources[index]
        }
        index = index - 1
    }
    assert not entry_names.contains(name)
    assert parent
    return parent.borrow_source(name)
}

func declare_owned(name: String, spite_type: Analysis.SpiteType) {
    declare(name, spite_type)
    var owned_local = OwnedLocal(name, spite_type)
    owned.append(owned_local)
}

func set_override(name: String, code: String) {
    override_names.append(name)
    override_codes.append(code)
}

func lookup_type(name: String): Analysis.SpiteType? {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            mark_used(name)
            return entry_types[index]
        }
        index = index - 1
    }
    if parent {
        return parent.lookup_type(name)
    }
    return null
}

func written_type(name: String): Analysis.SpiteType? {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            return entry_types[index]
        }
        index = index - 1
    }
    if parent {
        return parent.written_type(name)
    }
    return null
}

func lookup_override(name: String): String? {
    var index = override_names.count() - 1
    while index >= 0 {
        if override_names[index] == name {
            return override_codes[index]
        }
        index = index - 1
    }
    if parent {
        return parent.lookup_override(name)
    }
    return null
}

func narrow_path(path: String) {
    var index = range_only_paths.count() - 1
    while index >= 0 {
        if range_only_paths[index] == path {
            range_only_paths.remove_at(index)
        }
        index = index - 1
    }
    if not narrowed_paths.contains(path) {
        narrowed_paths.append(path)
    }
}

func narrow_bound_path(path: String, condition_text: String) {
    var only_in_range = not is_present_narrowed(path)
    narrow_path(path)
    if only_in_range {
        range_only_paths.append(path)
    }
    bound_paths.append(path)
    if is_loop {
        bound_reasons.append("the loop condition '{condition_text}'")
    } else {
        bound_reasons.append("'{condition_text}'")
    }
}

func proof_of(path: String): String {
    var index = bound_paths.count() - 1
    while index >= 0 {
        if bound_paths[index] == path {
            crash bound_reasons[index]
            return bound_reasons[index]
        }
        index = index - 1
    }
    assert parent
    return parent.proof_of(path)
}

func forget_bound(path: String) {
    var index = bound_paths.count() - 1
    while index >= 0 {
        if bound_paths[index] == path {
            bound_paths.remove_at(index)
            bound_reasons.remove_at(index)
        }
        index = index - 1
    }
}

func is_path_narrowed(candidate: String): Boolean {
    return not narrowing_of(candidate).is_empty()
}

func is_present_narrowed(candidate: String): Boolean {
    var index = narrowed_paths.count() - 1
    while index >= 0 {
        crash narrowed_paths[index]
        var narrowed = narrowed_paths[index]
        var reaches = narrowed == candidate or narrowed.starts_with("{candidate}.") or narrowed.starts_with("{candidate}[")
        if reaches and not range_only_paths.contains(narrowed) {
            return true
        }
        index = index - 1
    }
    if parent {
        return parent.is_present_narrowed(candidate)
    }
    return false
}

func narrowing_of(candidate: String): String {
    var index = narrowed_paths.count() - 1
    while index >= 0 {
        crash narrowed_paths[index]
        var narrowed = narrowed_paths[index]
        if narrowed == candidate or narrowed.starts_with("{candidate}.") or narrowed.starts_with("{candidate}[") {
            return narrowed
        }
        index = index - 1
    }
    if parent {
        var answered = parent.narrowing_of(candidate)
        if is_loop and not answered.is_empty() and not paths_read_from_outside.contains(answered) {
            paths_read_from_outside.append(answered)
        }
        return answered
    }
    return ""
}

func forget_path(path: String, include_itself: Boolean, read_by_crossed_loops: List<String>): Boolean {
    var crossed_a_loop = false
    var index = narrowed_paths.count() - 1
    while index >= 0 {
        crash narrowed_paths[index]
        var narrowed = narrowed_paths[index]
        if narrowed.starts_with("{path}.") or narrowed.starts_with("{path}[") or key_mentions(narrowed, path) or include_itself and narrowed == path {
            narrowed_paths.remove_at(index)
            forget_bound(narrowed)
            if read_by_crossed_loops.contains(narrowed) {
                crossed_a_loop = true
            }
        }
        index = index - 1
    }
    if parent {
        var read_above = read_by_crossed_loops.copy()
        if is_loop {
            var read_index = 0
            while read_index < paths_read_from_outside.count() {
                read_above.append(paths_read_from_outside[read_index])
                read_index = read_index + 1
            }
        }
        if parent.forget_path(path, include_itself, read_above) {
            crossed_a_loop = true
        }
    }
    return crossed_a_loop
}

func holds_proofs(): Boolean {
    if not narrowed_paths.is_empty() or not override_names.is_empty() {
        return true
    }
    assert parent
    return parent.holds_proofs()
}

func visible_narrowed_paths(): List<String> {
    var paths = narrowed_paths.copy()
    if parent {
        var above = parent.visible_narrowed_paths()
        var index = 0
        while index < above.count() {
            if not paths.contains(above[index]) {
                paths.append(above[index])
            }
            index = index + 1
        }
    }
    return paths
}

func narrowed_attributes(): List<String> {
    var attributes = List<String>()
    var index = 0
    while index < override_names.count() {
        var name = override_names[index]
        var underlying = unnarrowed_type(name)
        if not underlying and not attributes.contains(name) {
            attributes.append(name)
        }
        index = index + 1
    }
    if parent {
        var above = parent.narrowed_attributes()
        var above_index = 0
        while above_index < above.count() {
            if not attributes.contains(above[above_index]) {
                attributes.append(above[above_index])
            }
            above_index = above_index + 1
        }
    }
    return attributes
}

func path_root(path: String): String {
    var root_end = name_end(path, 0)
    return path.slice(0, root_end)
}

func name_end(text: String, start: Integer): Integer {
    var position = start
    var text_length = text.length()
    var code = text.code_at(position)
    while position < text_length and is_name_code(code) {
        position = position + 1
        code = text.code_at(position)
    }
    return position
}

func key_end(path: String, open_position: Integer): Integer {
    var depth = 0
    var position = open_position
    var path_length = path.length()
    var closed = false
    while position < path_length and not closed {
        var code = path.code_at(position)
        if code == 91 {
            depth = depth + 1
        }
        if code == 93 {
            depth = depth - 1
            closed = depth == 0
        }
        position = position + 1
    }
    return position - 1
}

func key_mentions(narrowed: String, path: String): Boolean {
    var first_key = narrowed.index_of("[")
    assert first_key >= 0
    var path_length = path.length()
    var narrowed_length = narrowed.length()
    var position = first_key + 1
    while position + path_length <= narrowed_length {
        if narrowed.matches_at(path, position) and is_word_start(narrowed, position) {
            var after = position + path_length
            var next_code = narrowed.code_at(after)
            if after == narrowed_length or not is_name_code(next_code) {
                return true
            }
        }
        position = position + 1
    }
    return false
}

func is_word_start(text: String, position: Integer): Boolean {
    var before = text.code_at(position - 1)
    return before != 46 and before != 34 and not is_name_code(before)
}

func is_name_code(code: Integer): Boolean {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func unnarrowed_type(name: String): Analysis.SpiteType? {
    var skipping = override_names.contains(name)
    var index = entry_names.count() - 1
    while index >= 0 {
        crash index < entry_types.count()
        if entry_names[index] == name {
            if skipping {
                skipping = false
            } else {
                return entry_types[index]
            }
        }
        index = index - 1
    }
    if parent {
        return parent.unnarrowed_type(name)
    }
    return null
}

func forget_override(name: String, below_a_loop: Boolean): Boolean {
    var crossed_a_loop = false
    var index = override_names.count() - 1
    while index >= 0 {
        if override_names[index] == name {
            crash index < override_codes.count()
            override_names.remove_at(index)
            override_codes.remove_at(index)
            remove_last_entry(name)
            if below_a_loop {
                crossed_a_loop = true
            }
        }
        index = index - 1
    }
    if parent {
        if parent.forget_override(name, below_a_loop or is_loop) {
            crossed_a_loop = true
        }
    }
    return crossed_a_loop
}

func remove_last_entry(name: String) {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            entry_names.remove_at(index)
            entry_types.remove_at(index)
            entry_used.remove_at(index)
            entry_lines.remove_at(index)
            entry_checked.remove_at(index)
            entry_parameters.remove_at(index)
            return
        }
        index = index - 1
    }
}
