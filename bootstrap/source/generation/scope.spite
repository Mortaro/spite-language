var parent: Scope? = null
var entry_names = List<String>()
var entry_types = List<Analysis.SpiteType>()
var entry_used = List<Bool>()
var entry_lines = List<Int>()
var entry_checked = List<Bool>()
var entry_parameters = List<Bool>()
var override_names = List<String>()
var override_codes = List<String>()
var owned = List<OwnedLocal>()
var narrowed_paths = List<String>()
var bound_paths = List<String>()
var bound_reasons = List<String>()
var is_loop = false
var rebindings = 0
var paths_read_from_outside = List<String>()

func Scope(starting_parent: Scope?) {
    parent = starting_parent
}

func declare(name: String, spite_type: Analysis.SpiteType) {
    entry_names.append(name)
    entry_types.append(spite_type)
    entry_used.append(false)
    entry_lines.append(0)
    entry_checked.append(false)
    entry_parameters.append(false)
}

func declare_checked(name: String, spite_type: Analysis.SpiteType, line: Int) {
    declare(name, spite_type)
    entry_lines[entry_lines.count() - 1] = line
    entry_checked[entry_checked.count() - 1] = true
}

func check_last(line: Int) {
    entry_lines[entry_lines.count() - 1] = line
    entry_checked[entry_checked.count() - 1] = true
}

func check_last_parameter(line: Int) {
    check_last(line)
    entry_parameters[entry_parameters.count() - 1] = true
}

func mark_used(name: String) {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            entry_used[index] = true
        }
        index = index - 1
    }
    assert parent
    parent.mark_used(name)
}

func forget_owned(name: String) {
    var index = owned.count() - 1
    while index >= 0 {
        crash owned[index]
        if owned[index].name == name {
            owned.remove_at(index)
        }
        index = index - 1
    }
}

func declare_owned(name: String, spite_type: Analysis.SpiteType) {
    declare(name, spite_type)
    owned.append(OwnedLocal(name, spite_type))
}

func set_override(name: String, code: String) {
    override_names.append(name)
    override_codes.append(code)
}

func lookup_type(name: String): Analysis.SpiteType? {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            mark_used(name)
            return entry_types[index]
        }
        index = index - 1
    }
    if parent {
        return parent.lookup_type(name)
    }
    return null
}

func written_type(name: String): Analysis.SpiteType? {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            return entry_types[index]
        }
        index = index - 1
    }
    if parent {
        return parent.written_type(name)
    }
    return null
}

func lookup_override(name: String): String? {
    var index = override_names.count() - 1
    while index >= 0 {
        if override_names[index] == name {
            return override_codes[index]
        }
        index = index - 1
    }
    if parent {
        return parent.lookup_override(name)
    }
    return null
}

func narrow_path(path: String) {
    if not narrowed_paths.contains(path) {
        narrowed_paths.append(path)
    }
}

func narrow_bound_path(path: String, condition_text: String) {
    narrow_path(path)
    bound_paths.append(path)
    if is_loop {
        bound_reasons.append("the loop condition '{condition_text}'")
    } else {
        bound_reasons.append("'{condition_text}'")
    }
}

func proof_of(path: String): String {
    var index = bound_paths.count() - 1
    while index >= 0 {
        if bound_paths[index] == path {
            crash bound_reasons[index]
            return bound_reasons[index]
        }
        index = index - 1
    }
    assert parent
    return parent.proof_of(path)
}

func forget_bound(path: String) {
    var index = bound_paths.count() - 1
    while index >= 0 {
        if bound_paths[index] == path {
            bound_paths.remove_at(index)
            bound_reasons.remove_at(index)
        }
        index = index - 1
    }
}

func is_path_narrowed(candidate: String): Bool {
    return not narrowing_of(candidate).is_empty()
}

func narrowing_of(candidate: String): String {
    var index = narrowed_paths.count() - 1
    while index >= 0 {
        crash narrowed_paths[index]
        var narrowed = narrowed_paths[index]
        if narrowed == candidate or narrowed.starts_with("{candidate}.") or narrowed.starts_with("{candidate}[") {
            return narrowed
        }
        index = index - 1
    }
    if parent {
        var answered = parent.narrowing_of(candidate)
        if is_loop and not answered.is_empty() and not paths_read_from_outside.contains(answered) {
            paths_read_from_outside.append(answered)
        }
        return answered
    }
    return ""
}

func forget_path(path: String, include_itself: Bool, read_by_crossed_loops: List<String>): Bool {
    var crossed_a_loop = false
    var index = narrowed_paths.count() - 1
    while index >= 0 {
        crash narrowed_paths[index]
        var narrowed = narrowed_paths[index]
        if narrowed.starts_with("{path}.") or narrowed.starts_with("{path}[") or key_mentions(narrowed, path) or include_itself and narrowed == path {
            narrowed_paths.remove_at(index)
            forget_bound(narrowed)
            if read_by_crossed_loops.contains(narrowed) {
                crossed_a_loop = true
            }
        }
        index = index - 1
    }
    if parent {
        var read_above = read_by_crossed_loops.copy()
        if is_loop {
            var read_index = 0
            while read_index < paths_read_from_outside.count() {
                read_above.append(paths_read_from_outside[read_index])
                read_index = read_index + 1
            }
        }
        if parent.forget_path(path, include_itself, read_above) {
            crossed_a_loop = true
        }
    }
    return crossed_a_loop
}

func key_mentions(narrowed: String, path: String): Bool {
    var first_key = narrowed.index_of("[")
    assert first_key >= 0
    var path_length = path.length()
    var narrowed_length = narrowed.length()
    var position = first_key + 1
    while position + path_length <= narrowed_length {
        if narrowed.matches_at(path, position) and is_word_start(narrowed, position) {
            var after = position + path_length
            var next_code = narrowed.code_at(after)
            if after == narrowed_length or not is_name_code(next_code) {
                return true
            }
        }
        position = position + 1
    }
    return false
}

func is_word_start(text: String, position: Int): Bool {
    var before = text.code_at(position - 1)
    return before != 46 and before != 34 and not is_name_code(before)
}

func is_name_code(code: Int): Bool {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func unnarrowed_type(name: String): Analysis.SpiteType? {
    var skipping = override_names.contains(name)
    var index = entry_names.count() - 1
    while index >= 0 {
        crash index < entry_types.count()
        if entry_names[index] == name {
            if skipping {
                skipping = false
            } else {
                return entry_types[index]
            }
        }
        index = index - 1
    }
    if parent {
        return parent.unnarrowed_type(name)
    }
    return null
}

func forget_override(name: String, below_a_loop: Bool): Bool {
    var crossed_a_loop = false
    var index = override_names.count() - 1
    while index >= 0 {
        if override_names[index] == name {
            crash index < override_codes.count()
            override_names.remove_at(index)
            override_codes.remove_at(index)
            remove_last_entry(name)
            if below_a_loop {
                crossed_a_loop = true
            }
        }
        index = index - 1
    }
    if parent {
        if parent.forget_override(name, below_a_loop or is_loop) {
            crossed_a_loop = true
        }
    }
    return crossed_a_loop
}

func remove_last_entry(name: String) {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            entry_names.remove_at(index)
            entry_types.remove_at(index)
            entry_used.remove_at(index)
            entry_lines.remove_at(index)
            entry_checked.remove_at(index)
            entry_parameters.remove_at(index)
            return
        }
        index = index - 1
    }
}
