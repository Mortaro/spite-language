var parent: Scope? = null
var entry_names = List<String>()
var entry_types = List<Analysis.SpiteType>()
var entry_used = List<Bool>()
var entry_lines = List<Int>()
var entry_checked = List<Bool>()
var override_names = List<String>()
var override_codes = List<String>()
var owned = List<OwnedLocal>()
var narrowed_paths = List<String>()
var is_loop = false
var paths_read_from_outside = List<String>()

func Scope(starting_parent: Scope?) {
    parent = starting_parent
}

func declare(name: String, spite_type: Analysis.SpiteType) {
    entry_names.append(name)
    entry_types.append(spite_type)
    entry_used.append(false)
    entry_lines.append(0)
    entry_checked.append(false)
}

func declare_checked(name: String, spite_type: Analysis.SpiteType, line: Int) {
    declare(name, spite_type)
    entry_lines[entry_lines.count() - 1] = line
    entry_checked[entry_checked.count() - 1] = true
}

func check_last(line: Int) {
    entry_lines[entry_lines.count() - 1] = line
    entry_checked[entry_checked.count() - 1] = true
}

func mark_used(name: String) {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            entry_used[index] = true
        }
        index = index - 1
    }
    assert parent
    parent.mark_used(name)
}

func declare_owned(name: String, spite_type: Analysis.SpiteType) {
    declare(name, spite_type)
    owned.append(OwnedLocal(name, spite_type))
}

func set_override(name: String, code: String) {
    override_names.append(name)
    override_codes.append(code)
}

func lookup_type(name: String): Analysis.SpiteType? {
    var index = entry_names.count() - 1
    while index >= 0 {
        if entry_names[index] == name {
            mark_used(name)
            return entry_types[index]
        }
        index = index - 1
    }
    if parent {
        return parent.lookup_type(name)
    }
    return null
}

func lookup_override(name: String): String? {
    var index = override_names.count() - 1
    while index >= 0 {
        if override_names[index] == name {
            return override_codes[index]
        }
        index = index - 1
    }
    if parent {
        return parent.lookup_override(name)
    }
    return null
}

func narrow_path(path: String) {
    if not narrowed_paths.contains(path) {
        narrowed_paths.append(path)
    }
}

func is_path_narrowed(candidate: String): Bool {
    return not narrowing_of(candidate).is_empty()
}

func narrowing_of(candidate: String): String {
    var index = narrowed_paths.count() - 1
    while index >= 0 {
        crash narrowed_paths[index]
        var narrowed = narrowed_paths[index]
        if narrowed == candidate or narrowed.starts_with("{candidate}.") or narrowed.starts_with("{candidate}[") {
            return narrowed
        }
        index = index - 1
    }
    if parent {
        var answered = parent.narrowing_of(candidate)
        if is_loop and not answered.is_empty() and not paths_read_from_outside.contains(answered) {
            paths_read_from_outside.append(answered)
        }
        return answered
    }
    return ""
}

func forget_path(path: String, include_itself: Bool, read_by_crossed_loops: List<String>): Bool {
    var crossed_a_loop = false
    var index = narrowed_paths.count() - 1
    while index >= 0 {
        crash narrowed_paths[index]
        var narrowed = narrowed_paths[index]
        if narrowed.starts_with("{path}.") or narrowed.starts_with("{path}[") or narrowed.contains("[{path}]") or include_itself and narrowed == path {
            narrowed_paths.remove_at(index)
            if read_by_crossed_loops.contains(narrowed) {
                crossed_a_loop = true
            }
        }
        index = index - 1
    }
    if parent {
        var read_above = read_by_crossed_loops.copy()
        if is_loop {
            var read_index = 0
            while read_index < paths_read_from_outside.count() {
                read_above.append(paths_read_from_outside[read_index])
                read_index = read_index + 1
            }
        }
        if parent.forget_path(path, include_itself, read_above) {
            crossed_a_loop = true
        }
    }
    return crossed_a_loop
}
