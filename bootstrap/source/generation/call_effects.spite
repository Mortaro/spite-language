var shape = Analysis.AstShape()
var by_function = Dictionary<FunctionEffects>()
var function_keys = List<String>()
var field_classes = Dictionary<String>()
var element_classes = Dictionary<String>()
var return_classes = Dictionary<String>()
var class_names = Dictionary<Boolean>()
var plain_fields = Dictionary<Boolean>()
var counted_field_names = Dictionary<Boolean>()
var type_field_classes = Dictionary<String>()
var shared_defaults = Dictionary<Boolean>()
var generator: Generator? = null

func study(class_files: List<Discovery.DiscoveredClass>, studying_generator: Generator) {
    generator = studying_generator
    var index = 0
    while index < class_files.count() {
        var discovered = class_files[index]
        class_names[discovered.qualified_dotted] = true
        index = index + 1
    }
    index = 0
    while index < class_files.count() {
        var discovered = class_files[index]
        var file = discovered.file
        record_fields(file.statements, discovered.qualified_dotted)
        index = index + 1
    }
    var class_index = 0
    while class_index < class_files.count() {
        var discovered = class_files[class_index]
        var file = discovered.file
        study_class(file.statements, discovered.qualified_dotted)
        class_index = class_index + 1
    }
    settle()
    generator = null
}

func class_identity(named: Syntax.Expressions.Expression, from_class: String): String {
    crash generator
    var saved_owner = generator.current_owner
    generator.current_owner = from_class
    var found = generator.try_resolve_static_path(named, from_class)
    generator.current_owner = saved_owner
    if not found {
        return "*"
    }
    return found.qualified_dotted
}

func type_identity(path: List<String>, from_class: String): String {
    crash generator
    var saved_owner = generator.current_owner
    generator.current_owner = from_class
    var joined = path.join(".")
    var found = generator.find_class(joined, from_class)
    var shape_owner = ""
    if not found and path.count() == 1 {
        shape_owner = generator.nearest_declaring_owner(joined, from_class)
    }
    generator.current_owner = saved_owner
    if found {
        return found.qualified_dotted
    }
    if shape_owner.is_empty() {
        return ""
    }
    return "{shape_owner}.{joined}"
}

func allocator_classes(): List<String> {
    crash generator
    crash generator.allocator_union
    return generator.allocator_union.members.map_qualified_dotteds()
}

func effects_of(class_name: String, name: String): List<String> {
    var own = by_function["{class_name}#{name}"]
    if own {
        return own.keys
    }
    var any = by_function["*#{name}"]
    if any {
        return any.keys
    }
    return List<String>()
}

func effects_of_key(key: String): List<String> {
    if by_function[key] {
        return by_function[key].keys
    }
    return List<String>()
}

func effects_key(class_name: String, name: String): String {
    var own_key = "{class_name}#{name}"
    if by_function.has(own_key) {
        return own_key
    }
    var any_key = "*#{name}"
    if by_function.has(any_key) {
        return any_key
    }
    return ""
}

func variadic_position_of(key: String): Integer {
    var effects = by_function[key]
    if not effects or effects.functions_studied != 1 {
        return -2
    }
    return effects.variadic_position
}

func resolved_effects(key: String, classes: DispatchClasses, visiting: List<String>): List<String> {
    var effects = by_function[key]
    assert effects
    if visiting.contains(key) or visiting.count() > 12 or effects.functions_studied != 1 or not classes.any_known() {
        return effects.keys
    }
    visiting.append(key)
    var gathered = FunctionEffects(key)
    effects.own_keys.each(gathered.add)
    var call_index = 0
    while call_index < effects.calls.count() {
        var call = effects.calls[call_index]
        var called_keys = resolved_call_keys(call, effects, classes, visiting)
        var key_index = 0
        while key_index < called_keys.count() {
            var translated = call.translated(called_keys[key_index])
            if not translated.is_empty() {
                gathered.add(translated)
            }
            key_index = key_index + 1
        }
        call_index = call_index + 1
    }
    visiting.remove_last()
    return gathered.keys
}

func resolved_call_keys(
    call: EffectCall,
    caller: FunctionEffects,
    classes: DispatchClasses,
    visiting: List<String>,
): List<String> {
    var callee_key = resolved_key("{call.callee_class}#{call.callee}")
    assert not callee_key.is_empty()
    var dispatched = dispatched_classes(call, caller, classes)
    if not dispatched.is_empty() {
        return dispatched_keys(call.callee, dispatched)
    }
    crash by_function[callee_key]
    var passed = passed_classes(call, by_function[callee_key], classes)
    if passed.any_known() {
        return resolved_effects(callee_key, passed, visiting)
    }
    return by_function[callee_key].keys
}

func dispatched_classes(call: EffectCall, caller: FunctionEffects, classes: DispatchClasses): String {
    var position = call.dispatch_parameter
    if position < 0 {
        return ""
    }
    var position_text: String = position
    if not call.dispatch_element {
        if not caller.kept_values.has(position_text) {
            return ""
        }
        return classes.value_at(position)
    }
    var seen = List<String>()
    if not list_kept_through(caller.key, position, seen) {
        return ""
    }
    return classes.element_at(position)
}

func dispatched_keys(name: String, dispatched: String): List<String> {
    var gathered = FunctionEffects(name)
    var class_list = dispatched.split(",")
    var index = 0
    while index < class_list.count() {
        var dispatched_key = resolved_key("{class_list[index]}#{name}")
        if by_function[dispatched_key] {
            by_function[dispatched_key].keys.each(gathered.add)
        }
        index = index + 1
    }
    return gathered.keys
}

func passed_classes(call: EffectCall, callee: FunctionEffects, classes: DispatchClasses): DispatchClasses {
    var argument_count = call.arguments.count()
    var passed = DispatchClasses(argument_count)
    if callee.functions_studied != 1 {
        return passed
    }
    var index = 0
    while index < argument_count {
        var argument = call.arguments[index]
        var spread = callee.variadic_position >= 0 and index >= callee.variadic_position
        if argument.starts_with("parameter:") and not spread {
            var argument_length = argument.length()
            var position_text = argument.slice(10, argument_length)
            var position = position_text.to_integer()
            crash position
            passed.values[index] = classes.value_at(position)
            passed.elements[index] = classes.element_at(position)
        }
        index = index + 1
    }
    return passed
}

func list_kept_through(key: String, position: Integer, seen: List<String>): Boolean {
    var effects = by_function[key]
    if not effects or effects.functions_studied != 1 {
        return false
    }
    var position_text: String = position
    if not effects.kept_lists.has(position_text) {
        return false
    }
    var seen_key = "{key}@{position}"
    if seen.contains(seen_key) {
        return true
    }
    seen.append(seen_key)
    var passed_key = "parameter:{position}"
    var call_index = 0
    while call_index < effects.calls.count() {
        var call = effects.calls[call_index]
        var argument_index = 0
        while argument_index < call.arguments.count() {
            if call.arguments[argument_index] == passed_key {
                if not handed_list_kept(call, argument_index, seen) {
                    return false
                }
            }
            argument_index = argument_index + 1
        }
        call_index = call_index + 1
    }
    return true
}

func handed_list_kept(call: EffectCall, argument_index: Integer, seen: List<String>): Boolean {
    var callee_key = "{call.callee_class}#{call.callee}"
    if call.callee_class == "*" or not by_function.has(callee_key) {
        return false
    }
    crash by_function[callee_key]
    if by_function[callee_key].variadic_position >= 0 and argument_index >= by_function[callee_key].variadic_position {
        return false
    }
    return list_kept_through(callee_key, argument_index, seen)
}

func record_fields(statements: List<Syntax.Statements.Statement>, class_name: String) {
    var index = 0
    while index < statements.count() {
        var declared = shape.as_variable_declaration(statements[index])
        if declared {
            var declared_class = declared_class_name(declared, class_name)
            if not declared_class.is_empty() {
                field_classes["{class_name}#{declared.name}"] = declared_class
            }
            var declared_element = declared_element_name(declared, class_name)
            if not declared_element.is_empty() {
                element_classes["{class_name}#{declared.name}"] = declared_element
            }
            if holds_plain_value(declared) {
                plain_fields["{class_name}#{declared.name}"] = true
            } else {
                counted_field_names[declared.name] = true
            }
            if not makes_its_own(declared) {
                shared_defaults["{class_name}#{declared.name}"] = true
            }
        }
        var function = shape.as_function_declaration(statements[index])
        if function {
            record_return(function, class_name)
        }
        var declared_type = shape.as_type_declaration(statements[index])
        if declared_type {
            record_type_fields(declared_type, class_name)
        }
        index = index + 1
    }
}

func record_type_fields(declared_type: Syntax.Statements.TypeDeclaration, class_name: String) {
    var index = 0
    while index < declared_type.fields.count() {
        var field = declared_type.fields[index]
        if field.is_attribute() and field.type_reference {
            var key = "{class_name}.{declared_type.name}#{field.name}"
            var field_class = type_class_name(field.type_reference, class_name)
            if field_class.is_empty() {
                field_class = "*"
            }
            var recorded = type_field_classes[key]
            if recorded and recorded != field_class {
                field_class = "*"
            }
            type_field_classes[key] = field_class
        }
        index = index + 1
    }
}

func holds_plain_value(declaration: Syntax.Statements.VariableDeclaration): Boolean {
    if declaration.type_reference {
        var named = shape.as_named_type(declaration.type_reference)
        if not named or named.path.is_empty() {
            return false
        }
        var plain = [
            "Integer"
            "Long"
            "Short"
            "Tiny"
            "Byte"
            "Float"
            "Double"
            "Boolean"
            "UnsignedInteger"
            "UnsignedLong"
            "UnsignedShort"
            "Address"
            "String"
            "Symbol"
        ]
        var last = named.path.last()
        if not last {
            return false
        }
        return named.arguments.is_empty() and plain.contains(last)
    }
    crash declaration.value
    var value = declaration.value
    if shape.as_integer_literal(value) or shape.as_float_literal(value) or shape.as_string_literal(value) {
        return true
    }
    return shape.is_true_literal(value) or shape.is_false_literal(value)
}

func makes_its_own(declaration: Syntax.Statements.VariableDeclaration): Boolean {
    crash declaration.value
    return is_fresh_value(declaration.value)
}

func is_fresh_value(value: Syntax.Expressions.Expression): Boolean {
    if shape.is_null_literal(value) or shape.as_generic_call(value) or shape.as_list_literal(value) {
        return true
    }
    var called = shape.as_call(value)
    if not called {
        return false
    }
    crash called.callee
    var callee_name = last_name(called.callee)
    return names_a_class(callee_name)
}

func default_is_shared(class_name: String, name: String): Boolean {
    return shared_defaults.has("{class_name}#{name}")
}

func record_return(function: Syntax.Statements.FunctionDeclaration, class_name: String) {
    assert function.return_type
    var returned_class = type_class_name(function.return_type, class_name)
    assert not returned_class.is_empty()
    return_classes["{class_name}#{function.name}"] = returned_class
}

func declared_class_name(declaration: Syntax.Statements.VariableDeclaration, from_class: String): String {
    if declaration.type_reference {
        return type_class_name(declaration.type_reference, from_class)
    }
    crash declaration.value
    return value_class_name(declaration.value, from_class)
}

func type_class_name(type_reference: Syntax.Types.Type, from_class: String): String {
    var named = shape.as_named_type(type_reference)
    if not named {
        return ""
    }
    if named.path.is_empty() {
        return ""
    }
    var last = named.path.last()
    crash last
    if last != "Nullable" {
        return type_identity(named.path, from_class)
    }
    if named.arguments.count() != 1 {
        return ""
    }
    var wrapped = shape.as_type_argument(named.arguments[0])
    if not wrapped {
        return ""
    }
    crash wrapped.value
    return type_class_name(wrapped.value, from_class)
}

func declared_element_name(declaration: Syntax.Statements.VariableDeclaration, from_class: String): String {
    if declaration.type_reference {
        return element_class_name(declaration.type_reference, from_class)
    }
    crash declaration.value
    var constructed = shape.as_generic_call(declaration.value)
    if not constructed or constructed.type_arguments.is_empty() {
        return ""
    }
    var first = shape.as_type_argument(constructed.type_arguments[0])
    if not first {
        return ""
    }
    crash first.value
    return type_class_name(first.value, from_class)
}

func element_class_name(type_reference: Syntax.Types.Type, from_class: String): String {
    var named = shape.as_named_type(type_reference)
    if not named {
        return ""
    }
    if named.path.is_empty() or named.arguments.is_empty() {
        return ""
    }
    var last = named.path.last()
    crash last
    var wrapped = shape.as_type_argument(named.arguments[0])
    if not wrapped {
        return ""
    }
    crash wrapped.value
    if last == "Nullable" {
        return element_class_name(wrapped.value, from_class)
    }
    var collections = ["List", "Vector", "Items", "Dictionary"]
    var collection = type_identity(named.path, from_class)
    if not collections.contains(collection) {
        return ""
    }
    return type_class_name(wrapped.value, from_class)
}

func value_class_name(value: Syntax.Expressions.Expression, from_class: String): String {
    var constructed = shape.as_generic_call(value)
    if constructed {
        crash constructed.callee
        return class_identity(constructed.callee, from_class)
    }
    var listed = shape.as_list_literal(value)
    if listed {
        return "List"
    }
    var called = shape.as_call(value)
    if not called {
        return ""
    }
    crash called.callee
    var callee_name = last_name(called.callee)
    if not names_a_class(callee_name) {
        return ""
    }
    return class_identity(called.callee, from_class)
}

func names_a_class(name: String): Boolean {
    var first_code = name.code_at(0)
    return first_code >= 65 and first_code <= 90
}

func last_name(expression: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(expression)
    if identifier {
        return identifier.name
    }
    var member = shape.as_member(expression)
    if not member {
        return ""
    }
    return member.name
}

func effects_named(class_name: String, name: String): FunctionEffects {
    var key = "{class_name}#{name}"
    if by_function[key] {
        return by_function[key]
    }
    var created = FunctionEffects(key)
    by_function[key] = created
    function_keys.append(key)
    var any_key = "*#{name}"
    var any = by_function[any_key]
    if not any {
        var gathered = FunctionEffects(any_key)
        by_function[any_key] = gathered
        function_keys.append(any_key)
    }
    crash by_function[any_key]
    var no_arguments = List<String>()
    var passed_through = EffectCall(class_name, name, no_arguments)
    passed_through.passes_parameters = true
    by_function[any_key].calls.append(passed_through)
    return created
}

func study_class(statements: List<Syntax.Statements.Statement>, class_name: String) {
    var initializers = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < statements.count() {
        var declared = shape.as_variable_declaration(statements[index])
        if declared {
            crash declared.value
            initializers.append(declared.value)
        }
        index = index + 1
    }
    var dotted = class_name.split(".")
    var constructor_name = dotted.last()
    crash constructor_name
    var constructor_effects = effects_named(class_name, constructor_name)
    var construction = EffectStudy(constructor_effects, class_name, this)
    construction.in_constructor = true
    construction.study_expressions(initializers)
    var function_index = 0
    while function_index < statements.count() {
        var function = shape.as_function_declaration(statements[function_index])
        if function {
            var function_effects = effects_named(class_name, function.name)
            var reader = EffectStudy(function_effects, class_name, this)
            reader.in_constructor = function.name == constructor_name
            reader.take_parameters(function.parameters)
            reader.study_block(function.body)
            reader.keep_parameters(function.parameters, function.body)
        }
        function_index = function_index + 1
    }
}

func settle() {
    var index = 0
    while index < function_keys.count() {
        var function_key = function_keys[index]
        crash by_function[function_key]
        by_function[function_key].own_keys = by_function[function_key].keys.copy()
        link_calls(by_function[function_key])
        index = index + 1
    }
    var waiting = function_keys.copy()
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        crash by_function[key]
        by_function[key].waiting = false
        var fresh = by_function[key].fresh_keys
        by_function[key].fresh_keys = List<String>()
        pass_to_callers(by_function[key], fresh, waiting)
    }
}

func link_calls(effects: FunctionEffects) {
    var call_index = 0
    while call_index < effects.calls.count() {
        var call = effects.calls[call_index]
        call.caller = effects.key
        var callee = by_function["{call.callee_class}#{call.callee}"]
        if not callee {
            callee = by_function["*#{call.callee}"]
        }
        if not callee {
            var singular = singular_template(call.callee_class, call.callee)
            if not singular.is_empty() {
                call.callee = singular
                call.arguments.prepend("fresh")
                callee = by_function["{call.callee_class}#{singular}"]
            }
        }
        if callee {
            callee.incoming.append(call)
        }
        call_index = call_index + 1
    }
}

func singular_template(class_name: String, plural: String): String {
    if class_name == "*" {
        return ""
    }
    var plural_length = plural.length()
    var index = 0
    while index < plural_length {
        if plural.code_at(index) == 115 {
            var candidate = plural.slice(0, index) + plural.slice(index + 1, plural_length)
            if by_function.has("{class_name}#{candidate}") {
                return candidate
            }
        }
        index = index + 1
    }
    return ""
}

func pass_to_callers(changed: FunctionEffects, fresh: List<String>, waiting: List<String>) {
    var call_index = 0
    while call_index < changed.incoming.count() {
        var call = changed.incoming[call_index]
        crash by_function[call.caller]
        var key_index = 0
        while key_index < fresh.count() {
            var translated = call.translated(fresh[key_index])
            if not translated.is_empty() and by_function[call.caller].add(translated) and not by_function[call.caller].waiting {
                by_function[call.caller].waiting = true
                waiting.append(by_function[call.caller].key)
            }
            key_index = key_index + 1
        }
        call_index = call_index + 1
    }
}

func thread_reached_classes(): Dictionary<Boolean> {
    var entries = List<String>()
    var index = 0
    while index < function_keys.count() {
        var function_key = function_keys[index]
        crash by_function[function_key]
        add_taken_entries(by_function[function_key], entries)
        add_parallel_each_entries(by_function[function_key], entries)
        index = index + 1
    }
    return reached_classes(entries)
}

func thread_reached_functions(): Dictionary<Boolean> {
    var entries = List<String>()
    var index = 0
    while index < function_keys.count() {
        var function_key = function_keys[index]
        crash by_function[function_key]
        add_taken_entries(by_function[function_key], entries)
        add_parallel_each_entries(by_function[function_key], entries)
        index = index + 1
    }
    var seen = Dictionary<Boolean>()
    var waiting = entries.copy()
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        if not seen.has(key) {
            seen[key] = true
            if by_function[key] {
                add_callees(by_function[key], waiting)
            }
        }
    }
    return seen
}

func writes_from_reached(class_name: String, reached: Dictionary<Boolean>): Boolean {
    var index = 0
    while index < function_keys.count() {
        var key = function_keys[index]
        var hash = key.index_of("#")
        var writer_class = key.slice(0, hash)
        crash by_function[key]
        if writer_class != class_name and reached.has(key) {
            var names = List<String>()
            add_outside_writes(by_function[key], class_name, names)
            if not names.is_empty() {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func add_taken_entries(effects: FunctionEffects, entries: List<String>) {
    var index = 0
    while index < effects.taken.count() {
        var taken_key = effects.taken[index]
        var resolved = resolved_key(taken_key)
        if not resolved.is_empty() {
            entries.append(resolved)
        }
        index = index + 1
    }
}

func add_parallel_each_entries(effects: FunctionEffects, entries: List<String>) {
    var parallel = false
    var index = 0
    while index < effects.calls.count() {
        var call = effects.calls[index]
        if call.callee.starts_with("parallel_each_") {
            parallel = true
        }
        index = index + 1
    }
    assert parallel
    index = 0
    while index < effects.calls.count() {
        var call = effects.calls[index]
        var callee_length = call.callee.length()
        if call.callee.starts_with("parallel_each_") {
            var member = call.callee.slice(14, callee_length)
            add_any_entry(member, entries)
        } else if call.callee.starts_with("filter_") {
            var filtered = call.callee.slice(7, callee_length)
            add_any_entry(filtered, entries)
        }
        index = index + 1
    }
}

func add_any_entry(name: String, entries: List<String>) {
    var any_key = "*#{name}"
    if by_function.has(any_key) {
        entries.append(any_key)
    }
}

func resolved_key(key: String): String {
    if by_function.has(key) {
        return key
    }
    var hash = key.index_of("#")
    if hash < 0 {
        return ""
    }
    var key_length = key.length()
    var name = key.slice(hash + 1, key_length)
    var any_key = "*#{name}"
    if by_function.has(any_key) {
        return any_key
    }
    return ""
}

func reached_classes(entries: List<String>): Dictionary<Boolean> {
    var classes = Dictionary<Boolean>()
    var seen = Dictionary<Boolean>()
    var waiting = entries.copy()
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        if not seen.has(key) {
            seen[key] = true
            var hash = key.index_of("#")
            var reached_class = key.slice(0, hash)
            classes[reached_class] = true
            if by_function[key] {
                add_callees(by_function[key], waiting)
            }
        }
    }
    return classes
}

func reached_functions(entries: List<String>): Dictionary<Boolean> {
    var seen = Dictionary<Boolean>()
    var waiting = entries.copy()
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        if not seen.has(key) {
            seen[key] = true
            if by_function[key] {
                add_placed_callees(by_function[key], waiting)
            }
        }
    }
    return seen
}

func reached_constructions(entries: List<String>): List<String> {
    var constructed = List<String>()
    var seen = Dictionary<Boolean>()
    var waiting = entries.copy()
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        if not seen.has(key) {
            seen[key] = true
            if by_function[key] {
                add_constructions(by_function[key], constructed)
                add_callees(by_function[key], waiting)
            }
        }
    }
    return constructed
}

func add_constructions(effects: FunctionEffects, constructed: List<String>) {
    var index = 0
    while index < effects.calls.count() {
        var call = effects.calls[index]
        if call.callee == "copy" or call.callee == "deep_copy" {
            constructed.append("*")
        } else if names_a_class(call.callee) {
            constructed.append(call.callee_class)
        }
        index = index + 1
    }
}

func add_placed_callees(effects: FunctionEffects, waiting: List<String>) {
    var index = 0
    while index < effects.calls.count() {
        var call = effects.calls[index]
        var key = "{call.callee_class}#{call.callee}"
        if call.callee_class != "*" and by_function.has(key) {
            waiting.append(key)
        }
        index = index + 1
    }
}

func add_callees(effects: FunctionEffects, waiting: List<String>) {
    var index = 0
    while index < effects.calls.count() {
        var call = effects.calls[index]
        var resolved = resolved_key("{call.callee_class}#{call.callee}")
        if resolved.is_empty() {
            add_template_members(call.callee, waiting)
        } else {
            waiting.append(resolved)
        }
        index = index + 1
    }
}

func add_template_members(callee: String, waiting: List<String>) {
    var callee_length = callee.length()
    var index = 0
    while index < callee_length {
        if callee.code_at(index) == 95 {
            var member = callee.slice(index + 1, callee_length)
            add_any_entry(member, waiting)
        }
        index = index + 1
    }
}

func calls_back_into(class_name: String, name: String): Boolean {
    var effects = by_function["{class_name}#{name}"]
    if effects {
        return reaches_own_class(effects, class_name)
    }
    return true
}

func reaches_own_class(effects: FunctionEffects, class_name: String): Boolean {
    var entries = List<String>()
    var index = 0
    while index < effects.calls.count() {
        var call = effects.calls[index]
        if call.callee_class != class_name {
            add_callee_entry(call, entries)
        }
        index = index + 1
    }
    var reached = reached_classes(entries)
    return reached.has(class_name)
}

func add_callee_entry(call: EffectCall, entries: List<String>) {
    var resolved = resolved_key("{call.callee_class}#{call.callee}")
    if resolved.is_empty() {
        add_template_members(call.callee, entries)
    } else {
        entries.append(resolved)
    }
}

func reached_accesses(entries: List<String>): List<String> {
    var accesses = List<String>()
    var seen = Dictionary<Boolean>()
    var waiting = entries.copy()
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        if not seen.has(key) {
            seen[key] = true
            if by_function[key] {
                by_function[key].member_reads.each(accesses.append)
                by_function[key].member_writes.each(accesses.append)
                add_callees(by_function[key], waiting)
            }
        }
    }
    return accesses
}

func assigned_after_construction(class_name: String, name: String): Boolean {
    var own = "field:{class_name}#{name}"
    var any = "field:*#{name}"
    var index = 0
    while index < function_keys.count() {
        var function_key = function_keys[index]
        crash by_function[function_key]
        if by_function[function_key].own_keys.contains(own) or by_function[function_key].own_keys.contains(any) {
            return true
        }
        index = index + 1
    }
    return false
}

func writes_from_outside(class_name: String): List<String> {
    var names = List<String>()
    var index = 0
    while index < function_keys.count() {
        var key = function_keys[index]
        var hash = key.index_of("#")
        var writer_class = key.slice(0, hash)
        crash by_function[key]
        if writer_class != class_name and writer_class != "*" {
            add_outside_writes(by_function[key], class_name, names)
        }
        index = index + 1
    }
    return names
}

func add_outside_writes(effects: FunctionEffects, class_name: String, names: List<String>) {
    var index = 0
    while index < effects.member_writes.count() {
        var written = effects.member_writes[index]
        var hash = written.index_of("#")
        var owner = written.slice(0, hash)
        var written_length = written.length()
        if owner == class_name or owner == "*" {
            var name = written.slice(hash + 1, written_length)
            names.append(name)
        }
        index = index + 1
    }
}
