var typedefs = List<String>()
var prototypes = List<String>()
var support_bodies = List<String>()
var user_bodies = List<String>()
var main_lines = List<String>()
var slot_lines = List<String>()
var slot_names = List<String>()
var binding_names = List<String>()
var binding_lines = Dictionary<String>()
var guard_names = List<String>()
var guard_lines = List<String>()
var shakes = true
var threads = false
var hot_reload = false
var host = HotReloadLibrary()
var mentioned_names = Dictionary<Bool>()
var scanned_typedefs = 0
var scanned_support = 0
var scanned_user = 0
var scanned_main = 0
var scanned_slots = 0

func mentions(name: String): Bool {
    scanned_typedefs = scan_from(typedefs, scanned_typedefs)
    scanned_support = scan_from(support_bodies, scanned_support)
    scanned_user = scan_from(user_bodies, scanned_user)
    scanned_main = scan_from(main_lines, scanned_main)
    scanned_slots = scan_from(slot_lines, scanned_slots)
    return mentioned_names.has(name)
}

func scan_from(lines: List<String>, start: Int): Int {
    var index = start
    while index < lines.count() {
        scan_names(lines[index])
        index = index + 1
    }
    return index
}

func scan_names(line: String) {
    var line_length = line.length()
    var start = -1
    var position = 0
    while position <= line_length {
        var code = line.code_at(position)
        var inside = position < line_length and is_name_code(code)
        if inside and start < 0 {
            start = position
        }
        if not inside and start >= 0 {
            var name = line.slice(start, position)
            mentioned_names.set(name, true)
            start = -1
        }
        position = position + 1
    }
}

func is_name_code(code: Int): Bool {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func add_typedef(line: String) {
    typedefs.append(line)
}

func typedef_count(): Int {
    return typedefs.count()
}

func replace_typedef(position: Int, line: String) {
    typedefs.set_at(position, line)
}

func add_prototype(line: String) {
    prototypes.append(line)
}

func add_slot(name: String, line: String) {
    slot_names.append(name)
    slot_lines.append(line)
}

func add_support(line: String) {
    support_bodies.append(line)
}

func support_count(): Int {
    return support_bodies.count()
}

func typedef_at(position: Int): String {
    return typedefs.get_at(position)
}

func support_at(position: Int): String {
    return support_bodies.get_at(position)
}

func replace_support(position: Int, line: String) {
    support_bodies.set_at(position, line)
}

func add_user(line: String) {
    user_bodies.append(line)
}

func user_count(): Int {
    return user_bodies.count()
}

func replace_user(position: Int, line: String) {
    user_bodies.set_at(position, line)
}

func add_main(line: String) {
    main_lines.append(line)
}

func add_main_if_kept(guard: String, line: String) {
    var position = guard_names.count()
    guard_names.append(guard)
    guard_lines.append(line)
    main_lines.append("/*spite_guard {position}*/")
}

func guarded(text: String, shaker: TreeShaker, keeps_all: Bool): String {
    if guard_names.is_empty() {
        return text
    }
    var parts = text.split("/*spite_guard ")
    var result = List<String>()
    var index = 0
    while index < parts.count() {
        var part = parts.get_at(index)
        if index == 0 {
            result.append(part)
        } else {
            var end = part.index_of("*/")
            var digits = part.slice(0, end)
            var position = digits.to_int()
            var part_length = part.length()
            var rest = part.slice(end + 2, part_length)
            var guard = guard_names.get_at(position)
            if keeps_all or shaker.is_kept_name(guard) {
                var line = guard_lines.get_at(position)
                result.append(line)
            }
            result.append(rest)
        }
        index = index + 1
    }
    return result.join("")
}

func render(): String {
    var main_text = List<String>()
    main_text.append("int main(int argument_count, char** argument_values) \{")
    main_text.append(
        "spite_program_arguments = (SpiteArguments)\{ .count = argument_count - 1, .items = (const char**)(argument_values + 1) };",
    )
    main_text.append("#ifdef _WIN32\n_setmode(_fileno(stdout), _O_BINARY);\n#endif")
    var joined_main_lines = main_lines.join("\n")
    main_text.append(joined_main_lines)
    main_text.append("return 0;\n}")
    var main_function = main_text.join("\n")
    var typedef_text = typedefs.join("\n")
    var prototype_lines = prototypes.join("\n")
    var bodies = unbound_bodies_text()
    if shakes {
        var shaker = TreeShaker()
        shaker.watched_names = binding_names
        shaker.guard_names = guard_names
        shaker.guard_lines = guard_lines
        bodies = shaker.shake_program(typedef_text, prototype_lines, main_function, bodies)
        main_function = guarded(main_function, shaker, false)
        typedef_text = shaker.kept_types()
        prototype_lines = shaker.kept_prototypes(prototype_lines)
        var kept_bindings = shaker.kept_watched_names()
        bodies = bound(bodies, kept_bindings)
    } else {
        bodies = bound(bodies, binding_names)
        var unused_shaker = TreeShaker()
        main_function = guarded(main_function, unused_shaker, true)
    }
    var threads_line = ""
    if threads {
        threads_line = "#define SPITE_THREADS\n"
    }
    var slot_text = ""
    if hot_reload {
        slot_text = "{slot_lines.join("\n")}\n"
        host.record_host(prototype_lines, bodies)
        var symbol_table = host.symbol_table()
        bodies = "{bodies}\n{symbol_table}"
    }
    return "{threads_line}{typedef_text}\n{prototype_lines}\n{slot_text}{bodies}\n{main_function}\n"
}

func bodies_text(): String {
    var unbound = unbound_bodies_text()
    return bound(unbound, binding_names)
}

func unbound_bodies_text(): String {
    return "{support_bodies.join("\n")}\n{user_bodies.join("\n")}"
}

func add_binding(name: String, line: String): String {
    binding_names.append(name)
    binding_lines[name] = line
    return "/*spite_binding {name}*/"
}

func bound(text: String, kept_names: List<String>): String {
    if binding_names.is_empty() {
        return text
    }
    var parts = text.split("/*spite_binding ")
    var result = List<String>()
    var index = 0
    while index < parts.count() {
        var part = parts.get_at(index)
        if index == 0 {
            result.append(part)
        } else {
            var kept = kept_binding(part, kept_names)
            result.append(kept)
        }
        index = index + 1
    }
    return result.join("")
}

func kept_binding(part: String, kept_names: List<String>): String {
    var end = part.index_of("*/")
    var name = part.slice(0, end)
    var part_length = part.length()
    var rest = part.slice(end + 2, part_length)
    var line = binding_lines[name]
    if line and kept_names.contains(name) {
        return "{line}{rest}"
    }
    return rest
}
