var code = ""
var spite_type: Analysis.SpiteType? = null
var owning_override: Boolean? = null
var constant_text = ""
var peek_union: Analysis.UnionInfo? = null
var peek_field = ""
var peek_object = ""
var borrowed_from = ""

func ExpressionResult(starting_code: String, starting_spite_type: Analysis.SpiteType) {
    code = starting_code
    spite_type = starting_spite_type
}

func get_type(): Analysis.SpiteType {
    crash spite_type
    return spite_type
}
