var code = ""
var spite_type: Analysis.SpiteType? = null
var owning_override: Bool? = null
var constant_text = ""

func ExpressionResult(starting_code: String, starting_spite_type: Analysis.SpiteType) {
    code = starting_code
    spite_type = starting_spite_type
}

func get_type(): Analysis.SpiteType {
    var value = spite_type
    crash value
    return value
}
