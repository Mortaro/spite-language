var key = ""
var keys = List<String>()
var key_set = Dictionary<Boolean>()
var fresh_keys = List<String>()
var calls = List<EffectCall>()
var incoming = List<EffectCall>()
var taken = List<String>()
var member_writes = List<String>()
var waiting = true

func FunctionEffects(function_key: String) {
    key = function_key
}

func add(added: String): Boolean {
    if key_set.has(added) {
        return false
    }
    key_set.set(added, true)
    keys.append(added)
    fresh_keys.append(added)
    return true
}
