var values = List<String>()
var elements = List<String>()

func DispatchClasses(count: Integer) {
    var index = 0
    while index < count {
        values.append("")
        elements.append("")
        index = index + 1
    }
}

func any_known(): Boolean {
    var index = 0
    while index < values.count() {
        var value = value_at(index)
        var element = element_at(index)
        if not value.is_empty() or not element.is_empty() {
            return true
        }
        index = index + 1
    }
    return false
}

func value_at(position: Integer): String {
    if position < 0 or position >= values.count() {
        return ""
    }
    var value = values[position]
    return value
}

func element_at(position: Integer): String {
    if position < 0 or position >= elements.count() {
        return ""
    }
    var element = elements[position]
    return element
}
