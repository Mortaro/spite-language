var prefix = ""
var member_type: Analysis.SpiteType? = null
var read = ""
var owner_name = ""

func FusedStep(starting_prefix: String, starting_member_type: Analysis.SpiteType, starting_read: String) {
    prefix = starting_prefix
    member_type = starting_member_type
    read = starting_read
}

func get_member_type(): Analysis.SpiteType {
    crash member_type
    return member_type
}

func read_of(current_name: String): String {
    if owner_name.is_empty() {
        return "{current_name}.{read}"
    }
    if read.is_empty() {
        return "{owner_name}({current_name})"
    }
    return "{owner_name}.{read}({current_name})"
}
