func check_abbreviations(name: String) {
    var short_words = abbreviated_words()
    var full_words = unabbreviated_words()
    check_abbreviations_in(name, short_words, full_words)
    var spelled_short_words = spelled_out_abbreviations()
    var spelled_full_words = spelled_out_words()
    check_abbreviations_in(name, spelled_short_words, spelled_full_words)
}

func check_abbreviations_in(name: String, short_words: List<String>, full_words: List<String>) {
    var words = words_of(name)
    var index = 0
    while index < words.count() {
        var position = 0
        while position < short_words.count() {
            if short_words[position] == words[index] {
                crash full_words[position]
                report(
                    "'{name}' abbreviates: write '{full_words[position]}' instead of '{words[index]}'. Spite has no abbreviations outside its own keywords",
                )
            }
            position = position + 1
        }
        index = index + 1
    }
}

func report_shadowed_functions(discovered: List<Discovery.DiscoveredClass>) {
    discovered.each(report_shadows_in)
}

func report_shadows_in(entry: Discovery.DiscoveredClass) {
    var file = entry.file
    current_owner = entry.qualified_dotted
    current_function = ""
    var function_names = List<String>()
    var index = 0
    while index < file.statements.count() {
        var declared_function = shape.as_function_declaration(file.statements[index])
        if declared_function {
            function_names.append(declared_function.name)
        }
        index = index + 1
    }
    var statement_index = 0
    while statement_index < file.statements.count() {
        var statement = file.statements[statement_index]
        report_shadows_in_member(statement, file.path, function_names)
        statement_index = statement_index + 1
    }
}

func report_shadows_in_member(statement: Syntax.Statements.Statement, file_path: String, function_names: List<String>) {
    current_path = file_path
    current_line = statement.line
    var attribute = shape.as_variable_declaration(statement)
    if attribute {
        if not attribute.source_path.is_empty() {
            current_path = attribute.source_path
        }
        report_shadow(attribute.name, "attribute", function_names)
        return
    }
    var function = shape.as_function_declaration(statement)
    assert function
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    current_function = function.name
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        report_shadow(function.parameters[parameter_index].name, "parameter", function_names)
        parameter_index = parameter_index + 1
    }
    report_shadowing_locals(function.body, function_names)
    current_function = ""
}

func report_shadowing_locals(statements: List<Syntax.Statements.Statement>, function_names: List<String>) {
    var index = 0
    while index < statements.count() {
        report_shadowing_statement(statements[index], function_names)
        index = index + 1
    }
}

func report_shadowing_statement(statement: Syntax.Statements.Statement, function_names: List<String>) {
    current_line = statement.line
    switch statement {
        Syntax.Statements.VariableDeclaration: report_shadow(statement.name, "variable", function_names)
        Syntax.Statements.IfStatement: {
            report_shadowing_locals(statement.then_branch, function_names)
            report_shadowing_locals(statement.else_branch, function_names)
        }
        Syntax.Statements.WhileStatement: report_shadowing_locals(statement.body, function_names)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                report_shadowing_locals(statement.cases[case_index].body, function_names)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func report_shadow(name: String, what: String, function_names: List<String>) {
    assert function_names.contains(name)
    report(
        "the {what} '{name}' has the name of a function of this class, and a function is a value passed by its name: give the {what} a name of its own",
    )
}

# ../../../specs/standard_library.md#the-string-class
func read_inflection_words(declaration: Syntax.Statements.VariableDeclaration) {
    crash declaration.value
    if declaration.name == "uncountables" {
        program_uncountables = literal_texts(declaration.value)
        program_inflection_read = true
        return
    }
    assert declaration.name == "irregulars"
    var literal = shape.as_object_literal(declaration.value)
    assert literal
    var singulars = List<String>()
    var plurals = List<String>()
    var index = 0
    while index < literal.fields.count() {
        var entry = literal.fields[index]
        crash entry.key
        crash entry.value
        var key_text = shape.as_string_literal(entry.key)
        var value_text = shape.as_string_literal(entry.value)
        if key_text and value_text {
            singulars.append(key_text.value)
            plurals.append(value_text.value)
        }
        index = index + 1
    }
    program_irregular_singulars = singulars
    program_irregular_plurals = plurals
    program_inflection_read = true
}

func literal_texts(value: Syntax.Expressions.Expression): List<String> {
    var texts = List<String>()
    var listed = shape.as_list_literal(value)
    if not listed {
        return texts
    }
    var index = 0
    while index < listed.elements.count() {
        crash listed.elements[index].value
        var text = shape.as_string_literal(listed.elements[index].value)
        if text {
            texts.append(text.value)
        }
        index = index + 1
    }
    return texts
}

# ../../../docs/optimizations.md#a-word-inflected-while-compiling
func folded_inflection(
    name: String,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
): ExpressionResult? {
    assert arguments_ast.is_empty() and same_inflection_table()
    var written = shape.as_string_literal(object_ast)
    assert written
    var text = written.value
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        assert code == 95 or code >= 97 and code <= 122
        index = index + 1
    }
    var inflected = program_inflected(text, name == "pluralize")
    var rendered = render_string_literal(inflected)
    var inflected_type = Analysis.Types.StringType()
    return ExpressionResult(rendered, inflected_type)
}

func same_inflection_table(): Boolean {
    if not program_inflection_read {
        return true
    }
    var own_singulars = inflection_words.irregulars.keys()
    var own_plurals = inflection_words.irregulars.values()
    var same_uncountables = same_texts(inflection_words.uncountables, program_uncountables)
    var same_singulars = same_texts(own_singulars, program_irregular_singulars)
    return same_uncountables and same_singulars and same_texts(own_plurals, program_irregular_plurals)
}

func same_texts(left: List<String>, right: List<String>): Boolean {
    if left.count() != right.count() {
        return false
    }
    var index = 0
    while index < left.count() {
        if left[index] != right[index] {
            return false
        }
        index = index + 1
    }
    return true
}

func program_inflected(word: String, to_plural: Boolean): String {
    var start = 0
    var index = 0
    var word_length = word.length()
    while index < word_length {
        if word.code_at(index) == 95 {
            start = index + 1
        }
        index = index + 1
    }
    var head = word.slice(0, start)
    var last = word.slice(start, word_length)
    if program_inflection_read and program_uncountables.contains(last) {
        return word
    }
    var position = 0
    while program_inflection_read and position < program_irregular_singulars.count() {
        var singular = program_irregular_singulars[position]
        var plural = program_irregular_plurals[position]
        crash plural
        if last == singular or last == plural {
            if to_plural {
                return head + plural
            }
            return head + singular
        }
        position = position + 1
    }
    if to_plural {
        return word.pluralize()
    }
    return word.singularize()
}

func check_value_name(name: String, what: String) {
    var bare = name
    if bare.starts_with("_") {
        var bare_length = bare.length()
        bare = bare.slice(1, bare_length)
    }
    if not is_lowercase_name(bare) {
        report("the {what} '{name}' must be written in snake_case: lowercase words joined by underscores")
        return
    }
    if bare.starts_with("_") or bare.ends_with("_") or bare.contains("__") {
        report(
            "the {what} '{name}' must be written in snake_case: lowercase words joined by one underscore each, with at most one '_' in front to make it private",
        )
        return
    }
    if bare.length() == 1 and not is_axis_name(bare) {
        report("the {what} '{name}' is a single letter: give it a name that says what it holds")
        return
    }
    check_abbreviations(bare)
}

func is_axis_name(name: String): Boolean {
    return name == "x" or name == "y" or name == "z" or name == "w"
}

func check_reflection_name(name: String, what: String, information: Analysis.ClassInfo) {
    assert not information.qualified_dotted.starts_with("Spite.")
    var member = name
    var accessor = ""
    if name.starts_with("get_") or name.starts_with("set_") {
        var name_length = name.length()
        member = name.slice(4, name_length)
        accessor = name.slice(0, 4)
    }
    var meaning = reflection_member_meaning(member)
    assert not meaning.is_empty()
    var owner = snake_words(information.simple_name)
    var suggestion = "{accessor}{owner}_{member}"
    if accessor.is_empty() {
        report(
            "the {what} '{name}' has a name reflection gives every object: {meaning}, and one of its own would hide it. Name it something else, like '{suggestion}'",
        )
        return
    }
    report(
        "the {what} '{name}' is read as '{member}', a name reflection gives every object: {meaning}, and one of its own would hide it. Name it something else, like '{suggestion}'",
    )
}

func reflection_member_meaning(member: String): String {
    switch member {
        "class": return "'value.class' is its class"
        "attributes": return "'value.attributes' lists its attributes, and JsonReader, JsonWriter and every attribute walk read through it"
        "functions": return "'value.functions' lists its functions"
        "instances": return "'Monster.instances' lists every live instance of a class"
        "memory": return "'value.memory' says where the value lives"
        _: return ""
    }
}

func joined_case_spelling(snake: String, capitalised_first: Boolean): String {
    var words = snake.split("_")
    var capitalised_words = List<String>()
    var capitalised_words_index = 0
    while capitalised_words_index < words.count() {
        var capitalised_words_item = capitalised_word(words[capitalised_words_index])
        capitalised_words.append(capitalised_words_item)
        capitalised_words_index = capitalised_words_index + 1
    }
    var pascal_spelling = capitalised_words.join("")
    if capitalised_first or pascal_spelling.is_empty() {
        return pascal_spelling
    }
    var first_letter = snake.slice(0, 1)
    var pascal_length = pascal_spelling.length()
    var rest = pascal_spelling.slice(1, pascal_length)
    return first_letter + rest
}

func capitalised_word(word: String): String {
    var word_length = word.length()
    var first_letter = word.slice(0, 1)
    var upper_first = first_letter.upper_case()
    var rest = word.slice(1, word_length)
    return upper_first + rest
}

func snake_words(pascal: String): String {
    var words = ""
    var index = 0
    while index < pascal.length() {
        var code = pascal.code_at(index)
        var character = pascal.character_at(index)
        if code >= 65 and code <= 90 and index > 0 {
            words = "{words}_"
        }
        var lowered = character.lower_case()
        words = words + lowered
        index = index + 1
    }
    return words
}

func check_type_name(name: String, what: String) {
    if not is_pascal_name(name) {
        report("the {what} '{name}' must be written in PascalCase: capitalised words with no underscores")
        return
    }
    check_abbreviations(name)
}

func report_unread_name(name: String, is_parameter: Boolean) {
    if not is_parameter {
        report("'{name}' is never read: remove it")
        return
    }
    if not name.starts_with("_") {
        report("the parameter '{name}' is never read: remove it, or name it '_{name}' if the signature needs it")
    }
}

func report_unused(scope: Scope) {
    var index = 0
    while index < scope.entry_names.count() {
        crash index < scope.entry_checked.count()
        crash index < scope.entry_used.count()
        if scope.entry_checked[index] {
            var name = scope.entry_names[index]
            var saved_line = current_line
            crash scope.entry_lines[index]
            current_line = scope.entry_lines[index]
            if name.starts_with("_") and scope.entry_used[index] {
                report(
                    "'{name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
                )
            }
            crash index < scope.entry_parameters.count()
            var is_parameter = scope.entry_parameters[index]
            if not scope.entry_used[index] {
                report_unread_name(name, is_parameter)
            }
            current_line = saved_line
        }
        index = index + 1
    }
}

func mark_attribute_read(information: Analysis.ClassInfo, name: String) {
    read_attributes["{information.qualified_dotted}.{name}"] = true
    note_fact("read {information.qualified_dotted}.{name}")
}

func mark_folded_words_read(statements: List<Syntax.Statements.Statement>) {
    var text = Syntax.SourcePrinter().source_statement_list(statements, 0)
    var no_metadata_receivers = List<String>()
    mark_words_read(text, false, no_metadata_receivers)
}

func mark_words_read(text: String, members_only: Boolean, metadata_receivers: List<String>) {
    var text_length = text.length()
    var start = 0
    var position = 0
    var previous_word = ""
    while position <= text_length {
        if position == text_length or not is_attribute_name_code(text, position) {
            if position > start {
                var word = text.slice(start, position)
                if not members_only or is_member_read_at(text, start, position, previous_word, metadata_receivers) {
                    folded_words[word] = true
                    note_fact("word {word}")
                }
                previous_word = word
            }
            start = position + 1
        }
        position = position + 1
    }
}

func is_member_read_at(
    text: String,
    start: Integer,
    end: Integer,
    receiver: String,
    metadata_receivers: List<String>,
): Boolean {
    if start <= 0 or text.code_at(start - 1) != 46 {
        return false
    }
    if end != text.length() and text.code_at(end) == 40 {
        return false
    }
    return not metadata_receivers.contains(receiver)
}

func mark_uncompiled_bodies_read(information: Analysis.ClassInfo, statements: List<Syntax.Statements.Statement>) {
    var index = 0
    while index < statements.count() {
        var function_declaration = shape.as_function_declaration(statements[index])
        if function_declaration {
            var metadata_receivers = symbol_parameter_names(function_declaration)
            var is_template = not metadata_receivers.is_empty()
            if is_template or information.is_generic_template {
                var names = List<String>()
                collect_block_names(function_declaration.body, names)
                mark_names_read(information, names)
            }
            if is_template or information.is_generic_template and not is_emitted_in_an_instance(information, function_declaration.name) {
                var text = Syntax.SourcePrinter().source_statement_list(function_declaration.body, 0)
                metadata_receivers.append("class")
                mark_words_read(text, true, metadata_receivers)
            }
        }
        var variable_declaration = shape.as_variable_declaration(statements[index])
        if variable_declaration {
            if information.is_generic_template {
                var default_names = List<String>()
                collect_optional_names(variable_declaration.value, default_names)
                mark_names_read(information, default_names)
            }
        }
        index = index + 1
    }
}

func symbol_parameter_names(declaration: Syntax.Statements.FunctionDeclaration): List<String> {
    var names = List<String>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.type_reference {
            var named = shape.as_named_type(parameter.type_reference)
            if named {
                if names_symbol_parameter(named) {
                    names.append(parameter.name)
                }
            }
        }
        index = index + 1
    }
    return names
}

func is_emitted_in_an_instance(template: Analysis.ClassInfo, name: String): Boolean {
    var index = 0
    while index < classes.count() {
        var instance = classes[index]
        if instance.is_instantiated and instance.qualified_dotted == template.qualified_dotted {
            var function = instance.find_function(name)
            if function {
                if function.is_emitted {
                    return true
                }
            }
        }
        index = index + 1
    }
    return false
}

func is_attribute_name_code(text: String, position: Integer): Boolean {
    var code = text.code_at(position)
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func mark_bound_attribute_read(class_information: Analysis.ClassInfo) {
    var owner = find_class_by_c_name(bound_member_owner_c_name)
    if owner {
        mark_attribute_read(owner, bound_field_name)
        return
    }
    mark_attribute_read(class_information, bound_field_name)
}

func mark_members_read(members: List<Analysis.ClassInfo>, name: String) {
    var index = 0
    while index < members.count() {
        mark_attribute_read(members[index], name)
        index = index + 1
    }
}

func mark_every_attribute_read(information: Analysis.ClassInfo) {
    var index = 0
    while index < information.fields.count() {
        mark_attribute_read(information, information.fields[index].name)
        index = index + 1
    }
}

func mark_names_read(information: Analysis.ClassInfo, names: List<String>) {
    var index = 0
    while index < names.count() {
        mark_attribute_read(information, names[index])
        index = index + 1
    }
}

func report_unused_attributes() {
    var checked = List<Analysis.ClassInfo>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if not information.is_instantiated and not information.source_path.is_empty() {
            checked.append(information)
            var statements = class_statements(information)
            mark_uncompiled_bodies_read(information, statements)
        }
        index = index + 1
    }
    index = 0
    while index < checked.count() {
        var information = checked[index]
        if attributes_are_checked(information) {
            var statements = class_statements(information)
            report_unread_attributes(information, statements)
        }
        index = index + 1
    }
}

func is_in_checkout(path: String): Boolean {
    var index = 0
    while index < checkout_folders.count() {
        if path.starts_with(checkout_folders[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_in_loaded_folder(path: String): Boolean {
    var index = 0
    while index < loaded_folders.count() {
        if path.starts_with(loaded_folders[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func class_statements(information: Analysis.ClassInfo): List<Syntax.Statements.Statement> {
    crash discovered_classes[information.entry_index]
    return discovered_classes[information.entry_index].file.statements
}

func attributes_are_checked(information: Analysis.ClassInfo): Boolean {
    if information.is_value_class {
        return false
    }
    if information.qualified_dotted == "Build" or information.qualified_dotted == "Environment" {
        return false
    }
    return true
}

func keeps_callback(information: Analysis.ClassInfo, name: String): Boolean {
    var field = information.find_field(name)
    if not field {
        return false
    }
    var field_type = field.type
    var nullable = type_shape.as_nullable(field_type)
    if nullable {
        field_type = nullable.inner
    }
    var class_ref = type_shape.as_class_ref(field_type)
    if not class_ref {
        return false
    }
    return class_ref.c_name == "ForeignCallback"
}

func report_unread_attributes(information: Analysis.ClassInfo, statements: List<Syntax.Statements.Statement>) {
    var index = 0
    while index < statements.count() {
        var declaration = shape.as_variable_declaration(statements[index])
        if declaration {
            var name = declaration.name
            var declared_path = information.source_path
            if not declaration.source_path.is_empty() {
                declared_path = declaration.source_path
            }
            var read = read_attributes.has("{information.qualified_dotted}.{name}") or folded_words.has(name) or keeps_callback(information, name)
            var seen_whole = name.starts_with("_") or not is_in_loaded_folder(declared_path) or binds_singleton(declaration, information)
            if not read and seen_whole {
                current_path = declared_path
                current_line = declaration.line
                current_owner = information.qualified_dotted
                current_function = ""
                report("the attribute '{name}' is never read: remove it")
            }
        }
        index = index + 1
    }
}

func binds_singleton(declaration: Syntax.Statements.VariableDeclaration, information: Analysis.ClassInfo): Boolean {
    crash declaration.value
    var bound = constructed_singleton(declaration.value, information)
    if not bound {
        return false
    }
    return true
}

func generate_block_in_scope(
    statements: List<Syntax.Statements.Statement>,
    block_scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var ended_in_return = generate_statement_list(statements, block_scope, class_information, function_information)
    if not ended_in_return {
        emit_scope_drops(block_scope, false)
    }
    close_rebindings(block_scope)
    report_unused(block_scope)
}

func generate_block(
    statements: List<Syntax.Statements.Statement>,
    parent_scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var block_scope = Scope(parent_scope)
    generate_block_in_scope(statements, block_scope, class_information, function_information)
}

func terminal_if_of(body: List<Syntax.Statements.Statement>): Syntax.Statements.IfStatement? {
    assert not body.is_empty()
    var last_statement = body[body.count() - 1]
    var last_if = shape.as_if_statement(last_statement)
    if last_if {
        if not last_if.has_else_branch {
            return last_if
        }
    }
    return null
}

func report_terminal_if(
    if_statement: Syntax.Statements.IfStatement,
    name: String,
    function_information: Analysis.FunctionInfo,
) {
    assert not if_statement.has_else_branch
    assert terminal_if
    var return_type = function_information.return_type
    if terminal_if == if_statement and not answers_nothing(return_type) {
        var type_name = type_display_name(return_type)
        report(
            "this 'if' is the last thing the function does and has no 'else', so when '{name}' is null the function answers no {type_name} at all: give that case its own 'return' after the 'if', or make the result '{type_name}?' and write 'assert {name}'",
        )
    } else if terminal_if == if_statement {
        report(
            "this 'if' is the last thing the function does and has no 'else', so it only checks that '{name}' is there: write 'assert {name}' and let the rest of the function run unindented",
        )
    }
}

func returned_default(if_statement: Syntax.Statements.IfStatement, return_type: Analysis.SpiteType): String? {
    assert not if_statement.has_else_branch and if_statement.then_branch.count() == 1
    var only = shape.as_return_statement(if_statement.then_branch[0])
    assert only
    if not only.value {
        return ""
    }
    var returned = only.value
    if type_shape.as_nullable(return_type) {
        if shape.is_null_literal(returned) {
            return "null"
        }
        return null
    }
    if answers_nothing(return_type) {
        return empty_collection_text(returned)
    }
    if shape.is_false_literal(returned) {
        return "false"
    }
    var text = shape.as_string_literal(returned)
    if text {
        if text.value.is_empty() {
            return "\"\""
        }
        return null
    }
    var integer = shape.as_integer_literal(returned)
    if integer {
        if integer.value == 0 {
            return "0"
        }
        return null
    }
    var fraction = shape.as_float_literal(returned)
    assert fraction
    assert fraction.value == 0.0
    return Syntax.SourcePrinter().source_expression(returned)
}

func empty_collection_text(returned: Syntax.Expressions.Expression): String? {
    var listed = shape.as_list_literal(returned)
    if listed {
        assert listed.elements.is_empty()
        return "[]"
    }
    var made = shape.as_generic_call(returned)
    assert made and made.arguments.is_empty()
    crash made.callee
    var made_name = operand_text(made.callee)
    assert made_name == "List" or made_name == "Dictionary" or made_name == "Vector" or made_name == "Items"
    return Syntax.SourcePrinter().source_expression(returned)
}

func flipped_comparison(operator: Syntax.Expressions.BinaryOperator): Syntax.Expressions.BinaryOperator {
    switch operator {
        'equal': return 'not_equal'
        'not_equal': return 'equal'
        'less': return 'greater_equal'
        'greater_equal': return 'less'
        'greater': return 'less_equal'
        'less_equal': return 'greater'
        'logical_and': return 'logical_or'
        'logical_or': return 'logical_and'
        _: return operator
    }
}

func negated_condition(condition: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var unary = shape.as_unary(condition)
    if unary {
        if unary.operator == 'logical_not' {
            crash unary.operand
            return unary.operand
        }
    }
    var binary = shape.as_binary(condition)
    if binary {
        crash binary.left
        crash binary.right
        var flipped = flipped_comparison(binary.operator)
        if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
            var left = negated_condition(binary.left)
            var right = negated_condition(binary.right)
            return Syntax.Expressions.BinaryExpression(flipped, left, right)
        }
        if flipped != binary.operator {
            return Syntax.Expressions.BinaryExpression(flipped, binary.left, binary.right)
        }
    }
    return Syntax.Expressions.UnaryExpression('logical_not', condition)
}

func answers_nothing(return_type: Analysis.SpiteType): Boolean {
    if type_shape.is_void(return_type) or type_shape.as_nullable(return_type) {
        return true
    }
    if type_shape.as_list(return_type) or type_shape.as_dictionary(return_type) {
        return true
    }
    var collection = vector_class_of(return_type)
    if collection {
        return true
    }
    return false
}

func report_default_assert(
    assert_statement: Syntax.Statements.AssertStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert not assert_statement.is_crash and not function_information.is_constructor
    var return_type = function_information.return_type
    assert not answers_nothing(return_type)
    crash assert_statement.value
    var written = truth_written_out(assert_statement.value, scope, class_information)
    var printer = Syntax.SourcePrinter()
    var condition = printer.source_expression(written)
    var negated = negated_condition(written)
    var leaving = printer.source_expression(negated)
    var name = type_display_name(return_type)
    var answer = example_answer(return_type)
    var answer_choice = ""
    if not answer.is_empty() {
        answer_choice = " return a value ('if {leaving} \{ return {answer} }'),"
    }
    var nullable_choice = " make the result '{name}?',"
    if answer == "false" {
        nullable_choice = ""
    }
    report(
        "this 'assert' would answer a default {name} ({shown_default(return_type)}) that a caller cannot tell from a real one:{answer_choice}{nullable_choice} or 'crash {condition}' if this is a developer mistake",
    )
}

func truth_written_out(
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.Expression {
    var joined = shape.as_binary(condition)
    if joined {
        if joined.operator == 'logical_and' {
            crash joined.left and joined.right
            var left = truth_written_out(joined.left, scope, class_information)
            var right = truth_written_out(joined.right, scope, class_information)
            return Syntax.Expressions.BinaryExpression('logical_and', left, right)
        }
    }
    if not reads_maybe_boolean(condition, scope, class_information) {
        return condition
    }
    var compared: Syntax.Expressions.Expression = Syntax.Expressions.TrueLiteral()
    return Syntax.Expressions.BinaryExpression('equal', condition, compared)
}

func reads_maybe_boolean(
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var indexed = shape.as_index(condition)
    if indexed {
        crash indexed.object
        var path = operand_text(condition)
        if path.is_empty() or scope.is_path_narrowed(path) {
            return false
        }
        var held_type = lookup_static_type(indexed.object, scope, class_information)
        if not held_type {
            return false
        }
        var listed = type_shape.as_list(held_type)
        if not listed {
            return false
        }
        var element = listed.element
        var maybe_element = type_shape.as_nullable(element)
        if maybe_element {
            var element_inner = maybe_element.inner
            return is_boolean_type(element_inner)
        }
        return is_boolean_type(element)
    }
    var static_type = lookup_static_type(condition, scope, class_information)
    if not static_type {
        return false
    }
    var maybe = type_shape.as_nullable(static_type)
    if not maybe {
        return false
    }
    var maybe_inner = maybe.inner
    return is_boolean_type(maybe_inner)
}

func shown_default(return_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(return_type)
    if scalar {
        return default_value_for_type(return_type)
    }
    if type_shape.as_string(return_type) {
        return "\"\""
    }
    var enum_type = type_shape.as_enum(return_type)
    if enum_type {
        var first_value = enum_type.values.first()
        crash first_value
        return "'{first_value}'"
    }
    return "an object with every attribute at its default"
}

func example_answer(return_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(return_type)
    if scalar {
        if scalar.kind == 'boolean_kind' {
            return "false"
        }
        if scalar.kind == 'float_kind' or scalar.kind == 'double_kind' {
            return "-1.0"
        }
        return "-1"
    }
    if type_shape.as_string(return_type) {
        return "\"\""
    }
    var enum_type = type_shape.as_enum(return_type)
    if enum_type {
        var first_value = enum_type.values.first()
        crash first_value
        return "'{first_value}'"
    }
    return made_answer(return_type)
}

func made_answer(return_type: Analysis.SpiteType): String {
    var made = ""
    var class_reference = type_shape.as_class_ref(return_type)
    if not class_reference or current_class_is_generic() {
        return made
    }
    var made_class = find_class_by_c_name(class_reference.c_name)
    if not made_class or made_class.is_singleton or not made_class.codegen_types.is_empty() {
        return made
    }
    if made_class.constructor {
        if not made_class.constructor.parameters.is_empty() {
            return made
        }
    }
    return "{type_display_name(return_type)}()"
}

func current_class_is_generic(): Boolean {
    var instanced = false
    if current_class {
        instanced = not current_class.codegen_types.is_empty()
    }
    return instanced
}

func report_default_guard(if_statement: Syntax.Statements.IfStatement, function_information: Analysis.FunctionInfo) {
    var return_type = function_information.return_type
    assert answers_nothing(return_type) or function_information.is_constructor
    var returned = returned_default(if_statement, return_type)
    assert returned
    crash if_statement.condition
    var negated = negated_condition(if_statement.condition)
    var proven = Syntax.SourcePrinter().source_expression(negated)
    if function_information.is_constructor {
        report(
            "this 'if' only leaves the constructor, and a constructor is setup, not logic: take already resolved values, or write 'crash {proven}' when this is a bug",
        )
        return
    }
    if returned.is_empty() {
        report("this 'if' only returns: write 'assert {proven}' and let the rest run unindented")
        return
    }
    report(
        "this 'if' only returns the default '{returned}', which is how a guard is written: write 'assert {proven}' and let the rest run unindented",
    )
}

func generate_if_statement(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    if not if_statement.condition {
        return false
    }
    report_repeated_branch_call(if_statement)
    report_nested_if_else(if_statement)
    report_else_chain(if_statement, scope, class_information)
    var constant = constant_condition(if_statement.condition, scope, class_information)
    if constant == true or constant == false {
        builder.add_user("\{")
        var taken = if_statement.then_branch
        if constant == true {
            mark_folded_names_used(if_statement.else_branch, scope)
        } else {
            mark_folded_names_used(if_statement.then_branch, scope)
            taken = if_statement.else_branch
        }
        var taken_scope = Scope(scope)
        var taken_returns = generate_statement_list(taken, taken_scope, class_information, function_information)
        if not taken_returns {
            emit_scope_drops(taken_scope, false)
        }
        close_rebindings(taken_scope)
        report_unused(taken_scope)
        builder.add_user("}")
        return taken_returns
    }
    generate_unfolded_if(if_statement, scope, class_information, function_information)
    return false
}

func generate_unfolded_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    crash if_statement.condition
    report_default_guard(if_statement, function_information)
    var leaves = not if_statement.has_else_branch and leaves_function(if_statement.then_branch)
    var sides = List<Syntax.Expressions.Expression>()
    collect_or_sides(if_statement.condition, sides)
    if leaves and sides.any(is_negated_side) {
        generate_leaving_if(if_statement, sides, scope, class_information, function_information)
        return
    }
    keeping_guard_reads = not resumable_mode and not hot_reload and not read_evaluate_print_loop
    var guard = try_nullable_guard(if_statement.condition, scope, class_information)
    keeping_guard_reads = false
    if guard {
        report_terminal_if(if_statement, guard.name, function_information)
        builder.add_user("if ({guard.guard_code}) \{")
        var then_scope = Scope(scope)
        narrow_by_guard(then_scope, guard, "'if {guard.name}'")
        generate_block_in_scope(if_statement.then_branch, then_scope, class_information, function_information)
        builder.add_user("}")
        if if_statement.has_else_branch {
            builder.add_user("else \{")
            generate_block(if_statement.else_branch, scope, class_information, function_information)
            builder.add_user("}")
        }
        return
    }
    assert not generate_and_narrowing_if(if_statement, scope, class_information, function_information)
    if not generate_class_narrowing_if(if_statement, scope, class_information, function_information) {
        generate_plain_if(if_statement, scope, class_information, function_information)
        if leaves {
            var kept = negated_condition(if_statement.condition)
            narrow_proven_indices(kept, scope, class_information)
        }
    }
}

func leaves_function(body: List<Syntax.Statements.Statement>): Boolean {
    var last_statement = body.last()
    var leaves = false
    if last_statement {
        leaves = is_leaving_statement(last_statement)
    }
    return leaves
}

func is_leaving_statement(statement: Syntax.Statements.Statement): Boolean {
    var check = shape.as_assert_statement(statement)
    var halts = false
    if check {
        if check.value {
            halts = check.is_crash and shape.is_false_literal(check.value)
        }
    }
    var choice = shape.as_switch_statement(statement)
    if choice {
        halts = not choice.cases.is_empty() and choice.cases.all(case_leaves)
    }
    return statement == Syntax.Statements.ReturnStatement or halts
}

func case_leaves(switch_case: Syntax.Statements.SwitchCase): Boolean {
    return leaves_function(switch_case.body)
}

func collect_or_sides(expression: Syntax.Expressions.Expression, sides: List<Syntax.Expressions.Expression>) {
    var joined = shape.as_binary(expression)
    if joined {
        if joined.operator == 'logical_or' {
            crash joined.left
            crash joined.right
            collect_or_sides(joined.left, sides)
            collect_or_sides(joined.right, sides)
            return
        }
    }
    sides.append(expression)
}

func is_negated_side(side: Syntax.Expressions.Expression): Boolean {
    var unary = shape.as_unary(side)
    var negated = false
    if unary {
        negated = unary.operator == 'logical_not'
    }
    return negated
}

func generate_leaving_if(
    if_statement: Syntax.Statements.IfStatement,
    sides: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var probe_scope = Scope(scope)
    var guards = List<NullableGuard>()
    var plain_sides = List<Syntax.Expressions.Expression>()
    var tests = List<String>()
    var index = 0
    while index < sides.count() {
        var side_position = builder.user_count()
        var side_marks = wait_mark_counters.count()
        var side_counter = temporary_counter
        var waits_in_place = index > 0 and (not resumable_mode or conditional_depth != 0)
        if waits_in_place {
            conditional_depth = conditional_depth + 1
        }
        var kept_test = leaving_side_test(sides[index], probe_scope, guards, plain_sides, class_information)
        if waits_in_place {
            conditional_depth = conditional_depth - 1
        }
        if index > 0 and waited_since(side_marks) {
            var decided = chained_side(tests, kept_test, side_position, side_marks, side_counter)
            tests.clear()
            tests.append(decided)
        } else {
            tests.append(kept_test)
        }
        index = index + 1
    }
    adopt_owned(probe_scope, scope)
    builder.add_user("if (!({tests.join(" && ")})) \{")
    generate_block(if_statement.then_branch, scope, class_information, function_information)
    builder.add_user("}")
    var guard_index = 0
    while guard_index < guards.count() {
        var leaving_guard = guards[guard_index]
        narrow_by_guard(scope, leaving_guard, "'if not {leaving_guard.name}'")
        guard_index = guard_index + 1
    }
    var side_index = 0
    while side_index < plain_sides.count() {
        var kept = negated_condition(plain_sides[side_index])
        narrow_proven_indices(kept, scope, class_information)
        side_index = side_index + 1
    }
}

func leaving_side_test(
    side: Syntax.Expressions.Expression,
    probe_scope: Scope,
    guards: List<NullableGuard>,
    plain_sides: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): String {
    var unary = shape.as_unary(side)
    if unary {
        if unary.operator == 'logical_not' and unary.operand {
            var guard = try_nullable_guard(unary.operand, probe_scope, class_information)
            if guard {
                narrow_by_guard(probe_scope, guard, "'if not {guard.name}'")
                guards.append(guard)
                return "({guard.guard_code})"
            }
        }
    }
    var side_result = generate_joined(side, probe_scope, class_information)
    check_condition(side, side_result, "if", probe_scope)
    plain_sides.append(side)
    return "!({owned_truth(side_result, side)})"
}

func adopt_owned(probe_scope: Scope, scope: Scope) {
    var index = 0
    while index < probe_scope.owned.count() {
        var owned_local = probe_scope.owned[index]
        var owned_type = owned_local.type
        scope.declare_owned(owned_local.name, owned_type)
        index = index + 1
    }
}

func generate_plain_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    crash if_statement.condition
    var condition_result = generate_joined(if_statement.condition, scope, class_information)
    check_condition(if_statement.condition, condition_result, "if", scope)
    builder.add_user("if ({owned_truth(condition_result, if_statement.condition)}) \{")
    var proven_scope = Scope(scope)
    narrow_proven_indices(if_statement.condition, proven_scope, class_information)
    generate_block_in_scope(if_statement.then_branch, proven_scope, class_information, function_information)
    builder.add_user("}")
    if if_statement.has_else_branch {
        builder.add_user("else \{")
        generate_block(if_statement.else_branch, scope, class_information, function_information)
        builder.add_user("}")
    }
}

func generate_class_narrowing_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    crash if_statement.condition
    var binary = shape.as_binary(if_statement.condition)
    if not binary {
        return false
    }
    if binary.operator != 'equal' {
        return false
    }
    crash binary.left
    crash binary.right
    var subject_identifier = shape.as_identifier(binary.left)
    if not subject_identifier {
        return false
    }
    var tested_class = tested_class_of(binary.right, class_information)
    if not tested_class {
        return false
    }
    var subject = generate_expression(binary.left, scope, class_information)
    var subject_type = subject.type
    var is_nullable = false
    var nullable = type_shape.as_nullable(subject_type)
    if nullable {
        subject_type = nullable.inner
        is_nullable = true
    }
    var subject_union = type_shape.as_union(subject_type)
    if not subject_union {
        return false
    }
    var union_information = find_union_by_c_name(subject_union.c_name)
    if union_information {
        check_tested_member(union_information, tested_class)
    }
    var subject_temporary = next_temporary()
    builder.add_user("\{")
    var subject_spite_type = subject.type
    builder.add_user("{c_type_name(subject_spite_type)} {subject_temporary} = {subject.code};")
    var test = value_class_test(subject_temporary, subject_spite_type, tested_class)
    if is_nullable {
        var subject_present = present_code(subject_temporary, subject_spite_type)
        test = "({subject_present} && {test})"
    }
    builder.add_user("if ({test}) \{")
    var case_scope = Scope(scope)
    var class_type = instance_type_of(tested_class)
    case_scope.declare(subject_identifier.name, class_type)
    case_scope.note_site(
        subject_identifier.name,
        "'if {subject_identifier.name} == {tested_class.simple_name}' on line {current_line}",
    )
    var narrowed = member_value_code(subject_temporary, subject_spite_type, tested_class)
    case_scope.set_override(subject_identifier.name, narrowed)
    generate_block_in_scope(if_statement.then_branch, case_scope, class_information, function_information)
    builder.add_user("}")
    if if_statement.has_else_branch {
        builder.add_user("else \{")
        generate_block(if_statement.else_branch, scope, class_information, function_information)
        builder.add_user("}")
    }
    builder.add_user("}")
    return true
}

func generate_nullable_switch(
    switch_statement: Syntax.Statements.SwitchStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
    guard: NullableGuard,
) {
    var covered_null = false
    var covered_value = false
    var case_index = 0
    while case_index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[case_index]
        if switch_case.value {
            report(
                "this value may be null, so its switch cases are its type and 'Null': narrow it first ('crash value' or 'assert value') to switch over its values",
            )
        }
        if switch_case.type_reference {
            var case_named = shape.as_named_type(switch_case.type_reference)
            var is_null_case = false
            if case_named {
                is_null_case = case_named.path.count() == 1 and case_named.path[0] == "Null"
            }
            if is_null_case {
                covered_null = true
                builder.add_user("if (!({guard.guard_code})) \{")
                generate_block(switch_case.body, scope, class_information, function_information)
                builder.add_user("}")
            } else {
                var case_type = resolve_type(switch_case.type_reference, class_information.qualified_dotted)
                if case_type {
                    var guard_inner = guard.inner
                    if not types_equal(case_type, guard_inner) {
                        report(
                            "this value is {type_with_article(guard_inner)} or null, so its switch cases are '{type_display_name(guard_inner)}' and 'Null'",
                        )
                    }
                }
                covered_value = true
                builder.add_user("if ({guard.guard_code}) \{")
                var case_scope = Scope(scope)
                narrow_by_guard(case_scope, guard, "the 'switch'")
                generate_block_in_scope(switch_case.body, case_scope, class_information, function_information)
                builder.add_user("}")
            }
        }
        case_index = case_index + 1
    }
    if not covered_null {
        report("this switch does not cover 'Null'")
    }
    if not covered_value {
        var guard_inner = guard.inner
        report("this switch does not cover '{type_display_name(guard_inner)}'")
    }
}

func generate_union_case(
    switch_case: Syntax.Statements.SwitchCase,
    case_index: Integer,
    information: Analysis.UnionInfo,
    subject_temporary: String,
    subject_identifier: Syntax.Expressions.IdentifierExpression?,
    covered_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    if switch_case.value {
        report("a case of a switch over the union '{information.simple_name}' names one of its classes, never a value")
    }
    assert switch_case.type_reference
    var case_class = class_of_type_reference(switch_case.type_reference, information.owner_namespace)
    if not case_class {
        case_class = class_of_type_reference(switch_case.type_reference, class_information.qualified_dotted)
    }
    if not case_class {
        report("a switch case must name a class of the union")
        return
    }
    if information.has_member(case_class.c_name) {
        covered_names.append(case_class.simple_name)
    } else {
        report("'{case_class.simple_name}' is not a member of union '{information.simple_name}'")
    }
    emit_narrowed_case(
        case_class,
        case_index > 0,
        switch_case.body,
        subject_temporary,
        subject_identifier,
        scope,
        class_information,
        function_information,
    )
}

func generate_rest_case(
    switch_case: Syntax.Statements.SwitchCase,
    case_index: Integer,
    information: Analysis.UnionInfo,
    subject_temporary: String,
    subject_identifier: Syntax.Expressions.IdentifierExpression?,
    covered_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var chained = case_index > 0
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        if not covered_names.contains(member.simple_name) {
            emit_narrowed_case(
                member,
                chained,
                switch_case.body,
                subject_temporary,
                subject_identifier,
                scope,
                class_information,
                function_information,
            )
            chained = true
        }
        member_index = member_index + 1
    }
}

func emit_narrowed_case(
    case_class: Analysis.ClassInfo,
    chained: Boolean,
    body: List<Syntax.Statements.Statement>,
    subject_temporary: String,
    subject_identifier: Syntax.Expressions.IdentifierExpression?,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var keyword = "if "
    if chained {
        keyword = "else if "
    }
    builder.add_user("{keyword}{class_id_test(subject_temporary, case_class)} \{")
    var case_scope = Scope(scope)
    if subject_identifier {
        var class_type = class_type_of(case_class)
        case_scope.declare(subject_identifier.name, class_type)
        case_scope.set_override(subject_identifier.name, "(({case_class.c_name}*){subject_temporary})")
    }
    generate_block_in_scope(body, case_scope, class_information, function_information)
    builder.add_user("}")
}

func report_misplaced_rest_case(
    switch_statement: Syntax.Statements.SwitchStatement,
    case_index: Integer,
    covered_names: List<String>,
    information: Analysis.UnionInfo,
) {
    if case_index != switch_statement.cases.count() - 1 {
        report("'_:' answers for every member without a case of its own, so it is the last case")
    } else if covered_names.count() == information.members.count() {
        report("every member of '{information.simple_name}' already has a case, so '_:' answers for nothing: remove it")
    }
}

func is_rest_case(switch_case: Syntax.Statements.SwitchCase): Boolean {
    if switch_case.type_reference {
        var named = shape.as_named_type(switch_case.type_reference)
        if named {
            return named.path.count() == 1 and named.path[0] == "_"
        }
    }
    return false
}

func report_single_case(switch_statement: Syntax.Statements.SwitchStatement) {
    assert switch_statement.cases.count() == 2 and is_rest_case(switch_statement.cases[1])
    var class_case = switch_statement.cases[0]
    crash switch_statement.subject
    var printer = Syntax.SourcePrinter()
    var subject = printer.source_expression(switch_statement.subject)
    var tested = printer.case_label(class_case)
    crash switch_statement.cases[1]
    assert only_returns(class_case.body) and only_returns(switch_statement.cases[1].body)
    var answer = returned_boolean(class_case.body)
    var rest_answer = returned_boolean(switch_statement.cases[1].body)
    if answer and rest_answer {
        if answer != rest_answer {
            var comparison = "=="
            if answer == "false" {
                comparison = "!="
            }
            report(
                "this switch only asks {single_case_question(class_case, subject, tested)}: write 'return {subject} {comparison} {tested}'",
            )
            return
        }
    }
    report(
        "a switch with one case and '_:' is an if: write 'if {subject} == {tested} \{ ... }', returning early, and then what '_:' does",
    )
}

func single_case_question(class_case: Syntax.Statements.SwitchCase, subject: String, tested: String): String {
    if class_case.value {
        return "whether '{subject}' is {tested}"
    }
    return "what class '{subject}' is"
}

func only_returns(body: List<Syntax.Statements.Statement>): Boolean {
    if body.count() != 1 {
        return false
    }
    return body[0] == Syntax.Statements.ReturnStatement
}

func returned_boolean(body: List<Syntax.Statements.Statement>): String? {
    assert body.count() == 1
    var returned = shape.as_return_statement(body[0])
    if returned {
        if returned.value {
            if shape.is_true_literal(returned.value) {
                return "true"
            }
            if shape.is_false_literal(returned.value) {
                return "false"
            }
        }
    }
    return null
}

func report_repeated_cases(switch_statement: Syntax.Statements.SwitchStatement) {
    var printer = Syntax.SourcePrinter()
    var bodies = List<String>()
    var names = List<String>()
    var rest_body = ""
    var index = 0
    while index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[index]
        var printed = printer.source_statement_list(switch_case.body, 0)
        if is_rest_case(switch_case) {
            rest_body = printed
        } else {
            bodies.append(printed)
            var label = printer.case_label(switch_case)
            names.append(label)
        }
        index = index + 1
    }
    index = 0
    while index < bodies.count() {
        if not rest_body.is_empty() and bodies[index] == rest_body {
            crash names[index]
            report("the case '{names[index]}' does the same as '_:': remove it and let '_:' answer for it")
            return
        }
        var other = index + 1
        while other < bodies.count() {
            if rest_body.is_empty() and bodies[index] == bodies[other] {
                crash names[index]
                crash names[other]
                report(
                    "the cases '{names[index]}' and '{names[other]}' do the same thing: write it once, as the last case '_:'",
                )
                return
            }
            other = other + 1
        }
        index = index + 1
    }
}

func report_repeated_branch_call(if_statement: Syntax.Statements.IfStatement) {
    assert not if_statement.follows_else
    var narrowed = List<String>()
    var ends_in_else = collect_chain_narrowed_names(if_statement, narrowed)
    assert ends_in_else
    var first_calls = List<String>()
    collect_branch_calls(if_statement.then_branch, narrowed, first_calls)
    var shared = keep_shared_calls(if_statement, narrowed, first_calls)
    assert shared[0]
    var branch_words = "both branches"
    if chained_if(if_statement) {
        branch_words = "every branch"
    }
    report("'{shared[0]}' is computed in {branch_words}: compute it once before the 'if'")
}

func report_nested_if_else(if_statement: Syntax.Statements.IfStatement) {
    assert if_statement.has_else_branch or if_statement.follows_else
    report_if_else_in_branch(if_statement.then_branch)
    var chained = chained_if(if_statement)
    if not chained {
        report_if_else_in_branch(if_statement.else_branch)
    }
}

func report_if_else_in_branch(branch: List<Syntax.Statements.Statement>) {
    var index = 0
    while index < branch.count() {
        var nested = shape.as_if_statement(branch[index])
        if nested and nested.has_else_branch {
            var saved_line = current_line
            current_line = nested.line
            report(
                "this 'if'/'else' is inside a branch of another 'if'/'else': move it into a function named for what it decides, or, when both test which member of a union or which value of an enum a value is, use one 'switch'",
            )
            current_line = saved_line
        }
        index = index + 1
    }
}

func collect_chain_narrowed_names(if_statement: Syntax.Statements.IfStatement, names: List<String>): Boolean {
    crash if_statement.condition
    collect_narrowed_names(if_statement.condition, names)
    if not if_statement.has_else_branch {
        return false
    }
    var chained = chained_if(if_statement)
    if chained {
        return collect_chain_narrowed_names(chained, names)
    }
    return true
}

func chained_if(if_statement: Syntax.Statements.IfStatement): Syntax.Statements.IfStatement? {
    assert if_statement.else_branch.count() == 1
    var chained = shape.as_if_statement(if_statement.else_branch[0])
    if chained {
        if chained.follows_else {
            return chained
        }
    }
    return null
}

func keep_shared_calls(
    if_statement: Syntax.Statements.IfStatement,
    narrowed: List<String>,
    shared: List<String>,
): List<String> {
    var chained = chained_if(if_statement)
    if chained {
        var kept = calls_also_in(shared, chained.then_branch, narrowed)
        return keep_shared_calls(chained, narrowed, kept)
    }
    return calls_also_in(shared, if_statement.else_branch, narrowed)
}

func calls_also_in(
    shared: List<String>,
    branch: List<Syntax.Statements.Statement>,
    narrowed: List<String>,
): List<String> {
    var found = List<String>()
    collect_branch_calls(branch, narrowed, found)
    var kept = List<String>()
    var index = 0
    while index < shared.count() {
        var call_text = shared[index]
        if found.contains(call_text) {
            kept.append(call_text)
        }
        index = index + 1
    }
    return kept
}

func copied_names(names: List<String>): List<String> {
    return names.copy()
}

func collect_narrowed_names(condition: Syntax.Expressions.Expression, names: List<String>) {
    var unary = shape.as_unary(condition)
    if unary {
        crash unary.operand
        collect_narrowed_names(unary.operand, names)
        return
    }
    var binary = shape.as_binary(condition)
    if binary {
        crash binary.left
        crash binary.right
        if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
            collect_narrowed_names(binary.left, names)
            collect_narrowed_names(binary.right, names)
        } else if binary.operator == 'equal' or binary.operator == 'not_equal' {
            if names_a_class_or_null(binary.right) {
                collect_mentioned_names(binary.left, names)
            }
        }
        return
    }
    if shape.as_identifier(condition) or shape.as_member(condition) or shape.as_index(condition) {
        collect_mentioned_names(condition, names)
    }
}

func names_a_class_or_null(expression: Syntax.Expressions.Expression): Boolean {
    switch expression {
        Syntax.Expressions.MemberExpression: return starts_upper_case(expression.name)
        Syntax.Expressions.IdentifierExpression: return starts_upper_case(expression.name)
        _: return shape.is_null_literal(expression)
    }
}

func collect_branch_calls(branch: List<Syntax.Statements.Statement>, narrowed: List<String>, calls: List<String>) {
    var changed = copied_names(narrowed)
    var index = 0
    while index < branch.count() {
        var statement = branch[index]
        switch statement {
            Syntax.Statements.VariableDeclaration: {
                crash statement.value
                collect_repeatable_calls(statement.value, changed, calls)
                changed.append(statement.name)
            }
            Syntax.Statements.AssignmentStatement: {
                crash statement.value
                crash statement.target
                collect_repeatable_calls(statement.value, changed, calls)
                collect_mentioned_names(statement.target, changed)
            }
            Syntax.Statements.ExpressionStatement: {
                crash statement.value
                collect_statement_call_parts(statement.value, changed, calls)
                collect_mentioned_names(statement.value, changed)
            }
            Syntax.Statements.ReturnStatement: {
                if statement.value {
                    collect_repeatable_calls(statement.value, changed, calls)
                }
            }
            Syntax.Statements.AssertStatement: {
                crash statement.value
                collect_repeatable_calls(statement.value, changed, calls)
                collect_mentioned_names(statement.value, changed)
            }
            Syntax.Statements.IfStatement: {
                crash statement.condition
                collect_repeatable_calls(statement.condition, changed, calls)
                return
            }
            _: return
        }
        index = index + 1
    }
}

func collect_statement_call_parts(
    expression: Syntax.Expressions.Expression,
    changed: List<String>,
    calls: List<String>,
) {
    var arguments = List<Syntax.Expressions.Expression>()
    var callee: Syntax.Expressions.Expression? = null
    switch expression {
        Syntax.Expressions.CallExpression: {
            callee = expression.callee
            arguments = expression.arguments
        }
        Syntax.Expressions.GenericCallExpression: {
            callee = expression.callee
            arguments = expression.arguments
        }
        _: {
            collect_repeatable_calls(expression, changed, calls)
            return
        }
    }
    crash callee
    collect_repeatable_calls(callee, changed, calls)
    var index = 0
    while index < arguments.count() {
        collect_repeatable_calls(arguments[index], changed, calls)
        index = index + 1
    }
}

func collect_repeatable_calls(expression: Syntax.Expressions.Expression, changed: List<String>, calls: List<String>) {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            add_repeatable_call(expression, expression.callee, expression.arguments, changed, calls)
            collect_repeatable_calls(expression.callee, changed, calls)
            collect_each_repeatable_call(expression.arguments, changed, calls)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            add_repeatable_call(expression, expression.callee, expression.arguments, changed, calls)
            collect_repeatable_calls(expression.callee, changed, calls)
            collect_each_repeatable_call(expression.arguments, changed, calls)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            collect_repeatable_calls(expression.left, changed, calls)
            if expression.operator != 'logical_and' and expression.operator != 'logical_or' {
                collect_repeatable_calls(expression.right, changed, calls)
            }
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            collect_repeatable_calls(expression.operand, changed, calls)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            collect_repeatable_calls(expression.object, changed, calls)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            collect_repeatable_calls(expression.object, changed, calls)
            collect_repeatable_calls(expression.index, changed, calls)
        }
        _: return
    }
}

func collect_each_repeatable_call(
    expressions: List<Syntax.Expressions.Expression>,
    changed: List<String>,
    calls: List<String>,
) {
    var index = 0
    while index < expressions.count() {
        collect_repeatable_calls(expressions[index], changed, calls)
        index = index + 1
    }
}

func add_repeatable_call(
    call: Syntax.Expressions.Expression,
    callee: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    changed: List<String>,
    calls: List<String>,
) {
    assert not arguments.is_empty()
    var called_name = ""
    var identifier = shape.as_identifier(callee)
    var member = shape.as_member(callee)
    if identifier {
        called_name = identifier.name
    } else if member {
        called_name = member.name
    }
    assert not starts_upper_case(called_name)
    var mentioned = List<String>()
    collect_mentioned_names(call, mentioned)
    var index = 0
    while index < mentioned.count() {
        assert not changed.contains(mentioned[index])
        index = index + 1
    }
    var source_expression = Syntax.SourcePrinter().source_expression(call)
    calls.append(source_expression)
}

func starts_upper_case(name: String): Boolean {
    var first_letter = name.slice(0, 1)
    return first_letter.upper_case() == first_letter and first_letter.lower_case() != first_letter
}

func collect_mentioned_names(expression: Syntax.Expressions.Expression, names: List<String>) {
    switch expression {
        Syntax.Expressions.IdentifierExpression: names.append(expression.name)
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            collect_mentioned_names(expression.callee, names)
            collect_each_mentioned_name(expression.arguments, names)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            collect_mentioned_names(expression.callee, names)
            collect_each_mentioned_name(expression.arguments, names)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            collect_mentioned_names(expression.left, names)
            collect_mentioned_names(expression.right, names)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            collect_mentioned_names(expression.operand, names)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            collect_mentioned_names(expression.object, names)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            collect_mentioned_names(expression.object, names)
            collect_mentioned_names(expression.index, names)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                collect_mentioned_names(element_value, names)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                collect_mentioned_names(field_value, names)
                index = index + 1
            }
        }
        _: return
    }
}

func mark_folded_names_used(statements: List<Syntax.Statements.Statement>, scope: Scope) {
    mark_folded_words_read(statements)
    var names = List<String>()
    collect_block_names(statements, names)
    names.each(scope.mark_used)
}

func collect_block_names(statements: List<Syntax.Statements.Statement>, names: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_statement_names(statements[index], names)
        index = index + 1
    }
}

func collect_statement_names(statement: Syntax.Statements.Statement, names: List<String>) {
    switch statement {
        Syntax.Statements.VariableDeclaration: collect_optional_names(statement.value, names)
        Syntax.Statements.AssignmentStatement: {
            collect_optional_names(statement.target, names)
            collect_optional_names(statement.value, names)
        }
        Syntax.Statements.IfStatement: {
            collect_optional_names(statement.condition, names)
            collect_block_names(statement.then_branch, names)
            collect_block_names(statement.else_branch, names)
        }
        Syntax.Statements.WhileStatement: {
            collect_optional_names(statement.condition, names)
            collect_block_names(statement.body, names)
        }
        Syntax.Statements.SwitchStatement: {
            collect_optional_names(statement.subject, names)
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_block_names(statement.cases[case_index].body, names)
                case_index = case_index + 1
            }
        }
        Syntax.Statements.AssertStatement: collect_optional_names(statement.value, names)
        Syntax.Statements.ReturnStatement: collect_optional_names(statement.value, names)
        Syntax.Statements.ExpressionStatement: collect_optional_names(statement.value, names)
        _: return
    }
}

func collect_optional_names(expression: Syntax.Expressions.Expression?, names: List<String>) {
    assert expression
    collect_mentioned_names(expression, names)
}

func collect_each_mentioned_name(expressions: List<Syntax.Expressions.Expression>, names: List<String>) {
    var index = 0
    while index < expressions.count() {
        collect_mentioned_names(expressions[index], names)
        index = index + 1
    }
}

func report_nested_calls(statement: Syntax.Statements.Statement, class_information: Analysis.ClassInfo) {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            report_nested_calls_in(statement.value)
            report_singletons_in_declared(statement.value, class_information)
            report_local_singleton(statement, class_information)
            report_written_handle_type(statement)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            report_nested_calls_in(statement.target)
            report_nested_calls_in(statement.value)
            report_inline_singletons(statement.target, class_information)
            report_inline_singletons(statement.value, class_information)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            report_nested_calls_in(statement.value)
            report_inline_singletons(statement.value, class_information)
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                report_nested_calls_in(statement.value)
                report_inline_singletons(statement.value, class_information)
            }
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            report_nested_calls_in(statement.value)
            report_inline_singletons(statement.value, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            report_nested_calls_in(statement.condition)
            report_inline_singletons(statement.condition, class_information)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            report_nested_calls_in(statement.condition)
            report_inline_singletons(statement.condition, class_information)
        }
        Syntax.Statements.SwitchStatement: {
            crash statement.subject
            report_nested_calls_in(statement.subject)
            report_inline_singletons(statement.subject, class_information)
        }
        _: return
    }
}

func report_singletons_in_declared(value: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var singleton = constructed_singleton(value, class_information)
    if singleton {
        report_singleton_arguments(value, class_information)
        return
    }
    report_inline_singletons(value, class_information)
}

func report_written_handle_type(declaration: Syntax.Statements.VariableDeclaration) {
    assert declaration.type_reference and declaration.value
    var written = shape.as_named_type(declaration.type_reference)
    assert written
    var written_kind = written.path.last()
    assert written.path.count() == 1 and (written_kind == "Parallel" or written_kind == "Concurrent")
    var started = shape.as_call(declaration.value)
    assert started
    crash started.callee
    var starter = shape.as_identifier(started.callee)
    assert starter
    assert starter.name == "Parallel" or starter.name == "Concurrent"
    var printer = Syntax.SourcePrinter()
    var construction_text = printer.source_expression(declaration.value)
    report(
        "the type of a '{starter.name}' handle is never written: it is worked out from the function it runs, so write 'var {declaration.name} = {construction_text}'",
    )
}

func has_no_attribute_to_spare(information: Analysis.ClassInfo): Boolean {
    var collections = ["List", "Vector", "Items", "Dictionary"]
    return information.is_value_class or collections.contains(information.qualified_dotted)
}

func report_local_singleton(declaration: Syntax.Statements.VariableDeclaration, class_information: Analysis.ClassInfo) {
    assert not has_no_attribute_to_spare(class_information)
    crash declaration.value
    var singleton = constructed_singleton(declaration.value, class_information)
    assert singleton
    var printer = Syntax.SourcePrinter()
    var construction_text = printer.source_expression(declaration.value)
    assert not construction_text.contains(".class") and not construction_text.contains("$")
    report(
        "'{singleton.qualified_dotted}' is a singleton, bound here as a local: bind it once beside the attributes, 'var {declaration.name} = {construction_text}', so every singleton the class uses is at the top of its file",
    )
}

func report_inline_singletons(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var singleton = constructed_singleton(expression, class_information)
    if singleton {
        report_unbound_singleton(singleton, expression, "")
        report_singleton_arguments(expression, class_information)
        return
    }
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            report_inline_singletons(expression.callee, class_information)
            report_inline_singletons_each(expression.arguments, class_information)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            report_inline_singletons(expression.callee, class_information)
            report_inline_singletons_each(expression.arguments, class_information)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            var receiver = constructed_singleton(expression.object, class_information)
            if receiver {
                if not made_from_walked_class(expression.object) {
                    report_unbound_singleton(receiver, expression.object, expression.name)
                }
                report_singleton_arguments(expression.object, class_information)
                return
            }
            report_inline_singletons(expression.object, class_information)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            report_inline_singletons(expression.left, class_information)
            report_inline_singletons(expression.right, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            report_inline_singletons(expression.operand, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            report_inline_singletons(expression.object, class_information)
            report_inline_singletons(expression.index, class_information)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                report_inline_singletons(element_value, class_information)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                report_inline_singletons(field_value, class_information)
                index = index + 1
            }
        }
        _: return
    }
}

func report_inline_singletons_each(
    expressions: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
) {
    var index = 0
    while index < expressions.count() {
        report_inline_singletons(expressions[index], class_information)
        index = index + 1
    }
}

func report_singleton_arguments(construction: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var call = shape.as_call(construction)
    if call {
        report_inline_singletons_each(call.arguments, class_information)
        return
    }
    var generic_call = shape.as_generic_call(construction)
    assert generic_call
    report_inline_singletons_each(generic_call.arguments, class_information)
}

func constructed_singleton(
    expression: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var call = shape.as_call(expression)
    if call {
        crash call.callee
        return singleton_named(call.callee, class_information)
    }
    var generic_call = shape.as_generic_call(expression)
    if generic_call {
        crash generic_call.callee
        return singleton_named(generic_call.callee, class_information)
    }
    return null
}

func singleton_named(
    callee: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var named_class = try_resolve_static_path(callee, class_information.qualified_dotted)
    assert named_class
    assert named_class.is_singleton
    return named_class
}

func made_from_walked_class(construction: Syntax.Expressions.Expression): Boolean {
    var printer = Syntax.SourcePrinter()
    var construction_text = printer.source_expression(construction)
    return construction_text.contains(".class>") or construction_text.contains(".class,")
}

func report_unbound_singleton(
    singleton: Analysis.ClassInfo,
    construction: Syntax.Expressions.Expression,
    member: String,
) {
    var printer = Syntax.SourcePrinter()
    var construction_text = printer.source_expression(construction)
    var variable = variable_name_for(singleton.simple_name)
    var use = variable
    if not member.is_empty() {
        use = "{variable}.{member}"
    }
    report(
        "'{singleton.simple_name}' is a singleton: bind it once beside the attributes, 'var {variable} = {construction_text}', and use '{use}'",
    )
}

func variable_name_for(class_name: String): String {
    var name = ""
    var index = 0
    while index < class_name.length() {
        var letter = class_name.slice(index, index + 1)
        var lower = letter.lower_case()
        if index > 0 and lower != letter {
            name = "{name}_"
        }
        name = name + lower
        index = index + 1
    }
    return name
}

func report_nested_calls_in(expression: Syntax.Expressions.Expression) {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            report_nested_calls_in(expression.callee)
            report_argument_calls(expression.callee, expression.arguments)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            report_nested_calls_in(expression.callee)
            report_argument_calls(expression.callee, expression.arguments)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            report_nested_calls_in(expression.left)
            report_nested_calls_in(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            report_nested_calls_in(expression.operand)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            report_nested_calls_in(expression.object)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            report_nested_calls_in(expression.object)
            report_nested_calls_in(expression.index)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                report_nested_calls_in(element_value)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                report_nested_calls_in(field_value)
                index = index + 1
            }
        }
        _: return
    }
}

func report_argument_calls(callee: Syntax.Expressions.Expression, arguments: List<Syntax.Expressions.Expression>) {
    if current_class {
        assert not spread_template(arguments, current_class)
    }
    if current_class {
        assert misnamed_plural_argument(arguments, current_class).is_empty()
    }
    var printer = Syntax.SourcePrinter()
    var called = printer.source_expression(callee)
    var index = 0
    while index < arguments.count() {
        report_calls_in_argument(arguments[index], called)
        index = index + 1
    }
}

func report_calls_in_argument(expression: Syntax.Expressions.Expression, called: String) {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            report_call_in_argument(expression, expression.callee, called)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            report_call_in_argument(expression, expression.callee, called)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if expression.is_text_join {
                report_nested_calls_in(expression.left)
                report_nested_calls_in(expression.right)
                return
            }
            report_calls_in_argument(expression.left, called)
            report_calls_in_argument(expression.right, called)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            report_calls_in_argument(expression.operand, called)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            report_calls_in_argument(expression.object, called)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            report_calls_in_argument(expression.object, called)
            report_calls_in_argument(expression.index, called)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                report_calls_in_argument(element_value, called)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                report_calls_in_argument(field_value, called)
                index = index + 1
            }
        }
        _: return
    }
}

func report_call_in_argument(
    call: Syntax.Expressions.Expression,
    callee: Syntax.Expressions.Expression,
    called: String,
) {
    var printer = Syntax.SourcePrinter()
    var call_text = printer.source_expression(call)
    var constructed = constructor_name(callee)
    if constructed.is_empty() {
        report(
            "'{call_text}' is called inside an argument of '{called}': compute it first into a named 'var' and pass the name",
        )
        return
    }
    if current_class {
        assert not constructed_singleton(call, current_class)
    }
    var variable = variable_name_for(constructed)
    report(
        "'{call_text}' is constructed inside an argument of '{called}': a constructor call is never an argument, so make it first on a line of its own, 'var {variable} = {call_text}', and pass '{variable}'",
    )
}

func constructor_name(callee: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(callee)
    if identifier {
        if starts_upper_case(identifier.name) {
            return identifier.name
        }
        return ""
    }
    var member = shape.as_member(callee)
    if member {
        if starts_upper_case(member.name) {
            return member.name
        }
    }
    return ""
}

func report_lone_holes(statement: Syntax.Statements.Statement, scope: Scope, class_information: Analysis.ClassInfo) {
    switch statement {
        Syntax.Statements.VariableDeclaration: report_lone_hole_declared(statement, scope, class_information)
        Syntax.Statements.AssignmentStatement: report_lone_hole_assigned(statement, scope, class_information)
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                report_lone_hole_returned(statement.value, scope, class_information)
            }
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            report_holes_in(statement.value, scope, class_information)
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            report_holes_in(statement.value, scope, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            report_holes_in(statement.condition, scope, class_information)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            report_holes_in(statement.condition, scope, class_information)
        }
        Syntax.Statements.SwitchStatement: {
            crash statement.subject
            report_holes_in(statement.subject, scope, class_information)
        }
        _: return
    }
}

func lone_hole_value(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    var text_join = shape.as_binary(expression)
    assert text_join
    assert text_join.is_text_join
    crash text_join.left
    var leading = shape.as_string_literal(text_join.left)
    assert leading
    assert leading.value.is_empty()
    return text_join.right
}

func report_lone_hole(text_expression: Syntax.Expressions.Expression, rewrite: String) {
    var printer = Syntax.SourcePrinter()
    var written = printer.source_expression(text_expression)
    report("'{written}' is a text of one value and nothing else: {rewrite}")
}

func probed_type(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType {
    var saved_counter = temporary_counter
    var probe = generate_expression(expression, scope, class_information)
    rewind_temporaries(saved_counter)
    return probe.type
}

func is_text_value(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var probe_type = probed_type(expression, scope, class_information)
    if not type_shape.as_string(probe_type) {
        return false
    }
    return true
}

func report_lone_hole_declared(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash declaration.value
    var hole = lone_hole_value(declaration.value)
    if hole {
        var printer = Syntax.SourcePrinter()
        var value_text = printer.source_expression(hole)
        var declared_type = declared_type_text(declaration, hole, scope, class_information)
        report_lone_hole(
            declaration.value,
            "declare the value directly, 'var {declaration.name}{declared_type} = {value_text}'",
        )
        return
    }
    report_holes_in(declaration.value, scope, class_information)
}

func declared_type_text(
    declaration: Syntax.Statements.VariableDeclaration,
    hole: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if declaration.type_reference {
        var printer = Syntax.SourcePrinter()
        var written_type = printer.source_type(declaration.type_reference)
        return ": {written_type}"
    }
    if is_text_value(hole, scope, class_information) {
        return ""
    }
    return ": String"
}

func report_lone_hole_assigned(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash assignment.target
    crash assignment.value
    report_holes_in(assignment.target, scope, class_information)
    var hole = lone_hole_value(assignment.value)
    if hole {
        var printer = Syntax.SourcePrinter()
        var target_text = printer.source_expression(assignment.target)
        var value_text = printer.source_expression(hole)
        report_lone_hole(assignment.value, "assign the value directly, '{target_text} = {value_text}'")
        return
    }
    report_holes_in(assignment.value, scope, class_information)
}

func report_lone_hole_returned(
    returned: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var hole = lone_hole_value(returned)
    if hole {
        var printer = Syntax.SourcePrinter()
        var value_text = printer.source_expression(hole)
        report_lone_hole(returned, "return the value directly, 'return {value_text}'")
        return
    }
    report_holes_in(returned, scope, class_information)
}

func report_holes_in(expression: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo) {
    var hole = lone_hole_value(expression)
    if hole {
        report_lone_hole_elsewhere(expression, hole, scope, class_information)
        return
    }
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            report_holes_in(expression.callee, scope, class_information)
            report_holes_passed(expression, expression.arguments, scope, class_information)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            report_holes_in(expression.callee, scope, class_information)
            report_holes_passed(expression, expression.arguments, scope, class_information)
        }
        Syntax.Expressions.BinaryExpression: report_holes_in_binary(expression, scope, class_information)
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            report_holes_in(expression.operand, scope, class_information)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            report_holes_in(expression.object, scope, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            report_holes_in(expression.object, scope, class_information)
            report_hole_indexed(expression, scope, class_information)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                report_holes_in(element_value, scope, class_information)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                report_holes_in(field_value, scope, class_information)
                index = index + 1
            }
        }
        _: return
    }
}

func report_holes_in_binary(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash binary.left
    crash binary.right
    if binary.is_text_join {
        report_holes_in_text(binary, scope, class_information)
        return
    }
    report_holes_in(binary.left, scope, class_information)
    var hole = lone_hole_value(binary.right)
    if hole {
        report_joined_hole(binary, hole, scope, class_information)
        return
    }
    report_holes_in(binary.right, scope, class_information)
}

func report_holes_in_text(
    text_join: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash text_join.left
    crash text_join.right
    var earlier = shape.as_binary(text_join.left)
    if earlier {
        report_holes_in_text(earlier, scope, class_information)
    }
    if not shape.as_string_literal(text_join.right) {
        report_holes_in(text_join.right, scope, class_information)
    }
}

func report_joined_hole(
    binary: Syntax.Expressions.BinaryExpression,
    hole: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash binary.left
    crash binary.right
    if binary.operator == 'add' and is_text_value(binary.left, scope, class_information) {
        var joined: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression('add', binary.left, hole)
        var printer = Syntax.SourcePrinter()
        var joined_text = printer.source_expression(joined)
        report_lone_hole(binary.right, "join the value directly, '{joined_text}'")
        return
    }
    report_lone_hole_elsewhere(binary.right, hole, scope, class_information)
}

func report_holes_passed(
    call: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var position = 0
    while position < arguments.count() {
        report_hole_passed(call, arguments, position, arguments[position], scope, class_information)
        position = position + 1
    }
}

func report_hole_passed(
    call: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    position: Integer,
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var hole = lone_hole_value(argument)
    if hole {
        var passed = passed_directly(arguments, position, hole)
        var rewritten = call_passing(call, passed)
        var printer = Syntax.SourcePrinter()
        var rewritten_text = printer.source_expression(rewritten)
        report_lone_hole(argument, "pass the value directly, '{rewritten_text}'")
        return
    }
    report_holes_in(argument, scope, class_information)
}

func passed_directly(
    arguments: List<Syntax.Expressions.Expression>,
    position: Integer,
    hole: Syntax.Expressions.Expression,
): List<Syntax.Expressions.Expression> {
    var passed = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        if index == position {
            passed.append(hole)
        } else {
            passed.append(argument)
        }
        index = index + 1
    }
    return passed
}

func call_passing(
    call: Syntax.Expressions.Expression,
    passed: List<Syntax.Expressions.Expression>,
): Syntax.Expressions.Expression {
    var generic_call = shape.as_generic_call(call)
    if generic_call {
        crash generic_call.callee
        var rewritten_generic = Syntax.Expressions.GenericCallExpression(
            generic_call.callee,
            generic_call.type_arguments,
            passed,
        )
        rewritten_generic.names_class = generic_call.names_class
        return rewritten_generic
    }
    var plain_call = shape.as_call(call)
    crash plain_call
    crash plain_call.callee
    return Syntax.Expressions.CallExpression(plain_call.callee, passed)
}

func report_hole_indexed(
    indexed: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash indexed.object
    crash indexed.index
    var hole = lone_hole_value(indexed.index)
    if hole {
        report_indexed_hole(indexed, hole, scope, class_information)
        return
    }
    report_holes_in(indexed.index, scope, class_information)
}

func report_indexed_hole(
    indexed: Syntax.Expressions.IndexExpression,
    hole: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash indexed.object
    crash indexed.index
    var object_type = probed_type(indexed.object, scope, class_information)
    if type_shape.as_dictionary(object_type) {
        var looked_up: Syntax.Expressions.Expression = Syntax.Expressions.IndexExpression(indexed.object, hole)
        var printer = Syntax.SourcePrinter()
        var looked_up_text = printer.source_expression(looked_up)
        report_lone_hole(indexed.index, "look it up by the value directly, '{looked_up_text}'")
        return
    }
    report_lone_hole_elsewhere(indexed.index, hole, scope, class_information)
}

func report_lone_hole_elsewhere(
    text_expression: Syntax.Expressions.Expression,
    hole: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var printer = Syntax.SourcePrinter()
    if is_text_value(hole, scope, class_information) {
        var value_text = printer.source_expression(hole)
        report_lone_hole(text_expression, "write the value directly, '{value_text}'")
        return
    }
    var converted = to_string_ast(hole)
    var converted_text = printer.source_expression(converted)
    report_lone_hole(text_expression, "write its text as '{converted_text}'")
}

func generate_switch_statement(
    switch_statement: Syntax.Statements.SwitchStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert switch_statement.subject
    var guard = try_nullable_guard(switch_statement.subject, scope, class_information)
    if guard {
        generate_nullable_switch(switch_statement, scope, class_information, function_information, guard)
        return
    }
    var subject = generate_expression(switch_statement.subject, scope, class_information)
    var subject_type = subject.type
    if type_shape.as_nullable(subject_type) {
        report("switch over a value that may be null needs a variable or an attribute as its subject")
        return
    }
    if takes_value_cases(subject_type) {
        generate_value_switch(switch_statement, subject, scope, class_information, function_information)
        return
    }
    var subject_union = type_shape.as_union(subject_type)
    if not subject_union {
        report(
            "a switch is over a union, a 'T?', an enum, a whole number or a text, and this is {type_with_article(subject_type)}",
        )
        return
    }
    var information = find_union_by_c_name(subject_union.c_name)
    assert information
    if information.is_shape {
        report(
            "switch needs a union: '{information.simple_name}' is a type matched by shape, so read its attributes directly",
        )
        return
    }
    var subject_temporary = next_temporary()
    builder.add_user("\{")
    builder.add_user("{subject_union.c_name} {subject_temporary} = {subject.code};")
    var subject_identifier = shape.as_identifier(switch_statement.subject)
    report_repeated_cases(switch_statement)
    report_single_case(switch_statement)
    var covered_names = List<String>()
    var answers_the_rest = false
    var case_index = 0
    while case_index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[case_index]
        if is_rest_case(switch_case) {
            report_misplaced_rest_case(switch_statement, case_index, covered_names, information)
            answers_the_rest = true
            generate_rest_case(
                switch_case,
                case_index,
                information,
                subject_temporary,
                subject_identifier,
                covered_names,
                scope,
                class_information,
                function_information,
            )
        } else {
            generate_union_case(
                switch_case,
                case_index,
                information,
                subject_temporary,
                subject_identifier,
                covered_names,
                scope,
                class_information,
                function_information,
            )
        }
        case_index = case_index + 1
    }
    if covered_names.count() != information.members.count() and not answers_the_rest {
        var missing = List<String>()
        var member_index = 0
        while member_index < information.members.count() {
            var member_name = information.members[member_index].simple_name
            if not covered_names.contains(member_name) {
                missing.append(member_name)
            }
            member_index = member_index + 1
        }
        report(
            "this switch over '{information.simple_name}' has no case for {missing.join(", ")}: a switch over a union covers every member, so a member added later cannot be forgotten; add the cases, or end with '_:' for the rest",
        )
    }
    if owns(subject, switch_statement.subject) {
        builder.add_user("{release_call(subject_type, subject_temporary)};")
    }
    builder.add_user("}")
}

func report_value_chain(
    statements: List<Syntax.Statements.Statement>,
    index: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var subject = statement_subject(statements, index)
    assert not subject.is_empty() and statement_subject(statements, index - 1) != subject
    var arms = List<Syntax.Statements.IfStatement>()
    var next = index
    while statement_subject(statements, next) == subject {
        crash statements[next]
        var arm = shape.as_if_statement(statements[next])
        crash arm
        arms.append(arm)
        next = next + 1
    }
    var rest = "..."
    if next < statements.count() {
        rest = answer_text(statements[next])
    }
    report_chain_of(arms, subject, rest, scope, class_information)
}

# ../../../docs/control_flow.md#return-converts-to-the-functions-type
func report_returned_local(
    statements: List<Syntax.Statements.Statement>,
    index: Integer,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert index + 1 < statements.count()
    var declaration = shape.as_variable_declaration(statements[index])
    assert declaration
    assert declaration.value
    var returned = shape.as_return_statement(statements[index + 1])
    assert returned
    assert returned.value
    var returned_name = shape.as_identifier(returned.value)
    assert returned_name
    assert returned_name.name == declaration.name
    var return_type_name = type_display_name(function_information.return_type)
    if declaration.type_reference {
        var declared = resolve_type(declaration.type_reference, class_information.qualified_dotted)
        assert types_equal(declared, function_information.return_type)
    }
    var source = Syntax.SourcePrinter().source_expression(declaration.value)
    current_line = declaration.line
    report(
        "'{declaration.name}' is declared only to be returned on the next line: write 'return {source}', since 'return' already makes the value the function's {return_type_name}",
    )
}

func statement_subject(statements: List<Syntax.Statements.Statement>, index: Integer): String {
    var subject = ""
    if index >= 0 and index < statements.count() {
        var arm = shape.as_if_statement(statements[index])
        if arm {
            if not arm.has_else_branch {
                subject = compared_subject(arm)
            }
        }
    }
    return subject
}

func compared_subject(if_statement: Syntax.Statements.IfStatement): String {
    var subject = ""
    var only = if_statement.then_branch.first()
    if only and if_statement.condition and if_statement.then_branch.count() == 1 {
        if only == Syntax.Statements.ReturnStatement {
            subject = constant_comparison_subject(if_statement.condition)
        }
    }
    return subject
}

func constant_comparison_subject(condition: Syntax.Expressions.Expression): String {
    var subject = ""
    var binary = shape.as_binary(condition)
    if binary {
        if binary.operator == 'equal' and binary.left and binary.right {
            subject = compared_path(binary.left, binary.right)
        }
    }
    return subject
}

func compared_path(left: Syntax.Expressions.Expression, right: Syntax.Expressions.Expression): String {
    var printed = Syntax.SourcePrinter().source_expression(left)
    var literal = shape.as_enum_literal(right)
    var constant = is_constant_case(right)
    if literal {
        constant = true
    }
    var subject = ""
    if constant and not printed.contains("(") {
        subject = printed
    }
    return subject
}

func report_else_chain(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert not if_statement.follows_else and if_statement.has_else_branch
    var subject = compared_subject(if_statement)
    assert not subject.is_empty()
    var arms = List<Syntax.Statements.IfStatement>()
    var rest = collect_else_arms(if_statement, subject, arms)
    report_chain_of(arms, subject, rest, scope, class_information)
}

func collect_else_arms(
    link: Syntax.Statements.IfStatement,
    subject: String,
    arms: List<Syntax.Statements.IfStatement>,
): String {
    if compared_subject(link) != subject {
        return "..."
    }
    arms.append(link)
    var chained = chained_if(link)
    if chained {
        return collect_else_arms(chained, subject, arms)
    }
    var only = link.else_branch.first()
    if only and link.else_branch.count() == 1 {
        return answer_text(only)
    }
    return "..."
}

func answer_text(statement: Syntax.Statements.Statement): String {
    var returned = shape.as_return_statement(statement)
    var text = "..."
    if returned {
        text = "return"
        if returned.value {
            text = "return {Syntax.SourcePrinter().source_expression(returned.value)}"
        }
    }
    return text
}

func report_chain_of(
    arms: List<Syntax.Statements.IfStatement>,
    subject: String,
    rest: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert arms.count() >= 3
    var first_line = arms[0].line
    var covers = covers_every_value(arms[0], arms, scope, class_information)
    var cases = List<String>()
    var cases_index = 0
    while cases_index < arms.count() {
        var cases_item = chain_case(arms[cases_index])
        cases.append(cases_item)
        cases_index = cases_index + 1
    }
    if not covers {
        cases.append("_: {rest}")
    }
    var saved_line = current_line
    current_line = first_line
    report(
        "these {arms.count()} 'if's each compare '{subject}' with a value and return, which is what a 'switch' says: write 'switch {subject} \{ {cases.join("  ")} }'",
    )
    current_line = saved_line
}

func chain_case(arm: Syntax.Statements.IfStatement): String {
    var only = arm.then_branch.first()
    crash only
    return "{compared_constant(arm)}: {answer_text(only)}"
}

func compared_constant(arm: Syntax.Statements.IfStatement): String {
    crash arm.condition
    var binary = shape.as_binary(arm.condition)
    crash binary
    crash binary.right
    return Syntax.SourcePrinter().source_expression(binary.right)
}

func covers_every_value(
    arm: Syntax.Statements.IfStatement,
    arms: List<Syntax.Statements.IfStatement>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash arm.condition
    var binary = shape.as_binary(arm.condition)
    crash binary
    crash binary.left
    var constants = List<String>()
    var constants_index = 0
    while constants_index < arms.count() {
        var constants_item = compared_constant(arms[constants_index])
        constants.append(constants_item)
        constants_index = constants_index + 1
    }
    var subject_type = lookup_static_type(binary.left, scope, class_information)
    var covers = false
    if subject_type {
        var enum_type = type_shape.as_enum(subject_type)
        if enum_type {
            covers = true
            var value_index = 0
            while value_index < enum_type.values.count() {
                if not constants.contains("'{enum_type.values[value_index]}'") {
                    covers = false
                }
                value_index = value_index + 1
            }
        }
    }
    return covers
}

func takes_value_cases(subject_type: Analysis.SpiteType): Boolean {
    var enum_type = type_shape.as_enum(subject_type)
    var takes = type_shape.as_string(subject_type) or is_whole_number_type(subject_type)
    if enum_type {
        takes = true
    }
    return takes
}

func generate_value_switch(
    switch_statement: Syntax.Statements.SwitchStatement,
    subject: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    crash switch_statement.subject
    var subject_type = subject.type
    var subject_temporary = next_temporary()
    builder.add_user("\{")
    builder.add_user("{c_type_name(subject_type)} {subject_temporary} = {subject.code};")
    report_repeated_cases(switch_statement)
    report_single_case(switch_statement)
    var probe_scope = Scope(scope)
    probe_scope.declare(subject_temporary, subject_type)
    probe_scope.set_override(subject_temporary, subject_temporary)
    var covered = List<String>()
    var answers_the_rest = false
    var chained = false
    var case_index = 0
    while case_index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[case_index]
        if is_rest_case(switch_case) {
            report_misplaced_value_rest(switch_statement, case_index)
            answers_the_rest = true
            var opening = rest_opening(chained)
            builder.add_user(opening)
        } else {
            var test = value_case_test(
                switch_case,
                subject_temporary,
                subject_type,
                covered,
                probe_scope,
                class_information,
            )
            builder.add_user("{case_keyword(chained)}({test}) \{")
            chained = true
        }
        generate_block(switch_case.body, scope, class_information, function_information)
        builder.add_user("}")
        case_index = case_index + 1
    }
    report_value_coverage(switch_statement.subject, subject_type, covered, answers_the_rest)
    var switched_enum = type_shape.as_enum(subject_type)
    if hot_reload and switched_enum and chained and not answers_the_rest {
        builder.add_user(
            "else \{ fflush(stdout); fprintf(stderr, \"spite: a switch over {enum_shown(switched_enum.c_name)} met the value '%s', which a reload removed from it: restart the program, or put the value back\\n\", {switched_enum.c_name}___name({subject_temporary})); exit(1); }",
        )
    }
    if owns(subject, switch_statement.subject) {
        builder.add_user("{release_call(subject_type, subject_temporary)};")
    }
    builder.add_user("}")
}

func rest_opening(chained: Boolean): String {
    if chained {
        return "else \{"
    }
    return "\{"
}

func case_keyword(chained: Boolean): String {
    if chained {
        return "else if "
    }
    return "if "
}

func report_misplaced_value_rest(switch_statement: Syntax.Statements.SwitchStatement, case_index: Integer) {
    if case_index != switch_statement.cases.count() - 1 {
        report("'_:' answers for every value without a case of its own, so it is the last case")
    }
}

func report_value_coverage(
    subject_ast: Syntax.Expressions.Expression,
    subject_type: Analysis.SpiteType,
    covered: List<String>,
    answers_the_rest: Boolean,
) {
    var subject_text = Syntax.SourcePrinter().source_expression(subject_ast)
    var enum_type = type_shape.as_enum(subject_type)
    if not enum_type {
        if not answers_the_rest {
            report(
                "this switch over '{subject_text}' has no '_:': {type_with_article(subject_type)} has more values than a switch can list, so its last case is '_:', for every value without a case of its own",
            )
        }
        return
    }
    var missing = List<String>()
    var index = 0
    while index < enum_type.values.count() {
        var quoted = "'{enum_type.values[index]}'"
        if not covered.contains(quoted) {
            missing.append(quoted)
        }
        index = index + 1
    }
    var enum_name = type_display_name(subject_type)
    if missing.is_empty() and answers_the_rest {
        report("every value of '{enum_name}' already has a case, so '_:' answers for nothing: remove it")
    } else if not missing.is_empty() and not answers_the_rest {
        report(
            "this switch over '{subject_text}' has no case for {missing.join(", ")}: a switch over an enum covers every value, so a value added later cannot be forgotten; add the cases, or end with '_:' for the rest",
        )
    }
}

func value_case_test(
    switch_case: Syntax.Statements.SwitchCase,
    subject_temporary: String,
    subject_type: Analysis.SpiteType,
    covered: List<String>,
    probe_scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if not switch_case.value {
        report(
            "a case of a switch over {type_with_article(subject_type)} is one of its values, like {example_case(subject_type)}, never a class",
        )
        return "0"
    }
    var label = Syntax.SourcePrinter().source_expression(switch_case.value)
    if covered.contains(label) {
        report("this switch has two cases for {label}: keep one")
    }
    var enum_type = type_shape.as_enum(subject_type)
    if enum_type {
        return enum_case_test(switch_case.value, enum_type, subject_temporary, subject_type, covered)
    }
    if not is_constant_case(switch_case.value) {
        report(
            "a case of a switch is a value written out (a whole number or a text), never a name or a call, and '{label}' is not one",
        )
        return "0"
    }
    covered.append(label)
    var subject_ast = Syntax.Expressions.IdentifierExpression(subject_temporary)
    var comparison = Syntax.Expressions.BinaryExpression('equal', subject_ast, switch_case.value)
    var compared = generate_joined(comparison, probe_scope, class_information)
    return owned_truth(compared, comparison)
}

func enum_case_test(
    value: Syntax.Expressions.Expression,
    enum_type: Analysis.Types.EnumType,
    subject_temporary: String,
    subject_type: Analysis.SpiteType,
    covered: List<String>,
): String {
    var literal = shape.as_enum_literal(value)
    if not literal {
        report(
            "a case of a switch over {type_with_article(subject_type)} is one of its values, like {example_case(subject_type)}",
        )
        return "0"
    }
    covered.append("'{literal.value}'")
    return "{subject_temporary} == {enum_value_code(literal, enum_type)}"
}

func example_case(subject_type: Analysis.SpiteType): String {
    var enum_type = type_shape.as_enum(subject_type)
    if enum_type {
        var first_value = enum_type.values.first()
        crash first_value
        return "'{first_value}'"
    }
    if type_shape.as_string(subject_type) {
        return "\"text\""
    }
    return "1"
}

func is_constant_case(value: Syntax.Expressions.Expression): Boolean {
    var constant = false
    var integer = shape.as_integer_literal(value)
    if integer {
        constant = true
    }
    var text = shape.as_string_literal(value)
    if text {
        constant = true
    }
    var unary = shape.as_unary(value)
    if unary {
        if unary.operator == 'negate' and unary.operand {
            var negated = shape.as_integer_literal(unary.operand)
            if negated {
                constant = true
            }
        }
    }
    return constant
}

func generate_union_dispatch(
    information: Analysis.UnionInfo,
    member_name: String,
    is_call: Boolean,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if is_call and member_name == "deep_copy" and arguments_ast.is_empty() {
        var union_deep_copy = ensure_union_deep_copy(information)
        var copied_union_type = union_type_of(information)
        var no_argument_types = no_types()
        var union_copied = generate_generic_call(
            union_deep_copy,
            object_result,
            object_ast,
            arguments_ast,
            no_argument_types,
            copied_union_type,
            scope,
            class_information,
        )
        union_copied.owning_override = true
        return union_copied
    }
    if information.is_shape {
        if is_call {
            return generate_shape_call(
                information,
                member_name,
                object_result,
                object_ast,
                arguments_ast,
                scope,
                class_information,
            )
        }
        var wanted = find_required_function(information, member_name)
        var row_name = operand_text(object_ast)
        var from_row = is_row_name(object_ast, scope)
        if wanted {
            if from_row {
                report(
                    "'{row_name}.{member_name}' would keep '{row_name}', which holds items borrowed from '{scope.row_source(row_name)}' for this call, in a function value: call '{row_name}.{member_name}()' instead",
                )
            }
            return shape_function_value(information, wanted, object_result, object_ast)
        }
        if from_row {
            return generate_row_read(information, member_name, object_result, row_name)
        }
        return generate_shape_read(information, member_name, object_result, object_ast)
    }
    var first_member = information.members.first()
    crash first_member
    var result_type = void_type()
    var expected_types = no_types()
    if is_call {
        var first_function = find_or_instantiate_function(first_member, member_name)
        if not first_function {
            report(
                "'{first_member.simple_name}' does not define '{member_name}', so it cannot be called on union '{information.simple_name}'",
            )
            return void_result()
        }
        result_type = first_function.return_type
        expected_types = parameter_types_of(first_function.parameters)
    } else {
        var first_type = union_read_type(first_member, member_name)
        if not first_type {
            report(
                "'{first_member.simple_name}' has no attribute '{member_name}', so it cannot be read on union '{information.simple_name}'",
            )
            return void_result()
        }
        result_type = first_type
        mark_members_read(information.members, member_name)
    }
    var owning_object = owns(object_result, object_ast)
    if is_call and waits_through_union(information, member_name) {
        var union_wait = UnionWait(information, member_name, expected_types, result_type)
        return waited_union_call(union_wait, object_result, owning_object, arguments_ast, scope, class_information)
    }
    var lines = List<String>()
    var object_temporary = next_temporary()
    lines.append("{information.c_name} {object_temporary} = {object_result.code};")
    var argument_temporaries = List<String>()
    var argument_index = 0
    while argument_index < arguments_ast.count() {
        var argument_temporary = next_temporary()
        lines.append(
            "{c_type_name(expected_types[argument_index])} {argument_temporary} = {coerce_for_store(arguments_ast[argument_index], expected_types[argument_index], scope, class_information)};",
        )
        argument_temporaries.append(argument_temporary)
        argument_index = argument_index + 1
    }
    var has_result = not type_shape.is_void(result_type)
    var result_temporary = next_temporary()
    if has_result {
        lines.append("{c_type_name(result_type)} {result_temporary} = {default_value_for_scalar_or_null(result_type)};")
    }
    var answered_by_function = false
    var checked_index = 0
    while checked_index < information.members.count() and not is_call {
        if not information.members[checked_index].find_field(member_name) {
            answered_by_function = true
        }
        checked_index = checked_index + 1
    }
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var casted_object = "(({member.c_name}*){object_temporary})"
        var branch_code = ""
        if is_call {
            branch_code = union_member_call(member, member_name, casted_object, argument_temporaries, information)
        } else if not member.find_field(member_name) {
            var no_temporaries = List<String>()
            branch_code = union_member_call(member, "get_{member_name}", casted_object, no_temporaries, information)
        } else {
            branch_code = field_place(casted_object, member, member_name)
            if (owning_object or answered_by_function) and type_needs_drop(result_type) {
                branch_code = retain_call(result_type, branch_code)
            }
        }
        var keyword = "if "
        if member_index > 0 {
            keyword = "else if "
        }
        var member_test = class_id_test(object_temporary, member)
        if has_result {
            lines.append(keyword + "{member_test} \{ {result_temporary} = {branch_code}; }")
        } else {
            lines.append(keyword + "{member_test} \{ {branch_code}; }")
        }
        member_index = member_index + 1
    }
    if owning_object {
        lines.append("{information.c_name}___release({object_temporary});")
    }
    if has_result {
        lines.append("{result_temporary};")
    }
    var dispatched = ExpressionResult("(\{ {lines.join(" ")} })", result_type)
    if answered_by_function and type_needs_drop(result_type) {
        dispatched.owning_override = true
    }
    return dispatched
}

func union_read_type(member: Analysis.ClassInfo, member_name: String): Analysis.SpiteType? {
    var field = member.find_field(member_name)
    if field {
        return field.type
    }
    var getter = member.find_function("get_{member_name}")
    if getter {
        return getter.return_type
    }
    return null
}

func union_member_call(
    member: Analysis.ClassInfo,
    member_name: String,
    casted_object: String,
    argument_temporaries: List<String>,
    information: Analysis.UnionInfo,
): String {
    var found_function = find_or_instantiate_function(member, member_name)
    if found_function {
        note_wait_edge(found_function.c_name)
        var call_arguments = argument_temporaries.copy()
        call_arguments.prepend(casted_object)
        return "{found_function.c_name}({call_arguments.join(", ")})"
    }
    report(
        "'{member.simple_name}' does not define '{member_name}', so it cannot be called on union '{information.simple_name}'",
    )
    return ""
}

func default_value_for_scalar_or_null(spite_type: Analysis.SpiteType): String {
    if type_is_reference(spite_type) {
        return null_code(spite_type)
    }
    return default_value_for_type(spite_type)
}

func check_asserted_condition(
    assert_statement: Syntax.Statements.AssertStatement,
    condition_result: ExpressionResult,
    scope: Scope,
) {
    var keyword = "assert"
    if assert_statement.is_crash {
        keyword = "crash"
    }
    var proof = earlier_proof(assert_statement.value, condition_result, scope)
    if proof.is_empty() {
        check_condition(assert_statement.value, condition_result, keyword, scope)
    } else {
        var proven_path = operand_text(assert_statement.value)
        report("'{proven_path}' is already proven by {proof}, so this '{keyword}' proves nothing: remove it")
    }
}

func earlier_proof(value: Syntax.Expressions.Expression, condition: ExpressionResult, scope: Scope): String {
    var condition_type = condition.type
    if type_shape.is_void(condition_type) {
        return ""
    }
    if type_shape.as_nullable(condition_type) {
        return ""
    }
    if is_boolean_type(condition_type) {
        return ""
    }
    if not shape.as_index(value) {
        return ""
    }
    var path = operand_text(value)
    if path.is_empty() {
        return ""
    }
    if not scope.proven_inside_loop(path) {
        return ""
    }
    var proof = scope.proof_of(path)
    if proof.is_empty() {
        return "an earlier check"
    }
    return proof
}

func check_keyword(check: Syntax.Statements.AssertStatement): String {
    if check.is_crash {
        return "crash"
    }
    return "assert"
}

# ../../../docs/proofs.md#proving-what-is-proven-is-an-error
func report_known_fact(
    condition_ast: Syntax.Expressions.Expression,
    condition_type: Analysis.SpiteType,
    scope: Scope,
): Boolean {
    var path = operand_text(condition_ast)
    if not path.is_empty() and not is_boolean_type(condition_type) {
        var site = scope.site_of(path)
        if not site.is_empty() {
            report("'{path}' is already narrowed by {site}: remove this check")
            return true
        }
        return false
    }
    var binary = shape.as_binary(condition_ast)
    if not binary or binary.operator != 'not_equal' and binary.operator != 'greater' {
        return false
    }
    crash binary.left
    crash binary.right
    var bound = shape.as_integer_literal(binary.right)
    var divisor_text = operand_text(binary.left)
    if not bound or bound.value != 0 or divisor_text.is_empty() {
        return false
    }
    if not scope.is_present_narrowed("~[{divisor_text}]") {
        return false
    }
    var proof = scope.site_of("~[{divisor_text}]")
    if proof.is_empty() {
        return false
    }
    if binary.operator == 'greater' and scope.site_of("~>[{divisor_text}]") != proof {
        return false
    }
    var written = Syntax.SourcePrinter().source_expression(condition_ast)
    report("'{written}' is already proven by {proof}: remove this check")
    return true
}

func check_condition(
    condition_ast: Syntax.Expressions.Expression,
    condition: ExpressionResult,
    keyword: String,
    scope: Scope,
) {
    var condition_type = condition.type
    assert not type_shape.is_void(condition_type)
    assert not type_shape.as_nullable(condition_type)
    assert not report_known_fact(condition_ast, condition_type, scope)
    if type_shape.as_class_ref(condition_type) {
        report(
            "this value cannot be null here (it is {type_with_article(condition_type)}), so '{keyword}' on it proves nothing: remove the check",
        )
        return
    }
    if not is_boolean_type(condition_type) {
        report(
            "the condition of '{keyword}' is {type_with_article(condition_type)}, but it must be a Boolean: compare it with something, like 'count > 0' or 'name != \"\"'",
        )
    }
}

func narrow_proven_indices(
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var negated = shape.as_unary(condition)
    if negated {
        narrow_not_empty(negated, scope)
        return
    }
    var binary = shape.as_binary(condition)
    assert binary
    crash binary.left
    crash binary.right
    if binary.operator == 'logical_and' {
        narrow_proven_indices(binary.left, scope, class_information)
        narrow_proven_indices(binary.right, scope, class_information)
        return
    }
    narrow_ranges(binary, scope, class_information)
    narrow_not_negative(binary, scope)
    narrow_width_room(binary, scope)
    narrow_area_room(binary, scope)
    narrow_counter_room(binary, scope)
    narrow_nonzero(binary, scope)
    if binary.operator == 'less' {
        narrow_counted_element(condition, scope)
        return
    }
    var counted = counted_list_text(binary.left)
    assert not counted.is_empty()
    var condition_text = Syntax.SourcePrinter().source_expression(condition)
    var named_bound = operand_text(binary.right)
    if binary.operator == 'greater' and not named_bound.is_empty() {
        scope.narrow_bound_path("{counted}[{named_bound}]", condition_text)
        return
    }
    var bound = shape.as_integer_literal(binary.right)
    assert bound
    var proven = 0
    if binary.operator == 'equal' or binary.operator == 'greater_equal' {
        proven = bound.value
    } else if binary.operator == 'greater' {
        proven = bound.value + 1
    } else if binary.operator == 'not_equal' and bound.value == 0 {
        proven = 1
    }
    var index = 0
    while index < proven and index < 64 {
        scope.narrow_bound_path("{counted}[{index}]", condition_text)
        index = index + 1
    }
}

func narrow_not_negative(binary: Syntax.Expressions.BinaryExpression, scope: Scope) {
    assert binary.operator == 'greater_equal' or binary.operator == 'greater'
    crash binary.left
    crash binary.right
    var zero = shape.as_integer_literal(binary.right)
    assert zero
    assert zero.value == 0
    var named = operand_text(binary.left)
    assert not named.is_empty()
    scope.narrow_path("~0[{named}]")
}

func narrow_width_room(binary: Syntax.Expressions.BinaryExpression, scope: Scope) {
    crash binary.left
    crash binary.right
    var counted = ""
    var reached_ast = binary.left
    if binary.operator == 'less_equal' {
        counted = counted_list_text(binary.right)
    } else if binary.operator == 'greater_equal' {
        counted = counted_list_text(binary.left)
        reached_ast = binary.right
    }
    assert not counted.is_empty()
    var reached = shape.as_binary(reached_ast)
    assert reached
    crash reached.left
    crash reached.right
    assert reached.operator == 'add'
    var room = shape.as_integer_literal(reached.right)
    assert room
    assert room.value >= 1 and room.value <= 64
    var condition_text = Syntax.SourcePrinter().source_expression(binary)
    var reach: Integer = room.value - 1
    if reach == 0 {
        var base_text = index_key_text(reached.left)
        assert not base_text.is_empty()
        scope.narrow_bound_path("{counted}[{base_text}]", condition_text)
        return
    }
    narrow_stride(counted, reached.left, reach, condition_text, scope)
}

func narrow_area_room(binary: Syntax.Expressions.BinaryExpression, scope: Scope) {
    crash binary.left
    crash binary.right
    var counted = ""
    var area_ast = binary.left
    if binary.operator == 'less_equal' {
        counted = counted_list_text(binary.right)
    } else if binary.operator == 'greater_equal' {
        counted = counted_list_text(binary.left)
        area_ast = binary.right
    }
    assert not counted.is_empty()
    var area = shape.as_binary(area_ast)
    assert area
    crash area.left
    crash area.right
    assert area.operator == 'multiply'
    var rows = index_key_text(area.left)
    var stride = index_key_text(area.right)
    assert not rows.is_empty() and not stride.is_empty()
    var condition_text = Syntax.SourcePrinter().source_expression(binary)
    scope.narrow_bound_path("{counted}[<*{rows}*{stride}]", condition_text)
}

# ../../../docs/proofs.md#an-index-built-from-loop-counters-is-proven-by-one-guard
func narrow_loop_counter(
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    function_information: Analysis.FunctionInfo,
) {
    var binary = shape.as_binary(condition)
    assert binary
    crash binary.left
    crash binary.right
    assert binary.operator == 'less'
    var counter = counted_counter(binary.left)
    assert counter
    assert is_local_counter(counter.name, scope, function_information)
    assert never_negative(counter.name, function_information.body)
    var bound = index_key_text(binary.right)
    assert not bound.is_empty()
    var reach = counted_reach(binary.left)
    scope.narrow_path("~<[{counter.name}:{reach}:{bound}]")
}

func never_negative(counter: String, statements: List<Syntax.Statements.Statement>): Boolean {
    var index = 0
    while index < statements.count() {
        if not statement_never_negative(counter, statements[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func statement_never_negative(counter: String, statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            return statement.name != counter or is_counter_start(statement.value)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            if not is_identifier_named(statement.target, counter) {
                return true
            }
            return is_counter_start(statement.value) or steps_up(counter, statement.value)
        }
        Syntax.Statements.IfStatement: return never_negative(counter, statement.then_branch) and never_negative(counter, statement.else_branch)
        Syntax.Statements.WhileStatement: return never_negative(counter, statement.body)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                if not never_negative(counter, statement.cases[case_index].body) {
                    return false
                }
                case_index = case_index + 1
            }
            return true
        }
        _: return true
    }
}

func steps_up(counter: String, value: Syntax.Expressions.Expression): Boolean {
    var sum = shape.as_binary(value)
    if not sum {
        return false
    }
    crash sum.left
    crash sum.right
    if sum.operator != 'add' or not is_identifier_named(sum.left, counter) {
        return false
    }
    var step = shape.as_integer_literal(sum.right)
    if not step {
        return false
    }
    return step.value >= 0
}

func narrow_literal_indices(declaration: Syntax.Statements.VariableDeclaration, scope: Scope) {
    assert declaration.value
    var literal = shape.as_list_literal(declaration.value)
    assert literal
    var printer = Syntax.SourcePrinter()
    var written = "var {declaration.name} = {printer.source_expression(declaration.value)}"
    var index = 0
    while index < literal.elements.count() and index < 64 {
        scope.narrow_bound_path("{declaration.name}[{index}]", written)
        index = index + 1
    }
}

func narrow_not_empty(negated: Syntax.Expressions.UnaryExpression, scope: Scope) {
    assert negated.operator == 'logical_not'
    crash negated.operand
    var call = shape.as_call(negated.operand)
    assert call
    crash call.callee
    assert call.arguments.is_empty()
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    assert member.name == "is_empty"
    var emptied = operand_text(member.object)
    assert not emptied.is_empty()
    var condition_text = Syntax.SourcePrinter().source_expression(negated)
    scope.narrow_bound_path("{emptied}[0]", condition_text)
}

func narrow_counter_room(binary: Syntax.Expressions.BinaryExpression, scope: Scope) {
    assert binary.operator == 'less' or binary.operator == 'greater'
    crash binary.left
    var counter = shape.as_identifier(binary.left)
    assert counter
    assert scope.unnarrowed_type(counter.name)
    if binary.operator == 'less' {
        scope.narrow_path("~+[{counter.name}]")
        return
    }
    scope.narrow_path("~-[{counter.name}]")
}

func narrow_nonzero(binary: Syntax.Expressions.BinaryExpression, scope: Scope) {
    assert binary.operator == 'not_equal' or binary.operator == 'greater'
    crash binary.left
    crash binary.right
    var bound = shape.as_integer_literal(binary.right)
    assert bound
    assert bound.value == 0
    var divisor_text = operand_text(binary.left)
    assert not divisor_text.is_empty()
    scope.narrow_path("~[{divisor_text}]")
    var written = Syntax.SourcePrinter().source_expression(binary)
    var site = "'{written}' on line {current_line}"
    scope.note_site("~[{divisor_text}]", site)
    if binary.operator == 'greater' {
        scope.note_site("~>[{divisor_text}]", site)
    }
}

func narrow_counted_element(condition: Syntax.Expressions.Expression, scope: Scope) {
    var binary = shape.as_binary(condition)
    assert binary
    crash binary.left
    crash binary.right
    assert binary.operator == 'less'
    var counted = counted_list_text(binary.right)
    if counted.is_empty() {
        counted = counted_alias(binary.right, scope)
    }
    assert not counted.is_empty()
    var condition_text = Syntax.SourcePrinter().source_expression(condition)
    var stride = shape.as_binary(binary.left)
    if stride {
        var reach = stride_reach(stride)
        if reach >= 0 {
            crash stride.left
            narrow_stride(counted, stride.left, reach, condition_text, scope)
            return
        }
    }
    var counter = index_key_text(binary.left)
    assert not counter.is_empty()
    scope.narrow_bound_path("{counted}[{counter}]", condition_text)
}

func stride_reach(stride: Syntax.Expressions.BinaryExpression): Integer {
    if stride.operator != 'add' or not stride.left or not stride.right {
        return -1
    }
    var reach = shape.as_integer_literal(stride.right)
    if not reach {
        return -1
    }
    if reach.value < 1 or reach.value > 63 {
        return -1
    }
    return reach.value
}

func narrow_stride(
    counted: String,
    base: Syntax.Expressions.Expression,
    reach: Integer,
    condition_text: String,
    scope: Scope,
) {
    var base_text = index_key_text(base)
    assert not base_text.is_empty()
    scope.narrow_bound_path("{counted}[{base_text}]", condition_text)
    var offset = 1
    while offset <= reach {
        var step: Syntax.Expressions.Expression = Syntax.Expressions.IntegerLiteral(offset)
        var stepped: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression('add', base, step)
        var key = index_key_text(stepped)
        if not key.is_empty() {
            scope.narrow_bound_path("{counted}[{key}]", condition_text)
        }
        offset = offset + 1
    }
}

func counted_alias(bound: Syntax.Expressions.Expression, scope: Scope): String {
    var named = shape.as_identifier(bound)
    if not named {
        return ""
    }
    var suffix = "[< {named.name}]"
    var paths = scope.visible_narrowed_paths()
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        if path.ends_with(suffix) {
            var kept = path.length() - suffix.length()
            return path.slice(0, kept)
        }
        index = index + 1
    }
    return ""
}

func note_not_negative(
    declaration: Syntax.Statements.VariableDeclaration,
    function_information: Analysis.FunctionInfo,
) {
    assert declaration.value
    assert is_counter_start(declaration.value)
    assert never_negative(declaration.name, function_information.body)
    never_negative_names["{current_function_c_name}/{declaration.name}"] = true
}

func note_count_alias(declaration: Syntax.Statements.VariableDeclaration, scope: Scope) {
    assert declaration.value
    var counted = counted_list_text(declaration.value)
    assert not counted.is_empty()
    var printer = Syntax.SourcePrinter()
    var written = "var {declaration.name} = {printer.source_expression(declaration.value)}"
    scope.narrow_bound_path("{counted}[< {declaration.name}]", written)
}

func counted_list_text(expression: Syntax.Expressions.Expression): String {
    var shortened = shape.as_binary(expression)
    if shortened {
        if shortened.operator == 'subtract' and shortened.left and shortened.right {
            if shape.as_integer_literal(shortened.right) {
                return counted_list_text(shortened.left)
            }
        }
        return ""
    }
    var call = shape.as_call(expression)
    if call {
        if call.callee and call.arguments.is_empty() {
            var member = shape.as_member(call.callee)
            if member {
                if member.name == "count" and member.object {
                    return operand_text(member.object)
                }
            }
        }
    }
    return ""
}

func generate_while_statement(
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    report_spinning_loop(while_statement)
    report_unstepped_poll(while_statement, scope, class_information)
    var coarse = coarse_singleton(while_statement, scope, class_information)
    if coarse.is_empty() {
        generate_while_loop(while_statement, scope, class_information, function_information)
        return
    }
    var site = coarse_site_owners.count()
    coarse_site_owners.append(coarse)
    var called = coarse_called.join(" ")
    coarse_site_calls.append(called)
    var keys = coarse_keys.join(" ")
    coarse_site_keys.append(keys)
    builder.add_user("spite_coarse_{site}_enter();")
    var start = builder.user_count()
    coarse_site_starts.append(start)
    generate_while_loop(while_statement, scope, class_information, function_information)
    var end = builder.user_count()
    coarse_site_ends.append(end)
    builder.add_user("spite_coarse_{site}_leave();")
}

# ../../../docs/control_flow.md#while-is-the-only-loop
func report_spinning_loop(while_statement: Syntax.Statements.WhileStatement) {
    crash while_statement.condition
    assert shape.is_true_literal(while_statement.condition) and not can_leave(while_statement.body)
    var calls = List<Syntax.Expressions.Expression>()
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(while_statement.body, expressions)
    collect_each_expression_call(expressions, calls)
    assert calls.is_empty()
    report(
        "this 'while true' never ends: nothing inside it returns, asserts or crashes, and it calls nothing, so the program would spin here for good: leave it with a 'return' ('if done \{ return }'), or loop 'while' a condition",
    )
}

func report_unstepped_poll(
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash while_statement.condition
    var polled = polled_handle(while_statement.condition, scope, class_information)
    assert polled
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(while_statement.body, expressions)
    expressions.append(while_statement.condition)
    var calls = List<Syntax.Expressions.Expression>()
    collect_each_expression_call(expressions, calls)
    assert calls.is_empty()
    report(
        "this loop reads '{polled}.finished' and calls nothing, so nothing steps '{polled}' between two reads and it never finishes: read its value instead ('var done: T = {polled}' waits for it), or call something that waits in the loop",
    )
}

func polled_handle(
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String? {
    var unary = shape.as_unary(condition)
    if unary {
        crash unary.operand
        return polled_handle(unary.operand, scope, class_information)
    }
    var binary = shape.as_binary(condition)
    if binary {
        crash binary.left
        crash binary.right
        var left = polled_handle(binary.left, scope, class_information)
        if left {
            return left
        }
        return polled_handle(binary.right, scope, class_information)
    }
    var member = shape.as_member(condition)
    assert member
    assert member.name == "finished"
    crash member.object
    var named = shape.as_identifier(member.object)
    assert named
    var static_type = lookup_static_type(member.object, scope, class_information)
    assert static_type
    assert is_concurrent_handle(static_type)
    return named.name
}

func coarse_singleton(
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if hot_reload or remote_loop_port != 0 or read_evaluate_print_loop or resumable_mode {
        return ""
    }
    if is_hot_class(class_information) or can_leave(while_statement.body) {
        return ""
    }
    coarse_holder = ""
    coarse_owner = ""
    coarse_called = List<String>()
    coarse_keys = List<String>()
    coarse_locals = List<String>()
    if not coarse_counts(while_statement, scope, class_information) {
        return ""
    }
    crash while_statement.condition
    if not coarse_expression(while_statement.condition, true, scope, class_information) {
        return ""
    }
    if not coarse_block(while_statement.body, scope, class_information) {
        return ""
    }
    if coarse_called.is_empty() {
        return ""
    }
    return coarse_owner
}

func coarse_block(
    statements: List<Syntax.Statements.Statement>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < statements.count() {
        if not coarse_statement(statements[index], scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func coarse_statement(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            if not coarse_expression(statement.value, true, scope, class_information) {
                return false
            }
            coarse_locals.append(statement.name)
            return true
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            if not coarse_target(statement.target, scope, class_information) {
                return false
            }
            return coarse_expression(statement.value, true, scope, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            if not coarse_expression(statement.condition, true, scope, class_information) {
                return false
            }
            if not coarse_block(statement.then_branch, scope, class_information) {
                return false
            }
            return coarse_block(statement.else_branch, scope, class_information)
        }
        Syntax.Statements.WhileStatement: {
            if not coarse_counts(statement, scope, class_information) {
                return false
            }
            crash statement.condition
            if not coarse_expression(statement.condition, true, scope, class_information) {
                return false
            }
            return coarse_block(statement.body, scope, class_information)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return coarse_expression(statement.value, false, scope, class_information)
        }
        _: return false
    }
}

func coarse_counts(
    loop: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash loop.condition
    var binary = shape.as_binary(loop.condition)
    if not binary {
        return false
    }
    crash binary.left
    crash binary.right
    if binary.operator != 'less' {
        return false
    }
    var counter = shape.as_identifier(binary.left)
    if not counter {
        return false
    }
    if not scope.written_type(counter.name) and not coarse_locals.contains(counter.name) {
        return false
    }
    if not steps_counter_last(counter.name, loop.body) or assigns_before_last(counter.name, loop.body) {
        return false
    }
    if shape.as_integer_literal(binary.right) {
        return true
    }
    var bound = shape.as_identifier(binary.right)
    if bound {
        return not block_assigns(bound.name, loop.body)
    }
    var listed = counted_receiver(binary.right)
    if listed.is_empty() {
        return false
    }
    return plain_list_named(listed, scope, class_information)
}

func coarse_target(
    target: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var identifier = shape.as_identifier(target)
    if identifier {
        return coarse_name(identifier.name, true, scope, class_information)
    }
    return coarse_expression(target, true, scope, class_information)
}

func coarse_expression(
    expression: Syntax.Expressions.Expression,
    plain: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch expression {
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        Syntax.Expressions.StringLiteralExpression: return expression.value.index_of("\{") < 0
        Syntax.Expressions.IdentifierExpression: return coarse_name(expression.name, plain, scope, class_information)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if not coarse_expression(expression.left, true, scope, class_information) {
                return false
            }
            return coarse_expression(expression.right, true, scope, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return coarse_expression(expression.operand, true, scope, class_information)
        }
        Syntax.Expressions.IndexExpression: return coarse_index(expression, scope, class_information)
        Syntax.Expressions.MemberExpression: return coarse_attribute(expression, class_information)
        Syntax.Expressions.CallExpression: return coarse_call(expression, scope, class_information)
        _: return false
    }
}

func coarse_name(name: String, plain: Boolean, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    if coarse_locals.contains(name) {
        return true
    }
    var held = coarse_type_of(name, scope, class_information)
    if not held {
        return false
    }
    if plain_value_type(held) {
        return true
    }
    if plain {
        return false
    }
    var behind = class_behind(held)
    if not behind {
        return false
    }
    var handle = behind.qualified_dotted == "Parallel" or behind.qualified_dotted == "Concurrent"
    if handle {
        return false
    }
    return not behind.find_function("to_string")
}

func coarse_type_of(name: String, scope: Scope, class_information: Analysis.ClassInfo): Analysis.SpiteType? {
    var written = scope.written_type(name)
    if written {
        return written
    }
    var field = class_information.find_field(name)
    assert field
    return field.type
}

func plain_value_type(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_scalar(spite_type) or type_shape.as_string(spite_type) {
        return true
    }
    if type_shape.as_enum(spite_type) {
        return true
    }
    return false
}

func coarse_index(
    indexed: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash indexed.object
    crash indexed.index
    var listed = shape.as_identifier(indexed.object)
    if not listed {
        return false
    }
    if not plain_list_named(listed.name, scope, class_information) {
        return false
    }
    return coarse_expression(indexed.index, true, scope, class_information)
}

func plain_list_named(name: String, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    if coarse_locals.contains(name) {
        return false
    }
    var held = coarse_type_of(name, scope, class_information)
    if not held {
        return false
    }
    var listed = type_shape.as_list(held)
    if not listed {
        return false
    }
    var element = listed.element
    return plain_value_type(element)
}

func coarse_attribute(member: Syntax.Expressions.MemberExpression, class_information: Analysis.ClassInfo): Boolean {
    crash member.object
    var holder = shape.as_identifier(member.object)
    if not holder {
        return false
    }
    var owner = coarse_holder_class(holder.name, class_information)
    if not owner {
        return false
    }
    var field = owner.find_field(member.name)
    if not field {
        return false
    }
    var field_type = field.type
    return plain_value_type(field_type)
}

func coarse_holder_class(name: String, class_information: Analysis.ClassInfo): Analysis.ClassInfo? {
    assert not coarse_locals.contains(name)
    var field = class_information.find_field(name)
    assert field
    var field_type = field.type
    var held = class_behind(field_type)
    assert held
    assert held.is_singleton and not held.is_stateless_singleton and not is_library_class(held)
    assert not is_hot_class(held) and held.c_name != class_information.c_name
    assert coarse_holder.is_empty() or coarse_holder == name
    coarse_holder = name
    coarse_owner = held.c_name
    return held
}

func coarse_call(
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    crash member.object
    var receiver = shape.as_identifier(member.object)
    if not receiver {
        return false
    }
    var list_calls = ["count", "get_at", "is_empty", "set_at", "append", "contains", "index_of"]
    if list_calls.contains(member.name) and plain_list_named(receiver.name, scope, class_information) {
        return coarse_arguments(call.arguments, true, scope, class_information)
    }
    var owner = coarse_holder_class(receiver.name, class_information)
    if not owner {
        return false
    }
    var function = owner.find_function(member.name)
    if not function {
        return false
    }
    if function.is_constructor or function.parameters.count() != call.arguments.count() {
        return false
    }
    var returned = function.return_type
    if not type_shape.is_void(returned) and not plain_value_type(returned) {
        return false
    }
    if not coarse_arguments(call.arguments, false, scope, class_information) {
        return false
    }
    coarse_called.append(function.c_name)
    coarse_keys.append("{owner.qualified_dotted}#{function.name}")
    return true
}

func coarse_arguments(
    arguments: List<Syntax.Expressions.Expression>,
    plain: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < arguments.count() {
        if not coarse_expression(arguments[index], plain, scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func finish_coarse_loops() {
    settle_wait_facts()
    var index = 0
    while index < coarse_site_owners.count() {
        var owner = coarse_site_owners[index]
        crash coarse_site_calls[index]
        crash coarse_site_keys[index]
        var called_text = coarse_site_calls[index]
        var called = called_text.split(" ")
        var keys_text = coarse_site_keys[index]
        var keys = keys_text.split(" ")
        var holds = coarse_holds(owner, called, keys)
        var reading = read_guarded_names.contains(owner) and all_reading(called)
        if holds and reading {
            builder.add_typedef(
                "#define spite_coarse_{index}_enter() int64_t* spite_coarse_reading_{index} = spite_read_enter(&{owner}___guard, {owner}___readers)",
            )
            builder.add_typedef("#define spite_coarse_{index}_leave() spite_read_leave(spite_coarse_reading_{index})")
            call_unguarded_between(index, called)
        } else if holds and read_guarded_names.contains(owner) {
            builder.add_typedef(
                "#define spite_coarse_{index}_enter() spite_guard_enter_writing(&{owner}___guard, {owner}___readers)",
            )
            builder.add_typedef("#define spite_coarse_{index}_leave() spite_guard_leave(&{owner}___guard)")
            call_unguarded_between(index, called)
        } else if holds {
            builder.add_typedef("#define spite_coarse_{index}_enter() spite_guard_enter(&{owner}___guard)")
            builder.add_typedef("#define spite_coarse_{index}_leave() spite_guard_leave(&{owner}___guard)")
            call_unguarded_between(index, called)
        } else {
            builder.add_typedef("#define spite_coarse_{index}_enter() ((void)0)")
            builder.add_typedef("#define spite_coarse_{index}_leave() ((void)0)")
        }
        index = index + 1
    }
}

func all_reading(called: List<String>): Boolean {
    var index = 0
    while index < called.count() {
        if not reading_function_names.has(called[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func coarse_holds(owner: String, called: List<String>, keys: List<String>): Boolean {
    if not parallel_used or not emitted_guards.contains(owner) {
        return false
    }
    var locked = false
    var index = 0
    while index < called.count() {
        var name = called[index]
        if wait_facts.may_wait(name) {
            return false
        }
        if wrapped_function_names.has(name) {
            locked = true
        }
        index = index + 1
    }
    if not locked {
        return false
    }
    var reached = call_effects.reached_classes(keys)
    var blocking = ["Parallel", "Concurrent", "ThreadPool", "Scheduler", "Lock", "Program", "Console", "File", "Socket"]
    index = 0
    while index < blocking.count() {
        if reached.has(blocking[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func call_unguarded_between(site: Integer, called: List<String>) {
    crash coarse_site_starts[site]
    crash coarse_site_ends[site]
    var line_index = coarse_site_starts[site]
    var end = coarse_site_ends[site]
    var unguarded = with_wrapped_copies(called)
    while line_index < end {
        var line = builder.user_at(line_index)
        var changed = line
        var index = 0
        while index < unguarded.count() {
            var name = unguarded[index]
            if wrapped_function_names.has(name) {
                changed = replace_call(changed, "{name}(", "{name}___unguarded(")
            }
            index = index + 1
        }
        if changed != line {
            builder.replace_user(line_index, changed)
        }
        line_index = line_index + 1
    }
}

func with_wrapped_copies(called: List<String>): List<String> {
    var names = called.copy()
    var wrapped = wrapped_function_names.keys()
    var index = 0
    while index < wrapped.count() {
        var wrapped_name = wrapped[index]
        var called_index = 0
        while called_index < called.count() {
            var name = called[called_index]
            var held_copy = wrapped_name.starts_with("{name}___held_")
            var lent_copy = wrapped_name.starts_with("{name}___lent_")
            if (held_copy or lent_copy) and not names.contains(wrapped_name) {
                names.append(wrapped_name)
            }
            called_index = called_index + 1
        }
        index = index + 1
    }
    return names
}

func generate_while_loop(
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert while_statement.condition
    enter_loop_ranges(while_statement, scope, class_information)
    var guard = try_nullable_guard(while_statement.condition, scope, class_information)
    if guard {
        builder.add_user("while ({guard.guard_code}) \{")
        var narrowed_body = Scope(scope)
        narrowed_body.is_loop = true
        start_loop_body(narrowed_body)
        var guarded_text = condition_source(while_statement)
        narrowed_body.know_loop_condition(guarded_text)
        narrow_by_guard(narrowed_body, guard, "'while {guard.name}'")
        generate_block_in_scope(while_statement.body, narrowed_body, class_information, function_information)
        add_loop_check_point(class_information)
        builder.add_user("}")
        return
    }
    var counted = counted_loop_list(while_statement, scope, class_information, function_information)
    var condition_start = builder.user_count()
    var condition_result = generate_joined(while_statement.condition, scope, class_information)
    check_condition(while_statement.condition, condition_result, "while", scope)
    var truth = owned_truth(condition_result, while_statement.condition)
    if not counted.is_empty() {
        generate_counted_loop(counted, while_statement, scope, class_information, function_information)
        return
    }
    if resumable_mode and builder.user_count() > condition_start {
        builder.insert_user(condition_start, "while (1) \{")
        shift_wait_marks(condition_start)
        builder.add_user("if (!({truth})) break;")
    } else {
        builder.add_user("while ({truth}) \{")
    }
    var body_scope = Scope(scope)
    body_scope.is_loop = true
    start_loop_body(body_scope)
    var condition_text = condition_source(while_statement)
    body_scope.know_loop_condition(condition_text)
    narrow_proven_indices(while_statement.condition, body_scope, class_information)
    narrow_loop_counter(while_statement.condition, body_scope, function_information)
    generate_block_in_scope(while_statement.body, body_scope, class_information, function_information)
    add_loop_check_point(class_information)
    builder.add_user("}")
}

func condition_source(while_statement: Syntax.Statements.WhileStatement): String {
    crash while_statement.condition
    return Syntax.SourcePrinter().source_expression(while_statement.condition)
}

func counted_loop_list(
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): String {
    if hot_reload or remote_loop_port != 0 or read_evaluate_print_loop or resumable_mode {
        return ""
    }
    crash while_statement.condition
    var binary = shape.as_binary(while_statement.condition)
    if not binary {
        return ""
    }
    crash binary.left
    crash binary.right
    if binary.operator != 'less' {
        return ""
    }
    var counter = counted_counter(binary.left)
    if not counter {
        return ""
    }
    var listed = counted_receiver(binary.right)
    if listed.is_empty() or listed == counter.name {
        return ""
    }
    if not holds_counted_values(listed, scope) {
        return ""
    }
    if not is_local_counter(counter.name, scope, function_information) {
        return ""
    }
    if not counter_counts_up(counter.name, function_information.body) {
        return ""
    }
    if not counted_body_keeps_count(listed, counter.name, while_statement.body, scope, class_information) {
        return ""
    }
    if last_counter_step(counter.name, while_statement.body) > counted_reach(binary.left) + 1 {
        return ""
    }
    return listed
}

func counted_counter(left: Syntax.Expressions.Expression): Syntax.Expressions.IdentifierExpression? {
    var named = shape.as_identifier(left)
    if named {
        return named
    }
    var strided = shape.as_binary(left)
    assert strided
    crash strided.left
    crash strided.right
    assert strided.operator == 'add'
    var reach = shape.as_integer_literal(strided.right)
    assert reach
    assert reach.value >= 1 and reach.value <= 63
    return shape.as_identifier(strided.left)
}

func counted_reach(left: Syntax.Expressions.Expression): Integer {
    var strided = shape.as_binary(left)
    if not strided {
        return 0
    }
    crash strided.right
    var reach = shape.as_integer_literal(strided.right)
    crash reach
    return reach.value
}

func counted_receiver(expression: Syntax.Expressions.Expression): String {
    var call = shape.as_call(expression)
    if not call {
        return ""
    }
    if not call.arguments.is_empty() {
        return ""
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return ""
    }
    if member.name != "count" {
        return ""
    }
    crash member.object
    var listed = shape.as_identifier(member.object)
    if not listed {
        return ""
    }
    return listed.name
}

func counted_element_type(list_type: Analysis.SpiteType): Analysis.SpiteType? {
    var listed = type_shape.as_list(list_type)
    assert listed
    var element = listed.element
    assert type_shape.as_scalar(element)
    return element
}

func holds_counted_values(name: String, scope: Scope): Boolean {
    var list_type = scope.written_type(name)
    if not list_type {
        return false
    }
    var element = counted_element_type(list_type)
    if not element {
        return false
    }
    return true
}

func is_local_counter(name: String, scope: Scope, function_information: Analysis.FunctionInfo): Boolean {
    var counter_type = scope.written_type(name)
    if not counter_type {
        return false
    }
    var scalar = type_shape.as_scalar(counter_type)
    if not scalar {
        return false
    }
    if scalar.kind != 'integer_kind' {
        return false
    }
    var parameter_names = c_parameter_names(function_information.parameters)
    var counter_code = c_value_name(name)
    return not parameter_names.contains(counter_code)
}

func counter_counts_up(counter: String, statements: List<Syntax.Statements.Statement>): Boolean {
    var index = 0
    while index < statements.count() {
        if not statement_counts_up(counter, statements[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func statement_counts_up(counter: String, statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            return statement.name != counter or is_counter_start(statement.value)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            return not is_identifier_named(statement.target, counter) or is_counter_start(statement.value)
        }
        Syntax.Statements.IfStatement: return counter_counts_up(counter, statement.then_branch) and counter_counts_up(counter, statement.else_branch)
        Syntax.Statements.WhileStatement: return loop_counts_up(counter, statement)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                if not counter_counts_up(counter, statement.cases[case_index].body) {
                    return false
                }
                case_index = case_index + 1
            }
            return true
        }
        _: return true
    }
}

func is_counter_start(value: Syntax.Expressions.Expression): Boolean {
    var start = shape.as_integer_literal(value)
    if not start {
        return false
    }
    return start.value >= 0
}

func loop_counts_up(counter: String, loop: Syntax.Statements.WhileStatement): Boolean {
    if steps_counter_last(counter, loop.body) and bounds_counter(counter, loop) {
        return not assigns_before_last(counter, loop.body)
    }
    return counter_counts_up(counter, loop.body)
}

func steps_counter_last(counter: String, body: List<Syntax.Statements.Statement>): Boolean {
    return last_counter_step(counter, body) > 0
}

func last_counter_step(counter: String, body: List<Syntax.Statements.Statement>): Integer {
    var last = body.last()
    if not last {
        return 0
    }
    var step = shape.as_assignment_statement(last)
    if not step {
        return 0
    }
    crash step.target
    crash step.value
    if not is_identifier_named(step.target, counter) {
        return 0
    }
    var sum = shape.as_binary(step.value)
    if not sum {
        return 0
    }
    crash sum.left
    crash sum.right
    if sum.operator != 'add' or not is_identifier_named(sum.left, counter) {
        return 0
    }
    var one = shape.as_integer_literal(sum.right)
    if not one {
        return 0
    }
    if one.value < 1 or one.value > 64 {
        return 0
    }
    return one.value
}

func bounds_counter(counter: String, loop: Syntax.Statements.WhileStatement): Boolean {
    crash loop.condition
    var binary = shape.as_binary(loop.condition)
    if not binary {
        return false
    }
    crash binary.left
    crash binary.right
    if binary.operator != 'less' {
        return false
    }
    if shape.as_integer_literal(binary.right) and is_identifier_named(binary.left, counter) {
        return true
    }
    var bounded = counted_counter(binary.left)
    if not bounded {
        return false
    }
    return bounded.name == counter and not counted_receiver(binary.right).is_empty()
}

func assigns_before_last(name: String, statements: List<Syntax.Statements.Statement>): Boolean {
    var index = 0
    while index < statements.count() - 1 {
        if statement_assigns(name, statements[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func block_assigns(name: String, statements: List<Syntax.Statements.Statement>): Boolean {
    var index = 0
    while index < statements.count() {
        if statement_assigns(name, statements[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_assigns(name: String, statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: return statement.name == name
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            return is_identifier_named(statement.target, name)
        }
        Syntax.Statements.IfStatement: return block_assigns(name, statement.then_branch) or block_assigns(name, statement.else_branch)
        Syntax.Statements.WhileStatement: return block_assigns(name, statement.body)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                if block_assigns(name, statement.cases[case_index].body) {
                    return true
                }
                case_index = case_index + 1
            }
            return false
        }
        _: return false
    }
}

func counted_body_keeps_count(
    listed: String,
    counter: String,
    body: List<Syntax.Statements.Statement>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if not steps_counter_last(counter, body) {
        return false
    }
    var plain_names = List<String>()
    var index = 0
    while index < body.count() - 1 {
        if not keeps_count_statement(listed, counter, body[index], plain_names, scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func keeps_count_block(
    listed: String,
    counter: String,
    statements: List<Syntax.Statements.Statement>,
    plain_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < statements.count() {
        if not keeps_count_statement(listed, counter, statements[index], plain_names, scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func keeps_count_statement(
    listed: String,
    counter: String,
    statement: Syntax.Statements.Statement,
    plain_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            if statement.name == listed or statement.name == counter {
                return false
            }
            crash statement.value
            if not is_counted_plain(statement.value, plain_names, scope, class_information) {
                return false
            }
            if statement.type_reference {
                if not names_plain_type(statement.type_reference) {
                    return false
                }
            }
            plain_names.append(statement.name)
            return true
        }
        Syntax.Statements.AssignmentStatement: return keeps_count_assignment(listed, counter, statement, plain_names, scope, class_information)
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return is_counted_plain(statement.value, plain_names, scope, class_information)
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            return is_counted_plain(statement.value, plain_names, scope, class_information)
        }
        Syntax.Statements.ReturnStatement: {
            if not statement.value {
                return false
            }
            return is_counted_plain(statement.value, plain_names, scope, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            if not is_counted_plain(statement.condition, plain_names, scope, class_information) {
                return false
            }
            if not keeps_count_block(listed, counter, statement.then_branch, plain_names, scope, class_information) {
                return false
            }
            return keeps_count_block(listed, counter, statement.else_branch, plain_names, scope, class_information)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            if not is_counted_plain(statement.condition, plain_names, scope, class_information) {
                return false
            }
            return keeps_count_block(listed, counter, statement.body, plain_names, scope, class_information)
        }
        _: return false
    }
}

func keeps_count_assignment(
    listed: String,
    counter: String,
    assignment: Syntax.Statements.AssignmentStatement,
    plain_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash assignment.target
    crash assignment.value
    if not is_counted_plain(assignment.value, plain_names, scope, class_information) {
        return false
    }
    var assigned = shape.as_identifier(assignment.target)
    if assigned {
        if assigned.name == listed or assigned.name == counter {
            return false
        }
        if not plain_names.contains(assigned.name) and not scope.written_type(assigned.name) {
            return false
        }
        return is_plain_name(assigned.name, plain_names, scope, class_information)
    }
    var indexed = shape.as_index(assignment.target)
    if not indexed {
        return false
    }
    crash indexed.object
    crash indexed.index
    var indexed_list = shape.as_identifier(indexed.object)
    if not indexed_list {
        return false
    }
    if not holds_counted_values(indexed_list.name, scope) {
        return false
    }
    return is_counted_plain(indexed.index, plain_names, scope, class_information)
}

func names_plain_type(type_reference: Syntax.Types.Type): Boolean {
    var named = shape.as_named_type(type_reference)
    if not named {
        return false
    }
    if named.path.count() != 1 or not named.arguments.is_empty() {
        return false
    }
    var plain = [
        "Integer"
        "Long"
        "Short"
        "Tiny"
        "Byte"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Float"
        "Double"
        "Boolean"
    ]
    return plain.contains(named.path[0])
}

func is_plain_name(
    name: String,
    plain_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if plain_names.contains(name) {
        return true
    }
    var local_type = scope.written_type(name)
    if local_type {
        return is_plain_value_type(local_type)
    }
    var field = class_information.find_field(name)
    if not field {
        return false
    }
    var field_type = field.type
    return is_plain_value_type(field_type)
}

func is_plain_value_type(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_scalar(spite_type) {
        return true
    }
    var nullable = type_shape.as_nullable(spite_type)
    if not nullable {
        return false
    }
    var inner = nullable.inner
    if not type_shape.as_scalar(inner) {
        return false
    }
    return true
}

func is_counted_plain(
    expression: Syntax.Expressions.Expression,
    plain_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch expression {
        Syntax.Expressions.IdentifierExpression: return is_plain_name(expression.name, plain_names, scope, class_information)
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if not is_counted_plain(expression.left, plain_names, scope, class_information) {
                return false
            }
            return is_counted_plain(expression.right, plain_names, scope, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return is_counted_plain(expression.operand, plain_names, scope, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            var indexed_list = shape.as_identifier(expression.object)
            if not indexed_list {
                return false
            }
            if not holds_counted_values(indexed_list.name, scope) {
                return false
            }
            return is_counted_plain(expression.index, plain_names, scope, class_information)
        }
        Syntax.Expressions.CallExpression: return is_counted_call(expression, plain_names, scope, class_information)
        _: return false
    }
}

func is_counted_call(
    call: Syntax.Expressions.CallExpression,
    plain_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    crash member.object
    var index = 0
    while index < call.arguments.count() {
        if not is_counted_plain(call.arguments[index], plain_names, scope, class_information) {
            return false
        }
        index = index + 1
    }
    var receiver = shape.as_identifier(member.object)
    if receiver and holds_counted_values(receiver.name, scope) {
        var reads = ["count", "is_empty", "get_at", "set_at", "first", "last", "contains", "index_of"]
        if is_byte_access(member.name) and not member.name.starts_with("append_") {
            return true
        }
        return reads.contains(member.name)
    }
    return maths.is_member(member.name) and is_counted_plain(member.object, plain_names, scope, class_information)
}

func generate_counted_loop(
    listed: String,
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    crash while_statement.condition
    var binary = shape.as_binary(while_statement.condition)
    crash binary
    crash binary.left
    crash binary.right
    var counter = counted_counter(binary.left)
    crash counter
    var reach = counted_reach(binary.left)
    var call = shape.as_call(binary.right)
    crash call
    crash call.callee
    var member = shape.as_member(call.callee)
    crash member
    crash member.object
    var counter_ast: Syntax.Expressions.Expression = counter
    var counter_result = generate_expression(counter_ast, scope, class_information)
    var count_result = generate_expression(binary.right, scope, class_information)
    var bound = next_temporary()
    builder.add_user("int32_t {bound} = {count_result.code};")
    var key = "{listed}[{counter.name}]"
    var items = hoist_items(member.object, scope, class_information)
    var truth = "{counter_result.code} < {bound}"
    if reach > 0 {
        truth = "{counter_result.code} < {bound} - {reach}"
    }
    var others = List<Syntax.Expressions.Expression>()
    var other_names = List<String>()
    collect_counted_others(listed, counter.name, while_statement.body, scope, others, other_names)
    if others.is_empty() or asserts_in(while_statement.body) {
        var body_scope = Scope(scope)
        body_scope.is_loop = true
        start_loop_body(body_scope)
        count_reached_items(body_scope, key, listed, counter.name, reach, items)
        generate_counted_body(truth, while_statement, body_scope, class_information, function_information)
        return
    }
    var fast_scope = Scope(scope)
    fast_scope.is_loop = true
    start_loop_body(fast_scope)
    count_reached_items(fast_scope, key, listed, counter.name, reach, items)
    var fits = List<String>()
    var index = 0
    while index < others.count() {
        var other = others[index]
        var other_result = generate_expression(other, scope, class_information)
        var other_count = next_temporary()
        builder.add_user("int32_t {other_count} = ({other_result.code})->item_count_;")
        var other_items = hoist_items(other, scope, class_information)
        fits.append("{bound} <= {other_count}")
        crash other_names[index]
        fast_scope.count_items("{other_names[index]}[{counter.name}]", other_items)
        index = index + 1
    }
    builder.add_user("if ({fits.join(" && ")}) \{")
    generate_counted_body(truth, while_statement, fast_scope, class_information, function_information)
    builder.add_user("} else \{")
    var slow_scope = Scope(scope)
    slow_scope.is_loop = true
    start_loop_body(slow_scope)
    count_reached_items(slow_scope, key, listed, counter.name, reach, items)
    generate_counted_body(truth, while_statement, slow_scope, class_information, function_information)
    builder.add_user("}")
}

func count_reached_items(scope: Scope, key: String, listed: String, counter: String, reach: Integer, items: String) {
    scope.count_items(key, items)
    var step = 1
    while step <= reach {
        scope.count_items("{listed}[{counter} + {step}]", items)
        step = step + 1
    }
    if reach > 0 {
        scope.narrow_path("~+[{counter}]")
    }
}

func hoist_items(list_ast: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo): String {
    var list_result = generate_expression(list_ast, scope, class_information)
    var element = counted_item_type(list_ast, scope)
    var items = next_temporary()
    var element_code = c_type_name(element)
    builder.add_user("{element_code}* {items} = ({element_code}*)(intptr_t)({list_result.code})->items_;")
    return items
}

func generate_counted_body(
    truth: String,
    while_statement: Syntax.Statements.WhileStatement,
    body_scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    crash while_statement.condition
    builder.add_user("while ({truth}) \{")
    if not compares_decimals_in(while_statement.body, body_scope) {
        builder.add_user("#if defined(__clang__)")
        builder.add_user("#pragma clang fp contract(fast) reassociate(on)")
        builder.add_user("#endif")
    }
    narrow_proven_indices(while_statement.condition, body_scope, class_information)
    generate_block_in_scope(while_statement.body, body_scope, class_information, function_information)
    add_loop_check_point(class_information)
    builder.add_user("}")
}

func compares_decimals_in(statements: List<Syntax.Statements.Statement>, scope: Scope): Boolean {
    var index = 0
    while index < statements.count() {
        if statement_compares_decimals(statements[index], scope) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_compares_decimals(statement: Syntax.Statements.Statement, scope: Scope): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: return optional_compares_decimals(statement.value, scope)
        Syntax.Statements.AssignmentStatement: {
            if optional_compares_decimals(statement.target, scope) {
                return true
            }
            return optional_compares_decimals(statement.value, scope)
        }
        Syntax.Statements.ExpressionStatement: return optional_compares_decimals(statement.value, scope)
        Syntax.Statements.AssertStatement: return optional_compares_decimals(statement.value, scope)
        Syntax.Statements.ReturnStatement: return optional_compares_decimals(statement.value, scope)
        Syntax.Statements.IfStatement: {
            if optional_compares_decimals(statement.condition, scope) {
                return true
            }
            if compares_decimals_in(statement.then_branch, scope) {
                return true
            }
            return compares_decimals_in(statement.else_branch, scope)
        }
        Syntax.Statements.WhileStatement: {
            if optional_compares_decimals(statement.condition, scope) {
                return true
            }
            return compares_decimals_in(statement.body, scope)
        }
        _: return true
    }
}

func optional_compares_decimals(expression: Syntax.Expressions.Expression?, scope: Scope): Boolean {
    if not expression {
        return false
    }
    return compares_decimals(expression, scope)
}

func compares_decimals(expression: Syntax.Expressions.Expression, scope: Scope): Boolean {
    switch expression {
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if expression.operator == 'equal' or expression.operator == 'not_equal' {
                if may_be_decimal(expression.left, scope) or may_be_decimal(expression.right, scope) {
                    return true
                }
            }
            if compares_decimals(expression.left, scope) {
                return true
            }
            return compares_decimals(expression.right, scope)
        }
        Syntax.Expressions.UnaryExpression: return optional_compares_decimals(expression.operand, scope)
        Syntax.Expressions.IndexExpression: return optional_compares_decimals(expression.index, scope)
        Syntax.Expressions.CallExpression: return arguments_compare_decimals(expression.arguments, scope)
        _: return false
    }
}

func arguments_compare_decimals(arguments: List<Syntax.Expressions.Expression>, scope: Scope): Boolean {
    var index = 0
    while index < arguments.count() {
        if compares_decimals(arguments[index], scope) {
            return true
        }
        index = index + 1
    }
    return false
}

func may_be_decimal(expression: Syntax.Expressions.Expression, scope: Scope): Boolean {
    switch expression {
        Syntax.Expressions.IntegerLiteral: return false
        Syntax.Expressions.TrueLiteral: return false
        Syntax.Expressions.FalseLiteral: return false
        Syntax.Expressions.IdentifierExpression: {
            var written = scope.written_type(expression.name)
            if not written {
                return true
            }
            return is_decimal_type(written)
        }
        Syntax.Expressions.IndexExpression: return indexes_decimals(expression, scope)
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return may_be_decimal(expression.operand, scope)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if is_boolean_result_operator(expression.operator) {
                return false
            }
            if may_be_decimal(expression.left, scope) {
                return true
            }
            return may_be_decimal(expression.right, scope)
        }
        _: return true
    }
}

func indexes_decimals(indexed: Syntax.Expressions.IndexExpression, scope: Scope): Boolean {
    crash indexed.object
    var listed = shape.as_identifier(indexed.object)
    if not listed {
        return true
    }
    var list_type = scope.written_type(listed.name)
    if not list_type {
        return true
    }
    var element = counted_element_type(list_type)
    if not element {
        return true
    }
    return is_decimal_type(element)
}

func is_decimal_type(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    if not scalar {
        return true
    }
    return is_float_kind(scalar.kind)
}

func asserts_in(statements: List<Syntax.Statements.Statement>): Boolean {
    return statements.any(statement_asserts)
}

func statement_asserts(statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.AssertStatement: return true
        Syntax.Statements.IfStatement: return asserts_in(statement.then_branch) or asserts_in(statement.else_branch)
        Syntax.Statements.WhileStatement: return asserts_in(statement.body)
        _: return false
    }
}

func collect_counted_others(
    listed: String,
    counter: String,
    statements: List<Syntax.Statements.Statement>,
    scope: Scope,
    others: List<Syntax.Expressions.Expression>,
    other_names: List<String>,
) {
    var index = 0
    while index < statements.count() {
        collect_counted_statement(listed, counter, statements[index], scope, others, other_names)
        index = index + 1
    }
}

func collect_counted_statement(
    listed: String,
    counter: String,
    statement: Syntax.Statements.Statement,
    scope: Scope,
    others: List<Syntax.Expressions.Expression>,
    other_names: List<String>,
) {
    switch statement {
        Syntax.Statements.VariableDeclaration: collect_counted_optional(listed, counter, statement.value, scope, others, other_names)
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            var written = shape.as_index(statement.target)
            if written {
                crash written.object
                crash written.index
                add_counted_other(listed, counter, written.object, written.index, scope, others, other_names)
                collect_counted_optional(listed, counter, written.index, scope, others, other_names)
            }
            collect_counted_optional(listed, counter, statement.value, scope, others, other_names)
        }
        Syntax.Statements.ExpressionStatement: collect_counted_optional(listed, counter, statement.value, scope, others, other_names)
        Syntax.Statements.ReturnStatement: collect_counted_optional(listed, counter, statement.value, scope, others, other_names)
        Syntax.Statements.IfStatement: {
            collect_counted_optional(listed, counter, statement.condition, scope, others, other_names)
            collect_counted_others(listed, counter, statement.then_branch, scope, others, other_names)
            collect_counted_others(listed, counter, statement.else_branch, scope, others, other_names)
        }
        Syntax.Statements.WhileStatement: {
            collect_counted_optional(listed, counter, statement.condition, scope, others, other_names)
            collect_counted_others(listed, counter, statement.body, scope, others, other_names)
        }
        _: return
    }
}

func collect_counted_optional(
    listed: String,
    counter: String,
    expression: Syntax.Expressions.Expression?,
    scope: Scope,
    others: List<Syntax.Expressions.Expression>,
    other_names: List<String>,
) {
    assert expression
    switch expression {
        Syntax.Expressions.BinaryExpression: {
            collect_counted_optional(listed, counter, expression.left, scope, others, other_names)
            collect_counted_optional(listed, counter, expression.right, scope, others, other_names)
        }
        Syntax.Expressions.UnaryExpression: collect_counted_optional(listed, counter, expression.operand, scope, others, other_names)
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            if indexes_counted_values(expression.object, scope) {
                add_counted_other(listed, counter, expression.object, expression.index, scope, others, other_names)
            }
            collect_counted_optional(listed, counter, expression.index, scope, others, other_names)
        }
        Syntax.Expressions.CallExpression: collect_counted_call(listed, counter, expression, scope, others, other_names)
        _: return
    }
}

func collect_counted_call(
    listed: String,
    counter: String,
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    others: List<Syntax.Expressions.Expression>,
    other_names: List<String>,
) {
    var index = 0
    while index < call.arguments.count() {
        collect_counted_optional(listed, counter, call.arguments[index], scope, others, other_names)
        index = index + 1
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    collect_counted_optional(listed, counter, member.object, scope, others, other_names)
    var first_argument = call.arguments.first()
    assert first_argument
    assert member.name == "get_at" or member.name == "set_at"
    add_counted_other(listed, counter, member.object, first_argument, scope, others, other_names)
}

func indexes_counted_values(expression: Syntax.Expressions.Expression, scope: Scope): Boolean {
    var named = shape.as_identifier(expression)
    if not named {
        return false
    }
    return holds_counted_values(named.name, scope)
}

func add_counted_other(
    listed: String,
    counter: String,
    object_ast: Syntax.Expressions.Expression,
    index_ast: Syntax.Expressions.Expression,
    scope: Scope,
    others: List<Syntax.Expressions.Expression>,
    other_names: List<String>,
) {
    var named = shape.as_identifier(object_ast)
    assert named
    assert named.name != listed and not other_names.contains(named.name)
    assert is_identifier_named(index_ast, counter)
    assert holds_counted_values(named.name, scope)
    others.append(object_ast)
    other_names.append(named.name)
}

func counted_item(
    object_ast: Syntax.Expressions.Expression,
    index_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var listed = shape.as_identifier(object_ast)
    if not listed {
        return ""
    }
    var counter = shape.as_identifier(index_ast)
    var step = 0
    if not counter {
        var stepped = shape.as_binary(index_ast)
        if not stepped {
            return ""
        }
        crash stepped.left
        crash stepped.right
        var stepped_by = shape.as_integer_literal(stepped.right)
        if stepped.operator != 'add' or not stepped_by {
            return ""
        }
        step = stepped_by.value
        counter = shape.as_identifier(stepped.left)
    }
    if not counter {
        return ""
    }
    var key = "{listed.name}[{counter.name}]"
    if step > 0 {
        key = "{listed.name}[{counter.name} + {step}]"
    }
    var items = scope.counted_items_of(key)
    if items.is_empty() {
        return ""
    }
    var counter_ast: Syntax.Expressions.Expression = counter
    var counter_result = generate_expression(counter_ast, scope, class_information)
    if step > 0 {
        return "{items}[{counter_result.code} + {step}]"
    }
    return "{items}[{counter_result.code}]"
}

func reads_counted_item(index_expression: Syntax.Expressions.IndexExpression, scope: Scope): Boolean {
    var read_path = operand_text(index_expression)
    return scope.is_path_narrowed(read_path)
}

func counted_item_type(object_ast: Syntax.Expressions.Expression, scope: Scope): Analysis.SpiteType {
    var listed = shape.as_identifier(object_ast)
    crash listed
    var list_type = scope.written_type(listed.name)
    crash list_type
    var element = counted_element_type(list_type)
    crash element
    return element
}

func counted_method(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert member.name == "set_at"
    var first_argument = arguments_ast.first()
    assert first_argument
    var item = counted_item(object_ast, first_argument, scope, class_information)
    assert not item.is_empty()
    var element = counted_item_type(object_ast, scope)
    assert arguments_ast.count() == 2
    var stored = coerce_for_store(arguments_ast[1], element, scope, class_information)
    var nothing = void_type()
    return ExpressionResult("{item} = {stored}", nothing)
}

func add_loop_check_point(class_information: Analysis.ClassInfo) {
    assert (remote_loop_port > 0 or hot_reload) and not is_library_class(class_information)
    var scheduler_class = find_class_by_qualified("Scheduler")
    crash scheduler_class
    var check_point = find_or_instantiate_function(scheduler_class, "check_point")
    crash check_point
    var scheduler = singleton_call(scheduler_class)
    ensure_check_point_flag()
    var parking = ""
    if hot_reload {
        if not world_gate_written {
            ensure_world_gate()
        }
        parking = "spite_world_park(); "
    }
    builder.add_user(
        "if (__atomic_load_n(&spite_check_point_wanted, __ATOMIC_RELAXED) != 0) \{ {parking}Scheduler* spite_check_point = {scheduler}; {check_point.c_name}(spite_check_point); Scheduler___release(spite_check_point); }",
    )
}

func index_key_text(key: Syntax.Expressions.Expression): String {
    var named = operand_text(key)
    if not named.is_empty() {
        return named
    }
    var number = shape.as_integer_literal(key)
    if number {
        return number.value
    }
    var text = shape.as_string_literal(key)
    if text {
        return "\"{text.value}\""
    }
    if not is_structural_key(key) {
        return ""
    }
    var printer = Syntax.SourcePrinter()
    return printer.source_expression(key)
}

func is_structural_key(key: Syntax.Expressions.Expression): Boolean {
    switch key {
        Syntax.Expressions.IdentifierExpression: return true
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        Syntax.Expressions.UnaryExpression: return is_structural_part(key.operand)
        Syntax.Expressions.BinaryExpression: {
            if key.is_text_join {
                return false
            }
            return is_structural_part(key.left) and is_structural_part(key.right)
        }
        Syntax.Expressions.MemberExpression: return is_structural_part(key.object)
        Syntax.Expressions.IndexExpression: return is_structural_part(key.object) and is_structural_part(key.index)
        _: return false
    }
}

func is_structural_part(part: Syntax.Expressions.Expression?): Boolean {
    if not part {
        return false
    }
    return is_structural_key(part)
}

func operand_text(expression: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(expression)
    if identifier {
        return identifier.name
    }
    var indexed = shape.as_index(expression)
    if indexed {
        if indexed.object and indexed.index {
            var indexed_text = operand_text(indexed.object)
            var key_text = index_key_text(indexed.index)
            if not indexed_text.is_empty() and not key_text.is_empty() {
                return "{indexed_text}[{key_text}]"
            }
        }
        return ""
    }
    var member = shape.as_member(expression)
    if member {
        if member.object {
            var object_text = operand_text(member.object)
            if not object_text.is_empty() {
                return "{object_text}.{member.name}"
            }
        }
    }
    var made = shape.as_generic_call(expression)
    if made {
        if is_generic_singleton_call(made) {
            var printer = Syntax.SourcePrinter()
            return printer.source_expression(expression)
        }
    }
    return ""
}

func is_generic_singleton_call(construction: Syntax.Expressions.GenericCallExpression): Boolean {
    if not construction.arguments.is_empty() or construction.names_class {
        return false
    }
    crash construction.callee
    var template = try_resolve_static_path(construction.callee, current_owner)
    if not template {
        return false
    }
    return template.is_generic_template and template.is_singleton
}

func emit_crash_parts(scope: Scope, class_information: Analysis.ClassInfo) {
    var shown = List<String>()
    var index = 0
    while index < crash_parts.count() {
        var part = crash_parts[index]
        if not part.is_reach and not shown.contains(part.label) and is_part_shown(part, scope, class_information) {
            shown.append(part.label)
            emit_crash_part(part, scope, class_information)
        }
        index = index + 1
    }
}

func emit_scope_values(condition_text: String, scope: Scope, class_information: Analysis.ClassInfo) {
    var names = List<String>()
    scope.visible_names(names)
    var shown = 0
    var index = 0
    while index < names.count() and shown < 12 {
        var name = names[index]
        var value_type = scope.lookup_type(name)
        if value_type and not mentions_word(condition_text, name) and is_scope_value_type(value_type) {
            var code = c_value_name(name)
            var override = scope.lookup_override(name)
            if override {
                code = override
            }
            emit_scope_value(name, code, value_type, scope, class_information)
            shown = shown + 1
        }
        index = index + 1
    }
    assert not class_information.is_value_class and class_information.c_name != "SpiteString"
    var field_index = 0
    while field_index < class_information.fields.count() and shown < 12 {
        var field = class_information.fields[field_index]
        var field_name = field.name
        var field_type = field.type
        var hidden = names.contains(field_name) or mentions_word(condition_text, field_name)
        var atomic = atomic_owner == class_information.c_name and atomic_fields.contains(field_name)
        if not hidden and not atomic and field_name != "_namespace" and is_scope_value_type(field_type) {
            var place = field_place("self", class_information, field_name)
            emit_scope_value(field_name, place, field_type, scope, class_information)
            shown = shown + 1
        }
        field_index = field_index + 1
    }
}

func emit_scope_value(
    label: String,
    code: String,
    value_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash_values_bounded = true
    var named: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(label)
    emit_shown_value(label, code, value_type, named, scope, class_information)
    crash_values_bounded = false
}

func is_scope_value_type(spite_type: Analysis.SpiteType): Boolean {
    var shown_type = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        shown_type = nullable.inner
    }
    return type_shape.as_string(shown_type) or type_shape.as_scalar(shown_type) or is_enum_type(shown_type)
}

func mentions_word(text: String, word: String): Boolean {
    var text_length = text.length()
    var word_length = word.length()
    var at = 0
    while at + word_length <= text_length {
        var starts_word = true
        if at > 0 {
            var before = text.code_at(at - 1)
            starts_word = not is_word_code(before)
        }
        if starts_word and text.slice(at, at + word_length) == word {
            var ends_word = true
            if at + word_length < text_length {
                var after = text.code_at(at + word_length)
                ends_word = not is_word_code(after)
            }
            if ends_word {
                return true
            }
        }
        at = at + 1
    }
    return false
}

func is_word_code(code: Integer): Boolean {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func is_part_shown(part: CrashPart, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    if part.is_call {
        if part.captured_type {
            return true
        }
        return false
    }
    var bare = not part.label.contains(".") and not part.label.contains("[")
    if not part.reached_names.is_empty() and not bare {
        return false
    }
    var root = scope.path_root(part.label)
    var local_type = scope.lookup_type(root)
    var field = class_information.find_field(root)
    var readable = false
    if local_type or field {
        readable = true
    }
    return readable
}

func emit_crash_part(part: CrashPart, scope: Scope, class_information: Analysis.ClassInfo) {
    var conditions = part.reached_names.copy()
    if part.is_call {
        conditions.append(part.set_name)
    }
    var opened = not conditions.is_empty()
    if opened {
        builder.add_user("if ({conditions.join(" && ")}) \{")
        conditional_depth = conditional_depth + 1
    }
    var expression = part.expression
    if part.is_call {
        crash part.captured_type
        emit_shown_value(part.label, part.value_name, part.captured_type, expression, scope, class_information)
    } else {
        emit_named_part(part.label, expression, scope, class_information)
    }
    if opened {
        conditional_depth = conditional_depth - 1
        builder.add_user("}")
    }
}

func emit_named_part(
    label: String,
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var saved_counter = temporary_counter
    var probe = generate_expression(expression, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    if type_shape.as_nullable(probe_type) {
        emit_shown_value(label, probe.code, probe_type, expression, scope, class_information)
        return
    }
    assert is_shown_type(probe_type)
    emit_labelled_operand(label, expression, scope, class_information)
}

func emit_shown_value(
    label: String,
    code: String,
    value_type: Analysis.SpiteType,
    part_expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var nullable = type_shape.as_nullable(value_type)
    if not nullable {
        emit_code_operand(label, code, value_type, scope, class_information)
        return
    }
    var inner = nullable.inner
    var presence = "({code}).has_value"
    var inner_code = "({code}).value"
    if type_is_reference(inner) {
        presence = present_code(code, inner)
        inner_code = code
    }
    builder.add_user("if (!({presence})) \{")
    var escaped = escape_c_string(label)
    var indexed = shape.as_index(part_expression)
    if indexed {
        emit_missing_item(escaped, indexed, scope, class_information)
    } else {
        builder.add_user("fputs(\"\\t{escaped} is null\", stderr);")
    }
    builder.add_user("} else \{")
    if is_shown_type(inner) {
        emit_code_operand(label, inner_code, inner, scope, class_information)
    }
    builder.add_user("}")
}

func emit_code_operand(
    label: String,
    code: String,
    value_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var shown_scope = Scope(scope)
    var shown_name = "spite_crash_shown"
    shown_scope.declare(shown_name, value_type)
    shown_scope.set_override(shown_name, code)
    var shown: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(shown_name)
    emit_labelled_operand(label, shown, shown_scope, class_information)
}

func emit_labelled_operand(
    label: String,
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var saved_counter = temporary_counter
    var probe = generate_expression(expression, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var printable = type_shape.as_string(probe_type)
    if type_shape.as_scalar(probe_type) {
        printable = true
    }
    if is_enum_type(probe_type) {
        printable = true
    }
    var shown = expression
    if not printable and describes_itself(probe_type) {
        var no_arguments = List<Syntax.Expressions.Expression>()
        var described: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(expression, "to_string")
        shown = Syntax.Expressions.CallExpression(described, no_arguments)
        printable = true
    }
    assert printable
    builder.add_user("fputs(\"\\t{escape_c_string(label)}=\", stderr);")
    var operand_statement = crash_operand_statement(shown, scope, class_information)
    builder.add_user(operand_statement)
}

func describes_itself(spite_type: Analysis.SpiteType): Boolean {
    var described_ref = type_shape.as_class_ref(spite_type)
    if not described_ref {
        return false
    }
    if described_ref.has_signature {
        return false
    }
    var described_class = find_class_by_c_name(described_ref.c_name)
    if not described_class {
        return false
    }
    var described = find_or_instantiate_function(described_class, "to_string")
    if not described {
        return false
    }
    return described.parameters.is_empty()
}

func emit_missing_report(guard: NullableGuard, scope: Scope, class_information: Analysis.ClassInfo) {
    var nullable_links = List<Integer>()
    var index = 0
    while index < guard.link_tests.count() {
        if not guard.link_tests[index].is_empty() {
            nullable_links.append(index)
        }
        index = index + 1
    }
    if nullable_links.is_empty() {
        builder.add_user("fputs(\"\\t{escape_c_string(guard.name)} is null\", stderr);")
        return
    }
    var probe_scope = Scope(scope)
    var next_link = 0
    var position = 0
    while position < nullable_links.count() {
        var link_position = nullable_links[position]
        while next_link < link_position {
            crash guard.links[next_link]
            var present_link = guard.links[next_link]
            var narrowed_path = operand_text(present_link)
            probe_scope.narrow_path(narrowed_path)
            next_link = next_link + 1
        }
        crash guard.link_tests[link_position]
        crash guard.links[link_position]
        var last = position == nullable_links.count() - 1
        if position > 0 {
            builder.add_user("else")
        }
        if last {
            builder.add_user("\{")
        } else {
            builder.add_user("if (!({guard.link_tests[link_position]})) \{")
        }
        conditional_depth = conditional_depth + 1
        var missing_link = guard.links[link_position]
        emit_missing_link(missing_link, probe_scope, class_information)
        conditional_depth = conditional_depth - 1
        builder.add_user("}")
        position = position + 1
    }
}

func emit_missing_link(link: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo) {
    var link_text = operand_text(link)
    var name = escape_c_string(link_text)
    var indexed = shape.as_index(link)
    if indexed {
        emit_missing_item(name, indexed, scope, class_information)
        return
    }
    builder.add_user("fputs(\"\\t{name} is null\", stderr);")
}

func emit_missing_item(
    name: String,
    indexed: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash indexed.object
    crash indexed.index
    var saved_counter = temporary_counter
    var object_result = generate_expression(indexed.object, scope, class_information)
    var key_result = generate_expression(indexed.index, scope, class_information)
    rewind_temporaries(saved_counter)
    var object_type = object_result.type
    var key_type = key_result.type
    var printable = type_shape.as_string(key_type) or is_enum_type(key_type)
    if type_shape.as_scalar(key_type) {
        printable = true
    }
    var key_word = "key"
    if type_shape.as_list(object_type) {
        key_word = "index"
    }
    if not printable {
        builder.add_user("fputs(\"\\t{name} is missing\", stderr);")
        return
    }
    builder.add_user("fputs(\"\\t{name} is missing: {key_word} \", stderr);")
    var quote = ""
    if type_shape.as_string(key_type) {
        quote = "fputs(\"\\\"\", stderr);"
    }
    var key_statement = crash_operand_statement(indexed.index, scope, class_information)
    builder.add_user("{quote}{key_statement}{quote}")
    assert type_shape.as_list(object_type)
    var count_result = generate_expression(indexed.object, scope, class_information)
    var count_type = integer_type()
    var counted = string_conversion("(({count_result.code})->item_count_)", count_type)
    var count_text = next_temporary()
    builder.add_user("fputs(\", count \", stderr);")
    builder.add_user(
        "\{ SpiteString {count_text} = {counted}; fwrite(spite_string_bytes(&{count_text}), 1, (size_t)spite_string_length({count_text}), stderr); SpiteString___release({count_text}); }",
    )
}

func content_hash(content: String): String {
    var hash: Long = 5381
    var index = 0
    while index < content.length() {
        hash = (hash * 33 + content.code_at(index)) % 2147483629
        index = index + 1
    }
    var digits = "0123456789abcdef"
    var text = ""
    var remaining = hash
    var count = 0
    while count < 8 {
        var digit: Integer = remaining % 16
        text = digits.character_at(digit) + text
        remaining = remaining / 16
        count = count + 1
    }
    return text
}

func operand_description(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var name = operand_text(expression)
    if name.is_empty() {
        return ""
    }
    var saved_counter = temporary_counter
    var probe = generate_expression(expression, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    return "{name}:{type_display_name(probe_type)}"
}

func record_site(
    assert_statement: Syntax.Statements.AssertStatement,
    kind: String,
    function_name: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    site_ordinal = site_ordinal + 1
    current_site_id = content_hash(
        "{version_free_owner(current_owner)}/{function_name}/{site_ordinal}/{assert_statement.condition_text}",
    )
    var operands = List<String>()
    if not crash_parts.is_empty() {
        crash_map_lines.append(
            "{current_site_id}\t{current_path}\t{current_line}\t{assert_statement.column}\t{current_owner}\t{function_name}\t{kind}\t{assert_statement.condition_text}\t{mapped_crash_parts(scope, class_information)}",
        )
        return
    }
    if assert_statement.value {
        var binary = shape.as_binary(assert_statement.value)
        if binary {
            if binary.left {
                var left_description = operand_description(binary.left, scope, class_information)
                if not left_description.is_empty() {
                    operands.append(left_description)
                }
            }
            if binary.right {
                var right_description = operand_description(binary.right, scope, class_information)
                if not right_description.is_empty() {
                    operands.append(right_description)
                }
            }
        } else {
            var single = operand_description(assert_statement.value, scope, class_information)
            if not single.is_empty() {
                operands.append(single)
            }
        }
    }
    crash_map_lines.append(
        "{current_site_id}\t{current_path}\t{current_line}\t{assert_statement.column}\t{current_owner}\t{function_name}\t{kind}\t{assert_statement.condition_text}\t{operands.join(" ")}",
    )
}

func mapped_crash_parts(scope: Scope, class_information: Analysis.ClassInfo): String {
    var described = List<String>()
    var index = 0
    while index < crash_parts.count() {
        var part = crash_parts[index]
        if part.is_call and part.captured_type {
            described.append("{part.label}:{type_display_name(part.captured_type)}")
        } else if not part.is_reach and not part.is_call and is_part_shown(part, scope, class_information) {
            var part_expression = part.expression
            var description = operand_description(part_expression, scope, class_information)
            if not described.contains(description) {
                described.append(description)
            }
        }
        index = index + 1
    }
    return described.join(" ")
}

func sorted_position(sorted: List<String>, line: String): Integer {
    var position = sorted.count()
    while position > 0 {
        var before = position - 1
        crash before < sorted.count()
        if sorted[before] > line {
            position = before
        } else {
            return position
        }
    }
    return position
}

func crash_map(): String {
    var sorted = List<String>()
    var index = 0
    while index < crash_map_lines.count() {
        var line = crash_map_lines[index]
        var insert_position = sorted_position(sorted, line)
        var repeated = false
        if insert_position > 0 {
            repeated = sorted[insert_position - 1] == line
        }
        if insert_position < sorted.count() and not repeated {
            repeated = sorted[insert_position] == line
        }
        if not repeated {
            sorted.insert(insert_position, line)
        }
        index = index + 1
    }
    var body = sorted.join("\n")
    return "# spite crashes 1 {content_hash(body)}\n{body}\n"
}

func backslash_quote(): String {
    return "\""
}

func tab_text(): String {
    return "\\t"
}

func newline_text(): String {
    return "\\n"
}

func collect_and_sides(expression: Syntax.Expressions.Expression, sides: List<Syntax.Expressions.Expression>) {
    var joined = shape.as_binary(expression)
    if joined {
        if joined.operator == 'logical_and' {
            crash joined.left
            crash joined.right
            collect_and_sides(joined.left, sides)
            collect_and_sides(joined.right, sides)
            return
        }
    }
    sides.append(expression)
}

func generate_and_narrowing_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    crash if_statement.condition
    var sides = List<Syntax.Expressions.Expression>()
    collect_and_sides(if_statement.condition, sides)
    if sides.count() <= 1 {
        return false
    }
    var then_scope = Scope(scope)
    var tests = List<String>()
    var index = 0
    while index < sides.count() {
        var side_position = builder.user_count()
        var side_marks = wait_mark_counters.count()
        var side_counter = temporary_counter
        var waits_in_place = index > 0 and (not resumable_mode or conditional_depth != 0)
        if waits_in_place {
            conditional_depth = conditional_depth + 1
        }
        var side_test = and_side_test(sides[index], then_scope, class_information)
        if waits_in_place {
            conditional_depth = conditional_depth - 1
        }
        if index > 0 and waited_since(side_marks) {
            var decided = chained_side(tests, side_test, side_position, side_marks, side_counter)
            tests.clear()
            tests.append(decided)
        } else {
            tests.append(side_test)
        }
        index = index + 1
    }
    builder.add_user("if ({tests.join(" && ")}) \{")
    generate_block_in_scope(if_statement.then_branch, then_scope, class_information, function_information)
    builder.add_user("}")
    if if_statement.has_else_branch {
        builder.add_user("else \{")
        generate_block(if_statement.else_branch, scope, class_information, function_information)
        builder.add_user("}")
    }
    return true
}

func chained_side(
    tests: List<String>,
    side_test: String,
    position: Integer,
    marks_before: Integer,
    counter_before: Integer,
): String {
    var decided = next_temporary()
    var opening = List<String>()
    opening.append("bool {decided} = {tests.join(" && ")};")
    opening.append("if ({decided}) \{")
    var closing = List<String>()
    closing.append("{decided} = {side_test};")
    closing.append("}")
    wrap_waits(position, marks_before, counter_before, opening, closing, decided)
    return decided
}

func and_side_test(
    side: Syntax.Expressions.Expression,
    then_scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var guard = try_nullable_guard(side, then_scope, class_information)
    if guard {
        narrow_by_guard(then_scope, guard, "the 'if'")
        return "({guard.guard_code})"
    }
    var side_result = generate_joined(side, then_scope, class_information)
    check_condition(side, side_result, "if", then_scope)
    narrow_proven_indices(side, then_scope, class_information)
    return "({owned_truth(side_result, side)})"
}

func recheck_in_loop(value: Syntax.Expressions.Expression, scope: Scope) {
    assert shape.as_index(value)
    var path = operand_text(value)
    if not path.is_empty() and not scope.proven_inside_loop(path) {
        scope.recheck_path(path)
    }
}

func generate_assert_statement(
    assert_statement: Syntax.Statements.AssertStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    if not assert_statement.value {
        return false
    }
    var walked_check = assert_statement.is_crash and walked_check_texts.contains(assert_statement.condition_text)
    if walked_check and emit_cached_check(assert_statement, scope, class_information, function_information) {
        return false
    }
    var sides = List<Syntax.Expressions.Expression>()
    collect_and_sides(assert_statement.value, sides)
    if sides.count() > 1 {
        var side_index = 0
        while side_index < sides.count() {
            var side_text = Syntax.SourcePrinter().source_expression(sides[side_index])
            var side_statement = Syntax.Statements.AssertStatement(sides[side_index])
            side_statement.is_crash = assert_statement.is_crash
            side_statement.condition_text = side_text
            side_statement.line = assert_statement.line
            side_statement.column = assert_statement.column
            if generate_assert_statement(side_statement, scope, class_information, function_information) {
                return true
            }
            side_index = side_index + 1
        }
        return false
    }
    recheck_in_loop(assert_statement.value, scope)
    var decided = folded_check(assert_statement.value, scope, class_information)
    if decided == true or decided == false {
        emit_folded_check(assert_statement, decided == true, scope, class_information, function_information)
        return decided == false
    }
    asserting_boolean_truth = true
    var guard = try_nullable_guard(assert_statement.value, scope, class_information)
    asserting_boolean_truth = false
    var guard_code = ""
    crash_parts = List<CrashPart>()
    if guard {
        guard_code = guard.guard_code
        narrow_by_guard(scope, guard, "'{check_keyword(assert_statement)} {guard.name}'")
        var guard_inner = guard.inner
        if is_boolean_type(guard_inner) {
            var truth = generate_expression(assert_statement.value, scope, class_information)
            guard_code = "({guard_code}) && ({truth.code})"
        }
    } else {
        var declarations_at = builder.user_count()
        var parts = List<CrashPart>()
        if assert_statement.is_crash {
            parts = crash_parts_of(assert_statement.value)
            crash_parts = parts
            crash_capturing = true
        }
        var condition_result = generate_joined(assert_statement.value, scope, class_information)
        guard_code = owned_truth(condition_result, assert_statement.value)
        crash_capturing = false
        crash_parts = parts
        declare_crash_parts(declarations_at)
        check_asserted_condition(assert_statement, condition_result, scope)
        narrow_proven_indices(assert_statement.value, scope, class_information)
    }
    if not assert_statement.is_crash and function_information.is_constructor {
        report(
            "'assert' is not allowed in a constructor: a constructor is setup, not logic. Take already resolved values, or use 'crash' when absence is a bug",
        )
    }
    var site_kind = "assert-predicate"
    if guard {
        site_kind = "assert-narrowing"
    }
    if assert_statement.is_crash {
        site_kind = "crash"
    }
    record_site(assert_statement, site_kind, function_information.name, scope, class_information)
    builder.add_user("if (!({guard_code})) \{")
    emit_check_failure(assert_statement, guard, true, scope, class_information, function_information)
    release_crash_parts()
    crash_parts = List<CrashPart>()
    return false
}

func crash_parts_of(condition: Syntax.Expressions.Expression): List<CrashPart> {
    var parts = List<CrashPart>()
    var reached = List<String>()
    collect_crash_parts(condition, true, false, reached, parts)
    return parts
}

func collect_crash_parts(
    expression: Syntax.Expressions.Expression,
    known: Boolean,
    held: Boolean,
    reached: List<String>,
    parts: List<CrashPart>,
) {
    var label = operand_text(expression)
    if not label.is_empty() {
        var part = CrashPart(expression, label)
        part.reached_names = reached
        parts.append(part)
        return
    }
    var binary = shape.as_binary(expression)
    if binary {
        collect_binary_parts(binary, known, held, reached, parts)
        return
    }
    var unary = shape.as_unary(expression)
    if unary {
        crash unary.operand
        var negates = unary.operator == 'logical_not'
        collect_crash_parts(unary.operand, known and negates, not held, reached, parts)
        return
    }
    var call = shape.as_call(expression)
    if call {
        collect_call_parts(call, known, reached, parts)
        return
    }
    var member = shape.as_member(expression)
    if member {
        crash member.object
        collect_crash_parts(member.object, false, false, reached, parts)
        return
    }
    var indexed = shape.as_index(expression)
    assert indexed
    crash indexed.object and indexed.index
    collect_crash_parts(indexed.object, false, false, reached, parts)
    collect_crash_parts(indexed.index, false, false, reached, parts)
}

func collect_binary_parts(
    binary: Syntax.Expressions.BinaryExpression,
    known: Boolean,
    held: Boolean,
    reached: List<String>,
    parts: List<CrashPart>,
) {
    crash binary.left and binary.right
    assert not binary.is_text_join
    var joins = binary.operator == 'logical_or' or binary.operator == 'logical_and'
    if not joins {
        collect_crash_parts(binary.left, false, false, reached, parts)
        collect_crash_parts(binary.right, false, false, reached, parts)
        return
    }
    var failed_or = binary.operator == 'logical_or' and not held
    var held_and = binary.operator == 'logical_and' and held
    var both_ran = known and (failed_or or held_and)
    collect_crash_parts(binary.left, both_ran, held, reached, parts)
    if both_ran {
        collect_crash_parts(binary.right, true, held, reached, parts)
        return
    }
    var reach = CrashPart(binary.right, "")
    reach.is_reach = true
    reach.set_name = next_crash_name("reached")
    reach.reached_names = reached
    parts.append(reach)
    var further = reached.copy()
    further.append(reach.set_name)
    collect_crash_parts(binary.right, false, false, further, parts)
}

func collect_call_parts(
    call: Syntax.Expressions.CallExpression,
    known: Boolean,
    reached: List<String>,
    parts: List<CrashPart>,
) {
    crash call.callee
    if not known {
        var called: Syntax.Expressions.Expression = call
        var printer = Syntax.SourcePrinter()
        var called_text = printer.source_expression(called)
        var part = CrashPart(called, called_text)
        part.is_call = true
        part.value_name = next_crash_name("value")
        part.set_name = next_crash_name("set")
        part.reached_names = reached
        parts.append(part)
    }
    var member = shape.as_member(call.callee)
    if member {
        crash member.object
        collect_crash_parts(member.object, false, false, reached, parts)
    }
    var index = 0
    while index < call.arguments.count() {
        collect_crash_parts(call.arguments[index], false, false, reached, parts)
        index = index + 1
    }
}

func next_crash_name(kind: String): String {
    crash_capture_counter = crash_capture_counter + 1
    return "spite_crash_{kind}_{crash_capture_counter}"
}

func declare_crash_parts(position: Integer) {
    var declarations = List<String>()
    var index = 0
    while index < crash_parts.count() {
        var part = crash_parts[index]
        if part.is_reach {
            declarations.append("bool {part.set_name} = false;")
        } else if part.is_call and part.captured_type {
            declarations.append("{c_type_name(part.captured_type)} {part.value_name}; bool {part.set_name} = false;")
        }
        index = index + 1
    }
    if not declarations.is_empty() {
        var declared = declarations.join(" ")
        builder.insert_user(position, declared)
    }
}

func release_crash_parts() {
    var index = 0
    while index < crash_parts.count() {
        var part = crash_parts[index]
        if part.owned and part.captured_type {
            builder.add_user("if ({part.set_name}) {release_call(part.captured_type, part.value_name)};")
        }
        index = index + 1
    }
}

func is_shown_type(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_nullable(spite_type) or type_shape.as_string(spite_type) or type_shape.as_scalar(spite_type) {
        return true
    }
    return is_enum_type(spite_type) or describes_itself(spite_type)
}

func emit_folded_check(
    assert_statement: Syntax.Statements.AssertStatement,
    holds: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    if not assert_statement.is_crash and function_information.is_constructor {
        report(
            "'assert' is not allowed in a constructor: a constructor is setup, not logic. Take already resolved values, or use 'crash' when absence is a bug",
        )
    }
    if holds and class_information.codegen_types.is_empty() and bound_symbol_name.is_empty() and not in_specialised_copy and not folded_by_reflection {
        report(
            "'{check_keyword(assert_statement)} {assert_statement.condition_text}' is decided while compiling and always holds here: remove it",
        )
    }
    assert not holds
    var site_kind = "assert-predicate"
    if assert_statement.is_crash {
        site_kind = "crash"
    }
    if assert_statement.is_crash {
        note_always_crashing(assert_statement, class_information, function_information)
    }
    site_ordinal = site_ordinal + 1
    current_site_id = content_hash(
        "{version_free_owner(current_owner)}/{function_information.name}/{site_ordinal}/{assert_statement.condition_text}",
    )
    crash_map_lines.append(
        "{current_site_id}\t{current_path}\t{current_line}\t{assert_statement.column}\t{current_owner}\t{function_information.name}\t{site_kind}\t{assert_statement.condition_text}\t",
    )
    builder.add_user("\{")
    emit_check_failure(assert_statement, null, false, scope, class_information, function_information)
}

func note_always_crashing(
    assert_statement: Syntax.Statements.AssertStatement,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var instance = instance_description(class_information)
    var condition = assert_statement.condition_text
    var message = "'crash {condition}' always halts{instance}: its condition is decided while compiling and is false, so the program would stop here every time this function runs: call it only where the condition holds, or change what the condition asks"
    if condition.is_empty() {
        message = "this 'crash' always halts{instance}, and this function is called: take the call out"
    }
    if not writes_reasons.is_empty() {
        message = "{message}; {writes_reasons.join("; ")}"
    }
    always_crashing_functions.append(current_function_c_name)
    always_crashing_paths.append(current_path)
    always_crashing_lines.append(current_line)
    always_crashing_owners.append(current_owner)
    always_crashing_names.append(function_information.name)
    always_crashing_messages.append(message)
}

func instance_description(class_information: Analysis.ClassInfo): String {
    if class_information.codegen_types.is_empty() {
        return ""
    }
    var names = display_names_of(class_information.codegen_types)
    return " in {class_information.simple_name}<{names.join(", ")}>"
}

func report_always_crashing() {
    var reached = builder.reached_functions(always_crashing_functions)
    var index = 0
    while index < reached.count() {
        if reached[index] == true {
            report_always_crashing_at(index)
        }
        index = index + 1
    }
}

func report_always_crashing_at(index: Integer) {
    var site_path = always_crashing_paths[index]
    var site_line = always_crashing_lines[index]
    var site_owner = always_crashing_owners[index]
    var site_function = always_crashing_names[index]
    var site_message = always_crashing_messages[index]
    crash site_path and site_line and site_owner and site_function and site_message
    current_path = site_path
    current_line = site_line
    current_owner = site_owner
    current_function = site_function
    report(site_message)
}

func emit_check_failure(
    assert_statement: Syntax.Statements.AssertStatement,
    guard: NullableGuard?,
    with_operands: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    if assert_statement.is_crash {
        var report_start = builder.user_count()
        builder.add_user("spite_crash_begin();")
        builder.add_user("fflush(stdout);")
        var crash_line = reported_site("spite.crash", "", function_information)
        builder.add_user("fputs({crash_line}, stderr);")
        if guard {
            emit_missing_report(guard, scope, class_information)
        } else if with_operands {
            emit_crash_parts(scope, class_information)
        }
        emit_scope_values(assert_statement.condition_text, scope, class_information)
        builder.add_user("fputs(\"\\n\", stderr);")
        builder.add_user("spite_report_assert_trace();")
        builder.add_user("exit(1);")
        outline_report(report_start)
        builder.add_user("}")
        return
    }
    if not current_path.starts_with("library/") {
        record_in_assert_trace(function_information)
    }
    emit_scope_drops(scope, true)
    var function_information_return_type = function_information.return_type
    if type_shape.is_void(function_information_return_type) {
        builder.add_user("return;")
    } else {
        builder.add_user("return {default_value_for_type(function_information_return_type)};")
    }
    builder.add_user("}")
}

func folded_check(
    assertion: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var reflected_answer = reflected_condition(assertion, scope, class_information)
    if bound_value_present(assertion, scope, class_information) {
        reflected_answer = true
    }
    folded_by_reflection = reflected_answer == true or reflected_answer == false
    if folded_by_reflection {
        var checked_path = operand_text(assertion)
        if reflected_answer == true and not checked_path.is_empty() {
            scope.narrow_path(checked_path)
        }
        return reflected_answer
    }
    assert asks_while_compiling(assertion)
    writes_reasons.clear()
    return constant_condition(assertion, scope, class_information)
}

func asks_while_compiling(expression: Syntax.Expressions.Expression): Boolean {
    switch expression {
        Syntax.Expressions.GenericIdentifierExpression: return true
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return asks_while_compiling(expression.operand)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if expression.operator == 'logical_and' or expression.operator == 'logical_or' {
                return asks_while_compiling(expression.left) and asks_while_compiling(expression.right)
            }
            if argument_count_call(expression.left) or argument_count_call(expression.right) {
                return true
            }
            if shape.as_generic_identifier(expression.left) or shape.as_generic_identifier(expression.right) {
                return true
            }
            if reads_build_field(expression.left) or reads_build_field(expression.right) {
                return true
            }
            return is_symbol_class_read(expression.left)
        }
        Syntax.Expressions.MemberExpression: return reads_build_field(expression)
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var member = shape.as_member(expression.callee)
            if not member {
                return false
            }
            var named = member.name
            return named == "has_function" or named == "function_waits" or named == "fits_vector" or named == "argument_count" or named == "function_writes_parameter" or named == "any_attribute_fits_vector" or named == "has_state"
        }
        _: return false
    }
}

func reads_build_field(expression: Syntax.Expressions.Expression): Boolean {
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    return is_hardcoded_setting_name(member.name)
}

func is_symbol_class_read(expression: Syntax.Expressions.Expression): Boolean {
    var read = shape.as_member(expression)
    if not read or bound_symbol_name.is_empty() {
        return false
    }
    crash read.object
    return read.name == "class" and is_identifier_named(read.object, bound_symbol_name)
}

func report_place(function_information: Analysis.FunctionInfo): String {
    if bare_crash_sites {
        return ""
    }
    return "{tab_text()}{escape_c_string(current_path)}:{current_line}{tab_text()}{current_owner}{tab_text()}{function_information.name}"
}

# ../../../docs/optimizations.md#identical-functions-are-folded-into-one
func reported_site(kind: String, ending: String, function_information: Analysis.FunctionInfo): String {
    var text = "{kind}{tab_text()}{current_site_id}{report_place(function_information)}{ending}"
    var free_path = version_free_path(current_path)
    var free_owner = version_free_owner(current_owner)
    var key = "{kind}/{current_site_id}/{bare_crash_sites}/{free_path}:{current_line}/{free_owner}/{function_information.name}{ending}"
    return site_symbol(key, text)
}

func located(path: String, line: Integer, owner: String, function_name: String): String {
    var text = escape_c_string("{path}:{line} in {owner}.{function_name}")
    var free_path = version_free_path(path)
    var free_owner = version_free_owner(owner)
    return site_symbol("{free_path}:{line} in {free_owner}.{function_name}", text)
}

func site_symbol(key: String, text: String): String {
    var known = site_symbols[key]
    if known {
        return known
    }
    var name = "spite_site_{site_symbols.count()}"
    var symbol = "{name}()"
    site_symbols[key] = symbol
    builder.add_shaken_macro(name)
    builder.add_typedef("#define {symbol} \"{text}\"")
    return symbol
}

func version_free_owner(owner: String): String {
    var dot = owner.index_of(".")
    if dot <= 0 {
        return owner
    }
    var first = owner.slice(0, dot)
    if not version_notes.has(first) {
        return owner
    }
    var owner_length = owner.length()
    return owner.slice(dot + 1, owner_length)
}

func version_free_path(path: String): String {
    var slashed = path.replace("\\", "/")
    var marker = slashed.index_of(".spite/git/")
    if marker < 0 {
        return path
    }
    var slashed_length = slashed.length()
    var checkout = slashed.slice(marker + 11, slashed_length)
    var repository_end = checkout.index_of("/")
    var checkout_length = checkout.length()
    var commit_part = checkout.slice(repository_end + 1, checkout_length)
    var commit_end = commit_part.index_of("/")
    if repository_end < 0 or commit_end < 0 {
        return path
    }
    var commit_length = commit_part.length()
    var repository = checkout.slice(0, repository_end)
    var inside = commit_part.slice(commit_end + 1, commit_length)
    return "{repository}/{inside}"
}

func record_in_assert_trace(function_information: Analysis.FunctionInfo) {
    var answer = assert_answer(function_information.return_type)
    var ending = "{tab_text()}answered={answer}{newline_text()}"
    var trace_line = reported_site("spite.assert", ending, function_information)
    builder.add_user("SPITE_TRACE_ASSERT({trace_line});")
}

func assert_answer(return_type: Analysis.SpiteType): String {
    if type_shape.is_void(return_type) {
        return "nothing"
    }
    if type_shape.as_nullable(return_type) {
        return "null"
    }
    return "empty"
}

func generate_return_statement(
    return_statement: Syntax.Statements.ReturnStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var return_type = function_information.return_type
    if type_shape.is_void(return_type) {
        if return_statement.value and not has_error {
            report(
                "'{function_information.name}' returns nothing, so 'return' cannot carry a value here: declare what it returns, like 'func {function_information.name}(): Integer', or return without a value",
            )
            return
        }
    } else if not return_statement.value {
        report("'{function_information.name}' returns {type_with_article(return_type)}, so 'return' needs a value")
        return
    }
    if return_statement.value and not function_information.lent_element.is_empty() {
        var mentioned = List<String>()
        collect_statement_names(return_statement, mentioned)
        mentioned.each(scope.mark_used)
        var lent_temporary = next_temporary()
        var lent_read = lent_element_read(class_information, function_information)
        builder.add_user("{c_type_name(return_type)} {lent_temporary} = {lent_read};")
        emit_scope_drops(scope, true)
        builder.add_user("return {lent_temporary};")
        return
    }
    if return_statement.value {
        report_unlent_return(return_statement.value, class_information, function_information)
        assert not returns_object_in_frame(return_statement.value, return_type, scope, class_information)
        frame_variadic_allowed = not resumable_mode
        var value_code = coerce_for_store(return_statement.value, return_type, scope, class_information)
        frame_variadic_allowed = false
        var temporary = next_temporary()
        builder.add_user("{c_type_name(return_type)} {temporary} = {value_code};")
        framed_cleanups.each(builder.add_user)
        framed_cleanups.clear()
        emit_scope_drops(scope, true)
        builder.add_user("return {temporary};")
    } else {
        emit_scope_drops(scope, true)
        builder.add_user("return;")
    }
}

func generate_expression_statement(
    expression_statement: Syntax.Statements.ExpressionStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert expression_statement.value
    assert not freed_from_frame(expression_statement, scope)
    report_dropped_construction(expression_statement.value, class_information)
    frame_variadic_allowed = not resumable_mode
    var result = generate_expression(expression_statement.value, scope, class_information)
    frame_variadic_allowed = false
    emit_result_statement(result, expression_statement)
    framed_cleanups.each(builder.add_user)
    framed_cleanups.clear()
}

func emit_result_statement(result: ExpressionResult, expression_statement: Syntax.Statements.ExpressionStatement) {
    var result_type = result.type
    if type_shape.is_void(result_type) {
        builder.add_user("{result.code};")
        return
    }
    if type_needs_drop(result_type) {
        crash expression_statement.value
        if owns(result, expression_statement.value) {
            var temporary = next_temporary()
            builder.add_user("{c_type_name(result_type)} {temporary} = {result.code};")
            builder.add_user("{release_call(result_type, temporary)};")
            return
        }
    }
    builder.add_user("(void)({result.code});")
}

func discard_call_result(result: ExpressionResult) {
    var result_type = result.type
    if type_shape.is_void(result_type) {
        builder.add_user("{result.code};")
        return
    }
    if type_needs_drop(result_type) and result.owning_override != false {
        var temporary = next_temporary()
        builder.add_user("{c_type_name(result_type)} {temporary} = {result.code};")
        builder.add_user("{release_call(result_type, temporary)};")
        return
    }
    builder.add_user("(void)({result.code});")
}

func report_dropped_construction(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var callee = constructor_callee(expression)
    assert callee
    var constructed = try_resolve_static_path(callee, class_information.qualified_dotted)
    assert constructed
    assert not constructed.is_singleton
    var printer = Syntax.SourcePrinter()
    var written = printer.source_expression(expression)
    var name = constructed.simple_name
    report(
        "'{written}' makes a '{name}' and drops it: a constructed object must be kept and used, so a class whose construction is the whole point should be a function instead; turn '{name}' into a function of the class that needs it, or keep the object in a variable that is read",
    )
}

func constructor_callee(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    var call = shape.as_call(expression)
    if call {
        return call.callee
    }
    var generic_call = shape.as_generic_call(expression)
    assert generic_call
    return generic_call.callee
}

func generate_statement(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    undo_proofs_after_calls(scope, class_information)
    current_line = statement.line
    if statement.line == 0 {
        current_line = function_information.line
    }
    report_reads_in_indices(statement)
    if not breakpoint_sites.is_empty() {
        emit_breakpoint(statement, scope, class_information, function_information)
    }
    var saved_poisoned = statement_poisoned
    var mentioned = List<String>()
    if mentions_poisoned(statement, mentioned) {
        statement_poisoned = true
        mark_each_used(mentioned, scope)
    }
    var errors_before = errors_reported
    var waits_before = wait_mark_counters.count()
    if scope.holds_kept_reads() and may_change_kept_reads(statement, scope, class_information) {
        scope.drop_kept_reads()
    }
    var assigned = shape.as_assignment_statement(statement)
    if assigned {
        frame_variadic_allowed = not resumable_mode
    }
    var ended_in_return = generate_statement_kind(statement, scope, class_information, function_information)
    if assigned {
        frame_variadic_allowed = false
        framed_cleanups.each(builder.add_user)
        framed_cleanups.clear()
    }
    note_repeated_check(statement, scope, errors_reported == errors_before)
    if ended_in_return {
        leaving_statements.append(statement)
    }
    if resumable_mode {
        drop_unread_waits(waits_before)
    }
    var declared = shape.as_variable_declaration(statement)
    if declared and errors_reported > errors_before {
        scope.mark_used(declared.name)
    }
    if declared and statement_poisoned {
        var key = poisoned_key(declared.name)
        poisoned_names.append(key)
        scope.mark_used(declared.name)
    }
    statement_poisoned = saved_poisoned
    return ended_in_return
}

# ../../../docs/proofs.md#proving-what-is-proven-is-an-error
func note_repeated_check(statement: Syntax.Statements.Statement, scope: Scope, clean: Boolean) {
    var check = shape.as_assert_statement(statement)
    if not check or check.condition_text.is_empty() or check.condition_text.contains("(") {
        scope.last_check_text = ""
        return
    }
    if clean and check.condition_text == scope.last_check_text {
        report(
            "'{check.condition_text}' was already checked on line {scope.last_check_line}, and nothing between could change it: remove this check",
        )
        return
    }
    scope.last_check_text = check.condition_text
    scope.last_check_line = statement.line
}

func emit_breakpoint(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var source_path = function_information.source_path
    if source_path.is_empty() {
        source_path = class_information.source_path
    }
    var site = "{statement.line} {source_path}"
    var emitted_key = "{site} {function_information.c_name}"
    assert hot_reload and remote_loop_port > 0 and breakpoint_sites.contains(site)
    assert not emitted_breakpoints.contains(emitted_key)
    emitted_breakpoints.append(emitted_key)
    if not matched_breakpoints.contains(site) {
        matched_breakpoints.append(site)
    }
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    crash attribute_class
    var attribute_type = class_type_of(attribute_class)
    var list_name = ensure_list(attribute_type)
    builder.add_prototype("void spite_breakpoint(SpiteString site, {list_name}* locals);")
    var lines = List<String>()
    lines.append("\{ {list_name}* spite_break_locals = {list_name}___make();")
    if not class_information.is_value_class {
        var self_type = class_type_of(class_information)
        var reflect_self = ensure_reflect_function(self_type)
        lines.append("{list_name}_append(spite_break_locals, {reflect_self}({ensure_symbol("self")}, self));")
    }
    var names = List<String>()
    scope.visible_names(names)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var local_type = scope.lookup_type(name)
        crash local_type
        var local_code = c_value_name(name)
        var override = scope.lookup_override(name)
        if override {
            local_code = override
        }
        var reflect = ensure_reflect_function(local_type)
        lines.append("{list_name}_append(spite_break_locals, {reflect}({ensure_symbol(name)}, {local_code}));")
        index = index + 1
    }
    var shown_site = "{source_path}:{statement.line}"
    lines.append("spite_breakpoint({owned_c_text(shown_site)}, spite_break_locals); }")
    var joined_lines = lines.join(" ")
    builder.add_user(joined_lines)
}

func mark_each_used(names: List<String>, scope: Scope) {
    names.each(scope.mark_used)
}

func generate_statement_kind(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    if not writing_lent_arguments {
        report_nested_calls(statement, class_information)
        report_lone_holes(statement, scope, class_information)
    }
    var variable_declaration = shape.as_variable_declaration(statement)
    if variable_declaration {
        generate_variable_declaration(variable_declaration, scope, class_information)
        narrow_literal_indices(variable_declaration, scope)
        note_count_alias(variable_declaration, scope)
        note_not_negative(variable_declaration, function_information)
        return false
    }
    var assignment = shape.as_assignment_statement(statement)
    if assignment {
        if report_borrowed_reassignment(assignment, scope) {
            return false
        }
        borrow_site = assignment_site(assignment, scope)
        generate_assignment(assignment, scope, class_information)
        borrow_site = ""
        return false
    }
    var if_statement = shape.as_if_statement(statement)
    if if_statement {
        return generate_if_statement(if_statement, scope, class_information, function_information)
    }
    var while_statement = shape.as_while_statement(statement)
    if while_statement {
        generate_while_statement(while_statement, scope, class_information, function_information)
        return false
    }
    var assert_statement = shape.as_assert_statement(statement)
    if assert_statement and not function_information.lent_element.is_empty() {
        report_default_assert(assert_statement, scope, class_information, function_information)
        var range_failed = lent_element_range_failed(class_information, function_information)
        builder.add_user("if ({range_failed}) \{")
        generate_assert_statement(assert_statement, scope, class_information, function_information)
        builder.add_user("}")
        return false
    }
    if assert_statement {
        report_default_assert(assert_statement, scope, class_information, function_information)
        return generate_assert_statement(assert_statement, scope, class_information, function_information)
    }
    var return_statement = shape.as_return_statement(statement)
    if return_statement {
        borrow_site = "return"
        generate_return_statement(return_statement, scope, class_information, function_information)
        borrow_site = ""
        return true
    }
    var switch_statement = shape.as_switch_statement(statement)
    if switch_statement {
        generate_switch_statement(switch_statement, scope, class_information, function_information)
        return false
    }
    var expression_statement = shape.as_expression_statement(statement)
    if expression_statement {
        if not lends_spread_arguments(expression_statement, scope, class_information, function_information) {
            generate_expression_statement(expression_statement, scope, class_information)
        }
        return false
    }
    report("unsupported statement kind in this stage")
    return false
}

func constructor_parameter_list(information: Analysis.ClassInfo): String {
    if not information.constructor {
        return "void"
    }
    var parts = List<String>()
    var index = 0
    while index < information.constructor.parameters.count() {
        var parameter = information.constructor.parameters[index]
        var parameter_type = parameter.type
        parts.append("{c_type_name(parameter_type)} {c_value_name(parameter.name)}")
        index = index + 1
    }
    if parts.is_empty() {
        return "void"
    }
    return parts.join(", ")
}

func function_signature(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    return named_signature(information, function, function.c_name)
}

func named_signature(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, c_name: String): String {
    var parts = List<String>()
    var receiver_type = value_class_type(information)
    parts.append("{c_type_name(receiver_type)} self")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        parts.append("{c_type_name(parameter_type)} {c_value_name(parameter.name)}")
        index = index + 1
    }
    var function_return_type = function.return_type
    var file = function.source_path
    if file.is_empty() {
        file = information.source_path
    }
    builder.name_function(c_name, "{file}\t{information.qualified_dotted}", function.name, function.line)
    if function.result_slot {
        parts.append("{c_type_name(function_return_type)} restrict spite_result")
    }
    return "{c_type_name(function_return_type)} {c_name}({parts.join(", ")})"
}

func emit_constructed_allocate(
    information: Analysis.ClassInfo,
    replaced: List<String>,
    allocate_lines: List<String>,
    initialize_lines: List<String>,
): String {
    var c_name = information.c_name
    var constructed_lines = List<String>()
    constructed_lines.append("static void {c_name}___init_constructed({c_name}* self) \{")
    var line_index = 1
    while line_index < initialize_lines.count() {
        var line = initialize_lines[line_index]
        var field_index = 0
        while field_index < information.fields.count() {
            var field = information.fields[field_index]
            if replaced.contains(field.name) and line == "self->{c_value_name(field.name)} = {field.default_value_code};" {
                line = "self->{c_value_name(field.name)} = 0;"
            }
            field_index = field_index + 1
        }
        constructed_lines.append(line)
        line_index = line_index + 1
    }
    var joined_initialize_lines = constructed_lines.join("\n")
    builder.add_support(joined_initialize_lines)
    var joined_allocate_lines = allocate_lines.join("\n")
    var constructed = joined_allocate_lines.replace(
        "{c_name}* {c_name}___allocate(void) \{",
        "static {c_name}* {c_name}___allocate_constructed(void) \{",
    )
    constructed = constructed.replace("{c_name}___init(self);", "{c_name}___init_constructed(self);")
    information.constructed_allocate_position = builder.support_count()
    builder.add_support(constructed)
    return "{c_name}___allocate_constructed"
}

func constructor_replaced_fields(information: Analysis.ClassInfo): List<String> {
    var replaced = List<String>()
    assert information.constructor and not hot_reload and not information.is_singleton
    assert not information.is_value_class
    var parameter_names = information.constructor.parameters.map_names()
    var body = information.constructor.body
    var index = 0
    var leading = true
    while leading and index < body.count() {
        var target = replaced_by_statement(information, body[index], parameter_names)
        leading = not target.is_empty()
        if leading and not replaced.contains(target) {
            var field = information.find_field(target)
            crash field
            var field_type = field.type
            var visiting = List<String>()
            if type_needs_drop(field_type) and pure_construction_code(field.default_value_code, visiting) {
                replaced.append(target)
            }
        }
        index = index + 1
    }
    return replaced
}

func replaced_by_statement(
    information: Analysis.ClassInfo,
    statement: Syntax.Statements.Statement,
    parameter_names: List<String>,
): String {
    var assignment = shape.as_assignment_statement(statement)
    if not assignment {
        return ""
    }
    crash assignment.target
    crash assignment.value
    var target = shape.as_identifier(assignment.target)
    if not target {
        return ""
    }
    if not information.find_field(target.name) or parameter_names.contains(target.name) {
        return ""
    }
    if not constant_or_parameter(assignment.value, parameter_names) {
        return ""
    }
    return target.name
}

func constant_or_parameter(value: Syntax.Expressions.Expression, parameter_names: List<String>): Boolean {
    var identifier = shape.as_identifier(value)
    if identifier {
        return parameter_names.contains(identifier.name)
    }
    if shape.as_string_literal(value) or shape.as_integer_literal(value) or shape.as_float_literal(value) {
        return true
    }
    return shape.is_true_literal(value) or shape.is_false_literal(value) or shape.is_null_literal(value)
}

func pure_construction_code(code: String, visiting: List<String>): Boolean {
    var opening = code.index_of("(")
    if opening <= 0 or not code.ends_with(")") {
        return false
    }
    var code_length = code.length()
    var callee = code.slice(0, opening)
    var arguments = code.slice(opening + 1, code_length - 1)
    if not callee.ends_with("___make") or not arguments.is_empty() and not constant_arguments(arguments) {
        return false
    }
    var callee_length = callee.length()
    var class_c_name = callee.slice(0, callee_length - 7)
    return pure_class(class_c_name, visiting)
}

func constant_arguments(arguments: String): Boolean {
    if arguments.is_empty() {
        return false
    }
    var parts = arguments.split(", ")
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        if not constant_texts.has(part) and not constant_number(part) {
            return false
        }
        index = index + 1
    }
    return true
}

func constant_number(part: String): Boolean {
    var index = 0
    while index < part.length() {
        var code = part.code_at(index)
        var digit = code >= 48 and code <= 57
        if not digit and code != 45 and code != 46 {
            return false
        }
        index = index + 1
    }
    return not part.is_empty()
}

func pure_class(class_c_name: String, visiting: List<String>): Boolean {
    if visiting.contains(class_c_name) {
        return false
    }
    visiting.append(class_c_name)
    var information = find_class_by_c_name(class_c_name)
    if not information {
        return false
    }
    if information.qualified_dotted == "List" or information.qualified_dotted == "Dictionary" {
        return true
    }
    if information.is_singleton or information.drop_function or information.is_value_class {
        return false
    }
    if is_hot_class(information) or information.is_generic_template {
        return false
    }
    if information.constructor {
        var parameter_names = information.constructor.parameters.map_names()
        var index = 0
        while index < information.constructor.body.count() {
            var target = replaced_by_statement(information, information.constructor.body[index], parameter_names)
            if target.is_empty() {
                return false
            }
            index = index + 1
        }
    }
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        var field_type = field.type
        if type_needs_drop(field_type) {
            if not pure_construction_code(field.default_value_code, visiting) and not constant_text_code(field.default_value_code) {
                return false
            }
        } else if not constant_scalar_code(field.default_value_code) {
            return false
        }
        field_index = field_index + 1
    }
    return true
}

func constant_text_code(code: String): Boolean {
    return constant_texts.has(code) or code == "0"
}

func constant_scalar_code(code: String): Boolean {
    var index = 0
    var name_start = 0
    while index < code.length() {
        var code_point = code.code_at(index)
        var letter = code_point >= 65 and code_point <= 90 or code_point >= 97 and code_point <= 122 or code_point == 95
        var digit = code_point >= 48 and code_point <= 57
        if code_point == 40 {
            var called = code.slice(name_start, index)
            if not called.is_empty() and (not called.starts_with("Spite") or not called.contains("_from_")) {
                return false
            }
        }
        if not letter and not digit {
            name_start = index + 1
        }
        index = index + 1
    }
    return true
}

# ../../../docs/optimizations.md#a-release-is-inlined-in-every-unit
func counts_inline(information: Analysis.ClassInfo): Boolean {
    var inspected = hot_reload or read_evaluate_print_loop or reload_host
    return not inspected and not information.is_singleton and not information.is_stateless_singleton
}

func emit_inline_counts(information: Analysis.ClassInfo) {
    var name = information.c_name
    builder.add_support(
        "static inline {name}* {name}___retain({name}* self) \{\nif (self != 0) SPITE_COUNT_UP(self->header.ref_count);\nreturn self;\n}",
    )
    builder.add_support(
        "static inline void {name}___release({name}* self) \{\nif (self == 0) return;\nif (SPITE_COUNT_DOWN(self->header.ref_count) > 0) return;\n{name}___free(self);\n}",
    )
}

func emit_class_prototypes(information: Analysis.ClassInfo) {
    builder.add_prototype("void {information.c_name}___init({information.c_name}* self);")
    builder.add_prototype("{information.c_name}* {information.c_name}___allocate(void);")
    builder.add_prototype("{information.c_name}* {information.c_name}___default(void);")
    builder.add_prototype(
        "{information.c_name}* {information.c_name}___make({constructor_parameter_list(information)});",
    )
    if counts_inline(information) {
        builder.add_prototype(
            "static inline {information.c_name}* {information.c_name}___retain({information.c_name}* self);",
        )
        builder.add_prototype("static inline void {information.c_name}___release({information.c_name}* self);")
        builder.add_prototype("void {information.c_name}___free({information.c_name}* self);")
    } else {
        builder.add_prototype("{information.c_name}* {information.c_name}___retain({information.c_name}* self);")
        builder.add_prototype("void {information.c_name}___release({information.c_name}* self);")
    }
    if not information.find_function("copy") {
        builder.add_prototype("{information.c_name}* {information.c_name}_copy({information.c_name}* self);")
    }
    if information.drop_function {
        builder.add_prototype("void {information.drop_function.c_name}({information.c_name}* self);")
    }
    var function_index = 0
    while function_index < information.declared_functions.count() {
        if not is_inline_supplied(information.declared_functions[function_index]) {
            builder.add_prototype("{function_signature(information, information.declared_functions[function_index])};")
        }
        function_index = function_index + 1
    }
}

func emit_class_support(information: Analysis.ClassInfo) {
    var class_id_text: String = information.class_id
    var initialize_lines = List<String>()
    var initialize_name = "{information.c_name}___init"
    if is_hot_class(information) {
        initialize_name = "{information.c_name}___init___hot"
        add_hot_initialize_slot(information)
        if read_evaluate_print_loop {
            ensure_byte_count_function(information)
        }
    }
    initialize_lines.append("void {initialize_name}({information.c_name}* self) \{")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        var initialized_place = field_place("self", information, field.name)
        initialize_lines.append("{initialized_place} = {field.default_value_code};")
        field_index = field_index + 1
    }
    if information.c_name == "Spite_Class" {}
    if information.c_name == "Spite_Function" {
        initialize_lines.append("self->spite_owner = 0;")
        initialize_lines.append("self->spite_release_owner = 0;")
        initialize_lines.append("self->spite_call = 0;")
        initialize_lines.append("self->spite_typed_call = 0;")
        initialize_lines.append("self->spite_text_call = 0;")
        initialize_lines.append("self->spite_add_arguments = 0;")
        initialize_lines.append("self->spite_arguments_lock = 0;")
    }
    if information.c_name == "Spite_Attribute" {
        var cleared_links = hidden_attribute_links_cleared("self")
        initialize_lines.append(cleared_links)
    }
    initialize_lines.append("}")
    var joined_initialize_lines = initialize_lines.join("\n")
    builder.add_support(joined_initialize_lines)
    if information.c_name == "Spite_Function" {
        builder.add_prototype("static void spite_function_arguments_described(Spite_Function* self);")
        builder.add_support(
            "static void spite_function_arguments_described(Spite_Function* self) \{\nif (SPITE_SINGLETON_FOUND(self->spite_add_arguments) == 0) return;\nSPITE_LOCK(self->spite_arguments_lock);\nvoid (*adding)(Spite_Function*) = self->spite_add_arguments;\nif (adding != 0) \{\nadding(self);\nSPITE_SINGLETON_PUBLISH(self->spite_add_arguments, (void (*)(Spite_Function*))0);\n}\nSPITE_UNLOCK(self->spite_arguments_lock);\n}",
        )
    }
    var allocate_lines = List<String>()
    allocate_lines.append("{information.c_name}* {information.c_name}___allocate(void) \{")
    allocate_lines.append(
        "{information.c_name}* self = ({information.c_name}*)SPITE_MALLOC(sizeof({information.c_name}));",
    )
    allocate_lines.append("self->header.ref_count = 1;")
    allocate_lines.append("self->header.class_id = {class_id_text};")
    if debug_memory {
        allocate_lines.append("#ifdef SPITE_DEBUG_MEMORY")
        allocate_lines.append("spite_debug_register_object(self, {class_id_text});")
        allocate_lines.append("#endif")
    }
    append_live_start(allocate_lines, information, "self")
    allocate_lines.append("{information.c_name}___init(self);")
    append_live_add(allocate_lines, information, "self")
    allocate_lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    allocate_lines.append("spite_track_{information.c_name}(self);")
    allocate_lines.append("#endif")
    allocate_lines.append("return self;")
    allocate_lines.append("}")
    var joined_allocate_lines = allocate_lines.join("\n")
    information.allocate_position = builder.support_count()
    note_live_slot(information, "'s allocation")
    builder.add_support(joined_allocate_lines)
    var default_instance = "{information.c_name}___allocate()"
    if information.is_stateless_singleton {
        default_instance = singleton_call(information)
    }
    builder.add_support("{information.c_name}* {information.c_name}___default(void) \{ return {default_instance}; }")
    var allocating = "{information.c_name}___allocate"
    var replaced = constructor_replaced_fields(information)
    if not replaced.is_empty() {
        allocating = emit_constructed_allocate(information, replaced, allocate_lines, initialize_lines)
    }
    var make_lines = List<String>()
    make_lines.append("{information.c_name}* {information.c_name}___make({constructor_parameter_list(information)}) \{")
    make_lines.append("{information.c_name}* self = {allocating}();")
    if information.constructor {
        var arguments = c_parameter_names(information.constructor.parameters)
        arguments.prepend("self")
        make_lines.append("{information.constructor.c_name}({arguments.join(", ")});")
    }
    make_lines.append("return self;")
    make_lines.append("}")
    var joined_make_lines = make_lines.join("\n")
    builder.add_support(joined_make_lines)
    if information.is_stateless_singleton {
        builder.add_support(
            "{information.c_name}* {information.c_name}___retain({information.c_name}* self) \{ return self; }",
        )
        builder.add_support("void {information.c_name}___release({information.c_name}* self) \{ (void)self; }")
        builder.add_support(
            "{information.c_name}* {information.c_name}_copy({information.c_name}* self) \{ return self; }",
        )
        return
    }
    var release_lines = List<String>()
    var retain_body = "if (self != 0) SPITE_COUNT_UP(self->header.ref_count); return self;"
    var release_name = "release"
    if information.is_singleton {
        retain_body = "return self;"
        release_name = "discard"
        builder.add_support("void {information.c_name}___release({information.c_name}* self) \{ (void)self; }")
        builder.add_prototype("void {information.c_name}___destroy({information.c_name}* self);")
        builder.add_prototype("void {information.c_name}___discard({information.c_name}* self);")
        var destroyed = singleton_destroyed(information)
        builder.add_support(destroyed)
    }
    var inline = counts_inline(information)
    if inline {
        emit_inline_counts(information)
        release_name = "free"
    } else {
        builder.add_support(
            "{information.c_name}* {information.c_name}___retain({information.c_name}* self) \{ {retain_body} }",
        )
    }
    release_lines.append("void {information.c_name}___{release_name}({information.c_name}* self) \{")
    if not inline {
        release_lines.append("if (self == 0) return;")
    }
    if not information.is_singleton and not inline {
        release_lines.append("if (SPITE_COUNT_DOWN(self->header.ref_count) > 0) return;")
    }
    if not information.is_singleton and information.drop_function {
        release_lines.append("{information.drop_function.c_name}(self);")
    }
    var drop_field_index = 0
    while drop_field_index < information.fields.count() {
        var field = information.fields[drop_field_index]
        var field_type = field.type
        if type_needs_drop(field_type) {
            var released_place = field_place("self", information, field.name)
            release_lines.append("{release_call(field_type, released_place)};")
        }
        drop_field_index = drop_field_index + 1
    }
    if information.c_name == "Spite_Function" {
        release_lines.append(
            "if (self->spite_owner != 0 && self->spite_release_owner != 0) self->spite_release_owner(self->spite_owner);",
        )
    }
    if information.c_name == "Spite_Attribute" {
        release_lines.append(
            "if (self->spite_owner != 0 && self->spite_release_owner != 0) self->spite_release_owner(self->spite_owner);",
        )
        release_lines.append(
            "if (self->spite_held != 0 && self->spite_release_held != 0) self->spite_release_held(self->spite_held);",
        )
    }
    append_live_remove(release_lines, information)
    release_lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    release_lines.append("spite_untrack_{information.c_name}(self);")
    release_lines.append("#endif")
    release_lines.append("#ifdef SPITE_WEAK_{information.c_name}")
    release_lines.append("spite_weak_object_freed(self);")
    release_lines.append("#endif")
    if information.is_singleton {
        release_lines.append("spite_singleton_free_later(self);")
    } else {
        release_lines.append("SPITE_FREE(self);")
    }
    release_lines.append("}")
    var joined_release_lines = release_lines.join("\n")
    information.release_position = builder.support_count()
    note_live_slot(information, "'s release")
    builder.add_support(joined_release_lines)
    assert not information.find_function("copy")
    if information.is_singleton {
        builder.add_support(
            "{information.c_name}* {information.c_name}_copy({information.c_name}* self) \{ return {information.c_name}___retain(self); }",
        )
        return
    }
    var copy_lines = List<String>()
    copy_lines.append("{information.c_name}* {information.c_name}_copy({information.c_name}* self) \{")
    copy_lines.append(
        "{information.c_name}* spite_copy = ({information.c_name}*)SPITE_MALLOC(sizeof({information.c_name}));",
    )
    copy_lines.append("spite_copy->header.ref_count = 1;")
    copy_lines.append("spite_copy->header.class_id = {class_id_text};")
    append_live_start(copy_lines, information, "spite_copy")
    if debug_memory {
        copy_lines.append("#ifdef SPITE_DEBUG_MEMORY")
        copy_lines.append("spite_debug_register_object(spite_copy, {class_id_text});")
        copy_lines.append("#endif")
    }
    if information.c_name == "Spite_Function" {
        copy_lines.append("spite_function_arguments_described(self);")
    }
    var copy_field_index = 0
    while copy_field_index < information.fields.count() {
        var field = information.fields[copy_field_index]
        var value_code = field_place("self", information, field.name)
        var field_type = field.type
        if type_needs_drop(field_type) {
            value_code = retain_call(field_type, value_code)
        }
        var copied_place = field_place("spite_copy", information, field.name)
        copy_lines.append("{copied_place} = {value_code};")
        copy_field_index = copy_field_index + 1
    }
    if information.c_name == "Spite_Function" {
        copy_lines.append(
            "spite_copy->spite_owner = 0; spite_copy->spite_release_owner = 0; spite_copy->spite_call = 0; spite_copy->spite_typed_call = 0; spite_copy->spite_text_call = 0; spite_copy->spite_add_arguments = 0; spite_copy->spite_arguments_lock = 0;",
        )
    }
    if information.c_name == "Spite_Attribute" {
        var cleared_links = hidden_attribute_links_cleared("spite_copy")
        copy_lines.append(cleared_links)
    }
    append_live_add(copy_lines, information, "spite_copy")
    copy_lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    copy_lines.append("spite_track_{information.c_name}(spite_copy);")
    copy_lines.append("#endif")
    copy_lines.append("return spite_copy;")
    copy_lines.append("}")
    var joined_copy_lines = copy_lines.join("\n")
    information.copy_position = builder.support_count()
    note_live_slot(information, "'s copy")
    builder.add_support(joined_copy_lines)
}

func emit_user_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    assert not function.is_emitted
    function.is_emitted = true
    if runs_in_host(information, function) {
        skipped_in_reload[function.c_name] = true
        if is_slotted_function(information, function) {
            note_hot_slot(information, function)
        }
        return
    }
    if is_inline_supplied(function) {
        if function.supplied_body.ends_with(schema_pending) {
            function.supplied_body = schema_body(information, function)
        }
        note_maths_macro(function)
        builder.add_typedef(function.supplied_body)
        return
    }
    if not function.has_body and is_slotted_function(information, function) and not is_hot_class(information) {
        var supplied_hot_name = "{function.c_name}___hot"
        add_hot_slot(information, function)
        builder.add_user("{named_signature(information, function, supplied_hot_name)} \{\n{function.supplied_body}\n}")
        return
    }
    if not function.has_body {
        builder.add_user("{function_signature(information, function)} \{\n{function.supplied_body}\n}")
        return
    }
    if asks_function_waits(function.body) {
        deferred_wait_classes.append(information)
        deferred_wait_functions.append(function)
        return
    }
    emit_user_function_body(information, function)
}

func report_lost_writes(statements: List<Syntax.Statements.Statement>, information: Analysis.ClassInfo) {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        var declared = shape.as_variable_declaration(statement)
        if declared {
            var made = only_held_here(declared.value, information)
            if made {
                report_lost_write(declared.name, made, statements, index + 1)
            }
        }
        var branched = shape.as_if_statement(statement)
        if branched {
            report_lost_writes(branched.then_branch, information)
            report_lost_writes(branched.else_branch, information)
        }
        var looped = shape.as_while_statement(statement)
        if looped {
            report_lost_writes(looped.body, information)
        }
        var switched = shape.as_switch_statement(statement)
        if switched {
            var case_index = 0
            while case_index < switched.cases.count() {
                report_lost_writes(switched.cases[case_index].body, information)
                case_index = case_index + 1
            }
        }
        index = index + 1
    }
}

func only_held_here(value: Syntax.Expressions.Expression?, information: Analysis.ClassInfo): Analysis.ClassInfo? {
    assert value
    var call = shape.as_call(value)
    assert call
    crash call.callee
    var member = shape.as_member(call.callee)
    if member {
        assert (member.name == "copy" or member.name == "deep_copy") and call.arguments.is_empty()
        crash member.object
        var copied = shape.as_identifier(member.object)
        assert copied
        var copied_field = information.find_field(copied.name)
        assert copied_field
        var copied_type = copied_field.type
        return writable_class(copied_type)
    }
    var named = shape.as_identifier(call.callee)
    assert named
    var made = find_class(named.name, information.namespace_dotted)
    if made {
        assert not made.is_singleton and not made.is_value_class and not is_library_class(made)
        return made
    }
    var own = information.find_function(named.name)
    assert own and not own.is_constructor and own.has_body and own.lent_element.is_empty()
    var answered = own.return_type
    var made_class = writable_class(answered)
    assert made_class
    assert returns_made_only(own.body, information)
    return made_class
}

func returns_made_only(statements: List<Syntax.Statements.Statement>, information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        var returned = shape.as_return_statement(statement)
        if returned {
            if not returned.value or not makes_object(returned.value, information) {
                return false
            }
        }
        var branched = shape.as_if_statement(statement)
        if branched {
            if not returns_made_only(branched.then_branch, information) or not returns_made_only(branched.else_branch, information) {
                return false
            }
        }
        var looped = shape.as_while_statement(statement)
        if looped {
            if not returns_made_only(looped.body, information) {
                return false
            }
        }
        var switched = shape.as_switch_statement(statement)
        if switched {
            var case_index = 0
            while case_index < switched.cases.count() {
                if not returns_made_only(switched.cases[case_index].body, information) {
                    return false
                }
                case_index = case_index + 1
            }
        }
        index = index + 1
    }
    return true
}

func makes_object(value: Syntax.Expressions.Expression?, information: Analysis.ClassInfo): Boolean {
    if not value {
        return false
    }
    var call = shape.as_call(value)
    if not call {
        return false
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if member {
        return (member.name == "copy" or member.name == "deep_copy") and call.arguments.is_empty()
    }
    var named = shape.as_identifier(call.callee)
    if not named {
        return false
    }
    var made = find_class(named.name, information.namespace_dotted)
    if not made {
        return false
    }
    return not made.is_singleton and not made.is_value_class
}

func writable_class(held_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(held_type)
    assert class_ref
    var held = find_class_by_c_name(class_ref.c_name)
    assert held
    assert not held.is_singleton and not held.is_value_class and not is_library_class(held)
    return held
}

func report_lost_write(
    name: String,
    made: Analysis.ClassInfo,
    statements: List<Syntax.Statements.Statement>,
    from: Integer,
) {
    assert not made.drop_function
    var last = -1
    var index = from
    while index < statements.count() {
        var mentioned = List<String>()
        collect_statement_names(statements[index], mentioned)
        if mentioned.contains(name) {
            last = index
        }
        index = index + 1
    }
    assert last >= 0
    var written = shape.as_assignment_statement(statements[last])
    assert written
    crash written.target
    var target = shape.as_member(written.target)
    assert target
    crash target.object
    var holder = shape.as_identifier(target.object)
    assert holder
    assert holder.name == name and not made.find_function("set_{target.name}")
    assert not escapes_before(made, name, statements, from, last)
    var written_field = made.find_field(target.name)
    assert written_field
    var written_type = written_field.type
    assert not lets_go_with_effect(written_type)
    crash written.value
    var value_names = List<String>()
    var value_statement: Syntax.Statements.Statement = Syntax.Statements.ExpressionStatement(written.value)
    collect_statement_names(value_statement, value_names)
    assert not value_names.contains(name)
    var saved_line = current_line
    current_line = statement_line(statements[last])
    report(
        "'{name}.{target.name}' is written here and '{name}' is never read after it: '{name}' is a '{made.simple_name}' only this function holds, so the write is lost when it is let go. Use what was written, return '{name}', keep it in an attribute or a list, or drop the write",
    )
    current_line = saved_line
}

func escapes_before(
    made: Analysis.ClassInfo,
    name: String,
    statements: List<Syntax.Statements.Statement>,
    from: Integer,
    last: Integer,
): Boolean {
    var expressions = List<Syntax.Expressions.Expression>()
    var index = from
    while index < last {
        var one = List<Syntax.Statements.Statement>()
        one.append(statements[index])
        collect_block_expressions(one, expressions)
        index = index + 1
    }
    var written = shape.as_assignment_statement(statements[last])
    crash written
    crash written.value
    expressions.append(written.value)
    var expression_index = 0
    while expression_index < expressions.count() {
        if expression_escapes(expressions[expression_index], name, made) {
            return true
        }
        expression_index = expression_index + 1
    }
    return false
}

func expression_escapes(expression: Syntax.Expressions.Expression?, name: String, made: Analysis.ClassInfo): Boolean {
    if not expression {
        return false
    }
    switch expression {
        Syntax.Expressions.IdentifierExpression: return expression.name == name
        Syntax.Expressions.MemberExpression: {
            if names_identifier(expression.object, name) {
                var named_function = made.find_function(expression.name)
                if named_function {
                    return true
                }
                return false
            }
            return expression_escapes(expression.object, name, made)
        }
        Syntax.Expressions.CallExpression: {
            var method = shape.as_member(expression.callee)
            if method {
                if names_identifier(method.object, name) {
                    return true
                }
            }
            if expression_escapes(expression.callee, name, made) {
                return true
            }
            return any_argument_escapes(expression.arguments, name, made)
        }
        Syntax.Expressions.GenericCallExpression: return any_argument_escapes(expression.arguments, name, made)
        Syntax.Expressions.BinaryExpression: {
            if expression_escapes(expression.left, name, made) {
                return true
            }
            return expression_escapes(expression.right, name, made)
        }
        Syntax.Expressions.UnaryExpression: return expression_escapes(expression.operand, name, made)
        Syntax.Expressions.IndexExpression: {
            if expression_escapes(expression.object, name, made) {
                return true
            }
            return expression_escapes(expression.index, name, made)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var element_index = 0
            while element_index < expression.elements.count() {
                if expression_escapes(expression.elements[element_index].value, name, made) {
                    return true
                }
                element_index = element_index + 1
            }
            return false
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var field_index = 0
            while field_index < expression.fields.count() {
                if expression_escapes(expression.fields[field_index].value, name, made) {
                    return true
                }
                field_index = field_index + 1
            }
            return false
        }
        Syntax.Expressions.StringLiteralExpression: return expression.value.contains(name)
        _: return false
    }
}

func any_argument_escapes(
    arguments: List<Syntax.Expressions.Expression>,
    name: String,
    made: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < arguments.count() {
        if expression_escapes(arguments[index], name, made) {
            return true
        }
        index = index + 1
    }
    return false
}

func lets_go_with_effect(held_type: Analysis.SpiteType): Boolean {
    var visiting = List<String>()
    if holds_handles(held_type, visiting) {
        return true
    }
    var inner = held_type
    var nullable = type_shape.as_nullable(held_type)
    if nullable {
        inner = nullable.inner
    }
    var class_ref = type_shape.as_class_ref(inner)
    if not class_ref {
        return false
    }
    var held = find_class_by_c_name(class_ref.c_name)
    if not held {
        return false
    }
    if held.qualified_dotted == "Parallel" or held.qualified_dotted == "Concurrent" {
        return true
    }
    if held.drop_function {
        return true
    }
    return false
}

func emit_user_function_body(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    site_ordinal = 0
    folded_dictionaries = Dictionary<String, Syntax.Expressions.ObjectLiteralExpression>()
    frame_candidates.clear()
    placed_names.clear()
    placed_frames.clear()
    placed_receiver_names.clear()
    placed_receiver_codes.clear()
    current_class = information
    current_function = function.name
    current_line = function.line
    current_path = information.source_path
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    bind_symbol_of(function)
    bind_reflected_of(function)
    if not is_library_class(information) {
        report_lost_writes(function.body, information)
    }
    var outer_fact_owner = fact_owner
    fact_owner = information.c_name
    placement.foreign_libraries = foreign_library_attributes(information)
    placement.typed_memories = typed_memory_attributes(information)
    study_lent_parameters_of(information)
    var waiting = waiting_kind(information, function)
    if not waiting.is_empty() {
        waiting_classes.append(information)
        waiting_functions.append(function)
        waiting_kinds.append(waiting)
        var user_count = builder.user_count()
        waiting_positions.append(user_count)
    }
    atomic_fields = List<String>()
    atomic_owner = information.c_name
    if atomic_function(information, function) {
        atomic_fields = atomic_singleton_fields(information)
        if not atomic_class_names.contains(information.c_name) {
            atomic_class_names.append(information.c_name)
            atomic_classes.append(information)
        }
    } else if not function.is_constructor {
        atomic_fields = lone_atomic_fields(information)
        if not atomic_fields.is_empty() and not atomic_class_names.contains(information.c_name) {
            atomic_class_names.append(information.c_name)
            atomic_classes.append(information)
        }
    }
    var guarded = guards_singleton(information, function)
    if guarded {
        guarded_classes.append(information)
        guarded_functions.append(function)
        var guarded_at = builder.user_count()
        guarded_positions.append(guarded_at)
    }
    current_function_c_name = function.c_name
    in_specialised_copy = not function.specialised_from.is_empty()
    borrowed_names = List<String>()
    into_function_active = function.result_slot
    object_frames_open = true
    current_return_c_name = returned_class_name(function)
    result_slot_local = ""
    var candidate = not function.result_slot and waiting.is_empty()
    if candidate and function.is_constructor {
        candidate = not information.is_singleton and not information.is_value_class
    }
    if candidate {
        machine_candidate_names.append(function.c_name)
        machine_candidate_classes.append(information)
        machine_candidate_functions.append(function)
        machine_candidate_guarded.append(guarded)
    }
    var defined_name = function.c_name
    if is_slotted_function(information, function) {
        defined_name = "{function.c_name}___hot"
        add_hot_slot(information, function)
    }
    if waiting.is_empty() and not guarded and dispatches_shapes(information, function) {
        defined_name = "{function.c_name}___general"
        builder.add_prototype("{named_signature(information, function, defined_name)};")
        note_dispatcher(information, function)
    }
    var outer_report_start = report_function_start
    var reports_before = report_outline.reports.count()
    report_function_start = builder.user_count()
    builder.add_user("{named_signature(information, function, defined_name)} \{")
    if function.c_name == "Spite_Function_get_arguments" {
        builder.add_user("spite_function_arguments_described(self);")
    }
    if function.c_name == "Spite_Function_get_accesses" {
        function_accesses_used = true
        note_fact("flag function_accesses_used")
        builder.add_prototype("static void spite_function_accesses_described(Spite_Function* self);")
        builder.add_user("spite_function_accesses_described(self);")
    }
    if function.c_name == "Spite_Function_waits" {
        function_waits_table_used = true
        note_fact("flag function_waits_table_used")
        builder.add_prototype("static bool spite_function_waits(void* typed_call);")
        builder.add_user("self->_waits_ = spite_function_waits(self->spite_typed_call);")
    }
    var scope = parameter_scope(function)
    var outer_item_function = item_function
    var outer_item_scope = item_function_scope
    item_function = function
    item_function_scope = scope
    terminal_if = terminal_if_of(function.body)
    body_narrowed_names = List<String>()
    body_assigned_paths = List<String>()
    collect_body_facts(function.body)
    var outer_leaving = leaving_statements
    leaving_statements = List<Syntax.Statements.Statement>()
    var ended_in_return = generate_statement_list(function.body, scope, information, function)
    item_function = outer_item_function
    item_function_scope = outer_item_scope
    terminal_if = null
    report_unused(scope)
    if not ended_in_return {
        report_falling_end(information, function)
    }
    leaving_statements = outer_leaving
    if not ended_in_return {
        emit_scope_drops(scope, true)
        var function_return_type = function.return_type
        if not type_shape.is_void(function_return_type) {
            builder.add_user("return {default_value_for_type(function_return_type)};")
        }
    }
    close_rebindings(scope)
    builder.add_user("}")
    fact_owner = outer_fact_owner
    into_function_active = false
    object_frames_open = false
    current_return_c_name = ""
    if guarded {
        var guarded_end = builder.user_count()
        guarded_ends.append(guarded_end)
    }
    report_function_start = outer_report_start
    add_outlined_reports(reports_before)
}

func add_outlined_reports(first: Integer) {
    var index = first
    while index < report_outline.reports.count() {
        builder.add_user(report_outline.reports[index])
        index = index + 1
    }
}

func outline_report(start: Integer) {
    if report_function_start >= 0 and report_function_start < start and not hot_reload {
        outline_report_from(start)
    }
}

func outline_report_from(start: Integer) {
    var body = builder.take_user_from(start)
    var function_lines = List<String>()
    var index = report_function_start
    while index < start {
        var line = builder.user_at(index)
        function_lines.append(line)
        index = index + 1
    }
    var call = report_outline.outlined_call(body, function_lines)
    if call.is_empty() {
        body.each(builder.add_user)
        return
    }
    var prototype = report_outline.prototypes.last()
    crash prototype
    builder.add_prototype(prototype)
    builder.add_user(call)
}

func returned_class_name(function: Analysis.FunctionInfo): String {
    var function_return_type = function.return_type
    var returned_reference = type_shape.as_class_ref(function_return_type)
    if not returned_reference {
        return ""
    }
    return returned_reference.c_name
}

func declare_lent_parameter(name: String, parameter_type: Analysis.SpiteType, sources: String, scope: Scope) {
    if type_shape.as_union(parameter_type) {
        var no_paths = List<String>()
        scope.declare_row(name, parameter_type, sources, no_paths)
        return
    }
    scope.declare_borrowed(name, parameter_type, sources)
}

func parameter_scope(function: Analysis.FunctionInfo): Scope {
    var scope = Scope(null)
    arguments_parameter_names.clear()
    lent_parameter_names = function.lent_parameters
    lent_parameter_caller = ""
    if lent_callers[function.c_name] {
        lent_parameter_caller = lent_callers[function.c_name]
    }
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        var parameter = function.parameters[parameter_index]
        var parameter_type = parameter.type
        if type_shape.is_arguments(parameter_type) {
            arguments_parameter_names.append(parameter.name)
        }
        if function.lent_parameters.contains(parameter.name) {
            declare_lent_parameter(parameter.name, parameter_type, function.lent_sources, scope)
        } else if function.held_parameters.contains(parameter.name) {
            scope.declare(parameter.name, parameter_type)
            scope.held_names.append(parameter.name)
        } else if type_needs_drop(parameter_type) {
            scope.declare_owned(parameter.name, parameter_type)
        } else {
            scope.declare(parameter.name, parameter_type)
        }
        var reflected_instance = function.specialisation_position >= 0 and parameter.name.ends_with("_instance")
        if not signature_is_dictated(function) and not reflected_instance {
            scope.check_last_parameter(current_line)
        }
        parameter_index = parameter_index + 1
    }
    return scope
}

func emit_class(information: Analysis.ClassInfo) {
    assert not information.is_emitted
    information.is_emitted = true
    current_owner = information.qualified_dotted
    if information.is_value_class {
        emit_value_class(information)
        return
    }
    var struct_lines = List<String>()
    struct_lines.append("struct {information.c_name} \{")
    struct_lines.append("SpiteHeader header;")
    if has_live_registry(information) {
        struct_lines.append("void* spite_moved;")
        struct_lines.append("int64_t spite_live;")
    }
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        var field_type = field.type
        struct_lines.append("{c_type_name(field_type)} {c_value_name(field.name)};")
        field_index = field_index + 1
    }
    if information.c_name == "Spite_Class" {}
    if information.c_name == "Spite_Function" {
        struct_lines.append("void* spite_owner;")
        struct_lines.append("void (*spite_release_owner)(void*);")
        struct_lines.append("void (*spite_call)(void*);")
        struct_lines.append("void* spite_typed_call;")
        struct_lines.append("void* spite_text_call;")
        struct_lines.append("void (*spite_add_arguments)(Spite_Function*);")
        struct_lines.append("int32_t spite_arguments_lock;")
    }
    if information.c_name == "Spite_Attribute" {
        struct_lines.append("void* spite_owner;")
        struct_lines.append("void (*spite_release_owner)(void*);")
        struct_lines.append("bool (*spite_assign)(void*, void*, SpiteString);")
        struct_lines.append("bool (*spite_store)(void*, void*, void*);")
        struct_lines.append("void* (*spite_held_class)(void);")
        struct_lines.append("void* spite_held;")
        struct_lines.append("void (*spite_release_held)(void*);")
        struct_lines.append("void* (*spite_held_attributes)(void*);")
        struct_lines.append("void* (*spite_held_functions)(void*);")
        struct_lines.append("int64_t spite_held_bytes;")
        struct_lines.append("int64_t spite_stored_address;")
        struct_lines.append("int64_t spite_stored_bytes;")
        struct_lines.append("int64_t spite_buffer_address;")
        struct_lines.append("int64_t spite_buffer_bytes;")
    }
    struct_lines.append("};")
    var joined_struct_lines = struct_lines.join("\n")
    information.struct_position = builder.typedef_count()
    builder.add_typedef(joined_struct_lines)
    if is_hot_class(information) {
        add_live_layout(information)
    } else if has_live_registry(information) {
        add_live_set(information.c_name)
    }
    emit_class_prototypes(information)
    emit_class_support(information)
    assert not information.is_instantiated
    var function_index = 0
    while function_index < information.declared_functions.count() {
        var emitted_function = information.declared_functions[function_index]
        if not skips_generic(information, emitted_function) or builder.mentions(emitted_function.c_name) {
            emit_user_function(information, emitted_function)
        }
        function_index = function_index + 1
    }
}

func emit_value_class(information: Analysis.ClassInfo) {
    var declares_only_memory = information.fields.count() == 1 and information.fields[0].name == "_memory"
    if information.qualified_dotted != "String" and not information.fields.is_empty() and not declares_only_memory {
        current_path = information.source_path
        report(
            "'{information.simple_name}' is a value the compiler keeps in one piece of memory, so it declares only its size, 'var _memory = Memory.Bytes(bytes)': keep what a function needs in its locals",
        )
        return
    }
    var function_index = 0
    while function_index < information.declared_functions.count() {
        var declared = information.declared_functions[function_index]
        if not is_inline_supplied(declared) {
            builder.add_prototype("{function_signature(information, declared)};")
        }
        function_index = function_index + 1
    }
    function_index = 0
    while function_index < information.declared_functions.count() {
        emit_user_function(information, information.declared_functions[function_index])
        function_index = function_index + 1
    }
    if information.c_name == "SpiteString" {
        emit_string_support(information)
    }
}

func string_storage_body(information: Analysis.ClassInfo, name: String): String {
    if information.c_name == "SpiteString" and name == "sum" {
        return "SpiteString pieces[2] = \{ self, other_ };\nSpiteString joined = spite_string_join(2, pieces);\nSpiteString___release(other_);\nreturn joined;"
    }
    if information.qualified_dotted == "Memory.Address" and name == "text" {
        return "return spite_string_from_bytes((const char*)(intptr_t)self, length_);"
    }
    if information.c_name == "SpiteString" and name == "code_at" {
        return "#define SpiteString_code_at(self, index) spite_string_code_at(&(self), (index))"
    }
    return ""
}

func emit_string_support(information: Analysis.ClassInfo) {
    current_path = information.source_path
    current_owner = "String"
    current_function = ""
    var class_id = information.class_id
    var registered = debug_registration("block", class_id)
    var freed = "SPITE_FREE(block);"
    builder.add_prototype("SpiteString SpiteString___retain(SpiteString self);")
    builder.add_prototype("void SpiteString___release(SpiteString self);")
    builder.add_prototype("SpiteString SpiteString_append(SpiteString left, SpiteString right);")
    builder.add_prototype("SpiteString spite_string_from_bytes(const char* bytes, int64_t length);")
    builder.add_prototype("SpiteString spite_string_from_cstring_owned(const char* text);")
    builder.add_prototype("SpiteString spite_string_join(int32_t count, const SpiteString* pieces);")
    builder.add_prototype("static int64_t spite_long_digits(char* digits, int64_t value);")
    builder.add_prototype("static SpiteStringBlock* spite_string_block(int64_t length);")
    builder.add_prototype("static SpiteString spite_string_held(SpiteStringBlock* block, int64_t length);")
    builder.add_support(
        "static int64_t spite_long_digits(char* digits, int64_t value) \{\nchar reversed[24];\nint64_t count = 0;\nuint64_t rest = value < 0 ? (uint64_t)0 - (uint64_t)value : (uint64_t)value;\ndo \{ reversed[count] = (char)('0' + rest % 10); count = count + 1; rest = rest / 10; } while (rest != 0);\nint64_t length = 0;\nif (value < 0) \{ digits[0] = '-'; length = 1; }\nwhile (count > 0) \{ count = count - 1; digits[length] = reversed[count]; length = length + 1; }\nreturn length;\n}",
    )
    builder.add_support(
        "static SpiteStringBlock* spite_string_block(int64_t length) \{\nsize_t size = ((size_t)length + 17 + 15) & ~(size_t)15;\nSpiteStringBlock* block = (SpiteStringBlock*)SPITE_MALLOC(size);\nblock->header.ref_count = 1;\nblock->header.class_id = {class_id};\n{registered}block->capacity = (int64_t)size - 17;\nreturn block;\n}",
    )
    builder.add_support(
        "static SpiteString spite_string_held(SpiteStringBlock* block, int64_t length) \{\nblock->bytes[length] = 0;\nSpiteString held;\nheld._bytes_ = (int64_t)(intptr_t)block->bytes;\nheld._length_ = length | SPITE_STRING_HEAP;\nreturn held;\n}",
    )
    builder.add_support(
        "SpiteString SpiteString___retain(SpiteString self) \{\nif (SPITE_STRING_IS_HEAP(self)) SPITE_COUNT_UP(SPITE_STRING_BLOCK(self)->header.ref_count);\nreturn self;\n}",
    )
    builder.add_support(
        "void SpiteString___release(SpiteString self) \{\nif (!SPITE_STRING_IS_HEAP(self)) return;\nSpiteStringBlock* block = SPITE_STRING_BLOCK(self);\nif (SPITE_COUNT_DOWN(block->header.ref_count) > 0) return;\n{freed}\n}",
    )
    builder.add_support(
        "SpiteString spite_string_from_bytes(const char* bytes, int64_t length) \{\nif (length <= SPITE_STRING_INLINE) \{\nSpiteString made = \{ 0, 0 };\nif (length > 0) memcpy(&made, bytes, (size_t)length);\n((char*)&made)[15] = (char)(SPITE_STRING_INLINE - length);\nreturn made;\n}\nSpiteStringBlock* block = spite_string_block(length);\nmemcpy(block->bytes, bytes, (size_t)length);\nreturn spite_string_held(block, length);\n}",
    )
    builder.add_support(
        "SpiteString spite_string_from_cstring_owned(const char* text) \{\nreturn spite_string_from_bytes(text, (int64_t)strlen(text));\n}",
    )
    builder.add_support(
        "SpiteString spite_string_join(int32_t count, const SpiteString* pieces) \{\nint64_t total = 0;\nfor (int32_t index = 0; index < count; index++) total += spite_string_length(pieces[index]);\nSpiteString made = \{ 0, 0 };\nSpiteStringBlock* block = 0;\nchar* at = (char*)&made;\nif (total > SPITE_STRING_INLINE) \{ block = spite_string_block(total); at = block->bytes; }\nfor (int32_t index = 0; index < count; index++) \{\nint64_t length = spite_string_length(pieces[index]);\nif (length > 0) memcpy(at, spite_string_bytes(&pieces[index]), (size_t)length);\nat += length;\n}\nif (block != 0) return spite_string_held(block, total);\n((char*)&made)[15] = (char)(SPITE_STRING_INLINE - total);\nreturn made;\n}",
    )
    builder.add_support(
        "SpiteString SpiteString_append(SpiteString left, SpiteString right) \{\nint64_t left_length = spite_string_length(left);\nint64_t right_length = spite_string_length(right);\nint64_t total = left_length + right_length;\nconst char* right_bytes = spite_string_bytes(&right);\nif (SPITE_STRING_IS_INLINE(left) && total <= SPITE_STRING_INLINE) \{\nif (right_length > 0) memcpy((char*)&left + left_length, right_bytes, (size_t)right_length);\n((char*)&left)[15] = (char)(SPITE_STRING_INLINE - total);\nreturn left;\n}\nif (SPITE_STRING_IS_HEAP(left) && left._bytes_ != right._bytes_) \{\nSpiteStringBlock* block = SPITE_STRING_BLOCK(left);\nif (block->header.ref_count == 1) \{\nif (total > block->capacity) \{\nint64_t capacity = block->capacity * 2;\nif (capacity < total) capacity = total;\nsize_t size = ((size_t)capacity + 17 + 15) & ~(size_t)15;\nblock = (SpiteStringBlock*)SPITE_REALLOC(block, size);\n{registered}block->capacity = (int64_t)size - 17;\n}\nmemcpy(block->bytes + left_length, right_bytes, (size_t)right_length);\nreturn spite_string_held(block, total);\n}\n}\nint64_t capacity = left_length * 2;\nif (capacity < total) capacity = total;\nSpiteStringBlock* block = spite_string_block(capacity);\nif (left_length > 0) memcpy(block->bytes, spite_string_bytes(&left), (size_t)left_length);\nif (right_length > 0) memcpy(block->bytes + left_length, right_bytes, (size_t)right_length);\nSpiteString___release(left);\nreturn spite_string_held(block, total);\n}",
    )
}

func declared_memory_bytes(declaration: Syntax.Statements.VariableDeclaration): Integer {
    crash declaration.value
    var allocation = shape.as_call(declaration.value)
    if allocation {
        crash allocation.callee
        var sizing = shape.as_member(allocation.callee)
        if sizing {
            crash sizing.object
            var namespace = shape.as_identifier(sizing.object)
            var names_bytes = false
            if namespace {
                names_bytes = namespace.name == "Memory" and sizing.name == "Bytes"
            }
            if names_bytes and allocation.arguments.count() == 1 {
                var bytes = shape.as_integer_literal(allocation.arguments[0])
                if bytes {
                    return bytes.value
                }
            }
        }
    }
    report(
        "a value states its size as 'var _memory = Memory.Bytes(bytes)', with the bytes written out: the compiler places that memory, and a number's is a register",
    )
    return -1
}

func scalar_c_bytes(c_type: String): Integer {
    if c_type == "int8_t" or c_type == "uint8_t" or c_type == "bool" {
        return 1
    }
    if c_type == "int16_t" or c_type == "uint16_t" {
        return 2
    }
    if c_type == "int32_t" or c_type == "uint32_t" or c_type == "float" {
        return 4
    }
    return 8
}

func check_number_memory() {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if information.is_value_class and information.c_name != "SpiteString" {
            current_path = information.source_path
            current_line = 1
            if not information.memory_path.is_empty() {
                current_path = information.memory_path
                current_line = information.memory_line
            }
            current_owner = information.qualified_dotted
            current_function = "_memory"
            var number_type = value_class_type(information)
            var c_type = c_type_name(number_type)
            var laid_out = scalar_c_bytes(c_type)
            if not information.find_field("_memory") {
                report(
                    "'{information.simple_name}' declares no memory: its file states its size with 'var _memory = Memory.Bytes({laid_out})', the {laid_out} bytes the compiler keeps it in",
                )
            } else if information.memory_bytes >= 0 and information.memory_bytes != laid_out {
                report(
                    "'{information.simple_name}' declares {information.memory_bytes} bytes of memory, and the compiler lays it out as {c_type}, which is {laid_out}",
                )
            }
        }
        index = index + 1
    }
}

func string_layout(): String {
    var string_class = find_class_by_c_name("SpiteString")
    crash string_class
    current_path = string_class.source_path
    current_owner = "String"
    current_function = ""
    if string_class.fields.count() != 2 {
        report(
            "library/string.spite declares the memory a String is, '_bytes: Memory.Address' and '_length: Long', and nothing else: the compiler keeps short text in those sixteen bytes",
        )
    }
    var storage = ["_bytes", "_length"]
    var storage_index = 0
    while storage_index < storage.count() {
        var name = storage[storage_index]
        var field = string_class.find_field(name)
        var declared = ""
        if field {
            var field_type = field.type
            declared = c_type_name(field_type)
        }
        if declared != "int64_t" {
            report(
                "library/string.spite declares the memory a String holds, and needs '_bytes: Memory.Address' (where its characters are) and '_length: Long': '{name}' is missing or has another type",
            )
        }
        storage_index = storage_index + 1
    }
    var lines = [
        "struct SpiteString \{"
        "int64_t _bytes_;"
        "int64_t _length_;"
        "};"
        "typedef struct SpiteStringBlock \{ SpiteHeader header; int64_t capacity; char bytes[]; } SpiteStringBlock;"
        "typedef struct SpiteBox_SpiteString \{ SpiteHeader header; SpiteString value; } SpiteBox_SpiteString;"
        "_Static_assert(sizeof(SpiteString) == 16 && sizeof(SpiteStringBlock) == 16, \"a String is 16 bytes and its block's characters start 16 bytes in\");"
        "#define SPITE_STRING_INLINE 15"
        "#define SPITE_STRING_HEAP ((int64_t)0x4000000000000000)"
        "#define SPITE_STRING_FORM(text) ((uint64_t)(text)._length_ >> 56)"
        "#define SPITE_STRING_IS_INLINE(text) (SPITE_STRING_FORM(text) <= SPITE_STRING_INLINE)"
        "#define SPITE_STRING_IS_HEAP(text) (SPITE_STRING_FORM(text) == 0x40)"
        "#define SPITE_STRING_IS_CONSTANT(text) (SPITE_STRING_FORM(text) == 0x80)"
        "#define SPITE_STRING_BLOCK(text) ((SpiteStringBlock*)(intptr_t)((text)._bytes_ - 16))"
        "#define SPITE_STATIC_STRING(text, length) \{ (int64_t)(intptr_t)(text), (int64_t)(length) | INT64_MIN }"
        "#define SPITE_STRING_NULL ((SpiteString)\{ 0, INT64_MIN })"
        "#define SPITE_STRING_EMPTY ((SpiteString)\{ 0, (int64_t)SPITE_STRING_INLINE << 56 })"
        "#define SPITE_STRING_IS_NULL(text) ((text)._bytes_ == 0 && (text)._length_ == INT64_MIN)"
        "static inline int64_t spite_string_length(SpiteString text) \{"
        "uint64_t form = (uint64_t)text._length_ >> 56;"
        "if (form <= SPITE_STRING_INLINE) return (int64_t)(SPITE_STRING_INLINE - form);"
        "return (int64_t)((uint64_t)text._length_ & 0x00FFFFFFFFFFFFFF);"
        "}"
        "static inline const char* spite_string_bytes(const SpiteString* text) \{"
        "if (SPITE_STRING_IS_INLINE(*text)) return (const char*)text;"
        "return (const char*)(intptr_t)text->_bytes_;"
        "}"
        "static inline int32_t spite_string_code_at(const SpiteString* text, int32_t index) \{"
        "const char* bytes = spite_string_bytes(text);"
        "int32_t length = (int32_t)spite_string_length(*text);"
        "if (index < 0 || index > length) index = length;"
        "return (int32_t)(uint8_t)bytes[index];"
        "}"
    ]
    return lines.join("\n")
}

func written_string_function(name: String): Analysis.FunctionInfo? {
    var string_class = find_class_by_c_name("SpiteString")
    if string_class {
        if string_class.is_value_class {
            return string_class.find_function(name)
        }
    }
    return null
}

func debug_memory_class_name_table(): String {
    var names = List<String>()
    var index = 0
    while index < class_names_by_id.count() {
        names.append("\"{class_names_by_id[index]}\"")
        index = index + 1
    }
    return "\{ {names.join(", ")} }"
}

func is_library_class(information: Analysis.ClassInfo): Boolean {
    return information.source_path.starts_with("library/") or information.source_path.starts_with("launcher/")
}

func waiting_kind(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var owner = information.qualified_dotted
    var name = function.name
    if owner == "Program" and name == "sleep" {
        return "sleep"
    }
    if owner == "ThreadPool" and name == "join" {
        return "yield"
    }
    if owner == "Scheduler" and name == "wait_for" {
        return "join"
    }
    var reads = owner == "Console" and name == "read_line_into"
    var receives = owner == "Socket" and (name == "accept_handle" or name == "receive_into" or name == "first_readable")
    var files = owner == "File" and (name == "read_into" or name == "write_text" or name == "write_from")
    if reads or receives or files {
        return "offload"
    }
    return ""
}

func guards_singleton(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not information.is_singleton or information.is_stateless_singleton or is_library_class(information) {
        return false
    }
    if function.is_constructor or function.name == "drop" or function.body.is_empty() {
        return false
    }
    if not function.lent_element.is_empty() {
        return false
    }
    if is_hot_class(information) {
        return false
    }
    var atomic = atomic_singleton_fields(information)
    if not atomic.is_empty() {
        return false
    }
    return changes_after_construction(information)
}

func atomic_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not information.is_singleton or information.is_stateless_singleton or is_library_class(information) {
        return false
    }
    if function.is_constructor or function.name == "drop" or function.body.is_empty() {
        return false
    }
    if is_hot_class(information) {
        return false
    }
    var atomic = atomic_singleton_fields(information)
    return not atomic.is_empty()
}

func changes_after_construction(information: Analysis.ClassInfo): Boolean {
    if written_from_outside(information) {
        return true
    }
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        if shares_state(field_type) {
            return true
        }
        index = index + 1
    }
    var targets = List<String>()
    index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if not function.is_constructor {
            collect_assigned_roots(function.body, targets)
        }
        index = index + 1
    }
    index = 0
    while index < targets.count() {
        if information.find_field(targets[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func collect_assigned_roots(statements: List<Syntax.Statements.Statement>, roots: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_statement_assigned_roots(statements[index], roots)
        index = index + 1
    }
}

func collect_statement_assigned_roots(statement: Syntax.Statements.Statement, roots: List<String>) {
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            var target_text = operand_text(statement.target)
            var dot = target_text.index_of(".")
            var bracket = target_text.index_of("[")
            var end = target_text.length()
            if dot >= 0 {
                end = dot
            }
            if bracket >= 0 and bracket < end {
                end = bracket
            }
            var root = target_text.slice(0, end)
            roots.append(root)
        }
        Syntax.Statements.IfStatement: {
            collect_assigned_roots(statement.then_branch, roots)
            collect_assigned_roots(statement.else_branch, roots)
        }
        Syntax.Statements.WhileStatement: collect_assigned_roots(statement.body, roots)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_assigned_roots(statement.cases[case_index].body, roots)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func finish_guard_count() {
    if parallel_used and guard_count_asked {
        builder.add_typedef("static SPITE_THREAD_LOCAL int32_t spite_guards_held = 0;")
        builder.add_typedef("#define SPITE_GUARDS_HELD() spite_guards_held")
        builder.add_typedef("#define SPITE_GUARDS_COUNT(change) (spite_guards_held = spite_guards_held + (change))")
        return
    }
    builder.add_typedef("#define SPITE_GUARDS_HELD() 0")
    builder.add_typedef("#define SPITE_GUARDS_COUNT(change) ((void)0)")
}

func finish_singleton_guards() {
    builder.add_typedef("typedef struct SpiteGuard \{ _Alignas(64) int64_t owner; int64_t depth; } SpiteGuard;")
    builder.add_prototype("static void spite_spin_pause(void);")
    builder.add_prototype("static void spite_guard_wait(SpiteGuard* guard, int64_t spite_me);")
    builder.add_prototype("static void spite_guard_enter(SpiteGuard* guard);")
    builder.add_prototype("static void spite_guard_leave(SpiteGuard* guard);")
    builder.add_support(
        "static inline void spite_spin_pause(void) \{\n#if defined(__x86_64__) || defined(__i386__)\n__builtin_ia32_pause();\n#elif defined(__aarch64__) || defined(__arm__)\n__asm__ __volatile__(\"yield\");\n#endif\n}",
    )
    builder.add_support(
        "static void spite_guard_wait(SpiteGuard* guard, int64_t spite_me) \{\nint32_t spite_backoff = 1;\nfor (;;) \{\nfor (int32_t spite_spin = 0; spite_spin < spite_backoff; spite_spin = spite_spin + 1) spite_spin_pause();\nif (spite_backoff < 1024) \{\nspite_backoff = spite_backoff * 2;\n} else \{\n#ifdef _WIN32\nSwitchToThread();\n#else\nextern int sched_yield(void);\nsched_yield();\n#endif\n}\nint64_t spite_free = 0;\nif (__atomic_load_n(&guard->owner, __ATOMIC_RELAXED) == 0 && __atomic_compare_exchange_n(&guard->owner, &spite_free, spite_me, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;\n}\n}",
    )
    builder.add_support(
        "static SPITE_THREAD_LOCAL char spite_guard_thread;\nstatic void spite_guard_enter(SpiteGuard* guard) \{\nint64_t spite_me = (int64_t)(intptr_t)&spite_guard_thread;\nif (__atomic_load_n(&guard->owner, __ATOMIC_ACQUIRE) == spite_me) \{ guard->depth = guard->depth + 1; return; }\nint64_t spite_free = 0;\nif (!__atomic_compare_exchange_n(&guard->owner, &spite_free, spite_me, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) spite_guard_wait(guard, spite_me);\nguard->depth = 1;\n}\nstatic void spite_guard_leave(SpiteGuard* guard) \{\nguard->depth = guard->depth - 1;\nif (guard->depth == 0) __atomic_store_n(&guard->owner, 0, __ATOMIC_RELEASE);\n}",
    )
    var guarded_names = List<String>()
    var wrapped = List<Integer>()
    var reached = call_effects.thread_reached_classes()
    var touching = state_touching_functions()
    var index = 0
    while index < guarded_functions.count() {
        crash guarded_classes[index]
        var information = guarded_classes[index]
        var function = guarded_functions[index]
        var threaded = reached.has(information.qualified_dotted) or called_implicitly(information)
        if threaded and touching.has(function.c_name) {
            wrapped.append(index)
        }
        index = index + 1
    }
    find_reading_functions(wrapped)
    index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        crash guarded_classes[position]
        crash guarded_functions[position]
        var information = guarded_classes[position]
        var function = guarded_functions[position]
        if not guarded_names.contains(information.c_name) {
            guarded_names.append(information.c_name)
            builder.add_support("static SpiteGuard {information.c_name}___guard = \{ 0, 0 };")
            if read_guarded_names.contains(information.c_name) {
                builder.add_support("static SpiteReaders {information.c_name}___readers[SPITE_READER_SLOTS];")
            }
        }
        var unguarded_name = "{function.c_name}___unguarded"
        var unguarded_signature = named_signature(information, function, unguarded_name)
        crash guarded_positions[position]
        var guarded_at = guarded_positions[position]
        builder.replace_user(guarded_at, "{unguarded_signature} \{")
        builder.add_prototype("{unguarded_signature};")
        emit_guard_wrapper(information, function, unguarded_name)
        report_endless_locked_loop(information, function)
        index = index + 1
    }
    emitted_guards = guarded_names
    call_unguarded_inside(wrapped)
    report_locked_waits(wrapped)
}

func find_reading_functions(wrapped: List<Integer>) {
    var reached = call_effects.thread_reached_functions()
    var written_on_threads = List<String>()
    var readers = List<String>()
    var index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        crash guarded_classes[position]
        crash guarded_functions[position]
        var information = guarded_classes[position]
        var function = guarded_functions[position]
        var visiting = List<String>()
        if reads_only(information, function, visiting) {
            if not readers.contains(information.c_name) {
                readers.append(information.c_name)
            }
        } else if thread_reaches(information, function.name, reached) {
            written_on_threads.append(information.c_name)
        }
        index = index + 1
    }
    index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        crash guarded_classes[position]
        crash guarded_functions[position]
        var information = guarded_classes[position]
        var function = guarded_functions[position]
        var name = information.c_name
        var shared = readers.contains(name) and not written_on_threads.contains(name)
        if shared and not call_effects.writes_from_reached(information.qualified_dotted, reached) {
            var visiting = List<String>()
            if reads_only(information, function, visiting) {
                reading_function_names[function.c_name] = true
            }
            if not read_guarded_names.contains(name) {
                read_guarded_names.append(name)
            }
        }
        index = index + 1
    }
    assert not read_guarded_names.is_empty()
    builder.add_typedef("#define SPITE_READER_SLOTS 32")
    builder.add_typedef("typedef struct SpiteReaders \{ _Alignas(64) int64_t count; } SpiteReaders;")
    builder.add_prototype("static int64_t* spite_read_enter(SpiteGuard* guard, SpiteReaders* readers);")
    builder.add_prototype("static void spite_read_leave(int64_t* slot);")
    builder.add_prototype("static void spite_guard_enter_writing(SpiteGuard* guard, SpiteReaders* readers);")
    builder.add_support(
        "static SPITE_THREAD_LOCAL int32_t spite_reader_index = -1;\nstatic int32_t spite_reader_next = 0;\nstatic int64_t* spite_read_enter(SpiteGuard* guard, SpiteReaders* readers) \{\nint64_t spite_me = (int64_t)(intptr_t)&spite_guard_thread;\nif (__atomic_load_n(&guard->owner, __ATOMIC_ACQUIRE) == spite_me) return 0;\nif (spite_reader_index < 0) spite_reader_index = __atomic_fetch_add(&spite_reader_next, 1, __ATOMIC_RELAXED) % SPITE_READER_SLOTS;\nint64_t* spite_slot = &readers[spite_reader_index].count;\nfor (;;) \{\n__atomic_fetch_add(spite_slot, 1, __ATOMIC_SEQ_CST);\nif (__atomic_load_n(&guard->owner, __ATOMIC_SEQ_CST) == 0) return spite_slot;\n__atomic_fetch_sub(spite_slot, 1, __ATOMIC_SEQ_CST);\nwhile (__atomic_load_n(&guard->owner, __ATOMIC_RELAXED) != 0) spite_spin_pause();\n}\n}\nstatic void spite_read_leave(int64_t* slot) \{\nif (slot != 0) __atomic_fetch_sub(slot, 1, __ATOMIC_RELEASE);\n}\nstatic void spite_guard_enter_writing(SpiteGuard* guard, SpiteReaders* readers) \{\nspite_guard_enter(guard);\nif (guard->depth != 1) return;\n__atomic_thread_fence(__ATOMIC_SEQ_CST);\nfor (int32_t spite_index = 0; spite_index < SPITE_READER_SLOTS; spite_index++) \{\nwhile (__atomic_load_n(&readers[spite_index].count, __ATOMIC_SEQ_CST) != 0) spite_spin_pause();\n}\n}",
    )
}

func thread_reaches(information: Analysis.ClassInfo, name: String, reached: Dictionary<String, Boolean>): Boolean {
    return reached.has("{information.qualified_dotted}#{name}") or reached.has("*#{name}")
}

func reads_only(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, visiting: List<String>): Boolean {
    var key = "{information.c_name}.{function.name}"
    if visiting.contains(key) {
        return true
    }
    visiting.append(key)
    if function.is_constructor or function.name == "drop" {
        return false
    }
    var locals = List<String>()
    return block_reads_only(function.body, information, function, locals, visiting)
}

func block_reads_only(
    statements: List<Syntax.Statements.Statement>,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
    visiting: List<String>,
): Boolean {
    var index = 0
    while index < statements.count() {
        if not statement_reads_only(statements[index], information, function, locals, visiting) {
            return false
        }
        index = index + 1
    }
    return true
}

func statement_reads_only(
    statement: Syntax.Statements.Statement,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
    visiting: List<String>,
): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            if statement.type_reference {
                return false
            }
            if plain_operand(statement.value, information, function, locals) {
                locals.append("={statement.name}")
            }
            locals.append(statement.name)
            return expression_reads_only(statement.value, information, function, locals, visiting)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var target = shape.as_identifier(statement.target)
            if not target {
                return false
            }
            if not locals.contains(target.name) {
                return false
            }
            var stays_plain = plain_operand(statement.value, information, function, locals)
            if not stays_plain and locals.contains("={target.name}") {
                return false
            }
            return expression_reads_only(statement.value, information, function, locals, visiting)
        }
        Syntax.Statements.IfStatement: {
            if not optional_reads_only(statement.condition, information, function, locals, visiting) {
                return false
            }
            if not block_reads_only(statement.then_branch, information, function, locals, visiting) {
                return false
            }
            return block_reads_only(statement.else_branch, information, function, locals, visiting)
        }
        Syntax.Statements.WhileStatement: {
            if not optional_reads_only(statement.condition, information, function, locals, visiting) {
                return false
            }
            return block_reads_only(statement.body, information, function, locals, visiting)
        }
        Syntax.Statements.ReturnStatement: {
            if not statement.value {
                return false
            }
            return optional_reads_only(statement.value, information, function, locals, visiting)
        }
        Syntax.Statements.AssertStatement: return optional_reads_only(statement.value, information, function, locals, visiting)
        Syntax.Statements.ExpressionStatement: return optional_reads_only(statement.value, information, function, locals, visiting)
        _: return false
    }
}

func optional_reads_only(
    expression: Syntax.Expressions.Expression?,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
    visiting: List<String>,
): Boolean {
    if not expression {
        return false
    }
    return expression_reads_only(expression, information, function, locals, visiting)
}

func expression_reads_only(
    expression: Syntax.Expressions.Expression,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
    visiting: List<String>,
): Boolean {
    switch expression {
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.NullLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        Syntax.Expressions.StringLiteralExpression: return expression.value.index_of("\{") < 0
        Syntax.Expressions.IdentifierExpression: return true
        Syntax.Expressions.BinaryExpression: {
            if not operators_are_pure() {
                if not plain_operand(expression, information, function, locals) {
                    return false
                }
            }
            if not optional_reads_only(expression.left, information, function, locals, visiting) {
                return false
            }
            return optional_reads_only(expression.right, information, function, locals, visiting)
        }
        Syntax.Expressions.UnaryExpression: {
            if not operators_are_pure() {
                if not plain_operand(expression, information, function, locals) {
                    return false
                }
            }
            return optional_reads_only(expression.operand, information, function, locals, visiting)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            var listed = shape.as_identifier(expression.object)
            if not listed {
                return false
            }
            var listed_type = reading_type_of(listed.name, information, function, locals)
            if not listed_type {
                return false
            }
            if not type_shape.as_list(listed_type) and not type_shape.as_dictionary(listed_type) {
                return false
            }
            return optional_reads_only(expression.index, information, function, locals, visiting)
        }
        Syntax.Expressions.MemberExpression: return member_reads_only(expression, information, function, locals)
        Syntax.Expressions.CallExpression: return call_reads_only(expression, information, function, locals, visiting)
        _: return false
    }
}

func reading_type_of(
    name: String,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
): Analysis.SpiteType? {
    assert not locals.contains(name)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name {
            return parameter.type
        }
        index = index + 1
    }
    var field = information.find_field(name)
    assert field
    return field.type
}

func member_reads_only(
    member: Syntax.Expressions.MemberExpression,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
): Boolean {
    crash member.object
    var holder = shape.as_identifier(member.object)
    if not holder {
        return false
    }
    var holder_type = reading_type_of(holder.name, information, function, locals)
    if not holder_type {
        return false
    }
    var held = class_behind(holder_type)
    if not held {
        return false
    }
    if not held.find_field(member.name) or held.find_function("get_{member.name}") {
        return false
    }
    return true
}

func call_reads_only(
    call: Syntax.Expressions.CallExpression,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
    visiting: List<String>,
): Boolean {
    var index = 0
    while index < call.arguments.count() {
        if not expression_reads_only(call.arguments[index], information, function, locals, visiting) {
            return false
        }
        index = index + 1
    }
    crash call.callee
    var own = shape.as_identifier(call.callee)
    if own {
        var called = information.find_function(own.name)
        if not called {
            return false
        }
        return reads_only(information, called, visiting)
    }
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    if member.name.starts_with("write_") or member.name == "copy_to" or member.name == "exchange_long" {
        return false
    }
    crash member.object
    var receiver = shape.as_identifier(member.object)
    if not receiver {
        return false
    }
    var receiver_type = reading_type_of(receiver.name, information, function, locals)
    if not receiver_type {
        return false
    }
    if type_shape.as_scalar(receiver_type) or type_shape.as_string(receiver_type) {
        return true
    }
    if type_shape.as_list(receiver_type) or type_shape.as_dictionary(receiver_type) {
        var reading = [
            "count"
            "get_at"
            "has"
            "is_empty"
            "first"
            "last"
            "contains"
            "index_of"
            "keys"
            "values"
            "join"
            "copy"
        ]
        return reading.contains(member.name)
    }
    var held = class_behind(receiver_type)
    if not held {
        return false
    }
    var memory = held.qualified_dotted == "TypedMemory" or held.qualified_dotted == "InlineMemory"
    if memory {
        var reading = ["read_value", "value_bytes", "value_bits", "item_at", "item_bytes", "item_start"]
        return reading.contains(member.name)
    }
    if not held.is_singleton or not held.is_stateless_singleton or is_library_class(held) {
        return false
    }
    var called = held.find_function(member.name)
    if not called {
        return false
    }
    return reads_only(held, called, visiting)
}

func plain_operand(
    expression: Syntax.Expressions.Expression,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locals: List<String>,
): Boolean {
    switch expression {
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.IdentifierExpression: {
            if locals.contains(expression.name) {
                return locals.contains("={expression.name}")
            }
            var named_type = reading_type_of(expression.name, information, function, locals)
            if not named_type {
                return false
            }
            var scalar = type_shape.as_scalar(named_type)
            if not scalar {
                return false
            }
            return true
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if not plain_operand(expression.left, information, function, locals) {
                return false
            }
            return plain_operand(expression.right, information, function, locals)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return plain_operand(expression.operand, information, function, locals)
        }
        _: return false
    }
}

func operators_are_pure(): Boolean {
    if not pure_operators_known {
        pure_operators_known = true
        pure_operators = no_operator_functions()
    }
    return pure_operators
}

func no_operator_functions(): Boolean {
    var operators = [
        "sum"
        "subtract"
        "multiply"
        "divide"
        "remainder"
        "equals"
        "less_than"
        "greater_than"
        "negate"
    ]
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if not is_library_class(information) and not information.is_value_class {
            var operator_index = 0
            while operator_index < operators.count() {
                if information.find_function(operators[operator_index]) {
                    return false
                }
                operator_index = operator_index + 1
            }
        }
        index = index + 1
    }
    return true
}

func state_touching_functions(): Dictionary<String, Boolean> {
    var touching = Dictionary<String, Boolean>()
    var own_names = Dictionary<String, Boolean>()
    var index = 0
    while index < guarded_functions.count() {
        var function = guarded_functions[index]
        own_names[function.c_name] = true
        index = index + 1
    }
    touch_callers.clear()
    touch_callees.clear()
    index = 0
    while index < guarded_functions.count() {
        crash guarded_classes[index]
        crash guarded_positions[index]
        crash guarded_ends[index]
        var information = guarded_classes[index]
        var function = guarded_functions[index]
        var line_index = guarded_positions[index] + 1
        var end = guarded_ends[index]
        var changing = changing_field_codes(information)
        var touches = call_effects.calls_back_into(information.qualified_dotted, function.name)
        while line_index < end and not touches {
            var line = builder.user_at(line_index)
            touches = line_touches_state(line, information, changing, function.c_name, own_names)
            line_index = line_index + 1
        }
        if touches {
            touching[function.c_name] = true
        }
        index = index + 1
    }
    spread_touches(touching)
    return touching
}

func spread_touches(touching: Dictionary<String, Boolean>) {
    var spreading = true
    while spreading {
        spreading = false
        var pair = 0
        while pair < touch_callers.count() {
            crash touch_callees[pair]
            var caller = touch_callers[pair]
            var callee = touch_callees[pair]
            if touching.has(callee) and not touching.has(caller) {
                touching[caller] = true
                spreading = true
            }
            pair = pair + 1
        }
    }
}

func changing_field_codes(information: Analysis.ClassInfo): List<String> {
    var assigned = List<String>()
    var index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if not function.is_constructor {
            collect_assigned_roots(function.body, assigned)
        }
        index = index + 1
    }
    var outside = call_effects.writes_from_outside(information.qualified_dotted)
    var codes = List<String>()
    index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var written = assigned.contains(field.name) or outside.contains(field.name)
        if written or shares_state(field_type) {
            var field_code = c_value_name(field.name)
            codes.append(field_code)
        }
        index = index + 1
    }
    return codes
}

func line_touches_state(
    line: String,
    information: Analysis.ClassInfo,
    changing: List<String>,
    caller: String,
    own_names: Dictionary<String, Boolean>,
): Boolean {
    if line.contains("spite_singleton_{information.c_name}") {
        return true
    }
    var pieces = line.split("self")
    var index = 1
    while index < pieces.count() {
        crash pieces[index - 1]
        var before = pieces[index - 1]
        var after = pieces[index]
        var whole = not ends_in_name(before) and not starts_with_name(after)
        if whole and self_touches(before, after, changing, caller, own_names) {
            return true
        }
        index = index + 1
    }
    return false
}

func self_touches(
    before: String,
    after: String,
    changing: List<String>,
    caller: String,
    own_names: Dictionary<String, Boolean>,
): Boolean {
    if after.starts_with("->") {
        var after_length = after.length()
        var field_text = after.slice(2, after_length)
        var field_code = leading_name(field_text)
        return changing.contains(field_code)
    }
    if before.ends_with("(void)") {
        return false
    }
    if not before.ends_with("(") {
        return true
    }
    var before_length = before.length()
    var called_text = before.slice(0, before_length - 1)
    var called = trailing_name(called_text)
    if not own_names.has(called) {
        return true
    }
    touch_callers.append(caller)
    touch_callees.append(called)
    return false
}

func ends_in_name(text: String): Boolean {
    var text_length = text.length()
    if text_length == 0 {
        return false
    }
    var last = text.code_at(text_length - 1)
    return is_c_name_code(last)
}

func starts_with_name(text: String): Boolean {
    if text.is_empty() {
        return false
    }
    var first = text.code_at(0)
    return is_c_name_code(first)
}

func leading_name(text: String): String {
    var text_length = text.length()
    var end = 0
    var inside = true
    while end < text_length and inside {
        var code = text.code_at(end)
        inside = is_c_name_code(code)
        if inside {
            end = end + 1
        }
    }
    return text.slice(0, end)
}

func trailing_name(text: String): String {
    var start = text.length()
    var inside = true
    while start > 0 and inside {
        var code = text.code_at(start - 1)
        inside = is_c_name_code(code)
        if inside {
            start = start - 1
        }
    }
    var text_length = text.length()
    return text.slice(start, text_length)
}

func is_c_name_code(code: Integer): Boolean {
    return code >= 97 and code <= 122 or code >= 65 and code <= 90 or code >= 48 and code <= 57 or code == 95
}

func report_endless_locked_loop(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var line = endless_loop_line(function.body)
    assert line > 0
    current_path = information.source_path
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    current_owner = information.qualified_dotted
    current_function = function.name
    current_line = line
    report(
        "'{information.simple_name}.{function.name}' holds {information.simple_name}'s lock for the whole call, since a Parallel reaches {information.simple_name}, and this loop never ends, so every other call on {information.simple_name} would wait forever: move the loop into a class that is not a singleton, and call {information.simple_name} from it",
    )
}

func report_locked_waits(wrapped: List<Integer>) {
    var locked_keys = Dictionary<String, String>()
    var index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        crash guarded_classes[position]
        crash guarded_functions[position]
        var information = guarded_classes[position]
        var function = guarded_functions[position]
        wrapped_function_names[function.c_name] = true
        if not is_instantiated_class(information) {
            locked_keys["{information.qualified_dotted}#{function.name}"] = information.qualified_dotted
        }
        index = index + 1
    }
    index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        crash guarded_classes[position]
        crash guarded_functions[position]
        var information = guarded_classes[position]
        var function = guarded_functions[position]
        if not is_instantiated_class(information) {
            report_waits_in(function.body, function.body, information, function, locked_keys)
        }
        index = index + 1
    }
}

func report_waits_in(
    statements: List<Syntax.Statements.Statement>,
    whole: List<Syntax.Statements.Statement>,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locked_keys: Dictionary<String, String>,
) {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        var declared = shape.as_variable_declaration(statement)
        if declared {
            report_joined_parallel(declared, whole, information, function, locked_keys)
        }
        var returned = shape.as_return_statement(statement)
        if returned {
            report_returned_parallel(returned, information, function, locked_keys)
        }
        var branched = shape.as_if_statement(statement)
        if branched {
            report_waits_in(branched.then_branch, whole, information, function, locked_keys)
            report_waits_in(branched.else_branch, whole, information, function, locked_keys)
        }
        var looped = shape.as_while_statement(statement)
        if looped {
            report_waits_in(looped.body, whole, information, function, locked_keys)
        }
        index = index + 1
    }
}

func report_joined_parallel(
    declared: Syntax.Statements.VariableDeclaration,
    whole: List<Syntax.Statements.Statement>,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locked_keys: Dictionary<String, String>,
) {
    crash declared.value
    var called = shape.as_call(declared.value)
    assert called
    assert called.arguments.count() == 1
    crash called.callee
    var starter = shape.as_identifier(called.callee)
    assert starter
    assert starter.name == "Parallel"
    returned_handle_escapes = returns_task_handle(function.return_type)
    var escapes = handle_escapes(declared.name, whole)
    returned_handle_escapes = true
    assert not escapes
    report_locked_join(declared.line, information, function, locked_keys)
}

func report_returned_parallel(
    returned: Syntax.Statements.ReturnStatement,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locked_keys: Dictionary<String, String>,
) {
    assert returned.value
    var called = shape.as_call(returned.value)
    assert called
    assert called.arguments.count() == 1
    crash called.callee
    var starter = shape.as_identifier(called.callee)
    assert starter
    var handed_on = returns_task_handle(function.return_type)
    assert starter.name == "Parallel" and not handed_on
    report_locked_join(returned.line, information, function, locked_keys)
}

func report_locked_join(
    line: Integer,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    locked_keys: Dictionary<String, String>,
) {
    var site = parallel_site_at(line, information, function)
    assert site >= 0
    crash parallel_site_keys[site]
    var work_key = parallel_site_keys[site]
    var entries = [work_key]
    var reached = call_effects.reached_functions(entries)
    var reached_keys = reached.keys()
    var index = 0
    while index < reached_keys.count() {
        var key = reached_keys[index]
        if locked_keys[key] {
            if locked_keys[key] == information.qualified_dotted {
                report_locked_wait(line, information, function, site, key)
                return
            }
        }
        index = index + 1
    }
}

func returns_task_handle(return_type: Analysis.SpiteType): Boolean {
    var inner = return_type
    var nullable = type_shape.as_nullable(return_type)
    if nullable {
        inner = nullable.inner
    }
    var class_ref = type_shape.as_class_ref(inner)
    if not class_ref {
        return false
    }
    var returned = find_class_by_c_name(class_ref.c_name)
    if not returned {
        return false
    }
    return returned.qualified_dotted == "Parallel" or returned.qualified_dotted == "Concurrent"
}

func parallel_site_at(line: Integer, information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Integer {
    var index = 0
    while index < parallel_site_places.count() {
        var site_place = parallel_site_places[index]
        var place = site_place.split("\n")
        var same_line = place[1] == line.to_string()
        if same_line and place[2] == information.qualified_dotted and place[3] == function.name {
            return index
        }
        index = index + 1
    }
    return -1
}

func report_locked_wait(
    line: Integer,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    site: Integer,
    key: String,
) {
    crash parallel_site_places[site]
    crash parallel_site_texts[site]
    var site_place = parallel_site_places[site]
    var place = site_place.split("\n")
    crash place[0]
    current_path = place[0]
    current_line = line
    current_owner = information.qualified_dotted
    current_function = function.name
    var work_text = parallel_site_texts[site]
    var hash = key.index_of("#")
    var key_length = key.length()
    var locked_name = key.slice(hash + 1, key_length)
    var name = information.simple_name
    report(
        "'{name}.{function.name}' waits for 'Parallel({work_text})' while it holds {name}'s lock, since a Parallel reaches {name}, and what '{work_text}' runs calls '{name}.{locked_name}', which takes that lock: each would wait for the other forever. Wait for the Parallel outside {name}'s functions, or do not call {name} from its work",
    )
}

func handle_escapes(name: String, statements: List<Syntax.Statements.Statement>): Boolean {
    var index = 0
    while index < statements.count() {
        if statement_hands_on(statements[index], name) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_hands_on(statement: Syntax.Statements.Statement, name: String): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: return optional_hands_on(statement.value, name)
        Syntax.Statements.AssignmentStatement: {
            if names_identifier(statement.value, name) {
                return true
            }
            return optional_hands_on(statement.value, name)
        }
        Syntax.Statements.ReturnStatement: {
            if names_identifier(statement.value, name) {
                return returned_handle_escapes
            }
            return optional_hands_on(statement.value, name)
        }
        Syntax.Statements.ExpressionStatement: return optional_hands_on(statement.value, name)
        Syntax.Statements.IfStatement: {
            if optional_hands_on(statement.condition, name) {
                return true
            }
            if handle_escapes(name, statement.then_branch) {
                return true
            }
            return handle_escapes(name, statement.else_branch)
        }
        Syntax.Statements.WhileStatement: {
            if optional_hands_on(statement.condition, name) {
                return true
            }
            return handle_escapes(name, statement.body)
        }
        Syntax.Statements.SwitchStatement: return true
        _: return false
    }
}

func names_identifier(expression: Syntax.Expressions.Expression?, name: String): Boolean {
    if not expression {
        return false
    }
    var identifier = shape.as_identifier(expression)
    if not identifier {
        return false
    }
    return identifier.name == name
}

func optional_hands_on(expression: Syntax.Expressions.Expression?, name: String): Boolean {
    if not expression {
        return false
    }
    return expression_hands_on(expression, name)
}

func expression_hands_on(expression: Syntax.Expressions.Expression, name: String): Boolean {
    switch expression {
        Syntax.Expressions.CallExpression: {
            if arguments_hand_on(expression.arguments, name) {
                return true
            }
            return optional_hands_on(expression.callee, name)
        }
        Syntax.Expressions.GenericCallExpression: return arguments_hand_on(expression.arguments, name)
        Syntax.Expressions.BinaryExpression: {
            if optional_hands_on(expression.left, name) {
                return true
            }
            return optional_hands_on(expression.right, name)
        }
        Syntax.Expressions.UnaryExpression: return optional_hands_on(expression.operand, name)
        Syntax.Expressions.MemberExpression: return optional_hands_on(expression.object, name)
        Syntax.Expressions.IndexExpression: {
            if optional_hands_on(expression.object, name) {
                return true
            }
            return optional_hands_on(expression.index, name)
        }
        Syntax.Expressions.ListLiteralExpression: return true
        Syntax.Expressions.ObjectLiteralExpression: return true
        _: return false
    }
}

func arguments_hand_on(arguments: List<Syntax.Expressions.Expression>, name: String): Boolean {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        if names_identifier(argument, name) {
            return true
        }
        if expression_hands_on(argument, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func endless_loop_line(statements: List<Syntax.Statements.Statement>): Integer {
    var index = 0
    while index < statements.count() {
        var line = statement_endless_loop_line(statements[index])
        if line > 0 {
            return line
        }
        index = index + 1
    }
    return 0
}

func statement_endless_loop_line(statement: Syntax.Statements.Statement): Integer {
    switch statement {
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            if shape.is_true_literal(statement.condition) and not can_leave(statement.body) {
                return statement.line
            }
            return endless_loop_line(statement.body)
        }
        Syntax.Statements.IfStatement: {
            var then_line = endless_loop_line(statement.then_branch)
            if then_line > 0 {
                return then_line
            }
            return endless_loop_line(statement.else_branch)
        }
        _: return 0
    }
}

func report_falling_end(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var return_type = function.return_type
    assert not type_shape.is_void(return_type)
    var path = falling_path(function.body)
    assert path
    current_line = function.end_line
    if current_line == 0 {
        current_line = function.line
    }
    var place = "{current_path}:{current_line}"
    assert not falling_ends.contains(place)
    falling_ends.append(place)
    var answered = type_with_article(return_type)
    var unwritten = answered
    if type_shape.as_nullable(return_type) {
        unwritten = "a null"
    }
    var reaches = "it reaches its end without a 'return'"
    var ending = "end it with 'return <value>', or with 'crash' if it cannot get there"
    if not path.is_empty() {
        reaches = "{path} it reaches its end without a 'return'"
        ending = "end that path with 'return <value>', or with 'crash' if it cannot happen"
    }
    report(
        "'{function.name}' answers {answered}{instance_description(information)}, but {reaches}, so a caller would get {unwritten} nobody wrote: {ending}",
    )
}

func falling_path(statements: List<Syntax.Statements.Statement>): String? {
    assert statements.all(statement_can_finish)
    var last = statements.last()
    var path = ""
    if last {
        return statement_falling_path(last)
    }
    return path
}

func statement_can_finish(statement: Syntax.Statements.Statement): Boolean {
    var path = statement_falling_path(statement)
    var finishes = false
    if path {
        finishes = true
    }
    return finishes
}

func statement_falling_path(statement: Syntax.Statements.Statement): String? {
    assert not left_the_function(statement)
    var path = ""
    switch statement {
        Syntax.Statements.ReturnStatement: return null
        Syntax.Statements.AssertStatement: {
            if statement.is_crash {
                assert statement.value and not shape.is_false_literal(statement.value)
            }
            return path
        }
        Syntax.Statements.IfStatement: return if_falling_path(statement)
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            assert not shape.is_true_literal(statement.condition)
            return "when the 'while' at line {statement.line} ends"
        }
        Syntax.Statements.SwitchStatement: return switch_falling_path(statement)
        _: return path
    }
}

func if_falling_path(if_statement: Syntax.Statements.IfStatement): String? {
    crash if_statement.condition
    var condition = Syntax.SourcePrinter().source_expression(if_statement.condition)
    if not if_statement.has_else_branch {
        return "when '{condition}' is false (line {if_statement.line}, an 'if' with no 'else')"
    }
    var then_path = falling_path(if_statement.then_branch)
    if then_path {
        return path_with_step("when '{condition}' is true (line {if_statement.line})", then_path)
    }
    var else_path = falling_path(if_statement.else_branch)
    assert else_path
    return path_with_step("when '{condition}' is false (line {if_statement.line})", else_path)
}

func switch_falling_path(switch_statement: Syntax.Statements.SwitchStatement): String? {
    var index = 0
    while index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[index]
        var case_path = falling_path(switch_case.body)
        if case_path {
            var step = "in the case {case_label(switch_case)} of the 'switch' at line {switch_statement.line}"
            return path_with_step(step, case_path)
        }
        index = index + 1
    }
    assert switch_statement.cases.is_empty()
    return ""
}

func case_label(switch_case: Syntax.Statements.SwitchCase): String {
    if switch_case.value {
        return Syntax.SourcePrinter().source_expression(switch_case.value)
    }
    crash switch_case.type_reference
    return Syntax.SourcePrinter().source_type(switch_case.type_reference)
}

func path_with_step(step: String, rest: String): String {
    if rest.is_empty() {
        return step
    }
    return "{step}, then {rest}"
}

func left_the_function(statement: Syntax.Statements.Statement): Boolean {
    var index = 0
    while index < leaving_statements.count() {
        var left = leaving_statements[index]
        if left == statement {
            return true
        }
        index = index + 1
    }
    return false
}

func can_leave(statements: List<Syntax.Statements.Statement>): Boolean {
    return statements.any(statement_can_leave)
}

func statement_can_leave(statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.ReturnStatement: return true
        Syntax.Statements.AssertStatement: return true
        Syntax.Statements.IfStatement: return can_leave(statement.then_branch) or can_leave(statement.else_branch)
        Syntax.Statements.WhileStatement: return can_leave(statement.body)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                if can_leave(statement.cases[case_index].body) {
                    return true
                }
                case_index = case_index + 1
            }
            return false
        }
        _: return false
    }
}

func call_unguarded_inside(wrapped: List<Integer>) {
    var index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        crash guarded_classes[position]
        crash guarded_positions[position]
        crash guarded_ends[position]
        var information = guarded_classes[position]
        var line_index = guarded_positions[position] + 1
        var end = guarded_ends[position]
        while line_index < end {
            var line = builder.user_at(line_index)
            var changed = unguarded_calls(line, information, wrapped)
            if changed != line {
                builder.replace_user(line_index, changed)
            }
            line_index = line_index + 1
        }
        index = index + 1
    }
}

func unguarded_calls(line: String, information: Analysis.ClassInfo, wrapped: List<Integer>): String {
    var result = line
    var index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        crash guarded_classes[position]
        var owner = guarded_classes[position]
        if owner.c_name == information.c_name {
            crash guarded_functions[position]
            var called = guarded_functions[position]
            result = replace_call(result, "{called.c_name}(self,", "{called.c_name}___unguarded(self,")
            result = replace_call(result, "{called.c_name}(self)", "{called.c_name}___unguarded(self)")
        }
        index = index + 1
    }
    return result
}

func replace_call(line: String, from: String, to: String): String {
    var pieces = line.split(from)
    crash pieces[0]
    var result = pieces[0]
    var index = 1
    while index < pieces.count() {
        crash pieces[index - 1]
        var before = pieces[index - 1]
        var last_position = before.length() - 1
        var last = before.code_at(last_position)
        var joins_a_name = last >= 97 and last <= 122 or last >= 65 and last <= 90 or last >= 48 and last <= 57 or last == 95
        if not before.is_empty() and joins_a_name {
            result = result + from
        } else {
            result = result + to
        }
        var piece = pieces[index]
        result = result + piece
        index = index + 1
    }
    return result
}

func atomic_singleton_fields(information: Analysis.ClassInfo): List<String> {
    var mutable = List<String>()
    var singleton = information.is_singleton and not information.is_stateless_singleton
    assert singleton and not is_library_class(information) and not is_hot_class(information)
    assert not written_from_outside(information)
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        assert not shares_state(field_type)
        index = index + 1
    }
    var targets = List<String>()
    index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if not function.is_constructor {
            collect_assigned_roots(function.body, targets)
        }
        index = index + 1
    }
    index = 0
    while index < targets.count() {
        var target = targets[index]
        var field = information.find_field(target)
        if field and not mutable.contains(target) {
            var field_type = field.type
            assert is_atomic_capable(field_type)
            mutable.append(target)
        }
        index = index + 1
    }
    index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if not function.is_constructor and function.name != "drop" {
            var visiting = List<String>()
            assert function_state_uses(information, function, mutable, visiting) <= 1
        }
        index = index + 1
    }
    return mutable
}

func lone_atomic_fields(information: Analysis.ClassInfo): List<String> {
    var known = lone_atomic_answers[information.c_name]
    if known {
        return lone_atomic_list(known)
    }
    var names = List<String>()
    var singleton = information.is_singleton and not information.is_stateless_singleton
    var hot = is_hot_class(information) or hot_reload or read_evaluate_print_loop or remote_loop_port != 0
    if singleton and not is_library_class(information) and not hot and atomic_singleton_fields(information).is_empty() {
        var index = 0
        while index < information.fields.count() {
            var field = information.fields[index]
            var field_type = field.type
            if is_atomic_capable(field_type) and written_once_by_every_function(information, field.name) {
                names.append(field.name)
            }
            index = index + 1
        }
    }
    lone_atomic_answers[information.c_name] = ",{names.join(",")}"
    return names
}

func lone_atomic_list(known: String): List<String> {
    var names = List<String>()
    var pieces = known.split(",")
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        if not piece.is_empty() {
            names.append(piece)
        }
        index = index + 1
    }
    return names
}

func written_once_by_every_function(information: Analysis.ClassInfo, name: String): Boolean {
    var index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if not function.is_constructor and function.name != "drop" {
            var visiting = List<String>()
            if function_field_writes(information, function, name, visiting) > 1 {
                return false
            }
        }
        index = index + 1
    }
    return true
}

func function_field_writes(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    name: String,
    visiting: List<String>,
): Integer {
    if visiting.contains(function.name) {
        return 2
    }
    var inner = visiting.copy()
    inner.append(function.name)
    return block_field_writes(function.body, information, name, inner)
}

func block_field_writes(
    statements: List<Syntax.Statements.Statement>,
    information: Analysis.ClassInfo,
    name: String,
    visiting: List<String>,
): Integer {
    var total = 0
    var index = 0
    while index < statements.count() {
        total = total + statement_field_writes(statements[index], information, name, visiting)
        index = index + 1
    }
    return total
}

func statement_field_writes(
    statement: Syntax.Statements.Statement,
    information: Analysis.ClassInfo,
    name: String,
    visiting: List<String>,
): Integer {
    var expressions = List<Syntax.Expressions.Expression>()
    var total = 0
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            var written = operand_text(statement.target)
            if written == name or written == "this.{name}" {
                total = 1
            }
            add_optional_expression(statement.value, expressions)
        }
        Syntax.Statements.IfStatement: {
            add_optional_expression(statement.condition, expressions)
            total = block_field_writes(statement.then_branch, information, name, visiting)
            total = total + block_field_writes(statement.else_branch, information, name, visiting)
        }
        Syntax.Statements.WhileStatement: {
            var looped = List<Syntax.Expressions.Expression>()
            add_optional_expression(statement.condition, looped)
            var inside = block_field_writes(statement.body, information, name, visiting)
            inside = inside + calls_field_writes(looped, information, name, visiting)
            if inside > 0 {
                return 2
            }
            return 0
        }
        Syntax.Statements.SwitchStatement: {
            add_optional_expression(statement.subject, expressions)
            var case_index = 0
            while case_index < statement.cases.count() {
                total = total + block_field_writes(statement.cases[case_index].body, information, name, visiting)
                case_index = case_index + 1
            }
        }
        _: collect_statement_expressions(statement, expressions)
    }
    return total + calls_field_writes(expressions, information, name, visiting)
}

func calls_field_writes(
    expressions: List<Syntax.Expressions.Expression>,
    information: Analysis.ClassInfo,
    name: String,
    visiting: List<String>,
): Integer {
    var calls = List<Syntax.Expressions.Expression>()
    collect_each_expression_call(expressions, calls)
    var total = 0
    var index = 0
    while index < calls.count() {
        var call = shape.as_call(calls[index])
        if call {
            crash call.callee
            var own = shape.as_identifier(call.callee)
            if own {
                var called = information.find_function(own.name)
                if called {
                    total = total + function_field_writes(information, called, name, visiting)
                }
            }
        }
        index = index + 1
    }
    return total
}

func emit_lone_atomic_write(
    target_class: Analysis.ClassInfo,
    target_code: String,
    field_type: Analysis.SpiteType,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var owner = target_class.c_name
    if not atomic_class_names.contains(owner) {
        atomic_class_names.append(owner)
        atomic_classes.append(target_class)
    }
    if not outside_class_names.contains(owner) {
        outside_class_names.append(owner)
        outside_classes.append(target_class)
    }
    var value_code = coerce_for_store(value, field_type, scope, class_information)
    var stored = next_temporary()
    builder.add_user("{c_type_name(field_type)} {stored} = {value_code};")
    builder.add_user("{owner}___outside_enter();")
    builder.add_user("SPITE_SINGLETON_STORE({owner}, {target_code}, {stored});")
    builder.add_user("{owner}___outside_leave();")
}

func is_atomic_capable(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    if not scalar {
        return false
    }
    var kind = scalar.kind
    var signed = kind == 'integer_kind' or kind == 'long_kind' or kind == 'tiny_kind' or kind == 'short_kind'
    var unsigned = kind == 'byte_kind' or kind == 'unsigned_short_kind' or kind == 'unsigned_integer_kind'
    return signed or unsigned or kind == 'unsigned_long_kind' or kind == 'boolean_kind'
}

func function_state_uses(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    if visiting.contains(function.name) {
        return 2
    }
    var names = List<String>()
    collect_declared_names(function.body, names)
    var index = 0
    while index < function.parameters.count() {
        names.append(function.parameters[index].name)
        index = index + 1
    }
    index = 0
    while index < names.count() {
        if mutable.contains(names[index]) {
            return 2
        }
        index = index + 1
    }
    var inner = visiting.copy()
    inner.append(function.name)
    return block_state_uses(function.body, information, mutable, inner)
}

func block_state_uses(
    statements: List<Syntax.Statements.Statement>,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    var total = 0
    var index = 0
    while index < statements.count() {
        var uses = statement_state_uses(statements[index], information, mutable, visiting)
        total = total + uses
        index = index + 1
    }
    return total
}

func statement_state_uses(
    statement: Syntax.Statements.Statement,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    switch statement {
        Syntax.Statements.VariableDeclaration: return optional_state_uses(statement.value, information, mutable, visiting)
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var target = shape.as_identifier(statement.target)
            if target {
                if mutable.contains(target.name) {
                    var stored = stored_value(statement.value, target.name)
                    var value_uses = expression_state_uses(stored, information, mutable, visiting)
                    return 1 + value_uses
                }
            }
            var target_uses = expression_state_uses(statement.target, information, mutable, visiting)
            var assigned_uses = expression_state_uses(statement.value, information, mutable, visiting)
            return target_uses + assigned_uses
        }
        Syntax.Statements.IfStatement: {
            var condition_uses = optional_state_uses(statement.condition, information, mutable, visiting)
            var then_uses = block_state_uses(statement.then_branch, information, mutable, visiting)
            var else_uses = block_state_uses(statement.else_branch, information, mutable, visiting)
            return condition_uses + then_uses + else_uses
        }
        Syntax.Statements.WhileStatement: {
            var condition_uses = optional_state_uses(statement.condition, information, mutable, visiting)
            var body_uses = block_state_uses(statement.body, information, mutable, visiting)
            if condition_uses + body_uses > 0 {
                return 2
            }
            return 0
        }
        Syntax.Statements.SwitchStatement: {
            var total = optional_state_uses(statement.subject, information, mutable, visiting)
            var case_index = 0
            while case_index < statement.cases.count() {
                var case_uses = block_state_uses(statement.cases[case_index].body, information, mutable, visiting)
                total = total + case_uses
                case_index = case_index + 1
            }
            return total
        }
        Syntax.Statements.AssertStatement: return optional_state_uses(statement.value, information, mutable, visiting)
        Syntax.Statements.ReturnStatement: return optional_state_uses(statement.value, information, mutable, visiting)
        Syntax.Statements.ExpressionStatement: return optional_state_uses(statement.value, information, mutable, visiting)
        _: return 0
    }
}

func stored_value(value: Syntax.Expressions.Expression, target: String): Syntax.Expressions.Expression {
    var binary = shape.as_binary(value)
    if binary {
        var counts = binary.operator == 'add' or binary.operator == 'subtract'
        crash binary.left
        crash binary.right
        if counts and is_identifier_named(binary.left, target) {
            return binary.right
        }
    }
    return value
}

func optional_state_uses(
    expression: Syntax.Expressions.Expression?,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    if expression {
        return expression_state_uses(expression, information, mutable, visiting)
    }
    return 0
}

func each_state_uses(
    expressions: List<Syntax.Expressions.Expression>,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    var total = 0
    var index = 0
    while index < expressions.count() {
        var uses = expression_state_uses(expressions[index], information, mutable, visiting)
        total = total + uses
        index = index + 1
    }
    return total
}

func expression_state_uses(
    expression: Syntax.Expressions.Expression,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    switch expression {
        Syntax.Expressions.IdentifierExpression: {
            if expression.name == "this" {
                return 2
            }
            if mutable.contains(expression.name) {
                return 1
            }
            return 0
        }
        Syntax.Expressions.StringLiteralExpression: {
            var index = 0
            while index < mutable.count() {
                if expression.value.contains("\{") and expression.value.contains(mutable[index]) {
                    return 2
                }
                index = index + 1
            }
            return 0
        }
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var argument_uses = each_state_uses(expression.arguments, information, mutable, visiting)
            var own = shape.as_identifier(expression.callee)
            if own {
                var called = information.find_function(own.name)
                if called {
                    var called_uses = function_state_uses(information, called, mutable, visiting)
                    return argument_uses + called_uses
                }
            }
            var callee_uses = expression_state_uses(expression.callee, information, mutable, visiting)
            return argument_uses + callee_uses
        }
        Syntax.Expressions.GenericCallExpression: return each_state_uses(expression.arguments, information, mutable, visiting)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            var left_uses = expression_state_uses(expression.left, information, mutable, visiting)
            var right_uses = expression_state_uses(expression.right, information, mutable, visiting)
            return left_uses + right_uses
        }
        Syntax.Expressions.UnaryExpression: return optional_state_uses(expression.operand, information, mutable, visiting)
        Syntax.Expressions.MemberExpression: return optional_state_uses(expression.object, information, mutable, visiting)
        Syntax.Expressions.IndexExpression: {
            var object_uses = optional_state_uses(expression.object, information, mutable, visiting)
            var index_uses = optional_state_uses(expression.index, information, mutable, visiting)
            return object_uses + index_uses
        }
        Syntax.Expressions.ListLiteralExpression: {
            var total = 0
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                var uses = optional_state_uses(element_value, information, mutable, visiting)
                total = total + uses
                index = index + 1
            }
            return total
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var total = 0
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                var uses = optional_state_uses(field_value, information, mutable, visiting)
                total = total + uses
                index = index + 1
            }
            return total
        }
        _: return 0
    }
}

func checked_singleton_add(
    binary: Syntax.Expressions.BinaryExpression,
    owner: String,
    place: String,
    step: String,
    field_type: Analysis.SpiteType,
): String {
    var scalar = type_shape.as_scalar(field_type)
    crash scalar
    var failure = overflow_failure(scalar.kind)
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = binary
    var source_text = printer.source_expression(expression)
    var operation = escape_c_string(source_text)
    var where = located(current_path, current_line, current_owner, current_function)
    var c_type = c_type_name(field_type)
    var builtin = overflow_builtin(binary.operator)
    var fetch = "__atomic_fetch_add"
    if binary.operator == 'subtract' {
        fetch = "__atomic_fetch_sub"
    }
    var symbol = binary_operator_symbol(binary.operator)
    var field_display = type_display_name(field_type)
    var shown = with_article(field_display)
    var widened = operand_cast(scalar.kind)
    var failed = "{failure}(\"{operation}\", \"{shown}\", \"{symbol}\", {widened}spite_before, {widened}spite_step, {where})"
    return "do \{ {c_type} spite_step = ({step}); {c_type} spite_before; {c_type} spite_after; if ({owner}___atomic) spite_before = {fetch}(&({place}), spite_step, __ATOMIC_SEQ_CST); else spite_before = ({place}); if (__builtin_expect({builtin}(spite_before, spite_step, &spite_after), 0)) {failed}; if (!{owner}___atomic) ({place}) = spite_after; } while (0);"
}

func emit_atomic_store(
    name: String,
    field_type: Analysis.SpiteType,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var place = field_place("self", class_information, name)
    var owner = class_information.c_name
    var binary = shape.as_binary(value)
    if binary {
        crash binary.left
        crash binary.right
        var counts = binary.operator == 'add' or binary.operator == 'subtract'
        if counts and is_identifier_named(binary.left, name) and not is_boolean_type(field_type) {
            mark_attribute_read(class_information, name)
            var step = coerce_for_store(binary.right, field_type, scope, class_information)
            var field_scalar = type_shape.as_scalar(field_type)
            if field_scalar {
                if is_checked_whole_kind(field_scalar.kind) {
                    var checked_add = checked_singleton_add(binary, owner, place, step, field_type)
                    builder.add_user(checked_add)
                    return
                }
            }
            if binary.operator == 'subtract' {
                step = "-({step})"
            }
            builder.add_user("SPITE_SINGLETON_ADD({owner}, {place}, {step});")
            return
        }
    }
    var stored = coerce_for_store(value, field_type, scope, class_information)
    builder.add_user("SPITE_SINGLETON_STORE({owner}, {place}, {stored});")
}

func emit_guarded_outside_write(
    target_class: Analysis.ClassInfo,
    target_code: String,
    field_type: Analysis.SpiteType,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    if not outside_class_names.contains(target_class.c_name) {
        outside_class_names.append(target_class.c_name)
        outside_classes.append(target_class)
    }
    var value_code = coerce_for_store(value, field_type, scope, class_information)
    var stored = next_temporary()
    var type_name = c_type_name(field_type)
    builder.add_user("{type_name} {stored} = {value_code};")
    var owner = target_class.c_name
    builder.add_user("{owner}___outside_enter();")
    if type_needs_drop(field_type) {
        var previous = next_temporary()
        builder.add_user("{type_name} {previous} = {target_code};")
        builder.add_user("{target_code} = {stored};")
        builder.add_user("{owner}___outside_leave();")
        builder.add_user("{release_call(field_type, previous)};")
    } else {
        builder.add_user("{target_code} = {stored};")
        builder.add_user("{owner}___outside_leave();")
    }
}

func reads_changing_singleton(target_class: Analysis.ClassInfo, class_information: Analysis.ClassInfo): Boolean {
    if not guards_outside_write(target_class) or target_class.c_name == class_information.c_name {
        return false
    }
    return changes_after_construction(target_class)
}

func guarded_outside_read(
    target_class: Analysis.ClassInfo,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    field: Analysis.FieldInfo,
): ExpressionResult {
    var owner = target_class.c_name
    var object_type = object_result.type
    var field_type = field.type
    var object_temporary = next_temporary()
    var field_temporary = next_temporary()
    var lines = List<String>()
    lines.append("{c_type_name(object_type)} {object_temporary} = {object_result.code};")
    var place = field_place("({object_temporary})", target_class, field.name)
    var atomic = atomic_singleton_fields(target_class)
    var lone = lone_atomic_fields(target_class)
    var loaded_atomically = atomic.contains(field.name) or lone.contains(field.name)
    if loaded_atomically {
        if not atomic_class_names.contains(owner) {
            atomic_class_names.append(owner)
            atomic_classes.append(target_class)
        }
        lines.append("{c_type_name(field_type)} {field_temporary} = SPITE_SINGLETON_LOAD({owner}, {place});")
    } else {
        if not outside_class_names.contains(owner) {
            outside_class_names.append(owner)
            outside_classes.append(target_class)
        }
        var read_code = place
        if type_needs_drop(field_type) {
            read_code = retain_call(field_type, place)
        }
        lines.append("{owner}___outside_read_enter();")
        lines.append("{c_type_name(field_type)} {field_temporary} = {read_code};")
        lines.append("{owner}___outside_read_leave();")
    }
    if owns(object_result, object_ast) {
        lines.append("{release_call(object_type, object_temporary)};")
    }
    lines.append("{field_temporary};")
    var guarded_read = ExpressionResult("(\{ {lines.join(" ")} })", field_type)
    guarded_read.owning_override = type_needs_drop(field_type) and not loaded_atomically
    return guarded_read
}

func finish_atomic_singletons() {
    assert not atomic_classes.is_empty()
    builder.add_typedef(
        "#define SPITE_SINGLETON_LOAD(owner, place) (owner##___atomic ? __atomic_load_n(&(place), __ATOMIC_SEQ_CST) : (place))",
    )
    builder.add_typedef(
        "#define SPITE_SINGLETON_STORE(owner, place, value) do \{ if (owner##___atomic) __atomic_store_n(&(place), (value), __ATOMIC_SEQ_CST); else (place) = (value); } while (0)",
    )
    builder.add_typedef(
        "#define SPITE_SINGLETON_ADD(owner, place, value) do \{ if (owner##___atomic) __atomic_fetch_add(&(place), (value), __ATOMIC_SEQ_CST); else (place) += (value); } while (0)",
    )
    var reached = call_effects.thread_reached_classes()
    var index = 0
    while index < atomic_classes.count() {
        var information = atomic_classes[index]
        var threaded = parallel_used and (reached.has(information.qualified_dotted) or called_implicitly(information))
        var flag = "0"
        if threaded {
            flag = "1"
        }
        builder.add_typedef("#define {information.c_name}___atomic {flag}")
        index = index + 1
    }
}

func written_from_outside(information: Analysis.ClassInfo): Boolean {
    if outside_written.has(information.c_name) {
        return outside_written[information.c_name] == true
    }
    var written = false
    var names = call_effects.writes_from_outside(information.qualified_dotted)
    var index = 0
    while index < names.count() {
        if information.find_field(names[index]) {
            written = true
        }
        index = index + 1
    }
    outside_written[information.c_name] = written
    return written
}

func shares_state(field_type: Analysis.SpiteType): Boolean {
    var visiting = List<String>()
    return not holds_read_only(field_type, visiting)
}

func holds_read_only(field_type: Analysis.SpiteType, visiting: List<String>): Boolean {
    if not reaches_shared(field_type) {
        return true
    }
    var held_type = field_type
    var nullable = type_shape.as_nullable(field_type)
    if nullable {
        held_type = nullable.inner
    }
    var class_ref = type_shape.as_class_ref(held_type)
    if not class_ref {
        return false
    }
    var held = find_class_by_c_name(class_ref.c_name)
    if not held {
        return false
    }
    return is_read_only_class(held, visiting)
}

func is_read_only_class(information: Analysis.ClassInfo, visiting: List<String>): Boolean {
    if read_only_classes.has(information.c_name) {
        return read_only_classes[information.c_name] == true
    }
    if visiting.contains(information.c_name) or information.is_value_class {
        return false
    }
    if information.is_generic_template {
        return false
    }
    visiting.append(information.c_name)
    var read_only = not written_from_outside(information)
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        if not holds_read_only(field_type, visiting) {
            read_only = false
        }
        index = index + 1
    }
    var targets = List<String>()
    index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if not function.is_constructor {
            collect_assigned_roots(function.body, targets)
        }
        index = index + 1
    }
    index = 0
    while index < targets.count() {
        if information.find_field(targets[index]) {
            read_only = false
        }
        index = index + 1
    }
    read_only_classes[information.c_name] = read_only
    return read_only
}

func stays_with_singleton(target_class: Analysis.ClassInfo, field: Analysis.FieldInfo): Boolean {
    if not target_class.is_singleton or is_library_class(target_class) or is_hot_class(target_class) {
        return false
    }
    if keeps_internals or hot_reload or read_evaluate_print_loop or remote_loop_port != 0 {
        return false
    }
    if target_class.find_function("get_{field.name}") {
        return false
    }
    var field_type = field.type
    var held_type = field_type
    var nullable = type_shape.as_nullable(field_type)
    if nullable {
        held_type = nullable.inner
    }
    var held_class = type_shape.as_class_ref(held_type)
    var collection = false
    if type_shape.as_list(held_type) or type_shape.as_dictionary(held_type) {
        collection = true
    }
    if held_class {
        if held_class.has_signature {
            return false
        }
    } else if not collection {
        return false
    }
    return not call_effects.assigned_after_construction(target_class.qualified_dotted, field.name)
}

func guards_outside_write(target_class: Analysis.ClassInfo): Boolean {
    var singleton = target_class.is_singleton and not target_class.is_stateless_singleton
    return singleton and not is_library_class(target_class) and not is_hot_class(target_class)
}

func finish_outside_writes() {
    var reached = call_effects.thread_reached_classes()
    var index = 0
    while index < outside_classes.count() {
        var information = outside_classes[index]
        var name = information.c_name
        var threaded = parallel_used and (reached.has(information.qualified_dotted) or called_implicitly(information))
        if threaded and not emitted_guards.contains(name) {
            emitted_guards.append(name)
            builder.add_support("static SpiteGuard {name}___guard = \{ 0, 0 };")
        }
        if threaded and read_guarded_names.contains(name) {
            builder.add_typedef(
                "#define {name}___outside_enter() spite_guard_enter_writing(&{name}___guard, {name}___readers)",
            )
            builder.add_typedef("#define {name}___outside_leave() spite_guard_leave(&{name}___guard)")
            builder.add_typedef(
                "#define {name}___outside_read_enter() int64_t* spite_reading = spite_read_enter(&{name}___guard, {name}___readers)",
            )
            builder.add_typedef("#define {name}___outside_read_leave() spite_read_leave(spite_reading)")
        } else if threaded {
            builder.add_typedef("#define {name}___outside_enter() spite_guard_enter(&{name}___guard)")
            builder.add_typedef("#define {name}___outside_leave() spite_guard_leave(&{name}___guard)")
            builder.add_typedef("#define {name}___outside_read_enter() spite_guard_enter(&{name}___guard)")
            builder.add_typedef("#define {name}___outside_read_leave() spite_guard_leave(&{name}___guard)")
        } else {
            builder.add_typedef("#define {name}___outside_enter() ((void)0)")
            builder.add_typedef("#define {name}___outside_leave() ((void)0)")
            builder.add_typedef("#define {name}___outside_read_enter() ((void)0)")
            builder.add_typedef("#define {name}___outside_read_leave() ((void)0)")
        }
        index = index + 1
    }
}

func called_implicitly(information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < information.declared_functions.count() {
        var name = information.declared_functions[index].name
        var operator = name == "sum" or name == "subtract" or name == "multiply" or name == "divide" or name == "remainder"
        var compares = name == "equals" or name == "less_than" or name == "greater_than" or name == "negate"
        var indexes = name == "get_at" or name == "set_at" or name == "missing_function"
        var accessor = name.starts_with("get_") or name.starts_with("set_")
        var text = name == "to_string" or name == "to_debug"
        if operator or compares or indexes or accessor or text {
            return true
        }
        index = index + 1
    }
    return false
}

func emit_guard_wrapper(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, unguarded_name: String) {
    var arguments = List<String>()
    arguments.append("self")
    var index = 0
    while index < function.parameters.count() {
        var argument_code = c_value_name(function.parameters[index].name)
        arguments.append(argument_code)
        index = index + 1
    }
    var called = "{unguarded_name}({arguments.join(", ")})"
    var guard = "&{information.c_name}___guard"
    var return_type = function.return_type
    var lines = List<String>()
    lines.append("{function_signature(information, function)} \{")
    append_unshared_path(lines, called, guard, return_type)
    var leave = "spite_guard_leave({guard});"
    if reading_function_names.has(function.c_name) {
        lines.append("int64_t* spite_reading = spite_read_enter({guard}, {information.c_name}___readers);")
        leave = "spite_read_leave(spite_reading);"
    } else if read_guarded_names.contains(information.c_name) {
        lines.append("spite_guard_enter_writing({guard}, {information.c_name}___readers);")
    } else {
        lines.append("spite_guard_enter({guard});")
    }
    lines.append("SPITE_GUARDS_COUNT(1);")
    if type_shape.is_void(return_type) {
        lines.append("{called};")
        lines.append(leave)
        lines.append("SPITE_GUARDS_COUNT(-1);")
    } else {
        lines.append("{c_type_name(return_type)} spite_guarded = {called};")
        lines.append(leave)
        lines.append("SPITE_GUARDS_COUNT(-1);")
        lines.append("return spite_guarded;")
    }
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func append_unshared_path(lines: List<String>, called: String, guard: String, return_type: Analysis.SpiteType) {
    lines.append("if (spite_skipped_depth < 16 && __atomic_load_n(&spite_tasks_in_flight, __ATOMIC_ACQUIRE) == 0) \{")
    lines.append("int32_t spite_skip = spite_skipped_depth;")
    lines.append("spite_skipped[spite_skip] = (void*){guard};")
    lines.append("spite_skipped_taken[spite_skip] = 0;")
    lines.append("spite_skipped_depth = spite_skip + 1;")
    lines.append("SPITE_GUARDS_COUNT(1);")
    var done = "return;"
    if type_shape.is_void(return_type) {
        lines.append("{called};")
    } else {
        lines.append("{c_type_name(return_type)} spite_unshared = {called};")
        done = "return spite_unshared;"
    }
    lines.append("spite_skipped_depth = spite_skip;")
    lines.append("if (spite_skipped_taken[spite_skip]) spite_guard_leave({guard});")
    lines.append("SPITE_GUARDS_COUNT(-1);")
    lines.append(done)
    lines.append("}")
}

func finish_skipped_guards() {
    if parallel_used {
        builder.add_support("static void spite_enter_skipped(void* guard) \{ spite_guard_enter((SpiteGuard*)guard); }")
        return
    }
    builder.add_support("static void spite_enter_skipped(void* guard) \{ (void)guard; }")
}

func finish_waiting_points() {
    assert scheduler_used or remote_loop_port > 0 or hot_reload
    builder.threads = true
    note_fact("flag threads")
    var scheduler_class = find_class_by_qualified("Scheduler")
    crash scheduler_class
    var scheduler = singleton_call(scheduler_class)
    builder.add_typedef(
        "typedef struct SpiteOffload \{ int64_t done; void (*perform)(void*); void* scheduler; } SpiteOffload;",
    )
    builder.add_prototype("static void* spite_offload_thread(void* call);")
    builder.add_support(
        "static void* spite_offload_thread(void* call) \{\nspite_fault_thread();\nSpiteOffload* offload = (SpiteOffload*)call;\noffload->perform(call);\nScheduler_offload_done((Scheduler*)offload->scheduler, (int64_t)(intptr_t)call);\nreturn 0;\n}",
    )
    var index = 0
    while index < waiting_functions.count() {
        crash waiting_classes[index]
        crash waiting_positions[index]
        var information = waiting_classes[index]
        crash waiting_kinds[index]
        var function = waiting_functions[index]
        var position = waiting_positions[index]
        var kind = waiting_kinds[index]
        if kind != "join" {
            var waited_name = "{function.c_name}___waiting"
            var waited_signature = named_signature(information, function, waited_name)
            builder.replace_user(position, "{waited_signature} \{")
            builder.add_prototype("{waited_signature};")
            emit_waiting_wrapper(information, function, kind, scheduler)
        }
        index = index + 1
    }
}

func emit_waiting_wrapper(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    kind: String,
    scheduler: String,
) {
    guard_count_asked = true
    var arguments = List<String>()
    arguments.append("self")
    var index = 0
    while index < function.parameters.count() {
        var argument_code = c_value_name(function.parameters[index].name)
        arguments.append(argument_code)
        index = index + 1
    }
    var waited = "{function.c_name}___waiting({arguments.join(", ")})"
    var lines = List<String>()
    lines.append("{function_signature(information, function)} \{")
    lines.append("Scheduler* spite_scheduler = {scheduler};")
    if kind == "yield" {
        lines.append("{waited};")
        lines.append(
            "if (SPITE_GUARDS_HELD() == 0 && Scheduler_waits_here(spite_scheduler)) Scheduler_yield_now(spite_scheduler);",
        )
        lines.append("Scheduler___release(spite_scheduler);")
    } else if kind == "sleep" {
        crash function.parameters[0]
        lines.append(
            "if (SPITE_GUARDS_HELD() == 0 && Scheduler_waits_here(spite_scheduler)) Scheduler_sleep(spite_scheduler, {c_value_name(function.parameters[0].name)}); else {waited};",
        )
        lines.append("Scheduler___release(spite_scheduler);")
    } else {
        var offloaded = offloaded_call_lines(information, function, arguments, waited)
        lines.append(offloaded)
    }
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func offloaded_call_lines(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    arguments: List<String>,
    waited: String,
): String {
    var call_type = "{function.c_name}___call"
    var return_type = function.return_type
    var returns = not type_shape.is_void(return_type)
    var fields = List<String>()
    fields.append("SpiteOffload offload;")
    fields.append("{information.c_name}* self;")
    var passed = List<String>()
    passed.append("call->self")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        fields.append("{c_type_name(parameter_type)} {c_value_name(parameter.name)};")
        passed.append("call->{c_value_name(parameter.name)}")
        index = index + 1
    }
    var stored = ""
    var blocked = "{waited}; Scheduler___release(spite_scheduler); return;"
    var answered = "return;"
    if returns {
        fields.append("{c_type_name(return_type)} result;")
        stored = "call->result = "
        blocked = "Scheduler___release(spite_scheduler); return {waited};"
        answered = "return spite_call.result;"
    }
    builder.add_typedef("typedef struct {call_type} \{ {fields.join(" ")} } {call_type};")
    builder.add_prototype("static void {function.c_name}___perform(void* raw);")
    builder.add_support(
        "static void {function.c_name}___perform(void* raw) \{\n{call_type}* call = ({call_type}*)raw;\n{stored}{function.c_name}___waiting({passed.join(", ")});\n}",
    )
    var lines = List<String>()
    lines.append("if (SPITE_GUARDS_HELD() != 0 || !Scheduler_waits_here(spite_scheduler)) \{ {blocked} }")
    lines.append(
        "{call_type} spite_call = \{ \{ 0, &{function.c_name}___perform, spite_scheduler }, {arguments.join(", ")} };",
    )
    lines.append(
        "if (!Scheduler_offload(spite_scheduler, (int64_t)(intptr_t)&spite_call, (int64_t)(intptr_t)&spite_offload_thread)) \{ {blocked} }",
    )
    lines.append("Scheduler___release(spite_scheduler);")
    lines.append(answered)
    return lines.join("\n")
}

func remote_loop_start(entry_class: Analysis.ClassInfo, lines: List<String>) {
    builder.threads = true
    note_fact("flag threads")
    var program_symbol = ensure_symbol("program")
    builder.add_support(
        "static ReadEvaluatePrintLoop* spite_remote_loop = 0;\nstatic {entry_class.c_name}* spite_remote_program = 0;\nstatic void* spite_remote_loop_thread(void* unused) \{\n(void)unused;\nspite_fault_thread();\nReadEvaluatePrintLoop_serve(spite_remote_loop, spite_reflect_{entry_class.c_name}({program_symbol}, spite_remote_program));\nreturn 0;\n}",
    )
    if hot_reload {
        var attribute_class = find_class_by_c_name("Spite_Attribute")
        crash attribute_class
        var attribute_type = class_type_of(attribute_class)
        var list_name = ensure_list(attribute_type)
        builder.add_prototype("void spite_breakpoint(SpiteString site, {list_name}* locals);")
        builder.add_support(
            "void spite_breakpoint(SpiteString site, {list_name}* locals) \{\nif (spite_remote_loop == 0) \{ SpiteString___release(site); {list_name}___release(locals); return; }\nReadEvaluatePrintLoop_pause_at(spite_remote_loop, site, locals);\n}",
        )
    }
    lines.append("spite_remote_program = spite_entry_instance;")
    lines.append("spite_remote_loop = ReadEvaluatePrintLoop___make();")
    lines.append(
        "ReadEvaluatePrintLoop_listen_in_background(spite_remote_loop, {remote_loop_port}, (int64_t)(intptr_t)&spite_remote_loop_thread);",
    )
}

func program_run_code(): String {
    var entry_class = find_class_by_c_name(entry_class_c_name)
    crash entry_class
    var lines = List<String>()
    lines.append("{entry_class.c_name}* spite_entry_instance = {entry_class.c_name}___allocate();")
    var hot_reload_class = find_class_by_qualified("HotReload")
    if hot_reload {
        crash hot_reload_class
        lines.append(
            "HotReload* spite_hot_reload = {singleton_call(hot_reload_class)}; HotReload_start(spite_hot_reload);",
        )
    }
    if remote_loop_port > 0 {
        remote_loop_start(entry_class, lines)
    }
    if entry_class.constructor {
        lines.append("{entry_class.constructor.c_name}(spite_entry_instance);")
    }
    if console_loop {
        var program_symbol = ensure_symbol("program")
        lines.append(
            "\{ ReadEvaluatePrintLoop* spite_loop = ReadEvaluatePrintLoop___make(); while (ReadEvaluatePrintLoop_step(spite_loop, spite_reflect_{entry_class.c_name}({program_symbol}, spite_entry_instance))) \{} ReadEvaluatePrintLoop___release(spite_loop); }",
        )
    }
    if remote_loop_port > 0 {
        lines.append("ReadEvaluatePrintLoop_wait_for_exit(spite_remote_loop);")
        lines.append("ReadEvaluatePrintLoop___release(spite_remote_loop);")
    }
    if hot_reload {
        lines.append("HotReload___release(spite_hot_reload);")
    }
    lines.append("{entry_class.c_name}___release(spite_entry_instance);")
    return "(\{ {lines.join(" ")} (void)0; })"
}

func emit_main(launcher_mangled_name: String) {
    var launcher_class = find_class_by_c_name(launcher_mangled_name)
    assert launcher_class
    if debug_memory {
        builder.add_main("static const char* spite_debug_class_name_table[] = {debug_memory_class_name_table()};")
        builder.add_main("spite_debug_set_class_names(spite_debug_class_name_table, {class_names_by_id.count()});")
    }
    builder.add_main("{launcher_class.c_name}* spite_launcher = {launcher_class.c_name}___allocate();")
    if launcher_class.constructor {
        builder.add_main("{launcher_class.constructor.c_name}(spite_launcher);")
    }
    builder.add_main("{launcher_class.c_name}___release(spite_launcher);")
    report_singleton_circles()
    emit_singleton_teardown()
    singleton_releases.each(builder.add_main)
}

func release_new_class_objects(): Boolean {
    if released_class_objects == class_object_names.count() {
        return false
    }
    var listed_name = ""
    if class_level_functions_used {
        var listed_class = find_class_by_c_name("Spite_Function")
        crash listed_class
        var class_type = class_type_of(listed_class)
        listed_name = ensure_list(class_type)
    }
    var attribute_listed_name = ""
    if class_level_attributes_used {
        attribute_listed_name = attribute_declaration_list_name()
    }
    var cache_index = released_class_objects
    while cache_index < class_object_names.count() {
        var class_object = class_object_names[cache_index]
        var cache = "{class_object}_cache"
        if not listed_name.is_empty() {
            builder.add_main_if_kept(
                class_object,
                "if ({cache} != 0) \{ {listed_name}___release({cache}->_functions_); {cache}->_functions_ = 0; }",
            )
        }
        if not attribute_listed_name.is_empty() {
            builder.add_main_if_kept(
                class_object,
                "if ({cache} != 0) \{ {attribute_listed_name}___release({cache}->_attributes_); {cache}->_attributes_ = 0; }",
            )
        }
        builder.add_main_if_kept(
            class_object,
            "if ({cache} != 0 && {cache}->_namespace_ != 0) \{ Spite_Namespace___release({cache}->_namespace_); {cache}->_namespace_ = 0; }",
        )
        if cache == entry_functions_cache {
            builder.add_main_if_kept(
                class_object,
                "if ({cache} != 0) \{ {listed_name}___release({cache}->_unbound_functions_); {cache}->_unbound_functions_ = 0; }",
            )
        }
        builder.add_main_if_kept(class_object, "Spite_Class___release({cache});")
        cache_index = cache_index + 1
    }
    released_class_objects = cache_index
    return true
}

func finish_main() {
    if namespace_read_used {
        var class_class = find_class_by_c_name("Spite_Class")
        var namespace_class = find_class_by_c_name("Spite_Namespace")
        crash class_class
        crash namespace_class
        var class_type = class_type_of(class_class)
        var classes_list_name = ensure_list(class_type)
        var namespace_class_type = class_type_of(namespace_class)
        var namespaces_list_name = ensure_list(namespace_class_type)
        var parent_position = 0
        while parent_position < namespace_object_keys.count() {
            var parent_cache = "spite_namespace_object_{namespace_object_keys[parent_position].replace(".", "_")}_cache"
            builder.add_main(
                "if ({parent_cache} != 0 && {parent_cache}->_parent_ != 0) \{ Spite_Namespace___release({parent_cache}->_parent_); {parent_cache}->_parent_ = 0; }",
            )
            parent_position = parent_position + 1
        }
        var namespace_position = 0
        while namespace_position < namespace_object_keys.count() {
            var namespace_cache = "spite_namespace_object_{namespace_object_keys[namespace_position].replace(".", "_")}_cache"
            builder.add_main(
                "if ({namespace_cache} != 0) \{ {classes_list_name}___release({namespace_cache}->_classes_); {namespace_cache}->_classes_ = 0; {namespaces_list_name}___release({namespace_cache}->_namespaces_); {namespace_cache}->_namespaces_ = 0; }",
            )
            builder.add_main("Spite_Namespace___release({namespace_cache});")
            namespace_position = namespace_position + 1
        }
    }
    if debug_memory {
        builder.add_main("spite_debug_report();")
    }
}

func is_hot_class(information: Analysis.ClassInfo): Boolean {
    var program_class = not information.source_path.is_empty() and not is_library_class(information)
    return hot_reload and (program_class or is_settings_class(information)) and not information.is_value_class
}

func is_settings_class(information: Analysis.ClassInfo): Boolean {
    return information.qualified_dotted == "Environment" or information.qualified_dotted == "Build"
}

func is_slotted_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not hot_reload {
        return false
    }
    var waiting = waiting_kind(information, function)
    return waiting.is_empty()
}

func field_place(object_code: String, owner: Analysis.ClassInfo, name: String): String {
    var field_code = c_value_name(name)
    if is_hot_class(owner) {
        return "{owner.c_name}___fields({object_code})->{field_code}"
    }
    return "{object_code}->{field_code}"
}

func field_signature(information: Analysis.ClassInfo): String {
    var codec = TypeCodec()
    codec.enums_by_name = true
    var parts = List<String>()
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var encoded = codec.encoded(field_type)
        parts.append("{field.name}={encoded}")
        index = index + 1
    }
    var fits = class_fits_vector(information)
    parts.append("fits={fits}")
    return parts.join(";")
}

func host_field_signature(c_name: String): String {
    if not layout_host {
        return ""
    }
    var found = layout_host.host_fields[c_name]
    if not found {
        return ""
    }
    return found
}

func running_field_signature(c_name: String): String {
    if not layout_host {
        return ""
    }
    if layout_host.running_fields[c_name] {
        return layout_host.running_fields[c_name]
    }
    return host_field_signature(c_name)
}

func note_layout_change(information: Analysis.ClassInfo, running: String, now: String) {
    var was = signature_types(running)
    var fields = signature_types(now)
    var notes = List<String>()
    var taken = List<String>()
    var appeared = List<String>()
    var held = "holds its default"
    if information.qualified_dotted == "Environment" {
        held = "is read like every setting, from the command line, the environment or its default"
    }
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var old_name = renamed_from(information, field.name)
        crash fields[field.name]
        var type_now = fields[field.name]
        var renamed = not old_name.is_empty() and was.has(old_name) and was[old_name] == type_now
        if not old_name.is_empty() and not renamed {
            report_unusable_rename(information, old_name, field.name)
        }
        if renamed {
            taken.append(old_name)
            notes.append("{old_name} is now {field.name}")
        } else if not was.has(field.name) {
            appeared.append(field.name)
            notes.append("{field.name} is new and {held}")
        } else if was[field.name] != type_now {
            taken.append(field.name)
            notes.append("{field.name} has a new type and {held}")
        } else {
            taken.append(field.name)
        }
        index = index + 1
    }
    var old_names = was.keys()
    var gone = List<String>()
    index = 0
    while index < old_names.count() {
        var old_name = old_names[index]
        if old_name != "fits" and not taken.contains(old_name) {
            gone.append(old_name)
            notes.append("{old_name} is gone, and what it held was released")
        }
        index = index + 1
    }
    if not gone.is_empty() and not appeared.is_empty() and not reload_renames_given {
        report_held_rename(information, gone, appeared)
    }
    if was["fits"] == "true" and fields["fits"] == "false" {
        notes.append("its objects moved out of an Items' own memory into objects of their own")
    }
    if was["fits"] == "false" and fields["fits"] == "true" {
        notes.append("its objects moved into an Items' own memory")
    }
    if notes.is_empty() {
        notes.append("its attributes were reordered")
    }
    migration_notes.append("moved every {information.qualified_dotted} to its new attributes: {notes.join("; ")}")
}

func report_held_rename(information: Analysis.ClassInfo, gone: List<String>, appeared: List<String>) {
    var class_name = information.qualified_dotted
    var first_gone = gone.first()
    var first_new = appeared.first()
    crash first_gone and first_new
    report(
        "the reload of {class_name} is held, since it would lose data: {gone.join(", ")} is gone and {appeared.join(", ")} is new, and a reload never guesses whether one is the other. Nothing was swapped in. To move the values of the running objects into the new attribute, give the map at the prompt: reload \{{class_name}.attributes['{first_gone}']: \"{first_new}\"}; to let what {gone.join(", ")} holds be released: reload \{}",
    )
}

func report_unusable_rename(information: Analysis.ClassInfo, old_name: String, new_name: String) {
    report(
        "the reload map moves {information.qualified_dotted}.attributes['{old_name}'] into \"{new_name}\", but the running {information.qualified_dotted} has no attribute '{old_name}' of the type '{new_name}' has now: name an attribute the running class has, of the same type",
    )
}

func signature_types(signature: String): Dictionary<String, String> {
    var types = Dictionary<String, String>()
    var parts = signature.split(";")
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        var equals = part.index_of("=")
        if equals > 0 {
            var part_length = part.length()
            var name = part.slice(0, equals)
            types[name] = part.slice(equals + 1, part_length)
        }
        index = index + 1
    }
    return types
}

func add_live_layout(information: Analysis.ClassInfo) {
    var c_name = information.c_name
    var signature = field_signature(information)
    field_signatures[c_name] = signature
    var host_signature = host_field_signature(c_name)
    var running_signature = running_field_signature(c_name)
    var moved_before = false
    if layout_host {
        moved_before = layout_host.running_fields.has(c_name)
    }
    if not running_signature.is_empty() and running_signature != signature {
        changing_layouts.append(c_name)
        note_layout_change(information, running_signature, signature)
    }
    if not host_signature.is_empty() and (host_signature != signature or moved_before) {
        migrating_classes.append(c_name)
        builder.add_typedef(
            "static inline {c_name}* {c_name}___fields({c_name}* object) \{ return object->spite_moved != 0 ? ({c_name}*)object->spite_moved : object; }",
        )
    } else {
        builder.add_typedef("#define {c_name}___fields(object) (object)")
    }
    add_live_set(c_name)
    builder.add_prototype("const SpiteLayout* {c_name}___layout(void);")
    var descriptor = layout_descriptor(information)
    builder.add_support(descriptor)
    builder.add_prototype("const SpiteLayout** {c_name}___layout_now(void);")
    builder.add_support(
        "const SpiteLayout** {c_name}___layout_now(void) \{\nstatic const SpiteLayout* now = 0;\nif (now == 0) now = {c_name}___layout();\nreturn &now;\n}",
    )
}

func add_live_set(c_name: String) {
    builder.add_prototype("SpiteLiveSet* {c_name}___live(void);")
    builder.add_support(
        "SpiteLiveSet* {c_name}___live(void) \{\nstatic SpiteLiveSet live = \{ 0, 0, 0, 0, 0 };\nreturn &live;\n}",
    )
}

func has_live_registry(information: Analysis.ClassInfo): Boolean {
    if is_hot_class(information) {
        return true
    }
    var item = live_item_class(information)
    if item {
        return true
    }
    return false
}

func live_item_class(information: Analysis.ClassInfo): Analysis.ClassInfo? {
    assert hot_reload and is_library_class(information) and not information.is_value_class
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var reference = type_shape.as_class_ref(field_type)
        if reference {
            var item = inline_memory_item(reference.c_name)
            if item {
                return item
            }
        }
        index = index + 1
    }
    return null
}

func inline_memory_item(c_name: String): Analysis.ClassInfo? {
    var held = find_class_by_c_name(c_name)
    assert held
    assert held.qualified_dotted == "InlineMemory" and held.codegen_types.count() == 1
    var item_reference = type_shape.as_class_ref(held.codegen_types[0])
    assert item_reference
    var item = find_class_by_c_name(item_reference.c_name)
    assert item
    if is_hot_class(item) {
        return item
    }
    return null
}

func layout_descriptor(information: Analysis.ClassInfo): String {
    var c_name = information.c_name
    var codec = TypeCodec()
    codec.enums_by_name = true
    var facts = ProgramFacts()
    var entries = List<String>()
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var field_code = c_value_name(field.name)
        var releaser = "0"
        if type_needs_drop(field_type) {
            releaser = "{c_name}___release_field_{field.name}"
            var released = release_call(field_type, "*({c_type_name(field_type)}*)place")
            builder.add_support("static void {releaser}(void* place) \{\n{released};\n}")
        }
        var encoded = codec.encoded(field_type)
        var type_hash = facts.text_hash(encoded)
        entries.append(
            "\{ \"{field.name}\", \"{type_hash}\", (int64_t)offsetof({c_name}, {field_code}), (int64_t)sizeof((({c_name}*)0)->{field_code}), {releaser} }",
        )
        index = index + 1
    }
    entries.append("\{ 0, 0, 0, 0, 0 }")
    var count = information.fields.count()
    var fits = 0
    if class_fits_vector(information) {
        fits = 1
    }
    return "const SpiteLayout* {c_name}___layout(void) \{\nstatic const SpiteLayoutField fields[] = \{ {entries.join(", ")} };\nstatic const SpiteLayout layout = \{ \"{information.qualified_dotted}\", (int64_t)sizeof({c_name}), {count}, fields, {fits} };\nreturn &layout;\n}"
}

func append_live_start(lines: List<String>, information: Analysis.ClassInfo, object_code: String) {
    if has_live_registry(information) {
        lines.append("{object_code}->spite_moved = 0;")
        lines.append("{object_code}->spite_live = 0;")
    }
}

func append_live_add(lines: List<String>, information: Analysis.ClassInfo, object_code: String) {
    if has_live_registry(information) {
        lines.append("spite_live_add({information.c_name}___live(), {object_code}, &{object_code}->spite_live);")
    }
}

func append_live_remove(lines: List<String>, information: Analysis.ClassInfo) {
    if has_live_registry(information) {
        lines.append("spite_live_remove({information.c_name}___live(), self, &self->spite_live);")
        lines.append("if (self->spite_moved != 0) SPITE_FREE(self->spite_moved);")
    }
}

func note_live_slot(information: Analysis.ClassInfo, what: String) {
    if is_hot_class(information) {
        var position = builder.support_count()
        live_slot_positions.append(position)
        live_slot_owners.append(information.c_name)
        live_slot_displays.append("{information.qualified_dotted}{what}")
    }
}

func moved_state_lines(): String {
    var lines = List<String>()
    var index = 0
    while index < migrating_classes.count() {
        var c_name = migrating_classes[index]
        crash field_signatures[c_name]
        lines.append("fields {c_name} {field_signatures[c_name]}")
        index = index + 1
    }
    return lines.join("\n")
}

func migrating_display(): String {
    var names = List<String>()
    var index = 0
    while index < changing_layouts.count() {
        var moved = find_class_by_c_name(changing_layouts[index])
        crash moved
        names.append(moved.qualified_dotted)
        index = index + 1
    }
    return names.join(", ")
}

func mentions_migrating_layout(text: String): Boolean {
    var index = 0
    while index < changing_layouts.count() {
        var c_name = changing_layouts[index]
        if text.contains("{c_name}___fields(") or text.contains("sizeof({c_name})") {
            return true
        }
        index = index + 1
    }
    return false
}

func migration_local_names(): List<String> {
    var names = List<String>()
    var index = 0
    while index < changing_layouts.count() {
        var c_name = changing_layouts[index]
        names.append("{c_name}___layout")
        index = index + 1
    }
    return names
}

func emit_migrations() {
    assert not changing_layouts.is_empty()
    builder.add_typedef(
        "typedef struct SpiteMoving \{ void** places; void (**releases)(void*); int64_t count; int64_t capacity; void** blocks; int64_t block_count; int64_t block_capacity; } SpiteMoving;",
    )
    builder.add_typedef(
        "typedef struct SpitePlan \{ const SpiteLayout** now; const SpiteLayout* old; const SpiteLayout* fresh; int64_t* from; int32_t* taken; void** objects; int64_t count; void** holders; int64_t holder_count; } SpitePlan;",
    )
    var helpers = moving_helpers()
    builder.add_support(helpers)
    var prepare_lines = List<String>()
    var move_lines = List<String>()
    var check_lines = List<String>()
    var index = 0
    while index < changing_layouts.count() {
        var moved = find_class_by_c_name(changing_layouts[index])
        crash moved
        emit_class_migration(moved)
        if storage_change(moved) == "into" {
            var holders = live_holders_of(moved)
            var holder_index = 0
            while holder_index < holders.count() {
                check_lines.append(
                    "\{ const char* shared = {holders[holder_index].c_name}___shared_item(); if (shared != 0) return shared; }",
                )
                holder_index = holder_index + 1
            }
        }
        prepare_lines.append("const char* spite_refused_{index} = {moved.c_name}___prepare(&spite_plan_{index});")
        prepare_lines.append("if (spite_refused_{index} != 0) return spite_refused_{index};")
        move_lines.append("{moved.c_name}___move_all(&spite_plan_{index}, &moving);")
        index = index + 1
    }
    var plans = List<String>()
    index = 0
    while index < changing_layouts.count() {
        plans.append("SpitePlan spite_plan_{index} = \{ 0 };")
        index = index + 1
    }
    var finishes = List<String>()
    index = 0
    while index < changing_layouts.count() {
        finishes.append("spite_plan_finish(&spite_plan_{index});")
        index = index + 1
    }
    builder.add_support(
        "static const char* spite_migrate_all(int32_t checking) \{\nif (checking) \{\n{check_lines.join("\n")}\nreturn 0;\n}\n{plans.join("\n")}\n{prepare_lines.join("\n")}\nSpiteMoving moving = \{ 0 };\n{move_lines.join("\n")}\n{finishes.join("\n")}\nspite_moving_finish(&moving);\nreturn 0;\n}",
    )
}

func moving_helpers(): String {
    var lines = List<String>()
    lines.append("static void spite_moving_release(SpiteMoving* moving, void (*release)(void*), void* place) \{")
    lines.append(
        "if (moving->count == moving->capacity) \{ moving->capacity = moving->capacity == 0 ? 64 : moving->capacity * 2; moving->places = (void**)realloc(moving->places, (size_t)moving->capacity * sizeof(void*)); moving->releases = (void (**)(void*))realloc(moving->releases, (size_t)moving->capacity * sizeof(void (*)(void*))); }",
    )
    lines.append(
        "moving->places[moving->count] = place; moving->releases[moving->count] = release; moving->count = moving->count + 1;",
    )
    lines.append("}")
    lines.append("static void spite_moving_free(SpiteMoving* moving, void* block) \{")
    lines.append(
        "if (moving->block_count == moving->block_capacity) \{ moving->block_capacity = moving->block_capacity == 0 ? 64 : moving->block_capacity * 2; moving->blocks = (void**)realloc(moving->blocks, (size_t)moving->block_capacity * sizeof(void*)); }",
    )
    lines.append("moving->blocks[moving->block_count] = block; moving->block_count = moving->block_count + 1;")
    lines.append("}")
    lines.append("static void spite_moving_finish(SpiteMoving* moving) \{")
    lines.append(
        "for (int64_t index = 0; index < moving->count; index = index + 1) moving->releases[index](moving->places[index]);",
    )
    lines.append(
        "for (int64_t index = 0; index < moving->block_count; index = index + 1) SPITE_FREE(moving->blocks[index]);",
    )
    lines.append("free(moving->places); free(moving->releases); free(moving->blocks);")
    lines.append("}")
    lines.append("static int32_t spite_same_layout(const SpiteLayout* old, const SpiteLayout* fresh) \{")
    lines.append("if (old->size != fresh->size || old->count != fresh->count || old->fits != fresh->fits) return 0;")
    lines.append("for (int64_t index = 0; index < old->count; index = index + 1) \{")
    lines.append(
        "const SpiteLayoutField* was = &old->fields[index]; const SpiteLayoutField* is = &fresh->fields[index];",
    )
    lines.append(
        "if (strcmp(was->name, is->name) != 0 || strcmp(was->type, is->type) != 0 || was->offset != is->offset || was->size != is->size) return 0;",
    )
    lines.append("}")
    lines.append("return 1;")
    lines.append("}")
    lines.append("static int64_t spite_old_field(const SpiteLayout* old, const char* name, const char* type) \{")
    lines.append("if (name == 0) return -1;")
    lines.append(
        "for (int64_t index = 0; index < old->count; index = index + 1) if (strcmp(old->fields[index].name, name) == 0 && strcmp(old->fields[index].type, type) == 0) return index;",
    )
    lines.append("return -1;")
    lines.append("}")
    lines.append(
        "static const char* spite_plan(SpitePlan* plan, const SpiteLayout** now, const SpiteLayout* fresh, const char* const* renamed, SpiteLiveSet* live) \{",
    )
    lines.append("plan->now = now; plan->old = *now; plan->fresh = fresh;")
    lines.append("if (spite_same_layout(plan->old, fresh)) return 0;")
    lines.append("plan->from = (int64_t*)calloc((size_t)fresh->count + 1, sizeof(int64_t));")
    lines.append("plan->taken = (int32_t*)calloc((size_t)plan->old->count + 1, sizeof(int32_t));")
    lines.append("for (int64_t index = 0; index < fresh->count; index = index + 1) \{")
    lines.append("int64_t found = spite_old_field(plan->old, renamed[index], fresh->fields[index].type);")
    lines.append(
        "if (found < 0 || plan->taken[found]) found = spite_old_field(plan->old, fresh->fields[index].name, fresh->fields[index].type);",
    )
    lines.append("if (found >= 0 && plan->taken[found]) found = -1;")
    lines.append("plan->from[index] = found;")
    lines.append("if (found >= 0) plan->taken[found] = 1;")
    lines.append("}")
    lines.append("plan->count = live->count;")
    lines.append("plan->objects = (void**)malloc((size_t)(live->count + 1) * sizeof(void*));")
    lines.append(
        "for (int64_t index = 0; index < live->count; index = index + 1) plan->objects[index] = live->objects[index];",
    )
    lines.append("return 0;")
    lines.append("}")
    lines.append("static void spite_plan_finish(SpitePlan* plan) \{")
    lines.append("if (plan->from != 0) *plan->now = plan->fresh;")
    lines.append("free(plan->from); free(plan->taken); free(plan->objects); free(plan->holders);")
    lines.append("}")
    lines.append("static void spite_forget_fields(char* was, const SpitePlan* plan, SpiteMoving* moving) \{")
    lines.append(
        "for (int64_t index = 0; index < plan->old->count; index = index + 1) if (!plan->taken[index] && plan->old->fields[index].release != 0) spite_moving_release(moving, plan->old->fields[index].release, was + plan->old->fields[index].offset);",
    )
    lines.append("}")
    return lines.join("\n")
}

func emit_class_migration(information: Analysis.ClassInfo) {
    var c_name = information.c_name
    var renamed = List<String>()
    var fill_lines = List<String>()
    fill_lines.append("static void {c_name}___fill({c_name}* fresh, char* was, const SpitePlan* plan) \{")
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var field_code = c_value_name(field.name)
        var old_name = renamed_from(information, field.name)
        if old_name.is_empty() {
            renamed.append("0")
        } else {
            renamed.append("\"{old_name}\"")
        }
        var released = release_statement(field_type, "fresh->{field_code}")
        fill_lines.append(
            "if (plan->from[{index}] >= 0) \{ {released} memcpy(&fresh->{field_code}, was + plan->old->fields[plan->from[{index}]].offset, sizeof(fresh->{field_code})); }",
        )
        index = index + 1
    }
    fill_lines.append("(void)fresh; (void)was; (void)plan;")
    fill_lines.append("}")
    var fill_text = fill_lines.join("\n")
    builder.add_support(fill_text)
    renamed.append("0")
    var change = storage_change(information)
    var holders = List<Analysis.ClassInfo>()
    if change != "references" {
        holders = live_holders_of(information)
    }
    var plan_lines = List<String>()
    plan_lines.append("static const char* {c_name}___prepare(SpitePlan* plan) \{")
    plan_lines.append("static const char* const renamed[] = \{ {renamed.join(", ")} };")
    plan_lines.append(
        "const char* refused = spite_plan(plan, {c_name}___layout_now(), {c_name}___layout(), renamed, {c_name}___live());",
    )
    plan_lines.append("if (refused != 0) return refused;")
    plan_lines.append("return 0;")
    plan_lines.append("}")
    var plan_text = plan_lines.join("\n")
    builder.add_support(plan_text)
    var move_lines = List<String>()
    move_lines.append("static void {c_name}___move_all(SpitePlan* plan, SpiteMoving* moving) \{")
    move_lines.append("if (plan->from == 0) return;")
    move_lines.append("for (int64_t index = 0; index < plan->count; index = index + 1) \{")
    move_lines.append("{c_name}* object = ({c_name}*)plan->objects[index];")
    move_lines.append("char* was = object->spite_moved != 0 ? (char*)object->spite_moved : (char*)object;")
    move_lines.append("{c_name}* fresh = ({c_name}*)SPITE_MALLOC(sizeof({c_name}));")
    move_lines.append("memset(fresh, 0, sizeof({c_name}));")
    move_lines.append("{c_name}___init___hot(fresh);")
    move_lines.append("{c_name}___fill(fresh, was, plan);")
    move_lines.append("spite_forget_fields(was, plan, moving);")
    move_lines.append("if (object->spite_moved != 0) spite_moving_free(moving, object->spite_moved);")
    move_lines.append("object->spite_moved = fresh;")
    move_lines.append("}")
    var holder_index = 0
    while holder_index < holders.count() {
        move_lines.append("{holders[holder_index].c_name}___move_items(plan, moving);")
        holder_index = holder_index + 1
    }
    move_lines.append("}")
    holder_index = 0
    while holder_index < holders.count() {
        var holder = holders[holder_index]
        var items_text = moved_items(information, holder, change)
        builder.add_support(items_text)
        if change == "into" {
            var shared_text = shared_item_check(information, holder)
            builder.add_support(shared_text)
        }
        holder_index = holder_index + 1
    }
    var move_text = move_lines.join("\n")
    builder.add_support(move_text)
}

func storage_change(information: Analysis.ClassInfo): String {
    var running = running_field_signature(information.c_name)
    var was = signature_types(running)
    var fits_now = class_fits_vector(information)
    if was["fits"] == "true" and fits_now {
        return "inline"
    }
    if was["fits"] == "true" {
        return "out of"
    }
    if fits_now {
        return "into"
    }
    return "references"
}

func moved_items(information: Analysis.ClassInfo, holder: Analysis.ClassInfo, change: String): String {
    var c_name = information.c_name
    var lines = List<String>()
    lines.append("static void {holder.c_name}___move_items(SpitePlan* plan, SpiteMoving* moving) \{")
    lines.append("SpiteLiveSet* holders = {holder.c_name}___live();")
    lines.append("int64_t old_stride = plan->old->size - (int64_t)sizeof(SpiteHeader);")
    lines.append("int64_t fresh_stride = (int64_t)sizeof({c_name}) - (int64_t)sizeof(SpiteHeader);")
    lines.append("(void)old_stride; (void)fresh_stride;")
    lines.append("for (int64_t index = 0; index < holders->count; index = index + 1) \{")
    lines.append("{holder.c_name}* holder = ({holder.c_name}*)holders->objects[index];")
    lines.append("if (holder->items_ == 0) continue;")
    if change == "out of" {
        lines.append("int64_t capacity = holder->capacity_ > 0 ? (int64_t)holder->capacity_ : 1;")
        lines.append("{c_name}** block = ({c_name}**)SPITE_MALLOC((size_t)(capacity * (int64_t)sizeof({c_name}*)));")
    } else {
        lines.append(
            "char* block = (char*)SPITE_MALLOC((size_t)((int64_t)holder->capacity_ * fresh_stride + (int64_t)sizeof(SpiteHeader)));",
        )
    }
    lines.append("for (int64_t item = 0; item < (int64_t)holder->item_count_; item = item + 1) \{")
    if change == "inline" {
        lines.append("char* was = (char*)(intptr_t)holder->items_ + item * old_stride;")
        lines.append("{c_name}* fresh = ({c_name}*)(block + item * fresh_stride);")
        lines.append("memset((char*)fresh + sizeof(SpiteHeader), 0, (size_t)fresh_stride);")
        lines.append("{c_name}___init___hot(fresh);")
        lines.append("{c_name}___fill(fresh, was, plan);")
        lines.append("spite_forget_fields(was, plan, moving);")
    }
    if change == "out of" {
        lines.append("char* was = (char*)(intptr_t)holder->items_ + item * old_stride;")
        lines.append("{c_name}* fresh = ({c_name}*)SPITE_MALLOC(sizeof({c_name}));")
        lines.append("memset(fresh, 0, sizeof({c_name}));")
        lines.append("fresh->header.ref_count = 1;")
        lines.append("fresh->header.class_id = {information.class_id};")
        lines.append("{c_name}___init___hot(fresh);")
        lines.append("{c_name}___fill(fresh, was, plan);")
        lines.append("spite_forget_fields(was, plan, moving);")
        lines.append("spite_live_add({c_name}___live(), fresh, &fresh->spite_live);")
        lines.append("#ifdef SPITE_TRACKS_{c_name}")
        lines.append("spite_track_{c_name}(fresh);")
        lines.append("#endif")
        lines.append("block[item] = fresh;")
    }
    if change == "into" {
        lines.append("{c_name}* object = (({c_name}**)(intptr_t)holder->items_)[item];")
        lines.append("char* now = object->spite_moved != 0 ? (char*)object->spite_moved : (char*)object;")
        lines.append("{c_name}* fresh = ({c_name}*)(block + item * fresh_stride);")
        lines.append("memcpy((char*)fresh + sizeof(SpiteHeader), now + sizeof(SpiteHeader), (size_t)fresh_stride);")
        lines.append("fresh->spite_moved = 0;")
        lines.append("fresh->spite_live = 0;")
        lines.append("spite_live_remove({c_name}___live(), object, &object->spite_live);")
        lines.append("#ifdef SPITE_TRACKS_{c_name}")
        lines.append("spite_untrack_{c_name}(object);")
        lines.append("#endif")
        lines.append("#ifdef SPITE_WEAK_{c_name}")
        lines.append("spite_weak_object_freed(object);")
        lines.append("#endif")
        lines.append("if (object->spite_moved != 0) spite_moving_free(moving, object->spite_moved);")
        lines.append("spite_moving_free(moving, object);")
    }
    lines.append("}")
    lines.append("spite_moving_free(moving, (void*)(intptr_t)holder->items_);")
    lines.append("holder->items_ = (int64_t)(intptr_t)block;")
    lines.append("}")
    lines.append("}")
    return lines.join("\n")
}

func shared_item_check(information: Analysis.ClassInfo, holder: Analysis.ClassInfo): String {
    var c_name = information.c_name
    var class_name = information.qualified_dotted
    var refusal = "refused: {class_name} now fits an Items' own memory, but an {holder.qualified_dotted} holds a {class_name} that is held elsewhere too, and an item kept in an Items' own memory is never shared, so moving it there would part it from what else holds it. Let go of the other reference (null it at the prompt), or undo the change"
    var lines = List<String>()
    lines.append("static const char* {holder.c_name}___shared_item(void) \{")
    lines.append("SpiteLiveSet* holders = {holder.c_name}___live();")
    lines.append("for (int64_t index = 0; index < holders->count; index = index + 1) \{")
    lines.append("{holder.c_name}* holder = ({holder.c_name}*)holders->objects[index];")
    lines.append("if (holder->items_ == 0) continue;")
    lines.append("for (int64_t item = 0; item < (int64_t)holder->item_count_; item = item + 1) \{")
    lines.append("{c_name}* object = (({c_name}**)(intptr_t)holder->items_)[item];")
    lines.append("if (object != 0 && object->header.ref_count > 1) return \"{escape_c_string(refusal)}\";")
    lines.append("}")
    lines.append("}")
    lines.append("return 0;")
    lines.append("}")
    return lines.join("\n")
}

func live_holders_of(item: Analysis.ClassInfo): List<Analysis.ClassInfo> {
    var holders = List<Analysis.ClassInfo>()
    var index = 0
    while index < classes.count() {
        var candidate = classes[index]
        var held = live_item_class(candidate)
        if held {
            if held.c_name == item.c_name {
                var items_field = candidate.find_field("items")
                var count_field = candidate.find_field("item_count")
                var capacity_field = candidate.find_field("capacity")
                if not items_field or not count_field or not capacity_field {
                    report(
                        "'{candidate.qualified_dotted}' keeps '{item.qualified_dotted}' objects in its own memory without the 'items', 'item_count' and 'capacity' attributes a reload moves them through",
                    )
                }
                holders.append(candidate)
            }
        }
        index = index + 1
    }
    return holders
}

func read_reload_renames(text: String) {
    reload_renames = Dictionary<String, String>()
    reload_renames_given = text.starts_with("given")
    var lines = text.split("\n")
    var index = 1
    while index < lines.count() {
        var words = lines[index].trim().split(" ")
        if words.count() == 3 {
            var key = "{words[0]}|{words[2]}"
            reload_renames[key] = words[1]
        }
        index = index + 1
    }
}

func renamed_from(information: Analysis.ClassInfo, attribute: String): String {
    var key = "{information.qualified_dotted}|{attribute}"
    if reload_renames[key] {
        if not used_renames.contains(key) {
            used_renames.append(key)
        }
        return reload_renames[key]
    }
    return ""
}

func unused_renames(): List<String> {
    var unused = List<String>()
    var keys = reload_renames.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if not used_renames.contains(key) {
            crash reload_renames[key]
            var old_name = reload_renames[key]
            var parts = key.split("|")
            crash parts[0] and parts[1]
            var class_name = parts[0]
            var new_name = parts[1]
            unused.append("{class_name}.attributes['{old_name}']: \"{new_name}\"")
        }
        index = index + 1
    }
    return unused
}

func note_support_slot(information: Analysis.ClassInfo, what: String) {
    if is_hot_class(information) {
        var position = builder.support_count()
        live_slot_positions.append(position)
        live_slot_owners.append("{information.c_name}___support")
        live_slot_displays.append("{information.qualified_dotted}{what}")
    }
}

func note_union_slot(information: Analysis.UnionInfo, what: String) {
    var owner = union_slot_owner(information)
    if not owner.is_empty() {
        var position = builder.support_count()
        live_slot_positions.append(position)
        live_slot_owners.append(information.c_name)
        live_slot_displays.append("{information.simple_name}{what}")
    }
}

func union_slot_owner(information: Analysis.UnionInfo): String {
    if not hot_reload {
        return ""
    }
    var index = 0
    while index < information.members.count() {
        var member = information.members[index]
        if is_hot_class(member) {
            return member.c_name
        }
        index = index + 1
    }
    return ""
}

func slot_live_supports() {
    var index = 0
    while index < live_slot_positions.count() {
        var position = live_slot_positions[index]
        var text = builder.support_at(position)
        var owner = live_slot_owners[index]
        var display = live_slot_displays[index]
        crash owner
        crash display
        var slotted = slotted_support(text, owner, display)
        crash not slotted.is_empty()
        builder.replace_support(position, slotted)
        index = index + 1
    }
}

func slotted_support(text: String, owner: String, display: String): String {
    var line_end = text.index_of("\n")
    if line_end <= 0 {
        return ""
    }
    var first = text.slice(0, line_end)
    var first_length = first.length()
    if not first.ends_with(") \{") or first.starts_with("static") {
        return ""
    }
    var signature = first.slice(0, first_length - 2)
    var open = signature.index_of("(")
    if open <= 0 {
        return ""
    }
    var head = signature.slice(0, open)
    var shaker = TreeShaker()
    var head_length = head.length()
    var name = shaker.name_before(head, head_length)
    var name_length = name.length()
    if name_length <= 0 {
        return ""
    }
    var returned = head.slice(0, head_length - name_length).trim()
    var signature_length = signature.length()
    var parameters = signature.slice(open + 1, signature_length - 1)
    var arguments = argument_names(parameters)
    var hot_signature = "{returned} {name}___hot({parameters})"
    builder.add_prototype("{hot_signature};")
    builder.add_slot(name, "static {returned} (*{name}___slot)({parameters}) = {name}___hot;")
    var result = "return "
    if returned == "void" {
        result = ""
    }
    builder.add_support("{signature} \{\n{result}{slot_read(name)}({arguments});\n}")
    hot_slot_names.append(name)
    hot_slot_owners.append(owner)
    hot_slot_displays.append(display)
    var text_length = text.length()
    var rest = text.slice(line_end, text_length)
    return "{hot_signature} \{{rest}"
}

func slot_every_helper() {
    var state = static_state_names()
    var slotted_names = Dictionary<String, Boolean>()
    var index = 0
    while index < hot_slot_names.count() {
        var slotted_name = hot_slot_names[index]
        slotted_names[slotted_name] = true
        index = index + 1
    }
    var support_total = builder.support_count()
    var position = 0
    while position < support_total {
        var text = builder.support_at(position)
        var rewritten = slotted_helpers(text, state, slotted_names)
        if rewritten != text {
            builder.replace_support(position, rewritten)
        }
        position = position + 1
    }
    var user_total = builder.user_count()
    position = 0
    while position < user_total {
        var text = builder.user_at(position)
        var rewritten = slotted_helpers(text, state, slotted_names)
        if rewritten != text {
            builder.replace_user(position, rewritten)
        }
        position = position + 1
    }
}

func static_state_names(): Dictionary<String, Boolean> {
    var state = Dictionary<String, Boolean>()
    note_static_state(builder.typedefs, state)
    note_static_state(builder.prototypes, state)
    note_static_state(builder.support_bodies, state)
    note_static_state(builder.user_bodies, state)
    return state
}

func note_static_state(texts: List<String>, state: Dictionary<String, Boolean>) {
    var shaker = TreeShaker()
    var index = 0
    while index < texts.count() {
        var lines = texts[index].split("\n")
        var depth = 0
        var line_index = 0
        while line_index < lines.count() {
            var line = lines[line_index]
            if depth == 0 and line.starts_with("static ") {
                var name = static_variable_of(line, shaker)
                if not name.is_empty() {
                    state[name] = true
                }
            }
            depth = depth + shaker.depth_change(line)
            line_index = line_index + 1
        }
        index = index + 1
    }
}

func static_variable_of(line: String, shaker: TreeShaker): String {
    var end = line.index_of("=")
    var bracket = line.index_of("[")
    if bracket > 0 and (end < 0 or bracket < end) {
        end = bracket
    }
    if end < 0 {
        end = line.index_of(";")
    }
    if end <= 0 {
        return ""
    }
    var head = line.slice(0, end).trim()
    if head.contains("(") {
        return ""
    }
    var head_length = head.length()
    var name = shaker.name_before(head, head_length)
    var shared = [
        "spite_program_arguments"
        "spite_check_point_wanted"
        "spite_assert_trace"
        "spite_assert_runs"
        "spite_assert_newest"
        "spite_assert_newest_count"
        "spite_assert_total"
    ]
    if name.starts_with("spite_lit_") or shared.contains(name) {
        return ""
    }
    return name
}

func slotted_helpers(
    text: String,
    state: Dictionary<String, Boolean>,
    slotted_names: Dictionary<String, Boolean>,
): String {
    var lines = text.split("\n")
    var shaker = TreeShaker()
    var result = List<String>()
    var changed = false
    var outer_depth = 0
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var signature = ""
        if outer_depth == 0 {
            signature = helper_signature(line, shaker, slotted_names)
        }
        if signature.is_empty() {
            result.append(line)
            outer_depth = outer_depth + shaker.depth_change(line)
            index = index + 1
        } else {
            var depth = 0
            var last = index
            var body = List<String>()
            var searching = true
            while searching and last < lines.count() {
                var body_line = lines[last]
                body.append(body_line)
                depth = depth + shaker.depth_change(body_line)
                if depth <= 0 {
                    searching = false
                } else {
                    last = last + 1
                }
            }
            var function_text = body.join("\n")
            var rewritten = line
            if not searching and not holds_state(function_text, state) {
                rewritten = slotted_helper(line, signature, shaker, slotted_names)
                changed = true
            }
            result.append(rewritten)
            var copied = index + 1
            while copied <= last and copied < lines.count() {
                result.append(lines[copied])
                copied = copied + 1
            }
            index = last + 1
        }
    }
    if not changed {
        return text
    }
    return result.join("\n")
}

func helper_signature(line: String, shaker: TreeShaker, slotted_names: Dictionary<String, Boolean>): String {
    if line.starts_with("static") or line.starts_with("#") or line.starts_with("typedef") or line.starts_with(" ") {
        return ""
    }
    var brace = line.index_of(") \{")
    if brace <= 0 {
        return ""
    }
    var signature = line.slice(0, brace + 1)
    var open = signature.index_of("(")
    if open <= 0 or signature.contains("...") or signature.contains("[") {
        return ""
    }
    var head = signature.slice(0, open)
    if head.contains("=") or head.contains(";") or head.contains("\{") or not head.contains(" ") {
        return ""
    }
    var head_length = head.length()
    var name = shaker.name_before(head, head_length)
    var name_length = name.length()
    var returned = head.slice(0, head_length - name_length).trim()
    if name.is_empty() or returned.is_empty() or name == "main" or name.ends_with("___hot") {
        return ""
    }
    if slotted_names[name] == true {
        return ""
    }
    if name.starts_with("spite_hot_") or name.starts_with("spite_reload_") or name.starts_with("spite_settings_") {
        return ""
    }
    return signature
}

func holds_state(text: String, state: Dictionary<String, Boolean>): Boolean {
    var lines = text.split("\n")
    var line_index = 1
    while line_index < lines.count() {
        var trimmed = lines[line_index].trim()
        if trimmed.starts_with("static ") {
            return true
        }
        line_index = line_index + 1
    }
    var text_length = text.length()
    var index = 0
    while index < text_length {
        var at_start = index == 0
        if not at_start {
            var before = text.code_at(index - 1)
            at_start = not is_identifier_code(before)
        }
        if at_start and text.matches_at("spite_", index) {
            var end = index
            var inside = true
            while end < text_length and inside {
                var code = text.code_at(end)
                inside = is_identifier_code(code)
                if inside {
                    end = end + 1
                }
            }
            var name = text.slice(index, end)
            if state.has(name) {
                return true
            }
            index = end
        } else {
            index = index + 1
        }
    }
    return false
}

func is_identifier_code(code: Integer): Boolean {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func slotted_helper(
    line: String,
    signature: String,
    shaker: TreeShaker,
    slotted_names: Dictionary<String, Boolean>,
): String {
    var open = signature.index_of("(")
    var head = signature.slice(0, open)
    var head_length = head.length()
    var name = shaker.name_before(head, head_length)
    var name_length = name.length()
    var returned = head.slice(0, head_length - name_length).trim()
    var signature_length = signature.length()
    var parameters = signature.slice(open + 1, signature_length - 1)
    var hot_signature = "{returned} {name}___hot({parameters})"
    var line_length = line.length()
    var rest = line.slice(signature_length, line_length)
    if slotted_names.has(name) {
        return "{hot_signature}{rest}"
    }
    slotted_names[name] = false
    var arguments = argument_names(parameters)
    builder.add_prototype("{signature};")
    builder.add_prototype("{hot_signature};")
    builder.add_slot(name, "static {returned} (*{name}___slot)({parameters}) = {name}___hot;")
    var result = "return "
    if returned == "void" {
        result = ""
    }
    builder.add_support("{signature} \{\n{result}{slot_read(name)}({arguments});\n}")
    hot_slot_names.append(name)
    hot_slot_owners.append(name)
    hot_slot_displays.append(name)
    return "{hot_signature}{rest}"
}

func slot_read(name: String): String {
    return "__atomic_load_n(&{name}___slot, __ATOMIC_ACQUIRE)"
}

func argument_names(parameters: String): String {
    var trimmed = parameters.trim()
    if trimmed == "void" or trimmed.is_empty() {
        return ""
    }
    var names = List<String>()
    var depth = 0
    var start = 0
    var index = 0
    var parameters_length = parameters.length()
    while index <= parameters_length {
        var at_end = index == parameters_length
        var code = 44
        if not at_end {
            code = parameters.code_at(index)
        }
        if code == 40 {
            depth = depth + 1
        } else if code == 41 {
            depth = depth - 1
        } else if code == 44 and depth == 0 {
            var parameter = parameters.slice(start, index)
            var named = c_parameter_name(parameter)
            names.append(named)
            start = index + 1
        }
        index = index + 1
    }
    return names.join(", ")
}

func c_parameter_name(parameter: String): String {
    var trimmed = parameter.trim()
    var pointer = trimmed.index_of("(*")
    if pointer >= 0 {
        var trimmed_length = trimmed.length()
        var after = trimmed.slice(pointer + 2, trimmed_length)
        var close = after.index_of(")")
        crash close > 0
        return after.slice(0, close)
    }
    var shaker = TreeShaker()
    var trimmed_length = trimmed.length()
    return shaker.name_before(trimmed, trimmed_length)
}

func live_support_types(): String {
    return "typedef struct SpiteLayoutField \{ const char* name; const char* type; int64_t offset; int64_t size; void (*release)(void*); } SpiteLayoutField;\ntypedef struct SpiteLayout \{ const char* name; int64_t size; int64_t count; const SpiteLayoutField* fields; int32_t fits; } SpiteLayout;\ntypedef struct SpiteLiveSet \{ void** objects; int64_t** places; int64_t count; int64_t capacity; int32_t lock; } SpiteLiveSet;"
}

func emit_live_support() {
    assert hot_reload
    var types = live_support_types()
    builder.add_typedef(types)
    builder.add_prototype("void spite_live_add(SpiteLiveSet* set, void* object, int64_t* place);")
    builder.add_prototype("void spite_live_remove(SpiteLiveSet* set, void* object, int64_t* place);")
    builder.add_support(
        "void spite_live_add(SpiteLiveSet* set, void* object, int64_t* place) \{\nSPITE_LOCK(set->lock);\nif (set->count == set->capacity) \{\nset->capacity = set->capacity == 0 ? 64 : set->capacity * 2;\nset->objects = (void**)realloc(set->objects, (size_t)set->capacity * sizeof(void*));\nset->places = (int64_t**)realloc(set->places, (size_t)set->capacity * sizeof(int64_t*));\nif (set->objects == 0 || set->places == 0) \{\nfflush(stdout);\nfprintf(stderr, \"spite: out of memory for the list of live objects a reload moves to a new layout\\n\");\nexit(1);\n}\n}\nset->objects[set->count] = object;\nset->places[set->count] = place;\n*place = set->count + 1;\nset->count = set->count + 1;\nSPITE_UNLOCK(set->lock);\n}",
    )
    builder.add_support(
        "void spite_live_remove(SpiteLiveSet* set, void* object, int64_t* place) \{\nSPITE_LOCK(set->lock);\nint64_t index = *place - 1;\nif (index < 0 || index >= set->count || set->objects[index] != object) \{\nfflush(stdout);\nfprintf(stderr, \"spite: an object was released that the list of live objects does not hold\\n\");\nexit(1);\n}\nint64_t last = set->count - 1;\nset->objects[index] = set->objects[last];\nset->places[index] = set->places[last];\n*set->places[index] = index + 1;\nset->count = last;\n*place = 0;\nSPITE_UNLOCK(set->lock);\n}",
    )
}

func add_hot_slot(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var hot_name = "{function.c_name}___hot"
    builder.add_prototype("{named_signature(information, function, hot_name)};")
    var slot_declarator = "(*{function.c_name}___slot)"
    builder.add_slot(function.c_name, "static {named_signature(information, function, slot_declarator)} = {hot_name};")
    var arguments = List<String>()
    arguments.append("self")
    var index = 0
    while index < function.parameters.count() {
        var argument_code = c_value_name(function.parameters[index].name)
        arguments.append(argument_code)
        index = index + 1
    }
    var returned = "return "
    var function_return_type = function.return_type
    if type_shape.is_void(function_return_type) {
        returned = ""
    }
    builder.add_user(
        "{function_signature(information, function)} \{\n{returned}{slot_read(function.c_name)}({arguments.join(", ")});\n}",
    )
    hot_slot_names.append(function.c_name)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}.{function.name}")
}

func note_fact(key: String) {
    program_facts.note(key, fact_owner)
}

func runs_in_host(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not reload_host or reload_owners.contains(information.c_name) or not function.has_body {
        return false
    }
    if is_inline_supplied(function) {
        return false
    }
    return reload_host.host_prototypes[function.c_name] == "{function_signature(information, function)};"
}

func note_hot_slot(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    hot_slot_names.append(function.c_name)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}.{function.name}")
}

func partial_falls_short(): Boolean {
    if not reload_host {
        return false
    }
    var prototype_text = builder.prototypes.join("\n")
    var bodies = builder.bodies_text()
    reload_host.split_program(prototype_text, bodies)
    var changed = reload_host.changed_signatures(hot_slot_names, hot_slot_owners, reload_owners)
    var index = 0
    while index < changed.count() {
        if reload_host.host_slots.has(changed[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func add_hot_functions_slot(information: Analysis.ClassInfo, list_name: String) {
    var functions_name = "{information.c_name}___functions"
    builder.add_prototype("{list_name}* {functions_name}___hot({information.c_name}* self);")
    builder.add_slot(
        functions_name,
        "static {list_name}* (*{functions_name}___slot)({information.c_name}* self) = {functions_name}___hot;",
    )
    builder.add_support(
        "{list_name}* {functions_name}({information.c_name}* self) \{\nreturn {slot_read(functions_name)}(self);\n}",
    )
    hot_slot_names.append(functions_name)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}'s list of functions")
}

func add_hot_initialize_slot(information: Analysis.ClassInfo) {
    var initialize_name = "{information.c_name}___init"
    builder.add_prototype("void {initialize_name}___hot({information.c_name}* self);")
    builder.add_slot(
        initialize_name,
        "static void (*{initialize_name}___slot)({information.c_name}* self) = {initialize_name}___hot;",
    )
    builder.add_support("void {initialize_name}({information.c_name}* self) \{\n{slot_read(initialize_name)}(self);\n}")
    hot_slot_names.append(initialize_name)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}'s attribute defaults")
}

func hot_reload_body(name: String): String {
    switch name {
        "compiler": return "return {owned_c_text(hot_reload_compiler)};"
        "build_arguments": return "return {owned_c_text(hot_reload_arguments)};"
        "program_file": return "return {owned_c_text(hot_reload_program_file)};"
        _: {
            if name == "loaded_folders" {
                var folders = List<String>()
                var index = 0
                while index < loaded_folders.count() {
                    var folder = loaded_folders[index]
                    var folder_length = folder.length()
                    var without_slash = folder.slice(0, folder_length - 1)
                    if not is_in_checkout(folder) {
                        folders.append(without_slash)
                    }
                    index = index + 1
                }
                var joined = folders.join("\n")
                return "return {owned_c_text(joined)};"
            }
            if name == "watcher_entry" and hot_reload {
                return "return (int64_t)(intptr_t)&spite_hot_reload_thread;"
            }
            if name == "watcher_entry" {
                return "return 0;"
            }
            if not hot_reload {
                return "(void)library_;\nreturn spite_string_from_cstring_owned(\"this program was not built with --hot-reload\");"
            }
            ensure_world_gate()
            return "typedef const char* (*SpiteHotBind)(void* (*)(const char*), int32_t (*)(const char*, void*));\n#ifdef _WIN32\nSpiteHotBind bind = (SpiteHotBind)(void*)GetProcAddress((HMODULE)(intptr_t)library_, \"spite_reload_bind\");\n#else\nSpiteHotBind bind = (SpiteHotBind)dlsym((void*)(intptr_t)library_,\"spite_reload_bind\");\n#endif\nif (bind == 0) return spite_string_from_cstring_owned(\"spite_reload_bind\");\ntypedef const char* (*SpiteHotInstalls)(int64_t);\n#ifdef _WIN32\nSpiteHotInstalls installs = (SpiteHotInstalls)(void*)GetProcAddress((HMODULE)(intptr_t)library_, \"spite_reload_installs\");\n#else\nSpiteHotInstalls installs = (SpiteHotInstalls)dlsym((void*)(intptr_t)library_, \"spite_reload_installs\");\n#endif\nif (installs != 0) for (int64_t spite_index = 0; installs(spite_index) != 0; spite_index = spite_index + 1) \{ const char* spite_held = spite_machine_waiting(installs(spite_index)); if (spite_held != 0) \{ char spite_text[512]; snprintf(spite_text, sizeof spite_text, \"waits: %s\", spite_held); return spite_string_from_cstring_owned(spite_text); } }\nif (spite_world_stop() == 0) return spite_string_from_cstring_owned(\"refused: a task on another thread did not reach a loop's check point within 10 seconds, so nothing was swapped in and no object moved under it: reload again once that work has finished\");\nconst char* missing = bind(spite_hot_find, spite_hot_install);\nspite_world_start();\nif (missing == 0) spite_settings_reread();\nreturn spite_string_from_cstring_owned(missing == 0 ? \"\" : missing);"
        }
    }
}

func emit_hot_reload_support() {
    assert hot_reload
    var hot_reload_class = find_class_by_qualified("HotReload")
    crash hot_reload_class
    var hot_reload_instance = singleton_call(hot_reload_class)
    builder.add_prototype("static void* spite_hot_reload_thread(void* unused);")
    builder.add_prototype("static void* spite_hot_find(const char* name);")
    builder.add_prototype("static int32_t spite_hot_install(const char* name, void* address);")
    builder.add_prototype("void* spite_hot_realloc(void* pointer, size_t size);")
    builder.add_prototype("void spite_hot_free(void* pointer);")
    builder.add_support(
        "static void* spite_hot_reload_thread(void* unused) \{\n(void)unused;\nspite_fault_thread();\nHotReload* spite_hot_reload = {hot_reload_instance};\nHotReload_watch(spite_hot_reload);\nHotReload___release(spite_hot_reload);\nreturn 0;\n}",
    )
    builder.add_support(
        "void* spite_hot_realloc(void* pointer, size_t size) \{\nreturn SPITE_REALLOC(pointer, size);\n}",
    )
    builder.add_support("void spite_hot_free(void* pointer) \{\nSPITE_FREE(pointer);\n}")
    emit_machine_frame_table()
    var settings = settings_reread_lines()
    builder.add_prototype("void spite_settings_reread(void);")
    builder.add_support(
        "static int32_t spite_settings_changed = 0;\nvoid spite_settings_reread(void) \{\nif (spite_settings_changed == 0) return;\nspite_settings_changed = 0;\n{settings.join("\n")}\n}",
    )
    slot_every_helper()
    var names = List<String>()
    var cells = List<String>()
    var index = 0
    while index < hot_slot_names.count() {
        names.append("\"{hot_slot_names[index]}\"")
        cells.append("(void**)&{hot_slot_names[index]}___slot")
        index = index + 1
    }
    names.append("0")
    cells.append("0")
    builder.add_support(
        "static const char* spite_hot_slot_names[] = \{ {names.join(", ")} };\nstatic void** spite_hot_slot_cells[] = \{ {cells.join(", ")} };\nstatic int32_t spite_hot_install(const char* name, void* address) \{\nfor (int64_t index = 0; spite_hot_slot_names[index] != 0; index = index + 1) \{\nif (strcmp(spite_hot_slot_names[index], name) == 0) \{ if (address != 0) \{ __atomic_store_n(spite_hot_slot_cells[index], address, __ATOMIC_SEQ_CST); if (strcmp(name, \"Environment_Environment\") == 0 || strcmp(name, \"Build___init\") == 0) spite_settings_changed = 1; } return 1; }\n}\nreturn 0;\n}",
    )
}

func emit_machine_frame_table() {
    builder.add_typedef(
        "typedef struct SpiteMachineCount \{ struct SpiteMachineCount* next; char* name; char* shown; int64_t count; } SpiteMachineCount;",
    )
    builder.add_prototype("int64_t* spite_machine_frames(const char* name, const char* shown);")
    builder.add_prototype("static const char* spite_machine_waiting(const char* name);")
    var lines = List<String>()
    lines.append("static SpiteMachineCount* spite_machine_counts = 0;")
    lines.append("static char* spite_machine_text(const char* text) \{")
    lines.append("size_t spite_length = strlen(text) + 1;")
    lines.append("char* spite_kept = (char*)malloc(spite_length);")
    lines.append(
        "if (spite_kept == 0) \{ fflush(stdout); fprintf(stderr, \"spite: out of memory for the table of the waits a reload holds for\\n\"); exit(1); }",
    )
    lines.append("memcpy(spite_kept, text, spite_length);")
    lines.append("return spite_kept;")
    lines.append("}")
    lines.append("int64_t* spite_machine_frames(const char* name, const char* shown) \{")
    lines.append(
        "for (SpiteMachineCount* spite_at = spite_machine_counts; spite_at != 0; spite_at = spite_at->next) if (strcmp(spite_at->name, name) == 0) return &spite_at->count;",
    )
    lines.append("SpiteMachineCount* spite_made = (SpiteMachineCount*)malloc(sizeof(SpiteMachineCount));")
    lines.append(
        "if (spite_made == 0) \{ fflush(stdout); fprintf(stderr, \"spite: out of memory for the table of the waits a reload holds for\\n\"); exit(1); }",
    )
    lines.append("spite_made->name = spite_machine_text(name);")
    lines.append("spite_made->shown = spite_machine_text(shown);")
    lines.append("spite_made->count = 0;")
    lines.append("spite_made->next = spite_machine_counts;")
    lines.append("spite_machine_counts = spite_made;")
    lines.append("return &spite_made->count;")
    lines.append("}")
    lines.append("static const char* spite_machine_waiting(const char* name) \{")
    lines.append(
        "for (SpiteMachineCount* spite_at = spite_machine_counts; spite_at != 0; spite_at = spite_at->next) if (strcmp(spite_at->name, name) == 0 && spite_at->count > 0) return spite_at->shown;",
    )
    lines.append("return 0;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func settings_reread_lines(): List<String> {
    var lines = List<String>()
    var index = 0
    while index < singleton_classes.count() {
        var information = singleton_classes[index]
        var made = "__atomic_load_n(&spite_singleton_{information.c_name}_cache, __ATOMIC_ACQUIRE)"
        if information.qualified_dotted == "Environment" {
            lines.append(
                "\{ Environment* environment = {made}; if (environment != 0) Environment_Environment(environment); }",
            )
        } else if information.qualified_dotted == "Build" {
            lines.append("\{ Build* build = {made}; if (build != 0) Build___init(build); }")
        }
        index = index + 1
    }
    return lines
}

func seed_class_names(names: List<String>, identities: List<String>) {
    var index = 0
    while index < names.count() {
        crash identities[index]
        var identity = identities[index]
        var name = names[index]
        class_names_by_id.append(name)
        class_identities.append(identity)
        seeded_class_ids[identity] = index
        index = index + 1
    }
}

func hot_manifest(): String {
    var manifest = builder.host.host_manifest(
        hot_slot_names,
        hot_slot_displays,
        class_names_by_id,
        class_identities,
        builder.typedefs,
    )
    var key_lines = analysis_manifest_lines()
    if key_lines.is_empty() {
        return manifest
    }
    return "{manifest}\n{key_lines.join("\n")}"
}

func baseline_manifest(host_text: String, reload: HotReloadLibrary): String {
    var lines = reload.baseline_lines(host_text, builder.typedefs, class_names_by_id, class_identities, constant_texts)
    var analysis = analysis_manifest_lines()
    var index = 0
    while index < analysis.count() {
        lines.append(analysis[index])
        index = index + 1
    }
    return lines.join("\n")
}

func analysis_manifest_lines(): List<String> {
    var fact_lines = snapshot_manifest_lines()
    var signed = field_signatures.keys()
    var signed_index = 0
    while signed_index < signed.count() {
        var signed_name = signed[signed_index]
        crash field_signatures[signed_name]
        fact_lines.append("fields {signed_name} {field_signatures[signed_name]}")
        signed_index = signed_index + 1
    }
    var variant_index = 0
    while variant_index < lent_variant_lines.count() {
        fact_lines.append(lent_variant_lines[variant_index])
        variant_index = variant_index + 1
    }
    var instance_index = 0
    while instance_index < instance_lines.count() {
        fact_lines.append(instance_lines[instance_index])
        instance_index = instance_index + 1
    }
    var literal_index = 0
    while literal_index < literal_lines.count() {
        fact_lines.append(literal_lines[literal_index])
        literal_index = literal_index + 1
    }
    var declared_index = 0
    while declared_index < classes.count() {
        var declaring = classes[declared_index]
        if is_hot_class(declaring) and not declaring.is_generic_template {
            var declared_names = declaring.declared_functions.map_c_names()
            fact_lines.append("declared {declaring.c_name}\t{declared_names.join(",")}")
        }
        declared_index = declared_index + 1
    }
    var union_index = 0
    while union_index < unions.count() {
        var shaped = unions[union_index]
        if shaped.is_shape {
            var shaped_members = shaped.members.map_c_names()
            fact_lines.append("members {shaped.c_name}\t{shaped_members.join(",")}")
        }
        union_index = union_index + 1
    }
    settle_wait_facts()
    var waiting_now = wait_facts.waits.keys()
    var waiting_index = 0
    while waiting_index < waiting_now.count() {
        fact_lines.append("waits {waiting_now[waiting_index]}")
        waiting_index = waiting_index + 1
    }
    var owner_index = 0
    while owner_index < hot_slot_names.count() and owner_index < hot_slot_owners.count() {
        fact_lines.append("owner {hot_slot_names[owner_index]} {hot_slot_owners[owner_index]}")
        owner_index = owner_index + 1
    }
    return fact_lines
}

func program_source_paths(): List<String> {
    var paths = List<String>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if is_hot_class(information) {
            append_new_path(paths, information.source_path)
            var function_index = 0
            while function_index < information.declared_functions.count() {
                append_new_path(paths, information.declared_functions[function_index].source_path)
                function_index = function_index + 1
            }
        }
        index = index + 1
    }
    return paths
}

func append_new_path(paths: List<String>, path: String) {
    if not path.is_empty() and not paths.contains(path) {
        paths.append(path)
    }
}

func classes_of_paths(paths: List<String>): List<String> {
    var owners = List<String>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        var class_paths = List<String>()
        append_new_path(class_paths, information.source_path)
        var function_index = 0
        while function_index < information.declared_functions.count() {
            append_new_path(class_paths, information.declared_functions[function_index].source_path)
            function_index = function_index + 1
        }
        var path_index = 0
        while path_index < class_paths.count() {
            if paths.contains(class_paths[path_index]) and not owners.contains(information.c_name) {
                owners.append(information.c_name)
            }
            path_index = path_index + 1
        }
        index = index + 1
    }
    return owners
}

func reload_library(
    reload: HotReloadLibrary,
    changed_paths: List<String>,
    rebuilt: List<String>,
    partial: Boolean,
): String {
    var owners = classes_of_paths(changed_paths)
    if not partial or not reload.split_done {
        var prototype_text = builder.prototypes.join("\n")
        var bodies = builder.bodies_text()
        reload.split_program(prototype_text, bodies)
    }
    if not partial {
        add_reached_classes(reload, owners)
        add_layout_owners(reload, owners)
    }
    var growing = true
    while growing {
        var changed_signatures = reload.changed_signatures(hot_slot_names, hot_slot_owners, owners)
        var callers = reload.callers_of(changed_signatures, hot_slot_names, hot_slot_owners, owners)
        growing = not callers.is_empty()
        var caller_index = 0
        while caller_index < callers.count() {
            owners.append(callers[caller_index])
            caller_index = caller_index + 1
        }
    }
    var index = 0
    while index < owners.count() {
        var owner = find_class_by_c_name(owners[index])
        if owner {
            rebuilt.append(owner.qualified_dotted)
        }
        index = index + 1
    }
    var local_only = migration_local_names()
    return reload.library(builder, hot_slot_names, hot_slot_owners, owners, local_only)
}

func add_layout_owners(reload: HotReloadLibrary, owners: List<String>) {
    assert not changing_layouts.is_empty()
    var shaker = reload.program_shaker
    var index = 0
    while index < shaker.pieces.count() {
        crash shaker.piece_names[index]
        var name = shaker.piece_names[index]
        var piece = shaker.pieces[index]
        var layout_piece = not name.is_empty() and mentions_migrating_layout(piece)
        if layout_piece and not is_local_migration_piece(name) {
            var owner = hot_owner_of(name)
            if owner.is_empty() {
                if not reload.stale_pieces.contains(name) {
                    reload.stale_pieces.append(name)
                }
            } else if not owners.contains(owner) {
                owners.append(owner)
            }
        }
        index = index + 1
    }
}

func is_local_migration_piece(name: String): Boolean {
    var helpers = [
        "spite_migrate_all"
        "spite_moving_release"
        "spite_moving_free"
        "spite_moving_finish"
        "spite_same_layout"
        "spite_old_field"
        "spite_plan"
        "spite_plan_finish"
        "spite_forget_fields"
    ]
    if helpers.contains(name) {
        return true
    }
    if name.ends_with("___shared_item") {
        return true
    }
    var index = 0
    while index < migrating_classes.count() {
        var c_name = migrating_classes[index]
        if name == "{c_name}___layout" or name.starts_with("{c_name}___release_field_") {
            return true
        }
        if name == "{c_name}___fill" or name == "{c_name}___prepare" or name == "{c_name}___move_all" {
            return true
        }
        index = index + 1
    }
    return name.ends_with("___move_items")
}

func add_reached_classes(reload: HotReloadLibrary, owners: List<String>) {
    var changed = reload.changed_bodies(constant_texts)
    var seen = Dictionary<String, Boolean>()
    var index = 0
    while index < changed.count() {
        var changed_name = changed[index]
        seen[changed_name] = true
        index = index + 1
    }
    index = 0
    while index < changed.count() {
        var name = changed[index]
        var owner = hot_owner_of(name)
        var migration_piece = not migrating_classes.is_empty() and is_local_migration_piece(name)
        var host_only = name.starts_with("spite_hot_") or name.starts_with("spite_settings_")
        var static_function = owner.is_empty() and reload.is_static_function(name)
        if static_function {
            add_callers_of_static(reload, name, changed, seen)
        } else if owner.is_empty() and not migration_piece and not host_only {
            reload.stale_pieces.append(name)
        } else if not owner.is_empty() and not owners.contains(owner) {
            owners.append(owner)
        }
        index = index + 1
    }
}

func add_callers_of_static(
    reload: HotReloadLibrary,
    name: String,
    changed: List<String>,
    seen: Dictionary<String, Boolean>,
) {
    var callers = reload.pieces_mentioning(name)
    var index = 0
    while index < callers.count() {
        var caller = callers[index]
        if not seen.has(caller) {
            seen[caller] = true
            changed.append(caller)
        }
        index = index + 1
    }
}

func hot_owner_of(piece_name: String): String {
    var slot = piece_name
    if piece_name.ends_with("___hot") {
        var name_length = piece_name.length()
        slot = piece_name.slice(0, name_length - 6)
    }
    if hot_owner_indexed != hot_slot_names.count() {
        hot_owner_indexed = hot_slot_names.count()
        hot_owner_index = Dictionary<String, String>()
        var index = 0
        while index < hot_slot_names.count() and index < hot_slot_owners.count() {
            var slot_name = hot_slot_names[index]
            if not hot_owner_index.has(slot_name) {
                hot_owner_index[slot_name] = hot_slot_owners[index]
            }
            index = index + 1
        }
    }
    var owner = hot_owner_index[slot]
    if owner {
        return owner
    }
    return ""
}

func frame_result_body(information: Analysis.ClassInfo): String {
    crash information.codegen_types[0]
    var result_type = information.codegen_types[0]
    var frame = "(void*)(intptr_t)self->_frame_"
    var result_class = type_shape.as_class_ref(result_type)
    if result_class {
        if result_class.c_name == "Nothing" {
            return "(void){frame};\nreturn Nothing___default();"
        }
    }
    var result_c = c_type_name(result_type)
    return "return ((struct \{ SpiteFrame spite_head; {result_c} spite_result; }*){frame})->spite_result;"
}

func record_call(callee: String) {
    assert not resumable_mode and not current_function_c_name.is_empty()
    call_edge_callers.append(current_function_c_name)
    call_edge_callees.append(callee)
}

func hoisted_wait(
    callee: String,
    receiver: ExpressionResult,
    receiver_owned: Boolean,
    argument_codes: List<String>,
    return_type: Analysis.SpiteType,
): ExpressionResult? {
    var nothing_before = List<String>()
    return hoisted_wait_after(callee, nothing_before, receiver, receiver_owned, argument_codes, return_type)
}

func hoisted_wait_after(
    callee: String,
    before: List<String>,
    receiver: ExpressionResult,
    receiver_owned: Boolean,
    argument_codes: List<String>,
    return_type: Analysis.SpiteType,
): ExpressionResult? {
    assert resumable_mode and conditional_depth == 0 and waiting_names.has(callee)
    var shape_caller = shape_callers_by_c_name[callee]
    if shape_caller {
        return waited_shape_call(shape_caller, before, receiver, receiver_owned, argument_codes, return_type)
    }
    assert ensure_machine(callee)
    wait_mark_counters.append(temporary_counter)
    var start = builder.user_count()
    wait_mark_positions.append(start)
    before.each(builder.add_user)
    resume_point_count = resume_point_count + 1
    var point = resume_point_count
    var receiver_type = receiver.type
    var releases = type_needs_drop(receiver_type)
    var held = receiver.code
    if releases and not receiver_owned {
        held = retain_call(receiver_type, receiver.code)
    }
    var receiver_temporary = "self"
    if receiver.code == "self" {
        releases = false
    } else {
        receiver_temporary = next_temporary()
        builder.add_user("{c_type_name(receiver_type)} {receiver_temporary} = {held};")
    }
    var passed = argument_codes.copy()
    passed.prepend(receiver_temporary)
    var slot = "spite_frame->spite_wait_{point}"
    builder.add_user("{slot} = {callee}___begin({passed.join(", ")});")
    builder.add_user("spite_resume_{point}: if (!{machine_step_call(callee, slot)}) SPITE_SUSPEND({point});")
    var result_temporary = next_temporary()
    var code = result_temporary
    if type_shape.is_void(return_type) {
        builder.add_user("bool {result_temporary} = true;")
        code = "(void){result_temporary}"
    } else {
        builder.add_user("{c_type_name(return_type)} {result_temporary} = (({callee}___frame*){slot})->spite_result;")
    }
    builder.add_user("SPITE_FREE({slot});")
    if releases {
        builder.add_user("{release_call(receiver_type, receiver_temporary)};")
    }
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(result_temporary)
    return ExpressionResult(code, return_type)
}

func holds_in_order(result: ExpressionResult): Boolean {
    var result_type = result.type
    if not resumable_mode or type_shape.is_void(result_type) or not result.constant_text.is_empty() {
        return false
    }
    return not stable_code(result.code)
}

func stable_code(code: String): Boolean {
    if code.is_empty() {
        return true
    }
    var first = code.code_at(0)
    if first >= 48 and first <= 57 or first == 45 or first == 39 {
        var index = 1
        while index < code.length() {
            var number_code = code.code_at(index)
            if not is_word_code(number_code) and number_code != 46 {
                return false
            }
            index = index + 1
        }
        return true
    }
    var index = 0
    while index < code.length() {
        var word_code = code.code_at(index)
        if not is_word_code(word_code) {
            return false
        }
        index = index + 1
    }
    return true
}

func hold_in_order(result: ExpressionResult, expression: Syntax.Expressions.Expression): HeldOperand? {
    assert holds_in_order(result)
    var token = next_temporary()
    var result_type = result.type
    var operand = ExpressionResult(token, result_type)
    operand.owning_override = result.owning_override
    operand.borrowed_from = result.borrowed_from
    operand.peek_union = result.peek_union
    operand.peek_field = result.peek_field
    operand.peek_object = result.peek_object
    var position = builder.user_count()
    var marks_before = wait_mark_counters.count()
    var held = HeldOperand(token, result, operand, position, marks_before, temporary_counter)
    held.retained = type_needs_drop(result_type) and not owns(result, expression)
    return held
}

func settle_in_order(held: HeldOperand?, made: ExpressionResult): ExpressionResult {
    if not held {
        return made
    }
    var original = held.original
    if not waited_since(held.marks_before) {
        made.code = replaced_name(made.code, held.token, original.code)
        var index = held.position
        while index < builder.user_count() {
            var line = builder.user_at(index)
            if mentions_name(line, held.token) {
                var restored = replaced_name(line, held.token, original.code)
                builder.replace_user(index, restored)
            }
            index = index + 1
        }
        return made
    }
    var original_type = original.type
    var kept = original.code
    if held.retained {
        kept = retain_call(original_type, original.code)
    }
    var spill = "{c_type_name(original_type)} {held.token} = {kept};"
    insert_wait_line(held.position, held.counter_before, spill, held.token)
    if not held.retained {
        return made
    }
    var made_type = made.type
    var release = release_call(original_type, held.token)
    if type_shape.is_void(made_type) {
        made.code = "(\{ {made.code}; {release}; })"
        return made
    }
    var kept_result = next_temporary()
    var kept_code = made.code
    if type_needs_drop(made_type) and made.owning_override == false {
        kept_code = retain_call(made_type, made.code)
        made.owning_override = true
    }
    made.code = "(\{ {c_type_name(made_type)} {kept_result} = {kept_code}; {release}; {kept_result}; })"
    return made
}

func insert_wait_line(position: Integer, counter_before: Integer, line: String, result: String) {
    builder.insert_user(position, line)
    shift_wait_marks(position)
    wait_mark_counters.append(counter_before)
    wait_mark_positions.append(position)
    wait_mark_ends.append(position + 1)
    wait_mark_results.append(result)
}

func replaced_name(text: String, name: String, replacement: String): String {
    var pieces = List<String>()
    var from = 0
    var name_length = name.length()
    var text_length = text.length()
    var copied = 0
    while from < text_length {
        var rest = text.slice(from, text_length)
        var found = rest.index_of(name)
        if found < 0 {
            from = text_length
        } else {
            var start = from + found
            var after = start + name_length
            var code_before = 32
            if start > 0 {
                code_before = text.code_at(start - 1)
            }
            var code_after = text.code_at(after)
            var cut_before = start == 0 or not is_word_code(code_before)
            var cut_after = after >= text_length or not is_word_code(code_after)
            if cut_before and cut_after {
                var before = text.slice(copied, start)
                pieces.append(before)
                pieces.append(replacement)
                copied = after
            }
            from = after
        }
    }
    var tail = text.slice(copied, text_length)
    pieces.append(tail)
    return pieces.join("")
}

func waited_since(marks_before: Integer): Boolean {
    return resumable_mode and wait_mark_counters.count() > marks_before
}

func wrap_waits(
    position: Integer,
    marks_before: Integer,
    counter_before: Integer,
    opening: List<String>,
    closing: List<String>,
    result: String,
) {
    var index = opening.count() - 1
    while index >= 0 {
        crash opening[index]
        builder.insert_user(position, opening[index])
        shift_wait_marks(position)
        index = index - 1
    }
    closing.each(builder.add_user)
    while wait_mark_counters.count() > marks_before {
        drop_last_wait_mark()
    }
    wait_mark_counters.append(counter_before)
    wait_mark_positions.append(position)
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(result)
}

func wait_for_dropped_handle(local_type: Analysis.SpiteType, code: String) {
    assert resumable_mode and conditional_depth == 0
    var listed = type_shape.as_list(local_type)
    if listed {
        var element = listed.element
        var listed_join = handle_join(element)
        assert not listed_join.is_empty()
        var index = next_temporary()
        var item = next_temporary()
        builder.add_user("if ({code} != 0 && {code}->header.ref_count == 1) \{")
        builder.add_user("int64_t {index} = 0;")
        builder.add_user("while ({index} < {code}->item_count_) \{")
        builder.add_user("{c_type_name(element)} {item} = {list_item_code(element, code, index)};")
        add_handle_wait(listed_join, item)
        builder.add_user("{index} = {index} + 1;")
        builder.add_user("}")
        builder.add_user("}")
        return
    }
    var join = handle_join(local_type)
    assert not join.is_empty()
    add_handle_wait(join, code)
}

func drop_may_wait(released_type: Analysis.SpiteType): Boolean {
    if not resumable_mode or conditional_depth != 0 {
        return false
    }
    var visiting = List<String>()
    return holds_handles(released_type, visiting)
}

func holds_handles(held_type: Analysis.SpiteType, visiting: List<String>): Boolean {
    var nullable = type_shape.as_nullable(held_type)
    if nullable {
        var inner = nullable.inner
        return holds_handles(inner, visiting)
    }
    if not handle_join(held_type).is_empty() {
        return true
    }
    var listed = type_shape.as_list(held_type)
    if listed {
        var element = listed.element
        return holds_handles(element, visiting)
    }
    var held = handle_holder_class(held_type)
    if not held or visiting.contains(held.c_name) {
        return false
    }
    visiting.append(held.c_name)
    var index = 0
    while index < held.fields.count() {
        var field = held.fields[index]
        var field_type = field.type
        if holds_handles(field_type, visiting) {
            visiting.remove_last()
            return true
        }
        index = index + 1
    }
    visiting.remove_last()
    return false
}

func handle_holder_class(held_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(held_type)
    assert class_ref
    var held = find_class_by_c_name(class_ref.c_name)
    assert held
    assert not held.is_singleton and not held.is_value_class and not is_library_class(held)
    return held
}

func wait_for_released(released_type: Analysis.SpiteType, code: String) {
    var visiting = List<String>()
    wait_for_held_handles(released_type, code, visiting)
}

func wait_for_held_handles(held_type: Analysis.SpiteType, code: String, visiting: List<String>) {
    var nullable = type_shape.as_nullable(held_type)
    if nullable {
        var inner = nullable.inner
        wait_for_held_handles(inner, code, visiting)
        return
    }
    assert holds_handles(held_type, visiting)
    var join = handle_join(held_type)
    if not join.is_empty() {
        add_handle_wait(join, code)
        return
    }
    var listed = type_shape.as_list(held_type)
    if listed {
        var element = listed.element
        var index = next_temporary()
        var item = next_temporary()
        builder.add_user("if ({code} != 0 && {code}->header.ref_count == 1) \{")
        builder.add_user("int64_t {index} = 0;")
        builder.add_user("while ({index} < {code}->item_count_) \{")
        builder.add_user("{c_type_name(element)} {item} = {list_item_code(element, code, index)};")
        wait_for_held_handles(element, item, visiting)
        builder.add_user("{index} = {index} + 1;")
        builder.add_user("}")
        builder.add_user("}")
        return
    }
    var held = handle_holder_class(held_type)
    crash held
    visiting.append(held.c_name)
    builder.add_user("if ({code} != 0 && {code}->header.ref_count == 1) \{")
    var field_index = 0
    while field_index < held.fields.count() {
        var field = held.fields[field_index]
        var field_type = field.type
        if holds_handles(field_type, visiting) {
            var place = next_temporary()
            builder.add_user("{c_type_name(field_type)} {place} = {field_place(code, held, field.name)};")
            wait_for_held_handles(field_type, place, visiting)
        }
        field_index = field_index + 1
    }
    builder.add_user("}")
    visiting.remove_last()
}

func waits_for_handles(element: Analysis.SpiteType): Boolean {
    if not resumable_mode or conditional_depth != 0 {
        return false
    }
    return is_concurrent_handle(element)
}

func is_concurrent_handle(handle_type: Analysis.SpiteType): Boolean {
    var class_ref = type_shape.as_class_ref(handle_type)
    if not class_ref {
        return false
    }
    var handle_class = find_class_by_c_name(class_ref.c_name)
    if not handle_class {
        return false
    }
    return handle_class.qualified_dotted == "Concurrent"
}

func waited_before_clearing(element: Analysis.SpiteType, list: ExpressionResult): ExpressionResult {
    var join = handle_join(element)
    if join.is_empty() {
        return list
    }
    wait_mark_counters.append(temporary_counter)
    var start = builder.user_count()
    wait_mark_positions.append(start)
    var list_type = list.type
    var held = next_temporary()
    var index = next_temporary()
    var item = next_temporary()
    builder.add_user("{c_type_name(list_type)} {held} = {list.code};")
    builder.add_user("int64_t {index} = 0;")
    builder.add_user("while ({index} < {held}->item_count_) \{")
    builder.add_user("{c_type_name(element)} {item} = {list_item_code(element, held, index)};")
    add_handle_wait(join, item)
    builder.add_user("{index} = {index} + 1;")
    builder.add_user("}")
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(held)
    var kept = ExpressionResult(held, list_type)
    kept.owning_override = list.owning_override
    kept.borrowed_from = list.borrowed_from
    return kept
}

func handle_join(handle_type: Analysis.SpiteType): String {
    if not is_concurrent_handle(handle_type) {
        return ""
    }
    var class_ref = type_shape.as_class_ref(handle_type)
    crash class_ref
    var handle_class = find_class_by_c_name(class_ref.c_name)
    crash handle_class
    var join = find_or_instantiate_function(handle_class, "_join")
    if not join {
        return ""
    }
    if not waiting_names.has(join.c_name) or not ensure_machine(join.c_name) {
        return ""
    }
    return join.c_name
}

func add_handle_wait(join: String, code: String) {
    resume_point_count = resume_point_count + 1
    var point = resume_point_count
    var slot = "spite_frame->spite_wait_{point}"
    builder.add_user("if ({code} != 0 && {code}->header.ref_count == 1) \{")
    builder.add_user("{slot} = {join}___begin({code});")
    builder.add_user("spite_resume_{point}: if (!{join}___step({slot})) SPITE_SUSPEND({point});")
    builder.add_user("SPITE_FREE({slot});")
    builder.add_user("}")
}

func waits_to_construct(target_class: Analysis.ClassInfo): Boolean {
    if not resumable_mode or conditional_depth != 0 or target_class.is_value_class or target_class.is_singleton {
        return false
    }
    if target_class.qualified_dotted == "Concurrent" or target_class.qualified_dotted == "Parallel" {
        return false
    }
    if not target_class.constructor {
        return false
    }
    return waiting_names.has(target_class.constructor.c_name) and ensure_machine(target_class.constructor.c_name)
}

func waited_construction(target_class: Analysis.ClassInfo, argument_codes: List<String>): ExpressionResult {
    crash target_class.constructor
    var construction = target_class.constructor.c_name
    var c_name = target_class.c_name
    wait_mark_counters.append(temporary_counter)
    var start = builder.user_count()
    wait_mark_positions.append(start)
    resume_point_count = resume_point_count + 1
    var point = resume_point_count
    var allocating = "{c_name}___allocate"
    var replaced = constructor_replaced_fields(target_class)
    if not replaced.is_empty() {
        allocating = "{c_name}___allocate_constructed"
    }
    var made = next_temporary()
    builder.add_user("{c_name}* {made} = {allocating}();")
    var passed = argument_codes.copy()
    passed.prepend(made)
    var slot = "spite_frame->spite_wait_{point}"
    builder.add_user("{slot} = {construction}___begin({passed.join(", ")});")
    builder.add_user("spite_resume_{point}: if (!{machine_step_call(construction, slot)}) SPITE_SUSPEND({point});")
    builder.add_user("SPITE_FREE({slot});")
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(made)
    var class_type = Analysis.Types.ClassRefType(c_name)
    return ExpressionResult(made, class_type)
}

func waited_shape_call(
    shape_caller: ShapeCaller,
    before: List<String>,
    receiver: ExpressionResult,
    receiver_owned: Boolean,
    argument_codes: List<String>,
    return_type: Analysis.SpiteType,
): ExpressionResult? {
    var information = shape_caller.information
    var starter = shape_starter(shape_caller)
    assert not starter.is_empty()
    wait_mark_counters.append(temporary_counter)
    var start = builder.user_count()
    wait_mark_positions.append(start)
    before.each(builder.add_user)
    var receiver_type = receiver.type
    var held = receiver.code
    if not receiver_owned {
        held = retain_call(receiver_type, receiver.code)
    }
    var receiver_temporary = next_temporary()
    builder.add_user("{c_type_name(receiver_type)} {receiver_temporary} = {held};")
    var parameter_types = shape_call_parameter_types(information, shape_caller.name)
    var passed = List<String>()
    passed.append(receiver_temporary)
    var index = 0
    while index < argument_codes.count() and index < parameter_types.count() {
        var argument_temporary = next_temporary()
        builder.add_user("{c_type_name(parameter_types[index])} {argument_temporary} = {argument_codes[index]};")
        passed.append(argument_temporary)
        index = index + 1
    }
    resume_point_count = resume_point_count + 1
    var point = resume_point_count
    var slot = "spite_frame->spite_wait_{point}"
    var passed_text = passed.join(", ")
    builder.add_user("{slot} = {starter}({passed_text});")
    builder.add_user(
        "spite_resume_{point}: if ({slot} != 0 && !((SpiteFrame*){slot})->step({slot})) SPITE_SUSPEND({point});",
    )
    var plain_call = "{information.c_name}___call_{shape_caller.name}({passed_text})"
    var result_temporary = next_temporary()
    var code = result_temporary
    if type_shape.is_void(return_type) {
        builder.add_user("bool {result_temporary} = true;")
        builder.add_user("if ({slot} != 0) \{ SPITE_FREE({slot}); } else \{ {plain_call}; }")
        code = "(void){result_temporary}"
    } else {
        var returned_c = c_type_name(return_type)
        builder.add_user("{returned_c} {result_temporary};")
        builder.add_user(
            "if ({slot} != 0) \{ {result_temporary} = ((struct \{ SpiteFrame spite_head; {returned_c} spite_result; }*){slot})->spite_result; SPITE_FREE({slot}); } else \{ {result_temporary} = {plain_call}; }",
        )
    }
    builder.add_user("{release_call(receiver_type, receiver_temporary)};")
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(result_temporary)
    return ExpressionResult(code, return_type)
}

func shape_starter(shape_caller: ShapeCaller): String {
    var information = shape_caller.information
    var name = "{information.c_name}___call_{shape_caller.name}___start"
    if shape_caller.starter.is_empty() {
        shape_caller.starter = name
        shape_starters.append(shape_caller)
        var parameter_types = shape_call_parameter_types(information, shape_caller.name)
        var signature = "static void* {name}({information.c_name} self"
        var index = 0
        while index < parameter_types.count() {
            signature = "{signature}, {c_type_name(parameter_types[index])} argument_{index}"
            index = index + 1
        }
        shape_caller.signature = "{signature})"
        builder.add_prototype("{signature});")
    }
    return name
}

func emit_shape_starters(first: Integer): Integer {
    var index = first
    while index < shape_starters.count() {
        var shape_caller = shape_starters[index]
        var information = shape_caller.information
        var parameter_types = shape_call_parameter_types(information, shape_caller.name)
        var passed = ""
        var argument_index = 0
        while argument_index < parameter_types.count() {
            passed = "{passed}, argument_{argument_index}"
            argument_index = argument_index + 1
        }
        var lines = List<String>()
        lines.append("{shape_caller.signature} \{")
        var shape_type = union_type_of(information)
        var member_index = 0
        while member_index < information.members.count() {
            var member = information.members[member_index]
            var called_function = shape_member_function(member, shape_caller.name)
            if called_function and not member.is_value_class {
                if waiting_names.has(called_function.c_name) and ensure_machine(called_function.c_name) {
                    var receiver = member_value_code("self", shape_type, member)
                    var member_test = value_class_test("self", shape_type, member)
                    lines.append("if {member_test} return {called_function.c_name}___begin({receiver}{passed});")
                }
            }
            member_index = member_index + 1
        }
        lines.append("return 0;")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_user(joined_lines)
        index = index + 1
    }
    return index
}

func waits_through_union(information: Analysis.UnionInfo, member_name: String): Boolean {
    if not resumable_mode or conditional_depth != 0 {
        return false
    }
    var waits = false
    var index = 0
    while index < information.members.count() {
        var member = information.members[index]
        var found = find_or_instantiate_function(member, member_name)
        if found {
            if waiting_names.has(found.c_name) and ensure_machine(found.c_name) {
                waits = true
            }
        }
        index = index + 1
    }
    return waits
}

func waited_union_call(
    union_wait: UnionWait,
    object_result: ExpressionResult,
    owning_object: Boolean,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var information = union_wait.information
    var expected_types = union_wait.expected_types
    var result_type = union_wait.result_type
    wait_mark_counters.append(temporary_counter)
    var start = builder.user_count()
    wait_mark_positions.append(start)
    var object_temporary = next_temporary()
    var held = object_result.code
    if not owning_object {
        held = "{information.c_name}___retain({object_result.code})"
    }
    builder.add_user("{information.c_name} {object_temporary} = {held};")
    var argument_temporaries = List<String>()
    var argument_index = 0
    while argument_index < arguments_ast.count() and argument_index < expected_types.count() {
        var argument_temporary = next_temporary()
        var expected = expected_types[argument_index]
        var stored = coerce_for_store(arguments_ast[argument_index], expected, scope, class_information)
        builder.add_user("{c_type_name(expected)} {argument_temporary} = {stored};")
        argument_temporaries.append(argument_temporary)
        argument_index = argument_index + 1
    }
    resume_point_count = resume_point_count + 1
    var point = resume_point_count
    var slot = "spite_frame->spite_wait_{point}"
    var has_result = not type_shape.is_void(result_type)
    var result_temporary = next_temporary()
    if has_result {
        builder.add_user(
            "{c_type_name(result_type)} {result_temporary} = {default_value_for_scalar_or_null(result_type)};",
        )
    } else {
        builder.add_user("bool {result_temporary} = true;")
    }
    builder.add_user("{slot} = 0;")
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var casted_object = "(({member.c_name}*){object_temporary})"
        var keyword = "if "
        if member_index > 0 {
            keyword = "else if "
        }
        var member_test = class_id_test(object_temporary, member)
        var found = find_or_instantiate_function(member, union_wait.member_name)
        var branch = ""
        if found {
            var call_arguments = argument_temporaries.copy()
            call_arguments.prepend(casted_object)
            var passed = call_arguments.join(", ")
            if waiting_names.has(found.c_name) and ensure_machine(found.c_name) {
                branch = "{slot} = {found.c_name}___begin({passed});"
            } else if has_result {
                branch = "{result_temporary} = {found.c_name}({passed});"
            } else {
                branch = "{found.c_name}({passed});"
            }
        }
        builder.add_user(keyword + "{member_test} \{ {branch} }")
        member_index = member_index + 1
    }
    builder.add_user(
        "spite_resume_{point}: if ({slot} != 0 && !((SpiteFrame*){slot})->step({slot})) SPITE_SUSPEND({point});",
    )
    if has_result {
        var result_c = c_type_name(result_type)
        builder.add_user(
            "if ({slot} != 0) \{ {result_temporary} = ((struct \{ SpiteFrame spite_head; {result_c} spite_result; }*){slot})->spite_result; SPITE_FREE({slot}); }",
        )
    } else {
        builder.add_user("if ({slot} != 0) \{ SPITE_FREE({slot}); }")
    }
    builder.add_user("{information.c_name}___release({object_temporary});")
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(result_temporary)
    if has_result {
        return ExpressionResult(result_temporary, result_type)
    }
    return ExpressionResult("(void){result_temporary}", result_type)
}

func waited_value_call(
    held: ExpressionResult,
    held_ast: Syntax.Expressions.Expression,
    argument_codes: List<String>,
    value_wait: ValueWait,
): ExpressionResult {
    var dispatcher = value_dispatcher(value_wait)
    var counter_before = temporary_counter
    wait_mark_counters.append(counter_before)
    var start = builder.user_count()
    wait_mark_positions.append(start)
    resume_point_count = resume_point_count + 1
    var point = resume_point_count
    var function_temporary = next_temporary()
    var held_code = held.code
    if not owns(held, held_ast) {
        held_code = "Spite_Function___retain({held.code})"
    }
    builder.add_user("Spite_Function* {function_temporary} = {held_code};")
    var passed = List<String>()
    passed.append(function_temporary)
    var called = List<String>()
    called.append("{function_temporary}->spite_owner")
    var index = 0
    while index < argument_codes.count() and index < value_wait.arguments.count() {
        var argument_temporary = next_temporary()
        builder.add_user("{c_type_name(value_wait.arguments[index])} {argument_temporary} = {argument_codes[index]};")
        passed.append(argument_temporary)
        called.append(argument_temporary)
        index = index + 1
    }
    var slot = "spite_frame->spite_wait_{point}"
    builder.add_user("{slot} = {dispatcher}({passed.join(", ")});")
    builder.add_user(
        "spite_resume_{point}: if ({slot} != 0 && !((SpiteFrame*){slot})->step({slot})) SPITE_SUSPEND({point});",
    )
    var returned = value_wait.returned
    var returned_text = "void"
    if not type_shape.is_void(returned) {
        returned_text = c_type_name(returned)
    }
    var plain_call = "(({returned_text} (*)({value_wait.pointer_parameters.join(", ")})){function_temporary}->spite_typed_call)({called.join(", ")})"
    var result_temporary = next_temporary()
    var code = result_temporary
    if type_shape.is_void(returned) {
        builder.add_user("bool {result_temporary} = true;")
        builder.add_user("if ({slot} != 0) \{ SPITE_FREE({slot}); } else \{ {plain_call}; }")
        code = "(void){result_temporary}"
    } else {
        var returned_c = c_type_name(returned)
        builder.add_user("{returned_c} {result_temporary};")
        builder.add_user(
            "if ({slot} != 0) \{ {result_temporary} = ((struct \{ SpiteFrame spite_head; {returned_c} spite_result; }*){slot})->spite_result; SPITE_FREE({slot}); } else \{ {result_temporary} = {plain_call}; }",
        )
    }
    builder.add_user("Spite_Function___release({function_temporary});")
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(result_temporary)
    var waited = ExpressionResult(code, returned)
    if not type_shape.is_void(returned) {
        waited.owning_override = true
    }
    return waited
}

func value_dispatcher(value_wait: ValueWait): String {
    var known = value_dispatcher_names[value_wait.key]
    if known {
        return known
    }
    var name = "spite_value_begin_{value_dispatcher_keys.count()}"
    value_dispatcher_names[value_wait.key] = name
    value_dispatcher_keys.append(value_wait.key)
    value_dispatcher_waits.append(value_wait)
    var parameters = List<String>()
    parameters.append("Spite_Function* spite_value")
    var index = 0
    while index < value_wait.arguments.count() {
        parameters.append("{c_type_name(value_wait.arguments[index])} spite_argument_{index}")
        index = index + 1
    }
    builder.add_prototype("static void* {name}({parameters.join(", ")});")
    return name
}

func note_value_target(value_call: String, information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var noted = "{value_call} {function.c_name}"
    assert not value_targets_noted.has(noted)
    value_targets_noted[noted] = true
    value_target_keys.append(value_call)
    value_target_classes.append(information)
    value_target_functions.append(function)
}

func emit_value_dispatchers(first: Integer): Integer {
    var index = first
    while index < value_dispatcher_keys.count() {
        crash value_dispatcher_waits[index]
        var key = value_dispatcher_keys[index]
        var value_wait = value_dispatcher_waits[index]
        emit_value_dispatcher(key, value_wait)
        index = index + 1
    }
    return index
}

func emit_value_dispatcher(key: String, value_wait: ValueWait) {
    crash value_dispatcher_names[key]
    var name = value_dispatcher_names[key]
    var parameters = List<String>()
    parameters.append("Spite_Function* spite_value")
    var arguments = List<String>()
    arguments.append("spite_value->spite_owner")
    var index = 0
    while index < value_wait.arguments.count() {
        parameters.append("{c_type_name(value_wait.arguments[index])} spite_argument_{index}")
        arguments.append("spite_argument_{index}")
        index = index + 1
    }
    var lines = List<String>()
    lines.append("static void* {name}({parameters.join(", ")}) \{")
    index = 0
    while index < value_target_keys.count() {
        crash value_target_classes[index]
        crash value_target_functions[index]
        var target_class = value_target_classes[index]
        var target = value_target_functions[index]
        var resumable = value_target_keys[index] == key and not target_class.is_value_class
        if resumable and waiting_names.has(target.c_name) and ensure_machine(target.c_name) {
            lines.append(
                "if (spite_value->spite_typed_call == (void*){target.c_name}) return {target.c_name}___begin({arguments.join(", ")});",
            )
        }
        index = index + 1
    }
    var shape_index = 0
    while shape_index < shape_value_keys.count() {
        if shape_value_keys[shape_index] == key {
            var valued_caller = shape_value_callers[shape_index]
            var forwarder = shape_value_forwarders[shape_index]
            var box_type = shape_value_boxes[shape_index]
            crash valued_caller
            crash forwarder
            crash box_type
            var starter = shape_starter(valued_caller)
            var started = List<String>()
            started.append("(({box_type}*)spite_value->spite_owner)->value")
            var argument_index = 1
            while argument_index < arguments.count() {
                started.append(arguments[argument_index])
                argument_index = argument_index + 1
            }
            lines.append(
                "if (spite_value->spite_typed_call == (void*){forwarder}) return {starter}({started.join(", ")});",
            )
        }
        shape_index = shape_index + 1
    }
    lines.append("return 0;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func rewind_temporaries(saved: Integer) {
    temporary_counter = saved
    while not wait_mark_counters.is_empty() and newest_wait_counter() >= saved {
        var position = wait_mark_positions.last()
        crash position
        var user_count = builder.user_count()
        builder.remove_user_range(position, user_count)
        drop_last_wait_mark()
    }
}

func newest_wait_counter(): Integer {
    var newest = wait_mark_counters.last()
    crash newest
    return newest
}

func drop_last_wait_mark() {
    wait_mark_counters.remove_last()
    wait_mark_positions.remove_last()
    wait_mark_ends.remove_last()
    wait_mark_results.remove_last()
}

func drop_unread_waits(first: Integer) {
    while wait_mark_counters.count() > first {
        var latest = latest_wait_mark(first)
        crash wait_mark_results[latest]
        crash wait_mark_positions[latest]
        crash wait_mark_ends[latest]
        var result = wait_mark_results[latest]
        var start = wait_mark_positions[latest]
        var end = wait_mark_ends[latest]
        wait_mark_counters.remove_at(latest)
        wait_mark_positions.remove_at(latest)
        wait_mark_ends.remove_at(latest)
        wait_mark_results.remove_at(latest)
        if not user_lines_mention(end, result) {
            builder.remove_user_range(start, end)
            unshift_wait_marks(end, end - start)
        }
    }
}

func latest_wait_mark(first: Integer): Integer {
    var latest = first
    var index = first + 1
    while index < wait_mark_positions.count() {
        crash wait_mark_positions[latest]
        if wait_mark_positions[index] > wait_mark_positions[latest] {
            latest = index
        }
        index = index + 1
    }
    return latest
}

func unshift_wait_marks(end: Integer, removed: Integer) {
    var index = 0
    while index < wait_mark_positions.count() {
        crash wait_mark_ends[index]
        if wait_mark_positions[index] >= end {
            var shifted = wait_mark_positions[index] - removed
            wait_mark_positions[index] = shifted
            var shifted_end = wait_mark_ends[index] - removed
            wait_mark_ends[index] = shifted_end
        }
        index = index + 1
    }
}

func shift_wait_marks(position: Integer) {
    var index = 0
    while index < wait_mark_positions.count() {
        if wait_mark_positions[index] >= position {
            var shifted = wait_mark_positions[index] + 1
            wait_mark_positions[index] = shifted
            crash wait_mark_ends[index]
            var shifted_end = wait_mark_ends[index] + 1
            wait_mark_ends[index] = shifted_end
        }
        index = index + 1
    }
}

func user_lines_mention(start: Integer, name: String): Boolean {
    var index = start
    while index < builder.user_count() {
        var line = builder.user_at(index)
        if mentions_name(line, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func mentions_name(text: String, name: String): Boolean {
    var from = 0
    var name_length = name.length()
    var text_length = text.length()
    while from < text_length {
        var rest = text.slice(from, text_length)
        var found = rest.index_of(name)
        if found < 0 {
            return false
        }
        var after = from + found + name_length
        var next_code = text.code_at(after)
        var continues_name = next_code == 95 or next_code >= 48 and next_code <= 57 or next_code >= 65 and next_code <= 90 or next_code >= 97 and next_code <= 122
        if after >= text_length or not continues_name {
            return true
        }
        from = after
    }
    return false
}

func ensure_machine(callee: String): Boolean {
    if machine_names.has(callee) {
        return machine_names[callee] == true
    }
    var queued = queue_machine(callee)
    machine_names[callee] = queued
    return queued
}

func queue_machine(callee: String): Boolean {
    var index = 0
    while index < waiting_functions.count() {
        crash waiting_kinds[index]
        var waiting = waiting_functions[index]
        var kind = waiting_kinds[index]
        if waiting.c_name == callee and kind != "yield" {
            crash waiting_classes[index]
            var waiting_class = waiting_classes[index]
            machine_primitive_classes.append(waiting_class)
            machine_primitive_functions.append(waiting)
            machine_primitive_kinds.append(kind)
            return true
        }
        index = index + 1
    }
    index = 0
    while index < machine_candidate_names.count() {
        if machine_candidate_names[index] == callee {
            crash machine_candidate_classes[index]
            crash machine_candidate_functions[index]
            var candidate_class = machine_candidate_classes[index]
            var candidate_function = machine_candidate_functions[index]
            var guarded = machine_candidate_guarded[index] == true
            if guarded and takes_lock_when_waiting(candidate_class, candidate_function) {
                return false
            }
            machine_queue_classes.append(candidate_class)
            machine_queue_functions.append(candidate_function)
            return true
        }
        index = index + 1
    }
    return false
}

func takes_lock_when_waiting(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not parallel_used {
        return false
    }
    if not machine_guard_reached {
        machine_guard_reached = call_effects.thread_reached_classes()
        machine_guard_touching = state_touching_functions()
    }
    var reached = machine_guard_reached
    crash reached
    var threaded = reached.has(information.qualified_dotted) or called_implicitly(information)
    return threaded and machine_guard_touching.has(function.c_name)
}

func find_waiting_functions() {
    var seeded_index = 0
    while seeded_index < seeded_waiting_names.count() {
        var seeded_name = seeded_waiting_names[seeded_index]
        waiting_names[seeded_name] = true
        seeded_index = seeded_index + 1
    }
    var index = 0
    while index < waiting_functions.count() {
        if waiting_kinds[index] != "yield" {
            var waiting = waiting_functions[index]
            waiting_names[waiting.c_name] = true
        }
        index = index + 1
    }
    settle_wait_facts()
    wake_all_callers()
}

func wake_all_callers() {
    var changed = true
    while changed {
        changed = wakes_callers(call_edge_callers, call_edge_callees)
        if wakes_callers(wait_facts.edge_callers, wait_facts.edge_callees) {
            changed = true
        }
        if wakes_callers(wait_facts.shape_callers, wait_facts.shape_callees) {
            changed = true
        }
    }
}

func wakes_callers(callers: List<String>, callees: List<String>): Boolean {
    var changed = false
    var index = 0
    while index < callers.count() {
        crash callees[index]
        var caller = callers[index]
        var callee = callees[index]
        if not waiting_names.has(caller) and waiting_names.has(callee) {
            waiting_names[caller] = true
            changed = true
        }
        index = index + 1
    }
    return changed
}

func emit_state_machines() {
    find_waiting_functions()
    var roots = List<String>()
    var index = 0
    while index < task_root_functions.count() {
        var root = task_root_functions[index]
        if waiting_names.has(root.c_name) and not roots.contains(root.c_name) and ensure_machine(root.c_name) {
            roots.append(root.c_name)
        }
        index = index + 1
    }
    var dispatchers = 0
    var starters = 0
    var pending = true
    emitting_machines = true
    while pending {
        while not machine_queue_functions.is_empty() {
            var information = machine_queue_classes.remove_first()
            var function = machine_queue_functions.remove_first()
            crash information
            crash function
            emit_resumable_function(information, function)
        }
        dispatchers = emit_value_dispatchers(dispatchers)
        starters = emit_shape_starters(starters)
        pending = not machine_queue_functions.is_empty()
    }
    emitting_machines = false
    refresh_shape_callers()
    var lines = List<String>()
    lines.append("static void* spite_frame_start(Spite_Function* spite_work) \{")
    lines.append("if (spite_work == 0) return 0;")
    index = 0
    while index < roots.count() {
        var root = roots[index]
        lines.append(
            "if (spite_work->spite_typed_call == (void*){root}) \{ SpiteFrame* spite_started = (SpiteFrame*){root}___begin(spite_work->spite_owner); spite_started->work = spite_work; Spite_Function___retain(spite_work); return spite_started; }",
        )
        index = index + 1
    }
    lines.append("return 0;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func emit_resumable_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var crash_lines = crash_map_lines.count()
    resumable_mode = true
    conditional_depth = 0
    resume_point_count = 0
    site_ordinal = 0
    frame_candidates.clear()
    placed_names.clear()
    placed_frames.clear()
    placed_receiver_names.clear()
    placed_receiver_codes.clear()
    current_class = information
    current_owner = information.qualified_dotted
    current_function = function.name
    current_line = function.line
    current_path = information.source_path
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    bind_symbol_of(function)
    var outer_fact_owner = fact_owner
    fact_owner = information.c_name
    var start = builder.user_count()
    var scope = parameter_scope(function)
    var outer_item_function = item_function
    var outer_item_scope = item_function_scope
    item_function = function
    item_function_scope = scope
    terminal_if = terminal_if_of(function.body)
    body_narrowed_names = List<String>()
    body_assigned_paths = List<String>()
    collect_body_facts(function.body)
    var ended_in_return = generate_statement_list(function.body, scope, information, function)
    item_function = outer_item_function
    item_function_scope = outer_item_scope
    terminal_if = null
    var return_type = function.return_type
    var returns_value = not type_shape.is_void(return_type)
    if not ended_in_return {
        emit_scope_drops(scope, true)
        if returns_value {
            builder.add_user("return {default_value_for_type(return_type)};")
        }
    }
    close_rebindings(scope)
    var body = builder.take_user_from(start)
    resumable_mode = false
    fact_owner = outer_fact_owner
    while crash_map_lines.count() > crash_lines {
        crash_map_lines.remove_last()
    }
    var machine = StateMachine()
    var parts = machine_parts(information, function, machine)
    var rewritten = machine.rewrite(body)
    var name = function.c_name
    var waits = List<String>()
    var point = 1
    while point <= resume_point_count {
        waits.append("void* spite_wait_{point};")
        point = point + 1
    }
    var result_field = ""
    if returns_value {
        result_field = " {c_type_name(return_type)} spite_result;"
    }
    crash parts[0]
    var hot = is_hot_class(information)
    var counted_field = ""
    if hot {
        counted_field = " int64_t* spite_frames;"
        hot_machine_names.append(name)
    }
    builder.add_typedef(
        "typedef struct {name}___frame \{ SpiteFrame spite_head;{result_field}{counted_field} {parts[0]} self; {machine.frame_fields()} {waits.join(" ")} } {name}___frame;",
    )
    emit_machine_begin(name, parts)
    if hot {
        emit_hot_machine_begin(information, function, parts)
    }
    var step_name = "{name}___step"
    if hot {
        step_name = "{name}___step_body"
        builder.add_prototype("static bool {step_name}(void* spite_raw);")
        builder.add_user(
            "static bool {name}___step(void* spite_raw) \{\nbool spite_done = {step_name}(spite_raw);\nif (spite_done) *((({name}___frame*)spite_raw)->spite_frames) -= 1;\nreturn spite_done;\n}",
        )
    }
    var lines = List<String>()
    lines.append("static bool {step_name}(void* spite_raw) \{")
    lines.append("{name}___frame* spite_frame = ({name}___frame*)spite_raw;")
    lines.append("{parts[0]} self = spite_frame->self;")
    var resume_switch = machine.resume_switch()
    lines.append(resume_switch)
    var rewritten_body = rewritten.join("\n")
    lines.append(rewritten_body)
    lines.append("return true;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func machine_parts(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    machine: StateMachine,
): List<String> {
    var receiver_type = value_class_type(information)
    var parts = List<String>()
    var receiver_c_type = c_type_name(receiver_type)
    parts.append(receiver_c_type)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        var c_type = c_type_name(parameter_type)
        var name = c_value_name(parameter.name)
        machine.bind_parameter(c_type, name)
        parts.append(c_type)
        parts.append(name)
        index = index + 1
    }
    return parts
}

func emit_hot_machine_begin(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, parts: List<String>) {
    var name = function.c_name
    var parameters = List<String>()
    var types = List<String>()
    var arguments = List<String>()
    crash parts[0]
    parameters.append("{parts[0]} self")
    types.append(parts[0])
    arguments.append("self")
    var index = 1
    while index + 1 < parts.count() {
        var c_type = parts[index]
        var parameter = parts[index + 1]
        parameters.append("{c_type} {parameter}")
        types.append(c_type)
        arguments.append(parameter)
        index = index + 2
    }
    var begun = "{name}___begin"
    var shown = escape_c_string("{information.qualified_dotted}.{function.name}")
    var lines = List<String>()
    lines.append("void* {begun}___hot({parameters.join(", ")}) \{")
    lines.append("static int64_t* spite_counted = 0;")
    lines.append("if (spite_counted == 0) spite_counted = spite_machine_frames(\"{name}\", \"{shown}\");")
    lines.append("{name}___frame* spite_frame = ({name}___frame*){name}___begin_frame({arguments.join(", ")});")
    lines.append("spite_frame->spite_frames = spite_counted;")
    lines.append("*spite_counted += 1;")
    lines.append("return spite_frame;")
    lines.append("}")
    builder.add_prototype("void* {begun}___hot({parameters.join(", ")});")
    builder.add_prototype("void* {begun}({parameters.join(", ")});")
    builder.add_slot(begun, "static void* (*{begun}___slot)({types.join(", ")}) = {begun}___hot;")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
    builder.add_user("void* {begun}({parameters.join(", ")}) \{\nreturn {slot_read(begun)}({arguments.join(", ")});\n}")
    hot_slot_names.append(begun)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}.{function.name}")
}

func machine_step_call(callee: String, slot: String): String {
    if hot_reload {
        return "((SpiteFrame*){slot})->step({slot})"
    }
    return "{callee}___step({slot})"
}

func emit_machine_begin(name: String, parts: List<String>) {
    var parameters = List<String>()
    crash parts[0]
    parameters.append("{parts[0]} self")
    var index = 1
    while index + 1 < parts.count() {
        var c_type = parts[index]
        var parameter = parts[index + 1]
        parameters.append("{c_type} {parameter}")
        index = index + 2
    }
    var begin_name = "{name}___begin"
    if hot_machine_names.contains(name) {
        begin_name = "{name}___begin_frame"
    }
    var signature = "static void* {begin_name}({parameters.join(", ")})"
    var lines = List<String>()
    lines.append("{signature} \{")
    lines.append("{name}___frame* spite_frame = ({name}___frame*)SPITE_MALLOC(sizeof({name}___frame));")
    lines.append("memset(spite_frame, 0, sizeof({name}___frame));")
    lines.append("spite_frame->spite_head.step = {name}___step;")
    lines.append("spite_frame->self = self;")
    index = 2
    while index < parts.count() {
        var parameter = parts[index]
        lines.append("spite_frame->{parameter} = {parameter};")
        index = index + 2
    }
    lines.append("return spite_frame;")
    lines.append("}")
    builder.add_prototype("{signature};")
    builder.add_prototype("static bool {name}___step(void* spite_raw);")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func emit_primitive_machines() {
    var index = 0
    while index < machine_primitive_functions.count() {
        crash machine_primitive_classes[index]
        crash machine_primitive_kinds[index]
        var information = machine_primitive_classes[index]
        var function = machine_primitive_functions[index]
        var kind = machine_primitive_kinds[index]
        emit_primitive_machine(information, function, kind)
        index = index + 1
    }
}

func emit_primitive_machine(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, kind: String) {
    var scheduler_class = find_class_by_qualified("Scheduler")
    crash scheduler_class
    var scheduler = singleton_call(scheduler_class)
    var machine = StateMachine()
    var parts = machine_parts(information, function, machine)
    var name = function.c_name
    var fields = List<String>()
    var return_type = function.return_type
    if not type_shape.is_void(return_type) {
        fields.append("{c_type_name(return_type)} spite_result;")
    }
    crash parts[0]
    fields.append("{parts[0]} self;")
    var index = 1
    while index + 1 < parts.count() {
        fields.append("{parts[index]} {parts[index + 1]};")
        index = index + 2
    }
    var lines = List<String>()
    lines.append("static bool {name}___step(void* spite_raw) \{")
    lines.append("{name}___frame* spite_frame = ({name}___frame*)spite_raw;")
    lines.append("Scheduler* spite_scheduler = {scheduler};")
    var steps = ""
    if kind == "sleep" {
        steps = sleep_steps(scheduler_class, function, fields)
    } else if kind == "join" {
        steps = join_steps(scheduler_class, function)
    } else {
        steps = offload_steps(scheduler_class, function, fields)
    }
    lines.append(steps)
    lines.append("Scheduler___release(spite_scheduler);")
    lines.append("return spite_over;")
    lines.append("}")
    builder.add_typedef("typedef struct {name}___frame \{ SpiteFrame spite_head; {fields.join(" ")} } {name}___frame;")
    emit_machine_begin(name, parts)
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func sleep_steps(scheduler_class: Analysis.ClassInfo, function: Analysis.FunctionInfo, fields: List<String>): String {
    crash function.parameters[0]
    var milliseconds = c_value_name(function.parameters[0].name)
    var timer_start = find_or_instantiate_function(scheduler_class, "timer_start")
    var timer_over = find_or_instantiate_function(scheduler_class, "timer_over")
    crash timer_start
    crash timer_over
    fields.append("int64_t spite_deadline;")
    return "if (spite_frame->spite_head.state == 0) \{ spite_frame->spite_deadline = {timer_start.c_name}(spite_scheduler, spite_frame->{milliseconds}); spite_frame->spite_head.state = 1; }\nbool spite_over = {timer_over.c_name}(spite_scheduler, spite_frame->spite_deadline);"
}

func join_steps(scheduler_class: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    crash function.parameters[0]
    var frame = c_value_name(function.parameters[0].name)
    var joins = find_or_instantiate_function(scheduler_class, "joins")
    crash joins
    var over = "bool spite_over = {joins.c_name}(spite_frame->self, spite_frame->{frame});"
    var return_type = function.return_type
    if type_shape.is_void(return_type) {
        return over
    }
    return "{over}\nif (spite_over) spite_frame->spite_result = true;"
}

func offload_steps(scheduler_class: Analysis.ClassInfo, function: Analysis.FunctionInfo, fields: List<String>): String {
    var offload_start = find_or_instantiate_function(scheduler_class, "offload_start")
    var offload_over = find_or_instantiate_function(scheduler_class, "offload_over")
    crash offload_start
    crash offload_over
    var name = function.c_name
    fields.append("{name}___call spite_call;")
    fields.append("int64_t spite_thread;")
    var passed = List<String>()
    passed.append("spite_frame->self")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        passed.append("spite_frame->{c_value_name(parameter.name)}")
        index = index + 1
    }
    var call = "(int64_t)(intptr_t)&spite_frame->spite_call"
    var lines = List<String>()
    lines.append("if (spite_frame->spite_head.state == 0) \{")
    lines.append(
        "spite_frame->spite_call = ({name}___call)\{ \{ 0, &{name}___perform, spite_scheduler }, {passed.join(", ")} };",
    )
    lines.append(
        "spite_frame->spite_thread = {offload_start.c_name}(spite_scheduler, {call}, (int64_t)(intptr_t)&spite_offload_thread);",
    )
    lines.append("spite_frame->spite_head.state = 1;")
    lines.append("}")
    lines.append("bool spite_over = {offload_over.c_name}(spite_scheduler, {call}, spite_frame->spite_thread);")
    var return_type = function.return_type
    if not type_shape.is_void(return_type) {
        lines.append("if (spite_over) spite_frame->spite_result = spite_frame->spite_call.result;")
    }
    return lines.join("\n")
}

func folded_maths_call(
    name: String,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    if maths.is_predicate(name) {
        return folded_question_call(name, object_ast, arguments_ast, class_information)
    }
    var folded = folded_maths_value(name, object_ast, arguments_ast, class_information)
    assert folded
    var is_float = folded.kind == "Float"
    var literal = maths.decimal_literal(folded.value, is_float)
    if is_float {
        var folded_float_type = float_type()
        return ExpressionResult(literal, folded_float_type)
    }
    var folded_double_type = double_type()
    return ExpressionResult(literal, folded_double_type)
}

func folded_question_call(
    name: String,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert arguments_ast.is_empty()
    var receiver = folded_decimal(object_ast, class_information)
    assert receiver
    assert folds_on(receiver, name)
    var answer = maths.folded_question(name, receiver.value)
    var answer_type = Analysis.Types.ScalarType('boolean_kind')
    return ExpressionResult(answer, answer_type)
}

func folds_on(receiver: FoldedDecimal, name: String): Boolean {
    if not receiver.is_decimal() {
        return false
    }
    var value_class = find_class_by_qualified(receiver.kind)
    if not value_class {
        return false
    }
    var function = find_or_instantiate_function(value_class, name)
    if not function {
        return false
    }
    return is_inline_supplied(function)
}

func folded_maths_value(
    name: String,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): FoldedDecimal? {
    assert maths.is_member(name) and not maths.is_constant(name) and not maths.is_predicate(name)
    assert arguments_ast.count() == maths.operand_count(name)
    var receiver = folded_decimal(object_ast, class_information)
    assert receiver
    assert folds_on(receiver, name)
    var is_float = receiver.kind == "Float"
    var operands = List<Double>()
    var index = 0
    while index < arguments_ast.count() {
        var argument = folded_decimal(arguments_ast[index], class_information)
        assert argument
        var operand_value = argument.operand(is_float)
        operands.append(operand_value)
        index = index + 1
    }
    while operands.count() < 2 {
        operands.append(0.0)
    }
    crash operands.count() >= 2
    var value = receiver.operand(is_float)
    var first = operands[0]
    var second = operands[1]
    var result = maths.folded(name, is_float, value, first, second)
    return FoldedDecimal(result, receiver.kind)
}

func folded_decimal(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): FoldedDecimal? {
    var float_literal = shape.as_float_literal(expression)
    if float_literal {
        return FoldedDecimal(float_literal.value, "Float")
    }
    var integer_literal = shape.as_integer_literal(expression)
    if integer_literal {
        assert integer_literal.value > -9007199254740992 and integer_literal.value < 9007199254740992
        var whole: Double = integer_literal.value
        return FoldedDecimal(whole, "Integer")
    }
    var negated = shape.as_unary(expression)
    if negated {
        assert negated.operator == 'negate'
        crash negated.operand
        var negated_operand = folded_decimal(negated.operand, class_information)
        assert negated_operand
        return FoldedDecimal(-negated_operand.value, negated_operand.kind)
    }
    var constant_member = shape.as_member(expression)
    if constant_member {
        crash constant_member.object
        var constant_class = try_resolve_static_path(constant_member.object, class_information.qualified_dotted)
        assert constant_class
        var constant_kind = constant_class.qualified_dotted
        assert constant_kind == "Float" or constant_kind == "Double"
        assert maths.is_constant(constant_member.name)
        var member_constant = maths.constant_value(constant_member.name, constant_kind == "Float")
        return FoldedDecimal(member_constant, constant_kind)
    }
    var call = shape.as_call(expression)
    assert call
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    assert maths.is_member(member.name) and not maths.is_constant(member.name) and not maths.is_predicate(member.name)
    return folded_maths_value(member.name, member.object, call.arguments, class_information)
}

func seed_host_waits(host: HotReloadLibrary) {
    var index = 0
    while index < host.host_waiting.count() {
        var name = host.host_waiting[index]
        var owner = class_of_function_c_name(name)
        var rebuilt = false
        if owner {
            rebuilt = reload_owners.contains(owner.c_name)
        }
        if not rebuilt {
            seeded_waiting_names.append(name)
        }
        index = index + 1
    }
}

func seed_lent_variants(host: HotReloadLibrary) {
    var index = 0
    while index < host.host_variants.count() {
        var fields = host.host_variants[index].split("\t")
        crash fields.count() == 4
        var variant_c_name = fields[0]
        var original_c_name = fields[1]
        var owner = class_of_function_c_name(original_c_name)
        if owner {
            var original = function_by_c_name(owner, original_c_name)
            var exists = function_by_c_name(owner, variant_c_name)
            if original and not exists and reload_owners.contains(owner.c_name) {
                var position_text = fields[2]
                var positions = position_text.split("_")
                var sources = fields[3]
                add_lent_variant(owner, original, variant_c_name, positions, sources)
            }
        }
        index = index + 1
    }
}

func instance_record(
    template: Analysis.ClassInfo,
    types: List<Analysis.SpiteType>,
    texts: List<String>,
    label: String,
): String {
    var codec = TypeCodec()
    var fields = List<String>()
    fields.append(label)
    fields.append(template.c_name)
    var count = types.count().to_string()
    fields.append(count)
    var index = 0
    while index < types.count() {
        var encoded_type = codec.encoded(types[index])
        fields.append(encoded_type)
        index = index + 1
    }
    index = 0
    while index < texts.count() {
        var escaped_text = codec.escaped(texts[index])
        fields.append(escaped_text)
        index = index + 1
    }
    return "instance {fields.join("\t")}"
}

func replay_instances(host: HotReloadLibrary) {
    var index = 0
    while index < host.host_instances.count() {
        var record = host.host_instances[index]
        replay_instance(record)
        index = index + 1
    }
    index = 0
    while index < host.host_literals.count() {
        var literal = host.host_literals[index]
        replay_literal(literal)
        index = index + 1
    }
}

func note_literal_class(names: List<String>, types: List<Analysis.SpiteType>) {
    var codec = TypeCodec()
    var fields = List<String>()
    var joined_names = names.join(",")
    fields.append(joined_names)
    var index = 0
    while index < types.count() {
        var encoded_type = codec.encoded(types[index])
        fields.append(encoded_type)
        index = index + 1
    }
    literal_lines.append("literal {fields.join("\t")}")
}

func replay_literal(record: String) {
    var codec = TypeCodec()
    var fields = record.split("\t")
    crash fields.count() >= 1
    var joined_names = fields[0]
    var names = joined_names.split(",")
    if joined_names.is_empty() {
        names = List<String>()
    }
    crash fields.count() == names.count() + 1
    var types = List<Analysis.SpiteType>()
    var index = 0
    while index < names.count() {
        crash fields[index + 1]
        var encoded_type = fields[index + 1]
        var decoded = codec.decoded(encoded_type)
        assert decoded
        types.append(decoded)
        index = index + 1
    }
    literal_class(names, types)
}

func replay_instance(record: String) {
    var codec = TypeCodec()
    var fields = record.split("\t")
    crash fields.count() >= 3
    var label = fields[0]
    assert not find_class_by_c_name(label)
    var template_name = fields[1]
    var template = find_class_by_c_name(template_name)
    assert template
    var count_text = fields[2]
    var count = count_text.to_integer()
    crash count
    crash fields.count() == 3 + count * 2
    var types = List<Analysis.SpiteType>()
    var texts = List<String>()
    var codes = List<String>()
    var index = 0
    while index < count {
        crash fields[3 + index]
        var encoded_type = fields[3 + index]
        var decoded = codec.decoded(encoded_type)
        assert decoded
        types.append(decoded)
        index = index + 1
    }
    index = 0
    while index < count {
        crash fields[3 + count + index]
        var escaped_text = fields[3 + count + index]
        var text = codec.unescaped(escaped_text)
        texts.append(text)
        var text_type = types[index]
        var code = code_of_text(text, text_type)
        codes.append(code)
        index = index + 1
    }
    if template.qualified_dotted == "List" {
        var listed = types[0]
        ensure_list(listed)
        return
    }
    if template.qualified_dotted == "Dictionary" {
        var key_first = template.codegen_names.first() == "key_type"
        var element = types[0]
        var key = types[1]
        if key_first {
            element = types[1]
            key = types[0]
        }
        var dictionary_type = Analysis.Types.DictionaryType(element, key)
        ensure_dictionary(dictionary_type)
        return
    }
    instantiated_with(template, types, codes, texts, label)
}

func code_of_text(text: String, spite_type: Analysis.SpiteType): String {
    if text.is_empty() {
        return ""
    }
    var text_length = text.length()
    var value = text.slice(2, text_length)
    if text.starts_with("s:") {
        return render_string_literal(value)
    }
    if text.starts_with("e:") {
        var written_enum = type_shape.as_enum(spite_type)
        crash written_enum
        return "{written_enum.c_name}_{value}"
    }
    return value
}

func prepare_partial(host: HotReloadLibrary) {
    replay_instances(host)
    reload_owners = classes_of_paths(reload_changed_paths)
    seed_host_facts(host)
}

func seed_host_facts(host: HotReloadLibrary) {
    seed_host_waits(host)
    seed_lent_variants(host)
    seed_made_members(host)
    var index = 0
    while index < host.host_facts.keys.count() {
        var key = host.host_facts.keys[index]
        if host.host_facts.kept_without(key, reload_owners) {
            seed_host_fact(key)
        }
        index = index + 1
    }
}

func seed_host_fact(key: String) {
    var key_length = key.length()
    if key.starts_with("read ") {
        read_attributes[key.slice(5, key_length)] = true
        return
    }
    if key.starts_with("word ") {
        folded_words[key.slice(5, key_length)] = true
        return
    }
    if key == "flag threads" {
        builder.threads = true
        return
    }
    if key.starts_with("allocated ") {
        var allocated_name = key.slice(10, key_length)
        var allocated = find_class_by_c_name(allocated_name)
        if allocated {
            note_allocated_class(allocated)
        }
        return
    }
    if key.starts_with("admit ") or key.starts_with("flow ") or key.starts_with("shape caller ") {
        seed_shape_fact(key)
    }
}

func admitted_class_named(c_name: String): Analysis.ClassInfo? {
    var found = find_class_by_c_name(c_name)
    if found {
        return found
    }
    if c_name == "SpiteSymbol" {
        var symbol_type: Analysis.SpiteType = Analysis.Types.SymbolType()
        return boxed_class_of(symbol_type)
    }
    var index = 0
    while index < enums.count() {
        if enums[index].c_name == c_name {
            var boxed_enum = enum_type_of(enums[index])
            return boxed_class_of(boxed_enum)
        }
        index = index + 1
    }
    return null
}

func seed_shape_fact(key: String) {
    var words = key.split(" ")
    if key.starts_with("admit ") {
        crash words[1]
        crash words[2]
        var admitting = find_union_by_c_name(words[1])
        var admitted = admitted_class_named(words[2])
        if admitting and admitted {
            if admitting.is_shape and not admitting.has_member(admitted.c_name) {
                admit_to_union(admitting, admitted)
            }
        }
        return
    }
    if key.starts_with("flow ") {
        crash words[1]
        var ends = words[1].split(">")
        crash ends[0]
        crash ends[1]
        var source = find_union_by_c_name(ends[0])
        var target = find_union_by_c_name(ends[1])
        if source and target {
            if not shape_flow_keys.contains(words[1]) {
                record_shape_flow(source, target)
            }
        }
        return
    }
    crash words[2]
    crash words[3]
    var called = find_union_by_c_name(words[2])
    assert called
    ensure_shape_caller(called, words[3])
}

func partial_problem(host: HotReloadLibrary): String {
    if not changing_layouts.is_empty() {
        return "the attributes of {migrating_display()} changed, and their live objects move to the new layout"
    }
    if partial_falls_short() {
        return "a function of a changed class has another parameter list or return type"
    }
    var changed_enum = changed_enum_values(host)
    if not changed_enum.is_empty() {
        return "the values of {changed_enum} changed, and the code that names them is compiled again"
    }
    var missing = missing_slot(host)
    if not missing.is_empty() {
        return "'{missing}' of a changed class is not made without compiling the whole program"
    }
    var fact_problem = changed_fact(host)
    if not fact_problem.is_empty() {
        return fact_problem
    }
    var write_problem = changed_write_answer(host)
    if not write_problem.is_empty() {
        return write_problem
    }
    var snapshot = analysis_snapshot()
    var snapshot_problem = changed_snapshot(host.host_snapshot, snapshot)
    if not snapshot_problem.is_empty() {
        return snapshot_problem
    }
    partial_snapshot = snapshot
    var interface_problem = changed_interface(host, snapshot)
    if not interface_problem.is_empty() {
        return interface_problem
    }
    return ""
}

func changed_enum_values(host: HotReloadLibrary): String {
    var index = 0
    while index < enums.count() {
        var information = enums[index]
        var running = host.host_layouts[information.c_name]
        var written = enum_typedefs[information.c_name]
        if running and written and running != written {
            return enum_display_name(information)
        }
        index = index + 1
    }
    return ""
}

func changed_interface(host: HotReloadLibrary, snapshot: Dictionary<String, String>): String {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        var function_index = 0
        while function_index < information.declared_functions.count() {
            var function = information.declared_functions[function_index]
            var key = "interface {function.c_name}"
            var compiled = function.is_emitted and not skipped_in_reload.has(function.c_name)
            var before_text = shown_or_none(host.host_snapshot[key])
            var after_text = shown_or_none(snapshot[key])
            if compiled and before_text != after_text {
                return "how '{function.c_name}' takes its arguments changed"
            }
            function_index = function_index + 1
        }
        index = index + 1
    }
    return ""
}

func differing_members(host: HotReloadLibrary, information: Analysis.UnionInfo): String {
    var running = host.host_members[information.c_name]
    if not running {
        return "the running program has none"
    }
    var running_names = running.split(",")
    var now = information.members.map_c_names()
    var differing = List<String>()
    var index = 0
    while index < running_names.count() {
        if not now.contains(running_names[index]) {
            differing.append("-{running_names[index]}")
        }
        index = index + 1
    }
    index = 0
    while index < now.count() {
        if not running_names.contains(now[index]) {
            differing.append("+{now[index]}")
        }
        index = index + 1
    }
    return differing.join(" ")
}

func shown_or_none(value: String?): String {
    if not value {
        return "none"
    }
    return value
}

func library_problem(host: HotReloadLibrary): String {
    var local_text = host.library_bodies.join("\n")
    var snapshot = partial_snapshot
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var key = "members {information.c_name}"
        if information.is_shape and host.host_snapshot[key] != snapshot[key] and local_text.contains(information.c_name) {
            var differing = differing_members(host, information)
            return "the classes that fit '{information.simple_name}' are not all known without compiling the whole program ({differing})"
        }
        index = index + 1
    }
    return ""
}

func missing_slot(host: HotReloadLibrary): String {
    var owner_index = 0
    while owner_index < reload_owners.count() {
        var rebuilt_name = reload_owners[owner_index]
        var rebuilt = find_class_by_c_name(rebuilt_name)
        var declared = host.host_declared[rebuilt_name]
        if rebuilt and declared {
            var names = declared.split(",")
            var existing = rebuilt.declared_functions.map_c_names()
            var name_index = 0
            while name_index < names.count() {
                if not names[name_index].is_empty() and not existing.contains(names[name_index]) {
                    return names[name_index]
                }
                name_index = name_index + 1
            }
        }
        owner_index = owner_index + 1
    }
    var running = host.host_slot_owners.keys()
    var index = 0
    while index < running.count() {
        var slot = running[index]
        crash host.host_slot_owners[slot]
        if reload_owners.contains(host.host_slot_owners[slot]) and not hot_slot_names.contains(slot) {
            return slot
        }
        index = index + 1
    }
    return ""
}

func seed_made_members(host: HotReloadLibrary) {
    var owner_index = 0
    while owner_index < reload_owners.count() {
        var rebuilt_name = reload_owners[owner_index]
        var rebuilt = find_class_by_c_name(rebuilt_name)
        var declared = host.host_declared[rebuilt_name]
        if rebuilt and declared {
            make_declared_again(rebuilt, declared)
        }
        owner_index = owner_index + 1
    }
    var running = host.host_slot_owners.keys()
    var index = 0
    while index < running.count() {
        var slot = running[index]
        crash host.host_slot_owners[slot]
        var slot_owner = host.host_slot_owners[slot]
        var owner = find_class_by_c_name(slot_owner)
        if owner and reload_owners.contains(slot_owner) {
            make_member_again(owner, slot)
        }
        index = index + 1
    }
}

func make_declared_again(owner: Analysis.ClassInfo, declared: String) {
    var names = declared.split(",")
    var existing = owner.declared_functions.map_c_names()
    var index = 0
    while index < names.count() {
        var c_name = names[index]
        if not c_name.is_empty() and not existing.contains(c_name) {
            make_member_again(owner, c_name)
        }
        index = index + 1
    }
}

func make_member_again(owner: Analysis.ClassInfo, slot: String) {
    if slot == "{owner.c_name}___functions" {
        ensure_functions_function(owner)
        return
    }
    var prefix_length = owner.c_name.length() + 1
    var slot_length = slot.length()
    assert slot_length > prefix_length and not slot.ends_with("___init") and slot.starts_with("{owner.c_name}_")
    var name = slot.slice(prefix_length, slot_length)
    assert not owner.find_function(name)
    find_or_instantiate_function(owner, name)
}

func changed_fact(host: HotReloadLibrary): String {
    var looked_up = host.host_facts.has("flag symbol_lookup_used")
    var waits_listed = host.host_facts.has("flag function_waits_table_used")
    var index = 0
    while index < program_facts.keys.count() {
        var key = program_facts.keys[index]
        if not host.host_facts.has(key) and not fact_may_differ(key, looked_up, waits_listed) {
            return "the change adds '{key}'"
        }
        index = index + 1
    }
    index = 0
    while index < host.host_facts.keys.count() {
        var host_key = host.host_facts.keys[index]
        var kept = host.host_facts.kept_without(host_key, reload_owners)
        if not kept and not program_facts.has(host_key) and not fact_may_differ(host_key, looked_up, waits_listed) {
            return "the change takes away '{host_key}'"
        }
        index = index + 1
    }
    return ""
}

func fact_may_differ(key: String, looked_up: Boolean, waits_listed: Boolean): Boolean {
    var about_reads = key.starts_with("read ") or key.starts_with("word ") or key.starts_with("asks writes ")
    if about_reads {
        return true
    }
    if key.starts_with("symbol ") {
        return not looked_up
    }
    if key.starts_with("maker ") {
        return not waits_listed
    }
    return false
}

func changed_write_answer(host: HotReloadLibrary): String {
    var index = 0
    while index < host.host_facts.keys.count() {
        var key = host.host_facts.keys[index]
        if key.starts_with("asks writes ") and host.host_facts.kept_without(key, reload_owners) {
            var words = key.split(" ")
            crash words[2]
            crash words[3]
            crash words[4]
            var owner = class_of_function_c_name(words[2])
            if not owner {
                return "'{words[2]}' asked about is gone"
            }
            var function = function_by_c_name(owner, words[2])
            if not function {
                return "'{words[2]}' asked about is gone"
            }
            var answered = parameter_writes.answer(this, owner, function, words[3])
            if answered.to_string() != words[4] {
                return "whether '{words[2]}' writes its argument {words[3]} changed"
            }
        }
        index = index + 1
    }
    return ""
}

func changed_snapshot(host_snapshot: Dictionary<String, String>, snapshot: Dictionary<String, String>): String {
    var keys = snapshot.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var compared_elsewhere = key.starts_with("members ") or key.starts_with("interface ")
        var new_function = key.starts_with("effects ") and not host_snapshot.has(key)
        if host_snapshot[key] != snapshot[key] and not compared_elsewhere and not new_function {
            return "{key} changed"
        }
        index = index + 1
    }
    var host_keys = host_snapshot.keys()
    index = 0
    while index < host_keys.count() {
        var host_key = host_keys[index]
        var compared_elsewhere = host_key.starts_with("members ") or host_key.starts_with("interface ")
        if not snapshot.has(host_key) and not compared_elsewhere {
            return "{host_key} changed"
        }
        index = index + 1
    }
    return ""
}

func analysis_snapshot(): Dictionary<String, String> {
    var snapshot = Dictionary<String, String>()
    var digest = ProgramFacts()
    var outside = Dictionary<String, List<String>>()
    var index = 0
    while index < call_effects.function_keys.count() {
        var key = call_effects.function_keys[index]
        crash call_effects.by_function[key]
        snapshot["effects {key}"] = digest.distinct_digest(call_effects.by_function[key].keys)
        note_outside_writes(key, call_effects.by_function[key], outside)
        index = index + 1
    }
    var written_classes = outside.keys()
    index = 0
    while index < written_classes.count() {
        var written = written_classes[index]
        crash outside[written]
        snapshot["outside {written}"] = digest.deduplicated_digest(outside[written])
        index = index + 1
    }
    var reached_classes = call_effects.thread_reached_classes()
    var reached_class_names = reached_classes.keys()
    snapshot["reach classes"] = digest.deduplicated_digest(reached_class_names)
    var reached_functions = call_effects.thread_reached_functions()
    var reached_function_names = reached_functions.keys()
    snapshot["reach functions"] = digest.deduplicated_digest(reached_function_names)
    snapshot["table fields"] = digest.pairs_digest(call_effects.field_classes)
    snapshot["table elements"] = digest.pairs_digest(call_effects.element_classes)
    snapshot["table returns"] = digest.pairs_digest(call_effects.return_classes)
    snapshot["table types"] = digest.pairs_digest(call_effects.type_field_classes)
    var plain_names = call_effects.plain_fields.keys()
    snapshot["table plain"] = digest.deduplicated_digest(plain_names)
    var counted_names = call_effects.counted_field_names.keys()
    snapshot["table counted"] = digest.deduplicated_digest(counted_names)
    var shared_names = call_effects.shared_defaults.keys()
    snapshot["table shared"] = digest.deduplicated_digest(shared_names)
    if not instance_lists_studied {
        instance_lists_studied = true
        classes.each(study_instance_lists)
    }
    var listed = instance_listed_names.copy()
    if every_class_listed {
        listed.append("*")
    }
    snapshot["instances"] = digest.deduplicated_digest(listed)
    settle_wait_facts()
    var waiting_names_now = wait_facts.waits.keys()
    snapshot["waits"] = digest.deduplicated_digest(waiting_names_now)
    add_interface_snapshot(snapshot, digest)
    index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.is_shape {
            var member_names = information.members.map_c_names()
            snapshot["members {information.c_name}"] = digest.deduplicated_digest(member_names)
        }
        index = index + 1
    }
    return snapshot
}

func note_outside_writes(key: String, effects: FunctionEffects, outside: Dictionary<String, List<String>>) {
    var hash = key.index_of("#")
    var writer = key.slice(0, hash)
    assert writer != "*"
    var index = 0
    while index < effects.member_writes.count() {
        var written = effects.member_writes[index]
        var written_hash = written.index_of("#")
        var written_class = written.slice(0, written_hash)
        if written_class != writer {
            if not outside.has(written_class) {
                var fresh = List<String>()
                outside[written_class] = fresh
            }
            var names = outside[written_class]
            crash names
            names.append(written)
        }
        index = index + 1
    }
}

func add_interface_snapshot(snapshot: Dictionary<String, String>, digest: ProgramFacts) {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if not information.is_generic_template {
            var function_index = 0
            while function_index < information.declared_functions.count() {
                var function = information.declared_functions[function_index]
                var lent = function.lent_parameters.join(",")
                var held = function.held_parameters.join(",")
                var shown = "{lent}|{function.lent_sources}|{held}|{function.lent_element}|{function.result_slot}"
                if shown != "||||false" {
                    var parts = [shown]
                    snapshot["interface {function.c_name}"] = digest.deduplicated_digest(parts)
                }
                function_index = function_index + 1
            }
        }
        index = index + 1
    }
}

func snapshot_manifest_lines(): List<String> {
    var snapshot = analysis_snapshot()
    var lines = program_facts.manifest_lines()
    var keys = snapshot.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        crash snapshot[key]
        lines.append("snapshot {snapshot[key]}\t{key}")
        index = index + 1
    }
    return lines
}

func read_evaluate_print_loop_body(name: String): String {
    if name == "singletons" {
        if read_evaluate_print_loop {
            builder.add_prototype("List_Spite_Attribute* spite_loop_singletons(void);")
            return "return spite_loop_singletons();"
        }
        return "return List_Spite_Attribute___make();"
    }
    if name == "class_descriptions" {
        if read_evaluate_print_loop {
            builder.add_prototype("SpiteString spite_loop_class_descriptions(void);")
            return "return spite_loop_class_descriptions();"
        }
        return "return spite_string_from_cstring_owned(\"\");"
    }
    if name == "enum_names" {
        if read_evaluate_print_loop {
            builder.add_prototype("SpiteString spite_loop_enum_names(void);")
            return "return spite_loop_enum_names();"
        }
        return "return spite_string_from_cstring_owned(\"\");"
    }
    if read_evaluate_print_loop {
        builder.add_prototype("SpiteString spite_loop_class_names(void);")
        return "return spite_loop_class_names();"
    }
    return "return spite_string_from_cstring_owned(\"\");"
}

func emit_loop_singletons() {
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    crash attribute_class
    var attribute_type = class_type_of(attribute_class)
    var list_name = ensure_list(attribute_type)
    var lines = List<String>()
    lines.append("{list_name}* spite_loop_singletons(void) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    var index = 0
    while index < singleton_classes.count() {
        var information = singleton_classes[index]
        crash singleton_functions[index]
        var function_c_name = singleton_functions[index]
        crash singleton_displays[index]
        var display_name = singleton_displays[index]
        var described = information.qualified_dotted == "Environment" or information.qualified_dotted == "Build"
        if not is_library_class(information) or described {
            var listed = listed_singleton(information, function_c_name, display_name, list_name)
            lines.append(listed)
        }
        index = index + 1
    }
    lines.append("return result;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    note_loop_table_slot("'s singletons")
    builder.add_support(joined_lines)
    var names = List<String>()
    index = 0
    while index < classes.count() {
        if is_listed_class(classes[index]) and not classes[index].is_singleton {
            var class_name = singleton_display_name(classes[index])
            names.append(class_name)
        }
        index = index + 1
    }
    var joined_names = names.join("\n")
    note_loop_table_slot("'s classes")
    builder.add_support("SpiteString spite_loop_class_names(void) \{\nreturn {owned_c_text(joined_names)};\n}")
    var enum_lines = List<String>()
    index = 0
    while index < enums.count() {
        var information = enums[index]
        var owner = find_class_by_qualified(information.owner_qualified)
        if owner and is_listed_class(owner) {
            var quoted = List<String>()
            var value_index = 0
            while value_index < information.values.count() {
                quoted.append("'{information.values[value_index]}'")
                value_index = value_index + 1
            }
            enum_lines.append("{enum_display_name(information)}: {quoted.join(", ")}")
        }
        index = index + 1
    }
    var joined_enums = enum_lines.join("\n")
    note_loop_table_slot("'s enums")
    builder.add_support("SpiteString spite_loop_enum_names(void) \{\nreturn {owned_c_text(joined_enums)};\n}")
    var blocks = List<String>()
    index = 0
    while index < classes.count() {
        if is_listed_class(classes[index]) {
            var block = class_description(classes[index])
            blocks.append(block)
        }
        index = index + 1
    }
    var joined_blocks = blocks.join("\n\n")
    note_loop_table_slot("'s class descriptions")
    builder.add_support("SpiteString spite_loop_class_descriptions(void) \{\nreturn {owned_c_text(joined_blocks)};\n}")
}

func class_description(information: Analysis.ClassInfo): String {
    var lines = List<String>()
    var display_name = singleton_display_name(information)
    if information.is_singleton {
        lines.append("{display_name}, a singleton")
    } else {
        lines.append(display_name)
    }
    if information.fields.is_empty() {
        lines.append("attributes: none")
    } else {
        lines.append("attributes:")
        var field_index = 0
        while field_index < information.fields.count() {
            var field = information.fields[field_index]
            var field_type = field.type
            if not field.name.starts_with("_") {
                lines.append("{field.name}: {type_display_name(field_type)}")
            }
            field_index = field_index + 1
        }
    }
    var signatures = List<String>()
    var function_index = 0
    while function_index < information.declared_functions.count() {
        var listed = information.declared_functions[function_index]
        var public = not listed.name.starts_with("_") and listed.name != "drop"
        if public and not listed.is_constructor and listed.symbol_name.is_empty() {
            var signature = prompt_signature(listed)
            if not signatures.contains(signature) {
                signatures.append(signature)
            }
        }
        function_index = function_index + 1
    }
    if signatures.is_empty() {
        lines.append("functions: none")
    } else {
        lines.append("functions:")
        var signature_index = 0
        while signature_index < signatures.count() {
            lines.append(signatures[signature_index])
            signature_index = signature_index + 1
        }
    }
    return lines.join("\n")
}

func prompt_signature(function: Analysis.FunctionInfo): String {
    var parameters = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        parameters.append("{parameter.name}: {type_display_name(parameter_type)}")
        index = index + 1
    }
    var return_type = function.return_type
    var returned = "Nothing"
    if not type_shape.is_void(return_type) {
        returned = type_display_name(return_type)
    }
    return "{function.name}({parameters.join(", ")}): {returned}"
}

func note_loop_table_slot(what: String) {
    assert hot_reload
    var entry_class = find_class_by_c_name(entry_class_c_name)
    crash entry_class
    note_support_slot(entry_class, what)
}

func listed_singleton(
    information: Analysis.ClassInfo,
    function_c_name: String,
    display_name: String,
    list_name: String,
): String {
    var class_type = class_type_of(information)
    var reflect = ensure_reflect_function(class_type)
    var cache = "{function_c_name}_cache"
    var peek = "{function_c_name}_peek"
    if not singleton_names.contains(peek) {
        singleton_names.append(peek)
        builder.add_prototype("{information.c_name}* {peek}(void);")
        builder.add_support(
            "{information.c_name}* {peek}(void) \{\nreturn __atomic_load_n(&{cache}, __ATOMIC_ACQUIRE);\n}",
        )
    }
    var named = ensure_symbol(display_name)
    var unmade = "Spite_Attribute___make({named}, {class_object_call(class_type)})"
    return "\{ {information.c_name}* made = {peek}(); {list_name}_append(result, made != 0 ? {reflect}({named}, made) : {unmade}); }"
}

func parameter_class_type(owner: Analysis.SpiteType, segment: String): Analysis.SpiteType? {
    var pieces = segment.split("\"")
    crash pieces.count() == 3
    var function_name = pieces[1]
    var number_piece = pieces[2]
    var number_text = number_piece.replace(",", "").replace(")", "").trim()
    var asked_index = number_text.to_integer()
    crash asked_index
    var owner_class_ref = type_shape.as_class_ref(owner)
    if not owner_class_ref {
        report(
            "'argument_class(\"{function_name}\", {asked_index})' asks a class for the class of a parameter, and {type_with_article(owner)} is not a class",
        )
        return null
    }
    var owner_class = find_class_by_c_name(owner_class_ref.c_name)
    crash owner_class
    var functions = declared_functions_of(owner_class)
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if function.name == function_name {
            var parameter = function.parameters[asked_index]
            if not parameter {
                report(
                    "'{owner_class.simple_name}.{function_name}' takes {function.parameters.count()} arguments, so it has no parameter {asked_index} for 'argument_class' to name: parameters are counted from 0",
                )
                return null
            }
            return parameter.type
        }
        index = index + 1
    }
    report(
        "'argument_class(\"{function_name}\", {asked_index})' names the class of a parameter of '{owner_class.simple_name}.{function_name}', and '{owner_class.simple_name}' has no function '{function_name}'",
    )
    return null
}

func ensure_byte_count_function(information: Analysis.ClassInfo): String {
    var name = "{information.c_name}___byte_count"
    if reflect_function_names.contains(name) {
        return name
    }
    reflect_function_names.append(name)
    builder.add_prototype("int64_t {name}(void);")
    var body = "return (int64_t)sizeof({information.c_name});"
    if not is_hot_class(information) {
        builder.add_support("int64_t {name}(void) \{\n{body}\n}")
        return name
    }
    builder.add_prototype("int64_t {name}___hot(void);")
    builder.add_slot(name, "static int64_t (*{name}___slot)(void) = {name}___hot;")
    builder.add_support("int64_t {name}(void) \{\nreturn {slot_read(name)}();\n}")
    builder.add_support("int64_t {name}___hot(void) \{\n{body}\n}")
    hot_slot_names.append(name)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}'s size")
    return name
}

# ../../../docs/reflection.md#known-while-compiling
func is_reflection_type(spite_type: Analysis.SpiteType): Boolean {
    var class_ref = type_shape.as_class_ref(spite_type)
    if not class_ref {
        return false
    }
    var reflection_names = [
        "Spite_Class"
        "Spite_Namespace"
        "Spite_Function"
        "Spite_Argument"
        "Spite_Attribute"
        "Spite_AttributeDeclaration"
        "Spite_Access"
    ]
    return reflection_names.contains(class_ref.c_name)
}

func takes_reflection(function: Analysis.FunctionInfo): Boolean {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        if is_reflection_type(parameter_type) {
            return true
        }
        index = index + 1
    }
    return false
}

func waits_for_constants(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    var reflection_classes = [
        "Spite.Class"
        "Spite.Namespace"
        "Spite.Function"
        "Spite.Argument"
        "Spite.Attribute"
        "Spite.AttributeDeclaration"
        "Spite.Access"
    ]
    if reflection_classes.contains(information.qualified_dotted) or function.is_constructor {
        return false
    }
    if function.specialisation_position >= 0 {
        return false
    }
    return takes_reflection(function)
}

func reflection_word(name: String): Boolean {
    var words = [
        "attributes"
        "functions"
        "classes"
        "namespaces"
        "every_class"
        "enums"
        "values"
        "arguments"
        "name"
        "name_with_namespaces"
        "namespace"
        "parent"
        "returns"
        "owner"
        "index"
        "class"
        "function"
        "is_singleton"
        "is_stateful"
        "is_fixed_size"
        "is_list"
        "is_dictionary"
        "is_optional"
        "is_enum"
        "is_resumable"
        "is_mutated"
        "returned_literal"
        "accesses"
        "target"
        "is_read"
        "is_written"
        "element_type"
        "value_type"
        "camel_case_name"
        "pascal_case_name"
        "instances"
    ]
    return words.contains(name)
}

func receiver_of(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    var member = shape.as_member(expression)
    if member {
        return member.object
    }
    var indexed = shape.as_index(expression)
    if indexed {
        return indexed.object
    }
    var called = shape.as_call(expression)
    assert called
    return called.callee
}

func root_of(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var current = expression
    var receiver = receiver_of(current)
    while receiver {
        current = receiver
        receiver = receiver_of(current)
    }
    return current
}

func worth_reflecting(expression: Syntax.Expressions.Expression, scope: Scope): Boolean {
    var binary = shape.as_binary(expression)
    if binary {
        crash binary.left
        crash binary.right
        return worth_reflecting(binary.left, scope) or worth_reflecting(binary.right, scope)
    }
    var unary = shape.as_unary(expression)
    if unary {
        crash unary.operand
        return worth_reflecting(unary.operand, scope)
    }
    var current = expression
    var mentions_reflection = false
    var nearest_member = ""
    var receiver = receiver_of(current)
    while receiver {
        var member = shape.as_member(current)
        if member {
            if reflection_word(member.name) {
                mentions_reflection = true
            }
            nearest_member = member.name
        }
        current = receiver
        receiver = receiver_of(current)
    }
    if shape.as_generic_identifier(current) {
        return mentions_reflection
    }
    var root = shape.as_identifier(current)
    if not root {
        return false
    }
    if reflected_binding(root.name) {
        return true
    }
    var own_name = root.name == "class" or root.name == "namespace"
    if own_name and not scope.lookup_type(root.name) {
        return true
    }
    if not mentions_reflection {
        return names_namespace(expression, scope)
    }
    var local_type = scope.lookup_type(root.name)
    var first_code = root.name.code_at(0)
    var static_root = first_code >= 65 and first_code <= 90
    if not local_type and (static_root or root.name == "class" or root.name == "namespace") {
        return true
    }
    return nearest_member == "class" or nearest_member == "attributes" or nearest_member == "functions"
}

func reflected_binding(name: String): Reflected? {
    var index = reflected_bindings.count() - 1
    while index >= 0 {
        var binding = reflected_bindings[index]
        crash binding
        if binding.name == name {
            return binding.value
        }
        index = index - 1
    }
    return null
}

func binding_origin(name: String): Syntax.Expressions.Expression? {
    var index = reflected_bindings.count() - 1
    while index >= 0 {
        var binding = reflected_bindings[index]
        crash binding
        if binding.name == name {
            return binding.origin
        }
        index = index - 1
    }
    return null
}

func bind_reflected(name: String, value: Reflected) {
    var binding = ReflectedBinding(name, value)
    reflected_bindings.append(binding)
}

func unbind_reflected() {
    reflected_bindings.remove_last()
}

func reflected_class(described: Analysis.SpiteType): Reflected {
    var made = Reflected("class")
    made.described_type = described
    return made
}

func reflected_text(text: String, is_symbol: Boolean): Reflected {
    var made = Reflected("text")
    made.name = text
    made.is_symbol = is_symbol
    return made
}

func reflected_truth(truth: Boolean): Reflected {
    var made = Reflected("boolean")
    made.truth = truth
    return made
}

func reflected_number(value: Integer): Reflected {
    var made = Reflected("integer")
    made.position = value
    return made
}

func reflected_null(): Reflected {
    return Reflected("null")
}

func reflected_namespace(dotted: String): Reflected {
    if dotted.is_empty() {
        return reflected_null()
    }
    var made = Reflected("namespace")
    made.name = dotted
    return made
}

func reflected_list(elements: List<Reflected>): Reflected {
    var made = Reflected("list")
    made.elements = elements
    return made
}

func reflected(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    switch expression {
        Syntax.Expressions.IdentifierExpression: return reflected_name(expression.name, scope, class_information)
        Syntax.Expressions.GenericIdentifierExpression: return reflected_generic(expression.name, class_information)
        Syntax.Expressions.MemberExpression: return reflected_member_read(expression, scope, class_information)
        Syntax.Expressions.IndexExpression: return reflected_index(expression, scope, class_information)
        Syntax.Expressions.CallExpression: return reflected_call(expression, scope, class_information)
        Syntax.Expressions.BinaryExpression: return reflected_binary(expression, scope, class_information)
        Syntax.Expressions.UnaryExpression: return reflected_not(expression, scope, class_information)
        Syntax.Expressions.StringLiteralExpression: {
            assert not expression.value.contains("\{")
            return reflected_text(expression.value, false)
        }
        Syntax.Expressions.EnumLiteralExpression: return reflected_text(expression.value, true)
        Syntax.Expressions.IntegerLiteral: {
            var number: Integer = expression.value
            return reflected_number(number)
        }
        Syntax.Expressions.TrueLiteral: return reflected_truth(true)
        Syntax.Expressions.FalseLiteral: return reflected_truth(false)
        Syntax.Expressions.NullLiteral: return reflected_null()
        _: return null
    }
}

func reflected_generic(name: String, class_information: Analysis.ClassInfo): Reflected? {
    var bare_name = without_dollar(name)
    assert codegen_index(class_information, bare_name) >= 0
    var bound_type = codegen_bound_type(bare_name, class_information)
    assert bound_type
    return reflected_class(bound_type)
}

func reflected_not(
    unary: Syntax.Expressions.UnaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    crash unary.operand
    assert unary.operator == 'logical_not'
    var inner = reflected(unary.operand, scope, class_information)
    assert inner
    assert inner.kind == "boolean"
    return reflected_truth(not inner.truth)
}

func reflected_name(name: String, scope: Scope, class_information: Analysis.ClassInfo): Reflected? {
    var bound = reflected_binding(name)
    if bound {
        return bound
    }
    assert not scope.lookup_type(name) and not class_information.find_field(name)
    if name == "class" {
        var own_type = value_class_type(class_information)
        return reflected_class(own_type)
    }
    if name == "namespace" {
        return reflected_namespace(class_information.namespace_dotted)
    }
    var first_code = name.code_at(0)
    assert first_code >= 65 and first_code <= 90
    return reflected_path(name, class_information)
}

func reflected_path(dotted: String, class_information: Analysis.ClassInfo): Reflected? {
    var named_enum = find_enum(dotted)
    if named_enum {
        var enum_type = enum_type_of(named_enum)
        return reflected_class(enum_type)
    }
    var named = find_class(dotted, class_information.qualified_dotted)
    if named {
        assert not named.is_generic_template
        var named_type = value_class_type(named)
        return reflected_class(named_type)
    }
    var plain = plain_type_named(dotted)
    if plain {
        return reflected_class(plain)
    }
    var namespace_dotted = nearest_namespace(dotted, class_information.namespace_dotted)
    assert not namespace_dotted.is_empty()
    return reflected_namespace(namespace_dotted)
}

func plain_type_named(name: String): Analysis.SpiteType? {
    var plain = [
        "Integer"
        "Long"
        "Tiny"
        "Short"
        "Byte"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Float"
        "Double"
        "Boolean"
        "String"
        "Symbol"
    ]
    assert plain.contains(name)
    var path = [name]
    var no_arguments = List<Syntax.Types.GenericArgument>()
    var named = Syntax.Types.NamedType(path, no_arguments)
    return resolve_named_type(named, "")
}

func known_namespaces(): List<String> {
    if namespaces_known_for == classes.count() {
        return namespaces_known
    }
    namespaces_known_for = classes.count()
    namespaces_known = List<String>()
    var index = 0
    while index < classes.count() {
        var known_class = classes[index]
        add_namespace_prefixes(known_class.namespace_dotted)
        index = index + 1
    }
    return namespaces_known
}

func add_namespace_prefixes(dotted: String) {
    assert not dotted.is_empty()
    var segments = dotted.split(".")
    var prefix = List<String>()
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        prefix.append(segment)
        var joined = prefix.join(".")
        if not namespaces_known.contains(joined) {
            namespaces_known.append(joined)
        }
        index = index + 1
    }
}

func nearest_namespace(name: String, current_namespace: String): String {
    var known = known_namespaces()
    var segments = current_namespace.split(".")
    if current_namespace.is_empty() {
        segments.clear()
    }
    while not segments.is_empty() {
        var candidate = "{segments.join(".")}.{name}"
        if known.contains(candidate) {
            return candidate
        }
        segments.remove_last()
    }
    if known.contains(name) {
        return name
    }
    return ""
}

func static_value_type(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var identifier = shape.as_identifier(expression)
    assert identifier
    assert not reflected_binding(identifier.name)
    var local_type = scope.lookup_type(identifier.name)
    if not local_type {
        var field = class_information.find_field(identifier.name)
        if field {
            local_type = field.type
        }
    }
    assert local_type
    assert not type_shape.as_union(local_type) and not type_shape.as_nullable(local_type)
    return local_type
}

func reflected_member_read(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    crash member.object
    var whole = reflected_static_path(member, scope, class_information)
    if whole {
        return whole
    }
    var object = reflected(member.object, scope, class_information)
    if object {
        return reflected_member_of(object, member.name, class_information)
    }
    var described = member.name == "class" or member.name == "attributes" or member.name == "functions"
    assert described
    var value_type = static_value_type(member.object, scope, class_information)
    assert value_type
    assert not is_reflection_type(value_type)
    var value_class = reflected_class(value_type)
    if member.name == "class" {
        return value_class
    }
    var listed = reflected_member_of(value_class, member.name, class_information)
    assert listed
    if member.name == "attributes" {
        listed = bound_attributes(listed, member.object)
    }
    return listed
}

func bound_attributes(listed: Reflected, instance: Syntax.Expressions.Expression): Reflected {
    var bound = List<Reflected>()
    var index = 0
    while index < listed.elements.count() {
        var element = listed.elements[index]
        var copied = Reflected("attribute")
        copied.owner = element.owner
        copied.name = element.name
        copied.described_type = element.described_type
        copied.position = element.position
        copied.bound = instance
        bound.append(copied)
        index = index + 1
    }
    return reflected_list(bound)
}

func reflected_static_path(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    var segments = List<String>()
    assert collect_static_segments(member, segments)
    assert segments[0]
    var root_code = segments[0].code_at(0)
    assert root_code >= 65 and root_code <= 90
    assert not reflected_binding(segments[0]) and not scope.lookup_type(segments[0])
    assert not class_information.find_field(segments[0])
    var dotted = segments.join(".")
    return reflected_path(dotted, class_information)
}

func reflected_member_of(object: Reflected, name: String, class_information: Analysis.ClassInfo): Reflected? {
    switch object.kind {
        "class": return reflected_class_member(object, name, class_information)
        "namespace": return reflected_namespace_member(object, name)
        "function": return reflected_function_member(object, name, class_information)
        "argument": return reflected_argument_member(object, name)
        "attribute": return reflected_attribute_member(object, name)
        "access": return reflected_access_member(object, name)
        "enum": {
            assert name == "name"
            return reflected_text(object.name, true)
        }
        _: return null
    }
}

func reflected_class_name(described: Analysis.SpiteType): Reflected {
    var described_class = class_of_type(described)
    if described_class {
        return reflected_text(described_class.simple_name, true)
    }
    var shown = type_display_name(described)
    return reflected_text(shown, true)
}

func reflected_class_member(object: Reflected, name: String, class_information: Analysis.ClassInfo): Reflected? {
    crash object.described_type
    var described = object.described_type
    var described_class = class_of_type(described)
    switch name {
        "name": return reflected_class_name(described)
        "namespace": {
            assert described_class
            return reflected_namespace(described_class.namespace_dotted)
        }
        "is_singleton": {
            var singleton = false
            if described_class {
                singleton = described_class.is_singleton
            }
            return reflected_truth(singleton)
        }
        "is_list": return reflected_kind_test(described, "list")
        "is_dictionary": return reflected_kind_test(described, "dictionary")
        "is_optional": return reflected_kind_test(described, "optional")
        "is_enum": return reflected_kind_test(described, "enum")
        "is_fixed_size": {
            var problem = vector_item_problem(described)
            var fixed = problem.is_empty()
            return reflected_truth(fixed)
        }
        "is_stateful": {
            var stateful = false
            if described_class {
                var visited = List<String>()
                stateful = class_has_state(described_class, visited)
            }
            return reflected_truth(stateful)
        }
        "element_type": return reflected_element_type(described)
        "value_type": return reflected_value_type(described)
        "values": return reflected_enum_values(described)
        "attributes": {
            assert described_class
            return reflected_attributes(described_class)
        }
        "functions": {
            assert described_class
            assert described_class.c_name != entry_class_c_name
            return reflected_functions(described_class)
        }
        "instances": {
            assert described_class
            if described_class.c_name == "Spite_Namespace" {
                return reflected_every_namespace()
            }
            assert described_class.c_name == "Spite_Class"
            return reflected_every_class()
        }
        _: return null
    }
}

func reflected_every_class(): Reflected {
    var every = List<Reflected>()
    var index = 0
    while index < classes.count() {
        var candidate = classes[index]
        if is_listed_class(candidate) {
            var candidate_type = value_class_type(candidate)
            var candidate_class = reflected_class(candidate_type)
            every.append(candidate_class)
        }
        index = index + 1
    }
    return reflected_list(every)
}

func reflected_every_namespace(): Reflected {
    var dotted_names = List<String>()
    var index = 0
    while index < classes.count() {
        var candidate = classes[index]
        if is_listed_class(candidate) and not candidate.namespace_dotted.is_empty() {
            add_prefixes_to(candidate.namespace_dotted, dotted_names)
        }
        index = index + 1
    }
    var every = List<Reflected>()
    index = 0
    while index < dotted_names.count() {
        var dotted = dotted_names[index]
        var namespace = reflected_namespace(dotted)
        every.append(namespace)
        index = index + 1
    }
    return reflected_list(every)
}

func add_prefixes_to(dotted: String, names: List<String>) {
    var segments = dotted.split(".")
    var prefix = List<String>()
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        prefix.append(segment)
        var joined = prefix.join(".")
        if not names.contains(joined) {
            names.append(joined)
        }
        index = index + 1
    }
}

func reflected_kind_test(described: Analysis.SpiteType, kind: String): Reflected {
    var answer = false
    switch kind {
        "list": {
            if type_shape.as_list(described) {
                answer = true
            }
        }
        "dictionary": {
            if type_shape.as_dictionary(described) {
                answer = true
            }
        }
        "optional": {
            if type_shape.as_nullable(described) {
                answer = true
            }
        }
        _: {
            if type_shape.as_enum(described) {
                answer = true
            }
        }
    }
    return reflected_truth(answer)
}

func reflected_element_type(described: Analysis.SpiteType): Reflected {
    var described_list = type_shape.as_list(described)
    if described_list {
        var element = described_list.element
        return reflected_class(element)
    }
    var described_optional = type_shape.as_nullable(described)
    if described_optional {
        var inner = described_optional.inner
        return reflected_class(inner)
    }
    return reflected_null()
}

func reflected_value_type(described: Analysis.SpiteType): Reflected {
    var described_dictionary = type_shape.as_dictionary(described)
    if described_dictionary {
        var value_type = described_dictionary.element
        return reflected_class(value_type)
    }
    return reflected_null()
}

func reflected_enum_values(described: Analysis.SpiteType): Reflected? {
    var described_enum = type_shape.as_enum(described)
    assert described_enum
    var enum_values = List<Reflected>()
    var index = 0
    while index < described_enum.values.count() {
        var value = Reflected("enum")
        value.name = described_enum.values[index]
        value.described_type = described
        value.position = index
        enum_values.append(value)
        index = index + 1
    }
    return reflected_list(enum_values)
}

func reflected_attributes(described_class: Analysis.ClassInfo): Reflected {
    item_values.reflect(described_class.qualified_dotted)
    var attributes = List<Reflected>()
    var index = 0
    while index < described_class.fields.count() and not described_class.is_value_class {
        var field = described_class.fields[index]
        var attribute = Reflected("attribute")
        attribute.owner = described_class
        attribute.name = field.name
        attribute.described_type = field.type
        attribute.position = index
        attributes.append(attribute)
        index = index + 1
    }
    return reflected_list(attributes)
}

func reflected_functions(described_class: Analysis.ClassInfo): Reflected {
    item_values.untrust_class(described_class.qualified_dotted)
    var functions = List<Reflected>()
    var declared = declared_functions_of(described_class)
    var index = 0
    while index < declared.count() {
        var declared_function = declared[index]
        if declared_function.specialisation_position < 0 {
            var reflected_function = Reflected("function")
            reflected_function.owner = described_class
            reflected_function.function = declared_function
            reflected_function.name = declared_function.name
            functions.append(reflected_function)
        }
        index = index + 1
    }
    return reflected_list(functions)
}

func reflected_namespace_member(object: Reflected, name: String): Reflected? {
    var dotted = object.name
    var segments = dotted.split(".")
    switch name {
        "name": {
            var last = segments.last()
            crash last
            return reflected_text(last, true)
        }
        "name_with_namespaces": return reflected_text(dotted, true)
        "parent": {
            segments.remove_last()
            var parent = segments.join(".")
            return reflected_namespace(parent)
        }
        "classes": return reflected_namespace_classes(dotted, false)
        "every_class": return reflected_namespace_classes(dotted, true)
        "namespaces": return reflected_child_namespaces(dotted)
        "enums": return reflected_namespace_enums(dotted)
        _: return null
    }
}

func reflected_namespace_classes(dotted: String, every: Boolean): Reflected {
    var listed = List<Reflected>()
    var index = 0
    while index < classes.count() {
        var candidate = classes[index]
        var inside = candidate.namespace_dotted == dotted
        if every and candidate.namespace_dotted.starts_with("{dotted}.") {
            inside = true
        }
        if inside and is_listed_class(candidate) {
            var candidate_type = value_class_type(candidate)
            var candidate_class = reflected_class(candidate_type)
            listed.append(candidate_class)
        }
        index = index + 1
    }
    return reflected_list(listed)
}

func reflected_namespace_enums(dotted: String): Reflected {
    var listed = List<Reflected>()
    var declared = enums_in_namespace(dotted)
    var index = 0
    while index < declared.count() {
        var enum_type = enum_type_of(declared[index])
        var enum_class = reflected_class(enum_type)
        listed.append(enum_class)
        index = index + 1
    }
    return reflected_list(listed)
}

func enums_in_namespace(dotted: String): List<Analysis.EnumInfo> {
    var declared = List<Analysis.EnumInfo>()
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        var owner = find_class_by_qualified(candidate.owner_qualified)
        if owner {
            if owner.namespace_dotted == dotted and is_listed_class(owner) {
                declared.append(candidate)
            }
        }
        index = index + 1
    }
    return declared
}

func reflected_child_namespaces(dotted: String): Reflected {
    var children = List<Reflected>()
    var depth = dotted.split(".").count()
    var known = known_namespaces()
    var index = 0
    while index < known.count() {
        var candidate = known[index]
        var child_depth = candidate.split(".").count()
        if candidate.starts_with("{dotted}.") and child_depth == depth + 1 {
            var child = reflected_namespace(candidate)
            children.append(child)
        }
        index = index + 1
    }
    return reflected_list(children)
}

func reflected_function_member(object: Reflected, name: String, class_information: Analysis.ClassInfo): Reflected? {
    crash object.owner
    crash object.function
    var owner = object.owner
    var function = object.function
    switch name {
        "name": return reflected_text(function.name, true)
        "owner": {
            var owner_type = value_class_type(owner)
            return reflected_class(owner_type)
        }
        "returns": {
            var returned = function.return_type
            return reflected_class(returned)
        }
        "arguments": return reflected_arguments_of(owner, function)
        "accesses": return reflected_accesses(owner, function, true)
        "is_resumable": {
            var resumable = class_function_waits(owner, function.name, class_information)
            return reflected_truth(resumable)
        }
        "returned_literal": {
            var literal = returned_literal(function)
            if literal {
                return reflected_text(literal, false)
            }
            report_unliteral_body(owner, function, "'{function.name}.returned_literal' reads it while compiling")
            return reflected_text("", false)
        }
        _: return null
    }
}

func reflected_arguments_of(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo): Reflected {
    var arguments = List<Reflected>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var argument = Reflected("argument")
        argument.owner = owner
        argument.function = function
        argument.name = parameter.name
        argument.described_type = parameter.type
        argument.position = index
        arguments.append(argument)
        index = index + 1
    }
    return reflected_list(arguments)
}

func reflected_argument_member(object: Reflected, name: String): Reflected? {
    crash object.owner
    crash object.function
    crash object.described_type
    switch name {
        "name": return reflected_text(object.name, true)
        "class": return reflected_class(object.described_type)
        "index": return reflected_number(object.position)
        "function": {
            var function = Reflected("function")
            function.owner = object.owner
            function.function = object.function
            function.name = object.function.name
            return function
        }
        "is_mutated": {
            var slot: String = object.position
            var written = parameter_writes.answer(this, object.owner, object.function, slot)
            note_fact("asks writes {object.function.c_name} {slot} {written}")
            return reflected_truth(written)
        }
        _: return null
    }
}

func reflected_attribute_member(object: Reflected, name: String): Reflected? {
    crash object.owner
    crash object.described_type
    switch name {
        "name": return reflected_text(object.name, true)
        "class": return reflected_class(object.described_type)
        "index": return reflected_number(object.position)
        "owner": {
            var owner_type = value_class_type(object.owner)
            return reflected_class(owner_type)
        }
        "camel_case_name": {
            var camel = joined_case_spelling(object.name, false)
            return reflected_text(camel, false)
        }
        "pascal_case_name": {
            var pascal = joined_case_spelling(object.name, true)
            return reflected_text(pascal, false)
        }
        "is_singleton": {
            var singleton = false
            var held = class_of_type(object.described_type)
            if held {
                singleton = held.is_singleton
            }
            return reflected_truth(singleton)
        }
        _: return null
    }
}

func reflected_accesses(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo, noting: Boolean): Reflected {
    var read_names = List<String>()
    var visited = List<String>()
    collect_function_reads(owner, function, true, read_names, visited)
    var accesses = List<Reflected>()
    var index = 0
    while index < owner.fields.count() {
        var field = owner.fields[index]
        var slot = "@{field.name}"
        var written = parameter_writes.answer(this, owner, function, slot)
        if noting {
            note_fact("asks writes {function.c_name} {slot} {written}")
        }
        var read = read_names.contains(field.name)
        if read or written {
            var attribute = Reflected("attribute")
            attribute.owner = owner
            attribute.name = field.name
            attribute.described_type = field.type
            attribute.position = index
            var attribute_access = reflected_access(attribute, read, written)
            accesses.append(attribute_access)
        }
        index = index + 1
    }
    index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var position: String = index
        var mutated = parameter_writes.answer(this, owner, function, position)
        if noting {
            note_fact("asks writes {function.c_name} {position} {mutated}")
        }
        var used = read_names.contains(parameter.name)
        if used or mutated {
            var argument = Reflected("argument")
            argument.owner = owner
            argument.function = function
            argument.name = parameter.name
            argument.described_type = parameter.type
            argument.position = index
            var argument_access = reflected_access(argument, used, mutated)
            accesses.append(argument_access)
        }
        index = index + 1
    }
    return reflected_list(accesses)
}

func reflected_access(target: Reflected, read: Boolean, written: Boolean): Reflected {
    var access = Reflected("access")
    access.name = target.name
    access.is_read = read
    access.is_written = written
    access.elements.append(target)
    return access
}

func reflected_access_member(object: Reflected, name: String): Reflected? {
    switch name {
        "is_read": return reflected_truth(object.is_read)
        "is_written": return reflected_truth(object.is_written)
        "target": {
            var target = object.elements.first()
            crash target
            return target
        }
        _: return null
    }
}

func collect_function_reads(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    every_name: Boolean,
    names: List<String>,
    visited: List<String>,
) {
    assert not visited.contains(function.c_name)
    visited.append(function.c_name)
    var mentioned = List<String>()
    collect_read_block(function.body, mentioned)
    var index = 0
    while index < mentioned.count() {
        var name = mentioned[index]
        var kept = every_name
        if owner.find_field(name) {
            kept = true
        }
        if kept and not names.contains(name) {
            names.append(name)
        }
        var own = owner.find_function(name)
        if own {
            if not own.is_constructor {
                collect_function_reads(owner, own, false, names, visited)
            }
        }
        index = index + 1
    }
}

func collect_read_block(statements: List<Syntax.Statements.Statement>, names: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_read_statement(statements[index], names)
        index = index + 1
    }
}

func collect_read_statement(statement: Syntax.Statements.Statement, names: List<String>) {
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            collect_target_reads(statement.target, names)
            collect_optional_names(statement.value, names)
        }
        Syntax.Statements.IfStatement: {
            collect_optional_names(statement.condition, names)
            collect_read_block(statement.then_branch, names)
            collect_read_block(statement.else_branch, names)
        }
        Syntax.Statements.WhileStatement: {
            collect_optional_names(statement.condition, names)
            collect_read_block(statement.body, names)
        }
        Syntax.Statements.SwitchStatement: {
            collect_optional_names(statement.subject, names)
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_read_block(statement.cases[case_index].body, names)
                case_index = case_index + 1
            }
        }
        _: collect_statement_names(statement, names)
    }
}

func collect_target_reads(target: Syntax.Expressions.Expression?, names: List<String>) {
    assert target
    var member = shape.as_member(target)
    if member {
        collect_target_reads(member.object, names)
        return
    }
    var indexed = shape.as_index(target)
    if indexed {
        collect_target_reads(indexed.object, names)
        collect_optional_names(indexed.index, names)
        return
    }
    assert not shape.as_identifier(target)
    collect_mentioned_names(target, names)
}

func reflected_index(
    indexed: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    crash indexed.object
    crash indexed.index
    var listed = reflected(indexed.object, scope, class_information)
    assert listed
    assert listed.kind == "list"
    var key = reflected(indexed.index, scope, class_information)
    assert key
    if key.kind == "text" {
        return reflected_named_element(listed, key.name)
    }
    assert key.kind == "integer"
    if key.position < 0 or key.position >= listed.elements.count() {
        return reflected_null()
    }
    return listed.elements[key.position]
}

func reflected_named_element(listed: Reflected, name: String): Reflected {
    var index = 0
    while index < listed.elements.count() {
        var element = listed.elements[index]
        var element_name = reflected_name_of(element)
        if element_name == name {
            return element
        }
        index = index + 1
    }
    return reflected_null()
}

func reflected_name_of(element: Reflected): String {
    switch element.kind {
        "class": {
            crash element.described_type
            var class_name = reflected_class_name(element.described_type)
            return class_name.name
        }
        "namespace": {
            var segments = element.name.split(".")
            var last = segments.last()
            crash last
            return last
        }
        _: return element.name
    }
}

func reflected_call(
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    var receiver = reflected(member.object, scope, class_information)
    assert receiver
    if member.name == "filter" and receiver.kind == "list" {
        assert call.arguments.count() == 1
        var chosen = call.arguments[0]
        return reflected_filter(receiver.elements, chosen, scope, class_information)
    }
    var arguments = List<Reflected>()
    var argument_index = 0
    while argument_index < call.arguments.count() {
        var argument_ast = call.arguments[argument_index]
        var argument = reflected(argument_ast, scope, class_information)
        assert argument
        arguments.append(argument)
        argument_index = argument_index + 1
    }
    if receiver.kind == "text" {
        return reflected_text_call(receiver.name, member.name, arguments)
    }
    assert receiver.kind == "list"
    return reflected_list_call(receiver.elements, member.name, arguments, class_information)
}

func reflected_list_call(
    elements: List<Reflected>,
    name: String,
    arguments: List<Reflected>,
    class_information: Analysis.ClassInfo,
): Reflected? {
    switch name {
        "count": {
            var counted = elements.count()
            return reflected_number(counted)
        }
        "is_empty": {
            var empty = elements.is_empty()
            return reflected_truth(empty)
        }
        "first": {
            var first = elements.first()
            if first {
                return first
            }
            return reflected_null()
        }
        "last": {
            var last = elements.last()
            if last {
                return last
            }
            return reflected_null()
        }
        _: return reflected_member_template(elements, name, arguments, class_information)
    }
}

func reflected_text_call(text: String, name: String, arguments: List<Reflected>): Reflected? {
    assert arguments.count() == 1
    var argument = arguments[0]
    assert argument.kind == "text"
    var asked = argument.name
    switch name {
        "ends_with": {
            var ends = text.ends_with(asked)
            return reflected_truth(ends)
        }
        "starts_with": {
            var starts = text.starts_with(asked)
            return reflected_truth(starts)
        }
        "contains": {
            var holds = text.contains(asked)
            return reflected_truth(holds)
        }
        "without_suffix": {
            var kept = text
            if text.ends_with(asked) {
                var kept_length = text.length() - asked.length()
                kept = text.slice(0, kept_length)
            }
            return reflected_text(kept, false)
        }
        "without_prefix": {
            var kept = text
            if text.starts_with(asked) {
                var text_length = text.length()
                var asked_length = asked.length()
                kept = text.slice(asked_length, text_length)
            }
            return reflected_text(kept, false)
        }
        _: return null
    }
}

func reflected_filter(
    elements: List<Reflected>,
    chosen: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    var chosen_name = shape.as_identifier(chosen)
    assert chosen_name
    var function = class_information.find_function(chosen_name.name)
    assert function
    assert function.parameters.count() == 1 and function.body.count() == 1
    var returned = shape.as_return_statement(function.body[0])
    assert returned
    var parameter = function.parameters[0]
    var kept = List<Reflected>()
    var index = 0
    while index < elements.count() {
        var element = elements[index]
        bind_reflected(parameter.name, element)
        crash returned.value
        var answer = reflected(returned.value, scope, class_information)
        unbind_reflected()
        assert answer
        assert answer.kind == "boolean"
        if answer.truth {
            kept.append(element)
        }
        index = index + 1
    }
    return reflected_list(kept)
}

func member_template_prefix(name: String): String {
    var prefixes = ["filter_", "count_", "any_", "all_", "find_by_"]
    var index = 0
    while index < prefixes.count() {
        var candidate = prefixes[index]
        if name.starts_with(candidate) {
            return candidate
        }
        index = index + 1
    }
    return ""
}

func reflected_member_template(
    elements: List<Reflected>,
    name: String,
    arguments: List<Reflected>,
    class_information: Analysis.ClassInfo,
): Reflected? {
    var prefix = member_template_prefix(name)
    assert not prefix.is_empty()
    var name_length = name.length()
    var prefix_length = prefix.length()
    var chain = name.slice(prefix_length, name_length)
    if prefix == "find_by_" {
        return reflected_found(elements, chain, arguments, class_information)
    }
    var kept = List<Reflected>()
    var index = 0
    while index < elements.count() {
        var element = elements[index]
        var answer = reflected_chain(element, chain, arguments, class_information)
        assert answer
        assert answer.kind == "boolean"
        if answer.truth {
            kept.append(element)
        }
        index = index + 1
    }
    switch prefix {
        "filter_": return reflected_list(kept)
        "count_": {
            var counted = kept.count()
            return reflected_number(counted)
        }
        "any_": {
            var any = not kept.is_empty()
            return reflected_truth(any)
        }
        _: {
            var all = kept.count() == elements.count()
            return reflected_truth(all)
        }
    }
}

func reflected_found(
    elements: List<Reflected>,
    member_name: String,
    arguments: List<Reflected>,
    class_information: Analysis.ClassInfo,
): Reflected? {
    assert arguments.count() == 1
    var wanted = arguments[0]
    var index = 0
    while index < elements.count() {
        var element = elements[index]
        var value = reflected_member_of(element, member_name, class_information)
        assert value
        if reflected_same(value, wanted) {
            return element
        }
        index = index + 1
    }
    return reflected_null()
}

func reflected_chain(
    element: Reflected,
    chain: String,
    arguments: List<Reflected>,
    class_information: Analysis.ClassInfo,
): Reflected? {
    if arguments.is_empty() {
        var direct = reflected_member_of(element, chain, class_information)
        if direct {
            return direct
        }
        return reflected_member_of(element, "is_{chain}", class_information)
    }
    var words = chain.split("_")
    var split = 1
    while split < words.count() {
        var member_words = List<String>()
        var method_words = List<String>()
        var word_index = 0
        while word_index < words.count() {
            var word = words[word_index]
            if word_index < split {
                member_words.append(word)
            } else {
                method_words.append(word)
            }
            word_index = word_index + 1
        }
        var member_name = member_words.join("_")
        var method_name = method_words.join("_")
        var value = reflected_member_of(element, member_name, class_information)
        if value {
            assert value.kind == "text"
            return reflected_text_call(value.name, method_name, arguments)
        }
        split = split + 1
    }
    return null
}

func reflected_same(left: Reflected, right: Reflected): Boolean {
    var named_kinds = ["text", "enum", "namespace"]
    if named_kinds.contains(left.kind) and named_kinds.contains(right.kind) {
        return left.name == right.name
    }
    if left.kind != right.kind {
        return false
    }
    switch left.kind {
        "boolean": return left.truth == right.truth
        "integer": return left.position == right.position
        "null": return true
        _: {
            var left_key = reflected_key(left)
            var right_key = reflected_key(right)
            return left_key == right_key
        }
    }
}

func reflected_binary(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected? {
    crash binary.left
    crash binary.right
    var left = reflected(binary.left, scope, class_information)
    assert left
    var decided_by_left = left.kind == "boolean" and (binary.operator == 'logical_and' and not left.truth or binary.operator == 'logical_or' and left.truth)
    if decided_by_left {
        return left
    }
    var right = reflected(binary.right, scope, class_information)
    assert right
    if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
        assert right.kind == "boolean"
        return right
    }
    var same = reflected_same(left, right)
    switch binary.operator {
        'equal': return reflected_truth(same)
        'not_equal': return reflected_truth(not same)
        _: return null
    }
}

func reflected_key(value: Reflected): String {
    switch value.kind {
        "class": {
            crash value.described_type
            return "class {c_type_name(value.described_type)}"
        }
        "attribute": {
            crash value.owner
            var bound_mark = ""
            if value.bound {
                bound_mark = " bound"
            }
            return "attribute {value.owner.c_name} {value.name}{bound_mark}"
        }
        "function": {
            crash value.owner
            return "function {value.owner.c_name} {value.name}"
        }
        "argument": {
            crash value.owner
            crash value.function
            return "argument {value.owner.c_name} {value.function.name} {value.position}"
        }
        _: return "{value.kind} {value.name} {value.position} {value.truth}"
    }
}

func reflected_word(value: Reflected): String {
    switch value.kind {
        "class": {
            crash value.described_type
            var described_class = class_of_type(value.described_type)
            if described_class {
                return snake_words(described_class.simple_name)
            }
            var label = type_label(value.described_type)
            return snake_words(label)
        }
        "namespace": {
            var lowered = value.name.lower_case()
            return lowered.replace(".", "_")
        }
        "argument": {
            crash value.function
            return "{value.function.name}_{value.name}"
        }
        _: return value.name
    }
}

func matches_parameter(constant: Reflected, parameter_type: Analysis.SpiteType): Boolean {
    var class_ref = type_shape.as_class_ref(parameter_type)
    if not class_ref {
        return false
    }
    switch class_ref.c_name {
        "Spite_Class": return constant.kind == "class"
        "Spite_Namespace": return constant.kind == "namespace"
        "Spite_Function": return constant.kind == "function"
        "Spite_Argument": return constant.kind == "argument"
        "Spite_Attribute": return constant.kind == "attribute" and constant.is_bound()
        "Spite_AttributeDeclaration": return constant.kind == "attribute" and not constant.bound
        "Spite_Access": return constant.kind == "access"
        _: return false
    }
}

func reflected_argument_at(
    taker: String,
    parameter_type: Analysis.SpiteType,
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Reflected {
    var not_constant = Reflected("")
    if not is_reflection_type(parameter_type) or not worth_reflecting(argument, scope) {
        return not_constant
    }
    var found = reflected(argument, scope, class_information)
    if not found {
        return not_constant
    }
    if not matches_parameter(found, parameter_type) {
        report_attribute_mismatch(found, parameter_type, taker)
        return not_constant
    }
    return found
}

func reflected_arguments(
    function: Analysis.FunctionInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<Reflected> {
    var constants = List<Reflected>()
    var any_constant = false
    var index = 0
    while index < function.parameters.count() and index < arguments_ast.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        var argument = arguments_ast[index]
        var constant = reflected_argument_at(function.name, parameter_type, argument, scope, class_information)
        if not constant.kind.is_empty() {
            any_constant = true
        }
        constants.append(constant)
        index = index + 1
    }
    if not any_constant {
        constants.clear()
    }
    return constants
}

func specialisation_key(function: Analysis.FunctionInfo, constants: List<Reflected>): String {
    var key_parts = [function.c_name]
    var index = 0
    while index < constants.count() {
        var constant = constants[index]
        var constant_key = reflected_key(constant)
        key_parts.append(constant_key)
        index = index + 1
    }
    return key_parts.join("|")
}

func specialisation_name(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    constants: List<Reflected>,
): String {
    var words = List<String>()
    var index = 0
    while index < constants.count() {
        var constant = constants[index]
        if not constant.kind.is_empty() {
            var word = reflected_word(constant)
            words.append(word)
        }
        index = index + 1
    }
    var base_name = "{function.name}_for_{words.join("_")}"
    var name = base_name
    var counter = 2
    while information.find_function(name) {
        name = "{base_name}_{counter}"
        counter = counter + 1
    }
    return name
}

func bound_copy(constant: Reflected, instance_name: String): Reflected {
    var copied = Reflected("attribute")
    copied.owner = constant.owner
    copied.name = constant.name
    copied.described_type = constant.described_type
    copied.position = constant.position
    copied.bound = Syntax.Expressions.IdentifierExpression(instance_name)
    return copied
}

func specialised_return_type(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    bindings: List<ReflectedBinding>,
): Analysis.SpiteType {
    var return_type = function.return_type
    var declaration_position = reflection_declaration_positions[function.c_name]
    crash declaration_position
    crash reflection_declarations[declaration_position]
    var declaration = reflection_declarations[declaration_position]
    crash declaration.return_type
    var saved_bindings = reflected_bindings
    reflected_bindings = bindings.copy()
    var saved_class = current_class
    current_class = information
    var resolved_return = resolve_type(declaration.return_type, information.qualified_dotted)
    current_class = saved_class
    reflected_bindings = saved_bindings
    if resolved_return {
        return_type = resolved_return
    }
    return return_type
}

func bind_single_symbol(specialised: Analysis.FunctionInfo, bindings: List<ReflectedBinding>) {
    assert bindings.count() == 1
    var only_binding = bindings[0]
    var only = only_binding.value
    var described = only.kind == "attribute" and not only.bound or only.kind == "argument"
    assert described
    specialised.symbol_name = only_binding.name
    specialised.symbol_field_name = only.name
    specialised.symbol_field_type = only.described_type
    specialised.symbol_field_index = only.position
    if only.kind == "attribute" {
        crash only.owner
        specialised.symbol_owner_c_name = only.owner.c_name
    }
}

func specialised_function(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    constants: List<Reflected>,
): Analysis.FunctionInfo {
    var key = specialisation_key(function, constants)
    var known = specialisation_names[key]
    if known {
        var existing = information.find_function(known)
        crash existing
        return existing
    }
    var name = specialisation_name(information, function, constants)
    specialisation_names[key] = name
    var parameters = List<Analysis.ParamInfo>()
    var bindings = List<ReflectedBinding>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var constant = Reflected("")
        if index < constants.count() {
            constant = constants[index]
        }
        if constant.kind.is_empty() {
            parameters.append(parameter)
        } else {
            var bound_value = constant
            if constant.bound {
                crash constant.owner
                var instance_name = "{parameter.name}_instance"
                var instance_type = value_class_type(constant.owner)
                var instance = Analysis.ParamInfo(instance_name, instance_type)
                parameters.append(instance)
                bound_value = bound_copy(constant, instance_name)
            }
            var binding = ReflectedBinding(parameter.name, bound_value)
            bindings.append(binding)
        }
        index = index + 1
    }
    var return_type = function.return_type
    if constant_return_names.contains(function.c_name) {
        return_type = specialised_return_type(information, function, bindings)
    }
    var specialised = Analysis.FunctionInfo(
        name,
        "{information.c_name}_{name}",
        parameters,
        return_type,
        function.body,
        false,
    )
    specialised.line = function.line
    specialised.end_line = function.end_line
    specialised.source_path = function.source_path
    bind_single_symbol(specialised, bindings)
    var position = specialisations.count()
    var made = Specialisation(specialised.c_name, bindings)
    specialisations.append(made)
    specialised.specialisation_position = position
    information.declared_functions.append(specialised)
    builder.add_prototype("{function_signature(information, specialised)};")
    return specialised
}

func specialised_arguments(
    arguments_ast: List<Syntax.Expressions.Expression>,
    constants: List<Reflected>,
): List<Syntax.Expressions.Expression> {
    var passed = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < arguments_ast.count() {
        var argument = arguments_ast[index]
        var constant = Reflected("")
        if index < constants.count() {
            constant = constants[index]
        }
        if constant.kind.is_empty() {
            passed.append(argument)
        } else if constant.bound {
            passed.append(constant.bound)
        }
        index = index + 1
    }
    return passed
}

func specialised_call(
    function: Analysis.FunctionInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert waits_for_constants(class_information, function)
    var constants = reflected_arguments(function, arguments_ast, scope, class_information)
    assert not constants.is_empty()
    assert keeps_constants(function, constants)
    var specialised = specialised_function(class_information, function, constants)
    var passed = specialised_arguments(arguments_ast, constants)
    return generate_own_function_call(specialised.name, passed, scope, class_information)
}

func specialised_method_call(
    target_class: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert waits_for_constants(target_class, function)
    var constants = reflected_arguments(function, arguments_ast, scope, class_information)
    assert not constants.is_empty()
    assert keeps_constants(function, constants)
    var specialised = specialised_function(target_class, function, constants)
    var passed = specialised_arguments(arguments_ast, constants)
    var parameter_types = parameter_types_of(specialised.parameters)
    var returned = specialised.return_type
    return generate_generic_call(
        specialised.c_name,
        object_result,
        object_ast,
        passed,
        parameter_types,
        returned,
        scope,
        class_information,
    )
}

func bind_reflected_of(function: Analysis.FunctionInfo) {
    reflected_bindings = List<ReflectedBinding>()
    reflected_body = function.body
    assert function.specialisation_position >= 0
    assert specialisations[function.specialisation_position]
    var made = specialisations[function.specialisation_position]
    reflected_bindings = made.bindings.copy()
}

func reflected_walk_function(
    arguments_ast: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    assert arguments_ast.count() == 1
    var walked = arguments_ast[0]
    var walked_name = shape.as_identifier(walked)
    assert walked_name
    var function = class_information.find_function(walked_name.name)
    assert function
    assert function.parameters.count() == 1
    return function
}

func report_attribute_mismatch(found: Reflected, parameter_type: Analysis.SpiteType, taker: String) {
    var class_ref = type_shape.as_class_ref(parameter_type)
    assert class_ref
    assert found.kind == "attribute"
    crash found.owner
    if class_ref.c_name == "Spite_Attribute" and not found.is_bound() {
        report(
            "'{taker}' takes a 'Spite.Attribute', an attribute bound to an instance, and '{found.name}' here is a declaration of '{found.owner.simple_name}', which has no value: declare the parameter 'Spite.AttributeDeclaration', or walk an instance's attributes",
        )
    }
    if class_ref.c_name == "Spite_AttributeDeclaration" and found.is_bound() {
        report(
            "'{taker}' takes a 'Spite.AttributeDeclaration', and '{found.name}' here is bound to an instance: declare the parameter 'Spite.Attribute', or walk the class's attributes, '{found.owner.simple_name}.attributes'",
        )
    }
}

func walk_fits(listed: Reflected, function: Analysis.FunctionInfo): Boolean {
    crash function.parameters[0]
    var parameter = function.parameters[0]
    var parameter_type = parameter.type
    if is_reflection_type(parameter_type) and parameter_needs_value(function, parameter.name) {
        return false
    }
    var index = 0
    while index < listed.elements.count() {
        var element = listed.elements[index]
        var fits = element.kind == "enum" or matches_parameter(element, parameter_type)
        if not fits {
            report_attribute_mismatch(element, parameter_type, function.name)
            return false
        }
        index = index + 1
    }
    return true
}

func unrolled_walk(
    member: Syntax.Expressions.MemberExpression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert member.name == "each" or member.name == "map"
    crash member.object
    assert worth_reflecting(member.object, scope)
    var function = reflected_walk_function(arguments_ast, class_information)
    assert function
    var listed = reflected(member.object, scope, class_information)
    assert listed
    assert listed.kind == "list" and walk_fits(listed, function)
    var calls = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < listed.elements.count() {
        var element = listed.elements[index]
        var call = reflected_walk_call(function, element)
        calls.append(call)
        index = index + 1
    }
    if member.name == "map" {
        return unrolled_map(function, calls, scope, class_information)
    }
    var codes = List<String>()
    index = 0
    while index < calls.count() {
        var call = calls[index]
        var called = generate_expression(call, scope, class_information)
        codes.append(called.code)
        index = index + 1
    }
    var nothing_type = void_type()
    if codes.is_empty() {
        return ExpressionResult("(void)0", nothing_type)
    }
    return ExpressionResult("({codes.join(", ")})", nothing_type)
}

func reflected_walk_call(function: Analysis.FunctionInfo, element: Reflected): Syntax.Expressions.Expression {
    var element_name = "reflected_element_{reflected_element_counter}"
    reflected_element_counter = reflected_element_counter + 1
    var element_argument: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(element_name)
    if element.kind == "enum" {
        element_argument = Syntax.Expressions.EnumLiteralExpression(element.name)
    } else {
        bind_reflected(element_name, element)
    }
    var call_arguments = [element_argument]
    var callee: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(function.name)
    return Syntax.Expressions.CallExpression(callee, call_arguments)
}

func unrolled_map(
    function: Analysis.FunctionInfo,
    calls: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var elements = List<Syntax.Expressions.ListElement>()
    var element_type = function.return_type
    var index = 0
    while index < calls.count() {
        var call = calls[index]
        var element = Syntax.Expressions.ListElement(call)
        elements.append(element)
        index = index + 1
    }
    var first_call = calls.first()
    if first_call {
        var saved_counter = temporary_counter
        var probe = generate_expression(first_call, scope, class_information)
        rewind_temporaries(saved_counter)
        element_type = probe.type
    }
    if type_shape.is_void(element_type) {
        report(
            "'map' needs a function that answers a value, and '{function.name}' answers nothing: walk with 'each' instead",
        )
        return void_result()
    }
    var literal = Syntax.Expressions.ListLiteralExpression(elements)
    return generate_list_literal(literal, element_type, scope, class_information)
}

func folded_reflection(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert worth_reflecting(expression, scope)
    var found = reflected(expression, scope, class_information)
    assert found
    switch found.kind {
        "boolean": {
            var answer_type = boolean_type()
            var answer = "false"
            if found.truth {
                answer = "true"
            }
            var folded_answer = ExpressionResult(answer, answer_type)
            folded_answer.constant_text = "b:{answer}"
            return folded_answer
        }
        "integer": {
            var count_type = integer_type()
            var counted = ExpressionResult(found.position, count_type)
            counted.constant_text = "i:{found.position}"
            return counted
        }
        "text": return folded_text_result(found)
        "list": return materialised_list(found, scope, class_information)
        "namespace": return namespace_object_result(found.name)
        "enum": {
            crash found.described_type
            var enum_ref = type_shape.as_enum(found.described_type)
            crash enum_ref
            return ExpressionResult("{enum_ref.c_name}_{found.name}", found.described_type)
        }
        "class": {
            assert rooted_in_binding(expression)
            crash found.described_type
            var class_object_code = class_object_call(found.described_type)
            var class_object_type = spite_class_type()
            var class_object = ExpressionResult(class_object_code, class_object_type)
            class_object.owning_override = true
            return class_object
        }
        _: return null
    }
}

func folded_text_result(found: Reflected): ExpressionResult {
    if found.is_symbol {
        var symbol_code = ensure_symbol(found.name)
        var symbol_spite_type: Analysis.SpiteType = Analysis.Types.SymbolType()
        return ExpressionResult(symbol_code, symbol_spite_type)
    }
    var rendered = render_string_literal(found.name)
    var text_type = string_type()
    var text = ExpressionResult(rendered, text_type)
    text.constant_text = "s:{found.name}"
    return text
}

func namespace_object_result(dotted: String): ExpressionResult {
    var namespace_code = "{ensure_namespace_object(dotted)}()"
    var namespace_class = find_class_by_c_name("Spite_Namespace")
    crash namespace_class
    var namespace_type = class_type_of(namespace_class)
    var namespace_object = ExpressionResult(namespace_code, namespace_type)
    namespace_object.owning_override = true
    return namespace_object
}

func rooted_in_binding(expression: Syntax.Expressions.Expression): Boolean {
    var root = root_of(expression)
    var root_name = shape.as_identifier(root)
    if not root_name {
        return false
    }
    var bound = reflected_binding(root_name.name)
    if not bound {
        return false
    }
    return true
}

func reflected_condition(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    assert worth_reflecting(expression, scope)
    var found = reflected(expression, scope, class_information)
    assert found
    if found.kind == "boolean" {
        return found.truth
    }
    if found.kind == "null" {
        return false
    }
    assert found.is_object() or found.kind == "list" or found.kind == "enum"
    return true
}

func reflected_type(named: Syntax.Types.NamedType): Analysis.SpiteType? {
    var root = named.path.first()
    crash root
    var current: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(root)
    var index = 1
    while index < named.path.count() {
        var segment = named.path[index]
        current = Syntax.Expressions.MemberExpression(current, segment)
        index = index + 1
    }
    var empty_scope = Scope(null)
    crash current_class
    var found = reflected(current, empty_scope, current_class)
    if found {
        if found.kind == "class" {
            return found.described_type
        }
    }
    report(
        "'{named.path.join(".")}' is not a class known while compiling, so it cannot be a type here: a reflection object is a type only when it is a class the compiler can identify",
    )
    return null
}

func reassigned_in(statements: List<Syntax.Statements.Statement>, name: String): Boolean {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if statement_reassigns(statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_reassigns(statement: Syntax.Statements.Statement, name: String): Boolean {
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            return is_identifier_named(statement.target, name)
        }
        Syntax.Statements.IfStatement: return reassigned_in(statement.then_branch, name) or reassigned_in(statement.else_branch, name)
        Syntax.Statements.WhileStatement: return reassigned_in(statement.body, name)
        _: return false
    }
}

# ../../../docs/optimizations.md#a-dictionary-written-out-and-only-read-by-literal-keys-is-folded
func folds_dictionary_local(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash declaration.value
    var literal = shape.as_object_literal(declaration.value)
    if not literal or declaration.type_reference or hot_reload or keeps_internals {
        return false
    }
    if not literal.is_dictionary or literal.fields.is_empty() or not entries_are_literals(literal) {
        return false
    }
    var following = borrow_index + 1
    var printer = Syntax.SourcePrinter()
    while following < borrow_statements.count() {
        var later = printer.source_statement(borrow_statements[following], 0)
        if not only_read_by_literal_keys(later, declaration.name) {
            return false
        }
        following = following + 1
    }
    var first = literal.fields.first()
    crash first
    crash first.value
    var probe_counter = temporary_counter
    var probe = generate_expression(first.value, scope, class_information)
    rewind_temporaries(probe_counter)
    var key_type = literal_key_type(literal)
    var folded_type: Analysis.SpiteType = Analysis.Types.DictionaryType(probe.type, key_type)
    scope.declare(declaration.name, folded_type)
    scope.mark_used(declaration.name)
    folded_dictionaries[declaration.name] = literal
    return true
}

func entries_are_literals(literal: Syntax.Expressions.ObjectLiteralExpression): Boolean {
    var first_kind = ""
    var index = 0
    while index < literal.fields.count() {
        var entry = literal.fields[index]
        crash entry.value
        var kind = literal_kind(entry.value)
        if kind.is_empty() {
            return false
        }
        if index == 0 {
            first_kind = kind
        }
        if kind != first_kind {
            return false
        }
        index = index + 1
    }
    return true
}

func literal_kind(value: Syntax.Expressions.Expression): String {
    var text = shape.as_string_literal(value)
    if text {
        if text.value.contains("\{") {
            return ""
        }
        return "text"
    }
    if shape.as_integer_literal(value) {
        return "integer"
    }
    if shape.as_float_literal(value) {
        return "decimal"
    }
    if shape.is_true_literal(value) or shape.is_false_literal(value) {
        return "boolean"
    }
    return ""
}

func only_read_by_literal_keys(text: String, name: String): Boolean {
    var name_length = name.length()
    var text_length = text.length()
    var at = text.index_of(name)
    while at >= 0 {
        var after = at + name_length
        var stands_alone = name_boundary_before(text, at) and name_boundary_after(text, after)
        if stands_alone and not read_by_literal_key(text, after) {
            return false
        }
        var rest = text.slice(after, text_length)
        var next = rest.index_of(name)
        if next < 0 {
            at = -1
        } else {
            at = after + next
        }
    }
    return true
}

func name_boundary_before(text: String, at: Integer): Boolean {
    if at == 0 {
        return true
    }
    var code = text.code_at(at - 1)
    return not is_name_code(code) and code != 46
}

func name_boundary_after(text: String, at: Integer): Boolean {
    if at >= text.length() {
        return true
    }
    var code = text.code_at(at)
    return not is_name_code(code)
}

func is_name_code(code: Integer): Boolean {
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func read_by_literal_key(text: String, at: Integer): Boolean {
    var text_length = text.length()
    if at >= text_length or text.code_at(at) != 91 {
        return false
    }
    var close = at + 1
    while close < text_length and text.code_at(close) != 93 {
        close = close + 1
    }
    if close >= text_length {
        return false
    }
    var key = text.slice(at + 1, close)
    var quoted = key.length() >= 2 and key.starts_with("\"") and key.ends_with("\"") and not key.contains("\\") and not key.contains("\{")
    var number = key.to_long()
    if not quoted and not number {
        return false
    }
    var rest = text.slice(close + 1, text_length)
    var after = rest.trim()
    return not after.starts_with("=") or after.starts_with("==")
}

func folded_dictionary_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    crash index_expression.object
    crash index_expression.index
    var named = shape.as_identifier(index_expression.object)
    assert named and folded_dictionaries.has(named.name)
    var literal = folded_dictionaries[named.name]
    crash literal
    var first = literal.fields.first()
    crash first
    crash first.value
    var probe_counter = temporary_counter
    var probe = generate_expression(first.value, scope, class_information)
    rewind_temporaries(probe_counter)
    var answer_type = nullable_type_of(probe.type)
    var printer = Syntax.SourcePrinter()
    var wanted = printer.source_expression(index_expression.index)
    var index = 0
    while index < literal.fields.count() {
        var entry = literal.fields[index]
        crash entry.value
        if entry.name == wanted {
            var code = coerce_for_store(entry.value, answer_type, scope, class_information)
            return ExpressionResult(code, answer_type)
        }
        index = index + 1
    }
    var missing = default_value_for_type(answer_type)
    return ExpressionResult(missing, answer_type)
}

func constant_local(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if declaration.type_reference or declaring_reflected_value {
        return false
    }
    crash declaration.value
    if not worth_reflecting(declaration.value, scope) {
        return false
    }
    var found = reflected(declaration.value, scope, class_information)
    if not found {
        return false
    }
    var constant_kind = found.is_object() or found.kind == "list" or found.kind == "null" and is_index_lookup(declaration.value)
    if not constant_kind or reassigned_in(reflected_body, declaration.name) {
        return false
    }
    scanned_body = reflected_body
    if statements_need_value(reflected_body, declaration.name) {
        return false
    }
    var binding = ReflectedBinding(declaration.name, found)
    binding.origin = declaration.value
    reflected_bindings.append(binding)
    return true
}

func is_index_lookup(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_index(expression) {
        return true
    }
    return false
}

func reflected_identifier(
    identifier: Syntax.Expressions.IdentifierExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var origin = binding_origin(identifier.name)
    if origin {
        return held_reflected_value(identifier.name, origin, scope, class_information)
    }
    var folded = folded_reflection(identifier, scope, class_information)
    if folded {
        return folded
    }
    report(
        "'{identifier.name}' is a reflection object known while compiling, so this function is compiled once for it, and it has no run-time value to pass on here: read what you need from it, like '{identifier.name}.name' or '{identifier.name}.class'",
    )
    return void_result()
}

func bound_attribute_read(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.Expression? {
    assert member.name == "value"
    crash member.object
    assert worth_reflecting(member.object, scope)
    assert rooted_in_parameter(member.object)
    var attribute = reflected(member.object, scope, class_information)
    assert attribute
    assert attribute.kind == "attribute"
    if not attribute.bound {
        var shown = Syntax.SourcePrinter().source_expression(member.object)
        report(
            "'{shown}.value' reads an attribute of an instance, and '{shown}' describes a declaration: walk the instance's own attributes, 'monster.attributes', or read 'monster.attributes[{shown}]'",
        )
        return null
    }
    var walked_member = Syntax.Expressions.MemberExpression(attribute.bound, attribute.name)
    walked_member.walked = true
    var read: Syntax.Expressions.Expression = walked_member
    return read
}

func reflected_field_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.Expression? {
    crash index_expression.object
    crash index_expression.index
    var listed = shape.as_member(index_expression.object)
    if not listed {
        return own_field_read(index_expression, scope, class_information)
    }
    assert listed.name == "attributes"
    assert worth_reflecting(index_expression.index, scope)
    var attribute = reflected(index_expression.index, scope, class_information)
    assert attribute
    assert attribute.kind == "attribute"
    crash listed.object
    var walked_member = Syntax.Expressions.MemberExpression(listed.object, attribute.name)
    walked_member.walked = true
    var read: Syntax.Expressions.Expression = walked_member
    return read
}

func own_field_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.Expression? {
    crash index_expression.object
    crash index_expression.index
    var listed = shape.as_identifier(index_expression.object)
    assert listed
    assert listed.name == "attributes" and not scope.lookup_type("attributes")
    assert worth_reflecting(index_expression.index, scope)
    var attribute = reflected(index_expression.index, scope, class_information)
    assert attribute
    assert attribute.kind == "attribute"
    crash attribute.owner
    if attribute.owner.c_name != class_information.c_name {
        report(
            "'attributes[...]' is an attribute of this '{class_information.simple_name}', and the attribute given is one of '{attribute.owner.simple_name}': read it on a '{attribute.owner.simple_name}', 'value.attributes[...]'",
        )
        return null
    }
    var read: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(attribute.name)
    return read
}

func named_reflection_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.Expression? {
    crash index_expression.object
    crash index_expression.index
    var text_name = shape.as_string_literal(index_expression.index)
    var enum_name = shape.as_enum_literal(index_expression.index)
    assert text_name or enum_name
    var saved_counter = temporary_counter
    var probe = generate_expression(index_expression.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var listed = type_shape.as_list(probe_type)
    assert listed
    var element = listed.element
    assert is_reflection_type(element)
    var callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(
        index_expression.object,
        "find_by_name",
    )
    var name_argument: Syntax.Expressions.Expression = index_expression.index
    if text_name {
        name_argument = Syntax.Expressions.EnumLiteralExpression(text_name.value)
    }
    var arguments = [name_argument]
    var found: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, arguments)
    return found
}

func report_run_time_reflection(function: Analysis.FunctionInfo) {
    report(
        "'{function.name}' answers a type read from a reflection object, so it is compiled once for each object the compiler can identify, and this call hands it one known only at run time: pass a class, attribute, function or argument named in the code, or walked from one",
    )
}

func reflection_parameter_named(declaration: Syntax.Statements.FunctionDeclaration, name: String): Boolean {
    var reflection_names = [
        "Spite.Class"
        "Spite.Namespace"
        "Spite.Function"
        "Spite.Argument"
        "Spite.Attribute"
        "Spite.AttributeDeclaration"
    ]
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var written = written_parameter_type(parameter)
        if written and parameter.name == name and reflection_names.contains(written) {
            return true
        }
        index = index + 1
    }
    return false
}

func written_parameter_type(parameter: Syntax.Statements.Parameter): String? {
    assert parameter.type_reference
    var named = shape.as_named_type(parameter.type_reference)
    assert named
    assert named.arguments.is_empty()
    return named.path.join(".")
}

func return_waits_for_constants(declaration: Syntax.Statements.FunctionDeclaration): Boolean {
    if not declaration.return_type {
        return false
    }
    var named = shape.as_named_type(declaration.return_type)
    if not named {
        return false
    }
    var root = named.path.first()
    if not root {
        return false
    }
    return reflection_parameter_named(declaration, root)
}

func reflected_assignment_target(
    target: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.Expression? {
    var indexed = shape.as_index(target)
    if indexed {
        return reflected_field_read(indexed, scope, class_information)
    }
    var member = shape.as_member(target)
    assert member
    return bound_attribute_read(member, scope, class_information)
}

func names_namespace(expression: Syntax.Expressions.Expression, scope: Scope): Boolean {
    var segments = List<String>()
    if not collect_static_segments(expression, segments) {
        return false
    }
    crash segments[0]
    var root_code = segments[0].code_at(0)
    if root_code < 65 or root_code > 90 or scope.lookup_type(segments[0]) {
        return false
    }
    var dotted = segments.join(".")
    crash current_class
    if find_class(dotted, current_class.qualified_dotted) {
        return false
    }
    var namespace_dotted = nearest_namespace(dotted, current_class.namespace_dotted)
    return not namespace_dotted.is_empty()
}

func statements_need_value(statements: List<Syntax.Statements.Statement>, name: String): Boolean {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if statement_needs_value(statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_needs_value(statement: Syntax.Statements.Statement, name: String): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: return declaration_needs_value(statement, name)
        Syntax.Statements.AssignmentStatement: {
            if optional_needs_value(statement.target, name) {
                return true
            }
            return optional_needs_value(statement.value, name)
        }
        Syntax.Statements.ExpressionStatement: return optional_needs_value(statement.value, name)
        Syntax.Statements.ReturnStatement: return optional_needs_value(statement.value, name)
        Syntax.Statements.AssertStatement: return condition_needs_value(statement.value, name)
        Syntax.Statements.IfStatement: {
            if condition_needs_value(statement.condition, name) {
                return true
            }
            return statements_need_value(statement.then_branch, name) or statements_need_value(statement.else_branch, name)
        }
        Syntax.Statements.WhileStatement: {
            if optional_needs_value(statement.condition, name) {
                return true
            }
            return statements_need_value(statement.body, name)
        }
        Syntax.Statements.SwitchStatement: return switch_needs_value(statement, name)
        _: return false
    }
}

func switch_needs_value(statement: Syntax.Statements.SwitchStatement, name: String): Boolean {
    if optional_needs_value(statement.subject, name) {
        return true
    }
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        if statements_need_value(switch_case.body, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func condition_needs_value(condition: Syntax.Expressions.Expression?, name: String): Boolean {
    if not condition {
        return false
    }
    if is_identifier_named(condition, name) {
        return false
    }
    return expression_needs_value(condition, name)
}

func optional_needs_value(expression: Syntax.Expressions.Expression?, name: String): Boolean {
    if not expression {
        return false
    }
    return expression_needs_value(expression, name)
}

func expressions_need_value(expressions: List<Syntax.Expressions.Expression>, name: String): Boolean {
    var index = 0
    while index < expressions.count() {
        var expression = expressions[index]
        if expression_needs_value(expression, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func expression_needs_value(expression: Syntax.Expressions.Expression, name: String): Boolean {
    switch expression {
        Syntax.Expressions.IdentifierExpression: return expression.name == name
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            if expression.name == "value" and not scanning_parameter and mentions_in(expression.object, name) {
                return true
            }
            if is_identifier_named(expression.object, name) {
                var typed_value = scanning_parameter and expression.name == "value"
                return not reflection_word(expression.name) and not typed_value
            }
            return expression_needs_value(expression.object, name)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            if is_identifier_named(expression.index, name) and indexes_attributes(expression.object) {
                return attributes_receiver_needs_value(expression.object, name)
            }
            if expression_needs_value(expression.index, name) {
                return true
            }
            if is_identifier_named(expression.object, name) {
                return false
            }
            return expression_needs_value(expression.object, name)
        }
        Syntax.Expressions.CallExpression: return call_needs_value(expression, name)
        Syntax.Expressions.GenericCallExpression: return expressions_need_value(expression.arguments, name)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            return expression_needs_value(expression.left, name) or expression_needs_value(expression.right, name)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return expression_needs_value(expression.operand, name)
        }
        Syntax.Expressions.StringLiteralExpression: return expression.value.contains("\{") and expression.value.contains(name)
        Syntax.Expressions.ListLiteralExpression: return list_literal_needs_value(expression, name)
        _: return false
    }
}

func indexes_attributes(object: Syntax.Expressions.Expression): Boolean {
    if is_identifier_named(object, "attributes") {
        return true
    }
    var member = shape.as_member(object)
    if member {
        return member.name == "attributes"
    }
    return false
}

func attributes_receiver_needs_value(object: Syntax.Expressions.Expression, name: String): Boolean {
    var member = shape.as_member(object)
    if not member {
        return false
    }
    crash member.object
    return expression_needs_value(member.object, name)
}

func list_literal_needs_value(literal: Syntax.Expressions.ListLiteralExpression, name: String): Boolean {
    var index = 0
    while index < literal.elements.count() {
        var element = literal.elements[index]
        if optional_needs_value(element.value, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func call_needs_value(call: Syntax.Expressions.CallExpression, name: String): Boolean {
    crash call.callee
    if arguments_need_value(call, name) {
        return true
    }
    var member = shape.as_member(call.callee)
    if not member {
        if is_identifier_named(call.callee, name) {
            return false
        }
        return expression_needs_value(call.callee, name)
    }
    crash member.object
    if not is_identifier_named(member.object, name) {
        return expression_needs_value(member.object, name)
    }
    var folding = ["each", "map", "count", "is_empty", "first", "last", "filter"]
    if folding.contains(member.name) or reflection_word(member.name) {
        return false
    }
    var prefix = member_template_prefix(member.name)
    return prefix.is_empty()
}

func declaration_needs_value(declaration: Syntax.Statements.VariableDeclaration, name: String): Boolean {
    crash declaration.value
    if expression_needs_value(declaration.value, name) {
        return true
    }
    var mentioned = List<String>()
    collect_mentioned_names(declaration.value, mentioned)
    if not mentioned.contains(name) or declaration.name == name or not answers_reflection(declaration.value) {
        return false
    }
    return statements_need_value(scanned_body, declaration.name)
}

func names_symbol_parameter(named: Syntax.Types.NamedType): Boolean {
    var written = named.path.join(".")
    if written == "Symbol" {
        return true
    }
    return written == "Spite.AttributeDeclaration" and not named.arguments.is_empty()
}

func materialised_list(found: Reflected, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult? {
    var first = found.elements.first()
    assert first
    if first.kind == "namespace" {
        return namespace_list_result(found)
    }
    assert first.kind == "enum"
    crash first.described_type
    var elements = List<Syntax.Expressions.ListElement>()
    var index = 0
    while index < found.elements.count() {
        var value = found.elements[index]
        var enum_value: Syntax.Expressions.Expression = Syntax.Expressions.EnumLiteralExpression(value.name)
        var element = Syntax.Expressions.ListElement(enum_value)
        elements.append(element)
        index = index + 1
    }
    var literal = Syntax.Expressions.ListLiteralExpression(elements)
    return generate_list_literal(literal, first.described_type, scope, class_information)
}

func namespace_list_result(found: Reflected): ExpressionResult {
    var namespace_class = find_class_by_c_name("Spite_Namespace")
    crash namespace_class
    var namespace_type = class_type_of(namespace_class)
    var list_name = ensure_list(namespace_type)
    var temporary = next_temporary()
    var lines = List<String>()
    lines.append("{list_name}* {temporary} = {list_name}___make();")
    var index = 0
    while index < found.elements.count() {
        var element = found.elements[index]
        lines.append("{list_name}_append({temporary}, {ensure_namespace_object(element.name)}());")
        index = index + 1
    }
    lines.append("{temporary};")
    var list_type = list_type_of(namespace_type)
    var listed = ExpressionResult("(\{ {lines.join(" ")} })", list_type)
    listed.owning_override = true
    return listed
}

func answers_plain_value(expression: Syntax.Expressions.Expression): Boolean {
    var plain_words = [
        "name"
        "name_with_namespaces"
        "index"
        "returned_literal"
        "camel_case_name"
        "pascal_case_name"
        "count"
        "is_empty"
    ]
    var member = shape.as_member(expression)
    if member {
        return plain_words.contains(member.name) or member.name.starts_with("is_")
    }
    var call = shape.as_call(expression)
    if not call {
        return false
    }
    crash call.callee
    var called = shape.as_member(call.callee)
    if not called {
        return false
    }
    var counting = called.name.starts_with("count_") or called.name.starts_with("any_") or called.name.starts_with("all_")
    return plain_words.contains(called.name) or counting
}

func reflected_construction(
    callee: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert rooted_in_binding(callee)
    var made_class = reflected(callee, scope, class_information)
    assert made_class
    assert made_class.kind == "class"
    crash made_class.described_type
    var written = Syntax.SourcePrinter().source_expression(callee)
    return generate_default_of(made_class.described_type, written, arguments, scope, class_information)
}

func chained_element_template(
    list_class: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    template: Analysis.TemplateInfo,
    name: String,
): Analysis.FunctionInfo? {
    var existing = list_class.find_function(name)
    if existing {
        return existing
    }
    var hole = template.member_name_for(name)
    var words = hole.split("_")
    var split = 1
    while split < words.count() {
        var member_words = List<String>()
        var method_words = List<String>()
        var word_index = 0
        while word_index < words.count() {
            var word = words[word_index]
            if word_index < split {
                member_words.append(word)
            } else {
                method_words.append(word)
            }
            word_index = word_index + 1
        }
        var member_name = member_words.join("_")
        var method_name = method_words.join("_")
        var member_type = element_member_type(element, member_name)
        if member_type {
            var method = chained_method(member_type, method_name)
            if method {
                var owner_c_name = element_owner_c_name(element)
                return instantiate_chained(list_class, owner_c_name, template, member_name, method, name)
            }
        }
        split = split + 1
    }
    return null
}

func chained_method(member_type: Analysis.SpiteType, method_name: String): Analysis.FunctionInfo? {
    var owner = class_of_type(member_type)
    if type_shape.as_string(member_type) or type_shape.is_symbol(member_type) {
        owner = find_class_by_c_name("SpiteString")
    }
    assert owner
    var method = find_or_instantiate_function(owner, method_name)
    assert method
    assert not method.is_constructor
    return method
}

func instantiate_chained(
    list_class: Analysis.ClassInfo,
    owner_c_name: String,
    template: Analysis.TemplateInfo,
    member_name: String,
    method: Analysis.FunctionInfo,
    name: String,
): Analysis.FunctionInfo {
    chained_parameters = List<Analysis.ParamInfo>()
    var index = 0
    while index < method.parameters.count() {
        var parameter = method.parameters[index]
        var parameter_type = parameter.type
        var chained = Analysis.ParamInfo("chained_{parameter.name}", parameter_type)
        chained_parameters.append(chained)
        index = index + 1
    }
    chained_method_name = method.name
    var returned = method.return_type
    return instantiate_template(list_class, template, member_name, returned, owner_c_name, name, null)
}

func note_source_path(information: Analysis.ClassInfo, path: String) {
    if information.source_paths.is_empty() and not information.source_path.is_empty() {
        information.source_paths.append(information.source_path)
    }
    if not path.is_empty() and not information.source_paths.contains(path) {
        information.source_paths.append(path)
    }
}

func emit_source_paths(lines: List<String>, cache: String, paths: List<String>, folders: Boolean) {
    var text_type = string_type()
    var list_name = ensure_list(text_type)
    if not paths.is_empty() {
        lines.append("if ({cache}->_source_paths_ == 0) {cache}->_source_paths_ = {list_name}___make();")
    }
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var absolute = absolute_source_path(path)
        if folders {
            absolute = path
        }
        lines.append("{list_name}_append({cache}->_source_paths_, {render_string_literal(absolute)});")
        index = index + 1
    }
}

func absolute_source_path(path: String): String {
    var forward = path.replace("\\", "/")
    var base = working_folder.replace("\\", "/")
    if forward.starts_with("library/") or forward.starts_with("launcher/") {
        base = language_folder.replace("\\", "/")
    }
    var joined = "{base}/{forward}"
    if forward.starts_with("/") or forward.slice(1, 2) == ":" {
        joined = forward
    }
    var folder = normalized_folder(joined)
    var segments = forward.split("/")
    var file_name = segments.last()
    crash file_name
    return "{folder}/{file_name}"
}

func namespace_source_paths(dotted: String): List<String> {
    var folders = List<String>()
    var index = 0
    while index < classes.count() {
        var candidate = classes[index]
        if candidate.namespace_dotted == dotted {
            add_class_folders(candidate, folders)
        }
        index = index + 1
    }
    return folders
}

func add_class_folders(candidate: Analysis.ClassInfo, folders: List<String>) {
    var index = 0
    while index < candidate.source_paths.count() {
        var path = candidate.source_paths[index]
        var absolute = absolute_source_path(path)
        var folder = normalized_folder(absolute)
        if not folders.contains(folder) {
            folders.append(folder)
        }
        index = index + 1
    }
}

func mentions_in(expression: Syntax.Expressions.Expression, name: String): Boolean {
    var mentioned = List<String>()
    collect_mentioned_names(expression, mentioned)
    return mentioned.contains(name)
}

func rooted_in_parameter(expression: Syntax.Expressions.Expression): Boolean {
    var root = root_of(expression)
    var root_name = shape.as_identifier(root)
    if not root_name {
        return false
    }
    var bound = reflected_binding(root_name.name)
    if not bound {
        return false
    }
    var origin = binding_origin(root_name.name)
    if origin {
        return false
    }
    return true
}

func parameter_needs_value(function: Analysis.FunctionInfo, name: String): Boolean {
    var saved_body = scanned_body
    scanned_body = function.body
    scanning_parameter = true
    var needs = statements_need_value(function.body, name)
    scanning_parameter = false
    scanned_body = saved_body
    return needs
}

func keeps_constants(function: Analysis.FunctionInfo, constants: List<Reflected>): Boolean {
    var index = 0
    while index < constants.count() and index < function.parameters.count() {
        var constant = constants[index]
        var parameter = function.parameters[index]
        if not constant.kind.is_empty() and parameter_needs_value(function, parameter.name) {
            return false
        }
        index = index + 1
    }
    return true
}

func bound_value_present(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    if member.name != "value" or not rooted_in_parameter(member.object) {
        return false
    }
    var attribute = reflected(member.object, scope, class_information)
    if not attribute {
        return false
    }
    if attribute.kind != "attribute" or not attribute.bound {
        return false
    }
    crash attribute.described_type
    if type_shape.as_nullable(attribute.described_type) {
        return false
    }
    return true
}

func arguments_need_value(call: Syntax.Expressions.CallExpression, name: String): Boolean {
    crash call.callee
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var passed_on = is_identifier_named(argument, name) and passes_reflection(call.callee, index)
        if not passed_on and expression_needs_value(argument, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func passes_reflection(callee: Syntax.Expressions.Expression, position: Integer): Boolean {
    var called = shape.as_identifier(callee)
    if not called or not current_class {
        return false
    }
    var function = current_class.find_function(called.name)
    if not function {
        return false
    }
    if position >= function.parameters.count() {
        return false
    }
    var parameter = function.parameters[position]
    var parameter_type = parameter.type
    return is_reflection_type(parameter_type)
}

func answers_reflection(expression: Syntax.Expressions.Expression): Boolean {
    var object_words = [
        "attributes"
        "functions"
        "classes"
        "namespaces"
        "every_class"
        "enums"
        "values"
        "arguments"
        "namespace"
        "parent"
        "owner"
        "function"
        "returns"
        "element_type"
        "value_type"
        "instances"
        "class"
    ]
    switch expression {
        Syntax.Expressions.IdentifierExpression: return true
        Syntax.Expressions.IndexExpression: return true
        Syntax.Expressions.MemberExpression: return object_words.contains(expression.name)
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var called = shape.as_member(expression.callee)
            if not called {
                return false
            }
            var selecting = ["first", "last", "filter"]
            return selecting.contains(called.name) or called.name.starts_with("filter_") or called.name.starts_with("find_by_")
        }
        _: return false
    }
}

func held_reflected_value(
    name: String,
    origin: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var hidden = "{name}_at_run_time"
    var held: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(hidden)
    if not scope.lookup_type(hidden) {
        var declaration = Syntax.Statements.VariableDeclaration(hidden, null, origin)
        declaration.line = current_line
        declaring_reflected_value = true
        generate_variable_declaration(declaration, scope, class_information)
        declaring_reflected_value = false
    }
    scope.mark_used(hidden)
    return generate_expression(held, scope, class_information)
}

func skips_generic(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not waits_for_constants(information, function) {
        return false
    }
    var inspectable = read_evaluate_print_loop or development or hot_reload
    if not inspectable or constant_return_names.contains(function.c_name) {
        return true
    }
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        var class_ref = type_shape.as_class_ref(parameter_type)
        if class_ref {
            var described = ["Spite_Attribute", "Spite_AttributeDeclaration", "Spite_Argument"]
            if described.contains(class_ref.c_name) {
                return true
            }
        }
        index = index + 1
    }
    return false
}
