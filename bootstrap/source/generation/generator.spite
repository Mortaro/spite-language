func check_abbreviations(name: String) {
    var short_words = abbreviated_words()
    var full_words = unabbreviated_words()
    var words = words_of(name)
    var index = 0
    while index < words.count() {
        var position = 0
        while position < short_words.count() {
            if short_words[position] == words[index] {
                crash full_words[position]
                report(
                    "'{name}' abbreviates: write '{full_words[position]}' instead of '{words[index]}'. Spite has no abbreviations outside its own keywords",
                )
            }
            position = position + 1
        }
        index = index + 1
    }
}

func report_shadowed_functions(discovered: List<Discovery.DiscoveredClass>) {
    discovered.each(report_shadows_in)
}

func report_shadows_in(entry: Discovery.DiscoveredClass) {
    var file = entry.get_file()
    current_owner = entry.qualified_dotted
    current_function = ""
    var function_names = List<String>()
    var index = 0
    while index < file.statements.count() {
        var declared_function = shape.as_function_declaration(file.statements[index])
        if declared_function {
            function_names.append(declared_function.name)
        }
        index = index + 1
    }
    var statement_index = 0
    while statement_index < file.statements.count() {
        var statement = file.statements[statement_index]
        report_shadows_in_member(statement, file.path, function_names)
        statement_index = statement_index + 1
    }
}

func report_shadows_in_member(statement: Syntax.Statements.Statement, file_path: String, function_names: List<String>) {
    current_path = file_path
    current_line = statement.line
    var attribute = shape.as_variable_declaration(statement)
    if attribute {
        if not attribute.source_path.is_empty() {
            current_path = attribute.source_path
        }
        report_shadow(attribute.name, "attribute", function_names)
        return
    }
    var function = shape.as_function_declaration(statement)
    assert function
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    current_function = function.name
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        report_shadow(function.parameters[parameter_index].name, "parameter", function_names)
        parameter_index = parameter_index + 1
    }
    report_shadowing_locals(function.body, function_names)
    current_function = ""
}

func report_shadowing_locals(statements: List<Syntax.Statements.Statement>, function_names: List<String>) {
    var index = 0
    while index < statements.count() {
        report_shadowing_statement(statements[index], function_names)
        index = index + 1
    }
}

func report_shadowing_statement(statement: Syntax.Statements.Statement, function_names: List<String>) {
    current_line = statement.line
    switch statement {
        Syntax.Statements.VariableDeclaration: report_shadow(statement.name, "variable", function_names)
        Syntax.Statements.IfStatement: {
            report_shadowing_locals(statement.then_branch, function_names)
            report_shadowing_locals(statement.else_branch, function_names)
        }
        Syntax.Statements.WhileStatement: report_shadowing_locals(statement.body, function_names)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                report_shadowing_locals(statement.cases[case_index].body, function_names)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func report_shadow(name: String, what: String, function_names: List<String>) {
    assert function_names.contains(name)
    report(
        "the {what} '{name}' has the name of a function of this class, and a function is a value passed by its name: give the {what} a name of its own",
    )
}

func check_value_name(name: String, what: String) {
    var bare = name
    if bare.starts_with("_") {
        var bare_length = bare.length()
        bare = bare.slice(1, bare_length)
    }
    if not is_lowercase_name(bare) {
        report("the {what} '{name}' must be written in snake_case: lowercase words joined by underscores")
        return
    }
    if bare.starts_with("_") or bare.ends_with("_") or bare.contains("__") {
        report(
            "the {what} '{name}' must be written in snake_case: lowercase words joined by one underscore each, with at most one '_' in front to make it private",
        )
        return
    }
    if bare.length() == 1 {
        report("the {what} '{name}' is a single letter: give it a name that says what it holds")
        return
    }
    check_abbreviations(bare)
}

func check_type_name(name: String, what: String) {
    if not is_pascal_name(name) {
        report("the {what} '{name}' must be written in PascalCase: capitalised words with no underscores")
        return
    }
    check_abbreviations(name)
}

func report_unread_name(name: String, is_parameter: Boolean) {
    if not is_parameter {
        report("'{name}' is never read: remove it")
        return
    }
    if not name.starts_with("_") {
        report("the parameter '{name}' is never read: remove it, or name it '_{name}' if the signature needs it")
    }
}

func report_unused(scope: Scope) {
    var index = 0
    while index < scope.entry_names.count() {
        crash index < scope.entry_checked.count()
        crash index < scope.entry_used.count()
        if scope.entry_checked[index] {
            var name = scope.entry_names[index]
            var saved_line = current_line
            crash scope.entry_lines[index]
            current_line = scope.entry_lines[index]
            if name.starts_with("_") and scope.entry_used[index] {
                report(
                    "'{name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
                )
            }
            crash index < scope.entry_parameters.count()
            var is_parameter = scope.entry_parameters[index]
            if not scope.entry_used[index] {
                report_unread_name(name, is_parameter)
            }
            current_line = saved_line
        }
        index = index + 1
    }
}

func mark_attribute_read(information: Analysis.ClassInfo, name: String) {
    read_attributes["{information.qualified_dotted}.{name}"] = true
}

func mark_folded_words_read(statements: List<Syntax.Statements.Statement>) {
    var text = Syntax.SourcePrinter().source_statement_list(statements, 0)
    mark_words_read(text, false, List<String>())
}

func mark_words_read(text: String, members_only: Boolean, metadata_receivers: List<String>) {
    var text_length = text.length()
    var start = 0
    var position = 0
    var previous_word = ""
    while position <= text_length {
        if position == text_length or not is_attribute_name_code(text, position) {
            if position > start {
                var word = text.slice(start, position)
                if not members_only or is_member_read_at(text, start, position, previous_word, metadata_receivers) {
                    folded_words[word] = true
                }
                previous_word = word
            }
            start = position + 1
        }
        position = position + 1
    }
}

func is_member_read_at(
    text: String,
    start: Integer,
    end: Integer,
    receiver: String,
    metadata_receivers: List<String>,
): Boolean {
    assert start > 0 and text.code_at(start - 1) == 46
    assert end == text.length() or text.code_at(end) != 40
    return not metadata_receivers.contains(receiver)
}

func mark_uncompiled_bodies_read(information: Analysis.ClassInfo, statements: List<Syntax.Statements.Statement>) {
    var index = 0
    while index < statements.count() {
        var function_declaration = shape.as_function_declaration(statements[index])
        if function_declaration {
            var metadata_receivers = symbol_parameter_names(function_declaration)
            var is_template = not metadata_receivers.is_empty()
            if is_template or information.is_generic_template {
                var names = List<String>()
                collect_block_names(function_declaration.body, names)
                mark_names_read(information, names)
            }
            if is_template or information.is_generic_template and not is_emitted_in_an_instance(information, function_declaration.name) {
                var text = Syntax.SourcePrinter().source_statement_list(function_declaration.body, 0)
                metadata_receivers.append("class")
                mark_words_read(text, true, metadata_receivers)
            }
        }
        var variable_declaration = shape.as_variable_declaration(statements[index])
        if variable_declaration {
            if information.is_generic_template {
                var default_names = List<String>()
                collect_optional_names(variable_declaration.value, default_names)
                mark_names_read(information, default_names)
            }
        }
        index = index + 1
    }
}

func symbol_parameter_names(declaration: Syntax.Statements.FunctionDeclaration): List<String> {
    var names = List<String>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.type_reference {
            var named = shape.as_named_type(parameter.type_reference)
            if named {
                if named.path.first() == "Symbol" {
                    names.append(parameter.name)
                }
            }
        }
        index = index + 1
    }
    return names
}

func is_emitted_in_an_instance(template: Analysis.ClassInfo, name: String): Boolean {
    var index = 0
    while index < classes.count() {
        var instance = classes[index]
        if instance.is_instantiated and instance.qualified_dotted == template.qualified_dotted {
            var function = instance.find_function(name)
            if function {
                if function.is_emitted {
                    return true
                }
            }
        }
        index = index + 1
    }
    return false
}

func is_attribute_name_code(text: String, position: Integer): Boolean {
    var code = text.code_at(position)
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}

func mark_bound_attribute_read(class_information: Analysis.ClassInfo) {
    var owner = find_class_by_c_name(bound_member_owner_c_name)
    if owner {
        mark_attribute_read(owner, bound_field_name)
        return
    }
    mark_attribute_read(class_information, bound_field_name)
}

func mark_members_read(members: List<Analysis.ClassInfo>, name: String) {
    var index = 0
    while index < members.count() {
        mark_attribute_read(members[index], name)
        index = index + 1
    }
}

func mark_every_attribute_read(information: Analysis.ClassInfo) {
    var index = 0
    while index < information.fields.count() {
        mark_attribute_read(information, information.fields[index].name)
        index = index + 1
    }
}

func mark_names_read(information: Analysis.ClassInfo, names: List<String>) {
    var index = 0
    while index < names.count() {
        mark_attribute_read(information, names[index])
        index = index + 1
    }
}

func report_unused_attributes() {
    var checked = List<Analysis.ClassInfo>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if not information.is_instantiated and not information.source_path.is_empty() {
            checked.append(information)
            var statements = class_statements(information)
            mark_uncompiled_bodies_read(information, statements)
        }
        index = index + 1
    }
    index = 0
    while index < checked.count() {
        var information = checked[index]
        if attributes_are_checked(information) {
            var statements = class_statements(information)
            report_unread_attributes(information, statements)
        }
        index = index + 1
    }
}

func is_in_loaded_folder(path: String): Boolean {
    var index = 0
    while index < loaded_folders.count() {
        if path.starts_with(loaded_folders[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func class_statements(information: Analysis.ClassInfo): List<Syntax.Statements.Statement> {
    crash discovered_classes[information.entry_index]
    return discovered_classes[information.entry_index].get_file().statements
}

func attributes_are_checked(information: Analysis.ClassInfo): Boolean {
    assert not information.is_value_class
    assert information.qualified_dotted != "Build" and information.qualified_dotted != "Environment"
    return true
}

func report_unread_attributes(information: Analysis.ClassInfo, statements: List<Syntax.Statements.Statement>) {
    var index = 0
    while index < statements.count() {
        var declaration = shape.as_variable_declaration(statements[index])
        if declaration {
            var name = declaration.name
            var declared_path = information.source_path
            if not declaration.source_path.is_empty() {
                declared_path = declaration.source_path
            }
            var read = read_attributes.has("{information.qualified_dotted}.{name}") or folded_words.has(name)
            var seen_whole = name.starts_with("_") or not is_in_loaded_folder(declared_path) or binds_singleton(declaration, information)
            if not read and seen_whole {
                current_path = declared_path
                current_line = declaration.line
                current_owner = information.qualified_dotted
                current_function = ""
                report("the attribute '{name}' is never read: remove it")
            }
        }
        index = index + 1
    }
}

func binds_singleton(declaration: Syntax.Statements.VariableDeclaration, information: Analysis.ClassInfo): Boolean {
    crash declaration.value
    var bound = constructed_singleton(declaration.value, information)
    assert bound
    return true
}

func generate_block_in_scope(
    statements: List<Syntax.Statements.Statement>,
    block_scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var ended_in_return = generate_statement_list(statements, block_scope, class_information, function_information)
    if not ended_in_return {
        emit_scope_drops(block_scope, false)
    }
    close_rebindings(block_scope)
    report_unused(block_scope)
}

func generate_block(
    statements: List<Syntax.Statements.Statement>,
    parent_scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    generate_block_in_scope(statements, Scope(parent_scope), class_information, function_information)
}

func terminal_if_of(body: List<Syntax.Statements.Statement>): Syntax.Statements.IfStatement? {
    assert not body.is_empty()
    var last_statement = body[body.count() - 1]
    var last_if = shape.as_if_statement(last_statement)
    if last_if {
        if not last_if.has_else_branch {
            return last_if
        }
    }
    return null
}

func report_terminal_if(if_statement: Syntax.Statements.IfStatement, name: String) {
    assert not if_statement.has_else_branch
    assert terminal_if
    if terminal_if == if_statement {
        report(
            "this 'if' is the last thing the function does and has no 'else', so it only checks that '{name}' is there: write 'assert {name}' and let the rest of the function run unindented",
        )
    }
}

func returned_default(if_statement: Syntax.Statements.IfStatement, return_type: Analysis.SpiteType): String? {
    assert not if_statement.has_else_branch and if_statement.then_branch.count() == 1
    var only = shape.as_return_statement(if_statement.then_branch[0])
    assert only
    var returned = only.value
    if not returned {
        return ""
    }
    if type_shape.as_nullable(return_type) {
        if shape.is_null_literal(returned) {
            return "null"
        }
        return null
    }
    if shape.is_false_literal(returned) {
        return "false"
    }
    var text = shape.as_string_literal(returned)
    if text {
        if text.value.is_empty() {
            return "\"\""
        }
        return null
    }
    var integer = shape.as_integer_literal(returned)
    if integer {
        if integer.value == 0 {
            return "0"
        }
        return null
    }
    var fraction = shape.as_float_literal(returned)
    assert fraction
    assert fraction.value == 0.0
    return Syntax.SourcePrinter().source_expression(returned)
}

func flipped_comparison(operator: Syntax.Expressions.BinaryOperator): Syntax.Expressions.BinaryOperator {
    if operator == 'equal' {
        return 'not_equal'
    }
    if operator == 'not_equal' {
        return 'equal'
    }
    if operator == 'less' {
        return 'greater_equal'
    }
    if operator == 'greater_equal' {
        return 'less'
    }
    if operator == 'greater' {
        return 'less_equal'
    }
    if operator == 'less_equal' {
        return 'greater'
    }
    if operator == 'logical_and' {
        return 'logical_or'
    }
    if operator == 'logical_or' {
        return 'logical_and'
    }
    return operator
}

func negated_condition(condition: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var unary = shape.as_unary(condition)
    if unary {
        if unary.operator == 'logical_not' {
            crash unary.operand
            return unary.operand
        }
    }
    var binary = shape.as_binary(condition)
    if binary {
        crash binary.left
        crash binary.right
        var flipped = flipped_comparison(binary.operator)
        if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
            var left = negated_condition(binary.left)
            var right = negated_condition(binary.right)
            return Syntax.Expressions.BinaryExpression(flipped, left, right)
        }
        if flipped != binary.operator {
            return Syntax.Expressions.BinaryExpression(flipped, binary.left, binary.right)
        }
    }
    return Syntax.Expressions.UnaryExpression('logical_not', condition)
}

func report_default_guard(if_statement: Syntax.Statements.IfStatement, function_information: Analysis.FunctionInfo) {
    var return_type = function_information.get_return_type()
    var returned = returned_default(if_statement, return_type)
    assert returned
    crash if_statement.condition
    var negated = negated_condition(if_statement.condition)
    var proven = Syntax.SourcePrinter().source_expression(negated)
    if function_information.is_constructor {
        report(
            "this 'if' only leaves the constructor, and a constructor is setup, not logic: take already resolved values, or write 'crash {proven}' when this is a bug",
        )
        return
    }
    var what = "returns"
    if not returned.is_empty() {
        what = "returns the default '{returned}'"
    }
    report("this 'if' only {what}: write 'assert {proven}' and let the rest run unindented")
}

func generate_if_statement(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    assert if_statement.condition
    report_repeated_branch_call(if_statement)
    report_nested_if_else(if_statement)
    var constant = constant_condition(if_statement.condition, scope, class_information)
    if constant == true or constant == false {
        builder.add_user("\{")
        var taken = if_statement.then_branch
        if constant == true {
            mark_folded_names_used(if_statement.else_branch, scope)
        } else {
            mark_folded_names_used(if_statement.then_branch, scope)
            taken = if_statement.else_branch
        }
        var taken_scope = Scope(scope)
        var taken_returns = generate_statement_list(taken, taken_scope, class_information, function_information)
        if not taken_returns {
            emit_scope_drops(taken_scope, false)
        }
        close_rebindings(taken_scope)
        report_unused(taken_scope)
        builder.add_user("}")
        return taken_returns
    }
    generate_unfolded_if(if_statement, scope, class_information, function_information)
    return false
}

func generate_unfolded_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    crash if_statement.condition
    report_default_guard(if_statement, function_information)
    var guard = try_nullable_guard(if_statement.condition, scope, class_information)
    if guard {
        report_terminal_if(if_statement, guard.name)
        builder.add_user("if ({guard.guard_code}) \{")
        var then_scope = Scope(scope)
        narrow_by_guard(then_scope, guard)
        generate_block_in_scope(if_statement.then_branch, then_scope, class_information, function_information)
        builder.add_user("}")
        if if_statement.has_else_branch {
            builder.add_user("else \{")
            generate_block(if_statement.else_branch, scope, class_information, function_information)
            builder.add_user("}")
        }
        return
    }
    assert not generate_and_narrowing_if(if_statement, scope, class_information, function_information)
    if not generate_class_narrowing_if(if_statement, scope, class_information, function_information) {
        generate_plain_if(if_statement, scope, class_information, function_information)
    }
}

func generate_plain_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    crash if_statement.condition
    var condition_result = generate_joined(if_statement.condition, scope, class_information)
    check_condition(condition_result, "if")
    builder.add_user("if ({owned_truth(condition_result, if_statement.condition)}) \{")
    var proven_scope = Scope(scope)
    narrow_proven_indices(if_statement.condition, proven_scope)
    generate_block_in_scope(if_statement.then_branch, proven_scope, class_information, function_information)
    builder.add_user("}")
    if if_statement.has_else_branch {
        builder.add_user("else \{")
        generate_block(if_statement.else_branch, scope, class_information, function_information)
        builder.add_user("}")
    }
}

func generate_class_narrowing_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    crash if_statement.condition
    var binary = shape.as_binary(if_statement.condition)
    assert binary
    assert binary.operator == 'equal'
    crash binary.left
    crash binary.right
    var subject_identifier = shape.as_identifier(binary.left)
    assert subject_identifier
    var tested_class = tested_class_of(binary.right, class_information)
    assert tested_class
    var subject = generate_expression(binary.left, scope, class_information)
    var subject_type = subject.get_type()
    var is_nullable = false
    var nullable = type_shape.as_nullable(subject_type)
    if nullable {
        subject_type = nullable.get_inner()
        is_nullable = true
    }
    var subject_union = type_shape.as_union(subject_type)
    assert subject_union
    var union_information = find_union_by_c_name(subject_union.c_name)
    if union_information {
        check_tested_member(union_information, tested_class)
    }
    var subject_temporary = next_temporary()
    builder.add_user("\{")
    var subject_spite_type = subject.get_type()
    builder.add_user("{c_type_name(subject_spite_type)} {subject_temporary} = {subject.code};")
    var test = class_id_test(subject_temporary, tested_class)
    if is_nullable {
        test = "({subject_temporary} != 0 && {test})"
    }
    builder.add_user("if ({test}) \{")
    var case_scope = Scope(scope)
    var class_type = instance_type_of(tested_class)
    case_scope.declare(subject_identifier.name, class_type)
    var narrowed = narrowed_code(subject_temporary, tested_class, class_type)
    case_scope.set_override(subject_identifier.name, narrowed)
    generate_block_in_scope(if_statement.then_branch, case_scope, class_information, function_information)
    builder.add_user("}")
    if if_statement.has_else_branch {
        builder.add_user("else \{")
        generate_block(if_statement.else_branch, scope, class_information, function_information)
        builder.add_user("}")
    }
    builder.add_user("}")
    return true
}

func narrowed_code(code: String, tested_class: Analysis.ClassInfo, class_type: Analysis.SpiteType): String {
    if boxed_value_types.has(tested_class.c_name) {
        return "(((SpiteBox_{tested_class.c_name}*){code})->value)"
    }
    return "(({c_type_name(class_type)}){code})"
}

func generate_nullable_switch(
    switch_statement: Syntax.Statements.SwitchStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
    guard: NullableGuard,
) {
    var covered_null = false
    var covered_value = false
    var case_index = 0
    while case_index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[case_index]
        if switch_case.type_reference {
            var case_named = shape.as_named_type(switch_case.type_reference)
            var is_null_case = false
            if case_named {
                is_null_case = case_named.path.count() == 1 and case_named.path[0] == "Null"
            }
            if is_null_case {
                covered_null = true
                builder.add_user("if (!({guard.guard_code})) \{")
                generate_block(switch_case.body, scope, class_information, function_information)
                builder.add_user("}")
            } else {
                var case_type = resolve_type(switch_case.type_reference, class_information.qualified_dotted)
                if case_type {
                    var guard_inner = guard.get_inner()
                    if not types_equal(case_type, guard_inner) {
                        report(
                            "this value is {type_with_article(guard_inner)} or null, so its switch cases are '{type_display_name(guard_inner)}' and 'Null'",
                        )
                    }
                }
                covered_value = true
                builder.add_user("if ({guard.guard_code}) \{")
                var case_scope = Scope(scope)
                narrow_by_guard(case_scope, guard)
                generate_block_in_scope(switch_case.body, case_scope, class_information, function_information)
                builder.add_user("}")
            }
        }
        case_index = case_index + 1
    }
    if not covered_null {
        report("this switch does not cover 'Null'")
    }
    if not covered_value {
        var guard_inner = guard.get_inner()
        report("this switch does not cover '{type_display_name(guard_inner)}'")
    }
}

func generate_union_case(
    switch_case: Syntax.Statements.SwitchCase,
    case_index: Integer,
    information: Analysis.UnionInfo,
    subject_temporary: String,
    subject_identifier: Syntax.Expressions.IdentifierExpression?,
    covered_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert switch_case.type_reference
    var case_class = class_of_type_reference(switch_case.type_reference, information.owner_namespace)
    if not case_class {
        case_class = class_of_type_reference(switch_case.type_reference, class_information.qualified_dotted)
    }
    if not case_class {
        report("a switch case must name a class of the union")
        return
    }
    assert case_class
    if information.has_member(case_class.c_name) {
        covered_names.append(case_class.simple_name)
    } else {
        report("'{case_class.simple_name}' is not a member of union '{information.simple_name}'")
    }
    emit_narrowed_case(
        case_class,
        case_index > 0,
        switch_case.body,
        subject_temporary,
        subject_identifier,
        scope,
        class_information,
        function_information,
    )
}

func generate_rest_case(
    switch_case: Syntax.Statements.SwitchCase,
    case_index: Integer,
    information: Analysis.UnionInfo,
    subject_temporary: String,
    subject_identifier: Syntax.Expressions.IdentifierExpression?,
    covered_names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var chained = case_index > 0
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        if not covered_names.contains(member.simple_name) {
            emit_narrowed_case(
                member,
                chained,
                switch_case.body,
                subject_temporary,
                subject_identifier,
                scope,
                class_information,
                function_information,
            )
            chained = true
        }
        member_index = member_index + 1
    }
}

func emit_narrowed_case(
    case_class: Analysis.ClassInfo,
    chained: Boolean,
    body: List<Syntax.Statements.Statement>,
    subject_temporary: String,
    subject_identifier: Syntax.Expressions.IdentifierExpression?,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var keyword = "if "
    if chained {
        keyword = "else if "
    }
    builder.add_user("{keyword}{class_id_test(subject_temporary, case_class)} \{")
    var case_scope = Scope(scope)
    if subject_identifier {
        var class_type = class_type_of(case_class)
        case_scope.declare(subject_identifier.name, class_type)
        case_scope.set_override(subject_identifier.name, "(({case_class.c_name}*){subject_temporary})")
    }
    generate_block_in_scope(body, case_scope, class_information, function_information)
    builder.add_user("}")
}

func report_misplaced_rest_case(
    switch_statement: Syntax.Statements.SwitchStatement,
    case_index: Integer,
    covered_names: List<String>,
    information: Analysis.UnionInfo,
) {
    if case_index != switch_statement.cases.count() - 1 {
        report("'_:' answers for every member without a case of its own, so it is the last case")
    } else if covered_names.count() == information.members.count() {
        report("every member of '{information.simple_name}' already has a case, so '_:' answers for nothing: remove it")
    }
}

func is_rest_case(switch_case: Syntax.Statements.SwitchCase): Boolean {
    if switch_case.type_reference {
        var named = shape.as_named_type(switch_case.type_reference)
        if named {
            return named.path.count() == 1 and named.path[0] == "_"
        }
    }
    return false
}

func report_single_case(switch_statement: Syntax.Statements.SwitchStatement) {
    assert switch_statement.cases.count() == 2 and is_rest_case(switch_statement.cases[1])
    var class_case = switch_statement.cases[0]
    crash class_case.type_reference
    crash switch_statement.subject
    var printer = Syntax.SourcePrinter()
    var subject = printer.source_expression(switch_statement.subject)
    var tested = printer.source_type(class_case.type_reference)
    crash switch_statement.cases[1]
    assert only_returns(class_case.body) and only_returns(switch_statement.cases[1].body)
    var answer = returned_boolean(class_case.body)
    var rest_answer = returned_boolean(switch_statement.cases[1].body)
    if answer and rest_answer {
        if answer != rest_answer {
            var comparison = "=="
            if answer == "false" {
                comparison = "!="
            }
            report("this switch only asks what class '{subject}' is: write 'return {subject} {comparison} {tested}'")
            return
        }
    }
    report(
        "a switch with one case and '_:' is an if: write 'if {subject} == {tested} \{ ... }', returning early, and then what '_:' does",
    )
}

func only_returns(body: List<Syntax.Statements.Statement>): Boolean {
    assert body.count() == 1
    return body[0] == Syntax.Statements.ReturnStatement
}

func returned_boolean(body: List<Syntax.Statements.Statement>): String? {
    assert body.count() == 1
    var returned = shape.as_return_statement(body[0])
    if returned {
        if returned.value {
            if shape.is_true_literal(returned.value) {
                return "true"
            }
            if shape.is_false_literal(returned.value) {
                return "false"
            }
        }
    }
    return null
}

func report_repeated_cases(switch_statement: Syntax.Statements.SwitchStatement) {
    var printer = Syntax.SourcePrinter()
    var bodies = List<String>()
    var names = List<String>()
    var rest_body = ""
    var index = 0
    while index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[index]
        var printed = printer.source_statement_list(switch_case.body, 0)
        if is_rest_case(switch_case) {
            rest_body = printed
        } else {
            crash switch_case.type_reference
            bodies.append(printed)
            var source_type = printer.source_type(switch_case.type_reference)
            names.append(source_type)
        }
        index = index + 1
    }
    index = 0
    while index < bodies.count() {
        if not rest_body.is_empty() and bodies[index] == rest_body {
            crash names[index]
            report("the case '{names[index]}' does the same as '_:': remove it and let '_:' answer for it")
            return
        }
        var other = index + 1
        while other < bodies.count() {
            if rest_body.is_empty() and bodies[index] == bodies[other] {
                crash names[index]
                crash names[other]
                report(
                    "the cases '{names[index]}' and '{names[other]}' do the same thing: write it once, as the last case '_:'",
                )
                return
            }
            other = other + 1
        }
        index = index + 1
    }
}

func report_repeated_branch_call(if_statement: Syntax.Statements.IfStatement) {
    assert not if_statement.follows_else
    var narrowed = List<String>()
    var ends_in_else = collect_chain_narrowed_names(if_statement, narrowed)
    assert ends_in_else
    var first_calls = List<String>()
    collect_branch_calls(if_statement.then_branch, narrowed, first_calls)
    var shared = keep_shared_calls(if_statement, narrowed, first_calls)
    assert shared[0]
    var branch_words = "both branches"
    if chained_if(if_statement) {
        branch_words = "every branch"
    }
    report("'{shared[0]}' is computed in {branch_words}: compute it once before the 'if'")
}

func report_nested_if_else(if_statement: Syntax.Statements.IfStatement) {
    assert if_statement.has_else_branch or if_statement.follows_else
    report_if_else_in_branch(if_statement.then_branch)
    var chained = chained_if(if_statement)
    if not chained {
        report_if_else_in_branch(if_statement.else_branch)
    }
}

func report_if_else_in_branch(branch: List<Syntax.Statements.Statement>) {
    var index = 0
    while index < branch.count() {
        var nested = shape.as_if_statement(branch[index])
        if nested and nested.has_else_branch {
            var saved_line = current_line
            current_line = nested.line
            report(
                "this 'if'/'else' is inside a branch of another 'if'/'else': move it into a function named for what it decides, or, when both test which member of a union a value is, use one 'switch'",
            )
            current_line = saved_line
        }
        index = index + 1
    }
}

func collect_chain_narrowed_names(if_statement: Syntax.Statements.IfStatement, names: List<String>): Boolean {
    crash if_statement.condition
    collect_narrowed_names(if_statement.condition, names)
    assert if_statement.has_else_branch
    var chained = chained_if(if_statement)
    if chained {
        return collect_chain_narrowed_names(chained, names)
    }
    return true
}

func chained_if(if_statement: Syntax.Statements.IfStatement): Syntax.Statements.IfStatement? {
    assert if_statement.else_branch.count() == 1
    var chained = shape.as_if_statement(if_statement.else_branch[0])
    if chained {
        if chained.follows_else {
            return chained
        }
    }
    return null
}

func keep_shared_calls(
    if_statement: Syntax.Statements.IfStatement,
    narrowed: List<String>,
    shared: List<String>,
): List<String> {
    var chained = chained_if(if_statement)
    if chained {
        var kept = calls_also_in(shared, chained.then_branch, narrowed)
        return keep_shared_calls(chained, narrowed, kept)
    }
    return calls_also_in(shared, if_statement.else_branch, narrowed)
}

func calls_also_in(
    shared: List<String>,
    branch: List<Syntax.Statements.Statement>,
    narrowed: List<String>,
): List<String> {
    var found = List<String>()
    collect_branch_calls(branch, narrowed, found)
    var kept = List<String>()
    var index = 0
    while index < shared.count() {
        var call_text = shared[index]
        if found.contains(call_text) {
            kept.append(call_text)
        }
        index = index + 1
    }
    return kept
}

func copied_names(names: List<String>): List<String> {
    return names.copy()
}

func collect_narrowed_names(condition: Syntax.Expressions.Expression, names: List<String>) {
    var unary = shape.as_unary(condition)
    if unary {
        crash unary.operand
        collect_narrowed_names(unary.operand, names)
        return
    }
    var binary = shape.as_binary(condition)
    if binary {
        crash binary.left
        crash binary.right
        if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
            collect_narrowed_names(binary.left, names)
            collect_narrowed_names(binary.right, names)
        } else if binary.operator == 'equal' or binary.operator == 'not_equal' {
            if names_a_class_or_null(binary.right) {
                collect_mentioned_names(binary.left, names)
            }
        }
        return
    }
    if shape.as_identifier(condition) or shape.as_member(condition) or shape.as_index(condition) {
        collect_mentioned_names(condition, names)
    }
}

func names_a_class_or_null(expression: Syntax.Expressions.Expression): Boolean {
    switch expression {
        Syntax.Expressions.MemberExpression: return starts_upper_case(expression.name)
        Syntax.Expressions.IdentifierExpression: return starts_upper_case(expression.name)
        _: return shape.is_null_literal(expression)
    }
}

func collect_branch_calls(branch: List<Syntax.Statements.Statement>, narrowed: List<String>, calls: List<String>) {
    var changed = copied_names(narrowed)
    var index = 0
    while index < branch.count() {
        var statement = branch[index]
        switch statement {
            Syntax.Statements.VariableDeclaration: {
                crash statement.value
                collect_repeatable_calls(statement.value, changed, calls)
                changed.append(statement.name)
            }
            Syntax.Statements.AssignmentStatement: {
                crash statement.value
                crash statement.target
                collect_repeatable_calls(statement.value, changed, calls)
                collect_mentioned_names(statement.target, changed)
            }
            Syntax.Statements.ExpressionStatement: {
                crash statement.value
                collect_statement_call_parts(statement.value, changed, calls)
                collect_mentioned_names(statement.value, changed)
            }
            Syntax.Statements.ReturnStatement: {
                if statement.value {
                    collect_repeatable_calls(statement.value, changed, calls)
                }
            }
            Syntax.Statements.AssertStatement: {
                crash statement.value
                collect_repeatable_calls(statement.value, changed, calls)
                collect_mentioned_names(statement.value, changed)
            }
            Syntax.Statements.IfStatement: {
                crash statement.condition
                collect_repeatable_calls(statement.condition, changed, calls)
                return
            }
            _: return
        }
        index = index + 1
    }
}

func collect_statement_call_parts(
    expression: Syntax.Expressions.Expression,
    changed: List<String>,
    calls: List<String>,
) {
    var arguments = List<Syntax.Expressions.Expression>()
    var callee: Syntax.Expressions.Expression? = null
    switch expression {
        Syntax.Expressions.CallExpression: {
            callee = expression.callee
            arguments = expression.arguments
        }
        Syntax.Expressions.GenericCallExpression: {
            callee = expression.callee
            arguments = expression.arguments
        }
        _: {
            collect_repeatable_calls(expression, changed, calls)
            return
        }
    }
    crash callee
    collect_repeatable_calls(callee, changed, calls)
    var index = 0
    while index < arguments.count() {
        collect_repeatable_calls(arguments[index], changed, calls)
        index = index + 1
    }
}

func collect_repeatable_calls(expression: Syntax.Expressions.Expression, changed: List<String>, calls: List<String>) {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            add_repeatable_call(expression, expression.callee, expression.arguments, changed, calls)
            collect_repeatable_calls(expression.callee, changed, calls)
            collect_each_repeatable_call(expression.arguments, changed, calls)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            add_repeatable_call(expression, expression.callee, expression.arguments, changed, calls)
            collect_repeatable_calls(expression.callee, changed, calls)
            collect_each_repeatable_call(expression.arguments, changed, calls)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            collect_repeatable_calls(expression.left, changed, calls)
            if expression.operator != 'logical_and' and expression.operator != 'logical_or' {
                collect_repeatable_calls(expression.right, changed, calls)
            }
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            collect_repeatable_calls(expression.operand, changed, calls)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            collect_repeatable_calls(expression.object, changed, calls)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            collect_repeatable_calls(expression.object, changed, calls)
            collect_repeatable_calls(expression.index, changed, calls)
        }
        _: return
    }
}

func collect_each_repeatable_call(
    expressions: List<Syntax.Expressions.Expression>,
    changed: List<String>,
    calls: List<String>,
) {
    var index = 0
    while index < expressions.count() {
        collect_repeatable_calls(expressions[index], changed, calls)
        index = index + 1
    }
}

func add_repeatable_call(
    call: Syntax.Expressions.Expression,
    callee: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    changed: List<String>,
    calls: List<String>,
) {
    assert not arguments.is_empty()
    var called_name = ""
    var identifier = shape.as_identifier(callee)
    var member = shape.as_member(callee)
    if identifier {
        called_name = identifier.name
    } else if member {
        called_name = member.name
    }
    assert not starts_upper_case(called_name)
    var mentioned = List<String>()
    collect_mentioned_names(call, mentioned)
    var index = 0
    while index < mentioned.count() {
        assert not changed.contains(mentioned[index])
        index = index + 1
    }
    var source_expression = Syntax.SourcePrinter().source_expression(call)
    calls.append(source_expression)
}

func starts_upper_case(name: String): Boolean {
    var first_letter = name.slice(0, 1)
    return first_letter.upper_case() == first_letter and first_letter.lower_case() != first_letter
}

func collect_mentioned_names(expression: Syntax.Expressions.Expression, names: List<String>) {
    switch expression {
        Syntax.Expressions.IdentifierExpression: names.append(expression.name)
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            collect_mentioned_names(expression.callee, names)
            collect_each_mentioned_name(expression.arguments, names)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            collect_mentioned_names(expression.callee, names)
            collect_each_mentioned_name(expression.arguments, names)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            collect_mentioned_names(expression.left, names)
            collect_mentioned_names(expression.right, names)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            collect_mentioned_names(expression.operand, names)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            collect_mentioned_names(expression.object, names)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            collect_mentioned_names(expression.object, names)
            collect_mentioned_names(expression.index, names)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                collect_mentioned_names(element_value, names)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                collect_mentioned_names(field_value, names)
                index = index + 1
            }
        }
        _: return
    }
}

func mark_folded_names_used(statements: List<Syntax.Statements.Statement>, scope: Scope) {
    mark_folded_words_read(statements)
    var names = List<String>()
    collect_block_names(statements, names)
    names.each(scope.mark_used)
}

func collect_block_names(statements: List<Syntax.Statements.Statement>, names: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_statement_names(statements[index], names)
        index = index + 1
    }
}

func collect_statement_names(statement: Syntax.Statements.Statement, names: List<String>) {
    switch statement {
        Syntax.Statements.VariableDeclaration: collect_optional_names(statement.value, names)
        Syntax.Statements.AssignmentStatement: {
            collect_optional_names(statement.target, names)
            collect_optional_names(statement.value, names)
        }
        Syntax.Statements.IfStatement: {
            collect_optional_names(statement.condition, names)
            collect_block_names(statement.then_branch, names)
            collect_block_names(statement.else_branch, names)
        }
        Syntax.Statements.WhileStatement: {
            collect_optional_names(statement.condition, names)
            collect_block_names(statement.body, names)
        }
        Syntax.Statements.SwitchStatement: {
            collect_optional_names(statement.subject, names)
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_block_names(statement.cases[case_index].body, names)
                case_index = case_index + 1
            }
        }
        Syntax.Statements.AssertStatement: collect_optional_names(statement.value, names)
        Syntax.Statements.ReturnStatement: collect_optional_names(statement.value, names)
        Syntax.Statements.ExpressionStatement: collect_optional_names(statement.value, names)
        _: return
    }
}

func collect_optional_names(expression: Syntax.Expressions.Expression?, names: List<String>) {
    assert expression
    collect_mentioned_names(expression, names)
}

func collect_each_mentioned_name(expressions: List<Syntax.Expressions.Expression>, names: List<String>) {
    var index = 0
    while index < expressions.count() {
        collect_mentioned_names(expressions[index], names)
        index = index + 1
    }
}

func report_nested_calls(statement: Syntax.Statements.Statement, class_information: Analysis.ClassInfo) {
    report_long_construction(statement)
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            report_nested_calls_in(statement.value)
            report_singletons_in_declared(statement.value, class_information)
            report_local_singleton(statement, class_information)
            report_written_handle_type(statement)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            report_nested_calls_in(statement.target)
            report_nested_calls_in(statement.value)
            report_inline_singletons(statement.target, class_information)
            report_inline_singletons(statement.value, class_information)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            report_nested_calls_in(statement.value)
            report_inline_singletons(statement.value, class_information)
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                report_nested_calls_in(statement.value)
                report_inline_singletons(statement.value, class_information)
            }
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            report_nested_calls_in(statement.value)
            report_inline_singletons(statement.value, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            report_nested_calls_in(statement.condition)
            report_inline_singletons(statement.condition, class_information)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            report_nested_calls_in(statement.condition)
            report_inline_singletons(statement.condition, class_information)
        }
        Syntax.Statements.SwitchStatement: {
            crash statement.subject
            report_nested_calls_in(statement.subject)
            report_inline_singletons(statement.subject, class_information)
        }
        _: return
    }
}

func report_long_construction(statement: Syntax.Statements.Statement) {
    var depth = statement_depth(statement)
    assert depth >= 0
    var printer = Syntax.SourcePrinter()
    var printed = printer.source_statement_line(statement, depth)
    var columns = printed.length()
    assert columns > printer.width
    var construction = construction_in_statement(statement)
    assert construction
    var construction_text = printer.source_expression(construction)
    var class_name = constructed_class_name(construction)
    var variable = variable_name_for(class_name)
    report(
        "this line is {columns} columns, wider than the formatter's {printer.width}, and it constructs '{construction_text}' inside the arguments of '{long_line_callee}': a long line makes no object inside a call, so make it first on a line of its own, 'var {variable} = {construction_text}', and pass '{variable}'",
    )
}

func statement_depth(statement: Syntax.Statements.Statement): Integer {
    switch statement {
        Syntax.Statements.VariableDeclaration: return statement.depth
        Syntax.Statements.AssignmentStatement: return statement.depth
        Syntax.Statements.ExpressionStatement: return statement.depth
        Syntax.Statements.ReturnStatement: return statement.depth
        Syntax.Statements.AssertStatement: return statement.depth
        _: return -1
    }
}

func construction_in_statement(statement: Syntax.Statements.Statement): Syntax.Expressions.Expression? {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            return construction_in_arguments(statement.value)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.value
            return construction_in_arguments(statement.value)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return construction_in_arguments(statement.value)
        }
        Syntax.Statements.ReturnStatement: {
            assert statement.value
            return construction_in_arguments(statement.value)
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            return construction_in_arguments(statement.value)
        }
        _: return null
    }
}

func construction_in_arguments(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            return construction_among(expression.callee, expression.arguments)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            return construction_among(expression.callee, expression.arguments)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            assert not expression.is_text_join
            var on_the_left = construction_in_arguments(expression.left)
            if on_the_left {
                return on_the_left
            }
            return construction_in_arguments(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return construction_in_arguments(expression.operand)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return construction_in_arguments(expression.object)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            var in_object = construction_in_arguments(expression.object)
            if in_object {
                return in_object
            }
            return construction_in_arguments(expression.index)
        }
        _: return null
    }
}

func construction_among(
    callee: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
): Syntax.Expressions.Expression? {
    var index = 0
    while index < arguments.count() {
        var constructed = construction_within(arguments[index])
        if constructed {
            var printer = Syntax.SourcePrinter()
            long_line_callee = printer.source_expression(callee)
            return constructed
        }
        index = index + 1
    }
    var in_callee = construction_in_arguments(callee)
    if in_callee {
        return in_callee
    }
    index = 0
    while index < arguments.count() {
        var nested = construction_in_arguments(arguments[index])
        if nested {
            return nested
        }
        index = index + 1
    }
    return null
}

func construction_within(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            assert not constructor_name(expression.callee).is_empty()
            return expression
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            assert not constructor_name(expression.callee).is_empty()
            return expression
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            assert not expression.is_text_join
            var on_the_left = construction_within(expression.left)
            if on_the_left {
                return on_the_left
            }
            return construction_within(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return construction_within(expression.operand)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return construction_within(expression.object)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            var in_object = construction_within(expression.object)
            if in_object {
                return in_object
            }
            return construction_within(expression.index)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                var in_element = construction_within(element_value)
                if in_element {
                    return in_element
                }
                index = index + 1
            }
            return null
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                var in_field = construction_within(field_value)
                if in_field {
                    return in_field
                }
                index = index + 1
            }
            return null
        }
        _: return null
    }
}

func constructed_class_name(construction: Syntax.Expressions.Expression): String {
    switch construction {
        Syntax.Expressions.CallExpression: {
            crash construction.callee
            return constructor_name(construction.callee)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash construction.callee
            return constructor_name(construction.callee)
        }
        _: return ""
    }
}

func report_singletons_in_declared(value: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var singleton = constructed_singleton(value, class_information)
    if singleton {
        report_singleton_arguments(value, class_information)
        return
    }
    report_inline_singletons(value, class_information)
}

func report_written_handle_type(declaration: Syntax.Statements.VariableDeclaration) {
    assert declaration.type_reference and declaration.value
    var written = shape.as_named_type(declaration.type_reference)
    assert written
    var written_kind = written.path.last()
    assert written.path.count() == 1 and (written_kind == "Parallel" or written_kind == "Concurrent")
    var started = shape.as_call(declaration.value)
    assert started
    crash started.callee
    var starter = shape.as_identifier(started.callee)
    assert starter
    assert starter.name == "Parallel" or starter.name == "Concurrent"
    var printer = Syntax.SourcePrinter()
    var construction_text = printer.source_expression(declaration.value)
    report(
        "the type of a '{starter.name}' handle is never written: it is worked out from the function it runs, so write 'var {declaration.name} = {construction_text}'",
    )
}

func has_no_attribute_to_spare(information: Analysis.ClassInfo): Boolean {
    return information.is_value_class or information.qualified_dotted == "List" or information.qualified_dotted == "Dictionary"
}

func report_local_singleton(declaration: Syntax.Statements.VariableDeclaration, class_information: Analysis.ClassInfo) {
    assert not has_no_attribute_to_spare(class_information)
    crash declaration.value
    var singleton = constructed_singleton(declaration.value, class_information)
    assert singleton
    var printer = Syntax.SourcePrinter()
    var construction_text = printer.source_expression(declaration.value)
    assert not construction_text.contains(".class") and not construction_text.contains("$")
    report(
        "'{singleton.qualified_dotted}' is a singleton, bound here as a local: bind it once beside the attributes, 'var {declaration.name} = {construction_text}', so every singleton the class uses is at the top of its file",
    )
}

func report_inline_singletons(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var singleton = constructed_singleton(expression, class_information)
    if singleton {
        report_unbound_singleton(singleton, expression, "")
        report_singleton_arguments(expression, class_information)
        return
    }
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            report_inline_singletons(expression.callee, class_information)
            report_inline_singletons_each(expression.arguments, class_information)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            report_inline_singletons(expression.callee, class_information)
            report_inline_singletons_each(expression.arguments, class_information)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            var receiver = constructed_singleton(expression.object, class_information)
            if receiver {
                report_unbound_singleton(receiver, expression.object, expression.name)
                report_singleton_arguments(expression.object, class_information)
                return
            }
            report_inline_singletons(expression.object, class_information)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            report_inline_singletons(expression.left, class_information)
            report_inline_singletons(expression.right, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            report_inline_singletons(expression.operand, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            report_inline_singletons(expression.object, class_information)
            report_inline_singletons(expression.index, class_information)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                report_inline_singletons(element_value, class_information)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                report_inline_singletons(field_value, class_information)
                index = index + 1
            }
        }
        _: return
    }
}

func report_inline_singletons_each(
    expressions: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
) {
    var index = 0
    while index < expressions.count() {
        report_inline_singletons(expressions[index], class_information)
        index = index + 1
    }
}

func report_singleton_arguments(construction: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var call = shape.as_call(construction)
    if call {
        report_inline_singletons_each(call.arguments, class_information)
        return
    }
    var generic_call = shape.as_generic_call(construction)
    assert generic_call
    report_inline_singletons_each(generic_call.arguments, class_information)
}

func constructed_singleton(
    expression: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var call = shape.as_call(expression)
    if call {
        crash call.callee
        return singleton_named(call.callee, class_information)
    }
    var generic_call = shape.as_generic_call(expression)
    if generic_call {
        crash generic_call.callee
        return singleton_named(generic_call.callee, class_information)
    }
    return null
}

func singleton_named(
    callee: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var named_class = try_resolve_static_path(callee, class_information.qualified_dotted)
    assert named_class
    assert named_class.is_singleton
    return named_class
}

func report_unbound_singleton(
    singleton: Analysis.ClassInfo,
    construction: Syntax.Expressions.Expression,
    member: String,
) {
    var printer = Syntax.SourcePrinter()
    var construction_text = printer.source_expression(construction)
    var variable = variable_name_for(singleton.simple_name)
    var use = variable
    if not member.is_empty() {
        use = "{variable}.{member}"
    }
    report(
        "'{singleton.simple_name}' is a singleton: bind it once beside the attributes, 'var {variable} = {construction_text}', and use '{use}'",
    )
}

func variable_name_for(class_name: String): String {
    var name = ""
    var index = 0
    while index < class_name.length() {
        var letter = class_name.slice(index, index + 1)
        var lower = letter.lower_case()
        if index > 0 and lower != letter {
            name = "{name}_"
        }
        name = name + lower
        index = index + 1
    }
    return name
}

func report_nested_calls_in(expression: Syntax.Expressions.Expression) {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            report_nested_calls_in(expression.callee)
            report_argument_calls(expression.callee, expression.arguments)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            report_nested_calls_in(expression.callee)
            report_argument_calls(expression.callee, expression.arguments)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            report_nested_calls_in(expression.left)
            report_nested_calls_in(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            report_nested_calls_in(expression.operand)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            report_nested_calls_in(expression.object)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            report_nested_calls_in(expression.object)
            report_nested_calls_in(expression.index)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                report_nested_calls_in(element_value)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                report_nested_calls_in(field_value)
                index = index + 1
            }
        }
        _: return
    }
}

func report_argument_calls(callee: Syntax.Expressions.Expression, arguments: List<Syntax.Expressions.Expression>) {
    if current_class {
        assert not spread_template(arguments, current_class)
    }
    var printer = Syntax.SourcePrinter()
    var called = printer.source_expression(callee)
    var index = 0
    while index < arguments.count() {
        report_calls_in_argument(arguments[index], called, "")
        index = index + 1
    }
}

func report_calls_in_argument(expression: Syntax.Expressions.Expression, called: String, constructor: String) {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            report_call_in_argument(expression, expression.callee, expression.arguments, called, constructor)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            report_call_in_argument(expression, expression.callee, expression.arguments, called, constructor)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if expression.is_text_join {
                report_nested_calls_in(expression.left)
                report_nested_calls_in(expression.right)
                return
            }
            report_calls_in_argument(expression.left, called, constructor)
            report_calls_in_argument(expression.right, called, constructor)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            report_calls_in_argument(expression.operand, called, constructor)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            report_calls_in_argument(expression.object, called, constructor)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            report_calls_in_argument(expression.object, called, constructor)
            report_calls_in_argument(expression.index, called, constructor)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                report_calls_in_argument(element_value, called, constructor)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                report_calls_in_argument(field_value, called, constructor)
                index = index + 1
            }
        }
        _: return
    }
}

func report_call_in_argument(
    call: Syntax.Expressions.Expression,
    callee: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    called: String,
    constructor: String,
) {
    var printer = Syntax.SourcePrinter()
    var call_text = printer.source_expression(call)
    var callee_text = printer.source_expression(callee)
    if not constructor.is_empty() {
        report(
            "'{call_text}' is passed to '{constructor}', which is itself passed to '{called}': compute it first into a named 'var' and pass the name. Only a constructor may be an argument, and only one level deep",
        )
        return
    }
    var constructed = constructor_name(callee)
    if not constructed.is_empty() {
        var index = 0
        while index < arguments.count() {
            report_calls_in_argument(arguments[index], called, callee_text)
            index = index + 1
        }
        return
    }
    report(
        "'{call_text}' is called inside an argument of '{called}': compute it first into a named 'var' and pass the name. Only a constructor may be an argument, and only one level deep",
    )
}

func constructor_name(callee: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(callee)
    if identifier {
        if starts_upper_case(identifier.name) {
            return identifier.name
        }
        return ""
    }
    var member = shape.as_member(callee)
    if member {
        if starts_upper_case(member.name) {
            return member.name
        }
    }
    return ""
}

func generate_switch_statement(
    switch_statement: Syntax.Statements.SwitchStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert switch_statement.subject
    var guard = try_nullable_guard(switch_statement.subject, scope, class_information)
    if guard {
        generate_nullable_switch(switch_statement, scope, class_information, function_information, guard)
        return
    }
    var subject = generate_expression(switch_statement.subject, scope, class_information)
    var subject_type = subject.get_type()
    if type_shape.as_nullable(subject_type) {
        report("switch over a value that may be null needs a variable or an attribute as its subject")
        return
    }
    var subject_union = type_shape.as_union(subject_type)
    if not subject_union {
        report("switch needs a union value")
        return
    }
    assert subject_union
    var information = find_union_by_c_name(subject_union.c_name)
    assert information
    if information.is_shape {
        report(
            "switch needs a union: '{information.simple_name}' is a type matched by shape, so read its attributes directly",
        )
        return
    }
    var subject_temporary = next_temporary()
    builder.add_user("\{")
    builder.add_user("{subject_union.c_name} {subject_temporary} = {subject.code};")
    var subject_identifier = shape.as_identifier(switch_statement.subject)
    report_repeated_cases(switch_statement)
    report_single_case(switch_statement)
    var covered_names = List<String>()
    var answers_the_rest = false
    var case_index = 0
    while case_index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[case_index]
        if is_rest_case(switch_case) {
            report_misplaced_rest_case(switch_statement, case_index, covered_names, information)
            answers_the_rest = true
            generate_rest_case(
                switch_case,
                case_index,
                information,
                subject_temporary,
                subject_identifier,
                covered_names,
                scope,
                class_information,
                function_information,
            )
        } else {
            generate_union_case(
                switch_case,
                case_index,
                information,
                subject_temporary,
                subject_identifier,
                covered_names,
                scope,
                class_information,
                function_information,
            )
        }
        case_index = case_index + 1
    }
    if covered_names.count() != information.members.count() and not answers_the_rest {
        var missing = List<String>()
        var member_index = 0
        while member_index < information.members.count() {
            var member_name = information.members[member_index].simple_name
            if not covered_names.contains(member_name) {
                missing.append(member_name)
            }
            member_index = member_index + 1
        }
        report(
            "this switch over '{information.simple_name}' has no case for {missing.join(", ")}: every member is covered, so a member added later cannot be forgotten",
        )
    }
    if owns(subject, switch_statement.subject) {
        builder.add_user("{release_call(subject_type, subject_temporary)};")
    }
    builder.add_user("}")
}

func generate_union_dispatch(
    information: Analysis.UnionInfo,
    member_name: String,
    is_call: Boolean,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if information.is_shape {
        if is_call {
            return generate_shape_call(
                information,
                member_name,
                object_result,
                object_ast,
                arguments_ast,
                scope,
                class_information,
            )
        }
        var wanted = find_required_function(information, member_name)
        if wanted {
            return shape_function_value(information, wanted, object_result, object_ast)
        }
        return generate_shape_read(information, member_name, object_result, object_ast)
    }
    var first_member = information.members.first()
    crash first_member
    var result_type = void_type()
    var expected_types = no_types()
    if is_call {
        var first_function = find_or_instantiate_function(first_member, member_name)
        if not first_function {
            report(
                "'{first_member.simple_name}' does not define '{member_name}', so it cannot be called on union '{information.simple_name}'",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        crash first_function
        result_type = first_function.get_return_type()
        expected_types = parameter_types_of(first_function.parameters)
    } else {
        var first_field = first_member.find_field(member_name)
        if not first_field {
            report(
                "'{first_member.simple_name}' has no attribute '{member_name}', so it cannot be read on union '{information.simple_name}'",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        crash first_field
        result_type = first_field.get_type()
        mark_members_read(information.members, member_name)
    }
    var owning_object = owns(object_result, object_ast)
    var lines = List<String>()
    var object_temporary = next_temporary()
    lines.append("{information.c_name} {object_temporary} = {object_result.code};")
    var argument_temporaries = List<String>()
    var argument_index = 0
    while argument_index < arguments_ast.count() {
        var argument_temporary = next_temporary()
        lines.append(
            "{c_type_name(expected_types[argument_index])} {argument_temporary} = {coerce_for_store(arguments_ast[argument_index], expected_types[argument_index], scope, class_information)};",
        )
        argument_temporaries.append(argument_temporary)
        argument_index = argument_index + 1
    }
    var has_result = not type_shape.is_void(result_type)
    var result_temporary = next_temporary()
    if has_result {
        lines.append("{c_type_name(result_type)} {result_temporary} = {default_value_for_scalar_or_null(result_type)};")
    }
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var casted_object = "(({member.c_name}*){object_temporary})"
        var branch_code = ""
        if is_call {
            branch_code = union_member_call(member, member_name, casted_object, argument_temporaries, information)
        } else {
            branch_code = "{casted_object}->{c_value_name(member_name)}"
            if owning_object and type_needs_drop(result_type) {
                branch_code = retain_call(result_type, branch_code)
            }
        }
        var keyword = "if "
        if member_index > 0 {
            keyword = "else if "
        }
        var member_test = class_id_test(object_temporary, member)
        if has_result {
            lines.append(keyword + "{member_test} \{ {result_temporary} = {branch_code}; }")
        } else {
            lines.append(keyword + "{member_test} \{ {branch_code}; }")
        }
        member_index = member_index + 1
    }
    if owning_object {
        lines.append("{information.c_name}___release({object_temporary});")
    }
    if has_result {
        lines.append("{result_temporary};")
    }
    return ExpressionResult("(\{ {lines.join(" ")} })", result_type)
}

func union_member_call(
    member: Analysis.ClassInfo,
    member_name: String,
    casted_object: String,
    argument_temporaries: List<String>,
    information: Analysis.UnionInfo,
): String {
    var found_function = find_or_instantiate_function(member, member_name)
    if found_function {
        var call_arguments = argument_temporaries.copy()
        call_arguments.prepend(casted_object)
        return "{found_function.c_name}({call_arguments.join(", ")})"
    }
    report(
        "'{member.simple_name}' does not define '{member_name}', so it cannot be called on union '{information.simple_name}'",
    )
    return ""
}

func default_value_for_scalar_or_null(spite_type: Analysis.SpiteType): String {
    if type_is_reference(spite_type) {
        return "0"
    }
    return default_value_for_type(spite_type)
}

func check_asserted_condition(
    assert_statement: Syntax.Statements.AssertStatement,
    condition_result: ExpressionResult,
    scope: Scope,
) {
    var keyword = "assert"
    if assert_statement.is_crash {
        keyword = "crash"
    }
    var proof = earlier_proof(assert_statement.value, condition_result, scope)
    if proof.is_empty() {
        check_condition(condition_result, keyword)
    } else {
        var proven_path = operand_text(assert_statement.value)
        report("'{proven_path}' is already proven by {proof}, so this '{keyword}' proves nothing: remove it")
    }
}

func earlier_proof(value: Syntax.Expressions.Expression, condition: ExpressionResult, scope: Scope): String {
    var condition_type = condition.get_type()
    assert not type_shape.is_void(condition_type)
    assert not type_shape.as_nullable(condition_type)
    assert not is_boolean_type(condition_type)
    assert shape.as_index(value)
    var path = operand_text(value)
    assert not path.is_empty()
    var proof = scope.proof_of(path)
    if proof.is_empty() {
        return "an earlier check"
    }
    return proof
}

func check_condition(condition: ExpressionResult, keyword: String) {
    var condition_type = condition.get_type()
    assert not type_shape.is_void(condition_type)
    assert not type_shape.as_nullable(condition_type)
    if type_shape.as_class_ref(condition_type) {
        report(
            "this value cannot be null here (it is {type_with_article(condition_type)}), so '{keyword}' on it proves nothing: remove the check",
        )
        return
    }
    if not is_boolean_type(condition_type) {
        report(
            "the condition of '{keyword}' is {type_with_article(condition_type)}, but it must be a Boolean: compare it with something, like 'count > 0' or 'name != \"\"'",
        )
    }
}

func narrow_proven_indices(condition: Syntax.Expressions.Expression, scope: Scope) {
    var binary = shape.as_binary(condition)
    assert binary
    crash binary.left
    crash binary.right
    if binary.operator == 'logical_and' {
        narrow_proven_indices(binary.left, scope)
        narrow_proven_indices(binary.right, scope)
        return
    }
    narrow_nonzero(binary, scope)
    if binary.operator == 'less' {
        narrow_counted_element(condition, scope)
        return
    }
    var counted = counted_list_text(binary.left)
    assert not counted.is_empty()
    var condition_text = Syntax.SourcePrinter().source_expression(condition)
    var named_bound = operand_text(binary.right)
    if binary.operator == 'greater' and not named_bound.is_empty() {
        scope.narrow_bound_path("{counted}[{named_bound}]", condition_text)
        return
    }
    var bound = shape.as_integer_literal(binary.right)
    assert bound
    var proven = 0
    if binary.operator == 'equal' or binary.operator == 'greater_equal' {
        proven = bound.value
    } else if binary.operator == 'greater' {
        proven = bound.value + 1
    }
    var index = 0
    while index < proven and index < 64 {
        scope.narrow_bound_path("{counted}[{index}]", condition_text)
        index = index + 1
    }
}

func narrow_nonzero(binary: Syntax.Expressions.BinaryExpression, scope: Scope) {
    assert binary.operator == 'not_equal' or binary.operator == 'greater'
    crash binary.left
    crash binary.right
    var bound = shape.as_integer_literal(binary.right)
    assert bound
    assert bound.value == 0
    var divisor_text = operand_text(binary.left)
    assert not divisor_text.is_empty()
    scope.narrow_path("~[{divisor_text}]")
}

func narrow_counted_element(condition: Syntax.Expressions.Expression, scope: Scope) {
    var binary = shape.as_binary(condition)
    assert binary
    crash binary.left
    crash binary.right
    assert binary.operator == 'less'
    var counter = operand_text(binary.left)
    var counted = counted_list_text(binary.right)
    assert not counter.is_empty()
    assert not counted.is_empty()
    var condition_text = Syntax.SourcePrinter().source_expression(condition)
    scope.narrow_bound_path("{counted}[{counter}]", condition_text)
}

func counted_list_text(expression: Syntax.Expressions.Expression): String {
    var shortened = shape.as_binary(expression)
    if shortened {
        if shortened.operator == 'subtract' and shortened.left and shortened.right {
            if shape.as_integer_literal(shortened.right) {
                return counted_list_text(shortened.left)
            }
        }
        return ""
    }
    var call = shape.as_call(expression)
    if call {
        if call.callee and call.arguments.is_empty() {
            var member = shape.as_member(call.callee)
            if member {
                if member.name == "count" and member.object {
                    return operand_text(member.object)
                }
            }
        }
    }
    return ""
}

func generate_while_statement(
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert while_statement.condition
    var guard = try_nullable_guard(while_statement.condition, scope, class_information)
    if guard {
        builder.add_user("while ({guard.guard_code}) \{")
        var narrowed_body = Scope(scope)
        narrowed_body.is_loop = true
        narrow_by_guard(narrowed_body, guard)
        generate_block_in_scope(while_statement.body, narrowed_body, class_information, function_information)
        add_loop_check_point(class_information)
        builder.add_user("}")
        return
    }
    var condition_start = builder.user_count()
    var condition_result = generate_joined(while_statement.condition, scope, class_information)
    check_condition(condition_result, "while")
    var truth = owned_truth(condition_result, while_statement.condition)
    if resumable_mode and builder.user_count() > condition_start {
        builder.insert_user(condition_start, "while (1) \{")
        shift_wait_marks(condition_start)
        builder.add_user("if (!({truth})) break;")
    } else {
        builder.add_user("while ({truth}) \{")
    }
    var body_scope = Scope(scope)
    body_scope.is_loop = true
    narrow_proven_indices(while_statement.condition, body_scope)
    generate_block_in_scope(while_statement.body, body_scope, class_information, function_information)
    add_loop_check_point(class_information)
    builder.add_user("}")
}

func add_loop_check_point(class_information: Analysis.ClassInfo) {
    assert (remote_loop_port > 0 or hot_reload) and not is_library_class(class_information)
    var scheduler_class = find_class_by_qualified("Scheduler")
    crash scheduler_class
    var check_point = find_or_instantiate_function(scheduler_class, "check_point")
    crash check_point
    var scheduler = singleton_call(scheduler_class)
    builder.add_user(
        "\{ Scheduler* spite_check_point = {scheduler}; {check_point.c_name}(spite_check_point); Scheduler___release(spite_check_point); }",
    )
}

func index_key_text(key: Syntax.Expressions.Expression): String {
    var named = operand_text(key)
    if not named.is_empty() {
        return named
    }
    var number = shape.as_integer_literal(key)
    if number {
        return "{number.value}"
    }
    var text = shape.as_string_literal(key)
    if text {
        return "\"{text.value}\""
    }
    assert is_structural_key(key)
    var printer = Syntax.SourcePrinter()
    return printer.source_expression(key)
}

func is_structural_key(key: Syntax.Expressions.Expression): Boolean {
    switch key {
        Syntax.Expressions.IdentifierExpression: return true
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        Syntax.Expressions.UnaryExpression: return is_structural_part(key.operand)
        Syntax.Expressions.BinaryExpression: {
            assert not key.is_text_join
            return is_structural_part(key.left) and is_structural_part(key.right)
        }
        Syntax.Expressions.MemberExpression: return is_structural_part(key.object)
        Syntax.Expressions.IndexExpression: return is_structural_part(key.object) and is_structural_part(key.index)
        _: return false
    }
}

func is_structural_part(part: Syntax.Expressions.Expression?): Boolean {
    assert part
    return is_structural_key(part)
}

func operand_text(expression: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(expression)
    if identifier {
        return identifier.name
    }
    var indexed = shape.as_index(expression)
    if indexed {
        if indexed.object and indexed.index {
            var indexed_text = operand_text(indexed.object)
            var key_text = index_key_text(indexed.index)
            if not indexed_text.is_empty() and not key_text.is_empty() {
                return "{indexed_text}[{key_text}]"
            }
        }
        return ""
    }
    var member = shape.as_member(expression)
    if member {
        if member.object {
            var object_text = operand_text(member.object)
            if not object_text.is_empty() {
                return "{object_text}.{member.name}"
            }
        }
    }
    return ""
}

func emit_crash_operand(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var name = operand_text(expression)
    assert not name.is_empty()
    var saved_counter = temporary_counter
    var probe = generate_expression(expression, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    var printable = type_shape.as_string(probe_type)
    if type_shape.as_scalar(probe_type) {
        printable = true
    }
    if is_enum_type(probe_type) {
        printable = true
    }
    assert printable
    builder.add_user("fputs(\"\\t{escape_c_string(name)}=\", stderr);")
    var operand_statement = crash_operand_statement(expression, scope, class_information)
    builder.add_user(operand_statement)
}

func emit_crash_operands(
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var binary = shape.as_binary(condition)
    if binary {
        if binary.left {
            emit_crash_operand(binary.left, scope, class_information)
        }
        if binary.right {
            emit_crash_operand(binary.right, scope, class_information)
        }
        return
    }
    emit_crash_operand(condition, scope, class_information)
}

func content_hash(content: String): String {
    var hash: Long = 5381
    var index = 0
    while index < content.length() {
        hash = (hash * 33 + content.code_at(index)) % 2147483629
        index = index + 1
    }
    var digits = "0123456789abcdef"
    var text = ""
    var remaining = hash
    var count = 0
    while count < 8 {
        var digit: Integer = remaining % 16
        text = digits.character_at(digit) + text
        remaining = remaining / 16
        count = count + 1
    }
    return text
}

func operand_description(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var name = operand_text(expression)
    assert not name.is_empty()
    var saved_counter = temporary_counter
    var probe = generate_expression(expression, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    return "{name}:{type_display_name(probe_type)}"
}

func record_site(
    assert_statement: Syntax.Statements.AssertStatement,
    kind: String,
    function_name: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    site_ordinal = site_ordinal + 1
    current_site_id = content_hash("{current_owner}/{function_name}/{site_ordinal}/{assert_statement.condition_text}")
    var operands = List<String>()
    if assert_statement.value {
        var binary = shape.as_binary(assert_statement.value)
        if binary {
            if binary.left {
                var left_description = operand_description(binary.left, scope, class_information)
                if not left_description.is_empty() {
                    operands.append(left_description)
                }
            }
            if binary.right {
                var right_description = operand_description(binary.right, scope, class_information)
                if not right_description.is_empty() {
                    operands.append(right_description)
                }
            }
        } else {
            var single = operand_description(assert_statement.value, scope, class_information)
            if not single.is_empty() {
                operands.append(single)
            }
        }
    }
    crash_map_lines.append(
        "{current_site_id}\t{current_path}\t{current_line}\t0\t{current_owner}\t{function_name}\t{kind}\t{assert_statement.condition_text}\t{operands.join(" ")}",
    )
}

func sorted_position(sorted: List<String>, line: String): Integer {
    var position = sorted.count()
    while position > 0 {
        var before = position - 1
        crash before < sorted.count()
        if sorted[before] > line {
            position = before
        } else {
            return position
        }
    }
    return position
}

func crash_map(): String {
    var sorted = List<String>()
    var index = 0
    while index < crash_map_lines.count() {
        var line = crash_map_lines[index]
        var insert_position = sorted_position(sorted, line)
        sorted.insert(insert_position, line)
        index = index + 1
    }
    var body = sorted.join("\n")
    return "# spite crashes 1 {content_hash(body)}\n{body}\n"
}

func backslash_quote(): String {
    return "\""
}

func tab_text(): String {
    return "\\t"
}

func newline_text(): String {
    return "\\n"
}

func collect_and_sides(expression: Syntax.Expressions.Expression, sides: List<Syntax.Expressions.Expression>) {
    var joined = shape.as_binary(expression)
    if joined {
        if joined.operator == 'logical_and' {
            crash joined.left
            crash joined.right
            collect_and_sides(joined.left, sides)
            collect_and_sides(joined.right, sides)
            return
        }
    }
    sides.append(expression)
}

func generate_and_narrowing_if(
    if_statement: Syntax.Statements.IfStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    crash if_statement.condition
    var sides = List<Syntax.Expressions.Expression>()
    collect_and_sides(if_statement.condition, sides)
    assert sides.count() > 1
    var then_scope = Scope(scope)
    var tests = List<String>()
    var index = 0
    while index < sides.count() {
        if index > 0 {
            conditional_depth = conditional_depth + 1
        }
        var side_test = and_side_test(sides[index], then_scope, class_information)
        if index > 0 {
            conditional_depth = conditional_depth - 1
        }
        tests.append(side_test)
        index = index + 1
    }
    builder.add_user("if ({tests.join(" && ")}) \{")
    generate_block_in_scope(if_statement.then_branch, then_scope, class_information, function_information)
    builder.add_user("}")
    if if_statement.has_else_branch {
        builder.add_user("else \{")
        generate_block(if_statement.else_branch, scope, class_information, function_information)
        builder.add_user("}")
    }
    return true
}

func and_side_test(
    side: Syntax.Expressions.Expression,
    then_scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var guard = try_nullable_guard(side, then_scope, class_information)
    if guard {
        narrow_by_guard(then_scope, guard)
        return "({guard.guard_code})"
    }
    var side_result = generate_joined(side, then_scope, class_information)
    check_condition(side_result, "if")
    narrow_proven_indices(side, then_scope)
    return "({owned_truth(side_result, side)})"
}

func generate_assert_statement(
    assert_statement: Syntax.Statements.AssertStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert assert_statement.value
    var sides = List<Syntax.Expressions.Expression>()
    collect_and_sides(assert_statement.value, sides)
    if sides.count() > 1 {
        var side_index = 0
        while side_index < sides.count() {
            var side_text = Syntax.SourcePrinter().source_expression(sides[side_index])
            var side_statement = Syntax.Statements.AssertStatement(sides[side_index])
            side_statement.is_crash = assert_statement.is_crash
            side_statement.condition_text = side_text
            side_statement.line = assert_statement.line
            generate_assert_statement(side_statement, scope, class_information, function_information)
            side_index = side_index + 1
        }
        return
    }
    var guard = try_nullable_guard(assert_statement.value, scope, class_information)
    var guard_code = ""
    if guard {
        guard_code = guard.guard_code
        narrow_by_guard(scope, guard)
    } else {
        var condition_result = generate_joined(assert_statement.value, scope, class_information)
        guard_code = owned_truth(condition_result, assert_statement.value)
        narrow_proven_indices(assert_statement.value, scope)
        check_asserted_condition(assert_statement, condition_result, scope)
    }
    if not assert_statement.is_crash and function_information.is_constructor {
        report(
            "'assert' is not allowed in a constructor: a constructor is setup, not logic. Take already resolved values, or use 'crash' when absence is a bug",
        )
    }
    var site_kind = "assert-predicate"
    if guard {
        site_kind = "assert-narrowing"
    }
    if assert_statement.is_crash {
        site_kind = "crash"
    }
    record_site(assert_statement, site_kind, function_information.name, scope, class_information)
    builder.add_user("if (!({guard_code})) \{")
    if assert_statement.is_crash {
        builder.add_user("fflush(stdout);")
        builder.add_user(
            "fputs(\"spite.crash\\t{current_site_id}\\t{escape_c_string(current_path)}:{current_line}\\t{current_owner}\\t{function_information.name}\\t{escape_c_string(assert_statement.condition_text)}\", stderr);",
        )
        emit_crash_operands(assert_statement.value, scope, class_information)
        builder.add_user("fputs(\"\\n\", stderr);")
        builder.add_user("spite_report_assert_trace();")
        builder.add_user("exit(1);")
        builder.add_user("}")
        return
    }
    if not current_path.starts_with("library/") {
        record_in_assert_trace(assert_statement, function_information)
    }
    emit_scope_drops(scope, true)
    var function_information_return_type = function_information.get_return_type()
    if type_shape.is_void(function_information_return_type) {
        builder.add_user("return;")
    } else {
        builder.add_user("return {default_value_for_type(function_information_return_type)};")
    }
    builder.add_user("}")
}

func record_in_assert_trace(
    assert_statement: Syntax.Statements.AssertStatement,
    function_information: Analysis.FunctionInfo,
) {
    builder.add_user(
        "SPITE_TRACE_ASSERT({backslash_quote()}spite.assert{tab_text()}{current_site_id}{tab_text()}{escape_c_string(current_path)}:{current_line}{tab_text()}{current_owner}{tab_text()}{function_information.name}{tab_text()}{escape_c_string(assert_statement.condition_text)}{newline_text()}{backslash_quote()});",
    )
}

func generate_return_statement(
    return_statement: Syntax.Statements.ReturnStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    var return_type = function_information.get_return_type()
    if type_shape.is_void(return_type) {
        if return_statement.value and not has_error {
            report(
                "'{function_information.name}' returns nothing, so 'return' cannot carry a value here: declare what it returns, like 'func {function_information.name}(): Integer', or return without a value",
            )
            return
        }
    } else if not return_statement.value {
        report("'{function_information.name}' returns {type_with_article(return_type)}, so 'return' needs a value")
        return
    }
    if return_statement.value {
        var value_code = coerce_for_store(return_statement.value, return_type, scope, class_information)
        var temporary = next_temporary()
        builder.add_user("{c_type_name(return_type)} {temporary} = {value_code};")
        emit_scope_drops(scope, true)
        builder.add_user("return {temporary};")
    } else {
        emit_scope_drops(scope, true)
        builder.add_user("return;")
    }
}

func generate_expression_statement(
    expression_statement: Syntax.Statements.ExpressionStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert expression_statement.value
    assert not freed_from_frame(expression_statement, scope)
    report_dropped_construction(expression_statement.value, class_information)
    var result = generate_expression(expression_statement.value, scope, class_information)
    var result_type = result.get_type()
    if type_shape.is_void(result_type) {
        builder.add_user("{result.code};")
        return
    }
    if type_needs_drop(result_type) {
        if owns(result, expression_statement.value) {
            var temporary = next_temporary()
            builder.add_user("{c_type_name(result_type)} {temporary} = {result.code};")
            builder.add_user("{release_call(result_type, temporary)};")
            return
        }
    }
    builder.add_user("(void)({result.code});")
}

func report_dropped_construction(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo) {
    var callee = constructor_callee(expression)
    assert callee
    var constructed = try_resolve_static_path(callee, class_information.qualified_dotted)
    assert constructed
    assert not constructed.is_singleton
    var printer = Syntax.SourcePrinter()
    var written = printer.source_expression(expression)
    var name = constructed.simple_name
    report(
        "'{written}' makes a '{name}' and drops it: a constructed object must be kept and used, so a class whose construction is the whole point should be a function instead -- turn '{name}' into a function of the class that needs it, or keep the object in a variable that is read",
    )
}

func constructor_callee(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    var call = shape.as_call(expression)
    if call {
        return call.callee
    }
    var generic_call = shape.as_generic_call(expression)
    assert generic_call
    return generic_call.callee
}

func generate_statement(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    undo_proofs_after_calls(scope, class_information)
    current_line = statement.line
    var saved_poisoned = statement_poisoned
    var mentioned = List<String>()
    if mentions_poisoned(statement, mentioned) {
        statement_poisoned = true
        mark_each_used(mentioned, scope)
    }
    var errors_before = error_lines.count()
    var waits_before = wait_mark_counters.count()
    var ended_in_return = generate_statement_kind(statement, scope, class_information, function_information)
    if resumable_mode {
        drop_unread_waits(waits_before)
    }
    var declared = shape.as_variable_declaration(statement)
    if declared and error_lines.count() > errors_before {
        scope.mark_used(declared.name)
    }
    if declared and statement_poisoned {
        var key = poisoned_key(declared.name)
        poisoned_names.append(key)
        scope.mark_used(declared.name)
    }
    statement_poisoned = saved_poisoned
    return ended_in_return
}

func mark_each_used(names: List<String>, scope: Scope) {
    names.each(scope.mark_used)
}

func generate_statement_kind(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    report_nested_calls(statement, class_information)
    var variable_declaration = shape.as_variable_declaration(statement)
    if variable_declaration {
        generate_variable_declaration(variable_declaration, scope, class_information)
        return false
    }
    var assignment = shape.as_assignment_statement(statement)
    if assignment {
        generate_assignment(assignment, scope, class_information)
        return false
    }
    var if_statement = shape.as_if_statement(statement)
    if if_statement {
        return generate_if_statement(if_statement, scope, class_information, function_information)
    }
    var while_statement = shape.as_while_statement(statement)
    if while_statement {
        generate_while_statement(while_statement, scope, class_information, function_information)
        return false
    }
    var assert_statement = shape.as_assert_statement(statement)
    if assert_statement {
        generate_assert_statement(assert_statement, scope, class_information, function_information)
        return false
    }
    var return_statement = shape.as_return_statement(statement)
    if return_statement {
        generate_return_statement(return_statement, scope, class_information, function_information)
        return true
    }
    var switch_statement = shape.as_switch_statement(statement)
    if switch_statement {
        generate_switch_statement(switch_statement, scope, class_information, function_information)
        return false
    }
    var expression_statement = shape.as_expression_statement(statement)
    if expression_statement {
        generate_expression_statement(expression_statement, scope, class_information)
        return false
    }
    report("unsupported statement kind in this stage")
    return false
}

func constructor_parameter_list(information: Analysis.ClassInfo): String {
    if not information.constructor {
        return "void"
    }
    crash information.constructor
    var parts = List<String>()
    var index = 0
    while index < information.constructor.parameters.count() {
        var parameter = information.constructor.parameters[index]
        var parameter_type = parameter.get_type()
        parts.append("{c_type_name(parameter_type)} {c_value_name(parameter.name)}")
        index = index + 1
    }
    if parts.is_empty() {
        return "void"
    }
    return parts.join(", ")
}

func function_signature(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    return named_signature(information, function, function.c_name)
}

func named_signature(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, c_name: String): String {
    var parts = List<String>()
    var receiver_type = value_class_type(information)
    parts.append("{c_type_name(receiver_type)} self")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.get_type()
        parts.append("{c_type_name(parameter_type)} {c_value_name(parameter.name)}")
        index = index + 1
    }
    var function_return_type = function.get_return_type()
    return "{c_type_name(function_return_type)} {c_name}({parts.join(", ")})"
}

func emit_constructed_allocate(
    information: Analysis.ClassInfo,
    replaced: List<String>,
    allocate_lines: List<String>,
    initialize_lines: List<String>,
): String {
    var c_name = information.c_name
    var constructed_lines = List<String>()
    constructed_lines.append("static void {c_name}___init_constructed({c_name}* self) \{")
    var line_index = 1
    while line_index < initialize_lines.count() {
        var line = initialize_lines[line_index]
        var field_index = 0
        while field_index < information.fields.count() {
            var field = information.fields[field_index]
            if replaced.contains(field.name) and line == "self->{c_value_name(field.name)} = {field.default_value_code};" {
                line = "self->{c_value_name(field.name)} = 0;"
            }
            field_index = field_index + 1
        }
        constructed_lines.append(line)
        line_index = line_index + 1
    }
    var joined_initialize_lines = constructed_lines.join("\n")
    builder.add_support(joined_initialize_lines)
    var joined_allocate_lines = allocate_lines.join("\n")
    var constructed = joined_allocate_lines.replace(
        "{c_name}* {c_name}___allocate(void) \{",
        "static {c_name}* {c_name}___allocate_constructed(void) \{",
    )
    constructed = constructed.replace("{c_name}___init(self);", "{c_name}___init_constructed(self);")
    information.constructed_allocate_position = builder.support_count()
    builder.add_support(constructed)
    return "{c_name}___allocate_constructed"
}

func constructor_replaced_fields(information: Analysis.ClassInfo): List<String> {
    var replaced = List<String>()
    assert information.constructor and not hot_reload and not information.is_singleton
    assert not information.is_value_class
    var parameter_names = information.constructor.parameters.map_name()
    var body = information.constructor.body
    var index = 0
    var leading = true
    while leading and index < body.count() {
        var target = replaced_by_statement(information, body[index], parameter_names)
        leading = not target.is_empty()
        if leading and not replaced.contains(target) {
            var field = information.find_field(target)
            crash field
            var field_type = field.get_type()
            var visiting = List<String>()
            if type_needs_drop(field_type) and pure_construction_code(field.default_value_code, visiting) {
                replaced.append(target)
            }
        }
        index = index + 1
    }
    return replaced
}

func replaced_by_statement(
    information: Analysis.ClassInfo,
    statement: Syntax.Statements.Statement,
    parameter_names: List<String>,
): String {
    var assignment = shape.as_assignment_statement(statement)
    assert assignment
    crash assignment.target
    crash assignment.value
    var target = shape.as_identifier(assignment.target)
    assert target
    assert information.find_field(target.name) and not parameter_names.contains(target.name)
    assert constant_or_parameter(assignment.value, parameter_names)
    return target.name
}

func constant_or_parameter(value: Syntax.Expressions.Expression, parameter_names: List<String>): Boolean {
    var identifier = shape.as_identifier(value)
    if identifier {
        return parameter_names.contains(identifier.name)
    }
    if shape.as_string_literal(value) or shape.as_integer_literal(value) or shape.as_float_literal(value) {
        return true
    }
    return shape.is_true_literal(value) or shape.is_false_literal(value) or shape.is_null_literal(value)
}

func pure_construction_code(code: String, visiting: List<String>): Boolean {
    var opening = code.index_of("(")
    assert opening > 0 and code.ends_with(")")
    var code_length = code.length()
    var callee = code.slice(0, opening)
    var arguments = code.slice(opening + 1, code_length - 1)
    assert callee.ends_with("___make") and (arguments.is_empty() or constant_arguments(arguments))
    var callee_length = callee.length()
    var class_c_name = callee.slice(0, callee_length - 7)
    return pure_class(class_c_name, visiting)
}

func constant_arguments(arguments: String): Boolean {
    assert not arguments.is_empty()
    var parts = arguments.split(", ")
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        assert constant_texts.has(part) or constant_number(part)
        index = index + 1
    }
    return true
}

func constant_number(part: String): Boolean {
    var index = 0
    while index < part.length() {
        var code = part.code_at(index)
        var digit = code >= 48 and code <= 57
        assert digit or code == 45 or code == 46
        index = index + 1
    }
    return not part.is_empty()
}

func pure_class(class_c_name: String, visiting: List<String>): Boolean {
    assert not visiting.contains(class_c_name)
    visiting.append(class_c_name)
    var information = find_class_by_c_name(class_c_name)
    assert information
    if information.qualified_dotted == "List" or information.qualified_dotted == "Dictionary" {
        return true
    }
    assert not information.is_singleton and not information.drop_function and not information.is_value_class
    assert not is_hot_class(information) and not information.is_generic_template
    if information.constructor {
        var parameter_names = information.constructor.parameters.map_name()
        var index = 0
        while index < information.constructor.body.count() {
            var target = replaced_by_statement(information, information.constructor.body[index], parameter_names)
            assert not target.is_empty()
            index = index + 1
        }
    }
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        var field_type = field.get_type()
        if type_needs_drop(field_type) {
            assert pure_construction_code(field.default_value_code, visiting) or constant_text_code(field.default_value_code)
        } else {
            assert constant_scalar_code(field.default_value_code)
        }
        field_index = field_index + 1
    }
    return true
}

func constant_text_code(code: String): Boolean {
    return constant_texts.has(code) or code == "0"
}

func constant_scalar_code(code: String): Boolean {
    var index = 0
    var name_start = 0
    while index < code.length() {
        var code_point = code.code_at(index)
        var letter = code_point >= 65 and code_point <= 90 or code_point >= 97 and code_point <= 122 or code_point == 95
        var digit = code_point >= 48 and code_point <= 57
        if code_point == 40 {
            var called = code.slice(name_start, index)
            assert called.is_empty() or called.starts_with("Spite") and called.contains("_from_")
        }
        if not letter and not digit {
            name_start = index + 1
        }
        index = index + 1
    }
    return true
}

func emit_class_prototypes(information: Analysis.ClassInfo) {
    builder.add_prototype("void {information.c_name}___init({information.c_name}* self);")
    builder.add_prototype("{information.c_name}* {information.c_name}___allocate(void);")
    builder.add_prototype("{information.c_name}* {information.c_name}___default(void);")
    builder.add_prototype(
        "{information.c_name}* {information.c_name}___make({constructor_parameter_list(information)});",
    )
    builder.add_prototype("{information.c_name}* {information.c_name}___retain({information.c_name}* self);")
    builder.add_prototype("void {information.c_name}___release({information.c_name}* self);")
    if not information.find_function("copy") {
        builder.add_prototype("{information.c_name}* {information.c_name}_copy({information.c_name}* self);")
    }
    if information.drop_function {
        builder.add_prototype("void {information.drop_function.c_name}({information.c_name}* self);")
    }
    var function_index = 0
    while function_index < information.functions.count() {
        if not is_inline_supplied(information.functions[function_index]) {
            builder.add_prototype("{function_signature(information, information.functions[function_index])};")
        }
        function_index = function_index + 1
    }
}

func emit_class_support(information: Analysis.ClassInfo) {
    var class_id_text = "{information.class_id}"
    var initialize_lines = List<String>()
    var initialize_name = "{information.c_name}___init"
    if is_hot_class(information) {
        initialize_name = "{information.c_name}___init___hot"
        add_hot_initialize_slot(information)
    }
    initialize_lines.append("void {initialize_name}({information.c_name}* self) \{")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        initialize_lines.append("self->{c_value_name(field.name)} = {field.default_value_code};")
        field_index = field_index + 1
    }
    if information.c_name == "Spite_Class" {}
    if information.c_name == "Spite_Function" {
        initialize_lines.append("self->spite_owner = 0;")
        initialize_lines.append("self->spite_release_owner = 0;")
        initialize_lines.append("self->spite_call = 0;")
        initialize_lines.append("self->spite_typed_call = 0;")
        initialize_lines.append("self->spite_text_call = 0;")
        initialize_lines.append("self->spite_add_arguments = 0;")
        initialize_lines.append("self->spite_arguments_lock = 0;")
    }
    if information.c_name == "Spite_Attribute" {
        var cleared_links = hidden_attribute_links_cleared("self")
        initialize_lines.append(cleared_links)
    }
    initialize_lines.append("}")
    var joined_initialize_lines = initialize_lines.join("\n")
    builder.add_support(joined_initialize_lines)
    if information.c_name == "Spite_Function" {
        builder.add_prototype("static void spite_function_arguments_described(Spite_Function* self);")
        builder.add_support(
            "static void spite_function_arguments_described(Spite_Function* self) \{\nif (SPITE_SINGLETON_FOUND(self->spite_add_arguments) == 0) return;\nSPITE_LOCK(self->spite_arguments_lock);\nvoid (*adding)(Spite_Function*) = self->spite_add_arguments;\nif (adding != 0) \{\nadding(self);\nSPITE_SINGLETON_PUBLISH(self->spite_add_arguments, (void (*)(Spite_Function*))0);\n}\nSPITE_UNLOCK(self->spite_arguments_lock);\n}",
        )
    }
    var allocate_lines = List<String>()
    allocate_lines.append("{information.c_name}* {information.c_name}___allocate(void) \{")
    allocate_lines.append(
        "{information.c_name}* self = ({information.c_name}*)SPITE_MALLOC(sizeof({information.c_name}));",
    )
    allocate_lines.append("self->header.ref_count = 1;")
    allocate_lines.append("self->header.class_id = {class_id_text};")
    if debug_memory {
        allocate_lines.append("#ifdef SPITE_DEBUG_MEMORY")
        allocate_lines.append("spite_debug_register_object(self, {class_id_text});")
        allocate_lines.append("#endif")
    }
    allocate_lines.append("{information.c_name}___init(self);")
    allocate_lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    allocate_lines.append("spite_track_{information.c_name}(self);")
    allocate_lines.append("#endif")
    allocate_lines.append("return self;")
    allocate_lines.append("}")
    var joined_allocate_lines = allocate_lines.join("\n")
    information.allocate_position = builder.support_count()
    builder.add_support(joined_allocate_lines)
    var default_instance = "{information.c_name}___allocate()"
    if information.is_stateless_singleton {
        default_instance = singleton_call(information)
    }
    builder.add_support("{information.c_name}* {information.c_name}___default(void) \{ return {default_instance}; }")
    var allocating = "{information.c_name}___allocate"
    var replaced = constructor_replaced_fields(information)
    if not replaced.is_empty() {
        allocating = emit_constructed_allocate(information, replaced, allocate_lines, initialize_lines)
    }
    var make_lines = List<String>()
    make_lines.append("{information.c_name}* {information.c_name}___make({constructor_parameter_list(information)}) \{")
    make_lines.append("{information.c_name}* self = {allocating}();")
    if information.constructor {
        var arguments = c_parameter_names(information.constructor.parameters)
        arguments.prepend("self")
        make_lines.append("{information.constructor.c_name}({arguments.join(", ")});")
    }
    make_lines.append("return self;")
    make_lines.append("}")
    var joined_make_lines = make_lines.join("\n")
    builder.add_support(joined_make_lines)
    if information.is_stateless_singleton {
        builder.add_support(
            "{information.c_name}* {information.c_name}___retain({information.c_name}* self) \{ return self; }",
        )
        builder.add_support("void {information.c_name}___release({information.c_name}* self) \{ (void)self; }")
        builder.add_support(
            "{information.c_name}* {information.c_name}_copy({information.c_name}* self) \{ return self; }",
        )
        return
    }
    var release_lines = List<String>()
    var retain_body = "if (self != 0) SPITE_COUNT_UP(self->header.ref_count); return self;"
    var release_name = "release"
    if information.is_singleton {
        retain_body = "return self;"
        release_name = "discard"
        builder.add_support("void {information.c_name}___release({information.c_name}* self) \{ (void)self; }")
        builder.add_prototype("void {information.c_name}___destroy({information.c_name}* self);")
        builder.add_prototype("void {information.c_name}___discard({information.c_name}* self);")
        var destroyed = singleton_destroyed(information)
        builder.add_support(destroyed)
    }
    builder.add_support(
        "{information.c_name}* {information.c_name}___retain({information.c_name}* self) \{ {retain_body} }",
    )
    release_lines.append("void {information.c_name}___{release_name}({information.c_name}* self) \{")
    release_lines.append("if (self == 0) return;")
    if not information.is_singleton {
        release_lines.append("if (SPITE_COUNT_DOWN(self->header.ref_count) > 0) return;")
        if information.drop_function {
            release_lines.append("{information.drop_function.c_name}(self);")
        }
    }
    var drop_field_index = 0
    while drop_field_index < information.fields.count() {
        var field = information.fields[drop_field_index]
        var field_type = field.get_type()
        if type_needs_drop(field_type) {
            release_lines.append("{release_call(field_type, "self->{c_value_name(field.name)}")};")
        }
        drop_field_index = drop_field_index + 1
    }
    if information.c_name == "Spite_Function" {
        release_lines.append(
            "if (self->spite_owner != 0 && self->spite_release_owner != 0) self->spite_release_owner(self->spite_owner);",
        )
    }
    if information.c_name == "Spite_Attribute" {
        release_lines.append(
            "if (self->spite_owner != 0 && self->spite_release_owner != 0) self->spite_release_owner(self->spite_owner);",
        )
        release_lines.append(
            "if (self->spite_held != 0 && self->spite_release_held != 0) self->spite_release_held(self->spite_held);",
        )
    }
    release_lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    release_lines.append("spite_untrack_{information.c_name}(self);")
    release_lines.append("#endif")
    release_lines.append("#ifdef SPITE_WEAK_{information.c_name}")
    release_lines.append("spite_weak_object_freed(self);")
    release_lines.append("#endif")
    release_lines.append("SPITE_FREE(self);")
    release_lines.append("}")
    var joined_release_lines = release_lines.join("\n")
    information.release_position = builder.support_count()
    builder.add_support(joined_release_lines)
    assert not information.find_function("copy")
    if information.is_singleton {
        builder.add_support(
            "{information.c_name}* {information.c_name}_copy({information.c_name}* self) \{ return {information.c_name}___retain(self); }",
        )
        return
    }
    var copy_lines = List<String>()
    copy_lines.append("{information.c_name}* {information.c_name}_copy({information.c_name}* self) \{")
    copy_lines.append(
        "{information.c_name}* spite_copy = ({information.c_name}*)SPITE_MALLOC(sizeof({information.c_name}));",
    )
    copy_lines.append("spite_copy->header.ref_count = 1;")
    copy_lines.append("spite_copy->header.class_id = {class_id_text};")
    if debug_memory {
        copy_lines.append("#ifdef SPITE_DEBUG_MEMORY")
        copy_lines.append("spite_debug_register_object(spite_copy, {class_id_text});")
        copy_lines.append("#endif")
    }
    if information.c_name == "Spite_Function" {
        copy_lines.append("spite_function_arguments_described(self);")
    }
    var copy_field_index = 0
    while copy_field_index < information.fields.count() {
        var field = information.fields[copy_field_index]
        var value_code = "self->{c_value_name(field.name)}"
        var field_type = field.get_type()
        if type_needs_drop(field_type) {
            value_code = retain_call(field_type, value_code)
        }
        copy_lines.append("spite_copy->{c_value_name(field.name)} = {value_code};")
        copy_field_index = copy_field_index + 1
    }
    if information.c_name == "Spite_Function" {
        copy_lines.append(
            "spite_copy->spite_owner = 0; spite_copy->spite_release_owner = 0; spite_copy->spite_call = 0; spite_copy->spite_typed_call = 0; spite_copy->spite_text_call = 0; spite_copy->spite_add_arguments = 0; spite_copy->spite_arguments_lock = 0;",
        )
    }
    if information.c_name == "Spite_Attribute" {
        var cleared_links = hidden_attribute_links_cleared("spite_copy")
        copy_lines.append(cleared_links)
    }
    copy_lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    copy_lines.append("spite_track_{information.c_name}(spite_copy);")
    copy_lines.append("#endif")
    copy_lines.append("return spite_copy;")
    copy_lines.append("}")
    var joined_copy_lines = copy_lines.join("\n")
    information.copy_position = builder.support_count()
    builder.add_support(joined_copy_lines)
}

func emit_user_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    assert not function.is_emitted
    function.is_emitted = true
    if is_inline_supplied(function) {
        builder.add_typedef(function.supplied_body)
        return
    }
    if not function.has_body {
        builder.add_user("{function_signature(information, function)} \{\n{function.supplied_body}\n}")
        return
    }
    site_ordinal = 0
    frame_candidates.clear()
    placed_names.clear()
    placed_frames.clear()
    placed_receiver_names.clear()
    placed_receiver_codes.clear()
    current_class = information
    current_function = function.name
    current_line = function.line
    current_path = information.source_path
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    bind_symbol_of(function)
    var waiting = waiting_kind(information, function)
    if not waiting.is_empty() {
        waiting_classes.append(information)
        waiting_functions.append(function)
        waiting_kinds.append(waiting)
        var user_count = builder.user_count()
        waiting_positions.append(user_count)
    }
    atomic_fields = List<String>()
    atomic_owner = information.c_name
    if atomic_function(information, function) {
        atomic_fields = atomic_singleton_fields(information)
        if not atomic_class_names.contains(information.c_name) {
            atomic_class_names.append(information.c_name)
            atomic_classes.append(information)
        }
    }
    var guarded = guards_singleton(information, function)
    if guarded {
        guarded_classes.append(information)
        guarded_functions.append(function)
        var guarded_at = builder.user_count()
        guarded_positions.append(guarded_at)
    }
    current_function_c_name = function.c_name
    borrowed_names = List<String>()
    if not guarded and not function.is_constructor and not is_hot_class(information) and waiting.is_empty() {
        machine_candidate_names.append(function.c_name)
        machine_candidate_classes.append(information)
        machine_candidate_functions.append(function)
    }
    var defined_name = function.c_name
    if is_hot_class(information) {
        defined_name = "{function.c_name}___hot"
        add_hot_slot(information, function)
    }
    builder.add_user("{named_signature(information, function, defined_name)} \{")
    if function.c_name == "Spite_Function_get_arguments" {
        builder.add_user("spite_function_arguments_described(self);")
    }
    var scope = parameter_scope(function)
    terminal_if = terminal_if_of(function.body)
    body_narrowed_names = List<String>()
    body_assigned_paths = List<String>()
    collect_body_facts(function.body)
    var ended_in_return = generate_statement_list(function.body, scope, information, function)
    terminal_if = null
    report_unused(scope)
    if not ended_in_return {
        emit_scope_drops(scope, true)
        var function_return_type = function.get_return_type()
        if not type_shape.is_void(function_return_type) {
            builder.add_user("return {default_value_for_type(function_return_type)};")
        }
    }
    close_rebindings(scope)
    builder.add_user("}")
    if guarded {
        var guarded_end = builder.user_count()
        guarded_ends.append(guarded_end)
    }
}

func parameter_scope(function: Analysis.FunctionInfo): Scope {
    var scope = Scope(null)
    arguments_parameter_names.clear()
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        var parameter = function.parameters[parameter_index]
        var parameter_type = parameter.get_type()
        if type_shape.is_arguments(parameter_type) {
            arguments_parameter_names.append(parameter.name)
        }
        if type_needs_drop(parameter_type) {
            scope.declare_owned(parameter.name, parameter_type)
        } else {
            scope.declare(parameter.name, parameter_type)
        }
        if not signature_is_dictated(function) {
            scope.check_last_parameter(current_line)
        }
        parameter_index = parameter_index + 1
    }
    return scope
}

func emit_class(information: Analysis.ClassInfo) {
    assert not information.is_emitted
    information.is_emitted = true
    current_owner = information.qualified_dotted
    if information.is_value_class {
        emit_value_class(information)
        return
    }
    var struct_lines = List<String>()
    struct_lines.append("struct {information.c_name} \{")
    struct_lines.append("SpiteHeader header;")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        var field_type = field.get_type()
        struct_lines.append("{c_type_name(field_type)} {c_value_name(field.name)};")
        field_index = field_index + 1
    }
    if information.c_name == "Spite_Class" {}
    if information.c_name == "Spite_Function" {
        struct_lines.append("void* spite_owner;")
        struct_lines.append("void (*spite_release_owner)(void*);")
        struct_lines.append("void (*spite_call)(void*);")
        struct_lines.append("void* spite_typed_call;")
        struct_lines.append("void* spite_text_call;")
        struct_lines.append("void (*spite_add_arguments)(Spite_Function*);")
        struct_lines.append("int32_t spite_arguments_lock;")
    }
    if information.c_name == "Spite_Attribute" {
        struct_lines.append("void* spite_owner;")
        struct_lines.append("void (*spite_release_owner)(void*);")
        struct_lines.append("bool (*spite_assign)(void*, SpiteString*);")
        struct_lines.append("void* spite_held;")
        struct_lines.append("void (*spite_release_held)(void*);")
        struct_lines.append("void* (*spite_held_attributes)(void*);")
        struct_lines.append("void* (*spite_held_functions)(void*);")
    }
    struct_lines.append("};")
    var joined_struct_lines = struct_lines.join("\n")
    information.struct_position = builder.typedef_count()
    builder.add_typedef(joined_struct_lines)
    emit_class_prototypes(information)
    emit_class_support(information)
    assert not information.is_instantiated
    var function_index = 0
    while function_index < information.functions.count() {
        emit_user_function(information, information.functions[function_index])
        function_index = function_index + 1
    }
}

func emit_value_class(information: Analysis.ClassInfo) {
    var declares_only_memory = information.fields.count() == 1 and information.fields[0].name == "_memory"
    if information.qualified_dotted != "String" and not information.fields.is_empty() and not declares_only_memory {
        current_path = information.source_path
        report(
            "'{information.simple_name}' is a value the compiler keeps in one piece of memory, so it declares only that memory, 'var heap = Memory.Heap()' and then 'var _memory = heap.allocate(bytes)': keep what a function needs in its locals",
        )
        return
    }
    var function_index = 0
    while function_index < information.functions.count() {
        if not is_inline_supplied(information.functions[function_index]) {
            builder.add_prototype("{function_signature(information, information.functions[function_index])};")
        }
        function_index = function_index + 1
    }
    function_index = 0
    while function_index < information.functions.count() {
        emit_user_function(information, information.functions[function_index])
        function_index = function_index + 1
    }
    if information.c_name == "SpiteString" {
        emit_string_support(information)
    }
}

func emit_string_support(information: Analysis.ClassInfo) {
    current_path = information.source_path
    current_owner = "String"
    current_function = ""
    var constructor_parameters = constructor_parameter_list(information)
    var unshared = information.find_function("_unshared")
    var append_in_place = information.find_function("_append_in_place")
    crash unshared
    crash append_in_place
    var address_class = find_class_by_qualified("Memory.Address")
    crash address_class
    var address_text = address_class.find_function("text")
    crash address_text
    builder.add_prototype("void SpiteString___init(SpiteString* self);")
    builder.add_prototype("SpiteString* SpiteString___allocate(void);")
    builder.add_prototype("SpiteString* SpiteString___make({constructor_parameters});")
    builder.add_prototype("SpiteString* SpiteString___retain(SpiteString* self);")
    builder.add_prototype("void SpiteString___release(SpiteString* self);")
    builder.add_prototype("SpiteString* SpiteString_append(SpiteString* left, SpiteString* right);")
    builder.add_prototype("SpiteString* spite_string_from_bytes(const char* bytes, int64_t length);")
    builder.add_prototype("SpiteString* spite_string_from_cstring_owned(const char* text);")
    builder.add_prototype("SpiteString* spite_string_join(int32_t count, SpiteString* const* pieces);")
    builder.add_prototype("static int64_t spite_long_digits(char* digits, int64_t value);")
    builder.add_support(
        "static int64_t spite_long_digits(char* digits, int64_t value) \{\nchar reversed[24];\nint64_t count = 0;\nuint64_t rest = value < 0 ? (uint64_t)0 - (uint64_t)value : (uint64_t)value;\ndo \{ reversed[count] = (char)('0' + rest % 10); count = count + 1; rest = rest / 10; } while (rest != 0);\nint64_t length = 0;\nif (value < 0) \{ digits[0] = '-'; length = 1; }\nwhile (count > 0) \{ count = count - 1; digits[length] = reversed[count]; length = length + 1; }\nreturn length;\n}",
    )
    var initialize_lines = List<String>()
    initialize_lines.append("void SpiteString___init(SpiteString* self) \{")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        initialize_lines.append("self->{c_value_name(field.name)} = {field.default_value_code};")
        field_index = field_index + 1
    }
    initialize_lines.append("}")
    var joined_initialize_lines = initialize_lines.join("\n")
    builder.add_support(joined_initialize_lines)
    var registered = debug_registration("self", "{information.class_id}")
    builder.add_support(
        "SpiteString* SpiteString___allocate(void) \{\nSpiteString* self = (SpiteString*)SPITE_MALLOC(sizeof(SpiteString));\nself->header.ref_count = 1;\nself->header.class_id = {information.class_id};\n{registered}SpiteString___init(self);\nreturn self;\n}",
    )
    crash information.constructor
    var arguments = c_parameter_names(information.constructor.parameters)
    arguments.prepend("self")
    builder.add_support(
        "SpiteString* SpiteString___make({constructor_parameters}) \{\nSpiteString* self = SpiteString___allocate();\n{information.constructor.c_name}({arguments.join(", ")});\nreturn self;\n}",
    )
    builder.add_support(
        "SpiteString* SpiteString___retain(SpiteString* self) \{\nif (self != 0 && self->_section_ != Spite_Memory_Section_constant) SPITE_COUNT_UP(self->header.ref_count);\nreturn self;\n}",
    )
    crash information.drop_function
    builder.add_support(
        "void SpiteString___release(SpiteString* self) \{\nif (self == 0 || self->_section_ == Spite_Memory_Section_constant) return;\nif (SPITE_COUNT_DOWN(self->header.ref_count) > 0) return;\n{information.drop_function.c_name}(self);\nSPITE_FREE(self);\n}",
    )
    builder.add_support(
        "SpiteString* SpiteString_append(SpiteString* left, SpiteString* right) \{\nif (left->_section_ == Spite_Memory_Section_constant || left->header.ref_count != 1) \{\nSpiteString* alone = {unshared.c_name}(left);\nSpiteString___release(left);\nleft = alone;\n}\n{append_in_place.c_name}(left, SpiteString___retain(right));\nreturn left;\n}",
    )
    builder.add_support(
        "SpiteString* spite_string_from_bytes(const char* bytes, int64_t length) \{\nreturn {address_text.c_name}((int64_t)(intptr_t)bytes, length);\n}",
    )
    builder.add_support(
        "SpiteString* spite_string_from_cstring_owned(const char* text) \{\nreturn spite_string_from_bytes(text, (int64_t)strlen(text));\n}",
    )
    builder.add_support(
        "SpiteString* spite_string_join(int32_t count, SpiteString* const* pieces) \{\nint64_t total = 0;\nfor (int32_t index = 0; index < count; index++) total += pieces[index]->_length_;\nchar* bytes = (char*)SPITE_MALLOC((size_t)total + 1);\nint64_t at = 0;\nfor (int32_t index = 0; index < count; index++) \{\nmemcpy(bytes + at, (const char*)(intptr_t)pieces[index]->_bytes_, (size_t)pieces[index]->_length_);\nat += pieces[index]->_length_;\n}\nreturn SpiteString___make((int64_t)(intptr_t)bytes, total);\n}",
    )
}

func declared_memory_bytes(
    declaration: Syntax.Statements.VariableDeclaration,
    information: Analysis.ClassInfo,
): Integer {
    crash declaration.value
    var allocation = shape.as_call(declaration.value)
    if allocation {
        crash allocation.callee
        var allocating = shape.as_member(allocation.callee)
        if allocating {
            crash allocating.object
            var memory = shape.as_identifier(allocating.object)
            var through_memory = false
            if memory {
                through_memory = memory.name == information.memory_binding
            }
            if allocating.name == "allocate" and through_memory and allocation.arguments.count() == 1 {
                var bytes = shape.as_integer_literal(allocation.arguments[0])
                if bytes {
                    return bytes.value
                }
            }
        }
    }
    report(
        "a number declares its memory as 'var heap = Memory.Heap()' and then 'var _memory = heap.allocate(bytes)', with the bytes written out: the compiler places that memory, and a number's is a register",
    )
    return 0
}

func scalar_c_bytes(c_type: String): Integer {
    if c_type == "int8_t" or c_type == "uint8_t" or c_type == "bool" {
        return 1
    }
    if c_type == "int16_t" or c_type == "uint16_t" {
        return 2
    }
    if c_type == "int32_t" or c_type == "uint32_t" or c_type == "float" {
        return 4
    }
    return 8
}

func check_number_memory() {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if information.is_value_class and information.c_name != "SpiteString" {
            current_path = information.source_path
            current_line = 1
            if not information.memory_path.is_empty() {
                current_path = information.memory_path
                current_line = information.memory_line
            }
            current_owner = information.qualified_dotted
            current_function = "_memory"
            var number_type = value_class_type(information)
            var c_type = c_type_name(number_type)
            var laid_out = scalar_c_bytes(c_type)
            if not information.find_field("_memory") {
                report(
                    "'{information.simple_name}' declares no memory: its file says what it is with 'var heap = Memory.Heap()' and then 'var _memory = heap.allocate({laid_out})', the {laid_out} bytes the compiler keeps it in",
                )
            } else if information.memory_bytes != laid_out {
                report(
                    "'{information.simple_name}' declares {information.memory_bytes} bytes of memory, and the compiler lays it out as {c_type}, which is {laid_out}",
                )
            }
        }
        index = index + 1
    }
}

func string_layout(): String {
    var string_class = find_class_by_c_name("SpiteString")
    crash string_class
    current_path = string_class.source_path
    current_owner = "String"
    current_function = ""
    var storage = ["_bytes", "_length", "_section"]
    var storage_types = ["int64_t", "int64_t", "Spite_Memory_Section"]
    var storage_index = 0
    while storage_index < storage.count() {
        var name = storage[storage_index]
        var wanted = storage_types[storage_index]
        var field = string_class.find_field(name)
        var declared = ""
        if field {
            var field_type = field.get_type()
            declared = c_type_name(field_type)
        }
        if declared != wanted {
            report(
                "library/string.spite declares the memory a String holds, and needs '_bytes: Long' (the address of its characters), '_length: Long' and '_section: Spite.Memory.Section' (where the compiler placed them): '{name}' is missing or has another type",
            )
        }
        storage_index = storage_index + 1
    }
    var lines = List<String>()
    lines.append("struct SpiteString \{")
    lines.append("SpiteHeader header;")
    var field_index = 0
    while field_index < string_class.fields.count() {
        var field = string_class.fields[field_index]
        var field_type = field.get_type()
        lines.append("{c_type_name(field_type)} {c_value_name(field.name)};")
        field_index = field_index + 1
    }
    lines.append("};")
    lines.append(
        "#define SPITE_STATIC_STRING(text, length) \{ .header = \{ 0, -1 }, ._bytes_ = (int64_t)(intptr_t)(text), ._length_ = (length), ._section_ = Spite_Memory_Section_constant }",
    )
    lines.append("static SpiteString spite_static_string_empty = SPITE_STATIC_STRING(\"\", 0);")
    return lines.join("\n")
}

func written_string_function(name: String): Analysis.FunctionInfo? {
    var string_class = find_class_by_c_name("SpiteString")
    if string_class {
        if string_class.is_value_class {
            return string_class.find_function(name)
        }
    }
    return null
}

func debug_memory_class_name_table(): String {
    var names = List<String>()
    var index = 0
    while index < class_names_by_id.count() {
        names.append("\"{class_names_by_id[index]}\"")
        index = index + 1
    }
    return "\{ {names.join(", ")} }"
}

func is_library_class(information: Analysis.ClassInfo): Boolean {
    return information.source_path.starts_with("library/") or information.source_path.starts_with("launcher/")
}

func waiting_kind(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var owner = information.qualified_dotted
    var name = function.name
    if owner == "Program" and name == "sleep" {
        return "sleep"
    }
    if owner == "ThreadPool" and name == "join" {
        return "yield"
    }
    if owner == "Scheduler" and name == "wait_for" {
        return "join"
    }
    var reads = owner == "Console" and name == "read_line_into"
    var receives = owner == "Socket" and (name == "accept_handle" or name == "receive_into")
    var files = owner == "File" and (name == "read_into" or name == "write_text" or name == "write_from")
    if reads or receives or files {
        return "offload"
    }
    return ""
}

func guards_singleton(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    assert information.is_singleton and not information.is_stateless_singleton and not is_library_class(information)
    assert not function.is_constructor and function.name != "drop" and not function.body.is_empty()
    assert not is_hot_class(information)
    var atomic = atomic_singleton_fields(information)
    assert atomic.is_empty()
    return changes_after_construction(information)
}

func atomic_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    assert information.is_singleton and not information.is_stateless_singleton and not is_library_class(information)
    assert not function.is_constructor and function.name != "drop" and not function.body.is_empty()
    assert not is_hot_class(information)
    var atomic = atomic_singleton_fields(information)
    return not atomic.is_empty()
}

func changes_after_construction(information: Analysis.ClassInfo): Boolean {
    if written_from_outside(information) {
        return true
    }
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.get_type()
        if shares_state(field_type) {
            return true
        }
        index = index + 1
    }
    var targets = List<String>()
    index = 0
    while index < information.functions.count() {
        var function = information.functions[index]
        if not function.is_constructor {
            collect_assigned_roots(function.body, targets)
        }
        index = index + 1
    }
    index = 0
    while index < targets.count() {
        if information.find_field(targets[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func collect_assigned_roots(statements: List<Syntax.Statements.Statement>, roots: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_statement_assigned_roots(statements[index], roots)
        index = index + 1
    }
}

func collect_statement_assigned_roots(statement: Syntax.Statements.Statement, roots: List<String>) {
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            var target_text = operand_text(statement.target)
            var dot = target_text.index_of(".")
            var bracket = target_text.index_of("[")
            var end = target_text.length()
            if dot >= 0 {
                end = dot
            }
            if bracket >= 0 and bracket < end {
                end = bracket
            }
            var root = target_text.slice(0, end)
            roots.append(root)
        }
        Syntax.Statements.IfStatement: {
            collect_assigned_roots(statement.then_branch, roots)
            collect_assigned_roots(statement.else_branch, roots)
        }
        Syntax.Statements.WhileStatement: collect_assigned_roots(statement.body, roots)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_assigned_roots(statement.cases[case_index].body, roots)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func finish_singleton_guards() {
    builder.add_typedef("typedef struct SpiteGuard \{ _Alignas(64) int64_t owner; int64_t depth; } SpiteGuard;")
    builder.add_prototype("static void spite_guard_enter(SpiteGuard* guard);")
    builder.add_prototype("static void spite_guard_leave(SpiteGuard* guard);")
    builder.add_support(
        "static SPITE_THREAD_LOCAL char spite_guard_thread;\nstatic void spite_guard_enter(SpiteGuard* guard) \{\nint64_t spite_me = (int64_t)(intptr_t)&spite_guard_thread;\nif (__atomic_load_n(&guard->owner, __ATOMIC_ACQUIRE) == spite_me) \{ guard->depth = guard->depth + 1; return; }\nint64_t spite_free = 0;\nwhile (!__atomic_compare_exchange_n(&guard->owner, &spite_free, spite_me, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) \{ spite_free = 0; }\nguard->depth = 1;\n}\nstatic void spite_guard_leave(SpiteGuard* guard) \{\nguard->depth = guard->depth - 1;\nif (guard->depth == 0) __atomic_store_n(&guard->owner, 0, __ATOMIC_RELEASE);\n}",
    )
    var guarded_names = List<String>()
    var wrapped = List<Integer>()
    var reached = call_effects.thread_reached_classes()
    var index = 0
    while index < guarded_functions.count() {
        var information = guarded_classes.get_at(index)
        var function = guarded_functions[index]
        var position = guarded_positions.get_at(index)
        if reached.has(information.simple_name) or called_implicitly(information) {
            if not guarded_names.contains(information.c_name) {
                guarded_names.append(information.c_name)
                builder.add_support("static SpiteGuard {information.c_name}___guard = \{ 0, 0 };")
            }
            var unguarded_name = "{function.c_name}___unguarded"
            var unguarded_signature = named_signature(information, function, unguarded_name)
            builder.replace_user(position, "{unguarded_signature} \{")
            builder.add_prototype("{unguarded_signature};")
            emit_guard_wrapper(information, function, unguarded_name)
            wrapped.append(index)
        }
        index = index + 1
    }
    emitted_guards = guarded_names
    call_unguarded_inside(wrapped)
}

func call_unguarded_inside(wrapped: List<Integer>) {
    var index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        var information = guarded_classes.get_at(position)
        var line_index = guarded_positions.get_at(position) + 1
        var end = guarded_ends.get_at(position)
        while line_index < end {
            var line = builder.user_at(line_index)
            var changed = unguarded_calls(line, information, wrapped)
            if changed != line {
                builder.replace_user(line_index, changed)
            }
            line_index = line_index + 1
        }
        index = index + 1
    }
}

func unguarded_calls(line: String, information: Analysis.ClassInfo, wrapped: List<Integer>): String {
    var result = line
    var index = 0
    while index < wrapped.count() {
        var position = wrapped[index]
        var owner = guarded_classes.get_at(position)
        if owner.c_name == information.c_name {
            var called = guarded_functions.get_at(position)
            result = replace_call(result, "{called.c_name}(self,", "{called.c_name}___unguarded(self,")
            result = replace_call(result, "{called.c_name}(self)", "{called.c_name}___unguarded(self)")
        }
        index = index + 1
    }
    return result
}

func replace_call(line: String, from: String, to: String): String {
    var pieces = line.split(from)
    var result = pieces.get_at(0)
    var index = 1
    while index < pieces.count() {
        var before = pieces.get_at(index - 1)
        var last_position = before.length() - 1
        var last = before.code_at(last_position)
        var joins_a_name = last >= 97 and last <= 122 or last >= 65 and last <= 90 or last >= 48 and last <= 57 or last == 95
        if not before.is_empty() and joins_a_name {
            result = result + from
        } else {
            result = result + to
        }
        var piece = pieces.get_at(index)
        result = result + piece
        index = index + 1
    }
    return result
}

func atomic_singleton_fields(information: Analysis.ClassInfo): List<String> {
    var mutable = List<String>()
    var singleton = information.is_singleton and not information.is_stateless_singleton
    assert singleton and not is_library_class(information) and not is_hot_class(information)
    assert not written_from_outside(information)
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.get_type()
        if shares_state(field_type) {
            return List<String>()
        }
        index = index + 1
    }
    var targets = List<String>()
    index = 0
    while index < information.functions.count() {
        var function = information.functions[index]
        if not function.is_constructor {
            collect_assigned_roots(function.body, targets)
        }
        index = index + 1
    }
    index = 0
    while index < targets.count() {
        var target = targets[index]
        var field = information.find_field(target)
        if field and not mutable.contains(target) {
            var field_type = field.get_type()
            if not is_atomic_capable(field_type) {
                return List<String>()
            }
            mutable.append(target)
        }
        index = index + 1
    }
    index = 0
    while index < information.functions.count() {
        var function = information.functions[index]
        if not function.is_constructor and function.name != "drop" {
            var visiting = List<String>()
            if function_state_uses(information, function, mutable, visiting) > 1 {
                return List<String>()
            }
        }
        index = index + 1
    }
    return mutable
}

func is_atomic_capable(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    assert scalar
    var kind = scalar.kind
    var signed = kind == 'integer_kind' or kind == 'long_kind' or kind == 'tiny_kind' or kind == 'short_kind'
    var unsigned = kind == 'byte_kind' or kind == 'unsigned_short_kind' or kind == 'unsigned_integer_kind'
    return signed or unsigned or kind == 'unsigned_long_kind' or kind == 'boolean_kind'
}

func function_state_uses(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    if visiting.contains(function.name) {
        return 2
    }
    var names = List<String>()
    collect_declared_names(function.body, names)
    var index = 0
    while index < function.parameters.count() {
        names.append(function.parameters[index].name)
        index = index + 1
    }
    index = 0
    while index < names.count() {
        if mutable.contains(names[index]) {
            return 2
        }
        index = index + 1
    }
    var inner = visiting.copy()
    inner.append(function.name)
    return block_state_uses(function.body, information, mutable, inner)
}

func block_state_uses(
    statements: List<Syntax.Statements.Statement>,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    var total = 0
    var index = 0
    while index < statements.count() {
        var uses = statement_state_uses(statements[index], information, mutable, visiting)
        total = total + uses
        index = index + 1
    }
    return total
}

func statement_state_uses(
    statement: Syntax.Statements.Statement,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    switch statement {
        Syntax.Statements.VariableDeclaration: return optional_state_uses(statement.value, information, mutable, visiting)
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var target = shape.as_identifier(statement.target)
            if target {
                if mutable.contains(target.name) {
                    var stored = stored_value(statement.value, target.name)
                    var value_uses = expression_state_uses(stored, information, mutable, visiting)
                    return 1 + value_uses
                }
            }
            var target_uses = expression_state_uses(statement.target, information, mutable, visiting)
            var assigned_uses = expression_state_uses(statement.value, information, mutable, visiting)
            return target_uses + assigned_uses
        }
        Syntax.Statements.IfStatement: {
            var condition_uses = optional_state_uses(statement.condition, information, mutable, visiting)
            var then_uses = block_state_uses(statement.then_branch, information, mutable, visiting)
            var else_uses = block_state_uses(statement.else_branch, information, mutable, visiting)
            return condition_uses + then_uses + else_uses
        }
        Syntax.Statements.WhileStatement: {
            var condition_uses = optional_state_uses(statement.condition, information, mutable, visiting)
            var body_uses = block_state_uses(statement.body, information, mutable, visiting)
            if condition_uses + body_uses > 0 {
                return 2
            }
            return 0
        }
        Syntax.Statements.SwitchStatement: {
            var total = optional_state_uses(statement.subject, information, mutable, visiting)
            var case_index = 0
            while case_index < statement.cases.count() {
                var case_uses = block_state_uses(statement.cases[case_index].body, information, mutable, visiting)
                total = total + case_uses
                case_index = case_index + 1
            }
            return total
        }
        Syntax.Statements.AssertStatement: return optional_state_uses(statement.value, information, mutable, visiting)
        Syntax.Statements.ReturnStatement: return optional_state_uses(statement.value, information, mutable, visiting)
        Syntax.Statements.ExpressionStatement: return optional_state_uses(statement.value, information, mutable, visiting)
        _: return 0
    }
}

func stored_value(value: Syntax.Expressions.Expression, target: String): Syntax.Expressions.Expression {
    var binary = shape.as_binary(value)
    if binary {
        var counts = binary.operator == 'add' or binary.operator == 'subtract'
        crash binary.left
        crash binary.right
        if counts and is_identifier_named(binary.left, target) {
            return binary.right
        }
    }
    return value
}

func optional_state_uses(
    expression: Syntax.Expressions.Expression?,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    if expression {
        return expression_state_uses(expression, information, mutable, visiting)
    }
    return 0
}

func each_state_uses(
    expressions: List<Syntax.Expressions.Expression>,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    var total = 0
    var index = 0
    while index < expressions.count() {
        var uses = expression_state_uses(expressions[index], information, mutable, visiting)
        total = total + uses
        index = index + 1
    }
    return total
}

func expression_state_uses(
    expression: Syntax.Expressions.Expression,
    information: Analysis.ClassInfo,
    mutable: List<String>,
    visiting: List<String>,
): Integer {
    switch expression {
        Syntax.Expressions.IdentifierExpression: {
            if expression.name == "this" {
                return 2
            }
            if mutable.contains(expression.name) {
                return 1
            }
            return 0
        }
        Syntax.Expressions.StringLiteralExpression: {
            var index = 0
            while index < mutable.count() {
                if expression.value.contains("\{") and expression.value.contains(mutable[index]) {
                    return 2
                }
                index = index + 1
            }
            return 0
        }
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var argument_uses = each_state_uses(expression.arguments, information, mutable, visiting)
            var own = shape.as_identifier(expression.callee)
            if own {
                var called = information.find_function(own.name)
                if called {
                    var called_uses = function_state_uses(information, called, mutable, visiting)
                    return argument_uses + called_uses
                }
            }
            var callee_uses = expression_state_uses(expression.callee, information, mutable, visiting)
            return argument_uses + callee_uses
        }
        Syntax.Expressions.GenericCallExpression: return each_state_uses(expression.arguments, information, mutable, visiting)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            var left_uses = expression_state_uses(expression.left, information, mutable, visiting)
            var right_uses = expression_state_uses(expression.right, information, mutable, visiting)
            return left_uses + right_uses
        }
        Syntax.Expressions.UnaryExpression: return optional_state_uses(expression.operand, information, mutable, visiting)
        Syntax.Expressions.MemberExpression: return optional_state_uses(expression.object, information, mutable, visiting)
        Syntax.Expressions.IndexExpression: {
            var object_uses = optional_state_uses(expression.object, information, mutable, visiting)
            var index_uses = optional_state_uses(expression.index, information, mutable, visiting)
            return object_uses + index_uses
        }
        Syntax.Expressions.ListLiteralExpression: {
            var total = 0
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                var uses = optional_state_uses(element_value, information, mutable, visiting)
                total = total + uses
                index = index + 1
            }
            return total
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var total = 0
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                var uses = optional_state_uses(field_value, information, mutable, visiting)
                total = total + uses
                index = index + 1
            }
            return total
        }
        _: return 0
    }
}

func emit_atomic_store(
    name: String,
    field_type: Analysis.SpiteType,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var place = "self->{c_value_name(name)}"
    var owner = class_information.c_name
    var binary = shape.as_binary(value)
    if binary {
        crash binary.left
        crash binary.right
        var counts = binary.operator == 'add' or binary.operator == 'subtract'
        if counts and is_identifier_named(binary.left, name) and not is_boolean_type(field_type) {
            mark_attribute_read(class_information, name)
            var step = coerce_for_store(binary.right, field_type, scope, class_information)
            if binary.operator == 'subtract' {
                step = "-({step})"
            }
            builder.add_user("SPITE_SINGLETON_ADD({owner}, {place}, {step});")
            return
        }
    }
    var stored = coerce_for_store(value, field_type, scope, class_information)
    builder.add_user("SPITE_SINGLETON_STORE({owner}, {place}, {stored});")
}

func emit_guarded_outside_write(
    target_class: Analysis.ClassInfo,
    target_code: String,
    field_type: Analysis.SpiteType,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    if not outside_class_names.contains(target_class.c_name) {
        outside_class_names.append(target_class.c_name)
        outside_classes.append(target_class)
    }
    var value_code = coerce_for_store(value, field_type, scope, class_information)
    var stored = next_temporary()
    var type_name = c_type_name(field_type)
    builder.add_user("{type_name} {stored} = {value_code};")
    var owner = target_class.c_name
    builder.add_user("{owner}___outside_enter();")
    if type_needs_drop(field_type) {
        var previous = next_temporary()
        builder.add_user("{type_name} {previous} = {target_code};")
        builder.add_user("{target_code} = {stored};")
        builder.add_user("{owner}___outside_leave();")
        builder.add_user("{release_call(field_type, previous)};")
    } else {
        builder.add_user("{target_code} = {stored};")
        builder.add_user("{owner}___outside_leave();")
    }
}

func finish_atomic_singletons() {
    assert not atomic_classes.is_empty()
    builder.add_typedef(
        "#define SPITE_SINGLETON_LOAD(owner, place) (owner##___atomic ? __atomic_load_n(&(place), __ATOMIC_SEQ_CST) : (place))",
    )
    builder.add_typedef(
        "#define SPITE_SINGLETON_STORE(owner, place, value) do \{ if (owner##___atomic) __atomic_store_n(&(place), (value), __ATOMIC_SEQ_CST); else (place) = (value); } while (0)",
    )
    builder.add_typedef(
        "#define SPITE_SINGLETON_ADD(owner, place, value) do \{ if (owner##___atomic) __atomic_fetch_add(&(place), (value), __ATOMIC_SEQ_CST); else (place) += (value); } while (0)",
    )
    var reached = call_effects.thread_reached_classes()
    var index = 0
    while index < atomic_classes.count() {
        var information = atomic_classes.get_at(index)
        var threaded = parallel_used and (reached.has(information.simple_name) or called_implicitly(information))
        var flag = "0"
        if threaded {
            flag = "1"
        }
        builder.add_typedef("#define {information.c_name}___atomic {flag}")
        index = index + 1
    }
}

func written_from_outside(information: Analysis.ClassInfo): Boolean {
    if outside_written.has(information.c_name) {
        return outside_written[information.c_name] == true
    }
    var written = false
    var names = call_effects.writes_from_outside(information.simple_name)
    var index = 0
    while index < names.count() {
        if information.find_field(names[index]) {
            written = true
        }
        index = index + 1
    }
    outside_written.set(information.c_name, written)
    return written
}

func shares_state(field_type: Analysis.SpiteType): Boolean {
    var visiting = List<String>()
    return not holds_read_only(field_type, visiting)
}

func holds_read_only(field_type: Analysis.SpiteType, visiting: List<String>): Boolean {
    if not reaches_shared(field_type) {
        return true
    }
    var held_type = field_type
    var nullable = type_shape.as_nullable(field_type)
    if nullable {
        held_type = nullable.get_inner()
    }
    var class_ref = type_shape.as_class_ref(held_type)
    assert class_ref
    var held = find_class_by_c_name(class_ref.c_name)
    assert held
    return is_read_only_class(held, visiting)
}

func is_read_only_class(information: Analysis.ClassInfo, visiting: List<String>): Boolean {
    if read_only_classes.has(information.c_name) {
        return read_only_classes[information.c_name] == true
    }
    assert not visiting.contains(information.c_name) and not information.is_value_class
    assert not information.is_generic_template
    visiting.append(information.c_name)
    var read_only = not written_from_outside(information)
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.get_type()
        if not holds_read_only(field_type, visiting) {
            read_only = false
        }
        index = index + 1
    }
    var targets = List<String>()
    index = 0
    while index < information.functions.count() {
        var function = information.functions[index]
        if not function.is_constructor {
            collect_assigned_roots(function.body, targets)
        }
        index = index + 1
    }
    index = 0
    while index < targets.count() {
        if information.find_field(targets[index]) {
            read_only = false
        }
        index = index + 1
    }
    read_only_classes.set(information.c_name, read_only)
    return read_only
}

func guards_outside_write(target_class: Analysis.ClassInfo): Boolean {
    var singleton = target_class.is_singleton and not target_class.is_stateless_singleton
    return singleton and not is_library_class(target_class) and not is_hot_class(target_class)
}

func finish_outside_writes() {
    var reached = call_effects.thread_reached_classes()
    var index = 0
    while index < outside_classes.count() {
        var information = outside_classes.get_at(index)
        var name = information.c_name
        var threaded = parallel_used and (reached.has(information.simple_name) or called_implicitly(information))
        if threaded and not emitted_guards.contains(name) {
            emitted_guards.append(name)
            builder.add_support("static SpiteGuard {name}___guard = \{ 0, 0 };")
        }
        if threaded {
            builder.add_typedef("#define {name}___outside_enter() spite_guard_enter(&{name}___guard)")
            builder.add_typedef("#define {name}___outside_leave() spite_guard_leave(&{name}___guard)")
        } else {
            builder.add_typedef("#define {name}___outside_enter() ((void)0)")
            builder.add_typedef("#define {name}___outside_leave() ((void)0)")
        }
        index = index + 1
    }
}

func called_implicitly(information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < information.functions.count() {
        var name = information.functions[index].name
        var operator = name == "sum" or name == "subtract" or name == "multiply" or name == "divide" or name == "remainder"
        var compares = name == "equals" or name == "less_than" or name == "greater_than" or name == "negate"
        var indexes = name == "get_at" or name == "set_at" or name == "missing_function"
        var accessor = name.starts_with("get_") or name.starts_with("set_")
        var text = name == "to_string" or name == "to_debug"
        if operator or compares or indexes or accessor or text {
            return true
        }
        index = index + 1
    }
    return false
}

func emit_guard_wrapper(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, unguarded_name: String) {
    var arguments = List<String>()
    arguments.append("self")
    var index = 0
    while index < function.parameters.count() {
        var argument_code = c_value_name(function.parameters[index].name)
        arguments.append(argument_code)
        index = index + 1
    }
    var called = "{unguarded_name}({arguments.join(", ")})"
    var guard = "&{information.c_name}___guard"
    var return_type = function.get_return_type()
    var lines = List<String>()
    lines.append("{function_signature(information, function)} \{")
    lines.append("spite_guard_enter({guard});")
    if type_shape.is_void(return_type) {
        lines.append("{called};")
        lines.append("spite_guard_leave({guard});")
    } else {
        lines.append("{c_type_name(return_type)} spite_guarded = {called};")
        lines.append("spite_guard_leave({guard});")
        lines.append("return spite_guarded;")
    }
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func finish_waiting_points() {
    assert scheduler_used or remote_loop_port > 0 or hot_reload
    builder.threads = true
    var scheduler_class = find_class_by_qualified("Scheduler")
    crash scheduler_class
    var scheduler = singleton_call(scheduler_class)
    builder.add_typedef(
        "typedef struct SpiteOffload \{ int64_t done; void (*perform)(void*); void* scheduler; } SpiteOffload;",
    )
    builder.add_prototype("static void* spite_offload_thread(void* call);")
    builder.add_support(
        "static void* spite_offload_thread(void* call) \{\nSpiteOffload* offload = (SpiteOffload*)call;\noffload->perform(call);\nScheduler_offload_done((Scheduler*)offload->scheduler, (int64_t)(intptr_t)call);\nreturn 0;\n}",
    )
    var index = 0
    while index < waiting_functions.count() {
        var information = waiting_classes.get_at(index)
        var function = waiting_functions[index]
        var position = waiting_positions.get_at(index)
        var kind = waiting_kinds.get_at(index)
        if kind != "join" {
            var waited_name = "{function.c_name}___waiting"
            var waited_signature = named_signature(information, function, waited_name)
            builder.replace_user(position, "{waited_signature} \{")
            builder.add_prototype("{waited_signature};")
            emit_waiting_wrapper(information, function, kind, scheduler)
        }
        index = index + 1
    }
}

func emit_waiting_wrapper(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    kind: String,
    scheduler: String,
) {
    var arguments = List<String>()
    arguments.append("self")
    var index = 0
    while index < function.parameters.count() {
        var argument_code = c_value_name(function.parameters[index].name)
        arguments.append(argument_code)
        index = index + 1
    }
    var waited = "{function.c_name}___waiting({arguments.join(", ")})"
    var lines = List<String>()
    lines.append("{function_signature(information, function)} \{")
    lines.append("Scheduler* spite_scheduler = {scheduler};")
    if kind == "yield" {
        lines.append("{waited};")
        lines.append("if (Scheduler_waits_here(spite_scheduler)) Scheduler_yield_now(spite_scheduler);")
        lines.append("Scheduler___release(spite_scheduler);")
    } else if kind == "sleep" {
        crash function.parameters[0]
        lines.append(
            "if (Scheduler_waits_here(spite_scheduler)) Scheduler_sleep(spite_scheduler, {c_value_name(function.parameters[0].name)}); else {waited};",
        )
        lines.append("Scheduler___release(spite_scheduler);")
    } else {
        var offloaded = offloaded_call_lines(information, function, arguments, waited)
        lines.append(offloaded)
    }
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func offloaded_call_lines(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    arguments: List<String>,
    waited: String,
): String {
    var call_type = "{function.c_name}___call"
    var return_type = function.get_return_type()
    var returns = not type_shape.is_void(return_type)
    var fields = List<String>()
    fields.append("SpiteOffload offload;")
    fields.append("{information.c_name}* self;")
    var passed = List<String>()
    passed.append("call->self")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.get_type()
        fields.append("{c_type_name(parameter_type)} {c_value_name(parameter.name)};")
        passed.append("call->{c_value_name(parameter.name)}")
        index = index + 1
    }
    var stored = ""
    var blocked = "{waited}; Scheduler___release(spite_scheduler); return;"
    var answered = "return;"
    if returns {
        fields.append("{c_type_name(return_type)} result;")
        stored = "call->result = "
        blocked = "Scheduler___release(spite_scheduler); return {waited};"
        answered = "return spite_call.result;"
    }
    builder.add_typedef("typedef struct {call_type} \{ {fields.join(" ")} } {call_type};")
    builder.add_prototype("static void {function.c_name}___perform(void* raw);")
    builder.add_support(
        "static void {function.c_name}___perform(void* raw) \{\n{call_type}* call = ({call_type}*)raw;\n{stored}{function.c_name}___waiting({passed.join(", ")});\n}",
    )
    var lines = List<String>()
    lines.append("if (!Scheduler_waits_here(spite_scheduler)) \{ {blocked} }")
    lines.append(
        "{call_type} spite_call = \{ \{ 0, &{function.c_name}___perform, spite_scheduler }, {arguments.join(", ")} };",
    )
    lines.append(
        "if (!Scheduler_offload(spite_scheduler, (int64_t)(intptr_t)&spite_call, (int64_t)(intptr_t)&spite_offload_thread)) \{ {blocked} }",
    )
    lines.append("Scheduler___release(spite_scheduler);")
    lines.append(answered)
    return lines.join("\n")
}

func remote_loop_start(entry_class: Analysis.ClassInfo, lines: List<String>) {
    builder.threads = true
    var program_symbol = ensure_symbol("program")
    builder.add_support(
        "static ReadEvaluatePrintLoop* spite_remote_loop = 0;\nstatic {entry_class.c_name}* spite_remote_program = 0;\nstatic void* spite_remote_loop_thread(void* unused) \{\n(void)unused;\nReadEvaluatePrintLoop_serve(spite_remote_loop, spite_reflect_{entry_class.c_name}({program_symbol}, spite_remote_program));\nreturn 0;\n}",
    )
    lines.append("spite_remote_program = spite_entry_instance;")
    lines.append("spite_remote_loop = ReadEvaluatePrintLoop___make();")
    lines.append(
        "ReadEvaluatePrintLoop_listen_in_background(spite_remote_loop, {remote_loop_port}, (int64_t)(intptr_t)&spite_remote_loop_thread);",
    )
}

func program_run_code(): String {
    var entry_class = find_class_by_c_name(entry_class_c_name)
    crash entry_class
    var lines = List<String>()
    lines.append("{entry_class.c_name}* spite_entry_instance = {entry_class.c_name}___allocate();")
    if remote_loop_port > 0 {
        remote_loop_start(entry_class, lines)
    }
    var hot_reload_class = find_class_by_qualified("HotReload")
    if hot_reload {
        crash hot_reload_class
        lines.append(
            "HotReload* spite_hot_reload = {singleton_call(hot_reload_class)}; HotReload_start(spite_hot_reload);",
        )
    }
    if entry_class.constructor {
        lines.append("{entry_class.constructor.c_name}(spite_entry_instance);")
    }
    if console_loop {
        var program_symbol = ensure_symbol("program")
        lines.append(
            "\{ ReadEvaluatePrintLoop* spite_loop = ReadEvaluatePrintLoop___make(); while (ReadEvaluatePrintLoop_step(spite_loop, spite_reflect_{entry_class.c_name}({program_symbol}, spite_entry_instance))) \{} ReadEvaluatePrintLoop___release(spite_loop); }",
        )
    }
    if remote_loop_port > 0 {
        lines.append("ReadEvaluatePrintLoop_wait_for_exit(spite_remote_loop);")
        lines.append("ReadEvaluatePrintLoop___release(spite_remote_loop);")
    }
    if hot_reload {
        lines.append("HotReload___release(spite_hot_reload);")
    }
    lines.append("{entry_class.c_name}___release(spite_entry_instance);")
    return "(\{ {lines.join(" ")} (void)0; })"
}

func emit_main(launcher_mangled_name: String) {
    var launcher_class = find_class_by_c_name(launcher_mangled_name)
    assert launcher_class
    if debug_memory {
        builder.add_main("static const char* spite_debug_class_name_table[] = {debug_memory_class_name_table()};")
        builder.add_main("spite_debug_set_class_names(spite_debug_class_name_table, {class_names_by_id.count()});")
    }
    builder.add_main("{launcher_class.c_name}* spite_launcher = {launcher_class.c_name}___allocate();")
    if launcher_class.constructor {
        builder.add_main("{launcher_class.constructor.c_name}(spite_launcher);")
    }
    builder.add_main("{launcher_class.c_name}___release(spite_launcher);")
    emit_singleton_teardown()
    singleton_releases.each(builder.add_main)
    var listed_name = ""
    if class_level_functions_used {
        var listed_class = find_class_by_c_name("Spite_Function")
        crash listed_class
        var class_type = class_type_of(listed_class)
        listed_name = ensure_list(class_type)
    }
    var attribute_listed_name = ""
    if class_level_attributes_used {
        var attribute_class = find_class_by_c_name("Spite_Attribute")
        crash attribute_class
        var class_type = class_type_of(attribute_class)
        attribute_listed_name = ensure_list(class_type)
    }
    var cache_index = 0
    while cache_index < class_object_names.count() {
        var class_object = class_object_names[cache_index]
        var cache = "{class_object}_cache"
        if not listed_name.is_empty() {
            builder.add_main_if_kept(
                class_object,
                "if ({cache} != 0) \{ {listed_name}___release({cache}->_functions_); {cache}->_functions_ = 0; }",
            )
        }
        if not attribute_listed_name.is_empty() {
            builder.add_main_if_kept(
                class_object,
                "if ({cache} != 0) \{ {attribute_listed_name}___release({cache}->_attributes_); {cache}->_attributes_ = 0; }",
            )
        }
        builder.add_main_if_kept(
            class_object,
            "if ({cache} != 0 && {cache}->_namespace_ != 0) \{ Spite_Namespace___release({cache}->_namespace_); {cache}->_namespace_ = 0; }",
        )
        builder.add_main_if_kept(class_object, "Spite_Class___release({cache});")
        cache_index = cache_index + 1
    }
    if namespace_read_used {
        var class_class = find_class_by_c_name("Spite_Class")
        var namespace_class = find_class_by_c_name("Spite_Namespace")
        crash class_class
        crash namespace_class
        var class_type = class_type_of(class_class)
        var classes_list_name = ensure_list(class_type)
        var namespace_class_type = class_type_of(namespace_class)
        var namespaces_list_name = ensure_list(namespace_class_type)
        var parent_position = 0
        while parent_position < namespace_object_keys.count() {
            var parent_cache = "spite_namespace_object_{namespace_object_keys[parent_position].replace(".", "_")}_cache"
            builder.add_main(
                "if ({parent_cache} != 0 && {parent_cache}->_parent_ != 0) \{ Spite_Namespace___release({parent_cache}->_parent_); {parent_cache}->_parent_ = 0; }",
            )
            parent_position = parent_position + 1
        }
        var namespace_position = 0
        while namespace_position < namespace_object_keys.count() {
            var namespace_cache = "spite_namespace_object_{namespace_object_keys[namespace_position].replace(".", "_")}_cache"
            builder.add_main(
                "if ({namespace_cache} != 0) \{ {classes_list_name}___release({namespace_cache}->_classes_); {namespace_cache}->_classes_ = 0; {namespaces_list_name}___release({namespace_cache}->_namespaces_); {namespace_cache}->_namespaces_ = 0; }",
            )
            builder.add_main("Spite_Namespace___release({namespace_cache});")
            namespace_position = namespace_position + 1
        }
    }
    if debug_memory {
        builder.add_main("spite_debug_report();")
    }
}

func is_hot_class(information: Analysis.ClassInfo): Boolean {
    var program_class = not information.source_path.is_empty() and not is_library_class(information)
    return hot_reload and program_class and not information.is_value_class
}

func add_hot_slot(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var hot_name = "{function.c_name}___hot"
    builder.add_prototype("{named_signature(information, function, hot_name)};")
    var slot_declarator = "(*{function.c_name}___slot)"
    builder.add_slot(function.c_name, "static {named_signature(information, function, slot_declarator)} = {hot_name};")
    var arguments = List<String>()
    arguments.append("self")
    var index = 0
    while index < function.parameters.count() {
        var argument_code = c_value_name(function.parameters[index].name)
        arguments.append(argument_code)
        index = index + 1
    }
    var returned = "return "
    var function_return_type = function.get_return_type()
    if type_shape.is_void(function_return_type) {
        returned = ""
    }
    builder.add_user(
        "{function_signature(information, function)} \{\n{returned}{function.c_name}___slot({arguments.join(", ")});\n}",
    )
    hot_slot_names.append(function.c_name)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}.{function.name}")
}

func add_hot_initialize_slot(information: Analysis.ClassInfo) {
    var initialize_name = "{information.c_name}___init"
    builder.add_prototype("void {initialize_name}___hot({information.c_name}* self);")
    builder.add_slot(
        initialize_name,
        "static void (*{initialize_name}___slot)({information.c_name}* self) = {initialize_name}___hot;",
    )
    builder.add_support("void {initialize_name}({information.c_name}* self) \{\n{initialize_name}___slot(self);\n}")
    hot_slot_names.append(initialize_name)
    hot_slot_owners.append(information.c_name)
    hot_slot_displays.append("{information.qualified_dotted}'s attribute defaults")
}

func hot_reload_body(name: String): String {
    if name == "compiler" {
        return "return {owned_c_text(hot_reload_compiler)};"
    }
    if name == "build_arguments" {
        return "return {owned_c_text(hot_reload_arguments)};"
    }
    if name == "program_file" {
        return "return {owned_c_text(hot_reload_program_file)};"
    }
    if name == "watcher_entry" and hot_reload {
        return "return (int64_t)(intptr_t)&spite_hot_reload_thread;"
    }
    if name == "watcher_entry" {
        return "return 0;"
    }
    if not hot_reload {
        return "(void)library_;\nreturn spite_string_from_cstring_owned(\"this program was not built with --hot-reload\");"
    }
    return "typedef const char* (*SpiteHotBind)(void* (*)(const char*), int32_t (*)(const char*, void*));\n#ifdef _WIN32\nSpiteHotBind bind = (SpiteHotBind)(void*)GetProcAddress((HMODULE)(intptr_t)library_, \"spite_reload_bind\");\n#else\nSpiteHotBind bind = (SpiteHotBind)dlsym((void*)(intptr_t)library_,\"spite_reload_bind\");\n#endif\nif (bind == 0) return spite_string_from_cstring_owned(\"spite_reload_bind\");\nconst char* missing = bind(spite_hot_find, spite_hot_install);\nreturn spite_string_from_cstring_owned(missing == 0 ? \"\" : missing);"
}

func emit_hot_reload_support() {
    assert hot_reload
    var hot_reload_class = find_class_by_qualified("HotReload")
    crash hot_reload_class
    var hot_reload_instance = singleton_call(hot_reload_class)
    builder.add_prototype("static void* spite_hot_reload_thread(void* unused);")
    builder.add_prototype("static void* spite_hot_find(const char* name);")
    builder.add_prototype("static int32_t spite_hot_install(const char* name, void* address);")
    builder.add_prototype("void* spite_hot_realloc(void* pointer, size_t size);")
    builder.add_prototype("void spite_hot_free(void* pointer);")
    builder.add_support(
        "static void* spite_hot_reload_thread(void* unused) \{\n(void)unused;\nHotReload* spite_hot_reload = {hot_reload_instance};\nHotReload_watch(spite_hot_reload);\nHotReload___release(spite_hot_reload);\nreturn 0;\n}",
    )
    builder.add_support(
        "void* spite_hot_realloc(void* pointer, size_t size) \{\nreturn SPITE_REALLOC(pointer, size);\n}",
    )
    builder.add_support("void spite_hot_free(void* pointer) \{\nSPITE_FREE(pointer);\n}")
    var names = List<String>()
    var cells = List<String>()
    var index = 0
    while index < hot_slot_names.count() {
        names.append("\"{hot_slot_names[index]}\"")
        cells.append("(void**)&{hot_slot_names[index]}___slot")
        index = index + 1
    }
    names.append("0")
    cells.append("0")
    builder.add_support(
        "static const char* spite_hot_slot_names[] = \{ {names.join(", ")} };\nstatic void** spite_hot_slot_cells[] = \{ {cells.join(", ")} };\nstatic int32_t spite_hot_install(const char* name, void* address) \{\nfor (int64_t index = 0; spite_hot_slot_names[index] != 0; index = index + 1) \{\nif (strcmp(spite_hot_slot_names[index], name) == 0) \{ __atomic_store_n(spite_hot_slot_cells[index], address, __ATOMIC_SEQ_CST); return 1; }\n}\nreturn 0;\n}",
    )
}

func seed_class_names(names: List<String>) {
    var index = 0
    while index < names.count() {
        var name = names[index]
        class_names_by_id.append(name)
        if not seeded_class_ids.has(name) {
            seeded_class_ids[name] = index
        }
        index = index + 1
    }
}

func hot_manifest(): String {
    return builder.host.host_manifest(hot_slot_names, hot_slot_displays, class_names_by_id, builder.typedefs)
}

func program_source_paths(): List<String> {
    var paths = List<String>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if is_hot_class(information) {
            append_new_path(paths, information.source_path)
            var function_index = 0
            while function_index < information.functions.count() {
                append_new_path(paths, information.functions[function_index].source_path)
                function_index = function_index + 1
            }
        }
        index = index + 1
    }
    return paths
}

func append_new_path(paths: List<String>, path: String) {
    if not path.is_empty() and not paths.contains(path) {
        paths.append(path)
    }
}

func classes_of_paths(paths: List<String>): List<String> {
    var owners = List<String>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        var class_paths = List<String>()
        append_new_path(class_paths, information.source_path)
        var function_index = 0
        while function_index < information.functions.count() {
            append_new_path(class_paths, information.functions[function_index].source_path)
            function_index = function_index + 1
        }
        var path_index = 0
        while path_index < class_paths.count() {
            if is_hot_class(information) and paths.contains(class_paths[path_index]) and not owners.contains(information.c_name) {
                owners.append(information.c_name)
            }
            path_index = path_index + 1
        }
        index = index + 1
    }
    return owners
}

func reload_library(reload: HotReloadLibrary, changed_paths: List<String>, rebuilt: List<String>): String {
    var owners = classes_of_paths(changed_paths)
    var prototype_text = builder.prototypes.join("\n")
    var bodies = builder.bodies_text()
    var growing = true
    while growing {
        var changed_signatures = reload.changed_signatures(
            hot_slot_names,
            hot_slot_owners,
            owners,
            prototype_text,
            bodies,
        )
        var callers = reload.callers_of(changed_signatures, hot_slot_names, hot_slot_owners, owners, bodies)
        growing = not callers.is_empty()
        var caller_index = 0
        while caller_index < callers.count() {
            owners.append(callers[caller_index])
            caller_index = caller_index + 1
        }
    }
    var index = 0
    while index < owners.count() {
        var owner = find_class_by_c_name(owners[index])
        crash owner
        rebuilt.append(owner.qualified_dotted)
        index = index + 1
    }
    return reload.library(builder, hot_slot_names, hot_slot_owners, owners)
}

func frame_result_body(information: Analysis.ClassInfo): String {
    crash information.codegen_types[0]
    var result_type = information.codegen_types[0]
    var frame = "(void*)(intptr_t)self->_frame_"
    var result_class = type_shape.as_class_ref(result_type)
    if result_class {
        if result_class.c_name == "Nothing" {
            return "SPITE_FREE({frame});\nreturn Nothing___default();"
        }
    }
    var result_c = c_type_name(result_type)
    return "{result_c} spite_result = ((struct \{ SpiteFrame spite_head; {result_c} spite_result; }*){frame})->spite_result;\nSPITE_FREE({frame});\nreturn spite_result;"
}

func record_call(callee: String) {
    assert not resumable_mode and not current_function_c_name.is_empty()
    call_edge_callers.append(current_function_c_name)
    call_edge_callees.append(callee)
}

func hoisted_wait(
    callee: String,
    receiver: ExpressionResult,
    receiver_owned: Boolean,
    argument_codes: List<String>,
    return_type: Analysis.SpiteType,
): ExpressionResult? {
    assert resumable_mode and conditional_depth == 0
    assert waiting_names.has(callee) and ensure_machine(callee)
    wait_mark_counters.append(temporary_counter)
    var start = builder.user_count()
    wait_mark_positions.append(start)
    resume_point_count = resume_point_count + 1
    var point = resume_point_count
    var receiver_type = receiver.get_type()
    var releases = type_needs_drop(receiver_type)
    var held = receiver.code
    if releases and not receiver_owned {
        held = retain_call(receiver_type, receiver.code)
    }
    var receiver_temporary = "self"
    if receiver.code == "self" {
        releases = false
    } else {
        receiver_temporary = next_temporary()
        builder.add_user("{c_type_name(receiver_type)} {receiver_temporary} = {held};")
    }
    var passed = argument_codes.copy()
    passed.prepend(receiver_temporary)
    var slot = "spite_frame->spite_wait_{point}"
    builder.add_user("{slot} = {callee}___begin({passed.join(", ")});")
    builder.add_user("spite_resume_{point}: if (!{callee}___step({slot})) SPITE_SUSPEND({point});")
    var result_temporary = next_temporary()
    var code = result_temporary
    if type_shape.is_void(return_type) {
        builder.add_user("bool {result_temporary} = true;")
        code = "(void){result_temporary}"
    } else {
        builder.add_user("{c_type_name(return_type)} {result_temporary} = (({callee}___frame*){slot})->spite_result;")
    }
    builder.add_user("SPITE_FREE({slot});")
    if releases {
        builder.add_user("{release_call(receiver_type, receiver_temporary)};")
    }
    var end = builder.user_count()
    wait_mark_ends.append(end)
    wait_mark_results.append(result_temporary)
    return ExpressionResult(code, return_type)
}

func rewind_temporaries(saved: Integer) {
    temporary_counter = saved
    while not wait_mark_counters.is_empty() and newest_wait_counter() >= saved {
        var position = wait_mark_positions.last()
        crash position
        var user_count = builder.user_count()
        builder.remove_user_range(position, user_count)
        drop_last_wait_mark()
    }
}

func newest_wait_counter(): Integer {
    var counter_count = wait_mark_counters.count()
    return wait_mark_counters.get_at(counter_count - 1)
}

func drop_last_wait_mark() {
    wait_mark_counters.remove_last()
    wait_mark_positions.remove_last()
    wait_mark_ends.remove_last()
    wait_mark_results.remove_last()
}

func drop_unread_waits(first: Integer) {
    while wait_mark_counters.count() > first {
        var result = wait_mark_results.last()
        crash result
        var start = wait_mark_positions.last()
        crash start
        var end = wait_mark_ends.last()
        crash end
        if not user_lines_mention(end, result) {
            builder.remove_user_range(start, end)
        }
        drop_last_wait_mark()
    }
}

func shift_wait_marks(position: Integer) {
    var index = 0
    while index < wait_mark_positions.count() {
        if wait_mark_positions.get_at(index) >= position {
            var shifted = wait_mark_positions.get_at(index) + 1
            wait_mark_positions.set_at(index, shifted)
            var shifted_end = wait_mark_ends.get_at(index) + 1
            wait_mark_ends.set_at(index, shifted_end)
        }
        index = index + 1
    }
}

func user_lines_mention(start: Integer, name: String): Boolean {
    var index = start
    while index < builder.user_count() {
        var line = builder.user_at(index)
        if mentions_name(line, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func mentions_name(text: String, name: String): Boolean {
    var from = 0
    var name_length = name.length()
    var text_length = text.length()
    while from < text_length {
        var rest = text.slice(from, text_length)
        var found = rest.index_of(name)
        assert found >= 0
        var after = from + found + name_length
        var next_code = text.code_at(after)
        var continues_name = next_code == 95 or next_code >= 48 and next_code <= 57 or next_code >= 65 and next_code <= 90 or next_code >= 97 and next_code <= 122
        if after >= text_length or not continues_name {
            return true
        }
        from = after
    }
    return false
}

func ensure_machine(callee: String): Boolean {
    if machine_names.has(callee) {
        return machine_names.get(callee) == true
    }
    var queued = queue_machine(callee)
    machine_names.set(callee, queued)
    return queued
}

func queue_machine(callee: String): Boolean {
    var index = 0
    while index < waiting_functions.count() {
        var waiting = waiting_functions.get_at(index)
        var kind = waiting_kinds.get_at(index)
        if waiting.c_name == callee and kind != "yield" {
            var waiting_class = waiting_classes.get_at(index)
            machine_primitive_classes.append(waiting_class)
            machine_primitive_functions.append(waiting)
            machine_primitive_kinds.append(kind)
            return true
        }
        index = index + 1
    }
    index = 0
    while index < machine_candidate_names.count() {
        if machine_candidate_names.get_at(index) == callee {
            var candidate_class = machine_candidate_classes.get_at(index)
            var candidate_function = machine_candidate_functions.get_at(index)
            machine_queue_classes.append(candidate_class)
            machine_queue_functions.append(candidate_function)
            return true
        }
        index = index + 1
    }
    return false
}

func find_waiting_functions() {
    var index = 0
    while index < waiting_functions.count() {
        if waiting_kinds.get_at(index) != "yield" {
            var waiting = waiting_functions.get_at(index)
            waiting_names.set(waiting.c_name, true)
        }
        index = index + 1
    }
    var changed = true
    while changed {
        changed = false
        index = 0
        while index < call_edge_callers.count() {
            var caller = call_edge_callers.get_at(index)
            var callee = call_edge_callees.get_at(index)
            if not waiting_names.has(caller) and waiting_names.has(callee) {
                waiting_names.set(caller, true)
                changed = true
            }
            index = index + 1
        }
    }
}

func emit_state_machines() {
    find_waiting_functions()
    var roots = List<String>()
    var index = 0
    while index < task_root_functions.count() {
        var root = task_root_functions.get_at(index)
        if waiting_names.has(root.c_name) and not roots.contains(root.c_name) and ensure_machine(root.c_name) {
            roots.append(root.c_name)
        }
        index = index + 1
    }
    while not machine_queue_functions.is_empty() {
        var information = machine_queue_classes.remove_first()
        var function = machine_queue_functions.remove_first()
        emit_resumable_function(information, function)
    }
    var lines = List<String>()
    lines.append("static void* spite_frame_start(Spite_Function* spite_work) \{")
    lines.append("if (spite_work == 0) return 0;")
    index = 0
    while index < roots.count() {
        var root = roots.get_at(index)
        lines.append(
            "if (spite_work->spite_typed_call == (void*){root}) return {root}___begin(spite_work->spite_owner);",
        )
        index = index + 1
    }
    lines.append("return 0;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func emit_resumable_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var crash_lines = crash_map_lines.count()
    resumable_mode = true
    conditional_depth = 0
    resume_point_count = 0
    site_ordinal = 0
    frame_candidates.clear()
    placed_names.clear()
    placed_frames.clear()
    placed_receiver_names.clear()
    placed_receiver_codes.clear()
    current_class = information
    current_owner = information.qualified_dotted
    current_function = function.name
    current_line = function.line
    current_path = information.source_path
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    bind_symbol_of(function)
    var start = builder.user_count()
    var scope = parameter_scope(function)
    terminal_if = terminal_if_of(function.body)
    body_narrowed_names = List<String>()
    body_assigned_paths = List<String>()
    collect_body_facts(function.body)
    var ended_in_return = generate_statement_list(function.body, scope, information, function)
    terminal_if = null
    var return_type = function.get_return_type()
    var returns_value = not type_shape.is_void(return_type)
    if not ended_in_return {
        emit_scope_drops(scope, true)
        if returns_value {
            builder.add_user("return {default_value_for_type(return_type)};")
        }
    }
    close_rebindings(scope)
    var body = builder.take_user_from(start)
    resumable_mode = false
    while crash_map_lines.count() > crash_lines {
        crash_map_lines.remove_last()
    }
    var machine = StateMachine()
    var parts = machine_parts(information, function, machine)
    var rewritten = machine.rewrite(body)
    var name = function.c_name
    var waits = List<String>()
    var point = 1
    while point <= resume_point_count {
        waits.append("void* spite_wait_{point};")
        point = point + 1
    }
    var result_field = ""
    if returns_value {
        result_field = " {c_type_name(return_type)} spite_result;"
    }
    builder.add_typedef(
        "typedef struct {name}___frame \{ SpiteFrame spite_head;{result_field} {parts.get_at(0)} self; {machine.frame_fields()} {waits.join(" ")} } {name}___frame;",
    )
    emit_machine_begin(name, parts)
    var lines = List<String>()
    lines.append("static bool {name}___step(void* spite_raw) \{")
    lines.append("{name}___frame* spite_frame = ({name}___frame*)spite_raw;")
    lines.append("{parts.get_at(0)} self = spite_frame->self;")
    var resume_switch = machine.resume_switch()
    lines.append(resume_switch)
    var rewritten_body = rewritten.join("\n")
    lines.append(rewritten_body)
    lines.append("return true;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func machine_parts(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    machine: StateMachine,
): List<String> {
    var receiver_type = value_class_type(information)
    var parts = List<String>()
    var receiver_c_type = c_type_name(receiver_type)
    parts.append(receiver_c_type)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.get_type()
        var c_type = c_type_name(parameter_type)
        var name = c_value_name(parameter.name)
        machine.bind_parameter(c_type, name)
        parts.append(c_type)
        parts.append(name)
        index = index + 1
    }
    return parts
}

func emit_machine_begin(name: String, parts: List<String>) {
    var parameters = List<String>()
    parameters.append("{parts.get_at(0)} self")
    var index = 1
    while index + 1 < parts.count() {
        var c_type = parts.get_at(index)
        var parameter = parts.get_at(index + 1)
        parameters.append("{c_type} {parameter}")
        index = index + 2
    }
    var signature = "static void* {name}___begin({parameters.join(", ")})"
    var lines = List<String>()
    lines.append("{signature} \{")
    lines.append("{name}___frame* spite_frame = ({name}___frame*)SPITE_MALLOC(sizeof({name}___frame));")
    lines.append("memset(spite_frame, 0, sizeof({name}___frame));")
    lines.append("spite_frame->spite_head.step = {name}___step;")
    lines.append("spite_frame->self = self;")
    index = 2
    while index < parts.count() {
        var parameter = parts.get_at(index)
        lines.append("spite_frame->{parameter} = {parameter};")
        index = index + 2
    }
    lines.append("return spite_frame;")
    lines.append("}")
    builder.add_prototype("{signature};")
    builder.add_prototype("static bool {name}___step(void* spite_raw);")
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func emit_primitive_machines() {
    var index = 0
    while index < machine_primitive_functions.count() {
        var information = machine_primitive_classes.get_at(index)
        var function = machine_primitive_functions.get_at(index)
        var kind = machine_primitive_kinds.get_at(index)
        emit_primitive_machine(information, function, kind)
        index = index + 1
    }
}

func emit_primitive_machine(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, kind: String) {
    var scheduler_class = find_class_by_qualified("Scheduler")
    crash scheduler_class
    var scheduler = singleton_call(scheduler_class)
    var machine = StateMachine()
    var parts = machine_parts(information, function, machine)
    var name = function.c_name
    var fields = List<String>()
    var return_type = function.get_return_type()
    if not type_shape.is_void(return_type) {
        fields.append("{c_type_name(return_type)} spite_result;")
    }
    fields.append("{parts.get_at(0)} self;")
    var index = 1
    while index + 1 < parts.count() {
        fields.append("{parts.get_at(index)} {parts.get_at(index + 1)};")
        index = index + 2
    }
    var lines = List<String>()
    lines.append("static bool {name}___step(void* spite_raw) \{")
    lines.append("{name}___frame* spite_frame = ({name}___frame*)spite_raw;")
    lines.append("Scheduler* spite_scheduler = {scheduler};")
    var steps = ""
    if kind == "sleep" {
        steps = sleep_steps(scheduler_class, function, fields)
    } else if kind == "join" {
        steps = join_steps(scheduler_class, function)
    } else {
        steps = offload_steps(scheduler_class, function, fields)
    }
    lines.append(steps)
    lines.append("Scheduler___release(spite_scheduler);")
    lines.append("return spite_over;")
    lines.append("}")
    builder.add_typedef("typedef struct {name}___frame \{ SpiteFrame spite_head; {fields.join(" ")} } {name}___frame;")
    emit_machine_begin(name, parts)
    var joined_lines = lines.join("\n")
    builder.add_user(joined_lines)
}

func sleep_steps(scheduler_class: Analysis.ClassInfo, function: Analysis.FunctionInfo, fields: List<String>): String {
    crash function.parameters[0]
    var milliseconds = c_value_name(function.parameters[0].name)
    var timer_start = find_or_instantiate_function(scheduler_class, "timer_start")
    var timer_over = find_or_instantiate_function(scheduler_class, "timer_over")
    crash timer_start
    crash timer_over
    fields.append("int64_t spite_deadline;")
    return "if (spite_frame->spite_head.state == 0) \{ spite_frame->spite_deadline = {timer_start.c_name}(spite_scheduler, spite_frame->{milliseconds}); spite_frame->spite_head.state = 1; }\nbool spite_over = {timer_over.c_name}(spite_scheduler, spite_frame->spite_deadline);"
}

func join_steps(scheduler_class: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    crash function.parameters[0]
    var frame = c_value_name(function.parameters[0].name)
    var frame_done = find_or_instantiate_function(scheduler_class, "frame_done")
    crash frame_done
    return "bool spite_over = {frame_done.c_name}(spite_frame->self, spite_frame->{frame});"
}

func offload_steps(scheduler_class: Analysis.ClassInfo, function: Analysis.FunctionInfo, fields: List<String>): String {
    var offload_start = find_or_instantiate_function(scheduler_class, "offload_start")
    var offload_over = find_or_instantiate_function(scheduler_class, "offload_over")
    crash offload_start
    crash offload_over
    var name = function.c_name
    fields.append("{name}___call spite_call;")
    fields.append("int64_t spite_thread;")
    var passed = List<String>()
    passed.append("spite_frame->self")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        passed.append("spite_frame->{c_value_name(parameter.name)}")
        index = index + 1
    }
    var call = "(int64_t)(intptr_t)&spite_frame->spite_call"
    var lines = List<String>()
    lines.append("if (spite_frame->spite_head.state == 0) \{")
    lines.append(
        "spite_frame->spite_call = ({name}___call)\{ \{ 0, &{name}___perform, spite_scheduler }, {passed.join(", ")} };",
    )
    lines.append(
        "spite_frame->spite_thread = {offload_start.c_name}(spite_scheduler, {call}, (int64_t)(intptr_t)&spite_offload_thread);",
    )
    lines.append("spite_frame->spite_head.state = 1;")
    lines.append("}")
    lines.append("bool spite_over = {offload_over.c_name}(spite_scheduler, {call}, spite_frame->spite_thread);")
    var return_type = function.get_return_type()
    if not type_shape.is_void(return_type) {
        lines.append("if (spite_over) spite_frame->spite_result = spite_frame->spite_call.result;")
    }
    return lines.join("\n")
}
