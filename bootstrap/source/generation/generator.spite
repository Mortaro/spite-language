func fallback_line(): Integer {
    var known_line = function_line_in(current_class, current_function)
    if known_line > 0 {
        return known_line
    }
    return 1
}

func function_line_in(owner: Analysis.ClassInfo?, function_name: String): Integer {
    if not owner {
        return 0
    }
    var owned_function = owner.find_function(function_name)
    if not owned_function {
        return 0
    }
    return owned_function.line
}

func report(message: String) {
    has_error = true
    assert not statement_poisoned
    assert not refused_serialiser or not is_serialiser_path(current_path)
    var shown_line = current_line
    if shown_line == 0 {
        shown_line = fallback_line()
    }
    var line = "{current_path}:{shown_line}: error: {message} (in {current_owner}.{current_function})"
    assert not reported_lines.has(line)
    reported_lines[line] = true
    errors_reported = errors_reported + 1
    errors_reported_at = "{current_path}:{current_line}"
    var package = error_package(current_path)
    if package.is_empty() {
        list_own_error(line)
    } else {
        list_package_error(line, package)
    }
    error_message = listed_errors()
}

func list_own_error(line: String) {
    if error_lines.count() < 25 {
        error_lines.append(line)
    } else {
        own_errors_hidden = own_errors_hidden + 1
    }
}

func list_package_error(line: String, package: String) {
    if package_error_lines.count() < 25 {
        package_error_lines.append(line)
        return
    }
    if hidden_package_errors[package] {
        hidden_package_errors[package] = hidden_package_errors[package] + 1
    } else {
        hidden_package_errors[package] = 1
    }
}

# ../../../specs/compiler.md#how-many-errors-are-listed
func listed_errors(): String {
    var shown = error_lines.copy()
    if own_errors_hidden > 0 {
        shown.append("and {own_errors_hidden} more in the program")
    }
    var index = 0
    while index < package_error_lines.count() {
        shown.append(package_error_lines[index])
        index = index + 1
    }
    var packages = hidden_package_errors.keys()
    index = 0
    while index < packages.count() {
        var package = packages[index]
        crash hidden_package_errors[package]
        shown.append("and {hidden_package_errors[package]} more in {package}")
        index = index + 1
    }
    return shown.join("\n")
}

func error_package(path: String): String {
    var entry_class = find_class_by_c_name(entry_class_c_name)
    if not entry_class or path.is_empty() {
        return ""
    }
    var slashed = path.replace("\\", "/")
    var base = working_folder.replace("\\", "/")
    var language = language_folder.replace("\\", "/")
    var joined = "{base}/{slashed}"
    if slashed.starts_with("library/") or slashed.starts_with("launcher/") {
        joined = "{language}/{slashed}"
    }
    if slashed.starts_with("/") or slashed.slice(1, 2) == ":" {
        joined = slashed
    }
    var folder = normalized_folder(joined)
    var program_folder = absolute_source_folder(entry_class)
    if folder == program_folder or folder.starts_with("{program_folder}/") {
        return ""
    }
    var library_root = normalized_folder("{language}/library/")
    if folder == library_root or folder.starts_with("{library_root}/") {
        return "library"
    }
    var launcher_root = normalized_folder("{language}/launcher/")
    if folder == launcher_root or folder.starts_with("{launcher_root}/") {
        return "launcher"
    }
    var best_root = ""
    var index = 0
    while index < loaded_folders.count() {
        var loaded = loaded_folders[index].replace("\\", "/")
        var loaded_path = loaded
        if not loaded.starts_with("/") and loaded.slice(1, 2) != ":" {
            loaded_path = "{base}/{loaded}"
        }
        var loaded_root = normalized_folder("{loaded_path}/")
        var holds = folder == loaded_root or folder.starts_with("{loaded_root}/")
        if holds and loaded_root.length() > best_root.length() {
            best_root = loaded_root
        }
        index = index + 1
    }
    if best_root.is_empty() {
        best_root = folder
    }
    var working_root = normalized_folder("{base}/")
    if best_root.starts_with("{working_root}/") {
        var start = working_root.length() + 1
        var end = best_root.length()
        return best_root.slice(start, end)
    }
    return best_root
}

func allocate_class_id(debug_name: String): Integer {
    return allocate_class_id_of(debug_name, debug_name)
}

func allocate_class_id_of(debug_name: String, identity: String): Integer {
    if class_names_by_id.is_empty() {
        class_names_by_id.append("String")
        class_identities.append("String")
    }
    if seeded_class_ids[identity] {
        return seeded_class_ids[identity]
    }
    class_names_by_id.append(debug_name)
    class_identities.append(identity)
    return class_names_by_id.count() - 1
}

func generated_functions_source(qualified: String): String {
    var text = ""
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if information.qualified_dotted == qualified and information.codegen_names.is_empty() {
            var function_index = 0
            while function_index < information.declared_functions.count() {
                var function = information.declared_functions[function_index]
                if not function.symbol_name.is_empty() and function.symbol_owner_c_name.is_empty() and function.has_body {
                    text = "{text}\n\n{instantiated_function_source(information, function)}"
                }
                function_index = function_index + 1
            }
        }
        index = index + 1
    }
    return text
}

func instantiated_function_source(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var field = information.find_field(function.symbol_field_name)
    var field_type = "Nothing"
    if field {
        var field_spite_type = field.type
        field_type = type_display_name(field_spite_type)
    } else if function.symbol_field_type {
        field_type = type_source_name(function.symbol_field_type)
    }
    var shown_name = function.symbol_field_name
    if not function.symbol_display_name.is_empty() {
        shown_name = function.symbol_display_name
    }
    var parameters = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        parameters.append("{parameter.name}: {type_display_name(parameter_type)}")
        index = index + 1
    }
    var returns = ""
    var function_return_type = function.return_type
    if not type_shape.is_void(function_return_type) {
        returns = ": {type_display_name(function_return_type)}"
    }
    var symbol = function.symbol_name
    var body = Syntax.SourcePrinter().source_statement_list(function.body, 1)
    body = body.replace("attributes[{symbol}]", function.symbol_field_name)
    body = body.replace("\{{symbol}.name}", shown_name)
    body = body.replace("{symbol}.name", "\"{shown_name}\"")
    if not function.symbol_enum_c_name.is_empty() {
        body = body.replace("{symbol}.value", "'{function.symbol_field_name}'")
    }
    body = body.replace("{symbol}.class", field_type)
    body = body.replace("{symbol}.index", function.symbol_field_index)
    if not function.symbol_pattern.is_empty() {
        body = body.replace(".{function.symbol_pattern}(", ".{function.symbol_function_name}(")
    }
    body = passed_calls_source(information, function, body)
    body = replace_word(body, symbol, "'{function.symbol_field_name}'")
    return "func {function.name}({parameters.join(", ")}){returns} \{\n{body}\n}"
}

func passed_calls_source(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, body: String): String {
    var result = body
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.passed and range_text(template) == function.symbol_range {
            var instance_name = passed_instance_name(
                information,
                template,
                function.symbol_field_name,
                function.symbol_pattern,
                function.symbol_function_name,
            )
            result = result.replace("{template.prefix}({function.symbol_name}, ", "{instance_name}(")
            result = result.replace("{template.prefix}({function.symbol_name})", "{instance_name}()")
        }
        index = index + 1
    }
    return result
}

func type_source_name(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return described.qualified_dotted
        }
    }
    return type_display_name(spite_type)
}

func replace_word(text: String, word: String, replacement: String): String {
    var result = ""
    var index = 0
    while index < text.length() {
        var text_length = text.length()
        var word_length = word.length()
        if text.slice(index, text_length).starts_with(word) and not is_word_character_at(text, index - 1) and not is_word_character_at(text, index + word_length) {
            result = "{result}{replacement}"
            index = index + word.length()
        } else {
            result = "{result}{text.slice(index, index + 1)}"
            index = index + 1
        }
    }
    return result
}

func is_word_character_at(text: String, index: Integer): Boolean {
    if index < 0 or index >= text.length() {
        return false
    }
    var character = text.slice(index, index + 1)
    return character == "_" or character == "." or character.lower_case() != character.upper_case() or "0123456789".contains(character)
}

func class_view_source(information: Analysis.ClassInfo, display_name: String): String {
    var lines = List<String>()
    lines.append("type {display_name} \{")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        var field_type = field.type
        lines.append("    {field.name}: {type_display_name(field_type)}")
        field_index = field_index + 1
    }
    var index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if not function.is_constructor {
            lines.append("    {built_in_signature(function)}")
        }
        index = index + 1
    }
    lines.append("}")
    return lines.join("\n")
}

func is_instantiated_class(information: Analysis.ClassInfo): Boolean {
    return not information.is_generic_template and not information.is_container and not information.codegen_types.is_empty()
}

func instantiated_class_names(): List<String> {
    var names = List<String>()
    var index = 0
    while index < classes.count() {
        if is_instantiated_class(classes[index]) {
            var instantiated_name = instantiated_class_name(classes[index])
            names.append(instantiated_name)
        }
        index = index + 1
    }
    return names
}

func instantiated_class_sources(): List<String> {
    var sources = List<String>()
    var index = 0
    while index < classes.count() {
        if is_instantiated_class(classes[index]) {
            var instantiated_name = instantiated_class_name(classes[index])
            var view_source = class_view_source(classes[index], instantiated_name)
            sources.append(view_source)
        }
        index = index + 1
    }
    return sources
}

func instantiated_class_name(information: Analysis.ClassInfo): String {
    var name = information.simple_name
    var index = 0
    while index < information.codegen_types.count() {
        name = "{name}{codegen_value_name(information, index)}"
        index = index + 1
    }
    return name
}

func codegen_value_name(information: Analysis.ClassInfo, index: Integer): String {
    crash information.codegen_codes[index]
    if information.codegen_codes[index].is_empty() {
        return type_display_name(information.codegen_types[index])
    }
    var code = information.codegen_codes[index]
    var code_length = code.length()
    return "{code.slice(0, 1).upper_case()}{code.slice(1, code_length)}"
}

func emitted_qualified_names(): List<String> {
    var names = List<String>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if information.is_emitted and not is_instantiated_class(information) {
            names.append(information.qualified_dotted)
        }
        index = index + 1
    }
    return names
}

func built_in_signature(function: Analysis.FunctionInfo): String {
    var parameters = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter_type = function.parameters[index].type
        var display_name = type_display_name(parameter_type)
        parameters.append(display_name)
        index = index + 1
    }
    var signature = "{function.name}({parameters.join(", ")})"
    var function_return_type = function.return_type
    if type_shape.is_void(function_return_type) {
        return signature
    }
    return "{signature}: {type_display_name(function_return_type)}"
}

func emit_system_classes(system_structs: String, system_prototypes: String, system_bodies: String) {
    var string_spite_type = string_type()
    ensure_list(string_spite_type)
    builder.add_typedef(system_structs)
    builder.add_prototype(system_prototypes)
    builder.add_support(system_bodies)
}

func generate(
    discovery: Discovery.DiscoveryResult,
    runtime_header_text: String,
    system_structs: String,
    system_prototypes: String,
    system_bodies: String,
): String {
    entry_class_c_name = discovery.entry_mangled_name
    loaded_folders = discovery.loaded_folders
    checkout_folders = discovery.checkout_folders
    version_notes = discovery.version_notes
    var allocator = allocator_text()
    var header_text = runtime_header_text.replace("/*spite_allocator*/", allocator)
    builder.add_typedef(header_text)
    builder.add_typedef(
        "#define SPITE_COLD_PATH __attribute__((noinline))\n#define SPITE_CRASH_PATH __attribute__((cold))\n#define SPITE_CRASH_REPORT __attribute__((noinline, cold, noreturn))\nstatic const char* spite_assert_trace[32];\nstatic uint64_t spite_assert_runs[32];\nstatic int64_t spite_assert_total = 0;\nstatic const char* spite_assert_newest = 0;\nstatic uint64_t spite_assert_newest_count = 0;\nstatic inline uint64_t spite_assert_run(const char* spite_site, int64_t spite_entry) \{ return ((uint64_t)(uintptr_t)spite_site << 32) | (((uint64_t)spite_entry & 0xffu) << 24) | 1u; }\n#ifdef SPITE_THREADS\nstatic SPITE_COLD_PATH void spite_ring_assert(const char* spite_site) \{\nfor (int32_t spite_waited = 0; spite_waited < 1000;) \{\nint64_t spite_newest = __atomic_load_n(&spite_assert_total, __ATOMIC_ACQUIRE) - 1;\nif (spite_newest < 0) break;\nuint64_t spite_run = __atomic_load_n(&spite_assert_runs[spite_newest % 32], __ATOMIC_ACQUIRE);\nif (((spite_run >> 24) & 0xffu) != ((uint64_t)spite_newest & 0xffu)) \{ spite_waited = spite_waited + 1; continue; }\nif ((uint32_t)(spite_run >> 32) != (uint32_t)(uintptr_t)spite_site || (spite_run & 0xffffffu) == 0xffffffu) break;\nif (__atomic_compare_exchange_n(&spite_assert_runs[spite_newest % 32], &spite_run, spite_run + 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;\n}\nint64_t spite_taken = __atomic_fetch_add(&spite_assert_total, 1, __ATOMIC_ACQ_REL);\n__atomic_store_n(&spite_assert_trace[spite_taken % 32], spite_site, __ATOMIC_RELAXED);\n__atomic_store_n(&spite_assert_runs[spite_taken % 32], spite_assert_run(spite_site, spite_taken), __ATOMIC_RELEASE);\n}\nstatic uint64_t spite_assert_count(int64_t spite_index) \{ return __atomic_load_n(&spite_assert_runs[spite_index % 32], __ATOMIC_ACQUIRE) & 0xffffffu; }\n#else\nstatic SPITE_COLD_PATH void spite_ring_assert(const char* spite_site) \{\nif (spite_site == spite_assert_newest) \{ spite_assert_newest_count = spite_assert_newest_count + 1; return; }\nif (spite_assert_total > 0) spite_assert_runs[(spite_assert_total - 1) % 32] = spite_assert_newest_count;\nspite_assert_trace[spite_assert_total % 32] = spite_site;\nspite_assert_total = spite_assert_total + 1;\nspite_assert_newest = spite_site;\nspite_assert_newest_count = 1;\n}\nstatic uint64_t spite_assert_count(int64_t spite_index) \{ return spite_index == spite_assert_total - 1 ? spite_assert_newest_count : spite_assert_runs[spite_index % 32]; }\n#endif\n#define SPITE_RING_ASSERT(site) spite_ring_assert(site)\nstatic int32_t spite_crashing = 0;\nstatic void (*spite_crash_chain)(void) = 0;\nstatic inline void spite_crash_text(const char* spite_bytes, int64_t spite_length) \{\nint64_t spite_kept = spite_length > 80 ? 80 : spite_length;\nwhile (spite_kept > 0 && spite_kept < spite_length && (spite_bytes[spite_kept] & 0xC0) == 0x80) spite_kept = spite_kept - 1;\nfwrite(spite_bytes, 1, (size_t)spite_kept, stderr);\nif (spite_kept < spite_length) fprintf(stderr, \"...(%lld bytes)\", (long long)spite_length);\n}\nstatic SPITE_CRASH_PATH void spite_crash_begin(void) \{\nif (__atomic_exchange_n(&spite_crashing, 1, __ATOMIC_ACQ_REL) != 0) \{ for (;;) \{ } }\n}\nstatic void spite_report_assert_trace(void) \{\nint64_t spite_total = __atomic_load_n(&spite_assert_total, __ATOMIC_ACQUIRE);\nint64_t spite_kept = spite_total < 32 ? spite_total : 32;\nfor (int64_t spite_index = spite_total - spite_kept; spite_index < spite_total; spite_index = spite_index + 1) \{\nconst char* spite_site = spite_assert_trace[spite_index % 32];\nif (spite_site == 0) continue;\nuint64_t spite_repeats = spite_assert_count(spite_index);\nwhile (spite_index + 1 < spite_total && spite_assert_trace[(spite_index + 1) % 32] == spite_site) \{ spite_index = spite_index + 1; spite_repeats = spite_repeats + spite_assert_count(spite_index); }\nif (spite_repeats > 1) \{ fwrite(spite_site, 1, strlen(spite_site) - 1, stderr); fprintf(stderr, \"\\trepeated=%llu\\n\", (unsigned long long)spite_repeats); } else \{ fputs(spite_site, stderr); }\n}\nif (spite_total > 32) \{ fprintf(stderr, \"spite.assert\\tearlier=%lld\\n\", (long long)(spite_total - 32)); }\nif (spite_crash_chain != 0) spite_crash_chain();\n}",
    )
    var traced = "#define SPITE_TRACE_ASSERT(site) (SPITE_RING_ASSERT(site))"
    var untraced = "#define SPITE_TRACE_ASSERT(site) ((void)0)"
    if trace_asserts {
        traced = "#define SPITE_TRACE_ASSERT(site) (fflush(stdout), fputs((site), stderr), SPITE_RING_ASSERT(site))"
        untraced = "#define SPITE_TRACE_ASSERT(site) (fflush(stdout), fputs((site), stderr))"
    }
    var trace_macro = builder.type_placeholder_if_kept("spite_report_assert_trace", traced, untraced)
    builder.add_typedef(trace_macro)
    register_classes(discovery.class_files)
    emit_enums()
    var string_layout_position = builder.typedef_count()
    builder.add_typedef("")
    var forward_index = 0
    while forward_index < classes.count() {
        if not classes[forward_index].is_value_class {
            builder.add_typedef("typedef struct {classes[forward_index].c_name} {classes[forward_index].c_name};")
        }
        forward_index = forward_index + 1
    }
    emit_system_classes(system_structs, system_prototypes, system_bodies)
    resolve_union_members()
    resolve_generic_constraints()
    emit_unions()
    resolve_classes(discovery.class_files)
    classes_resolved = true
    check_pending_constraints()
    make_allocator_union()
    report_shadowed_functions(discovery.class_files)
    call_effects.study(discovery.class_files, this)
    item_values_on = studies_item_values()
    if item_values_on {
        item_values.study(discovery.class_files)
    }
    overlap_allowed = not hot_reload and not read_evaluate_print_loop and not development
    var string_layout_code = string_layout()
    builder.replace_typedef(string_layout_position, string_layout_code)
    check_number_memory()
    if has_error {
        return ""
    }
    if reload_host {
        prepare_partial(reload_host)
    }
    var index = 0
    while index < classes.count() {
        if not classes[index].is_generic_template {
            emit_class(classes[index])
        }
        index = index + 1
    }
    emit_pending_functions()
    emit_all_classes_function()
    if read_evaluate_print_loop {
        var looped_class = find_class_by_c_name(discovery.entry_mangled_name)
        if looped_class {
            ensure_symbol("program")
            var class_type = class_type_of(looped_class)
            ensure_reflect_function(class_type)
        }
    }
    var settle = 0
    while settle < 4 {
        emit_class_object_bodies()
        emit_namespace_object_bodies()
        emit_functions_function_bodies()
        emit_pending_functions()
        settle = settle + 1
    }
    if read_evaluate_print_loop and not reload_host {
        emit_loop_singletons()
    }
    settle_shape_members()
    emit_shape_bodies()
    emit_union_class_of_bodies()
    emit_union_attributes_bodies()
    var final_settle = 0
    while final_settle < 4 {
        emit_class_object_bodies()
        emit_namespace_object_bodies()
        emit_functions_function_bodies()
        emit_attribute_object_bodies()
        emit_pending_functions()
        emit_late_shape_callers()
        emit_pending_functions()
        final_settle = final_settle + 1
    }
    emit_foreign_libraries()
    emit_symbol_table()
    if debug_memory {
        emit_allocation_table()
    }
    if scheduler_used and not has_error {
        emit_state_machines()
    }
    if scheduler_used or remote_loop_port > 0 or hot_reload {
        finish_waiting_points()
    }
    if scheduler_used and not has_error {
        emit_primitive_machines()
    }
    emit_main(discovery.launcher_mangled_name)
    emit_pending_functions()
    while emit_late_shape_callers() > 0 {
        emit_pending_functions()
    }
    emit_attribute_object_bodies()
    while refresh_functions_lists() or refresh_accesses_table() {
        emit_class_object_bodies()
        emit_namespace_object_bodies()
        emit_functions_function_bodies()
        emit_attribute_object_bodies()
        emit_pending_functions()
    }
    while emit_late_shape_callers() > 0 {
        emit_pending_functions()
    }
    while release_new_class_objects() {
        emit_class_object_bodies()
        emit_namespace_object_bodies()
        emit_functions_function_bodies()
        emit_attribute_object_bodies()
        emit_pending_functions()
    }
    finish_main()
    emit_pending_functions()
    emit_union_deep_copy_bodies()
    refresh_union_releases()
    finish_wait_questions()
    if overlap_groups > 0 {
        finish_overlap_groups()
    }
    if row_groups > 0 {
        finish_row_groups()
    }
    if parallel_used {
        finish_singleton_guards()
    }
    if parallel_used or guard_count_asked {
        finish_guard_count()
    }
    if builder.threads {
        finish_skipped_guards()
    }
    if not coarse_site_owners.is_empty() {
        finish_coarse_loops()
    }
    if not lend_site_owners.is_empty() {
        finish_lend_sites()
    }
    if parallel_used and not weak_classes.is_empty() {
        report_weak_across_threads()
    }
    if not parallel_site_keys.is_empty() {
        report_endless_parallel_work()
    }
    if not atomic_classes.is_empty() {
        finish_atomic_singletons()
    }
    if not outside_classes.is_empty() {
        finish_outside_writes()
    }
    if not has_error {
        report_unused_attributes()
    }
    finish_allocated_classes()
    finish_allocator_reads()
    slot_live_supports()
    emit_live_support()
    emit_migrations()
    emit_hot_reload_support()
    if reload_host and not has_error {
        partial_refusal = partial_problem(reload_host)
    }
    builder.shakes = not keeps_internals
    builder.hot_reload = hot_reload
    builder.folds = not hot_reload and not read_evaluate_print_loop and not reload_host
    builder.counts_by_class = not hot_reload and not read_evaluate_print_loop and not reload_host
    builder.debug_memory = debug_memory
    builder.constant_texts = constant_texts
    if item_values_on {
        item_values.settle()
        builder.apply_item_values(item_values)
    }
    var rendered = ""
    if renders_program {
        rendered = builder.render()
    }
    if not always_crashing_functions.is_empty() {
        report_always_crashing()
    }
    return rendered
}

func register_classes(discovered: List<Discovery.DiscoveredClass>) {
    first_discovered_class = classes.count()
    var index = 0
    while index < discovered.count() {
        var entry = discovered[index]
        var value_type = value_type_named(entry.qualified_dotted)
        if value_type {
            var value_c_name = entry.qualified_dotted.replace(".", "_")
            var value_class = Analysis.ClassInfo(
                "Spite{value_c_name}",
                entry.qualified_dotted,
                "",
                entry.qualified_dotted,
                0,
            )
            value_class.is_value_class = true
            classes.append(value_class)
        } else {
            var class_id = allocate_class_id(entry.mangled_name)
            var discovered_class = Analysis.ClassInfo(
                entry.mangled_name,
                entry.simple_name,
                entry.namespace_dotted,
                entry.qualified_dotted,
                class_id,
            )
            classes.append(discovered_class)
        }
        var registered = classes.last()
        crash registered
        note_pinned_versions(entry)
        registered.source_path = entry.file.path
        registered.entry_index = index
        registered.codegen_names = declared_codegen_names(entry)
        registered.is_singleton = has_singleton_line(entry)
        registered.holds_nothing = registered.is_singleton and holds_nothing(entry)
        registered.is_stateless_singleton = registered.holds_nothing and not keeps_internals
        registered.is_generic_template = not registered.codegen_names.is_empty()
        discovered_classes.append(entry)
        register_enums(entry)
        register_unions(entry)
        register_shapes(entry)
        index = index + 1
    }
}

func has_singleton_line(entry: Discovery.DiscoveredClass): Boolean {
    var file = entry.file
    var statement_index = 0
    while statement_index < file.statements.count() {
        if shape.as_singleton_declaration(file.statements[statement_index]) {
            return true
        }
        statement_index = statement_index + 1
    }
    return false
}

func holds_nothing(entry: Discovery.DiscoveredClass): Boolean {
    var file = entry.file
    var statement_index = 0
    while statement_index < file.statements.count() {
        var statement = file.statements[statement_index]
        var declaration = shape.as_variable_declaration(statement)
        if declaration {
            if not declaration.hardcoded_value {
                return false
            }
        }
        var function_declaration = shape.as_function_declaration(statement)
        if function_declaration {
            if function_declaration.name == "drop" {
                return false
            }
        }
        statement_index = statement_index + 1
    }
    return true
}

func is_stateless_singleton(information: Analysis.ClassInfo): Boolean {
    return information.is_stateless_singleton
}

func declared_codegen_names(entry: Discovery.DiscoveredClass): List<String> {
    var file = entry.file
    var declared = List<String>()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var generic_line = shape.as_generic_declaration(file.statements[statement_index])
        if generic_line {
            var bare_name = without_dollar(generic_line.name)
            declared.append(bare_name)
        }
        statement_index = statement_index + 1
    }
    return declared
}

func without_dollar(name: String): String {
    if name.starts_with("$") {
        var name_length = name.length()
        return name.slice(1, name_length)
    }
    return name
}

func codegen_index(information: Analysis.ClassInfo, name: String): Integer {
    var index = 0
    while index < information.codegen_names.count() {
        if information.codegen_names[index] == name {
            if index < information.codegen_types.count() {
                return index
            }
        }
        index = index + 1
    }
    return 0 - 1
}

func generate_codegen_value(name: String, class_information: Analysis.ClassInfo): ExpressionResult {
    var bound = codegen_index(class_information, name)
    if bound >= 0 {
        crash class_information.codegen_codes[bound]
        if class_information.codegen_codes[bound].is_empty() {
            report("'${name}' is a type here, so it cannot be used as a value")
            return void_result()
        }
        crash class_information.codegen_types[bound]
        var bound_value = ExpressionResult(
            class_information.codegen_codes[bound],
            class_information.codegen_types[bound],
        )
        bound_value.owning_override = false
        crash class_information.codegen_texts[bound]
        bound_value.constant_text = class_information.codegen_texts[bound]
        return bound_value
    }
    report(
        "'{class_information.simple_name}' has no 'generic ${name}' line, and '$' is for generics only: a program's settings are fields of Environment, so reopen it in environment.spite with 'var {name} = ...' and read it through 'var environment = Environment()' as 'environment.{name}'",
    )
    return void_result()
}

func walked_name_condition(expression: Syntax.Expressions.Expression): Boolean? {
    var called = shape.as_call(expression)
    assert not bound_symbol_name.is_empty() and not bound_field_name.is_empty() and called
    crash called.callee
    var method = shape.as_member(called.callee)
    assert method and called.arguments.count() == 1
    crash method.object
    var read = shape.as_member(method.object)
    var given = shape.as_string_literal(called.arguments[0])
    assert read and given
    crash read.object
    var symbol = shape.as_identifier(read.object)
    assert symbol and read.name == "name"
    assert symbol.name == bound_symbol_name
    switch method.name {
        "starts_with": return bound_field_name.starts_with(given.value)
        "ends_with": return bound_field_name.ends_with(given.value)
        _: return null
    }
}

func walked_singleton_condition(expression: Syntax.Expressions.Expression): Boolean? {
    var read = shape.as_member(expression)
    assert read and not bound_symbol_name.is_empty() and bound_field_index >= 0 and bound_field_type
    assert read.name == "is_singleton"
    crash read.object
    assert is_identifier_named(read.object, bound_symbol_name)
    return singleton_type(bound_field_type)
}

func constant_condition(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var generic_identifier = shape.as_generic_identifier(expression)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var value = generate_codegen_value(bare_name, class_information)
        var value_type = value.type
        if is_boolean_type(value_type) {
            return value.code == "true"
        }
        return null
    }
    var reflected_answer = reflected_condition(expression, scope, class_information)
    if reflected_answer == true or reflected_answer == false {
        return reflected_answer
    }
    if bound_value_present(expression, scope, class_information) {
        return true
    }
    var asked = function_question(expression, class_information)
    if asked == true or asked == false {
        return asked
    }
    var walked_answer = walked_name_condition(expression)
    if walked_answer == true or walked_answer == false {
        return walked_answer
    }
    var walked_singleton = walked_singleton_condition(expression)
    if walked_singleton == true or walked_singleton == false {
        return walked_singleton
    }
    var setting_text = hardcoded_setting_text(expression, scope, class_information)
    if setting_text {
        if setting_text == "b:true" or setting_text == "b:false" {
            return setting_text == "b:true"
        }
        return null
    }
    var unary = shape.as_unary(expression)
    if unary {
        if unary.operator == 'logical_not' {
            if unary.operand {
                var inner = constant_condition(unary.operand, scope, class_information)
                if inner == true {
                    return false
                }
                if inner == false {
                    return true
                }
                return null
            }
        }
        return null
    }
    var binary = shape.as_binary(expression)
    if binary {
        if binary.left {
            if binary.right {
                if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
                    var left_constant = constant_condition(binary.left, scope, class_information)
                    var decided_by_left = left_constant == false and binary.operator == 'logical_and' or left_constant == true and binary.operator == 'logical_or'
                    if decided_by_left {
                        mark_names_used_in(binary.right, scope)
                        return left_constant == true
                    }
                    var right_constant = constant_condition(binary.right, scope, class_information)
                    if (left_constant == true or left_constant == false) and (right_constant == true or right_constant == false) {
                        if binary.operator == 'logical_and' {
                            return left_constant == true and right_constant == true
                        }
                        return left_constant == true or right_constant == true
                    }
                    return null
                }
                var counted = folded_count_comparison(binary, class_information)
                if counted == true or counted == false {
                    return counted
                }
                if binary.operator == 'equal' or binary.operator == 'not_equal' {
                    var copied_same = copied_class_is(binary.left, binary.right, scope, class_information)
                    if copied_same == true {
                        return binary.operator == 'equal'
                    }
                    if copied_same == false {
                        return binary.operator == 'not_equal'
                    }
                    var walked_same = walked_class_is(binary.left, binary.right, class_information)
                    if walked_same == true {
                        return binary.operator == 'equal'
                    }
                    if walked_same == false {
                        return binary.operator == 'not_equal'
                    }
                    if codegen_is_class(binary.right, class_information) and not shape.as_generic_identifier(binary.left) {
                        return known_codegen_class_test(binary, scope, class_information)
                    }
                    var left_generic = shape.as_generic_identifier(binary.left)
                    if left_generic {
                        var bare_name = without_dollar(left_generic.name)
                        var bound_type = codegen_bound_type(bare_name, class_information)
                        if bound_type {
                            var same_kind = type_test(bound_type, binary.right, class_information)
                            if binary.operator == 'equal' {
                                return same_kind
                            }
                            return not same_kind
                        }
                    }
                    var member_type = codegen_member_chain_type(binary.left, class_information)
                    if member_type {
                        var same_member_kind = type_test(member_type, binary.right, class_information)
                        if binary.operator == 'equal' {
                            return same_member_kind
                        }
                        return not same_member_kind
                    }
                    var left_text = folded_text(binary.left, scope, class_information)
                    var right_text = constant_text(binary.right)
                    if left_text {
                        if right_text {
                            var same = left_text == right_text
                            if binary.operator == 'equal' {
                                return same
                            }
                            return not same
                        }
                    }
                }
            }
        }
    }
    return null
}

func copied_class_is(
    left: Syntax.Expressions.Expression,
    right: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    assert in_specialised_copy
    var named = shape.as_identifier(left)
    assert named
    var value_type = scope.lookup_type(named.name)
    assert value_type
    assert not type_shape.as_nullable(value_type) and not type_shape.as_union(value_type)
    var tested = resolve_tested_class(right, class_information)
    assert tested
    var reaching = reaching_class_of(value_type)
    assert reaching
    return reaching.c_name == tested.c_name
}

func function_question(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): Boolean? {
    var call = shape.as_call(expression)
    assert call
    return folded_function_question(call, class_information)
}

func folded_function_question(
    call: Syntax.Expressions.CallExpression,
    class_information: Analysis.ClassInfo,
): Boolean? {
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    switch member.name {
        "fits_vector": return fits_vector_question(member.object, call.arguments, class_information)
        "function_writes_parameter": return parameter_write_question(member.object, call.arguments, class_information)
        "any_attribute_fits_vector": return inline_attribute_question(member.object, call.arguments, class_information)
        "has_state": return state_question(member.object, call.arguments, class_information)
        _: assert member.name == "has_function" or member.name == "function_waits"
    }
    var symbol_class = shape.as_member(member.object)
    if symbol_class {
        return symbol_function_question(symbol_class, member.name, call.arguments, class_information)
    }
    var generic_identifier = shape.as_generic_identifier(member.object)
    assert generic_identifier
    var bare_name = without_dollar(generic_identifier.name)
    var bound = codegen_index(class_information, bare_name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    var pattern = written_name(call.arguments)
    if pattern {
        crash class_information.codegen_types[bound]
        var bound_class_ref = type_shape.as_class_ref(class_information.codegen_types[bound])
        if bound_class_ref {
            var owner = find_class_by_c_name(bound_class_ref.c_name)
            crash owner
            return class_function_answer(owner, member.name, pattern, class_information)
        }
        return false
    }
    var example = "run_each"
    if member.name == "function_waits" {
        example = "update_each"
    }
    report(
        "'${bare_name}.{member.name}(...)' is decided while compiling, so the name it asks for is written as a literal: '${bare_name}.{member.name}(\"{example}\")', or a pattern such as \"<phase>_each\"",
    )
    return false
}

func walked_class_is(
    left: Syntax.Expressions.Expression,
    right: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var symbol_class = shape.as_member(left)
    assert symbol_class
    assert symbol_class.name == "class" and not bound_symbol_name.is_empty()
    crash symbol_class.object
    var symbol_identifier = shape.as_identifier(symbol_class.object)
    assert symbol_identifier
    assert symbol_identifier.name == bound_symbol_name
    assert bound_field_type
    var right_generic = shape.as_generic_identifier(right)
    if right_generic {
        var right_name = without_dollar(right_generic.name)
        var right_type = codegen_bound_type(right_name, class_information)
        assert right_type
        return exact_type_label(bound_field_type) == exact_type_label(right_type)
    }
    var tested = try_resolve_static_path(right, class_information.qualified_dotted)
    assert tested
    if type_shape.as_nullable(bound_field_type) {
        return false
    }
    var field_class = class_of_type(bound_field_type)
    if field_class {
        return field_class.c_name == tested.c_name
    }
    return false
}

func class_fits_vector(described: Analysis.ClassInfo): Boolean {
    if described.is_value_class {
        return true
    }
    if described.is_generic_template {
        return false
    }
    var described_type: Analysis.SpiteType = Analysis.Types.ClassRefType(described.c_name)
    var problem = vector_item_problem(described_type)
    return problem.is_empty()
}

func fits_vector_question(
    subject: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var asked = asked_item_type(subject, class_information)
    assert asked and arguments.is_empty()
    var problem = vector_item_problem(asked)
    return problem.is_empty()
}

func state_question(
    subject: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var asked = asked_item_type(subject, class_information)
    assert asked
    if not arguments.is_empty() {
        var written = Syntax.SourcePrinter().source_expression(subject)
        report("'{written}.has_state()' is decided while compiling, and it takes nothing: '{written}.has_state()'")
        return false
    }
    var asked_class_ref = type_shape.as_class_ref(asked)
    if not asked_class_ref {
        return false
    }
    var owner = find_class_by_c_name(asked_class_ref.c_name)
    crash owner
    var visited = List<String>()
    return class_has_state(owner, visited)
}

func class_has_state(owner: Analysis.ClassInfo, visited: List<String>): Boolean {
    if visited.contains(owner.c_name) or owner.is_value_class {
        return false
    }
    visited.append(owner.c_name)
    var functions = declared_functions_of(owner)
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        var studied = not function.is_constructor and function.name != "drop" and function.has_body
        if studied and parameter_writes.answer(this, owner, function, "this") {
            var why = parameter_writes.reason_of(function.c_name, "this")
            writes_reasons.append("'{owner.simple_name}.{function.name}' writes its own attributes {why}")
            return true
        }
        if studied and parameter_writes.writes(function.c_name, "shared") {
            var shared_why = parameter_writes.reason_of(function.c_name, "shared")
            writes_reasons.append("'{owner.simple_name}.{function.name}' writes a singleton {shared_why}")
            return true
        }
        index = index + 1
    }
    var field_index = 0
    while field_index < owner.fields.count() {
        var field_type = owner.fields[field_index].type
        var field_class_ref = type_shape.as_class_ref(field_type)
        if field_class_ref {
            var bound = find_class_by_c_name(field_class_ref.c_name)
            if bound and bound.is_singleton and class_has_state(bound, visited) {
                return true
            }
        }
        field_index = field_index + 1
    }
    return false
}

func asked_item_type(
    subject: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var generic_identifier = shape.as_generic_identifier(subject)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var bound = codegen_index(class_information, bare_name)
        assert bound >= 0
        crash class_information.codegen_codes[bound]
        assert class_information.codegen_codes[bound].is_empty()
        return class_information.codegen_types[bound]
    }
    var symbol_class = shape.as_member(subject)
    if symbol_class {
        crash symbol_class.object
        var symbol_identifier = shape.as_identifier(symbol_class.object)
        assert symbol_identifier
        assert symbol_class.name == "class" and not bound_symbol_name.is_empty()
        assert symbol_identifier.name == bound_symbol_name
        return bound_field_type
    }
    var named = try_resolve_static_path(subject, class_information.qualified_dotted)
    assert named
    return class_type_of(named)
}

func argument_count_call(expression: Syntax.Expressions.Expression): Syntax.Expressions.CallExpression? {
    var call = shape.as_call(expression)
    assert call
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member
    assert member.name == "argument_count"
    return call
}

func folded_integer(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): Long? {
    var literal = shape.as_integer_literal(expression)
    if literal {
        return literal.value
    }
    var call = argument_count_call(expression)
    assert call
    var counted = folded_argument_count(call, class_information)
    assert counted
    var answer: Long = counted
    return answer
}

func folded_count_comparison(
    binary: Syntax.Expressions.BinaryExpression,
    class_information: Analysis.ClassInfo,
): Boolean? {
    crash binary.left
    crash binary.right
    var left_call = argument_count_call(binary.left)
    var right_call = argument_count_call(binary.right)
    assert left_call or right_call
    var left = folded_integer(binary.left, class_information)
    assert left
    var right = folded_integer(binary.right, class_information)
    assert right
    switch binary.operator {
        'equal': return left == right
        'not_equal': return left != right
        'less': return left < right
        'less_equal': return left <= right
        'greater': return left > right
        'greater_equal': return left >= right
        _: return null
    }
}

func folded_argument_count(call: Syntax.Expressions.CallExpression, class_information: Analysis.ClassInfo): Integer? {
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    var generic_identifier = shape.as_generic_identifier(member.object)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var bound = codegen_index(class_information, bare_name)
        assert bound >= 0
        crash class_information.codegen_codes[bound]
        assert class_information.codegen_codes[bound].is_empty()
        var pattern = counted_name(call.arguments, "${bare_name}")
        crash class_information.codegen_types[bound]
        var bound_class_ref = type_shape.as_class_ref(class_information.codegen_types[bound])
        if bound_class_ref {
            var owner = find_class_by_c_name(bound_class_ref.c_name)
            crash owner
            return class_argument_count(owner, pattern, class_information, "${bare_name}")
        }
        return 0
    }
    var walked = shape.as_identifier(member.object)
    if walked {
        assert walked.name == bound_symbol_name and not bound_symbol_name.is_empty()
        return walked_function_argument_count(call.arguments)
    }
    var symbol_class = shape.as_member(member.object)
    assert symbol_class
    assert symbol_class.name == "class" and not bound_symbol_name.is_empty()
    crash symbol_class.object
    var symbol_identifier = shape.as_identifier(symbol_class.object)
    assert symbol_identifier
    assert symbol_identifier.name == bound_symbol_name
    assert bound_field_type
    var bound_class_ref = type_shape.as_class_ref(bound_field_type)
    assert bound_class_ref
    assert not bound_class_ref.has_signature
    var owner = find_class_by_c_name(bound_class_ref.c_name)
    assert owner
    assert call.arguments.count() == 1
    var literal = shape.as_string_literal(call.arguments[0])
    assert literal
    return class_argument_count(owner, literal.value, class_information, "{bound_symbol_name}.class")
}

func counted_name(arguments: List<Syntax.Expressions.Expression>, asked: String): String {
    if arguments.count() == 1 {
        var literal = shape.as_string_literal(arguments[0])
        if literal {
            return literal.value
        }
    }
    report(
        "'{asked}.argument_count(...)' is decided while compiling, so the name it asks for is written as a literal: '{asked}.argument_count(\"update_each\")', or a pattern such as \"<phase>_each\"",
    )
    return ""
}

func walked_function_argument_count(arguments: List<Syntax.Expressions.Expression>): Integer {
    var range = bound_range.split(".")
    var last = range.last()
    var is_pattern = false
    if last {
        is_pattern = ("_{last}_").contains("_{bound_symbol_name}_") and not bound_function_name.is_empty()
    }
    if not is_pattern or not arguments.is_empty() {
        report(
            "'{bound_symbol_name}.argument_count()' is how many arguments the function a walk over functions stands for takes, so it is asked with no name in a template over a pattern, such as 'phase: Symbol<$system_type.phase_each>'",
        )
        return 0
    }
    range.remove_last()
    var owner = range_owner_class(range)
    crash owner
    var function = owner.find_function(bound_function_name)
    crash function
    return function.parameters.count()
}

func range_owner_class(path: List<String>): Analysis.ClassInfo? {
    var first = path.first()
    assert first
    crash current_class
    if first.starts_with("$") and path.count() == 1 {
        var bare_name = without_dollar(first)
        var bound_type = codegen_bound_type(bare_name, current_class)
        assert bound_type
        var bound_class_ref = type_shape.as_class_ref(bound_type)
        assert bound_class_ref
        return find_class_by_c_name(bound_class_ref.c_name)
    }
    var joined = path.join(".")
    return find_class(joined, current_class.namespace_dotted)
}

func class_argument_count(
    owner: Analysis.ClassInfo,
    pattern: String,
    asking: Analysis.ClassInfo,
    asked: String,
): Integer {
    if pattern.is_empty() {
        return 0
    }
    var wanted = List<String>()
    var opening = pattern.index_of("<")
    var closing = pattern.index_of(">")
    if opening < 0 or closing < opening {
        wanted.append(pattern)
    } else {
        var pattern_length = pattern.length()
        var prefix = pattern.slice(0, opening)
        var suffix = pattern.slice(closing + 1, pattern_length)
        var hole = pattern.slice(opening + 1, closing)
        var hole_values = hole_enum(asking, hole)
        if not hole_values {
            var missing = missing_hole_enum(asking, hole, pattern)
            report(missing)
            return 0
        }
        var value_index = 0
        while value_index < hole_values.values.count() {
            var value = hole_values.values[value_index]
            wanted.append("{prefix}{value}{suffix}")
            value_index = value_index + 1
        }
    }
    var functions = declared_functions_of(owner)
    var first = -1
    var same = true
    var fitting = List<String>()
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        var taken = function.parameters.count()
        if wanted.contains(function.name) {
            if first >= 0 and first != taken {
                same = false
            }
            if first < 0 {
                first = taken
            }
            fitting.append("'{function.name}' {taken}")
        }
        index = index + 1
    }
    if first < 0 {
        return 0
    }
    if not same {
        report(
            "'{asked}.argument_count(\"{pattern}\")' has no one answer: the functions of '{owner.qualified_dotted}' that fit it take different numbers of arguments ({fitting.join(", ")}), so ask 'phase.argument_count()' in a template over them, where each is walked on its own",
        )
    }
    return first
}

func class_function_answer(
    owner: Analysis.ClassInfo,
    question: String,
    pattern: String,
    asking: Analysis.ClassInfo,
): Boolean {
    if question == "function_waits" {
        return class_function_waits(owner, pattern, asking)
    }
    return class_has_function(owner, pattern, asking)
}

func symbol_function_question(
    symbol_class: Syntax.Expressions.MemberExpression,
    question: String,
    arguments: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Boolean? {
    assert symbol_class.name == "class" and not bound_symbol_name.is_empty()
    crash symbol_class.object
    var symbol_identifier = shape.as_identifier(symbol_class.object)
    assert symbol_identifier
    assert symbol_identifier.name == bound_symbol_name
    assert bound_field_type
    var pattern = written_name(arguments)
    assert pattern
    var bound_class_ref = type_shape.as_class_ref(bound_field_type)
    assert bound_class_ref
    assert not bound_class_ref.has_signature
    var owner = find_class_by_c_name(bound_class_ref.c_name)
    assert owner
    return class_function_answer(owner, question, pattern, class_information)
}

func written_name(arguments: List<Syntax.Expressions.Expression>): String? {
    assert arguments.count() == 1
    var folded_name = folded_name_text(arguments[0])
    if folded_name {
        return folded_name
    }
    var enum_literal = shape.as_enum_literal(arguments[0])
    assert enum_literal
    report(
        "'{enum_literal.value}' in single quotes is a symbol, and 'has_function' takes the name as text: text is always written in double quotes, so write \"{enum_literal.value}\"",
    )
    return enum_literal.value
}

func folded_name_text(expression: Syntax.Expressions.Expression): String? {
    var string_literal = shape.as_string_literal(expression)
    if string_literal {
        return string_literal.value
    }
    var joined = shape.as_binary(expression)
    if joined {
        assert joined.is_text_join
        crash joined.left
        crash joined.right
        var left = folded_name_text(joined.left)
        assert left
        var right = folded_name_text(joined.right)
        assert right
        return left + right
    }
    var member = shape.as_member(expression)
    assert member and not bound_symbol_name.is_empty()
    assert member.name == "name"
    crash member.object
    assert is_identifier_named(member.object, bound_symbol_name)
    if not bound_display_name.is_empty() {
        return bound_display_name
    }
    return bound_field_name
}

func folded_returned_text(
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash call.callee
    var member = shape.as_member(call.callee)
    crash member
    crash member.object
    var asked = operand_text(member.object)
    var asked_generic = shape.as_generic_identifier(member.object)
    if asked_generic {
        asked = "${without_dollar(asked_generic.name)}"
    }
    var mentioned = List<String>()
    collect_each_mentioned_name(call.arguments, mentioned)
    mark_each_used(mentioned, scope)
    var owner = asked_function_owner(member.object, class_information)
    if not owner {
        report(
            "'{asked}.returned_text(...)' is decided while compiling, so it is asked of a generic's type or of the class a walk visits, like '$value_type.returned_text(\"json_key_\{attribute.name}\")'",
        )
        return void_result()
    }
    var name: String? = null
    if call.arguments.count() == 1 {
        name = folded_name_text(call.arguments[0])
    }
    if not name {
        report(
            "'{asked}.returned_text(...)' is decided while compiling, so the name it asks for is written as a literal: '{asked}.returned_text(\"json_key_level\")', or with a walked symbol's name in it, '\"json_key_\{attribute.name}\"'",
        )
        return void_result()
    }
    var function = owner.find_function(name)
    if not function {
        report(
            "'{asked}.returned_text(\"{name}\")' reads the text a function of '{owner.qualified_dotted}' returns, and it has no function '{name}': ask '{asked}.has_function(\"{name}\")' first, and read the text only in the branch where it is true",
        )
        return void_result()
    }
    var literal = returned_literal(function)
    if not literal {
        report_unliteral_body(owner, function, "'{asked}.returned_text(\"{name}\")' reads it while compiling")
        return void_result()
    }
    var rendered = render_string_literal(literal)
    var text_type = string_type()
    var text = ExpressionResult(rendered, text_type)
    text.constant_text = "s:{literal}"
    return text
}

func asked_function_owner(
    subject: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var generic_identifier = shape.as_generic_identifier(subject)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var bound = codegen_index(class_information, bare_name)
        assert bound >= 0
        crash class_information.codegen_codes[bound]
        assert class_information.codegen_codes[bound].is_empty()
        crash class_information.codegen_types[bound]
        var bound_class_ref = type_shape.as_class_ref(class_information.codegen_types[bound])
        assert bound_class_ref
        assert not bound_class_ref.has_signature
        return find_class_by_c_name(bound_class_ref.c_name)
    }
    assert is_symbol_class_read(subject)
    crash bound_field_type
    var walked_class_ref = type_shape.as_class_ref(bound_field_type)
    assert walked_class_ref
    assert not walked_class_ref.has_signature
    return find_class_by_c_name(walked_class_ref.c_name)
}

func literal_body(function: Analysis.FunctionInfo): Boolean {
    if not function.has_body or not function.parameters.is_empty() or function.body.count() != 1 {
        return false
    }
    var returned = shape.as_return_statement(function.body[0])
    if not returned {
        return false
    }
    if not returned.value {
        return false
    }
    if shape.as_string_literal(returned.value) {
        return true
    }
    return false
}

func returned_literal(function: Analysis.FunctionInfo): String? {
    assert function.has_body and function.parameters.is_empty() and function.body.count() == 1
    var returned = shape.as_return_statement(function.body[0])
    assert returned
    crash returned.value
    var literal = shape.as_string_literal(returned.value)
    assert literal
    return literal.value
}

func report_unliteral_body(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo, reason: String) {
    assert not unliteral_reported.contains(function.c_name)
    unliteral_reported.append(function.c_name)
    var saved_line = current_line
    var saved_path = current_path
    var saved_function = current_function
    var saved_owner = current_owner
    current_owner = owner.qualified_dotted
    current_function = function.name
    current_line = function.line
    current_path = owner.source_path
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    report(
        "'{owner.qualified_dotted}.{function.name}' must be written 'func {function.name}(): String \{ return \"...\" }', taking nothing and returning a literal text with no '\{...}' in it, since {reason}",
    )
    current_line = saved_line
    current_path = saved_path
    current_function = saved_function
    current_owner = saved_owner
}

func refuse_json_keys(information: Analysis.ClassInfo) {
    var saved_line = current_line
    var saved_path = current_path
    var saved_function = current_function
    var function_index = 0
    while function_index < information.declared_functions.count() {
        var function = information.declared_functions[function_index]
        if function.name.starts_with("json_key_") and function.has_body {
            refuse_json_key(information, function, saved_path)
        }
        function_index = function_index + 1
    }
    current_line = saved_line
    current_path = saved_path
    current_function = saved_function
}

func refuse_json_key(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, saved_path: String) {
    var name_length = function.name.length()
    var attribute_name = function.name.slice(9, name_length)
    if information.fields.find_by_name(attribute_name) {
        current_function = function.name
        current_line = function.line
        current_path = saved_path
        if not function.source_path.is_empty() {
            current_path = function.source_path
        }
        report(
            "'{information.simple_name}.{function.name}' would name the JSON key of '{attribute_name}', and JsonReader and JsonWriter do not read a function for it: a key that is not an attribute's name is given to the serializer in a map keyed by the attribute, '\{{information.simple_name}.attributes['{attribute_name}']: \"...\"}'",
        )
    }
}

func class_has_function(owner: Analysis.ClassInfo, pattern: String, asking: Analysis.ClassInfo): Boolean {
    var functions = declared_functions_of(owner)
    var names = functions.map_names()
    var opening = pattern.index_of("<")
    var closing = pattern.index_of(">")
    if opening < 0 or closing < opening {
        return names.contains(pattern)
    }
    var pattern_length = pattern.length()
    var prefix = pattern.slice(0, opening)
    var suffix = pattern.slice(closing + 1, pattern_length)
    var hole = pattern.slice(opening + 1, closing)
    var hole_values = hole_enum(asking, hole)
    if hole_values {
        var index = 0
        while index < hole_values.values.count() {
            var value = hole_values.values[index]
            if names.contains("{prefix}{value}{suffix}") {
                return true
            }
            index = index + 1
        }
        return false
    }
    var missing = missing_hole_enum(asking, hole, pattern)
    report(missing)
    return false
}

func wanted_function_names(pattern: String, asking: Analysis.ClassInfo): List<String> {
    var wanted = List<String>()
    var opening = pattern.index_of("<")
    var closing = pattern.index_of(">")
    if opening < 0 or closing < opening {
        wanted.append(pattern)
        return wanted
    }
    var pattern_length = pattern.length()
    var prefix = pattern.slice(0, opening)
    var suffix = pattern.slice(closing + 1, pattern_length)
    var hole = pattern.slice(opening + 1, closing)
    var hole_values = hole_enum(asking, hole)
    if not hole_values {
        var missing = missing_hole_enum(asking, hole, pattern)
        report(missing)
        return wanted
    }
    var value_index = 0
    while value_index < hole_values.values.count() {
        var value = hole_values.values[value_index]
        wanted.append("{prefix}{value}{suffix}")
        value_index = value_index + 1
    }
    return wanted
}

func parameter_write_question(
    object: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var asked = Syntax.SourcePrinter().source_expression(object)
    var pattern_literal: Syntax.Expressions.StringLiteralExpression? = null
    var asked_index: Long = -1
    if arguments.count() == 2 {
        pattern_literal = shape.as_string_literal(arguments[0])
        asked_index = asked_parameter_index(arguments[1])
    }
    if not pattern_literal or asked_index < 0 {
        report(
            "'{asked}.function_writes_parameter(...)' is decided while compiling, so it takes the function's name as text and the parameter's number, counted from 0, as a literal or as a walked argument's '.index': '{asked}.function_writes_parameter(\"last_each\", 1)'",
        )
        return false
    }
    var walked_function = ""
    if not shape.as_integer_literal(arguments[1]) {
        walked_function = bound_function_name
    }
    var asked_type = asked_item_type(object, class_information)
    assert asked_type
    var asked_class_ref = type_shape.as_class_ref(asked_type)
    if not asked_class_ref {
        return false
    }
    var owner = find_class_by_c_name(asked_class_ref.c_name)
    crash owner
    return class_writes_parameter(owner, pattern_literal.value, asked_index, walked_function, class_information)
}

func inline_attribute_question(
    subject: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var asked_type = asked_item_type(subject, class_information)
    assert asked_type
    var skipped = List<String>()
    var index = 0
    while index < arguments.count() {
        var named = try_resolve_static_path(arguments[index], class_information.qualified_dotted)
        if named {
            skipped.append(named.c_name)
        } else {
            var written = Syntax.SourcePrinter().source_expression(arguments[index])
            report(
                "'{written}' is not a class: 'any_attribute_fits_vector(...)' is decided while compiling, and what it is given are the classes whose attributes it skips, such as 'any_attribute_fits_vector(Entity)'",
            )
        }
        index = index + 1
    }
    var attribute_types = attribute_types_of(asked_type)
    var attribute_index = 0
    while attribute_index < attribute_types.count() {
        var attribute_type = attribute_types[attribute_index]
        var attribute_class_ref = type_shape.as_class_ref(attribute_type)
        if attribute_class_ref and not skipped.contains(attribute_class_ref.c_name) {
            var attribute_class = find_class_by_c_name(attribute_class_ref.c_name)
            if attribute_class and not attribute_class.is_value_class and class_fits_vector(attribute_class) {
                return true
            }
        }
        attribute_index = attribute_index + 1
    }
    return false
}

func attribute_types_of(asked_type: Analysis.SpiteType): List<Analysis.SpiteType> {
    var found = List<Analysis.SpiteType>()
    var shaped = type_shape.as_union(asked_type)
    if shaped {
        var information = find_union_by_c_name(shaped.c_name)
        crash information
        assert information.is_shape
        var field_index = 0
        while field_index < information.shape_fields.count() {
            var field_name = information.shape_fields[field_index].name
            var field_type = shape_field_type(information, field_name)
            if field_type {
                found.append(field_type)
            }
            field_index = field_index + 1
        }
        return found
    }
    var asked_class = class_of_type(asked_type)
    assert asked_class
    var attribute_index = 0
    while attribute_index < asked_class.fields.count() {
        var field = asked_class.fields[attribute_index]
        if field.spite_type {
            found.append(field.spite_type)
        }
        attribute_index = attribute_index + 1
    }
    return found
}

func asked_parameter_index(expression: Syntax.Expressions.Expression): Long {
    var literal = shape.as_integer_literal(expression)
    if literal {
        return literal.value
    }
    var read = shape.as_member(expression)
    if not read or bound_field_index < 0 or bound_symbol_name.is_empty() {
        return -1
    }
    crash read.object
    if read.name != "index" or not is_identifier_named(read.object, bound_symbol_name) {
        return -1
    }
    return bound_field_index
}

func class_writes_parameter(
    owner: Analysis.ClassInfo,
    pattern: String,
    asked_index: Long,
    walked_function: String,
    asking: Analysis.ClassInfo,
): Boolean {
    var wanted = wanted_function_names(pattern, asking)
    if not walked_function.is_empty() and wanted.contains(walked_function) {
        wanted = [walked_function]
    }
    var functions = declared_functions_of(owner)
    var writes = false
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if wanted.contains(function.name) and asks_about_parameter(owner, function, asked_index) {
            writes = true
        }
        index = index + 1
    }
    return writes
}

func asks_about_parameter(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo, asked_index: Long): Boolean {
    var position = 0
    while position < function.parameters.count() {
        if asked_index == position {
            var parameter = function.parameters[position]
            var slot: String = position
            var written = parameter_writes.answer(this, owner, function, slot)
            note_fact("asks writes {function.c_name} {slot} {written}")
            if not written {
                return false
            }
            var why = parameter_writes.reason_of(function.c_name, slot)
            writes_reasons.append("'{owner.simple_name}.{function.name}' writes its parameter '{parameter.name}' {why}")
            return true
        }
        position = position + 1
    }
    report(
        "'{owner.simple_name}.{function.name}' takes {function.parameters.count()} arguments, so it has no parameter {asked_index} to ask about: 'function_writes_parameter' counts parameters from 0",
    )
    return false
}

func class_function_waits(owner: Analysis.ClassInfo, pattern: String, asking: Analysis.ClassInfo): Boolean {
    var wanted = wanted_function_names(pattern, asking)
    if wanted.is_empty() {
        return false
    }
    settle_wait_facts()
    var functions = declared_functions_of(owner)
    var waits = false
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if wanted.contains(function.name) {
            var asked = "{owner.simple_name}.{function.name}"
            var answered = wait_facts.answer(
                function.c_name,
                asked,
                current_path,
                current_line,
                current_owner,
                current_function,
            )
            note_fact("asks waits {function.c_name}")
            if answered {
                waits = true
            }
        }
        index = index + 1
    }
    return waits
}

func settle_wait_facts() {
    var seeds = seeded_waiting_names.copy()
    var index = 0
    while index < waiting_functions.count() {
        if waiting_kinds[index] != "yield" {
            var waiting = waiting_functions[index]
            seeds.append(waiting.c_name)
        }
        index = index + 1
    }
    wait_facts.shape_callers.clear()
    wait_facts.shape_callees.clear()
    index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.is_shape {
            add_shape_wait_edges(information)
        }
        index = index + 1
    }
    wait_facts.settle(call_edge_callers, call_edge_callees, seeds)
}

func add_shape_wait_edges(information: Analysis.UnionInfo) {
    var name_index = 0
    while name_index < information.caller_names.count() {
        var name = information.caller_names[name_index]
        var member_index = 0
        while member_index < information.members.count() {
            var member = information.members[member_index]
            var called = member.find_function(name)
            if called {
                wait_facts.add_shape_edge("{information.c_name}___call_{name}", called.c_name)
            }
            member_index = member_index + 1
        }
        name_index = name_index + 1
    }
}

func note_wait_edge(callee: String) {
    assert not resumable_mode and not current_function_c_name.is_empty()
    wait_facts.add_edge(current_function_c_name, callee)
}

func value_call_key(arguments: List<Analysis.SpiteType>, returns: Analysis.SpiteType?): String {
    var pieces = List<String>()
    var pieces_index = 0
    while pieces_index < arguments.count() {
        var pieces_item = c_type_name(arguments[pieces_index])
        pieces.append(pieces_item)
        pieces_index = pieces_index + 1
    }
    var returned = "void"
    if returns {
        var returns_class = type_shape.as_class_ref(returns)
        var returns_nothing = false
        if returns_class {
            returns_nothing = returns_class.c_name == "Nothing"
        }
        if not returns_nothing and not type_shape.is_void(returns) {
            returned = c_type_name(returns)
        }
    }
    return "spite_value_call {returned}({pieces.join(", ")})"
}

func asks_function_waits(statements: List<Syntax.Statements.Statement>): Boolean {
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(statements, expressions)
    return expressions.any(expression_asks_waits)
}

func expression_asks_waits(expression: Syntax.Expressions.Expression): Boolean {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var member = shape.as_member(expression.callee)
            if member {
                if member.name == "function_waits" {
                    return true
                }
            }
            if expression_asks_waits(expression.callee) {
                return true
            }
            return any_expression_asks_waits(expression.arguments)
        }
        Syntax.Expressions.GenericCallExpression: return any_expression_asks_waits(expression.arguments)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if expression_asks_waits(expression.left) {
                return true
            }
            return expression_asks_waits(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return expression_asks_waits(expression.operand)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            if expression.name == "is_resumable" {
                return true
            }
            return expression_asks_waits(expression.object)
        }
        _: return false
    }
}

func any_expression_asks_waits(expressions: List<Syntax.Expressions.Expression>): Boolean {
    return expressions.any(expression_asks_waits)
}

func finish_wait_questions() {
    assert (not wait_facts.asked_names.is_empty() or function_waits_table_used) and not has_error
    settle_wait_facts()
    var changed = wait_facts.first_changed_answer()
    if changed >= 0 {
        crash wait_facts.asked_paths[changed]
        crash wait_facts.asked_lines[changed]
        crash wait_facts.asked_owners[changed]
        crash wait_facts.asked_functions[changed]
        crash wait_facts.asked_texts[changed]
        crash wait_facts.asked_names[changed]
        current_path = wait_facts.asked_paths[changed]
        current_line = wait_facts.asked_lines[changed]
        current_owner = wait_facts.asked_owners[changed]
        current_function = wait_facts.asked_functions[changed]
        var asked = wait_facts.asked_texts[changed]
        var asked_name = wait_facts.asked_names[changed]
        var now_waits = wait_facts.may_wait(asked_name)
        var before = not now_waits
        report(
            "whether '{asked}' can wait was answered {before} here, before the functions that ask 'function_waits' were compiled, and it is {now_waits} once they are: it reaches one of them, or a function value made in one, so its answer would decide itself, so ask from a function that '{asked}' does not reach",
        )
        return
    }
    if function_waits_table_used {
        emit_function_waits_table()
    }
}

func remember_accessed_call(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    assert not is_library_class(information) and not accessed_call_names.contains(function.c_name)
    accessed_call_names.append(function.c_name)
    accessed_call_owners.append(information)
    accessed_call_functions.append(function)
    accessed_call_lines.append("")
}

func refresh_accesses_table(): Boolean {
    var current = accesses_table_position >= 0 and accesses_table_count == accessed_call_names.count()
    if not function_accesses_used or current {
        return false
    }
    var function_class = find_class_by_c_name("Spite_Function")
    var class_class = find_class_by_c_name("Spite_Class")
    crash function_class and class_class
    var accessed_place = field_place("self", function_class, "_accessed")
    var names_place = field_place("self", function_class, "_accessed_names")
    var classes_place = field_place("self", function_class, "_accessed_classes")
    var symbol_spite_type: Analysis.SpiteType = Analysis.Types.SymbolType()
    var names_list = ensure_list(symbol_spite_type)
    var class_spite_type = class_type_of(class_class)
    var classes_list = ensure_list(class_spite_type)
    var lines = List<String>()
    lines.append("static void spite_function_accesses_described(Spite_Function* self) \{")
    lines.append("SPITE_LOCK(self->spite_arguments_lock);")
    lines.append("void* typed_call = self->spite_typed_call;")
    lines.append("if ({names_place} != 0) typed_call = 0;")
    var index = 0
    var tabled = accessed_call_names.count()
    if hot_reload {
        tabled = 0
    }
    while index < tabled {
        crash accessed_call_lines[index]
        if accessed_call_lines[index].is_empty() {
            crash accessed_call_owners[index]
            crash accessed_call_functions[index]
            var owner = accessed_call_owners[index]
            var function = accessed_call_functions[index]
            accessed_call_lines[index] = described_accesses_line(
                owner,
                function,
                names_list,
                classes_list,
                accessed_place,
                names_place,
                classes_place,
            )
        }
        crash accessed_call_lines[index]
        lines.append(accessed_call_lines[index])
        index = index + 1
    }
    lines.append("SPITE_UNLOCK(self->spite_arguments_lock);")
    lines.append("}")
    var joined_lines = lines.join("\n")
    if accesses_table_position < 0 {
        accesses_table_position = builder.support_count()
        builder.add_support(joined_lines)
    } else {
        builder.replace_support(accesses_table_position, joined_lines)
    }
    accesses_table_count = accessed_call_names.count()
    return true
}

func described_accesses_line(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    names_list: String,
    classes_list: String,
    accessed_place: String,
    names_place: String,
    classes_place: String,
): String {
    var plain_name = function.c_name == "{owner.c_name}_{function.name}"
    var written_in_source = plain_name and function.line > 0 and function.symbol_name.is_empty() and function.specialisation_position < 0
    var listed = reflected_accesses(owner, function, written_in_source)
    var entries = List<String>()
    var parts = List<String>()
    parts.append("if (typed_call == (void*){function.c_name}) \{")
    parts.append("{names_list}* spite_names = {names_list}___make();")
    parts.append("{classes_list}* spite_classes = {classes_list}___make();")
    var index = 0
    while index < listed.elements.count() {
        var access = listed.elements[index]
        var target = access.elements.first()
        crash target
        crash target.described_type
        var kind = "g"
        if target.kind == "attribute" {
            kind = "a"
        }
        var read = "-"
        if access.is_read {
            read = "r"
        }
        var written = "-"
        if access.is_written {
            written = "w"
        }
        entries.append("{kind}{read}{written}")
        parts.append("{names_list}_append(spite_names, {ensure_symbol(target.name)});")
        parts.append("{classes_list}_append(spite_classes, {class_object_call(target.described_type)});")
        index = index + 1
    }
    var encoded = entries.join(";")
    parts.append("{accessed_place} = {render_string_literal(encoded)};")
    parts.append("{names_place} = spite_names;")
    parts.append("{classes_place} = spite_classes;")
    parts.append("}")
    return parts.join(" ")
}

func emit_function_waits_table() {
    var lines = List<String>()
    lines.append("static bool spite_function_waits(void* typed_call) \{")
    var index = 0
    while index < function_value_makers.count() {
        var maker = function_value_makers[index]
        var maker_length = maker.length()
        var made = maker.slice(21, maker_length)
        if wait_facts.may_wait(made) {
            lines.append("if (typed_call == (void*){made}) return true;")
        }
        index = index + 1
    }
    var listed_index = 0
    while listed_index < listed_typed_calls.count() {
        var listed = listed_typed_calls[listed_index]
        var made_too = function_value_makers.contains("spite_function_value_{listed}")
        if not made_too and wait_facts.may_wait(listed) {
            lines.append("if (typed_call == (void*){listed}) return true;")
        }
        listed_index = listed_index + 1
    }
    lines.append("return false;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func folded_text(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String? {
    var generic_identifier = shape.as_generic_identifier(expression)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var value = generate_codegen_value(bare_name, class_information)
        return constant_text_of_code(value)
    }
    return hardcoded_setting_text(expression, scope, class_information)
}

func hardcoded_setting_text(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String? {
    var member = shape.as_member(expression)
    if member {
        if is_hardcoded_setting_name(member.name) {
            var value = generate_member_read(member, scope, class_information)
            if not value.constant_text.is_empty() {
                return value.constant_text
            }
        }
    }
    return null
}

func codegen_bound_type(name: String, class_information: Analysis.ClassInfo): Analysis.SpiteType? {
    var bound = codegen_index(class_information, name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    return class_information.codegen_types[bound]
}

func type_test(
    bound_type: Analysis.SpiteType,
    kind: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Boolean {
    var kind_name = operand_text(kind)
    switch kind_name {
        "List": return bound_type == Analysis.Types.ListType
        "Dictionary": return bound_type == Analysis.Types.DictionaryType
        "Null": return bound_type == Analysis.Types.NullableType
        "Symbol": return is_enum_type(bound_type) or type_shape.is_symbol(bound_type)
        "Enum": return is_enum_type(bound_type)
        _: {
            var kind_path = kind_name.split(".")
            var no_generic_arguments = List<Syntax.Types.GenericArgument>()
            var kind_reference: Syntax.Types.Type = Syntax.Types.NamedType(kind_path, no_generic_arguments)
            var saved_class = current_class
            current_class = class_information
            var kind_type = resolve_type(kind_reference, class_information.qualified_dotted)
            current_class = saved_class
            if not kind_type {
                return false
            }
            var kind_union = type_shape.as_union(kind_type)
            if kind_union {
                var union_information = find_union_by_c_name(kind_union.c_name)
                if union_information {
                    if union_information.is_shape {
                        return type_fits_shape(bound_type, union_information)
                    }
                    var member_index = 0
                    while member_index < union_information.member_types.count() {
                        var member_type = resolve_type(
                            union_information.member_types[member_index],
                            union_information.owner_namespace,
                        )
                        if member_type {
                            if exact_type_label(member_type) == exact_type_label(bound_type) {
                                return true
                            }
                        }
                        member_index = member_index + 1
                    }
                }
            }
            return exact_type_label(kind_type) == exact_type_label(bound_type)
        }
    }
}

func type_fits_shape(bound_type: Analysis.SpiteType, information: Analysis.UnionInfo): Boolean {
    if type_shape.as_nullable(bound_type) {
        return false
    }
    var candidate = class_of_given(bound_type)
    if not candidate {
        return false
    }
    var problem = shape_fit_problem(information, candidate)
    return problem.is_empty()
}

func exact_type_label(spite_type: Analysis.SpiteType): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.inner
        return "Nullable_{exact_type_label(nullable_inner)}"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_element = list_type.element
        return "List_{exact_type_label(list_element)}"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_element = dictionary_type.element
        return "Dictionary_{exact_type_label(dictionary_element)}{dictionary_key_suffix(dictionary_type)}"
    }
    var function_type = type_shape.as_class_ref(spite_type)
    if function_type {
        if function_type.has_signature {
            return function_type_label(function_type)
        }
    }
    return type_label(spite_type)
}

func function_type_label(function_type: Analysis.Types.ClassRefType): String {
    var label = "Spite_Function_{function_type.arguments.count()}"
    var index = 0
    while index < function_type.arguments.count() {
        label = "{label}_{exact_type_label(function_type.arguments[index])}"
        index = index + 1
    }
    if function_type.returns {
        label = "{label}_{exact_type_label(function_type.returns)}"
    }
    return label
}

func constant_text(expression: Syntax.Expressions.Expression): String? {
    var string_literal = shape.as_string_literal(expression)
    if string_literal {
        return "s:{string_literal.value}"
    }
    var integer_literal = shape.as_integer_literal(expression)
    if integer_literal {
        return "i:{integer_literal.value}"
    }
    var enum_literal = shape.as_enum_literal(expression)
    if enum_literal {
        return "e:{enum_literal.value}"
    }
    if shape.is_true_literal(expression) {
        return "b:true"
    }
    if shape.is_false_literal(expression) {
        return "b:false"
    }
    return null
}

func constant_text_of_code(value: ExpressionResult): String {
    if value.constant_text.is_empty() {
        return "?"
    }
    return value.constant_text
}

func generic_argument_label(text: String): String {
    var result = ""
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        var is_letter = code >= 65 and code <= 90 or code >= 97 and code <= 122
        var is_digit = code >= 48 and code <= 57
        if is_letter or is_digit {
            result = result + text.character_at(index)
        } else {
            result = "{result}_"
        }
        index = index + 1
    }
    return result
}

func instantiate_generic(
    template: Analysis.ClassInfo,
    arguments: List<Syntax.Types.GenericArgument>,
    current_namespace: String,
): Analysis.ClassInfo? {
    if arguments.count() != template.codegen_names.count() {
        report(
            "'{template.simple_name}' takes {template.codegen_names.count()} codegen value(s), in this order: ${template.codegen_names.join(", $")}, but {arguments.count()} were given",
        )
        return null
    }
    var types = List<Analysis.SpiteType>()
    var codes = List<String>()
    var texts = List<String>()
    var label = "{template.c_name}_"
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var type_argument = shape.as_type_argument(argument)
        if type_argument {
            var argument_type = resolve_generic_argument(argument, current_namespace)
            assert argument_type
            types.append(argument_type)
            codes.append("")
            texts.append("")
            label = "{label}_{exact_type_label(argument_type)}"
        }
        var boolean_argument = shape.as_boolean_argument(argument)
        if boolean_argument {
            var boolean_spite_type = boolean_type()
            types.append(boolean_spite_type)
            var boolean_code = "false"
            if boolean_argument.value {
                boolean_code = "true"
            }
            codes.append(boolean_code)
            texts.append("b:{boolean_code}")
            label = "{label}_{boolean_code}"
        }
        var integer_argument = shape.as_integer_argument(argument)
        if integer_argument {
            var integer_spite_type = integer_type()
            types.append(integer_spite_type)
            var integer_code: String = integer_argument.value
            codes.append(integer_code)
            texts.append("i:{integer_code}")
            label = "{label}_{integer_code}"
        }
        var float_argument = shape.as_float_argument(argument)
        if float_argument {
            var float_spite_type = float_type()
            types.append(float_spite_type)
            var last_code: String = float_argument.value
            codes.append(last_code)
            texts.append("f:{last_code}")
            label = "{label}_{generic_argument_label(last_code)}"
        }
        var string_argument = shape.as_string_argument(argument)
        if string_argument {
            var string_spite_type = string_type()
            types.append(string_spite_type)
            var rendered_string_literal = render_string_literal(string_argument.value)
            codes.append(rendered_string_literal)
            texts.append("s:{string_argument.value}")
            label = "{label}_{generic_argument_label(string_argument.value)}"
        }
        var enum_argument = shape.as_enum_argument(argument)
        if enum_argument {
            var owner_enum = find_enum_with_value(enum_argument.value)
            if owner_enum {
                var enum_type = enum_type_of(owner_enum)
                types.append(enum_type)
                codes.append("{owner_enum.c_name}_{enum_argument.value}")
                texts.append("e:{enum_argument.value}")
                label = "{label}_{enum_argument.value}"
            } else {
                report("cannot tell which enum '{enum_argument.value}' belongs to here")
                return null
            }
        }
        index = index + 1
    }
    var existing = find_class_by_c_name(label)
    if existing {
        return existing
    }
    return instantiated_with(template, types, codes, texts, label)
}

func instantiated_with(
    template: Analysis.ClassInfo,
    types: List<Analysis.SpiteType>,
    codes: List<String>,
    texts: List<String>,
    label: String,
): Analysis.ClassInfo {
    var record = instance_record(template, types, texts, label)
    instance_lines.append(record)
    var class_id = allocate_class_id(label)
    var instance = Analysis.ClassInfo(
        label,
        template.simple_name,
        template.namespace_dotted,
        template.qualified_dotted,
        class_id,
    )
    instance.source_path = template.source_path
    instance.entry_index = template.entry_index
    instance.codegen_names = template.codegen_names
    instance.codegen_types = types
    instance.codegen_codes = codes
    instance.codegen_texts = texts
    instance.codegen_constraints = template.codegen_constraints
    constrain_codegen_types(instance)
    instance.is_singleton = template.is_singleton
    instance.is_stateless_singleton = template.is_stateless_singleton
    instance.holds_nothing = template.holds_nothing
    instance.is_container = template.qualified_dotted == "TypedMemory" or template.qualified_dotted == "InlineMemory"
    instance.is_instantiated = true
    if is_serialiser(template) and not current_path.starts_with("library/") {
        var written_type = types.first()
        refuse_unwritable(template, written_type)
    }
    classes.append(instance)
    builder.add_typedef("typedef struct {label} {label};")
    var saved_owner = current_owner
    var saved_class = current_class
    var saved_function = current_function
    var saved_path = current_path
    var saved_line = current_line
    var saved_symbol_name = bound_symbol_name
    var saved_field_name = bound_field_name
    var saved_field_type = bound_field_type
    var saved_member_owner = bound_member_owner_c_name
    var saved_pattern = bound_pattern
    var saved_function_name = bound_function_name
    var saved_display_name = bound_display_name
    bound_symbol_name = ""
    bound_member_owner_c_name = ""
    bound_pattern = ""
    bound_function_name = ""
    bound_display_name = ""
    crash discovered_classes[template.entry_index]
    var discovered = discovered_classes[template.entry_index]
    resolve_class_body(discovered, instance, true)
    resolve_class_body(discovered, instance, false)
    if template.qualified_dotted == "Concurrent" or template.qualified_dotted == "Parallel" {
        supply_concurrency_functions(instance)
    }
    bound_symbol_name = saved_symbol_name
    bound_field_name = saved_field_name
    bound_field_type = saved_field_type
    bound_member_owner_c_name = saved_member_owner
    bound_pattern = saved_pattern
    bound_function_name = saved_function_name
    bound_display_name = saved_display_name
    current_owner = saved_owner
    current_class = saved_class
    current_function = saved_function
    current_path = saved_path
    current_line = saved_line
    if template.qualified_dotted == "Vector" {
        check_vector_item(instance)
    }
    if template.qualified_dotted == "Vector" or template.qualified_dotted == "Items" {
        check_plain_items(instance)
    }
    return instance
}

func check_plain_items(instance: Analysis.ClassInfo) {
    crash instance.codegen_types[0]
    var item_type = instance.codegen_types[0]
    var plain_type = item_type
    var nullable = type_shape.as_nullable(item_type)
    if nullable {
        plain_type = nullable.inner
    }
    assert plain_item_type(plain_type) or is_address_type(plain_type)
    var label = type_display_name(item_type)
    report(
        "'{instance.qualified_dotted}<{label}>' holds plain values, and a List keeps numbers, Boolean, enums and Memory.Address flat just as it did, so a list of them has one spelling: write 'List<{label}>'",
    )
}

func is_address_type(spite_type: Analysis.SpiteType): Boolean {
    var class_reference = type_shape.as_class_ref(spite_type)
    if not class_reference {
        return false
    }
    var information = find_class_by_c_name(class_reference.c_name)
    if not information {
        return false
    }
    return information.qualified_dotted == "Memory.Address"
}

func is_serialiser(template: Analysis.ClassInfo): Boolean {
    var name = template.qualified_dotted
    return name == "JsonWriter" or name == "JsonReader" or name == "BinaryWriter" or name == "BinaryReader"
}

func is_serialiser_path(path: String): Boolean {
    return path.starts_with("library/json_") or path.starts_with("library/binary_")
}

func refuse_unwritable(template: Analysis.ClassInfo, written: Analysis.SpiteType) {
    var format = "binary"
    if template.qualified_dotted.starts_with("Json") {
        format = "JSON"
    }
    var verb = "write"
    if template.qualified_dotted.ends_with("Reader") {
        verb = "read"
    }
    var visited = List<String>()
    var problem = unwritable_json(written, "", visited, format)
    assert not problem.is_empty()
    var serialised_type = type_display_name(written)
    var serialiser = template.qualified_dotted
    report(
        "{serialiser} cannot {verb} '{serialised_type}': {problem}. {serialiser} handles classes, lists, dictionaries, enums, Symbols, numbers, Boolean, String and 'T?', so keep what it sees to those, or give it a class of its own that holds only them",
    )
    refused_serialiser = true
}

# ../../../specs/collections.md#dictionarykey-value
func unwritable_key(key_type: Analysis.SpiteType, path: String, format: String): String {
    var named = "its dictionary"
    if not path.is_empty() {
        named = "the dictionary '{path}'"
    }
    var shown = type_display_name(key_type)
    if type_shape.as_class_ref(key_type) {
        return "{named} is keyed by '{shown}' objects, each key one object's identity, which has no {format} form"
    }
    var textual = type_shape.as_string(key_type) or is_whole_number_type(key_type) or is_enum_type(key_type)
    if format == "JSON" and not textual {
        return "{named} is keyed by '{shown}', and a JSON key is text: key it by a String, a whole number or an enum value"
    }
    return ""
}

func unwritable_json(spite_type: Analysis.SpiteType, path: String, visited: List<String>, format: String): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.inner
        return unwritable_json(inner, path, visited, format)
    }
    var listed = type_shape.as_list(spite_type)
    if listed {
        var element = listed.element
        return unwritable_json(element, path, visited, format)
    }
    var mapped = type_shape.as_dictionary(spite_type)
    if mapped {
        var mapped_key = mapped.key
        var key_problem = unwritable_key(mapped_key, path, format)
        if not key_problem.is_empty() {
            return key_problem
        }
        var entry = mapped.element
        return unwritable_json(entry, path, visited, format)
    }
    var shown = type_display_name(spite_type)
    var named = "it"
    if not path.is_empty() {
        named = "'{path}'"
    }
    if type_shape.as_union(spite_type) {
        return unwritable_union(spite_type, named, shown, format)
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if not class_ref {
        return ""
    }
    if class_ref.has_signature or class_ref.c_name == "Spite_Function" {
        return "{named} is a function value, {shown}, which has no {format} form"
    }
    if visited.contains(class_ref.c_name) {
        return ""
    }
    visited.append(class_ref.c_name)
    var information = find_class_by_c_name(class_ref.c_name)
    if not information {
        return ""
    }
    if information.is_value_class or information.is_generic_template {
        return ""
    }
    return unwritable_attribute(information, visited, format)
}

func unwritable_union(spite_type: Analysis.SpiteType, named: String, shown: String, format: String): String {
    if is_shape_type(spite_type) {
        return "{named} is typed as the 'type' {shown}, which says what it has, not what it is, so there is no class to read it back into"
    }
    if format == "JSON" {
        return "{named} is the union {shown}, and JSON does not say which member a value is"
    }
    return "{named} is the union {shown}, and the bytes do not say which member a value is"
}

func unwritable_attribute(information: Analysis.ClassInfo, visited: List<String>, format: String): String {
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        if not field.name.starts_with("_") and not singleton_type(field.type) {
            var field_type = field.type
            var problem = unwritable_json(field_type, "{information.simple_name}.{field.name}", visited, format)
            if not problem.is_empty() {
                return problem
            }
        }
        index = index + 1
    }
    return ""
}

func check_vector_item(vector_class: Analysis.ClassInfo) {
    crash vector_class.codegen_types[0]
    var problem = vector_item_problem(vector_class.codegen_types[0])
    if not problem.is_empty() {
        report(problem)
    }
}

func vector_item_problem(item_type: Analysis.SpiteType): String {
    if inline_value_type(item_type) {
        return ""
    }
    var label = type_display_name(item_type)
    var item_class = inline_item_class(item_type)
    if not item_class {
        return "a Vector holds each item inline, so an item is a number, a Boolean, an enum, a String or a class made only of those, and {type_with_article(item_type)} is not: keep it in a 'List<{label}>'"
    }
    var index = 0
    while index < item_class.fields.count() {
        var field = item_class.fields[index]
        var field_type = field.type
        if not inline_value_type(field_type) and not singleton_type(field_type) {
            return "'{label}' cannot be an item of a Vector: its attribute '{field.name}' is {type_with_article(field_type)}, and a Vector holds each item inline, so every attribute is a number, a Boolean, an enum or a String (keep '{label}' in a 'List<{label}>', or keep '{field.name}' somewhere else)"
        }
        index = index + 1
    }
    if item_class.drop_function {
        return "'{label}' cannot be an item of a Vector: it has a 'drop()', and an item inline in a Vector is never an object of its own to drop (keep '{label}' in a 'List<{label}>')"
    }
    index = 0
    while index < item_class.declared_functions.count() {
        var function = item_class.declared_functions[index]
        if not function.is_constructor and block_uses_this(function.body, item_class) {
            return "'{label}.{function.name}' uses 'this' as a value, and an item of a Vector is borrowed from the Vector, never an object to keep or to pass on: read and write its attributes instead"
        }
        index = index + 1
    }
    return ""
}

func singleton_type(spite_type: Analysis.SpiteType): Boolean {
    var found = class_behind(spite_type)
    if not found {
        return false
    }
    return found.is_singleton
}

func inline_value_type(spite_type: Analysis.SpiteType): Boolean {
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.inner
    }
    return type_shape.as_scalar(plain) or type_shape.as_string(plain) or type_shape.is_symbol(plain) or is_enum_type(plain)
}

func block_uses_this(statements: List<Syntax.Statements.Statement>, item_class: Analysis.ClassInfo): Boolean {
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(statements, expressions)
    var index = 0
    while index < expressions.count() {
        if expression_uses_this(expressions[index], item_class) {
            return true
        }
        index = index + 1
    }
    return false
}

func collect_block_expressions(
    statements: List<Syntax.Statements.Statement>,
    expressions: List<Syntax.Expressions.Expression>,
) {
    var index = 0
    while index < statements.count() {
        collect_statement_expressions(statements[index], expressions)
        index = index + 1
    }
}

func collect_statement_expressions(
    statement: Syntax.Statements.Statement,
    expressions: List<Syntax.Expressions.Expression>,
) {
    switch statement {
        Syntax.Statements.VariableDeclaration: add_optional_expression(statement.value, expressions)
        Syntax.Statements.AssignmentStatement: {
            add_optional_expression(statement.target, expressions)
            add_optional_expression(statement.value, expressions)
        }
        Syntax.Statements.IfStatement: {
            add_optional_expression(statement.condition, expressions)
            collect_block_expressions(statement.then_branch, expressions)
            collect_block_expressions(statement.else_branch, expressions)
        }
        Syntax.Statements.WhileStatement: {
            add_optional_expression(statement.condition, expressions)
            collect_block_expressions(statement.body, expressions)
        }
        Syntax.Statements.SwitchStatement: {
            add_optional_expression(statement.subject, expressions)
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_block_expressions(statement.cases[case_index].body, expressions)
                case_index = case_index + 1
            }
        }
        Syntax.Statements.AssertStatement: add_optional_expression(statement.value, expressions)
        Syntax.Statements.ReturnStatement: add_optional_expression(statement.value, expressions)
        Syntax.Statements.ExpressionStatement: add_optional_expression(statement.value, expressions)
        _: return
    }
}

func add_optional_expression(
    expression: Syntax.Expressions.Expression?,
    expressions: List<Syntax.Expressions.Expression>,
) {
    assert expression
    expressions.append(expression)
}

func expression_uses_this(expression: Syntax.Expressions.Expression, item_class: Analysis.ClassInfo): Boolean {
    switch expression {
        Syntax.Expressions.IdentifierExpression: {
            if expression.name == "this" or expression.name == "self" {
                return true
            }
            if item_class.find_function(expression.name) {
                return true
            }
            return false
        }
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            if not shape.as_identifier(expression.callee) and not is_member_of_this(expression.callee) {
                if expression_uses_this(expression.callee, item_class) {
                    return true
                }
            }
            return any_expression_uses_this(expression.arguments, item_class)
        }
        Syntax.Expressions.GenericCallExpression: return any_expression_uses_this(expression.arguments, item_class)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if expression_uses_this(expression.left, item_class) {
                return true
            }
            return expression_uses_this(expression.right, item_class)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return expression_uses_this(expression.operand, item_class)
        }
        Syntax.Expressions.MemberExpression: {
            if is_member_of_this(expression) {
                return false
            }
            crash expression.object
            return expression_uses_this(expression.object, item_class)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            if expression_uses_this(expression.object, item_class) {
                return true
            }
            return expression_uses_this(expression.index, item_class)
        }
        Syntax.Expressions.StringLiteralExpression: return expression.value.contains("\{this}")
        _: return false
    }
}

func is_member_of_this(expression: Syntax.Expressions.Expression): Boolean {
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    var object = shape.as_identifier(member.object)
    if not object {
        return false
    }
    return object.name == "this" or object.name == "self"
}

func any_expression_uses_this(
    expressions: List<Syntax.Expressions.Expression>,
    item_class: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < expressions.count() {
        if expression_uses_this(expressions[index], item_class) {
            return true
        }
        index = index + 1
    }
    return false
}

func resolve_generic_constraints() {
    var index = 0
    while index < classes.count() {
        if classes[index].is_generic_template {
            resolve_constraints_of(classes[index])
        }
        index = index + 1
    }
}

func resolve_constraints_of(information: Analysis.ClassInfo) {
    crash discovered_classes[information.entry_index]
    var file = discovered_classes[information.entry_index].file
    var statement_index = 0
    while statement_index < file.statements.count() {
        var generic_line = shape.as_generic_declaration(file.statements[statement_index])
        if generic_line {
            current_path = file.path
            current_line = generic_line.line
            current_owner = information.qualified_dotted
            current_function = ""
            var constraint_name = generic_constraint_name(information, generic_line)
            information.codegen_constraints.append(constraint_name)
        }
        statement_index = statement_index + 1
    }
}

func generic_constraint_name(
    information: Analysis.ClassInfo,
    generic_line: Syntax.Statements.GenericDeclaration,
): String {
    if not generic_line.constraint {
        return ""
    }
    var bare_name = without_dollar(generic_line.name)
    var resolved = resolve_type(generic_line.constraint, information.namespace_dotted)
    if not resolved {
        return ""
    }
    var union_type = type_shape.as_union(resolved)
    if union_type {
        var constrained = find_union_by_c_name(union_type.c_name)
        if constrained {
            if constrained.is_shape {
                return constrained.c_name
            }
        }
    }
    report(
        "'${bare_name}' is constrained by '{type_display_name(resolved)}', which is not a 'type': a constraint names a 'type' the class given must fit, like 'generic ${bare_name}: Printable'",
    )
    return ""
}

func constrain_codegen_types(instance: Analysis.ClassInfo) {
    if classes_resolved {
        check_constraints_of(instance)
        return
    }
    pending_constraint_instances.append(instance)
    pending_constraint_paths.append(current_path)
    pending_constraint_lines.append(current_line)
    pending_constraint_owners.append(current_owner)
    pending_constraint_functions.append(current_function)
}

func check_pending_constraints() {
    var index = 0
    while index < pending_constraint_instances.count() {
        crash pending_constraint_paths[index]
        crash pending_constraint_lines[index]
        crash pending_constraint_owners[index]
        crash pending_constraint_functions[index]
        current_path = pending_constraint_paths[index]
        current_line = pending_constraint_lines[index]
        current_owner = pending_constraint_owners[index]
        current_function = pending_constraint_functions[index]
        var pending_instance = pending_constraint_instances[index]
        check_constraints_of(pending_instance)
        index = index + 1
    }
}

func check_constraints_of(instance: Analysis.ClassInfo) {
    var index = 0
    while index < instance.codegen_constraints.count() and index < instance.codegen_types.count() {
        var constraint_name = instance.codegen_constraints[index]
        if not constraint_name.is_empty() {
            var constrained = find_union_by_c_name(constraint_name)
            crash constrained
            var given = instance.codegen_types[index]
            var problem = constraint_problem(constrained, given)
            if not problem.is_empty() {
                crash instance.codegen_names[index]
                var constrained_name = instance.codegen_names[index]
                report(
                    "'{type_display_name(given)}' does not fit type '{constrained.simple_name}', which '{instance.simple_name}' requires of ${constrained_name}: {problem}",
                )
                instance.codegen_types[index] = union_type_of(constrained)
            }
        }
        index = index + 1
    }
}

func constraint_problem(constrained: Analysis.UnionInfo, given: Analysis.SpiteType): String {
    var constrained_type = union_type_of(constrained)
    if types_equal(given, constrained_type) {
        return ""
    }
    if type_shape.as_nullable(given) {
        return "it may be null, and null has none of what the type needs"
    }
    var candidate = class_of_given(given)
    if candidate {
        var problem = shape_fit_problem(constrained, candidate)
        if not problem.is_empty() {
            failed_constraints.append("{constrained.c_name}>{candidate.c_name}")
        }
        return problem
    }
    return "only a class can fit a 'type'"
}

func class_of_given(given: Analysis.SpiteType): Analysis.ClassInfo? {
    if type_shape.as_string(given) {
        return find_class_by_c_name("SpiteString")
    }
    var boxed_class = boxed_class_of(given)
    if boxed_class {
        return boxed_class
    }
    var container_class = container_class_of(given)
    if container_class {
        return container_class
    }
    var class_ref = type_shape.as_class_ref(given)
    assert class_ref
    assert not class_ref.has_signature
    return find_class_by_c_name(class_ref.c_name)
}

func register_unions(entry: Discovery.DiscoveredClass) {
    var file = entry.file
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_union_declaration(file.statements[statement_index])
        if declaration {
            current_path = file.path
            current_line = declaration.line
            current_owner = entry.qualified_dotted
            current_function = ""
            check_type_name(declaration.name, "union")
            check_union_members(declaration.name, declaration.members)
            var information = Analysis.UnionInfo(
                "{entry.mangled_name}_{declaration.name}",
                declaration.name,
                entry.qualified_dotted,
                entry.qualified_dotted,
                declaration.members,
            )
            var reopened = shape_position(information.c_name)
            if reopened < 0 {
                unions.append(information)
            } else {
                unions[reopened] = information
            }
        }
        statement_index = statement_index + 1
    }
}

func check_union_members(union_name: String, members: List<Syntax.Types.Type>) {
    var value_names = value_class_names()
    var index = 0
    while index < members.count() {
        var named = shape.as_named_type(members[index])
        if named {
            var joined_path = named.path.join(".")
            if joined_path == "String" or value_names.contains(joined_path) {
                var shown = with_article(joined_path)
                report(
                    "'{joined_path}' cannot be a member of union '{union_name}': a union holds objects whose class a switch tests, and {shown} is a value; make the member a class of your own that keeps it in an attribute",
                )
            } else if not named.arguments.is_empty() {
                report(
                    "a generic class cannot be a member of union '{union_name}': a switch could tell only that it is a '{joined_path}', not of what; make the member a class of your own that keeps it in an attribute",
                )
            }
        }
        index = index + 1
    }
}

func register_shapes(entry: Discovery.DiscoveredClass) {
    var file = entry.file
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_type_declaration(file.statements[statement_index])
        if declaration {
            current_path = file.path
            current_line = declaration.line
            current_owner = entry.qualified_dotted
            current_function = ""
            check_type_name(declaration.name, "type")
            var no_members = List<Syntax.Types.Type>()
            var information = Analysis.UnionInfo(
                "{entry.mangled_name}_{declaration.name}",
                declaration.name,
                entry.qualified_dotted,
                entry.qualified_dotted,
                no_members,
            )
            information.is_shape = true
            information.shape_fields = declaration.fields
            information.is_tagged = not declaration.fields.any(is_attribute_field)
            information.shape_path = file.path
            var reopened = shape_position(information.c_name)
            if reopened < 0 {
                unions.append(information)
            } else {
                unions[reopened] = information
            }
        }
        statement_index = statement_index + 1
    }
}

func shape_position(c_name: String): Integer {
    var index = 0
    while index < unions.count() {
        if unions[index].c_name == c_name {
            return index
        }
        index = index + 1
    }
    return -1
}

func shape_field_type(information: Analysis.UnionInfo, field_name: String): Analysis.SpiteType? {
    var index = 0
    while index < information.shape_fields.count() {
        var field = information.shape_fields[index]
        if field.name == field_name {
            if field.type_reference {
                var saved_owner = current_owner
                var saved_path = current_path
                var saved_line = current_line
                var saved_function = current_function
                current_owner = information.owner_qualified
                if not information.shape_path.is_empty() and field.line > 0 {
                    current_path = information.shape_path
                    current_line = field.line
                    current_function = ""
                }
                var resolved = resolve_type(field.type_reference, information.owner_namespace)
                current_owner = saved_owner
                current_path = saved_path
                current_line = saved_line
                current_function = saved_function
                return resolved
            }
        }
        index = index + 1
    }
    return null
}

func fit_subject(candidate: Analysis.ClassInfo): String {
    if candidate.c_name.starts_with("Object_") {
        return "this object literal"
    }
    var debugged_type = instance_type_of(candidate)
    return "'{type_display_name(debugged_type)}'"
}

func required_parameter_types(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
): List<Analysis.SpiteType> {
    var types = List<Analysis.SpiteType>()
    var saved_owner = current_owner
    current_owner = information.owner_qualified
    var index = 0
    while index < wanted.parameter_types.count() {
        var resolved = resolve_type(wanted.parameter_types[index], information.owner_namespace)
        if resolved {
            types.append(resolved)
        }
        index = index + 1
    }
    current_owner = saved_owner
    return types
}

func required_return_type(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
): Analysis.SpiteType {
    if wanted.returns_nothing {
        return void_type()
    }
    var resolved = shape_field_type(information, wanted.name)
    if resolved {
        return resolved
    }
    return void_type()
}

func find_required_function(information: Analysis.UnionInfo, name: String): Syntax.Statements.FieldDeclaration? {
    var index = 0
    while index < information.shape_fields.count() {
        if information.shape_fields[index].is_function and information.shape_fields[index].name == name {
            return information.shape_fields[index]
        }
        index = index + 1
    }
    return null
}

func returned_display(spite_type: Analysis.SpiteType, display_name: String): String {
    if type_shape.is_void(spite_type) {
        return "Nothing"
    }
    return with_article(display_name)
}

func required_function_problem(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
    candidate: Analysis.ClassInfo,
): String {
    var function = find_or_instantiate_function(candidate, wanted.name)
    if not function {
        return built_in_operator_problem(information, wanted, candidate)
    }
    var wanted_types = required_parameter_types(information, wanted)
    var own_index = 0
    while own_index < wanted_types.count() {
        wanted_types[own_index] = own_type_in_shape(information, wanted_types[own_index], candidate)
        own_index = own_index + 1
    }
    if function.parameters.count() != wanted_types.count() {
        return "its '{wanted.name}' takes {function.parameters.count()} argument(s), but the type needs {wanted_types.count()}"
    }
    var index = 0
    while index < wanted_types.count() {
        crash function.parameters[index]
        var parameter_type = function.parameters[index].type
        if not types_equal(parameter_type, wanted_types[index]) {
            var names = type_display_names(parameter_type, wanted_types[index])
            var found_name = names.first()
            crash found_name
            var wanted_name = names.last()
            crash wanted_name
            return "argument {index + 1} of its '{wanted.name}' is {with_article(found_name)}, but the type needs {with_article(wanted_name)}"
        }
        index = index + 1
    }
    var shape_return = required_return_type(information, wanted)
    var wanted_return = own_type_in_shape(information, shape_return, candidate)
    var function_return_type = function.return_type
    if not types_equal(function_return_type, wanted_return) {
        var names = type_display_names(function_return_type, wanted_return)
        var returned_name = names.first()
        crash returned_name
        var needed_name = names.last()
        crash needed_name
        var returned = returned_display(function_return_type, returned_name)
        var needed = returned_display(wanted_return, needed_name)
        return "its '{wanted.name}' returns {returned}, but the type needs {needed}"
    }
    var lent = lent_result_source(candidate, function)
    if not lent.is_empty() {
        return "its '{wanted.name}' lends its caller an item of '{lent}', which only a call written by name can borrow: a call through the type would let go of an item it does not own"
    }
    return ""
}

# ../../../specs/values_and_types.md#inline-types-and-duck-typing-in-full
func own_type_in_shape(
    information: Analysis.UnionInfo,
    wanted_type: Analysis.SpiteType,
    candidate: Analysis.ClassInfo,
): Analysis.SpiteType {
    var shape_type = union_type_of(information)
    if types_equal(wanted_type, shape_type) {
        return instance_type_of(candidate)
    }
    return wanted_type
}

func names_own_shape(information: Analysis.UnionInfo, wanted: Syntax.Statements.FieldDeclaration): Boolean {
    var shape_type = union_type_of(information)
    var parameter_types = required_parameter_types(information, wanted)
    var index = 0
    while index < parameter_types.count() {
        if types_equal(parameter_types[index], shape_type) {
            return true
        }
        index = index + 1
    }
    var returned = required_return_type(information, wanted)
    return types_equal(returned, shape_type)
}

func built_in_operator_problem(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
    candidate: Analysis.ClassInfo,
): String {
    var missing = "it has no function '{wanted.name}'"
    var own_type = instance_type_of(candidate)
    var own_scalar = type_shape.as_scalar(own_type)
    if not own_scalar {
        return missing
    }
    if own_scalar.kind == 'boolean_kind' or own_scalar.kind == 'address_kind' {
        return missing
    }
    var arithmetic = ["sum", "subtract", "multiply", "divide", "remainder"]
    var comparison = ["less_than", "greater_than", "equals"]
    var is_arithmetic = arithmetic.contains(wanted.name)
    if not is_arithmetic and not comparison.contains(wanted.name) {
        return missing
    }
    var wanted_types = required_parameter_types(information, wanted)
    if wanted_types.count() != 1 {
        return "its '{wanted.name}' takes 1 argument, but the type needs {wanted_types.count()}"
    }
    var wanted_parameter = own_type_in_shape(information, wanted_types[0], candidate)
    if not types_equal(wanted_parameter, own_type) {
        var parameter_name = type_display_name(wanted_parameter)
        var own_name = type_display_name(own_type)
        return "its '{wanted.name}' takes {with_article(own_name)}, but the type needs {with_article(parameter_name)}"
    }
    var shape_return = required_return_type(information, wanted)
    var wanted_return = own_type_in_shape(information, shape_return, candidate)
    var answered = own_type
    if not is_arithmetic {
        answered = boolean_type()
    }
    if not types_equal(wanted_return, answered) {
        var answered_name = type_display_name(answered)
        var returned = returned_display(answered, answered_name)
        var wanted_name = type_display_name(wanted_return)
        var needed = returned_display(wanted_return, wanted_name)
        return "its '{wanted.name}' returns {returned}, but the type needs {needed}"
    }
    return ""
}

func shape_call_parameter_types(information: Analysis.UnionInfo, name: String): List<Analysis.SpiteType> {
    var wanted = find_required_function(information, name)
    assert wanted
    return required_parameter_types(information, wanted)
}

func shape_call_return_type(information: Analysis.UnionInfo, name: String): Analysis.SpiteType {
    var wanted = find_required_function(information, name)
    if wanted {
        return required_return_type(information, wanted)
    }
    return string_type()
}

func generate_shape_call(
    information: Analysis.UnionInfo,
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var wanted = find_required_function(information, name)
    if not wanted and name != "to_debug" and name != "to_string" {
        report(
            "type '{information.simple_name}' does not require a function '{name}', so it cannot be called through it",
        )
        return void_result()
    }
    if wanted {
        if names_own_shape(information, wanted) {
            report(
                "'{name}' of type '{information.simple_name}' takes or answers the class that fits the type, which a value read as '{information.simple_name}' does not know while compiling: take the value through a codegen value the type constrains, 'generic $value_type: {information.simple_name}'",
            )
            return void_result()
        }
    }
    var parameter_types = shape_call_parameter_types(information, name)
    var return_type = shape_call_return_type(information, name)
    var function_c_name = ensure_shape_caller(information, name)
    var called = generate_generic_call(
        function_c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types,
        return_type,
        scope,
        class_information,
    )
    called.owning_override = true
    return called
}

func ensure_shape_caller(information: Analysis.UnionInfo, name: String): String {
    var function_c_name = "{information.c_name}___call_{name}"
    note_fact("shape caller {information.c_name} {name}")
    if not information.caller_names.contains(name) {
        information.caller_names.append(name)
        shape_caller_names[name] = true
        var called_shape = ShapeCaller(information, name)
        shape_callers_by_c_name[function_c_name] = called_shape
        var parameter_types = shape_call_parameter_types(information, name)
        var return_type = shape_call_return_type(information, name)
        var signature = "{c_type_name(return_type)} {function_c_name}({information.c_name} self"
        var index = 0
        while index < parameter_types.count() {
            signature = "{signature}, {c_type_name(parameter_types[index])} argument_{index}"
            index = index + 1
        }
        builder.add_prototype("{signature});")
    }
    return function_c_name
}

func shape_function_value(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
): ExpressionResult {
    var caller = ensure_shape_caller(information, wanted.name)
    var parameter_types = required_parameter_types(information, wanted)
    var return_type = required_return_type(information, wanted)
    var signature = Analysis.Types.ClassRefType("Spite_Function")
    signature.has_signature = true
    signature.arguments = parameter_types
    signature.returns = return_type
    if type_shape.is_void(return_type) {
        signature.returns = Analysis.Types.ClassRefType("Nothing")
    }
    if task_value_arguments == 0 {
        var value_call = value_call_key(signature.arguments, signature.returns)
        wait_facts.add_edge(value_call, caller)
    }
    var maker = "spite_function_value_{caller}"
    note_fact("maker {maker}")
    if not function_value_makers.contains(maker) {
        function_value_makers.append(maker)
        var argument_class = find_class_by_c_name("Spite_Argument")
        crash argument_class
        var class_type = class_type_of(argument_class)
        var arguments_list_name = ensure_list(class_type)
        var returned = signature.returns
        crash returned
        var argument_lines = List<String>()
        var parameter_index = 0
        while parameter_index < parameter_types.count() {
            var argument_symbol = ensure_symbol("argument_{parameter_index}")
            argument_lines.append(
                "{arguments_list_name}_append(described->_arguments_, Spite_Argument___make({argument_symbol}, {class_object_call(parameter_types[parameter_index])}));",
            )
            parameter_index = parameter_index + 1
        }
        var box_type = ensure_shape_box(information)
        var forwarder = "{maker}___call"
        var forwarder_parameters = List<String>()
        forwarder_parameters.append("void* owner")
        var forwarded = List<String>()
        forwarded.append("(({box_type}*)owner)->value")
        var forwarded_index = 0
        while forwarded_index < parameter_types.count() {
            forwarder_parameters.append("{c_type_name(parameter_types[forwarded_index])} argument_{forwarded_index}")
            forwarded.append("argument_{forwarded_index}")
            forwarded_index = forwarded_index + 1
        }
        var returned_c = "void"
        var forwarded_body = "{caller}({forwarded.join(", ")});"
        if not type_shape.is_void(return_type) {
            returned_c = c_type_name(return_type)
            forwarded_body = "return {forwarded_body}"
        }
        var forwarder_signature = "static {returned_c} {forwarder}({forwarder_parameters.join(", ")})"
        builder.add_prototype("{forwarder_signature};")
        builder.add_support("{forwarder_signature} \{\n{forwarded_body}\n}")
        var box_release = "{maker}___release_owner"
        builder.add_prototype("static void {box_release}(void* owner);")
        builder.add_support(
            "static void {box_release}(void* owner) \{\n{box_type}* spite_box = ({box_type}*)owner;\n{information.c_name}___release(spite_box->value);\nSPITE_FREE(spite_box);\n}",
        )
        var lines = List<String>()
        lines.append("Spite_Function* {maker}({information.c_name} owner) \{")
        lines.append(
            "Spite_Function* described = Spite_Function___make({ensure_symbol(wanted.name)}, {class_object_call(returned)});",
        )
        add_lazy_arguments(maker, argument_lines, lines)
        lines.append("{box_type}* spite_box = ({box_type}*)SPITE_MALLOC(sizeof({box_type}));")
        lines.append("spite_box->value = {information.c_name}___retain(owner);")
        lines.append("described->spite_owner = spite_box;")
        lines.append("described->spite_release_owner = {box_release};")
        if parameter_types.is_empty() and type_shape.is_void(return_type) {
            lines.append("described->spite_call = (void (*)(void*)){forwarder};")
        }
        lines.append("described->spite_typed_call = (void*){forwarder};")
        var valued_caller = shape_callers_by_c_name[caller]
        crash valued_caller
        var valued_key = value_call_key(signature.arguments, signature.returns)
        shape_value_keys.append(valued_key)
        shape_value_forwarders.append(forwarder)
        shape_value_boxes.append(box_type)
        shape_value_callers.append(valued_caller)
        lines.append("return described;")
        lines.append("}")
        builder.add_prototype("Spite_Function* {maker}({information.c_name} owner);")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    var code = "{maker}({object_result.code})"
    if owns(object_result, object_ast) {
        var owner_temporary = next_temporary()
        var value_temporary = next_temporary()
        code = "(\{ {information.c_name} {owner_temporary} = {object_result.code}; Spite_Function* {value_temporary} = {maker}({owner_temporary}); {information.c_name}___release({owner_temporary}); {value_temporary}; })"
    }
    var typed: Analysis.SpiteType = signature
    var made = ExpressionResult(code, typed)
    made.owning_override = true
    return made
}

func ensure_shape_box(information: Analysis.UnionInfo): String {
    var box_type = "SpiteShapeBox_{information.c_name}"
    if not shape_boxes_written.contains(box_type) {
        shape_boxes_written.append(box_type)
        builder.add_typedef("typedef struct {box_type} \{ {information.c_name} value; } {box_type};")
    }
    return box_type
}

func shape_member_function(member: Analysis.ClassInfo, name: String): Analysis.FunctionInfo? {
    var function = find_or_instantiate_function(member, name)
    if function {
        return function
    }
    assert name == "to_string"
    return find_or_instantiate_function(member, "to_debug")
}

func emit_late_shape_callers(): Integer {
    var emitted = emit_dispatchers()
    emitted = emitted + emit_shape_operators()
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.is_shape and information.emitted_callers < information.caller_names.count() {
            emitted = emitted + information.caller_names.count() - information.emitted_callers
            emit_shape_callers(information)
        }
        index = index + 1
    }
    return emitted
}

func emit_shape_callers(information: Analysis.UnionInfo) {
    var caller_index = information.emitted_callers
    while caller_index < information.caller_names.count() {
        var name = information.caller_names[caller_index]
        var parameter_types = shape_call_parameter_types(information, name)
        var return_type = shape_call_return_type(information, name)
        var lines = List<String>()
        var signature = "{c_type_name(return_type)} {information.c_name}___call_{name}({information.c_name} self"
        var passed = ""
        var index = 0
        while index < parameter_types.count() {
            signature = "{signature}, {c_type_name(parameter_types[index])} argument_{index}"
            passed = "{passed}, argument_{index}"
            index = index + 1
        }
        lines.append("{signature}) \{")
        var joined_lines = shape_caller_text(information, name, lines, passed, parameter_types, return_type)
        note_union_slot(information, "'s call of {name}")
        var position = builder.support_count()
        shape_caller_positions["{information.c_name} {name}"] = position
        builder.add_support(joined_lines)
        caller_index = caller_index + 1
    }
    information.emitted_callers = caller_index
}

func shape_caller_text(
    information: Analysis.UnionInfo,
    name: String,
    lines: List<String>,
    passed: String,
    parameter_types: List<Analysis.SpiteType>,
    return_type: Analysis.SpiteType,
): String {
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var shape_type = union_type_of(information)
        var receiver = member_value_code("self", shape_type, member)
        var called_function = shape_member_function(member, name)
        crash called_function
        var call = "{called_function.c_name}({receiver}{passed})"
        var member_test = value_class_test("self", shape_type, member)
        if type_shape.is_void(return_type) {
            lines.append("if {member_test} \{ {call}; return; }")
        } else {
            lines.append("if {member_test} return {call};")
        }
        member_index = member_index + 1
    }
    var index = 0
    while index < parameter_types.count() {
        var release_line = release_statement(parameter_types[index], "argument_{index}")
        lines.append(release_line)
        index = index + 1
    }
    lines.append(
        "fputs(\"spite.crash\\t{information.simple_name}.{name} was called on a value of a class it was not compiled for\\n\", stderr);",
    )
    lines.append("abort();")
    lines.append("}")
    return lines.join("\n")
}

func refresh_shape_callers() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var caller_index = 0
        while information.is_shape and caller_index < information.emitted_callers {
            crash information.caller_names[caller_index]
            var name = information.caller_names[caller_index]
            var position = shape_caller_positions["{information.c_name} {name}"]
            crash position
            var parameter_types = shape_call_parameter_types(information, name)
            var return_type = shape_call_return_type(information, name)
            var signature = "{c_type_name(return_type)} {information.c_name}___call_{name}({information.c_name} self"
            var passed = ""
            var parameter_index = 0
            while parameter_index < parameter_types.count() {
                signature = "{signature}, {c_type_name(parameter_types[parameter_index])} argument_{parameter_index}"
                passed = "{passed}, argument_{parameter_index}"
                parameter_index = parameter_index + 1
            }
            var lines = List<String>()
            lines.append("{signature}) \{")
            var text = shape_caller_text(information, name, lines, passed, parameter_types, return_type)
            builder.replace_support(position, text)
            caller_index = caller_index + 1
        }
        index = index + 1
    }
}

func admit_to_union(information: Analysis.UnionInfo, candidate: Analysis.ClassInfo) {
    note_fact("admit {information.c_name} {candidate.c_name}")
    assert not information.has_member(candidate.c_name)
    if not information.is_shape {
        report("'{candidate.simple_name}' is not a member of union '{information.simple_name}'")
        return
    }
    var problem = shape_fit_problem(information, candidate)
    if not problem.is_empty() {
        if not failed_constraints.contains("{information.c_name}>{candidate.c_name}") {
            report("{fit_subject(candidate)} does not fit type '{information.simple_name}': {problem}")
        }
        return
    }
    information.members.append(candidate)
    if emitting_machines {
        wake_shape_callers(information, candidate)
    }
    admit_along_flows(information, candidate)
}

func wake_shape_callers(information: Analysis.UnionInfo, candidate: Analysis.ClassInfo) {
    var woken = false
    var index = 0
    while index < information.caller_names.count() {
        var name = information.caller_names[index]
        var called = candidate.find_function(name)
        var caller = "{information.c_name}___call_{name}"
        if called and not waiting_names.has(caller) {
            if waiting_names.has(called.c_name) {
                waiting_names[caller] = true
                woken = true
            }
        }
        index = index + 1
    }
    assert woken
    wake_all_callers()
}

func shape_fit_problem(information: Analysis.UnionInfo, candidate: Analysis.ClassInfo): String {
    var index = 0
    while index < information.shape_fields.count() {
        var wanted = information.shape_fields[index]
        if wanted.is_function {
            var function_problem = required_function_problem(information, wanted, candidate)
            if not function_problem.is_empty() {
                return function_problem
            }
        } else {
            var found = candidate.find_field(wanted.name)
            if not found {
                return "it has no attribute '{wanted.name}'"
            }
            var wanted_type = shape_field_type(information, wanted.name)
            if wanted_type {
                var found_type = found.type
                if not types_equal(found_type, wanted_type) {
                    var names = type_display_names(found_type, wanted_type)
                    var found_name = names.first()
                    crash found_name
                    var wanted_name = names.last()
                    crash wanted_name
                    return "attribute '{wanted.name}' is {with_article(found_name)}, but the type needs {with_article(wanted_name)}"
                }
            }
        }
        index = index + 1
    }
    return ""
}

func ensure_shape_reader(information: Analysis.UnionInfo, field_name: String, field_type: Analysis.SpiteType): String {
    var function_c_name = "{information.c_name}___read_{field_name}"
    if not information.accessor_names.contains(field_name) {
        information.accessor_names.append(field_name)
        builder.add_prototype("{c_type_name(field_type)} {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func ensure_shape_writer(information: Analysis.UnionInfo, field_name: String, field_type: Analysis.SpiteType): String {
    var function_c_name = "{information.c_name}___write_{field_name}"
    if not information.writer_names.contains(field_name) {
        information.writer_names.append(field_name)
        builder.add_prototype("void {function_c_name}({information.c_name} self, {c_type_name(field_type)} value);")
    }
    return function_c_name
}

func ensure_union_class_of(information: Analysis.UnionInfo): String {
    var function_c_name = "{information.c_name}___class_of"
    note_fact("flag class_of {information.c_name}")
    if not information.class_of_used {
        information.class_of_used = true
        builder.add_prototype("Spite_Class* {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func emit_union_class_of_bodies() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.class_of_used {
            var lines = List<String>()
            lines.append("Spite_Class* {information.c_name}___class_of({information.c_name} self) \{")
            var member_index = 0
            while member_index < information.members.count() {
                var member = information.members[member_index]
                var class_type = class_type_of(member)
                if boxed_value_types.has(member.c_name) {
                    crash boxed_value_types[member.c_name]
                    class_type = boxed_value_types[member.c_name]
                }
                var owner_type = union_type_of(information)
                var tested_member = value_class_test("self", owner_type, member)
                lines.append("if {tested_member} return {class_object_call(class_type)};")
                member_index = member_index + 1
            }
            lines.append(
                "return {ensure_class_object(information.simple_name, information.owner_namespace, information.c_name)}();",
            )
            lines.append("}")
            var joined_lines = lines.join("\n")
            note_union_slot(information, "'s class")
            builder.add_support(joined_lines)
        }
        index = index + 1
    }
}

func emit_union_release(information: Analysis.UnionInfo) {
    var position = builder.support_count()
    union_release_positions[information.c_name] = position
    var release_text = union_release_text(information)
    note_union_slot(information, "'s release")
    builder.add_support(release_text)
}

func refresh_union_releases() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if union_release_positions[information.c_name] {
            var release_text = union_release_text(information)
            builder.replace_support(union_release_positions[information.c_name], release_text)
        }
        index = index + 1
    }
}

func union_release_text(information: Analysis.UnionInfo): String {
    var name = information.c_name
    var release_lines = List<String>()
    release_lines.append("void {name}___release({name} self) \{")
    if information.is_tagged {
        release_lines.append("if (self.plain != 0 || self.value.object == 0) return;")
        var tagged_index = 0
        while tagged_index < information.members.count() {
            var tagged_member = information.members[tagged_index]
            if not is_plain_member(tagged_member) {
                var released_object = "{tagged_member.c_name}___release(({tagged_member.c_name}*)self.value.object)"
                if tagged_member.c_name == "SpiteString" {
                    released_object = "spite_string_box_release(self.value.object)"
                } else if boxed_value_types.has(tagged_member.c_name) {
                    released_object = "spite_box_release(self.value.object)"
                }
                release_lines.append("if {tagged_member_test("self", tagged_member)} \{ {released_object}; return; }")
            }
            tagged_index = tagged_index + 1
        }
        release_lines.append("}")
        return release_lines.join("\n")
    }
    release_lines.append("if (self == 0) return;")
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var released = "{member.c_name}___release(({member.c_name}*)self)"
        if member.c_name == "SpiteString" {
            released = "spite_string_box_release(self)"
        } else if boxed_value_types.has(member.c_name) {
            released = "spite_box_release(self)"
        }
        release_lines.append("if {class_id_test("self", member)} \{ {released}; return; }")
        member_index = member_index + 1
    }
    release_lines.append("}")
    return release_lines.join("\n")
}

func emit_shape_peekers(information: Analysis.UnionInfo) {
    var index = 0
    while index < information.peeker_names.count() {
        var field_name = information.peeker_names[index]
        var field_type = shape_field_type(information, field_name)
        assert field_type
        var lines = List<String>()
        lines.append("{c_type_name(field_type)} {information.c_name}___peek_{field_name}({information.c_name} self) \{")
        var only = information.members.count() == 1 and not hot_reload and not read_evaluate_print_loop and remote_loop_port == 0 and not keeps_internals
        if only {
            crash information.members[0]
            var sole = information.members[0]
            lines.append("return {field_place("(({sole.c_name}*)self)", sole, field_name)};")
        }
        var member_index = 0
        while not only and member_index < information.members.count() {
            var member = information.members[member_index]
            lines.append(
                "if {class_id_test("self", member)} return {field_place("(({member.c_name}*)self)", member, field_name)};",
            )
            member_index = member_index + 1
        }
        lines.append("return 0;")
        lines.append("}")
        var joined_lines = lines.join("\n")
        note_union_slot(information, "'s peek at {field_name}")
        builder.add_support(joined_lines)
        index = index + 1
    }
}

func emit_shape_bodies() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.is_shape {
            emit_union_release(information)
            emit_shape_callers(information)
            var reader_index = 0
            while reader_index < information.accessor_names.count() {
                var field_name = information.accessor_names[reader_index]
                var field_type = shape_field_type(information, field_name)
                if field_type {
                    mark_members_read(information.members, field_name)
                    var lines = List<String>()
                    lines.append(
                        "{c_type_name(field_type)} {information.c_name}___read_{field_name}({information.c_name} self) \{",
                    )
                    var member_index = 0
                    while member_index < information.members.count() {
                        var member = information.members[member_index]
                        var member_place = field_place("(({member.c_name}*)self)", member, field_name)
                        lines.append(
                            "if {class_id_test("self", member)} return {retain_call(field_type, member_place)};",
                        )
                        member_index = member_index + 1
                    }
                    lines.append("return {default_value_for_type(field_type)};")
                    lines.append("}")
                    var joined_lines = lines.join("\n")
                    note_union_slot(information, "'s read of {field_name}")
                    builder.add_support(joined_lines)
                }
                reader_index = reader_index + 1
            }
            emit_shape_peekers(information)
            var writer_index = 0
            while writer_index < information.writer_names.count() {
                var written = information.writer_names[writer_index]
                var written_type = shape_field_type(information, written)
                if written_type {
                    var writer_lines = List<String>()
                    writer_lines.append(
                        "void {information.c_name}___write_{written}({information.c_name} self, {c_type_name(written_type)} value) \{",
                    )
                    var writer_member_index = 0
                    while writer_member_index < information.members.count() {
                        var writer_member = information.members[writer_member_index]
                        var target = field_place("(({writer_member.c_name}*)self)", writer_member, written)
                        writer_lines.append(
                            "if {class_id_test("self", writer_member)} \{ {release_statement(written_type, target)} {target} = value; return; }",
                        )
                        writer_member_index = writer_member_index + 1
                    }
                    var release_line = release_statement(written_type, "value")
                    writer_lines.append(release_line)
                    writer_lines.append("}")
                    var joined_writer_lines = writer_lines.join("\n")
                    note_union_slot(information, "'s write of {written}")
                    builder.add_support(joined_writer_lines)
                }
                writer_index = writer_index + 1
            }
        }
        index = index + 1
    }
}

func generate_shape_read(
    information: Analysis.UnionInfo,
    field_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
): ExpressionResult {
    var field_type = shape_field_type(information, field_name)
    if not field_type {
        report("type '{information.simple_name}' has no attribute '{field_name}'")
        return void_result()
    }
    mark_members_read(information.members, field_name)
    var reader = ensure_shape_reader(information, field_name, field_type)
    var lines = List<String>()
    lines.append("{information.c_name} spite_shaped = {object_result.code};")
    lines.append("{c_type_name(field_type)} spite_shaped_value = {reader}(spite_shaped);")
    if owns(object_result, object_ast) {
        lines.append("{information.c_name}___release(spite_shaped);")
    }
    lines.append("spite_shaped_value;")
    var read = ExpressionResult("(\{ {lines.join(" ")} })", field_type)
    read.owning_override = true
    if not owns(object_result, object_ast) and not hot_reload and type_shape.as_class_ref(field_type) {
        read.peek_union = information
        read.peek_field = field_name
        read.peek_object = object_result.code
    }
    return read
}

func generate_row_read(
    information: Analysis.UnionInfo,
    field_name: String,
    object_result: ExpressionResult,
    row_name: String,
): ExpressionResult {
    var field_type = shape_field_type(information, field_name)
    if not field_type {
        report("type '{information.simple_name}' has no attribute '{field_name}'")
        return void_result()
    }
    mark_members_read(information.members, field_name)
    var peeker = ensure_shape_peeker(information, field_name, field_type)
    var read = ExpressionResult("{peeker}({object_result.code})", field_type)
    read.owning_override = false
    if type_needs_drop(field_type) {
        read.borrowed_from = row_name
    }
    if type_shape.as_class_ref(field_type) {
        read.peek_union = information
        read.peek_field = field_name
        read.peek_object = object_result.code
    }
    return read
}

func peeked_code(result: ExpressionResult): String {
    if not result.peek_union {
        return ""
    }
    var field_type = result.type
    var peeker = ensure_shape_peeker(result.peek_union, result.peek_field, field_type)
    return "{peeker}({result.peek_object})"
}

func ensure_shape_peeker(information: Analysis.UnionInfo, field_name: String, field_type: Analysis.SpiteType): String {
    var function_c_name = "{information.c_name}___peek_{field_name}"
    if not information.peeker_names.contains(field_name) {
        information.peeker_names.append(field_name)
        builder.add_prototype("{c_type_name(field_type)} {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func generate_object_literal(
    literal: Syntax.Expressions.ObjectLiteralExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var names = List<String>()
    var types = List<Analysis.SpiteType>()
    var codes = List<String>()
    var label = "Object"
    var index = 0
    while index < literal.fields.count() {
        var field = literal.fields[index]
        if field.value {
            var saved_counter = temporary_counter
            var probe = generate_expression(field.value, scope, class_information)
            rewind_temporaries(saved_counter)
            names.append(field.name)
            var probe_type = probe.type
            types.append(probe_type)
            var stored_code = coerce_for_store(field.value, probe_type, scope, class_information)
            codes.append(stored_code)
            label = "{label}_{field.name}_{type_label(probe_type)}"
        }
        index = index + 1
    }
    var information = find_class_by_c_name(label)
    if not information {
        var class_id = allocate_class_id(label)
        var created = Analysis.ClassInfo(label, "Object", "", label, class_id)
        note_literal_class(names, types)
        var field_index = 0
        while field_index < names.count() {
            var listed_name = names[field_index]
            var listed_type = types[field_index]
            var default_value_code = default_value_for_type(listed_type)
            var listed_field = Analysis.FieldInfo(listed_name, listed_type, default_value_code)
            created.fields.append(listed_field)
            field_index = field_index + 1
        }
        classes.append(created)
        builder.add_typedef("typedef struct {label} {label};")
        var saved_owner = current_owner
        emit_class(created)
        current_owner = saved_owner
    }
    var lines = List<String>()
    var temporary = next_temporary()
    lines.append("{label}* {temporary} = {label}___allocate();")
    var assign_index = 0
    while assign_index < names.count() {
        var target = "{temporary}->{c_value_name(names[assign_index])}"
        crash codes[assign_index]
        crash types[assign_index]
        lines.append("{release_statement(types[assign_index], target)} {target} = {codes[assign_index]};")
        assign_index = assign_index + 1
    }
    lines.append("{temporary};")
    var class_type = Analysis.Types.ClassRefType(label)
    var built = ExpressionResult("(\{ {lines.join(" ")} })", class_type)
    built.owning_override = true
    return built
}

func shape_default(information: Analysis.UnionInfo): String {
    if information.is_tagged {
        return "SPITE_TAGGED_NULL"
    }
    var names = List<String>()
    var types = List<Analysis.SpiteType>()
    var label = "Object"
    var index = 0
    while index < information.shape_fields.count() {
        var field = information.shape_fields[index]
        if field.is_function {
            return "0"
        }
        var field_type = shape_field_type(information, field.name)
        if not field_type {
            return "0"
        }
        names.append(field.name)
        types.append(field_type)
        label = "{label}_{field.name}_{type_label(field_type)}"
        index = index + 1
    }
    var information_class = find_class_by_c_name(label)
    if not information_class {
        var class_id = allocate_class_id(label)
        var created = Analysis.ClassInfo(label, "Object", "", label, class_id)
        note_literal_class(names, types)
        var field_index = 0
        while field_index < names.count() {
            var listed_name = names[field_index]
            var listed_type = types[field_index]
            var default_value_code = default_value_for_type(listed_type)
            var listed_field = Analysis.FieldInfo(listed_name, listed_type, default_value_code)
            created.fields.append(listed_field)
            field_index = field_index + 1
        }
        classes.append(created)
        builder.add_typedef("typedef struct {label} {label};")
        builder.add_prototype("{label}* {label}___default(void);")
        information_class = created
    }
    crash information_class
    if not information.has_member(label) {
        admit_to_union(information, information_class)
    }
    return "(({information.c_name}){label}___default())"
}

func resolve_union_members() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var member_index = 0
        while member_index < information.member_types.count() {
            var member_class = class_of_type_reference(
                information.member_types[member_index],
                information.owner_namespace,
            )
            if member_class {
                information.members.append(member_class)
            } else {
                report("a member of union '{information.simple_name}' is not a class")
            }
            member_index = member_index + 1
        }
        index = index + 1
    }
}

func class_of_type_reference(type_reference: Syntax.Types.Type, current_namespace: String): Analysis.ClassInfo? {
    var named = shape.as_named_type(type_reference)
    if named {
        var joined_path = named.path.join(".")
        return find_class(joined_path, current_namespace)
    }
    return null
}

func find_union(name: String): Analysis.UnionInfo? {
    var fallback: Analysis.UnionInfo? = null
    var index = 0
    while index < unions.count() {
        var candidate = unions[index]
        if candidate.simple_name == name {
            if candidate.owner_qualified == current_owner {
                return candidate
            }
            fallback = candidate
        }
        index = index + 1
    }
    return fallback
}

func find_union_qualified(owner_qualified: String, name: String): Analysis.UnionInfo? {
    var index = 0
    while index < unions.count() {
        var candidate = unions[index]
        if candidate.simple_name == name and candidate.owner_qualified == owner_qualified {
            return candidate
        }
        index = index + 1
    }
    return null
}

func find_union_by_c_name(c_name: String): Analysis.UnionInfo? {
    return unions.find_by_c_name(c_name)
}

func union_type_of(information: Analysis.UnionInfo): Analysis.SpiteType {
    return Analysis.Types.UnionType(information.c_name)
}

func class_type_of(information: Analysis.ClassInfo): Analysis.SpiteType {
    return Analysis.Types.ClassRefType(information.c_name)
}

func is_attribute_field(field: Syntax.Statements.FieldDeclaration): Boolean {
    return not field.is_function
}

func tagged_shape_of(spite_type: Analysis.SpiteType): Analysis.UnionInfo? {
    var inner = expected_type_without_nullable(spite_type)
    var union_type = type_shape.as_union(inner)
    assert union_type
    var information = find_union_by_c_name(union_type.c_name)
    assert information
    assert information.is_tagged
    return information
}

func is_plain_member(member: Analysis.ClassInfo): Boolean {
    if member.c_name == "SpiteString" or not boxed_value_types.has(member.c_name) {
        return false
    }
    crash boxed_value_types[member.c_name]
    return is_tagged_in_place(boxed_value_types[member.c_name])
}

func value_class_test(code: String, value_type: Analysis.SpiteType, member: Analysis.ClassInfo): String {
    var tagged = tagged_shape_of(value_type)
    if tagged {
        return tagged_member_test(code, member)
    }
    return class_id_test(code, member)
}

func tagged_member_test(code: String, member: Analysis.ClassInfo): String {
    if member.c_name == "SpiteString" {
        return "((({code}).tag == 0) && (({code}).plain == 0))"
    }
    return "(({code}).tag == {member.class_id})"
}

func member_value_code(code: String, value_type: Analysis.SpiteType, member: Analysis.ClassInfo): String {
    var tagged = tagged_shape_of(value_type)
    if not tagged {
        if boxed_value_types.has(member.c_name) {
            return "(((SpiteBox_{member.c_name}*)({code}))->value)"
        }
        var class_type = instance_type_of(member)
        return "(({c_type_name(class_type)})({code}))"
    }
    if is_plain_member(member) {
        crash boxed_value_types[member.c_name]
        var plain_c_type = c_type_name(boxed_value_types[member.c_name])
        return "SPITE_TAGGED_VALUE({code}, {plain_c_type})"
    }
    if boxed_value_types.has(member.c_name) {
        return "(((SpiteBox_{member.c_name}*)({code}).value.object)->value)"
    }
    var object_type = instance_type_of(member)
    return "(({c_type_name(object_type)})({code}).value.object)"
}

func object_pointer_code(code: String, value_type: Analysis.SpiteType): String {
    var tagged = tagged_shape_of(value_type)
    if tagged {
        return "({code}).value.object"
    }
    return code
}

func tagged_value(code: String, from: Analysis.SpiteType, information: Analysis.UnionInfo): String {
    var from_tagged = tagged_shape_of(from)
    if from_tagged {
        if from_tagged.c_name != information.c_name {
            admit_members_of(from_tagged, information)
            record_shape_flow(from_tagged, information)
        }
        return code
    }
    if type_shape.as_string(from) {
        var string_class = find_class_by_c_name("SpiteString")
        crash string_class
        admit_to_union(information, string_class)
        return "spite_tagged_object({string_class.class_id}, {boxed_text(code)})"
    }
    var boxed_class = boxed_class_of(from)
    if boxed_class {
        admit_to_union(information, boxed_class)
        if is_tagged_in_place(from) {
            return "{ensure_tag(boxed_class, from)}({code})"
        }
        var box_maker = ensure_box(boxed_class, from)
        return "spite_tagged_object({boxed_class.class_id}, {box_maker}({code}))"
    }
    var container_class = container_class_of(from)
    if container_class {
        admit_to_union(information, container_class)
        return "spite_tagged_object({container_class.class_id}, (void*)({code}))"
    }
    var class_ref = type_shape.as_class_ref(from)
    if class_ref {
        var admitted = find_class_by_c_name(class_ref.c_name)
        if admitted {
            if not information.has_member(admitted.c_name) {
                admit_to_union(information, admitted)
            }
            return "spite_tagged_object({admitted.class_id}, (void*)({code}))"
        }
    }
    var from_union = type_shape.as_union(from)
    if from_union {
        var from_information = find_union_by_c_name(from_union.c_name)
        if from_information {
            var member_index = 0
            while member_index < from_information.members.count() {
                var member = from_information.members[member_index]
                if not information.has_member(member.c_name) {
                    admit_to_union(information, member)
                }
                member_index = member_index + 1
            }
            if from_information.is_shape {
                record_shape_flow(from_information, information)
            }
        }
    } else {
        var to = union_type_of(information)
        report_mismatch(from, to, code)
    }
    return "spite_tagged_from_pointer((void*)({code}))"
}

func is_tagged_in_place(value_type: Analysis.SpiteType): Boolean {
    if type_shape.as_scalar(value_type) {
        return true
    }
    if type_shape.as_enum(value_type) {
        return true
    }
    return false
}

func ensure_tag(member: Analysis.ClassInfo, value_type: Analysis.SpiteType): String {
    var maker = "spite_tagged_{member.c_name}"
    if tagged_makers.has(member.c_name) {
        return maker
    }
    tagged_makers[member.c_name] = true
    ensure_box(member, value_type)
    var value_c_type = c_type_name(value_type)
    builder.add_prototype("static inline SpiteTagged {maker}({value_c_type} value);")
    builder.add_support(
        "static inline SpiteTagged {maker}({value_c_type} value) \{\nSpiteTagged tagged;\ntagged.tag = {member.class_id};\ntagged.plain = 1;\ntagged.value.bits = 0;\nmemcpy(&tagged.value, &value, sizeof(value));\nreturn tagged;\n}",
    )
    return maker
}

func class_id_test(code: String, information: Analysis.ClassInfo): String {
    if information.c_name == "SpiteString" {
        return "(((SpiteHeader*)({code}))->class_id <= 0)"
    }
    return "(((SpiteHeader*)({code}))->class_id == {information.class_id})"
}

func shaped_value(
    code: String,
    from: Analysis.SpiteType,
    to: Analysis.SpiteType,
    information: Analysis.UnionInfo,
): String {
    if information.is_tagged {
        return tagged_value(code, from, information)
    }
    if type_shape.as_string(from) {
        var string_class = find_class_by_c_name("SpiteString")
        crash string_class
        admit_to_union(information, string_class)
        return "(({information.c_name})({boxed_text(code)}))"
    }
    var boxed_class = boxed_class_of(from)
    if boxed_class {
        admit_to_union(information, boxed_class)
        return "{ensure_box(boxed_class, from)}({code})"
    }
    var container_class = container_class_of(from)
    if container_class {
        admit_to_union(information, container_class)
        return "(({information.c_name})({code}))"
    }
    var from_union = type_shape.as_union(from)
    if from_union {
        var from_information = find_union_by_c_name(from_union.c_name)
        if from_information {
            var member_index = 0
            while member_index < from_information.members.count() {
                admit_to_union(information, from_information.members[member_index])
                member_index = member_index + 1
            }
            if from_information.is_shape {
                record_shape_flow(from_information, information)
            }
        }
    } else {
        report_mismatch(from, to, code)
    }
    return "(({information.c_name})({code}))"
}

func record_shape_flow(source: Analysis.UnionInfo, target: Analysis.UnionInfo) {
    var key = "{source.c_name}>{target.c_name}"
    note_fact("flow {key}")
    assert not shape_flow_keys.contains(key)
    shape_flow_keys.append(key)
    shape_flow_sources.append(source.c_name)
    shape_flow_targets.append(target)
}

func admit_members_of(source: Analysis.UnionInfo, target: Analysis.UnionInfo) {
    var index = 0
    while index < source.members.count() {
        var member = source.members[index]
        if not target.has_member(member.c_name) {
            admit_to_union(target, member)
        }
        index = index + 1
    }
}

func admit_along_flows(source: Analysis.UnionInfo, candidate: Analysis.ClassInfo) {
    var index = 0
    while index < shape_flow_sources.count() {
        if shape_flow_sources[index] == source.c_name {
            crash shape_flow_targets[index]
            admit_to_union(shape_flow_targets[index], candidate)
        }
        index = index + 1
    }
}

func is_boxed_into_shape(from: Analysis.SpiteType, to: Analysis.SpiteType): Boolean {
    var to_union = type_shape.as_union(to)
    if not to_union {
        return false
    }
    var information = find_union_by_c_name(to_union.c_name)
    if not information {
        return false
    }
    if not information.is_shape {
        return false
    }
    var boxed_class = boxed_class_of(from)
    if boxed_class {
        return true
    }
    return false
}

func is_shape_type(spite_type: Analysis.SpiteType): Boolean {
    var union_type = type_shape.as_union(spite_type)
    if not union_type {
        return false
    }
    var information = find_union_by_c_name(union_type.c_name)
    if not information {
        return false
    }
    return information.is_shape
}

func container_class_of(from: Analysis.SpiteType): Analysis.ClassInfo? {
    var list_type = type_shape.as_list(from)
    if list_type {
        var element = list_type.element
        return list_class_of(element)
    }
    var dictionary_type = type_shape.as_dictionary(from)
    if dictionary_type {
        var ensured_dictionary = ensure_dictionary(dictionary_type)
        return find_class_by_c_name(ensured_dictionary)
    }
    return null
}

func instance_type_of(information: Analysis.ClassInfo): Analysis.SpiteType {
    if synthetic_value_types.has(information.c_name) {
        crash synthetic_value_types[information.c_name]
        return synthetic_value_types[information.c_name]
    }
    if information.qualified_dotted == "List" and information.codegen_types.count() == 1 {
        return list_type_of(information.codegen_types[0])
    }
    if information.qualified_dotted == "Dictionary" and information.codegen_types.count() == 2 {
        return fixed_dictionary_type(information)
    }
    return value_class_type(information)
}

func debug_class_of(debugged_type: Analysis.SpiteType): Analysis.ClassInfo {
    var template_name = "Spite.Debug"
    if type_shape.as_class_ref(debugged_type) {
        template_name = "Spite.DebugInstance"
    }
    var debug_template = find_class_by_qualified(template_name)
    crash debug_template
    var label = "{debug_template.c_name}__{exact_type_label(debugged_type)}"
    var existing = find_class_by_c_name(label)
    if existing {
        return existing
    }
    var types = List<Analysis.SpiteType>()
    types.append(debugged_type)
    var codes = List<String>()
    codes.append("")
    var texts = List<String>()
    texts.append("")
    return instantiated_with(debug_template, types, codes, texts, label)
}

func automatic_debug(information: Analysis.ClassInfo): Analysis.FunctionInfo? {
    assert not information.is_generic_template
    var debugged_type = instance_type_of(information)
    var debug_class = debug_class_of(debugged_type)
    var described = find_or_instantiate_function(debug_class, "text")
    crash described
    var string_spite_type = string_type()
    var no_parameters = List<Analysis.ParamInfo>()
    var no_statements = List<Syntax.Statements.Statement>()
    var function = Analysis.FunctionInfo(
        "to_debug",
        "{information.c_name}_to_debug",
        no_parameters,
        string_spite_type,
        no_statements,
        false,
    )
    function.has_body = false
    var body = "{debug_class.c_name}* spite_debug = {singleton_call(debug_class)};\nSpiteString spite_text = {described.c_name}(spite_debug, {retain_call(debugged_type, "self")});\n{debug_class.c_name}___release(spite_debug);\nreturn spite_text;"
    function.supplied_body = body
    information.declared_functions.append(function)
    if synthetic_value_types.has(information.c_name) {
        function.is_emitted = true
        var signature = "SpiteString {function.c_name}({c_type_name(debugged_type)} self)"
        builder.add_prototype("{signature};")
        builder.add_support("{signature} \{\n{body}\n}")
        return function
    }
    builder.add_prototype("{function_signature(information, function)};")
    return function
}

func boxed_class_of(from: Analysis.SpiteType): Analysis.ClassInfo? {
    var scalar = type_shape.as_scalar(from)
    if scalar {
        return value_class_of(scalar.kind)
    }
    if type_shape.is_symbol(from) {
        return synthetic_value_class("SpiteSymbol", from, "return SpiteString___retain(self);")
    }
    var enum_type = type_shape.as_enum(from)
    if enum_type {
        return synthetic_value_class(
            enum_type.c_name,
            from,
            "return spite_string_from_cstring_owned({enum_type.c_name}___name(self));",
        )
    }
    return null
}

func synthetic_value_class(c_name: String, value_type: Analysis.SpiteType, to_string_body: String): Analysis.ClassInfo {
    var existing = synthetic_value_classes.find_by_c_name(c_name)
    if existing {
        return existing
    }
    var display_name = type_display_name(value_type)
    var created = Analysis.ClassInfo(c_name, display_name, "", display_name, 0)
    created.is_value_class = true
    var string_spite_type = string_type()
    var no_parameters = List<Analysis.ParamInfo>()
    var no_statements = List<Syntax.Statements.Statement>()
    var to_string = Analysis.FunctionInfo(
        "to_string",
        "{c_name}_to_string",
        no_parameters,
        string_spite_type,
        no_statements,
        false,
    )
    to_string.is_emitted = true
    created.declared_functions.append(to_string)
    synthetic_value_classes.append(created)
    synthetic_value_types[c_name] = value_type
    var signature = "SpiteString {c_name}_to_string({c_type_name(value_type)} self)"
    builder.add_prototype("{signature};")
    builder.add_support("{signature} \{\n{to_string_body}\n}")
    return created
}

func boxed_text(code: String): String {
    var string_class = find_class_by_c_name("SpiteString")
    crash string_class
    if not boxed_value_types.has(string_class.c_name) {
        var string_spite_type = string_type()
        boxed_value_types[string_class.c_name] = string_spite_type
        builder.add_prototype("void* spite_box_SpiteString(SpiteString value);")
        builder.add_prototype("void spite_string_box_release(void* self);")
        var boxed_registration = debug_registration("self", string_class.class_id)
        builder.add_support(
            "void* spite_box_SpiteString(SpiteString value) \{\nSpiteBox_SpiteString* self = (SpiteBox_SpiteString*)SPITE_MALLOC(sizeof(SpiteBox_SpiteString));\nself->header.ref_count = 1;\nself->header.class_id = {string_class.class_id};\n{boxed_registration}self->value = value;\nreturn self;\n}",
        )
        builder.add_support(
            "void spite_string_box_release(void* self) \{\nSpiteBox_SpiteString* box = (SpiteBox_SpiteString*)self;\nif (box->header.class_id < 0) return;\nif (SPITE_COUNT_DOWN(box->header.ref_count) > 0) return;\nSpiteString___release(box->value);\nSPITE_FREE(box);\n}",
        )
    }
    if constant_texts[code] {
        var boxed_name = "{code}_box"
        if not constant_boxes.contains(boxed_name) {
            constant_boxes.append(boxed_name)
            builder.add_typedef(
                "static SpiteBox_SpiteString {boxed_name} = \{ \{ 0, -1 }, SPITE_STATIC_STRING(\"{escape_c_string(constant_texts[code])}\", {constant_texts[code].length()}) };",
            )
        }
        return "((void*)&{boxed_name})"
    }
    return "spite_box_SpiteString({code})"
}

func ensure_box(member: Analysis.ClassInfo, value_type: Analysis.SpiteType): String {
    var maker = "spite_box_{member.c_name}"
    if boxed_value_types.has(member.c_name) {
        return maker
    }
    if not box_release_emitted {
        box_release_emitted = true
        builder.add_prototype("void spite_box_release(void* self);")
        builder.add_support(
            "void spite_box_release(void* self) \{\nif (SPITE_COUNT_DOWN(((SpiteHeader*)self)->ref_count) > 0) return;\nSPITE_FREE(self);\n}",
        )
    }
    boxed_value_types[member.c_name] = value_type
    member.class_id = allocate_class_id_of(member.simple_name, "box {member.c_name}")
    var box = "SpiteBox_{member.c_name}"
    var value_c_type = c_type_name(value_type)
    builder.add_typedef("typedef struct {box} \{ SpiteHeader header; {value_c_type} value; } {box};")
    builder.add_prototype("void* {maker}({value_c_type} value);")
    var registered = debug_registration("self", member.class_id)
    builder.add_support(
        "void* {maker}({value_c_type} value) \{\n{box}* self = ({box}*)SPITE_MALLOC(sizeof({box}));\nself->header.ref_count = 1;\nself->header.class_id = {member.class_id};\n{registered}self->value = value;\nreturn self;\n}",
    )
    return maker
}

func emit_unions() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var name = information.c_name
        builder.add_prototype("{name} {name}___retain({name} self);")
        builder.add_prototype("void {name}___release({name} self);")
        if information.is_tagged {
            builder.add_typedef("typedef SpiteTagged {name};")
            builder.add_support(
                "{name} {name}___retain({name} self) \{\nif (self.plain == 0 && self.value.object != 0) SPITE_COUNT_UP(((SpiteHeader*)self.value.object)->ref_count);\nreturn self;\n}",
            )
        } else {
            builder.add_typedef("typedef void* {name};")
            builder.add_support(
                "{name} {name}___retain({name} self) \{\nif (self != 0) SPITE_COUNT_UP(((SpiteHeader*)self)->ref_count);\nreturn self;\n}",
            )
        }
        if not information.is_shape {
            emit_union_release(information)
        }
        index = index + 1
    }
}

func register_enums(entry: Discovery.DiscoveredClass) {
    var file = entry.file
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_enum_declaration(file.statements[statement_index])
        if declaration {
            current_path = file.path
            current_line = declaration.line
            current_owner = entry.qualified_dotted
            current_function = ""
            check_type_name(declaration.name, "enum")
            var value_index = 0
            while value_index < declaration.values.count() {
                check_value_name(declaration.values[value_index], "enum value")
                value_index = value_index + 1
            }
            var enumeration = Analysis.EnumInfo(
                "{entry.mangled_name}_{declaration.name}",
                declaration.name,
                entry.qualified_dotted,
                declaration.values,
            )
            enumeration.numbers = written_enum_numbers(declaration)
            enums.append(enumeration)
        }
        statement_index = statement_index + 1
    }
}

func written_enum_numbers(declaration: Syntax.Statements.EnumDeclaration): List<Integer> {
    var numbers = List<Integer>()
    if not has_written_number(declaration) {
        return numbers
    }
    var owners = Dictionary<String, String>()
    var next: Long = 0
    var index = 0
    while index < declaration.values.count() {
        var value = declaration.values[index]
        var written = declaration.numbers[index]
        crash written
        var number = next
        if not written.is_empty() {
            var read = written.to_long()
            crash read
            number = read
        }
        if number < Integer.smallest or number > Integer.largest {
            report(
                "'{value}' would be number {number} of enum '{declaration.name}', which does not fit an Integer: an enum value's number is an Integer",
            )
            return List<Integer>()
        }
        var key = number.to_string()
        var owner = owners[key]
        if owner {
            report(
                "'{owner}' and '{value}' both have the number {number} in enum '{declaration.name}': a value's number is its identity, so give one of them another",
            )
            return List<Integer>()
        }
        owners[key] = value
        var whole = number.to_integer()
        numbers.append(whole)
        next = number + 1
        index = index + 1
    }
    return numbers
}

func has_written_number(declaration: Syntax.Statements.EnumDeclaration): Boolean {
    var index = 0
    while index < declaration.numbers.count() {
        var written = declaration.numbers[index]
        if not written.is_empty() {
            return true
        }
        index = index + 1
    }
    return false
}

func find_enum(name: String): Analysis.EnumInfo? {
    var fallback: Analysis.EnumInfo? = null
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        if candidate.simple_name == name {
            if candidate.owner_qualified == current_owner {
                return candidate
            }
            fallback = candidate
        }
        index = index + 1
    }
    return fallback
}

func find_enum_qualified(owner_qualified: String, name: String): Analysis.EnumInfo? {
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        if candidate.simple_name == name and candidate.owner_qualified == owner_qualified {
            return candidate
        }
        index = index + 1
    }
    return null
}

func find_enum_with_value(value: String): Analysis.EnumInfo? {
    var found: Analysis.EnumInfo? = null
    var matches = 0
    var index = 0
    while index < enums.count() {
        if enums[index].has_value(value) {
            found = enums[index]
            matches = matches + 1
        }
        index = index + 1
    }
    if matches == 1 {
        return found
    }
    return null
}

func enum_type_of(information: Analysis.EnumInfo): Analysis.SpiteType {
    return Analysis.Types.EnumType(information.c_name, information.values)
}

func enum_value_code(literal: Syntax.Expressions.EnumLiteralExpression, enum_type: Analysis.Types.EnumType): String {
    if not enum_type.values.contains(literal.value) {
        report("'{literal.value}' is not a value of this enum")
    }
    return "{enum_type.c_name}_{literal.value}"
}

func emit_enums() {
    var index = 0
    while index < enums.count() {
        var information = enums[index]
        var typedef_lines = List<String>()
        typedef_lines.append("typedef enum \{")
        var name_lines = List<String>()
        name_lines.append("const char* {information.c_name}___name({information.c_name} value) \{")
        name_lines.append("switch (value) \{")
        var numbers = enum_numbers(information)
        var value_index = 0
        while value_index < information.values.count() {
            var value_name = information.values[value_index]
            if hot_reload or information.is_numbered() {
                crash numbers[value_name]
                typedef_lines.append("{information.c_name}_{value_name} = {numbers[value_name]},")
            } else {
                typedef_lines.append("{information.c_name}_{value_name},")
            }
            name_lines.append("case {information.c_name}_{value_name}: return \"{value_name}\";")
            value_index = value_index + 1
        }
        var removed = removed_enum_values(information, numbers)
        var removed_index = 0
        while removed_index < removed.count() {
            var removed_name = removed[removed_index]
            crash numbers[removed_name]
            typedef_lines.append("{information.c_name}_{removed_name} = {numbers[removed_name]},")
            name_lines.append("case {information.c_name}_{removed_name}: return \"{removed_name}\";")
            removed_index = removed_index + 1
        }
        typedef_lines.append("} {information.c_name};")
        var enum_typedef = typedef_lines.join("\n")
        enum_typedefs[information.c_name] = enum_typedef.replace("\n", " ")
        name_lines.append("}")
        name_lines.append("return \"\";")
        name_lines.append("}")
        var joined_typedef_lines = typedef_lines.join("\n")
        builder.add_typedef(joined_typedef_lines)
        builder.add_prototype("const char* {information.c_name}___name({information.c_name} value);")
        var joined_name_lines = name_lines.join("\n")
        var owner = enum_owner(information)
        if owner {
            note_support_slot(owner, "'s names of {information.simple_name}")
        }
        builder.add_support(joined_name_lines)
        index = index + 1
    }
}

func enum_shown(c_name: String): String {
    var index = 0
    while index < enums.count() {
        if enums[index].c_name == c_name {
            return enum_display_name(enums[index])
        }
        index = index + 1
    }
    return c_name
}

func enum_owner(information: Analysis.EnumInfo): Analysis.ClassInfo? {
    assert hot_reload and not information.owner_qualified.is_empty()
    return find_class_by_qualified(information.owner_qualified)
}

func enum_numbers(information: Analysis.EnumInfo): Dictionary<String, Integer> {
    var numbers = Dictionary<String, Integer>()
    if information.is_numbered() {
        var index = 0
        while index < information.values.count() {
            var value_name = information.values[index]
            var number = information.numbers[index]
            crash number
            numbers[value_name] = number
            index = index + 1
        }
        refuse_renumbering(information, numbers)
        return numbers
    }
    if layout_host {
        numbers = layout_host.host_enum_numbers(information.c_name)
    }
    var next = 0
    var known = numbers.keys()
    var known_index = 0
    while known_index < known.count() {
        var known_name = known[known_index]
        crash numbers[known_name]
        if numbers[known_name] >= next {
            next = numbers[known_name] + 1
        }
        known_index = known_index + 1
    }
    var index = 0
    while index < information.values.count() {
        var value_name = information.values[index]
        if not numbers.has(value_name) {
            numbers[value_name] = next
            next = next + 1
        }
        index = index + 1
    }
    return numbers
}

func refuse_renumbering(information: Analysis.EnumInfo, numbers: Dictionary<String, Integer>) {
    assert layout_host
    var running = layout_host.host_enum_numbers(information.c_name)
    var names = running.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var before = running[name]
        var now = numbers[name]
        if before and now and before != now {
            report(
                "a reload cannot give '{name}' of enum '{information.simple_name}' the number {now}: the running program stores it as {before}, so restart it to renumber",
            )
            return
        }
        index = index + 1
    }
}

func removed_enum_values(information: Analysis.EnumInfo, numbers: Dictionary<String, Integer>): List<String> {
    var removed = List<String>()
    if not hot_reload {
        return removed
    }
    var names = numbers.keys()
    var index = 0
    while index < names.count() {
        if not information.values.contains(names[index]) {
            removed.append(names[index])
        }
        index = index + 1
    }
    return removed
}

func find_class_by_qualified(qualified: String): Analysis.ClassInfo? {
    index_new_classes()
    assert class_by_qualified[qualified]
    var position = class_by_qualified[qualified]
    return classes[position]
}

func find_class_by_c_name(c_name: String): Analysis.ClassInfo? {
    index_new_classes()
    assert class_by_c_name[c_name]
    var position = class_by_c_name[c_name]
    return classes[position]
}

func index_new_classes() {
    while classes_indexed < classes.count() {
        var information = classes[classes_indexed]
        if not class_by_qualified.has(information.qualified_dotted) {
            class_by_qualified[information.qualified_dotted] = classes_indexed
        }
        if not class_by_c_name.has(information.c_name) {
            class_by_c_name[information.c_name] = classes_indexed
        }
        classes_indexed = classes_indexed + 1
    }
}

func find_class(name: String, current_namespace: String): Analysis.ClassInfo? {
    var segments = current_namespace.split(".")
    if current_namespace.is_empty() {
        segments.clear()
    }
    if version_notes.count() > 0 {
        return find_class_in_versions(name, segments)
    }
    while not segments.is_empty() {
        var inside = find_class_by_qualified("{segments.join(".")}.{name}")
        if inside {
            return inside
        }
        segments.remove_last()
    }
    return find_class_by_qualified(name)
}

func versions_holding(name: String): String? {
    var holding = List<String>()
    var prefixes = version_notes.keys()
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        var note = version_notes[prefix]
        if note and find_class_by_qualified("{prefix}.{name}") {
            holding.append(note)
        }
        index = index + 1
    }
    assert not holding.is_empty()
    return "'{name}' is a class of a repository this program loads at more than one commit ({holding.join("; ")}), and this package loads none of them: a package reads the version it loads, so load the one it means here"
}

func note_pinned_versions(entry: Discovery.DiscoveredClass) {
    assert not entry.pinned_versions.is_empty()
    pinned_versions_of[entry.qualified_dotted] = entry.pinned_versions
    var own = entry.qualified_dotted.split(".")[0]
    if own and version_notes.has(own) {
        pinned_versions_in[own] = entry.pinned_versions
    }
}

func find_class_in_versions(name: String, segments: List<String>): Analysis.ClassInfo? {
    var own = ""
    if not segments.is_empty() and version_notes.has(segments[0]) {
        own = segments[0]
        segments.remove_at(0)
    }
    var candidates = [own]
    var pinned = pinned_versions_of[current_owner]
    if not own.is_empty() {
        pinned = pinned_versions_in[own]
    }
    if pinned {
        var pinned_index = 0
        while pinned_index < pinned.count() {
            if not candidates.contains(pinned[pinned_index]) {
                candidates.append(pinned[pinned_index])
            }
            pinned_index = pinned_index + 1
        }
    }
    var level = segments.count()
    while level >= 0 {
        var index = 0
        while index < candidates.count() {
            var inside = find_class_at_level(name, candidates[index], segments, level)
            if inside {
                return inside
            }
            index = index + 1
        }
        level = level - 1
    }
    assert not own.is_empty()
    return find_class_by_qualified(name)
}

func find_class_at_level(name: String, version: String, segments: List<String>, level: Integer): Analysis.ClassInfo? {
    var parts = List<String>()
    if not version.is_empty() {
        parts.append(version)
    }
    var index = 0
    while index < level and index < segments.count() {
        parts.append(segments[index])
        index = index + 1
    }
    if parts.is_empty() {
        return find_class_by_qualified(name)
    }
    var namespace = parts.join(".")
    var inside = find_class_by_qualified("{namespace}.{name}")
    if inside {
        return inside
    }
    return null
}

func nearest_declaring_owner(name: String, current_namespace: String): String {
    var segments = current_namespace.split(".")
    if current_namespace.is_empty() {
        segments.clear()
    }
    while not segments.is_empty() {
        var owner = segments.join(".")
        if declares_type_named(owner, name) {
            return owner
        }
        if find_class_by_qualified("{owner}.{name}") {
            return ""
        }
        segments.remove_last()
    }
    return ""
}

func declares_type_named(owner: String, name: String): Boolean {
    if find_union_qualified(owner, name) {
        return true
    }
    if find_enum_qualified(owner, name) {
        return true
    }
    return false
}

func resolve_classes(discovered: List<Discovery.DiscoveredClass>) {
    resolve_discovered(discovered, true)
    resolve_discovered(discovered, false)
}

func resolve_discovered(discovered: List<Discovery.DiscoveredClass>, functions_pass: Boolean) {
    var index = 0
    while index < discovered.count() {
        var position = first_discovered_class + index
        crash classes[position]
        if not classes[position].is_generic_template {
            resolve_class_body(discovered[index], classes[position], functions_pass)
        }
        index = index + 1
    }
}

func resolve_class_body(entry: Discovery.DiscoveredClass, information: Analysis.ClassInfo, functions_pass: Boolean) {
    var file = entry.file
    current_owner = information.qualified_dotted
    current_class = information
    current_path = information.source_path
    current_function = ""
    var empty_scope = Scope(null)
    var statement_index = 0
    while statement_index < file.statements.count() {
        var statement = file.statements[statement_index]
        current_line = statement.line
        current_path = information.source_path
        var reopened_function = shape.as_function_declaration(statement)
        if reopened_function {
            if not reopened_function.source_path.is_empty() {
                current_path = reopened_function.source_path
            }
        }
        var reopened_variable = shape.as_variable_declaration(statement)
        if reopened_variable {
            if not reopened_variable.source_path.is_empty() {
                current_path = reopened_variable.source_path
            }
        }
        var variable_declaration = shape.as_variable_declaration(statement)
        if variable_declaration {
            if not functions_pass {
                resolve_field(variable_declaration, information, empty_scope, file.statements)
            }
        }
        var function_declaration = shape.as_function_declaration(statement)
        if function_declaration {
            if functions_pass {
                resolve_function(function_declaration, information)
            }
        }
        statement_index = statement_index + 1
    }
    if not functions_pass {
        refuse_json_keys(information)
    }
}

func infer_declared_type(
    annotation: Syntax.Types.Type?,
    initializer: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType {
    if annotation {
        var resolved = resolve_type(annotation, class_information.qualified_dotted)
        if resolved {
            return resolved
        }
        return void_type()
    }
    var result = generate_expression(initializer, scope, class_information)
    return result.type
}

func resolve_field(
    declaration: Syntax.Statements.VariableDeclaration,
    information: Analysis.ClassInfo,
    scope: Scope,
    file_statements: List<Syntax.Statements.Statement>,
) {
    assert declaration.value
    check_value_name(declaration.name, "attribute")
    check_reflection_name(declaration.name, "attribute", information)
    report_nested_calls_in(declaration.value)
    report_singletons_in_declared(declaration.value, information)
    report_written_handle_type(declaration)
    if information.is_value_class and information.c_name != "SpiteString" {
        var bound_singleton = constructed_singleton(declaration.value, information)
        if not bound_singleton {
            information.memory_bytes = declared_memory_bytes(declaration)
            information.memory_path = current_path
            information.memory_line = current_line
            var memory_type = long_type()
            var field = Analysis.FieldInfo(declaration.name, memory_type, "0")
            information.fields.append(field)
        }
        return
    }
    var field_type = infer_declared_type(declaration.type_reference, declaration.value, scope, information)
    var errors_before = errors_reported
    report_function_shape_default(declaration, field_type, information, file_statements)
    if errors_reported == errors_before and not constructor_assigns(information.simple_name, declaration.name, file_statements) {
        report_null_default(declaration, field_type, "attribute")
    }
    var default_code = coerce_for_store(declaration.value, field_type, scope, information)
    if declaration.hardcoded_value {
        default_code = coerce_for_store(declaration.hardcoded_value, field_type, scope, information)
        hardcoded_settings.append(declaration)
    }
    if information.qualified_dotted == "String.Inflection" {
        read_inflection_words(declaration)
    }
    var field = Analysis.FieldInfo(declaration.name, field_type, default_code)
    field.line = declaration.line
    information.fields.append(field)
    note_source_path(information, declaration.source_path)
}

func report_null_default(
    declaration: Syntax.Statements.VariableDeclaration,
    declared: Analysis.SpiteType,
    kind: String,
) {
    crash declaration.value
    assert declaration.type_reference
    assert shape.is_null_literal(declaration.value) and not type_shape.as_nullable(declared)
    assert not type_shape.is_void(declared)
    var written = Syntax.SourcePrinter().source_type(declaration.type_reference)
    var made = default_spelling(written, declared)
    var default_text = ""
    if not made.is_empty() {
        default_text = ", or 'var {declaration.name} = {made}' for a default"
    }
    if kind == "attribute" {
        default_text = "{default_text}, or keep '= null' and assign it at the top of the constructor"
    }
    report(
        "the {kind} '{declaration.name}' is declared '{written}', not '{written}?', so '= null' would make a default {written} rather than nothing: write 'var {declaration.name}: {written}? = null' for none yet, narrowed before use{default_text}",
    )
}

func default_spelling(written: String, declared: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(declared)
    if scalar {
        if scalar.kind == 'boolean_kind' {
            return "false"
        }
        if is_float_kind(scalar.kind) {
            return "0.0"
        }
        return "0"
    }
    if type_shape.as_string(declared) {
        return "\"\""
    }
    var named = type_shape.as_class_ref(declared)
    if named or type_shape.as_list(declared) or type_shape.as_dictionary(declared) {
        if named {
            if named.has_signature {
                return ""
            }
        }
        return "{written}()"
    }
    return ""
}

func filled_by_walk(
    declaration: Syntax.Statements.VariableDeclaration,
    class_information: Analysis.ClassInfo,
): Boolean {
    var next_index = borrow_index + 1
    if borrow_index >= borrow_statements.count() or next_index >= borrow_statements.count() {
        return false
    }
    var here_statement = borrow_statements[borrow_index]
    var here = shape.as_variable_declaration(here_statement)
    if not here {
        return false
    }
    if here.name != declaration.name or here.line != declaration.line {
        return false
    }
    return walks_into(borrow_statements, next_index, declaration.name, class_information)
}

func walks_into(
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    name: String,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = start
    while index < statements.count() {
        var statement = statements[index]
        if statement_walks_into(statement, name, class_information) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_walks_into(
    statement: Syntax.Statements.Statement,
    name: String,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            var call = shape.as_call(statement.value)
            if not call {
                return false
            }
            crash call.callee
            if each_walk_of(call.callee, name) {
                return true
            }
            var callee = shape.as_identifier(call.callee)
            if not callee {
                return false
            }
            if not walk_template(class_information, callee.name) {
                return false
            }
            return row_argument_position(call.arguments, name) < call.arguments.count()
        }
        Syntax.Statements.IfStatement: {
            if walks_into(statement.then_branch, 0, name, class_information) {
                return true
            }
            return walks_into(statement.else_branch, 0, name, class_information)
        }
        Syntax.Statements.WhileStatement: return walks_into(statement.body, 0, name, class_information)
        _: return false
    }
}

func each_walk_of(callee: Syntax.Expressions.Expression, name: String): Boolean {
    var walk = shape.as_member(callee)
    if not walk {
        return false
    }
    if walk.name != "each" {
        return false
    }
    crash walk.object
    var attributes = shape.as_member(walk.object)
    if not attributes {
        return false
    }
    if attributes.name != "attributes" {
        return false
    }
    crash attributes.object
    return is_identifier_named(attributes.object, name)
}

func report_function_shape_default(
    declaration: Syntax.Statements.VariableDeclaration,
    field_type: Analysis.SpiteType,
    information: Analysis.ClassInfo,
    file_statements: List<Syntax.Statements.Statement>,
) {
    crash declaration.value
    assert shape.is_null_literal(declaration.value)
    assert not constructor_assigns(information.simple_name, declaration.name, file_statements)
    var union_type = type_shape.as_union(field_type)
    assert union_type
    var information = find_union_by_c_name(union_type.c_name)
    assert information
    assert information.is_shape
    var required = information.shape_fields.find_by_is_function(true)
    assert required
    report(
        "'{declaration.name}' is {with_article(information.simple_name)}, a type that requires the function '{required.name}', so '= null' has no default to make: no object can supply a function it does not have. Make its type nullable, with a '?', and narrow it before use, or give it a real object in the constructor",
    )
}

func constructor_assigns(
    declaring_class: String,
    name: String,
    file_statements: List<Syntax.Statements.Statement>,
): Boolean {
    var index = 0
    while index < file_statements.count() {
        var constructor = shape.as_function_declaration(file_statements[index])
        if constructor {
            if constructor.name == declaring_class {
                return assigns_at_top(constructor.body, name)
            }
        }
        index = index + 1
    }
    return false
}

func assigns_at_top(statements: List<Syntax.Statements.Statement>, name: String): Boolean {
    var index = 0
    while index < statements.count() {
        var assignment = shape.as_assignment_statement(statements[index])
        if assignment {
            crash assignment.target
            if is_identifier_named(assignment.target, name) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func hardcoded_setting(target_class: Analysis.ClassInfo, name: String): Syntax.Statements.VariableDeclaration? {
    assert target_class.c_name == "Build"
    return hardcoded_settings.find_by_name(name)
}

func read_when_running(setting: Syntax.Statements.VariableDeclaration, reader: Analysis.ClassInfo): Boolean {
    if not hot_reload or is_library_class(reader) or reader.source_path.is_empty() {
        return false
    }
    return not setting.source_path.is_empty() and not setting.source_path.starts_with("library/")
}

func is_hardcoded_setting_name(name: String): Boolean {
    var index = 0
    while index < hardcoded_settings.count() {
        if hardcoded_settings[index].name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func hardcoded_setting_value(
    setting: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash setting.hardcoded_value
    var value = generate_expression(setting.hardcoded_value, scope, class_information)
    value.owning_override = false
    var text = constant_text(setting.hardcoded_value)
    if text {
        value.constant_text = text
    }
    return value
}

func symbol_parameter_of(declaration: Syntax.Statements.FunctionDeclaration): String {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.type_reference {
            var named = shape.as_named_type(parameter.type_reference)
            if named {
                if names_symbol_parameter(named) {
                    return parameter.name
                }
                if named.path.join(".") == "Spite.Attribute" and not named.arguments.is_empty() {
                    var saved_line = current_line
                    current_line = declaration.line
                    report(
                        "'{parameter.name}: Spite.Attribute<...>' would be bound to one instance, and a template is made once for each member of the class, with the instance as its own argument: write '{parameter.name}: Spite.AttributeDeclaration<...>'",
                    )
                    current_line = saved_line
                }
            }
        }
        index = index + 1
    }
    return ""
}

func register_template(declaration: Syntax.Statements.FunctionDeclaration, information: Analysis.ClassInfo): Boolean {
    var symbol_parameter = symbol_parameter_of(declaration)
    if symbol_parameter.is_empty() {
        return false
    }
    var padded_name = "_{declaration.name}_"
    var position = padded_name.index_of("_{symbol_parameter}_")
    var plural_word = program_inflected(symbol_parameter, true)
    var plural_position = padded_name.index_of("_{plural_word}_")
    if position < 0 and plural_position >= 0 and plural_word != symbol_parameter and has_element_templates(information) {
        var plural_prefix = declaration.name.slice(0, plural_position)
        var plural_name_length = declaration.name.length()
        var plural_word_length = plural_word.length()
        var plural_suffix = declaration.name.slice(plural_position + plural_word_length, plural_name_length)
        var plural_template = Analysis.TemplateInfo(declaration, symbol_parameter, plural_prefix, plural_suffix)
        plural_template.range = symbol_range_of(declaration, symbol_parameter)
        plural_template.plural = true
        information.templates.append(plural_template)
        return true
    }
    if position < 0 {
        var passed_range = symbol_range_of(declaration, symbol_parameter)
        if not passed_range {
            return false
        }
        var passed_template_information = Analysis.TemplateInfo(declaration, symbol_parameter, declaration.name, "")
        passed_template_information.range = passed_range
        passed_template_information.passed = true
        information.templates.append(passed_template_information)
        return true
    }
    var prefix = declaration.name.slice(0, position)
    var symbol_parameter_length = symbol_parameter.length()
    var name_length = declaration.name.length()
    var suffix = declaration.name.slice(position + symbol_parameter_length, name_length)
    var template = Analysis.TemplateInfo(declaration, symbol_parameter, prefix, suffix)
    template.range = symbol_range_of(declaration, symbol_parameter)
    report_singular_collection(declaration, information, symbol_parameter)
    if not template.range and information.qualified_dotted == "List" {
        var saved_function = current_function
        current_function = declaration.name
        report(
            "'{declaration.name}' is a template on List, whose own attributes are its buffer, so a plain 'Symbol' answers nothing: write '{symbol_parameter}: Symbol<$element_type>' to name a member of the element",
        )
        current_function = saved_function
    }
    information.templates.append(template)
    check_hole_enum(information, template)
    return true
}

func report_singular_collection(
    declaration: Syntax.Statements.FunctionDeclaration,
    information: Analysis.ClassInfo,
    symbol_parameter: String,
) {
    assert has_element_templates(information)
    assert declaration.return_type
    var printer = Syntax.SourcePrinter()
    var returned = printer.source_type(declaration.return_type)
    assert returned == "List<{symbol_parameter}.class>"
    var plural_word = program_inflected(symbol_parameter, true)
    assert plural_word != symbol_parameter
    var renamed = declaration.name.replace(symbol_parameter, plural_word)
    var saved_function = current_function
    var saved_line = current_line
    current_function = declaration.name
    current_line = declaration.line
    report(
        "'{declaration.name}' answers every '{symbol_parameter}' of the element, a 'List<{symbol_parameter}.class>', so its name holds the member in the plural: '{renamed}'",
    )
    current_function = saved_function
    current_line = saved_line
}

func has_element_templates(information: Analysis.ClassInfo): Boolean {
    var dotted = information.qualified_dotted
    return dotted == "List" or dotted == "Vector" or dotted == "Items" or dotted == "Dictionary"
}

func symbol_range_of(declaration: Syntax.Statements.FunctionDeclaration, symbol_parameter: String): Syntax.Types.Type? {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.name == symbol_parameter and parameter.type_reference {
            var named = shape.as_named_type(parameter.type_reference)
            if named {
                if named.arguments.count() == 1 {
                    var range_argument = shape.as_type_argument(named.arguments[0])
                    if range_argument {
                        return range_argument.value
                    }
                }
            }
        }
        index = index + 1
    }
    return null
}

func template_range_class(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.ClassInfo? {
    if not template.range {
        return information
    }
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    assert range_type
    var range_class_ref = type_shape.as_class_ref(range_type)
    assert range_class_ref
    var range_class = find_class_by_c_name(range_class_ref.c_name)
    assert range_class
    assert not range_class.is_generic_template
    return range_class
}

func walks_no_class(information: Analysis.ClassInfo, template: Analysis.TemplateInfo, member_name: String): Boolean {
    if member_name != "{template.symbol_parameter}s" or information.is_container or not template.range {
        return false
    }
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    if range_type {
        return true
    }
    return false
}

func template_range_shape(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.UnionInfo? {
    assert template.range
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    assert range_type
    var range_union = type_shape.as_union(range_type)
    assert range_union
    var shaped = find_union_by_c_name(range_union.c_name)
    assert shaped
    assert shaped.is_shape
    return shaped
}

func template_range_kind(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): String {
    if not template.range {
        return ""
    }
    if is_function_range(information, template) {
        var path = range_path(template)
        var last_segment = path.last()
        crash last_segment
        if ("_{last_segment}_").contains("_{template.symbol_parameter}_") {
            return "pattern"
        }
        return "function"
    }
    var path = range_path(template)
    if path.is_empty() {
        return codegen_range_kind(information, template)
    }
    var first_segment = path.first()
    crash first_segment
    if first_segment.starts_with("$") {
        return codegen_range_kind(information, template)
    }
    var joined = path.join(".")
    if joined == "Spite.Class" {
        return "namespace"
    }
    if find_class(joined, information.namespace_dotted) or find_union(joined) {
        return "class"
    }
    if find_enum(joined) {
        return "enum"
    }
    var owner_path = path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    var last_segment = path.last()
    crash last_segment
    if find_union_qualified(joined_owner_path, last_segment) {
        return "class"
    }
    if find_enum_qualified(joined_owner_path, last_segment) {
        return "enum"
    }
    return "namespace"
}

func codegen_range_kind(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): String {
    crash template.range
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    if not range_type {
        return "class"
    }
    if type_shape.as_enum(range_type) {
        return "enum"
    }
    return "class"
}

func template_range_enum(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.EnumInfo? {
    assert template.range
    var kind = template_range_kind(information, template)
    if kind == "pattern" {
        return hole_enum(information, template.symbol_parameter)
    }
    assert kind == "enum"
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    assert range_type
    var range_enum = type_shape.as_enum(range_type)
    assert range_enum
    return enums.find_by_c_name(range_enum.c_name)
}

func pascal_name(snake_name: String): String {
    var words = snake_name.split("_")
    var capitalized = ""
    var index = 0
    while index < words.count() {
        var word = words[index]
        var word_length = word.length()
        capitalized = "{capitalized}{word.slice(0, 1).upper_case()}{word.slice(1, word_length)}"
        index = index + 1
    }
    return capitalized
}

func hole_enum(information: Analysis.ClassInfo, hole: String): Analysis.EnumInfo? {
    var name = pascal_name(hole)
    var declaring_owner = nearest_declaring_owner(name, information.qualified_dotted)
    if not declaring_owner.is_empty() {
        var declared_there = find_enum_qualified(declaring_owner, name)
        if declared_there {
            return declared_there
        }
    }
    var named = enums_named(name)
    if named.count() == 1 {
        return named.first()
    }
    return null
}

func enums_named(name: String): List<Analysis.EnumInfo> {
    var named = List<Analysis.EnumInfo>()
    var index = 0
    while index < enums.count() {
        if enums[index].simple_name == name {
            named.append(enums[index])
        }
        index = index + 1
    }
    return named
}

func enum_display_name(information: Analysis.EnumInfo): String {
    if information.owner_qualified.is_empty() {
        return information.simple_name
    }
    return "{information.owner_qualified}.{information.simple_name}"
}

func missing_hole_enum(information: Analysis.ClassInfo, hole: String, pattern: String): String {
    var name = pascal_name(hole)
    var named = enums_named(name)
    if named.count() > 1 {
        var owners = named.map_owner_qualifieds()
        return "the hole '<{hole}>' of '{pattern}' matches only the values of the enum '{name}', and more than one class declares one ('{owners.join("', '")}'): rename one of them, or declare '{name}' in '{information.qualified_dotted}' itself"
    }
    return "the hole '<{hole}>' of '{pattern}' matches only the values of an enum named for it, and there is no enum '{name}': declare 'enum {name}' listing the names it may match, one per line"
}

func pattern_text(template: Analysis.TemplateInfo): String {
    return "{pattern_prefix(template)}<{template.symbol_parameter}>{pattern_suffix(template)}"
}

func check_hole_enum(information: Analysis.ClassInfo, template: Analysis.TemplateInfo) {
    assert not template.passed
    assert template.range
    assert template_range_kind(information, template) == "pattern"
    assert not hole_enum(information, template.symbol_parameter)
    var declaration = template.declaration
    var saved_function = current_function
    var saved_line = current_line
    current_function = declaration.name
    current_line = declaration.line
    var written_pattern = pattern_text(template)
    var missing = missing_hole_enum(information, template.symbol_parameter, written_pattern)
    report(missing)
    current_function = saved_function
    current_line = saved_line
}

func range_path(template: Analysis.TemplateInfo): List<String> {
    assert template.range
    var named = shape.as_named_type(template.range)
    assert named
    assert named.arguments.is_empty()
    return named.path
}

func is_function_range(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Boolean {
    var path = range_path(template)
    if path.count() < 2 {
        return false
    }
    var last_segment = path.last()
    crash last_segment
    var first_segment = path.first()
    crash first_segment
    if first_segment.starts_with("$") {
        if path.count() != 2 {
            return false
        }
        var bare_name = without_dollar(first_segment)
        var bound = codegen_index(information, bare_name)
        if bound < 0 {
            return false
        }
        crash information.codegen_codes[bound]
        if not information.codegen_codes[bound].is_empty() {
            return false
        }
        crash information.codegen_types[bound]
        var bound_type = information.codegen_types[bound]
        if type_shape.as_list(bound_type) or type_shape.as_dictionary(bound_type) or type_shape.as_nullable(bound_type) {
            return last_segment != "element_type" and last_segment != "value_type"
        }
        var bound_class_ref = type_shape.as_class_ref(bound_type)
        if bound_class_ref {
            var bound_class = find_class_by_c_name(bound_class_ref.c_name)
            crash bound_class
            return codegen_index(bound_class, last_segment) < 0
        }
        return true
    }
    var owner_path = path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    var owner = find_class(joined_owner_path, information.namespace_dotted)
    if not owner {
        return false
    }
    var joined = path.join(".")
    if find_class(joined, information.namespace_dotted) {
        return false
    }
    if find_union_qualified(owner.qualified_dotted, last_segment) {
        return false
    }
    return not find_enum_qualified(owner.qualified_dotted, last_segment)
}

func range_function_owner(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.ClassInfo? {
    var path = range_path(template)
    var first_segment = path.first()
    crash first_segment
    if first_segment.starts_with("$") {
        var bare_name = without_dollar(first_segment)
        var bound = codegen_index(information, bare_name)
        crash information.codegen_types[bound]
        var bound_class_ref = type_shape.as_class_ref(information.codegen_types[bound])
        assert bound_class_ref
        return find_class_by_c_name(bound_class_ref.c_name)
    }
    var owner_path = path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    return find_class(joined_owner_path, information.namespace_dotted)
}

func range_function_name(template: Analysis.TemplateInfo): String {
    var path = range_path(template)
    var last_segment = path.last()
    crash last_segment
    if last_segment == bound_pattern and not bound_pattern.is_empty() {
        return bound_function_name
    }
    return last_segment
}

func range_function(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.FunctionInfo? {
    var owner = range_function_owner(information, template)
    assert owner
    var function_name = range_function_name(template)
    var function = owner.find_function(function_name)
    assert function
    assert not function.is_constructor
    return function
}

func declared_functions_of(owner: Analysis.ClassInfo): List<Analysis.FunctionInfo> {
    var declared = List<Analysis.FunctionInfo>()
    var index = 0
    while index < owner.declared_functions.count() {
        var function = owner.declared_functions[index]
        if not function.is_constructor and function.symbol_name.is_empty() and not function.name.starts_with("_") {
            declared.append(function)
        }
        index = index + 1
    }
    return declared
}

func pattern_prefix(template: Analysis.TemplateInfo): String {
    var path = range_path(template)
    var last_segment = path.last()
    crash last_segment
    var padded = "_{last_segment}_"
    var position = padded.index_of("_{template.symbol_parameter}_")
    if position < 0 {
        return ""
    }
    return padded.slice(1, position + 1)
}

func pattern_suffix(template: Analysis.TemplateInfo): String {
    var path = range_path(template)
    var last_segment = path.last()
    crash last_segment
    var padded = "_{last_segment}_"
    var position = padded.index_of("_{template.symbol_parameter}_")
    if position < 0 {
        return ""
    }
    var hole_end = position + template.symbol_parameter.length() + 1
    var padded_length = padded.length()
    return padded.slice(hole_end, padded_length - 1)
}

func pattern_matches(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): List<String> {
    var matches = List<String>()
    var owner = range_function_owner(information, template)
    assert owner
    var hole_values = hole_enum(information, template.symbol_parameter)
    assert hole_values
    var prefix = pattern_prefix(template)
    var suffix = pattern_suffix(template)
    var functions = declared_functions_of(owner)
    var names = functions.map_names()
    var index = 0
    while index < hole_values.values.count() {
        var value = hole_values.values[index]
        if names.contains("{prefix}{value}{suffix}") {
            matches.append(value)
        }
        index = index + 1
    }
    return matches
}

func namespace_classes(template: Analysis.TemplateInfo): List<Analysis.ClassInfo> {
    var walk = namespace_walk(template)
    return walk.classes
}

func namespace_walk(template: Analysis.TemplateInfo): NamespaceWalk {
    var path = range_path(template)
    var joined = path.join(".")
    if not namespace_walks.has(joined) {
        var created = NamespaceWalk()
        namespace_walks[joined] = created
    }
    crash namespace_walks[joined]
    var walk = namespace_walks[joined]
    var grew = false
    while walk.scanned < classes.count() {
        var candidate = classes[walk.scanned]
        var every_class = joined == "Spite.Class" and not candidate.source_path.is_empty() and not candidate.c_name.starts_with("Object_")
        var in_namespace = every_class or candidate.namespace_dotted == joined or candidate.namespace_dotted.ends_with(".{joined}")
        if in_namespace and not candidate.is_generic_template and not is_instantiated_class(candidate) {
            walk.classes.append(candidate)
            grew = true
        }
        walk.scanned = walk.scanned + 1
    }
    if grew {
        index_namespace_walk(walk)
    }
    return walk
}

func index_namespace_walk(walk: NamespaceWalk) {
    walk.classes = walk.classes.sort_by_qualified_dotted()
    walk.member_names = member_names_of(walk.classes)
    walk.first_positions = Dictionary<String, Integer>()
    walk.last_positions = Dictionary<String, Integer>()
    var index = 0
    while index < walk.member_names.count() {
        var member_name = walk.member_names[index]
        if not walk.first_positions.has(member_name) {
            walk.first_positions[member_name] = index
        }
        walk.last_positions[member_name] = index
        index = index + 1
    }
}

func range_miss(information: Analysis.ClassInfo, name: String): String {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        var member_name = ""
        if template.range {
            member_name = template.member_name_for(name)
        }
        if not member_name.is_empty() and template_range_owner(information, template) == "namespace" {
            var path = range_path(template)
            var range = path.join(".")
            var declaration = template.declaration
            var found = namespace_classes(template)
            if found.is_empty() {
                return "'{name}' is '{declaration.name}' for a class '{member_name}', but no folder is named for '{range}', so 'Symbol<{range}>' walks nothing here"
            }
            var members = member_names_of(found)
            return "'{name}' is '{declaration.name}' for a class '{member_name}', but the folders named for '{range}' hold only '{members.join("', '")}'"
        }
        var missed_value = value_range_miss(information, template, name, member_name)
        if not missed_value.is_empty() {
            return missed_value
        }
        index = index + 1
    }
    return ""
}

func value_range_miss(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    name: String,
    member_name: String,
): String {
    if member_name.is_empty() or member_name == "{template.symbol_parameter}s" {
        return ""
    }
    var kind = template_range_owner(information, template)
    if kind != "pattern" and kind != "enum" {
        return ""
    }
    var range_enum = template_range_enum(information, template)
    if not range_enum {
        return ""
    }
    var declaration = template.declaration
    var shown_enum = enum_display_name(range_enum)
    if not range_enum.has_value(member_name) {
        return "'{name}' is '{declaration.name}' for '{member_name}', but '{member_name}' is not a value of '{shown_enum}', which has '{range_enum.values.join("', '")}'"
    }
    if kind != "pattern" {
        return ""
    }
    var owner = range_function_owner(information, template)
    crash owner
    return "'{name}' is '{declaration.name}' for '{member_name}', a value of '{shown_enum}', but '{owner.qualified_dotted}' has no function '{pattern_prefix(template)}{member_name}{pattern_suffix(template)}'"
}

func member_names_of(sources: List<Analysis.ClassInfo>): List<String> {
    var answers = List<String>()
    var index = 0
    while index < sources.count() {
        var answer = class_member_name(sources[index])
        answers.append(answer)
        index = index + 1
    }
    return answers
}

func class_member_name(candidate: Analysis.ClassInfo): String {
    if class_member_names[candidate.qualified_dotted] {
        return class_member_names[candidate.qualified_dotted]
    }
    var member_name = member_name_of(candidate.qualified_dotted)
    class_member_names[candidate.qualified_dotted] = member_name
    return member_name
}

func member_name_of(qualified_dotted: String): String {
    var segments = qualified_dotted.split(".")
    var words = List<String>()
    var index = 0
    while index < segments.count() {
        var segment_words = words_of(segments[index])
        append_lines(words, segment_words)
        index = index + 1
    }
    return words.join("_")
}

func template_range_owner(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): String {
    if template.range {
        var kind = template_range_kind(information, template)
        if kind != "class" {
            return kind
        }
    }
    var range_class = template_range_class(information, template)
    if range_class {
        return range_class.c_name
    }
    var range_shape = template_range_shape(information, template)
    if range_shape {
        return range_shape.c_name
    }
    return ""
}

func shape_member_type(shaped: Analysis.UnionInfo, member_name: String): Analysis.SpiteType? {
    var required = find_required_function(shaped, member_name)
    if required {
        assert required.parameter_types.is_empty()
        return required_return_type(shaped, required)
    }
    return shape_field_type(shaped, member_name)
}

func template_attribute_names(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): List<String> {
    var kind = template_range_owner(information, template)
    if kind == "function" {
        var function = range_function(information, template)
        if function {
            return function.parameters.map_names()
        }
        return List<String>()
    }
    if kind == "pattern" {
        return pattern_matches(information, template)
    }
    if kind == "enum" {
        var range_enum = template_range_enum(information, template)
        crash range_enum
        return range_enum.values.copy()
    }
    if kind == "namespace" {
        var walk = namespace_walk(template)
        return walk.member_names.copy()
    }
    var range_class = template_range_class(information, template)
    if range_class {
        item_values.reflect(range_class.qualified_dotted)
        return range_class.fields.map_names()
    }
    var range_shape = template_range_shape(information, template)
    if range_shape {
        return range_shape.shape_fields.filter_is_attribute().map_names()
    }
    return List<String>()
}

func find_or_instantiate_function(information: Analysis.ClassInfo, name: String): Analysis.FunctionInfo? {
    var existing = information.find_function(name)
    if existing {
        if existing.kept_for_prompt {
            crash not existing.is_emitted
            existing.kept_for_prompt = false
        }
        return existing
    }
    var registered_name = name
    if not bound_pattern.is_empty() and answers_through_pattern(information, name) {
        registered_name = "{name}_in_{bound_function_name}"
        var keyed = information.find_function(registered_name)
        if keyed {
            return keyed
        }
    }
    var chosen: Analysis.TemplateInfo? = null
    var chosen_member = ""
    var chosen_type: Analysis.SpiteType? = null
    var chosen_owner = ""
    var matches = 0
    var index = 0
    var every: Analysis.TemplateInfo? = null
    while index < information.templates.count() {
        var template = information.templates[index]
        var member_name = template.member_name_for(name)
        if not member_name.is_empty() and has_element_templates(information) and not information.codegen_types.is_empty() {
            var listed_element = information.codegen_types.first()
            crash listed_element
            var walked_names = element_member_names(listed_element)
            member_name = template_member_name(template, name, walked_names)
        }
        var range_owner = template_range_owner(information, template)
        if not member_name.is_empty() and not information.is_container and not range_owner.is_empty() {
            var member_type = template_member_type(information, template, member_name)
            if member_type {
                chosen = template
                chosen_member = member_name
                chosen_type = member_type
                chosen_owner = range_owner
                matches = matches + 1
            } else if member_name == "{template.symbol_parameter}s" {
                every = template
            }
        }
        if range_owner.is_empty() and walks_no_class(information, template, member_name) {
            every = template
        }
        index = index + 1
    }
    if matches > 1 {
        report("'{name}' is answered by more than one Symbol codegen function of '{information.simple_name}'")
        return null
    }
    if chosen {
        if chosen_type {
            if not chosen.range or chosen_owner == "function" or chosen_owner == "pattern" or chosen_owner == "namespace" or chosen_owner == "enum" {
                chosen_owner = ""
            }
            var instance = instantiate_template(
                information,
                chosen,
                chosen_member,
                chosen_type,
                chosen_owner,
                registered_name,
                null,
            )
            var walked_position = attribute_position(information, chosen, chosen_member)
            if walked_position >= 0 {
                instance.symbol_field_index = walked_position
            }
            describe_range_binding(information, chosen, instance)
            return instance
        }
    }
    if every {
        var plural = instantiate_every_attribute(information, every, registered_name)
        if plural {
            plural.symbol_pattern = bound_pattern
            plural.symbol_function_name = bound_function_name
        }
        return plural
    }
    assert name == "to_debug"
    return automatic_debug(information)
}

func describe_range_binding(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    instance: Analysis.FunctionInfo,
) {
    instance.symbol_pattern = bound_pattern
    instance.symbol_function_name = bound_function_name
    assert template.range
    var kind = template_range_owner(information, template)
    if kind == "pattern" {
        var path = range_path(template)
        var pattern = path.last()
        crash pattern
        instance.symbol_pattern = pattern
        instance.symbol_function_name = "{pattern_prefix(template)}{instance.symbol_field_name}{pattern_suffix(template)}"
    }
    if kind == "pattern" or kind == "enum" {
        var range_enum = template_range_enum(information, template)
        crash range_enum
        instance.symbol_enum_c_name = range_enum.c_name
    }
    if kind == "namespace" {
        var walk = namespace_walk(template)
        if walk.last_positions[instance.symbol_field_name] {
            var last_position = walk.last_positions[instance.symbol_field_name]
            crash walk.classes[last_position]
            var named = walk.classes[last_position]
            instance.symbol_display_name = named.qualified_dotted
        }
    }
}

func attribute_position(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    member_name: String,
): Integer {
    if template.range and template_range_owner(information, template) == "namespace" {
        var walk = namespace_walk(template)
        if walk.first_positions[member_name] {
            return walk.first_positions[member_name]
        }
        return -1
    }
    var walked_names = template_attribute_names(information, template)
    var walked_position = name_position(walked_names, member_name)
    if walked_position < walked_names.count() {
        return walked_position
    }
    return -1
}

func answers_through_pattern(information: Analysis.ClassInfo, name: String): Boolean {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.range and not template.member_name_for(name).is_empty() {
            if template_range_owner(information, template) == "function" {
                var path = range_path(template)
                if path.last() == bound_pattern {
                    return true
                }
            }
        }
        index = index + 1
    }
    return false
}

func type_named_by(member_name: String): Analysis.SpiteType? {
    var type_name = pascal_name(member_name)
    return value_type_named(type_name)
}

func template_member_type(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    member_name: String,
): Analysis.SpiteType? {
    if template.range {
        var kind = template_range_owner(information, template)
        if kind == "function" {
            var function = range_function(information, template)
            assert function
            var parameter = function.parameters.find_by_name(member_name)
            assert parameter
            return parameter.type
        }
        if kind == "pattern" {
            var matches = pattern_matches(information, template)
            assert matches.contains(member_name)
            var symbol_type: Analysis.SpiteType = Analysis.Types.SymbolType()
            return symbol_type
        }
        if kind == "enum" {
            var range_enum = template_range_enum(information, template)
            crash range_enum
            assert range_enum.has_value(member_name)
            return enum_type_of(range_enum)
        }
        if kind == "namespace" {
            var walk = namespace_walk(template)
            assert walk.first_positions[member_name]
            var first_position = walk.first_positions[member_name]
            crash walk.classes[first_position]
            var named = walk.classes[first_position]
            return class_type_of(named)
        }
        var range_class = template_range_class(information, template)
        if range_class {
            return member_type_of(range_class, member_name)
        }
        var range_shape = template_range_shape(information, template)
        crash range_shape
        return shape_member_type(range_shape, member_name)
    }
    if template.symbol_parameter == "type" {
        return type_named_by(member_name)
    }
    var field = information.find_field(member_name)
    assert field
    return field.type
}

func clashing_function(information: Analysis.ClassInfo, instance_name: String): Analysis.FunctionInfo? {
    var written = information.find_function(instance_name)
    assert written
    assert written.symbol_name.is_empty() and written.line > 0 and not written.is_constructor
    return written
}

func report_template_clash(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    attribute_name: String,
    clashing: Analysis.FunctionInfo,
) {
    var declaration = template.declaration
    var range_owner = information.simple_name
    var range_class = template_range_class(information, template)
    if range_class {
        range_owner = range_class.simple_name
    }
    var saved_path = current_path
    var saved_line = current_line
    var saved_function = current_function
    current_path = clashing.source_path
    if current_path.is_empty() {
        current_path = information.source_path
    }
    current_line = clashing.line
    current_function = clashing.name
    report(
        "the template '{declaration.name}' makes '{clashing.name}' for the attribute '{attribute_name}' of '{range_owner}', which is already a function of '{information.simple_name}': rename the function or the template",
    )
    current_path = saved_path
    current_line = saved_line
    current_function = saved_function
}

func instantiate_every_attribute(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    call_name: String,
): Analysis.FunctionInfo? {
    var declaration = template.declaration
    var kind = ""
    if template.range {
        kind = template_range_owner(information, template)
    }
    if declaration.return_type {
        if kind == "function" {
            var range = range_path(template)
            var ranged_function = range.last()
            crash ranged_function
            report(
                "'{template.prefix}{template.symbol_parameter}s{template.suffix}' makes one value for each argument of '{ranged_function}', so it can only be the whole argument list of a call to '{ranged_function}', as in '{ranged_function}({template.prefix}{template.symbol_parameter}s{template.suffix}())', or else '{declaration.name}' has to return nothing",
            )
            return null
        }
        report(
            "'{call_name}' calls '{declaration.name}' once for every attribute, so '{declaration.name}' has to return nothing",
        )
        return null
    }
    var attribute_names = template_attribute_names(information, template)
    var saved_class = current_class
    var saved_owner = current_owner
    current_class = information
    current_owner = information.qualified_dotted
    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name != template.symbol_parameter and parameter.type_reference {
            var parameter_type = resolve_type(parameter.type_reference, information.qualified_dotted)
            if parameter_type {
                var described_parameter = Analysis.ParamInfo(parameter.name, parameter_type)
                parameters.append(described_parameter)
            }
        }
        parameter_index = parameter_index + 1
    }
    current_class = saved_class
    current_owner = saved_owner
    var body = List<Syntax.Statements.Statement>()
    var stored_by_the_compiler = information.is_value_class
    var range_class = find_class_by_c_name(kind)
    if range_class {
        stored_by_the_compiler = range_class.is_value_class
    }
    var field_index = 0
    while field_index < attribute_names.count() and not stored_by_the_compiler {
        var attribute_name = attribute_names[field_index]
        var clashing = clashing_function(information, "{template.prefix}{attribute_name}{template.suffix}")
        if clashing {
            report_template_clash(information, template, attribute_name, clashing)
        }
        if not clashing {
            var arguments = List<Syntax.Expressions.Expression>()
            var argument_index = 0
            while argument_index < parameters.count() {
                var argument: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(
                    parameters[argument_index].name,
                )
                arguments.append(argument)
                argument_index = argument_index + 1
            }
            var callee: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(
                "{template.prefix}{attribute_name}{template.suffix}",
            )
            var call: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, arguments)
            var statement: Syntax.Statements.Statement = Syntax.Statements.ExpressionStatement(call)
            body.append(statement)
        }
        field_index = field_index + 1
    }
    var returns_nothing = void_type()
    var function = Analysis.FunctionInfo(
        call_name,
        "{information.c_name}_{call_name}",
        parameters,
        returns_nothing,
        body,
        false,
    )
    function.symbol_name = template.symbol_parameter
    function.line = declaration.line
    function.source_path = declaration.source_path
    information.declared_functions.append(function)
    builder.add_prototype("{function_signature(information, function)};")
    return function
}

func instantiate_template(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    member_name: String,
    member_type: Analysis.SpiteType,
    member_owner_c_name: String,
    call_name: String,
    owner_type: Analysis.SpiteType?,
): Analysis.FunctionInfo {
    var declaration = template.declaration
    var saved_symbol_name = bound_symbol_name
    var saved_field_name = bound_field_name
    var saved_field_type = bound_field_type
    var saved_member_owner = bound_member_owner_c_name
    var saved_owner = current_owner
    var saved_class = current_class
    bound_symbol_name = template.symbol_parameter
    bound_field_name = member_name
    bound_field_type = member_type
    bound_member_owner_c_name = member_owner_c_name
    current_owner = information.qualified_dotted
    current_class = information
    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name != template.symbol_parameter {
            if parameter.type_reference {
                var parameter_type = resolve_type(parameter.type_reference, information.qualified_dotted)
                if parameter_type {
                    var receiving_type = received_type(parameter, parameter_type)
                    var described_parameter = Analysis.ParamInfo(parameter.name, receiving_type)
                    parameters.append(described_parameter)
                }
            }
        }
        parameter_index = parameter_index + 1
    }
    if owner_type {
        var described_parameter = Analysis.ParamInfo("owner", owner_type)
        parameters.append(described_parameter)
    }
    var chained_names = List<String>()
    var chained_index = 0
    while chained_index < chained_parameters.count() {
        var chained = chained_parameters[chained_index]
        parameters.append(chained)
        chained_names.append(chained.name)
        chained_index = chained_index + 1
    }
    chained_parameters = List<Analysis.ParamInfo>()
    var return_type = void_type()
    if declaration.return_type {
        var resolved_return = resolve_type(declaration.return_type, information.qualified_dotted)
        if resolved_return {
            return_type = resolved_return
        }
    }
    var function = Analysis.FunctionInfo(
        call_name,
        "{information.c_name}_{call_name}",
        parameters,
        return_type,
        declaration.body,
        false,
    )
    function.symbol_name = template.symbol_parameter
    function.source_path = declaration.source_path
    function.symbol_field_name = member_name
    function.symbol_field_type = member_type
    function.symbol_owner_c_name = member_owner_c_name
    function.symbol_chain_method = chained_method_name
    function.symbol_chain_arguments = chained_names
    function.symbol_compared_value = compared_value_name
    chained_method_name = ""
    compared_value_name = ""
    if owner_type {
        function.symbol_through_caller = true
    }
    function.symbol_range = range_text(template)
    if not declaration.has_body {
        function.has_body = false
        function.supplied_body = "#define {function.c_name}(self) (({c_type_name(return_type)})(self))"
        if declaration.name != "to_type" {
            report(
                "'{information.simple_name}.{declaration.name}' has no body, and only a function whose body the compiler supplies is written without one: give it a body",
            )
        }
    }
    information.declared_functions.append(function)
    if not is_inline_supplied(function) {
        builder.add_prototype("{function_signature(information, function)};")
    }
    bound_symbol_name = saved_symbol_name
    bound_field_name = saved_field_name
    bound_field_type = saved_field_type
    bound_member_owner_c_name = saved_member_owner
    current_owner = saved_owner
    current_class = saved_class
    return function
}

func range_text(template: Analysis.TemplateInfo): String {
    if template.range {
        var named = shape.as_named_type(template.range)
        if named {
            return named.path.join(".")
        }
    }
    return ""
}

func bind_symbol_of(function: Analysis.FunctionInfo) {
    bound_range = function.symbol_range
    bound_symbol_name = function.symbol_name
    bound_field_name = function.symbol_field_name
    bound_field_index = function.symbol_field_index
    bound_field_type = function.symbol_field_type
    bound_member_owner_c_name = function.symbol_owner_c_name
    bound_through_caller = function.symbol_through_caller
    bound_pattern = function.symbol_pattern
    bound_function_name = function.symbol_function_name
    bound_display_name = function.symbol_display_name
    bound_enum_c_name = function.symbol_enum_c_name
    bound_chain_method = function.symbol_chain_method
    bound_chain_arguments = function.symbol_chain_arguments
    bound_compared_value = function.symbol_compared_value
}

func is_bound_member_index(index_expression: Syntax.Expressions.IndexExpression): Boolean {
    if bound_member_owner_c_name.is_empty() {
        return false
    }
    crash index_expression.object
    crash index_expression.index
    var member = shape.as_member(index_expression.object)
    var index_identifier = shape.as_identifier(index_expression.index)
    if member {
        if index_identifier {
            return member.name == "attributes" and index_identifier.name == bound_symbol_name
        }
    }
    return false
}

func bound_member_expression(index_expression: Syntax.Expressions.IndexExpression): Syntax.Expressions.Expression {
    var member = shape.as_member(index_expression.object)
    crash member
    crash member.object
    if bound_through_caller {
        return caller_call_expression(member.object)
    }
    var walked_member = Syntax.Expressions.MemberExpression(member.object, bound_field_name)
    walked_member.walked = true
    var read: Syntax.Expressions.Expression = walked_member
    if bound_member_is_function() {
        var no_arguments = List<Syntax.Expressions.Expression>()
        read = Syntax.Expressions.CallExpression(read, no_arguments)
    }
    return chained_read(read)
}

# ../../../docs/collections.md#a-members-own-function-in-a-templates-name
func chained_read(read: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    if not bound_compared_value.is_empty() {
        var value: Syntax.Expressions.Expression = Syntax.Expressions.EnumLiteralExpression(bound_compared_value)
        return Syntax.Expressions.BinaryExpression('equal', read, value)
    }
    if bound_chain_method.is_empty() {
        return read
    }
    var arguments = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < bound_chain_arguments.count() {
        var argument_name = bound_chain_arguments[index]
        var argument: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(argument_name)
        arguments.append(argument)
        index = index + 1
    }
    var method: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(read, bound_chain_method)
    return Syntax.Expressions.CallExpression(method, arguments)
}

func bound_member_is_function(): Boolean {
    var owner = find_class_by_c_name(bound_member_owner_c_name)
    if owner {
        if owner.find_field(bound_field_name) {
            return false
        }
        if not owner.find_function(bound_field_name) {
            return false
        }
        return true
    }
    var owner_shape = find_union_by_c_name(bound_member_owner_c_name)
    crash owner_shape
    if not owner_shape.is_shape {
        var first_class = owner_shape.members.first()
        crash first_class
        if first_class.find_field(bound_field_name) {
            return false
        }
        if not first_class.find_function(bound_field_name) {
            return false
        }
        return true
    }
    if not find_required_function(owner_shape, bound_field_name) {
        return false
    }
    return true
}

func is_shape_member_read(expression: Syntax.Expressions.Expression): Boolean {
    if bound_member_owner_c_name.is_empty() {
        return false
    }
    if not find_union_by_c_name(bound_member_owner_c_name) {
        return false
    }
    var indexed = shape.as_index(expression)
    if not indexed {
        return false
    }
    return is_bound_member_index(indexed)
}

func is_text_member_read(expression: Syntax.Expressions.Expression): Boolean {
    if bound_member_owner_c_name != "SpiteString" {
        return false
    }
    var indexed = shape.as_index(expression)
    if not indexed {
        return false
    }
    return is_bound_member_index(indexed)
}

func is_caller_call(expression: Syntax.Expressions.Expression): Boolean {
    if not bound_through_caller {
        return false
    }
    var indexed = shape.as_index(expression)
    if not indexed {
        return false
    }
    return is_bound_member_index(indexed)
}

func caller_call_expression(element: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var owner: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("owner")
    var arguments = List<Syntax.Expressions.Expression>()
    arguments.append(element)
    if bound_field_name.is_empty() {
        return Syntax.Expressions.CallExpression(owner, arguments)
    }
    var callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(owner, bound_field_name)
    return Syntax.Expressions.CallExpression(callee, arguments)
}

func generate_bound_member_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var read = bound_member_expression(index_expression)
    return generate_expression(read, scope, class_information)
}

func is_bound_attributes_index(index_expression: Syntax.Expressions.IndexExpression): Boolean {
    if bound_symbol_name.is_empty() {
        return false
    }
    if not bound_member_owner_c_name.is_empty() and not bound_to_own_class() {
        return false
    }
    if index_expression.object {
        if index_expression.index {
            var object_identifier = shape.as_identifier(index_expression.object)
            var index_identifier = shape.as_identifier(index_expression.index)
            if object_identifier {
                if index_identifier {
                    return object_identifier.name == "attributes" and index_identifier.name == bound_symbol_name
                }
            }
        }
    }
    return false
}

func bound_to_own_class(): Boolean {
    if not current_class {
        return false
    }
    return bound_member_owner_c_name == current_class.c_name and not bound_through_caller and not bound_member_is_function()
}

func emit_pending_functions() {
    emit_pending_only()
    while not deferred_wait_functions.is_empty() {
        var information = deferred_wait_classes.remove_first()
        var function = deferred_wait_functions.remove_first()
        crash information
        crash function
        current_owner = information.qualified_dotted
        emit_user_function_body(information, function)
        emit_pending_only()
    }
}

func emit_pending_only() {
    var emitted_any = true
    while emitted_any {
        emitted_any = false
        var class_index = 0
        while class_index < classes.count() {
            var information = classes[class_index]
            if not information.is_generic_template {
                if not information.is_emitted {
                    emit_class(information)
                    emitted_any = true
                }
                var function_index = 0
                while function_index < information.declared_functions.count() {
                    if is_pending(information, information.declared_functions[function_index]) {
                        current_owner = information.qualified_dotted
                        emit_user_function(information, information.declared_functions[function_index])
                        emitted_any = true
                    }
                    function_index = function_index + 1
                }
            }
            class_index = class_index + 1
        }
    }
}

func is_pending(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if function.is_emitted {
        return false
    }
    if skips_generic(information, function) and not builder.mentions(function.c_name) {
        return false
    }
    if not information.is_instantiated or ran_in_host(information, function) {
        return true
    }
    return builder.mentions(function.c_name) or is_called_through_shape(information, function.name)
}

func ran_in_host(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not reload_host {
        return false
    }
    return reload_owners.contains(information.c_name) and reload_host.host_slots.has(function.c_name)
}

func is_called_through_shape(information: Analysis.ClassInfo, name: String): Boolean {
    if not shape_caller_names.has(name) {
        return false
    }
    var index = 0
    while index < unions.count() {
        if unions[index].is_shape and unions[index].caller_names.contains(name) {
            if unions[index].has_member(information.c_name) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func received_type(parameter: Syntax.Statements.Parameter, resolved: Analysis.SpiteType): Analysis.SpiteType {
    if not parameter.is_variadic {
        return resolved
    }
    var listed = type_shape.as_list(resolved)
    if listed {
        var element = listed.element
        var spread = Analysis.Types.ListType(element)
        spread.is_variadic = true
        return spread
    }
    return resolved
}

func resolve_function(declaration: Syntax.Statements.FunctionDeclaration, information: Analysis.ClassInfo) {
    assert not register_template(declaration, information)
    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        check_value_name(parameter.name, "parameter")
        assert parameter.type_reference
        var parameter_type = resolve_type(parameter.type_reference, information.qualified_dotted)
        if parameter_type {
            var receiving_type = received_type(parameter, parameter_type)
            var described_parameter = Analysis.ParamInfo(parameter.name, receiving_type)
            parameters.append(described_parameter)
        } else {
            var void_spite_type = void_type()
            var described_parameter = Analysis.ParamInfo(parameter.name, void_spite_type)
            parameters.append(described_parameter)
        }
        parameter_index = parameter_index + 1
    }
    var return_type: Analysis.SpiteType = Analysis.Types.VoidType()
    var waiting_return = return_waits_for_constants(declaration)
    if declaration.return_type and not waiting_return {
        var resolved_return = resolve_type(declaration.return_type, information.qualified_dotted)
        if resolved_return {
            return_type = resolved_return
        }
    }
    var is_constructor = declaration.name == information.simple_name
    if is_constructor and declaration.parameters.is_empty() and declaration.body.is_empty() {
        report(
            "'{declaration.name}' has an empty constructor: delete it. A class without a constructor is already made from its defaults",
        )
    }
    var is_conversion = information.is_value_class and declaration.name.starts_with("to_")
    if not is_constructor and not is_conversion and declaration.has_body {
        check_value_name(declaration.name, "function")
        check_reflection_name(declaration.name, "function", information)
    }
    var c_name = "{information.c_name}_{declaration.name}"
    var function = Analysis.FunctionInfo(
        declaration.name,
        c_name,
        parameters,
        return_type,
        declaration.body,
        is_constructor,
    )
    function.source_path = declaration.source_path
    note_source_path(information, declaration.source_path)
    if takes_reflection(function) {
        reflection_declaration_positions[c_name] = reflection_declarations.count()
        reflection_declarations.append(declaration)
        if waiting_return {
            constant_return_names.append(c_name)
        }
    }
    if not declaration.has_body {
        supply_body(information, function)
    }
    if declaration.name == "is_singleton" and information.qualified_dotted != "Spite.Class" {
        report(
            "a class says it is a singleton with a 'singleton' line at the top of its file, not with a function: delete 'is_singleton()' and write 'singleton' as the file's first line",
        )
    }
    if declaration.name == "get_at" and not type_shape.as_nullable(return_type) {
        report_plain_get_at(declaration, return_type)
    }
    var parameter_count = parameters.count()
    report_reserved_signature(declaration, parameter_count, return_type, information)
    if declaration.name.starts_with("from_") {
        report_from_declaration(declaration, information)
    }
    function.line = declaration.line
    function.end_line = declaration.end_line
    if is_constructor {
        information.constructor = function
    } else if declaration.name == "drop" {
        information.drop_function = function
    }
    var existing = 0
    while existing < information.declared_functions.count() {
        if information.declared_functions[existing].name == declaration.name {
            var saved_line = current_line
            current_line = declaration.line
            report(
                "'{information.simple_name}' declares '{declaration.name}' twice: a later file may reopen a class and replace a function, but one file declares each name once",
            )
            current_line = saved_line
        }
        existing = existing + 1
    }
    information.declared_functions.append(function)
}

# ../../../specs/values_and_types.md#numbers-are-classes-and-this
func report_from_declaration(declaration: Syntax.Statements.FunctionDeclaration, information: Analysis.ClassInfo) {
    var saved_line = current_line
    current_line = declaration.line
    var target_words = snake_words(information.simple_name)
    report(
        "'{information.simple_name}.{declaration.name}' makes a {information.simple_name} from another value, and a conversion belongs to the value converted: declare 'to_{target_words}()' on the class it converts from, or take the value in the constructor",
    )
    current_line = saved_line
}

# ../../../docs/functions_and_operators.md#functions-the-compiler-calls-by-name
func report_reserved_signature(
    declaration: Syntax.Statements.FunctionDeclaration,
    parameter_count: Integer,
    return_type: Analysis.SpiteType,
    information: Analysis.ClassInfo,
) {
    var wanted = reserved_signature(declaration.name, information.simple_name)
    assert not wanted.is_empty()
    var wanted_count = 1
    var wanted_return = "Boolean"
    if declaration.name == "drop" {
        wanted_count = 0
        wanted_return = ""
    } else if declaration.name == "to_string" or declaration.name == "to_debug" {
        wanted_count = 0
        wanted_return = "String"
    }
    var answered = ""
    if not type_shape.is_void(return_type) {
        answered = type_display_name(return_type)
    }
    assert parameter_count != wanted_count or answered != wanted_return
    var saved_line = current_line
    current_line = declaration.line
    report(
        "'{declaration.name}' is called by the compiler {reserved_use(declaration.name)}, so it is declared exactly '{wanted}'",
    )
    current_line = saved_line
}

func reserved_signature(name: String, class_name: String): String {
    switch name {
        "drop": return "func drop()"
        "to_string": return "func to_string(): String"
        "to_debug": return "func to_debug(): String"
        "equals": return "func equals(other: {class_name}): Boolean"
        "less_than": return "func less_than(other: {class_name}): Boolean"
        "greater_than": return "func greater_than(other: {class_name}): Boolean"
        _: return ""
    }
}

func reserved_use(name: String): String {
    switch name {
        "drop": return "when the last reference to an object goes"
        "to_string": return "wherever the object is used as text"
        "to_debug": return "wherever the object is shown for debugging"
        "equals": return "for '==' and '!='"
        "less_than": return "for '<' and '<='"
        _: return "for '>' and '>='"
    }
}

func report_plain_get_at(declaration: Syntax.Statements.FunctionDeclaration, return_type: Analysis.SpiteType) {
    var saved_line = current_line
    current_line = declaration.line
    var answered = "nothing"
    var wanted = "the item's type followed by '?'"
    if not type_shape.is_void(return_type) {
        var shown = type_display_name(return_type)
        answered = "'{shown}'"
        wanted = "'{shown}?'"
    }
    report(
        "'get_at' answers {answered}, but it is what '[ ]' calls, and every '[ ]' answers a 'T?' that is narrowed before use: declare it to answer {wanted}, and answer null when nothing is at the index",
    )
    current_line = saved_line
}

func is_inline_supplied(function: Analysis.FunctionInfo): Boolean {
    return not function.has_body and function.supplied_body.starts_with("#define")
}

func supply_body(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    function.has_body = false
    var segments = information.qualified_dotted.split(".")
    var folders = List<String>()
    var index = 0
    while index < segments.count() {
        var words = words_of(segments[index])
        var folder = words.join("_")
        folders.append(folder)
        index = index + 1
    }
    var class_path = folders.join("/")
    var storage_body = string_storage_body(information, function.name)
    if not storage_body.is_empty() {
        function.supplied_body = storage_body
        return
    }
    var supplied = Prelude().supplied_body(class_path, function.name)
    if supplied {
        assert not information.is_generic_template
        function.supplied_body = supplied
        if class_path == "typed_memory" {
            function.supplied_body = typed_memory_body(information, function.name)
        }
        if class_path == "weak" {
            function.supplied_body = weak_body(information, function.name)
        }
        if class_path == "inline_memory" {
            function.supplied_body = inline_memory_body(information, function.name)
        }
        if class_path == "concurrent" or class_path == "thread_pool" {
            function.supplied_body = task_body(information, function.name)
        }
        if class_path == "hot_reload" and function.name != "open" {
            function.supplied_body = hot_reload_body(function.name)
        }
        if class_path == "read_evaluate_print_loop" {
            function.supplied_body = read_evaluate_print_loop_body(function.name)
        }
        if class_path == "memory/address" {
            function.supplied_body = address_body(function)
        }
        if class_path == "binary_writer" or class_path == "binary_reader" {
            maths_macros[function.c_name] = false
            function.supplied_body = "#define {function.c_name}(self) {schema_pending}"
        }
        if class_path == "scheduler" and function.name.ends_with("_check_point") {
            function.supplied_body = check_point_flag_body(function.name)
        }
        var number_classes = Prelude().number_classes()
        if number_classes.contains(class_path) and maths.is_member(function.name) {
            function.supplied_body = maths_body(information, function)
        }
        if number_classes.contains(class_path) and maths.is_bit_view(function.name) {
            function.supplied_body = bit_view_body(information, function)
        }
        return
    }
    report(
        "'{information.simple_name}.{function.name}' has no body, and only a function whose body the compiler supplies is written without one: give it a body",
    )
}

func check_point_flag_body(name: String): String {
    var checked = remote_loop_port > 0 or hot_reload
    if not checked and name == "_want_check_point" {
        return "(void)self;"
    }
    if not checked {
        return "(void)self;\nreturn true;"
    }
    ensure_check_point_flag()
    if name == "_want_check_point" {
        return "(void)self;\n__atomic_store_n(&spite_check_point_wanted, 1, __ATOMIC_RELEASE);"
    }
    return "(void)self;\nreturn __atomic_exchange_n(&spite_check_point_wanted, 0, __ATOMIC_ACQ_REL) != 0;"
}

func ensure_world_gate() {
    assert not world_gate_written
    world_gate_written = true
    ensure_check_point_flag()
    builder.add_typedef("#include <time.h>")
    builder.add_prototype("void spite_world_enter(void);")
    builder.add_prototype("void spite_world_leave(void);")
    builder.add_prototype("void spite_world_park(void);")
    builder.add_prototype("int32_t spite_world_stop(void);")
    builder.add_prototype("void spite_world_start(void);")
    var lines = List<String>()
    lines.append("static int32_t spite_world_stopping = 0;")
    lines.append("static int32_t spite_world_running = 0;")
    lines.append("static SPITE_THREAD_LOCAL int32_t spite_world_mine = 0;")
    lines.append("static void spite_world_join(int32_t held) \{")
    lines.append("for (;;) \{")
    lines.append("while (__atomic_load_n(&spite_world_stopping, __ATOMIC_ACQUIRE) != 0) \{}")
    lines.append("__atomic_fetch_add(&spite_world_running, held, __ATOMIC_SEQ_CST);")
    lines.append("if (__atomic_load_n(&spite_world_stopping, __ATOMIC_SEQ_CST) == 0) return;")
    lines.append("__atomic_fetch_sub(&spite_world_running, held, __ATOMIC_SEQ_CST);")
    lines.append("}")
    lines.append("}")
    lines.append("void spite_world_enter(void) \{")
    lines.append(
        "if (spite_world_mine > 0) \{ __atomic_fetch_add(&spite_world_running, 1, __ATOMIC_SEQ_CST); } else spite_world_join(1);",
    )
    lines.append("spite_world_mine = spite_world_mine + 1;")
    lines.append("}")
    lines.append("void spite_world_leave(void) \{")
    lines.append("spite_world_mine = spite_world_mine - 1;")
    lines.append("__atomic_fetch_sub(&spite_world_running, 1, __ATOMIC_SEQ_CST);")
    lines.append("}")
    lines.append("void spite_world_park(void) \{")
    lines.append("int32_t held = spite_world_mine;")
    lines.append("if (held == 0 || __atomic_load_n(&spite_world_stopping, __ATOMIC_SEQ_CST) == 0) return;")
    lines.append("__atomic_fetch_sub(&spite_world_running, held, __ATOMIC_SEQ_CST);")
    lines.append("spite_world_join(held);")
    lines.append("}")
    lines.append("int32_t spite_world_stop(void) \{")
    lines.append("__atomic_store_n(&spite_world_stopping, 1, __ATOMIC_SEQ_CST);")
    lines.append("time_t spite_deadline = time(0) + 10;")
    lines.append("while (__atomic_load_n(&spite_world_running, __ATOMIC_SEQ_CST) > spite_world_mine) \{")
    lines.append("__atomic_store_n(&spite_check_point_wanted, 1, __ATOMIC_RELEASE);")
    lines.append(
        "if (time(0) > spite_deadline) \{ __atomic_store_n(&spite_world_stopping, 0, __ATOMIC_SEQ_CST); return 0; }",
    )
    lines.append("}")
    lines.append("return 1;")
    lines.append("}")
    lines.append("void spite_world_start(void) \{")
    lines.append("__atomic_store_n(&spite_world_stopping, 0, __ATOMIC_SEQ_CST);")
    lines.append("}")
    var joined = lines.join("\n")
    builder.add_support(joined)
}

func ensure_check_point_flag() {
    assert not check_point_flag_written
    check_point_flag_written = true
    builder.add_prototype("static int32_t spite_check_point_wanted = 0;")
}

func address_body(function: Analysis.FunctionInfo): String {
    var name = function.name
    var at = "((char*)(intptr_t)(self) + (offset))"
    switch name {
        "copy_to": return "#define {function.c_name}(self, target, bytes) memmove((void*)(intptr_t)(target), (void*)(intptr_t)(self), (size_t)(bytes))"
        "compare_bytes": return "#define {function.c_name}(self, other, bytes) (\{ int64_t spite_bytes = (bytes); spite_bytes > 0 ? (int32_t)memcmp((const void*)(intptr_t)(self), (const void*)(intptr_t)(other), (size_t)spite_bytes) : 0; })"
        "exchange_long": return "#define {function.c_name}(self, offset, value) __atomic_exchange_n((int64_t*){at}, (int64_t)(value), __ATOMIC_SEQ_CST)"
        "read_long_atomically": return "#define {function.c_name}(self, offset) __atomic_load_n((int64_t*){at}, __ATOMIC_SEQ_CST)"
        "write_long_atomically": return "#define {function.c_name}(self, offset, value) __atomic_store_n((int64_t*){at}, (int64_t)(value), __ATOMIC_SEQ_CST)"
        "add_long_atomically": return "#define {function.c_name}(self, offset, value) __atomic_add_fetch((int64_t*){at}, (int64_t)(value), __ATOMIC_SEQ_CST)"
        "compare_and_swap_long": return "#define {function.c_name}(self, offset, expected, desired) (\{ int64_t spite_expected = (int64_t)(expected); __atomic_compare_exchange_n((int64_t*){at}, &spite_expected, (int64_t)(desired), false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); })"
        _: {
            var value_type = function.return_type
            if name.starts_with("write_") {
                crash function.parameters[1]
                value_type = function.parameters[1].type
                var written = c_type_name(value_type)
                if name.ends_with("_big_endian") {
                    var swapped_bits = swapped_width(written)
                    return "#define {function.c_name}(self, offset, value) (\{ {written} spite_value = (value); uint{swapped_bits}_t spite_bits; memcpy(&spite_bits, &spite_value, sizeof(spite_bits)); spite_bits = __builtin_bswap{swapped_bits}(spite_bits); memcpy({at}, &spite_bits, sizeof(spite_bits)); })"
                }
                return "#define {function.c_name}(self, offset, value) memcpy({at}, &({written})\{ (value) }, sizeof({written}))"
            }
            var read = c_type_name(value_type)
            if name.ends_with("_big_endian") {
                var read_bits = swapped_width(read)
                return "#define {function.c_name}(self, offset) (\{ uint{read_bits}_t spite_bits; memcpy(&spite_bits, {at}, sizeof(spite_bits)); spite_bits = __builtin_bswap{read_bits}(spite_bits); {read} spite_read; memcpy(&spite_read, &spite_bits, sizeof(spite_read)); spite_read; })"
            }
            return "#define {function.c_name}(self, offset) (\{ {read} spite_read; memcpy(&spite_read, {at}, sizeof(spite_read)); spite_read; })"
        }
    }
}

func swapped_width(c_type: String): Integer {
    if c_type.ends_with("16_t") {
        return 16
    }
    if c_type.ends_with("32_t") or c_type == "float" {
        return 32
    }
    return 64
}

func maths_body(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var is_decimal = information.qualified_dotted == "Float" or information.qualified_dotted == "Double"
    maths_macros[function.c_name] = is_decimal and maths.uses_library(function.name)
    if is_decimal {
        return maths.decimal_body(function.c_name, function.name, information.qualified_dotted == "Float")
    }
    var value_type = value_class_type(information)
    var c_type = c_type_name(value_type)
    return maths.whole_body(function.c_name, function.name, c_type)
}

func schema_body(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    crash information.codegen_types[0]
    var value_type = information.codegen_types[0]
    var visiting = List<String>()
    var text = schema_text(value_type, visiting)
    var hash = schema_hash.hash_of(text)
    var literal = long_literal(hash)
    return "#define {function.c_name}(self) ((void)(self), (int64_t){literal}) /* {text} */"
}

func long_literal(value: Long): String {
    if value == -9223372036854775807 - 1 {
        return "(-9223372036854775807LL - 1)"
    }
    return "({value}LL)"
}

func schema_text(spite_type: Analysis.SpiteType, visiting: List<String>): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.inner
        var inner_text = schema_text(inner, visiting)
        return "{inner_text}?"
    }
    var listed = type_shape.as_list(spite_type)
    if listed {
        var element = listed.element
        var element_text = schema_text(element, visiting)
        return "List<{element_text}>"
    }
    var mapped = type_shape.as_dictionary(spite_type)
    if mapped {
        var entry = mapped.element
        var entry_text = schema_text(entry, visiting)
        var mapped_key = mapped.key
        if type_shape.as_string(mapped_key) {
            return "Dictionary<{entry_text}>"
        }
        return "Dictionary<{entry_text}>by{type_label(mapped_key)}"
    }
    var shown = type_display_name(spite_type)
    var enumerated = type_shape.as_enum(spite_type)
    if enumerated {
        var values_text = enumerated.values.join(",")
        return "{shown}({values_text})"
    }
    var information = schema_class(spite_type)
    if not information {
        return shown
    }
    if visiting.contains(information.c_name) {
        return information.qualified_dotted
    }
    visiting.append(information.c_name)
    var parts = List<String>()
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        if not field.name.starts_with("_") and not singleton_type(field.type) {
            var field_type = field.type
            var field_text = schema_text(field_type, visiting)
            parts.append("{field.name}:{field_text}")
        }
        index = index + 1
    }
    visiting.remove_last()
    var parts_text = parts.join(";")
    return "{information.qualified_dotted}\{{parts_text}}"
}

func schema_class(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(spite_type)
    assert class_ref and not class_ref.has_signature
    var information = find_class_by_c_name(class_ref.c_name)
    assert information and not information.is_value_class
    return information
}

func bit_view_body(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    maths_macros[function.c_name] = false
    var from_type = value_class_type(information)
    var to_type = function.return_type
    var from_c_type = c_type_name(from_type)
    var to_c_type = c_type_name(to_type)
    return maths.bit_view_body(function.c_name, from_c_type, to_c_type)
}

func note_maths_macro(function: Analysis.FunctionInfo) {
    assert maths_macros.has(function.c_name)
    builder.add_shaken_macro(function.c_name)
    if maths_macros[function.c_name] == true {
        builder.include_maths_library(function.c_name)
    }
}

func task_body(information: Analysis.ClassInfo, name: String): String {
    switch name {
        "address": return "return (int64_t)(intptr_t)self;"
        "_task_begun": return "#ifdef SPITE_THREADS\nfor (int32_t spite_index = 0; spite_index < spite_skipped_depth; spite_index++) \{ if (!spite_skipped_taken[spite_index]) \{ spite_enter_skipped(spite_skipped[spite_index]); spite_skipped_taken[spite_index] = 1; } }\n__atomic_fetch_add(&spite_tasks_in_flight, 1, __ATOMIC_SEQ_CST);\n#endif"
        "_task_ended": return "#ifdef SPITE_THREADS\n__atomic_fetch_sub(&spite_tasks_in_flight, 1, __ATOMIC_RELEASE);\n#endif"
        _: {}
    }
    if name == "_world_enter" or name == "_world_leave" {
        if not hot_reload {
            return "(void)self;"
        }
        ensure_world_gate()
        return "(void)self;\nspite{name}();"
    }
    if name == "_start_frame" {
        builder.add_prototype("static void* spite_frame_start(Spite_Function* spite_work);")
        return "return (int64_t)(intptr_t)spite_frame_start(self->_work_);"
    }
    if name == "_frame_result" {
        return frame_result_body(information)
    }
    if name == "_free_frame" {
        return "if (self->_frame_ != 0) SPITE_FREE((void*)(intptr_t)self->_frame_);\nself->_frame_ = 0;"
    }
    var entry = "{information.c_name}___thread_entry"
    builder.add_prototype("static void* {entry}(void* pool);")
    builder.add_support(
        "static void* {entry}(void* pool) \{\nspite_fault_thread();\n{information.c_name}__serve(({information.c_name}*)pool);\nreturn 0;\n}",
    )
    return "return (int64_t)(intptr_t)&{entry};"
}

func weak_body(information: Analysis.ClassInfo, name: String): String {
    crash information.codegen_types[0]
    var value_type = information.codegen_types[0]
    var class_ref = type_shape.as_class_ref(value_type)
    if not class_ref {
        report(
            "Weak holds an object without counting it, and {type_with_article(value_type)} is not an object: a number, a Boolean, an enum or a T? is kept by value, so hold it as it is",
        )
        return ""
    }
    ensure_weak_runtime(class_ref.c_name)
    if name == "_box_of" {
        var released = release_call(value_type, "target_")
        return "int64_t spite_box = spite_weak_box_of((void*)target_);\n{released};\nreturn spite_box;"
    }
    if name == "get" {
        var retained = retain_call(value_type, "spite_object")
        return "{class_ref.c_name}* spite_object = ({class_ref.c_name}*)spite_weak_object(self->_box_);\nif (spite_object == 0) return 0;\nreturn {retained};"
    }
    return "spite_weak_box_release(self->_box_);"
}

func ensure_weak_runtime(c_name: String) {
    note_fact("weak {c_name}")
    if not weak_classes.contains(c_name) {
        weak_classes.append(c_name)
        builder.add_typedef("#define SPITE_WEAK_{c_name} 1")
    }
    assert not weak_runtime_written
    weak_runtime_written = true
    builder.add_prototype("static void spite_weak_object_freed(void* object);")
    var runtime = weak_runtime()
    builder.add_support(runtime)
}

func weak_runtime(): String {
    var lines = [
        "typedef struct SpiteWeakBox \{ void* object; int64_t weak_count; } SpiteWeakBox;"
        "static SpiteWeakBox** spite_weak_table = 0;"
        "static int64_t spite_weak_capacity = 0;"
        "static int64_t spite_weak_used = 0;"
        "static int64_t spite_weak_filled = 0;"
        "#define SPITE_WEAK_GONE ((SpiteWeakBox*)(intptr_t)1)"
        "static int64_t spite_weak_find(void* object) \{"
        "if (spite_weak_capacity == 0) return -1;"
        "uint64_t spite_hash = (uint64_t)(uintptr_t)object; spite_hash ^= spite_hash >> 33; spite_hash *= 0xff51afd7ed558ccdULL; spite_hash ^= spite_hash >> 33;"
        "int64_t spite_slot = (int64_t)(spite_hash & (uint64_t)(spite_weak_capacity - 1));"
        "while (spite_weak_table[spite_slot] != 0) \{"
        "if (spite_weak_table[spite_slot] != SPITE_WEAK_GONE && spite_weak_table[spite_slot]->object == object) return spite_slot;"
        "spite_slot = (spite_slot + 1) & (spite_weak_capacity - 1);"
        "}"
        "return -1;"
        "}"
        "static void spite_weak_insert(SpiteWeakBox* box) \{"
        "if ((spite_weak_filled + 1) * 2 > spite_weak_capacity) \{"
        "SpiteWeakBox** spite_old = spite_weak_table; int64_t spite_old_capacity = spite_weak_capacity;"
        "spite_weak_capacity = spite_weak_capacity == 0 ? 16 : (spite_weak_used + 1) * 4 > spite_weak_capacity ? spite_weak_capacity * 2 : spite_weak_capacity;"
        "spite_weak_table = (SpiteWeakBox**)calloc((size_t)spite_weak_capacity, sizeof(SpiteWeakBox*));"
        "spite_weak_filled = 0; spite_weak_used = 0;"
        "for (int64_t spite_index = 0; spite_index < spite_old_capacity; spite_index = spite_index + 1) \{"
        "if (spite_old[spite_index] != 0 && spite_old[spite_index] != SPITE_WEAK_GONE) spite_weak_insert(spite_old[spite_index]);"
        "}"
        "free(spite_old);"
        "}"
        "uint64_t spite_hash = (uint64_t)(uintptr_t)box->object; spite_hash ^= spite_hash >> 33; spite_hash *= 0xff51afd7ed558ccdULL; spite_hash ^= spite_hash >> 33;"
        "int64_t spite_slot = (int64_t)(spite_hash & (uint64_t)(spite_weak_capacity - 1));"
        "while (spite_weak_table[spite_slot] != 0 && spite_weak_table[spite_slot] != SPITE_WEAK_GONE) spite_slot = (spite_slot + 1) & (spite_weak_capacity - 1);"
        "if (spite_weak_table[spite_slot] == 0) spite_weak_filled = spite_weak_filled + 1;"
        "spite_weak_table[spite_slot] = box;"
        "spite_weak_used = spite_weak_used + 1;"
        "}"
        "static void spite_weak_forget(int64_t spite_slot) \{"
        "spite_weak_table[spite_slot] = SPITE_WEAK_GONE;"
        "spite_weak_used = spite_weak_used - 1;"
        "if (spite_weak_used == 0) \{ free(spite_weak_table); spite_weak_table = 0; spite_weak_capacity = 0; spite_weak_filled = 0; }"
        "}"
        "static int64_t spite_weak_box_of(void* object) \{"
        "if (object == 0) return 0;"
        "int64_t spite_slot = spite_weak_find(object);"
        "if (spite_slot >= 0) \{ spite_weak_table[spite_slot]->weak_count = spite_weak_table[spite_slot]->weak_count + 1; return (int64_t)(intptr_t)spite_weak_table[spite_slot]; }"
        "SpiteWeakBox* box = (SpiteWeakBox*)malloc(sizeof(SpiteWeakBox));"
        "box->object = object; box->weak_count = 1;"
        "spite_weak_insert(box);"
        "return (int64_t)(intptr_t)box;"
        "}"
        "static void* spite_weak_object(int64_t box) \{"
        "if (box == 0) return 0;"
        "return ((SpiteWeakBox*)(intptr_t)box)->object;"
        "}"
        "static void spite_weak_box_release(int64_t box_address) \{"
        "SpiteWeakBox* box = (SpiteWeakBox*)(intptr_t)box_address;"
        "if (box == 0) return;"
        "box->weak_count = box->weak_count - 1;"
        "if (box->weak_count > 0) return;"
        "if (box->object != 0) \{ int64_t spite_slot = spite_weak_find(box->object); if (spite_slot >= 0) spite_weak_forget(spite_slot); }"
        "free(box);"
        "}"
        "static void spite_weak_object_freed(void* object) \{"
        "int64_t spite_slot = spite_weak_find(object);"
        "if (spite_slot < 0) return;"
        "spite_weak_table[spite_slot]->object = 0;"
        "spite_weak_forget(spite_slot);"
        "}"
    ]
    return lines.join("\n")
}

func typed_memory_body(information: Analysis.ClassInfo, name: String): String {
    crash information.codegen_types[0]
    var value_type = information.codegen_types[0]
    var slot = "(({c_type_name(value_type)}*)(intptr_t)address_)[index_]"
    switch name {
        "read_value": return "return {retain_call(value_type, slot)};"
        "write_value": return "{slot} = value_;"
        "release_value": return release_statement(value_type, slot)
        "swap_values": {
            var swapped_type = c_type_name(value_type)
            return swapped_slots(swapped_type)
        }
        "value_bits": return value_bits_body(value_type)
        _: return "return (int64_t)sizeof({c_type_name(value_type)});"
    }
}

# ../../../specs/collections.md#dictionarykey-value
func value_bits_body(value_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(value_type)
    if scalar {
        if scalar.kind == 'float_kind' {
            return "float spite_value = value_ == 0.0f ? 0.0f : value_; if (spite_value != spite_value) return 0x7fc00000ULL; uint32_t spite_bits; memcpy(&spite_bits, &spite_value, sizeof spite_bits); return (uint64_t)spite_bits;"
        }
        if scalar.kind == 'double_kind' {
            return "double spite_value = value_ == 0.0 ? 0.0 : value_; if (spite_value != spite_value) return 0x7ff8000000000000ULL; uint64_t spite_bits; memcpy(&spite_bits, &spite_value, sizeof spite_bits); return spite_bits;"
        }
        return "return (uint64_t)value_;"
    }
    if is_enum_type(value_type) {
        return "return (uint64_t)value_;"
    }
    var released = release_statement(value_type, "value_")
    return "uint64_t spite_bits = (uint64_t)(uintptr_t)value_; {released} return spite_bits;"
}

func swapped_slots(c_type: String): String {
    var slots = "(({c_type}*)(intptr_t)address_)"
    return "{c_type} spite_held = {slots}[first_index_];\n{slots}[first_index_] = {slots}[second_index_];\n{slots}[second_index_] = spite_held;"
}

func inline_memory_body(information: Analysis.ClassInfo, name: String): String {
    crash information.codegen_types[0]
    var value_type = information.codegen_types[0]
    var item_class = inline_item_class(value_type)
    if not item_class {
        return plain_memory_body(name, value_type)
    }
    var c_name = item_class.c_name
    var stride = "((int64_t)sizeof({c_name}) - (int64_t)sizeof(SpiteHeader))"
    var slot = "(({c_name}*)((char*)(intptr_t)address_ + (int64_t)index_ * {stride}))"
    switch name {
        "item_at": return "return {slot};"
        "item_bytes": return "return {stride};"
        "item_start": return "return (int64_t)sizeof(SpiteHeader);"
        "block_bytes": return "return (int64_t)item_count_ * {stride} + (int64_t)sizeof(SpiteHeader);"
        "swap_items": {
            var bytes = "(size_t){stride}"
            var start = "(char*)(intptr_t)address_ + sizeof(SpiteHeader)"
            return "char spite_held[sizeof({c_name}) - sizeof(SpiteHeader)];\nchar* spite_first = {start} + (int64_t)first_index_ * {stride};\nchar* spite_second = {start} + (int64_t)second_index_ * {stride};\nmemcpy(spite_held, spite_first, {bytes});\nmemcpy(spite_first, spite_second, {bytes});\nmemcpy(spite_second, spite_held, {bytes});"
        }
        _: {
            var lines = List<String>()
            if name == "release_item" {
                lines.append("{c_name}* spite_slot = {slot};")
                append_item_references(lines, item_class, false)
                return lines.join("\n")
            }
            var copied = "value_"
            if name == "copy_item" {
                copied = "(({c_name}*)((char*)(intptr_t)source_ + (int64_t)source_index_ * {stride}))"
            }
            lines.append("{c_name}* spite_slot = {slot};")
            lines.append(
                "memcpy((char*)spite_slot + sizeof(SpiteHeader), (char*){copied} + sizeof(SpiteHeader), (size_t){stride});",
            )
            append_item_references(lines, item_class, true)
            if name == "write_item" {
                lines.append("{release_call(value_type, "value_")};")
            }
            return lines.join("\n")
        }
    }
}

func plain_memory_body(name: String, value_type: Analysis.SpiteType): String {
    var slot = "(({c_type_name(value_type)}*)(intptr_t)address_)[index_]"
    var source = "(({c_type_name(value_type)}*)(intptr_t)source_)[source_index_]"
    switch name {
        "item_at": return "return {retain_call(value_type, slot)};"
        "write_item": return "{slot} = value_;"
        "copy_item": return "{slot} = {retain_call(value_type, source)};"
        "release_item": return release_statement(value_type, slot)
        "item_start": return "return 0;"
        "block_bytes": return "return (int64_t)item_count_ * (int64_t)sizeof({c_type_name(value_type)});"
        "swap_items": {
            var swapped_type = c_type_name(value_type)
            return swapped_slots(swapped_type)
        }
        _: return "return (int64_t)sizeof({c_type_name(value_type)});"
    }
}

func append_item_references(lines: List<String>, item_class: Analysis.ClassInfo, retaining: Boolean) {
    var index = 0
    while index < item_class.fields.count() {
        var field = item_class.fields[index]
        var field_type = field.type
        if type_needs_drop(field_type) {
            var code = field_place("spite_slot", item_class, field.name)
            if retaining {
                lines.append("(void){retain_call(field_type, code)};")
            } else {
                lines.append("{release_call(field_type, code)};")
            }
        }
        index = index + 1
    }
}

func inline_item_class(value_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(value_type)
    assert class_ref
    assert not class_ref.has_signature
    var found = find_class_by_c_name(class_ref.c_name)
    assert found
    assert not found.is_singleton and not found.is_value_class and not found.is_generic_template
    return found
}

func resolve_type(type_reference: Syntax.Types.Type, current_namespace: String): Analysis.SpiteType? {
    var generic_type = shape.as_generic_type(type_reference)
    if generic_type {
        var generic_name = without_dollar(generic_type.name)
        if current_class {
            var bound = codegen_index(current_class, generic_name)
            if bound >= 0 {
                crash current_class.codegen_codes[bound]
                if current_class.codegen_codes[bound].is_empty() {
                    return current_class.codegen_types[bound]
                }
                report("'${generic_name}' is a value here, so it cannot be used as a type")
                return null
            }
        }
        report("this class has no 'generic ${generic_name}' line, so '${generic_name}' cannot be used as a type")
        return null
    }
    var named = shape.as_named_type(type_reference)
    if named {
        return resolve_named_type(named, current_namespace)
    }
    report("this kind of type reference is not supported yet")
    return null
}

func resolve_named_type(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    if not reflected_bindings.is_empty() {
        var reflected_root = named.path.first()
        if reflected_root {
            if reflected_binding(reflected_root) {
                return reflected_type(named)
            }
        }
    }
    if named.path.count() > 1 and named.path[0].starts_with("$") {
        return resolve_codegen_member(named)
    }
    if named.path.count() >= 2 and not bound_symbol_name.is_empty() {
        if named.path[0] == bound_symbol_name and named.path[1] == "class" {
            return bound_type_member(named)
        }
    }
    if named.path.count() == 2 and named.path[0] == "Memory" and named.path[1] == "Address" {
        var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('address_kind')
        return resolved
    }
    if named.path.count() == 1 {
        var name = named.path[0]
        if name == "Integer" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('integer_kind')
            return resolved
        }
        if name == "Long" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('long_kind')
            return resolved
        }
        if name == "Tiny" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('tiny_kind')
            return resolved
        }
        if name == "Short" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('short_kind')
            return resolved
        }
        if name == "Byte" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('byte_kind')
            return resolved
        }
        if name == "UnsignedShort" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('unsigned_short_kind')
            return resolved
        }
        if name == "UnsignedInteger" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('unsigned_integer_kind')
            return resolved
        }
        if name == "UnsignedLong" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('unsigned_long_kind')
            return resolved
        }
        if name == "Float" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('float_kind')
            return resolved
        }
        if name == "Double" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('double_kind')
            return resolved
        }
        if name == "Boolean" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('boolean_kind')
            return resolved
        }
        if name == "String" {
            var resolved: Analysis.SpiteType = Analysis.Types.StringType()
            return resolved
        }
        if name == "Nullable" {
            return resolve_nullable_argument(named, current_namespace)
        }
        if name == "Symbol" {
            var symbol_type: Analysis.SpiteType = Analysis.Types.SymbolType()
            return symbol_type
        }
        if name == "Arguments" {
            var resolved: Analysis.SpiteType = Analysis.Types.ArgumentsType()
            return resolved
        }
        if name == "Dictionary" {
            var argument_count = named.arguments.count()
            if argument_count != 2 {
                report_dictionary_arguments(argument_count)
                return null
            }
            return written_dictionary_type(named.arguments[0], named.arguments[1], current_namespace)
        }
        if name == "List" {
            var list_element = resolve_single_type_argument(named, current_namespace)
            if list_element {
                return list_type_of(list_element)
            }
            return null
        }
        var declaring_owner = nearest_declaring_owner(name, current_namespace)
        if not declaring_owner.is_empty() {
            var near_union = find_union_qualified(declaring_owner, name)
            if near_union {
                return union_type_of(near_union)
            }
            var near_enum = find_enum_qualified(declaring_owner, name)
            crash near_enum
            return enum_type_of(near_enum)
        }
        var found_class = find_class(name, current_namespace)
        if found_class {
            if found_class.is_generic_template {
                var generic_instance = instantiate_generic(found_class, named.arguments, current_namespace)
                if generic_instance {
                    return class_type_of(generic_instance)
                }
                return null
            }
            var same_name_union = find_union_qualified(found_class.qualified_dotted, name)
            if same_name_union {
                return union_type_of(same_name_union)
            }
            var same_name_enum = find_enum_qualified(found_class.qualified_dotted, name)
            if same_name_enum {
                return enum_type_of(same_name_enum)
            }
            if found_class.c_name == "Spite_Function" and not named.arguments.is_empty() {
                return function_type_from(named, current_namespace)
            }
            var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(found_class.c_name)
            return resolved
        }
        var found_enum = find_enum(name)
        if found_enum {
            return enum_type_of(found_enum)
        }
        var found_union = find_union(name)
        if found_union {
            return union_type_of(found_union)
        }
        if not reported_old_spelling(name) {
            var unknown_single = unknown_type_message(name, current_namespace)
            report(unknown_single)
        }
        return null
    }
    var joined = named.path.join(".")
    var owner_path = named.path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    var last_segment = named.path.last()
    crash last_segment
    var owner_class = find_class(joined_owner_path, current_namespace)
    if owner_class {
        joined_owner_path = owner_class.qualified_dotted
    }
    var qualified_enum = find_enum_qualified(joined_owner_path, last_segment)
    if qualified_enum {
        return enum_type_of(qualified_enum)
    }
    var qualified_union = find_union_qualified(joined_owner_path, last_segment)
    if qualified_union {
        return union_type_of(qualified_union)
    }
    var qualified_class = find_class(joined, current_namespace)
    if qualified_class {
        if qualified_class.is_generic_template {
            var generic_instance = instantiate_generic(qualified_class, named.arguments, current_namespace)
            if generic_instance {
                return class_type_of(generic_instance)
            }
            return null
        }
        joined = qualified_class.qualified_dotted
        var owned_union = find_union_qualified(joined, last_segment)
        if owned_union {
            return union_type_of(owned_union)
        }
        var owned_enum = find_enum_qualified(joined, last_segment)
        if owned_enum {
            return enum_type_of(owned_enum)
        }
        if qualified_class.c_name == "Spite_Function" and not named.arguments.is_empty() {
            return function_type_from(named, current_namespace)
        }
        var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(qualified_class.c_name)
        return resolved
    }
    var unknown_path = unknown_type_message(joined, current_namespace)
    report(unknown_path)
    return null
}

func unknown_type_message(written: String, current_namespace: String): String {
    var held = versions_holding(written)
    if held {
        return "unknown type '{written}': {held}"
    }
    var segments = written.split(".")
    var dropped = 1
    while dropped < segments.count() {
        var shorter = segments.copy()
        var removed = 0
        while removed < dropped {
            shorter.remove_first()
            removed = removed + 1
        }
        var shorter_path = shorter.join(".")
        var found = find_class(shorter_path, current_namespace)
        if found {
            return "unknown type '{written}': did you mean '{found.qualified_dotted}'?"
        }
        dropped = dropped + 1
    }
    unknown_simple_name = written
    var named_alike = classes.filter(is_named_alike)
    var only_alike = named_alike.first()
    if only_alike and segments.count() == 1 and named_alike.count() == 1 {
        return "unknown type '{written}': did you mean '{only_alike.qualified_dotted}'?"
    }
    return "unknown type '{written}'"
}

func is_named_alike(candidate: Analysis.ClassInfo): Boolean {
    return candidate.simple_name == unknown_simple_name and candidate.qualified_dotted != unknown_simple_name
}

func resolve_single_type_argument(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    if named.arguments.count() != 1 {
        var type_name = named.path.last()
        crash type_name
        report("{type_name} takes exactly one type argument")
        return null
    }
    return resolve_generic_argument(named.arguments[0], current_namespace)
}

func bound_type_member(named: Syntax.Types.NamedType): Analysis.SpiteType? {
    var bound_type = bound_field_type
    var index = 2
    while index < named.path.count() {
        var segment = named.path[index]
        var member_type = codegen_member_type(bound_type, segment)
        assert member_type or not segment.starts_with("argument_class(")
        if not member_type {
            report(
                "{type_with_article(bound_type)} has no codegen value named '{segment}': List<$element_type>, Dictionary<$key_type, $value_type> and $value_type? name theirs, and a generic class names its own",
            )
            return null
        }
        bound_type = member_type
        index = index + 1
    }
    return bound_type
}

func codegen_member_chain_type(
    expression: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var member = shape.as_member(expression)
    assert member
    crash member.object
    var owner_type: Analysis.SpiteType? = null
    var generic_identifier = shape.as_generic_identifier(member.object)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        owner_type = codegen_bound_type(bare_name, class_information)
    } else {
        owner_type = codegen_member_chain_type(member.object, class_information)
    }
    assert owner_type
    return codegen_member_type(owner_type, member.name)
}

func resolve_codegen_member(named: Syntax.Types.NamedType): Analysis.SpiteType? {
    var written = named.path.first()
    crash written
    var generic_name = without_dollar(written)
    var bound_type: Analysis.SpiteType? = null
    if current_class {
        bound_type = codegen_bound_type(generic_name, current_class)
    }
    if not bound_type {
        report(
            "'${generic_name}' is not a type declared on this class's constructor, so it has no codegen values to read",
        )
        return null
    }
    var index = 1
    while index < named.path.count() {
        var segment = named.path[index]
        var member_type = codegen_member_type(bound_type, segment)
        assert member_type or not segment.starts_with("argument_class(")
        if not member_type {
            report(
                "{type_with_article(bound_type)} has no codegen value named '${segment}': List<$element_type>, Dictionary<$key_type, $value_type> and $value_type? name theirs, and a generic class names its own",
            )
            return null
        }
        bound_type = member_type
        index = index + 1
    }
    return bound_type
}

func codegen_member_type(owner: Analysis.SpiteType, name: String): Analysis.SpiteType? {
    if name.starts_with("argument_class(") {
        return parameter_class_type(owner, name)
    }
    var owner_list = type_shape.as_list(owner)
    if owner_list {
        assert name == "element_type"
        return owner_list.element
    }
    var owner_dictionary = type_shape.as_dictionary(owner)
    if owner_dictionary {
        if name == "key_type" {
            return owner_dictionary.key
        }
        assert name == "value_type"
        return owner_dictionary.element
    }
    var owner_nullable = type_shape.as_nullable(owner)
    if owner_nullable {
        assert name == "value_type"
        return owner_nullable.inner
    }
    var owner_class_ref = type_shape.as_class_ref(owner)
    assert owner_class_ref
    var owner_class = find_class_by_c_name(owner_class_ref.c_name)
    assert owner_class
    var bound = codegen_index(owner_class, name)
    assert bound >= 0
    crash owner_class.codegen_codes[bound]
    assert owner_class.codegen_codes[bound].is_empty()
    return owner_class.codegen_types[bound]
}

func resolve_generic_argument(argument: Syntax.Types.GenericArgument, current_namespace: String): Analysis.SpiteType? {
    var type_argument = shape.as_type_argument(argument)
    if not type_argument {
        report("a type argument must be a type")
        return null
    }
    assert type_argument.value
    return resolve_type(type_argument.value, current_namespace)
}

func written_dictionary_type(
    key_argument: Syntax.Types.GenericArgument,
    value_argument: Syntax.Types.GenericArgument,
    current_namespace: String,
): Analysis.SpiteType? {
    var written_key = resolve_generic_argument(key_argument, current_namespace)
    var written_value = resolve_generic_argument(value_argument, current_namespace)
    assert written_key and written_value
    assert keyable(written_key)
    var written: Analysis.SpiteType = Analysis.Types.DictionaryType(written_value, written_key)
    return written
}

func report_dictionary_arguments(given: Integer) {
    report(
        "a Dictionary names two types, its keys' and then its values', as in 'Dictionary<String, Integer>', and this one names {given}",
    )
}

# ../../../specs/collections.md#dictionarykey-value
func keyable(key_type: Analysis.SpiteType): Boolean {
    var shown = type_display_name(key_type)
    if is_whole_number_type(key_type) or type_shape.as_string(key_type) or is_enum_type(key_type) {
        return true
    }
    var scalar = type_shape.as_scalar(key_type)
    if scalar {
        return true
    }
    var keyed_class = type_shape.as_class_ref(key_type)
    if keyed_class and not keyed_class.has_signature {
        var information = find_class_by_c_name(keyed_class.c_name)
        if information {
            if information.is_value_class {
                report(
                    "a Dictionary cannot be keyed by '{shown}': it is a value, copied wherever it goes, so it has no identity to key by; key the dictionary by a number or a String made from it",
                )
                return false
            }
            if declares_equals(information) {
                report(
                    "a Dictionary keyed by '{shown}' finds each key by identity, one object one key, but '{shown}' declares 'equals', so an equal '{shown}' would not be found: key the dictionary by what 'equals' compares, a number or a String",
                )
                return false
            }
            return true
        }
    }
    report(
        "a Dictionary cannot be keyed by '{shown}': a key is a number, a Boolean, a String, an enum value or an object of a class",
    )
    return false
}

func declares_equals(information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < discovered_classes.count() {
        var discovered = discovered_classes[index]
        if discovered.qualified_dotted == information.qualified_dotted and declares_function(discovered, "equals") {
            return true
        }
        index = index + 1
    }
    return false
}

func declares_function(discovered: Discovery.DiscoveredClass, name: String): Boolean {
    var statements = discovered.file.statements
    var index = 0
    while index < statements.count() {
        var declaration = shape.as_function_declaration(statements[index])
        if declaration {
            if declaration.name == name {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func list_type_of(element: Analysis.SpiteType): Analysis.SpiteType {
    return Analysis.Types.ListType(element)
}

func integer_type(): Analysis.SpiteType {
    return Analysis.Types.ScalarType('integer_kind')
}

func boolean_type(): Analysis.SpiteType {
    return Analysis.Types.ScalarType('boolean_kind')
}

func string_type(): Analysis.SpiteType {
    return Analysis.Types.StringType()
}

func value_class_names(): List<String> {
    return [
        "Integer"
        "Long"
        "Float"
        "Double"
        "Boolean"
        "Tiny"
        "Short"
        "Byte"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Memory.Address"
    ]
}

func value_type_named(name: String): Analysis.SpiteType? {
    if name == "String" {
        return string_type()
    }
    var names = value_class_names()
    assert names.contains(name)
    var no_arguments = List<Syntax.Types.GenericArgument>()
    var path = name.split(".")
    var named = Syntax.Types.NamedType(path, no_arguments)
    return resolve_named_type(named, "")
}

func value_class_of(kind: Analysis.Types.NumericKind): Analysis.ClassInfo? {
    var scalar_type: Analysis.SpiteType = Analysis.Types.ScalarType(kind)
    var name = type_label(scalar_type)
    return find_class_by_c_name("Spite{name}")
}

func value_class_type(information: Analysis.ClassInfo): Analysis.SpiteType {
    var value_type = value_type_named(information.qualified_dotted)
    if value_type {
        return value_type
    }
    return Analysis.Types.ClassRefType(information.c_name)
}

func address_type(): Analysis.SpiteType {
    return Analysis.Types.ScalarType('address_kind')
}

func long_type(): Analysis.SpiteType {
    return Analysis.Types.ScalarType('long_kind')
}

func float_type(): Analysis.SpiteType {
    return Analysis.Types.ScalarType('float_kind')
}

func double_type(): Analysis.SpiteType {
    return Analysis.Types.ScalarType('double_kind')
}

func void_type(): Analysis.SpiteType {
    return Analysis.Types.VoidType()
}

func void_result(): ExpressionResult {
    var nothing_type = void_type()
    return ExpressionResult("0", nothing_type)
}

func no_types(): List<Analysis.SpiteType> {
    return List<Analysis.SpiteType>()
}

func one_type(first: Analysis.SpiteType): List<Analysis.SpiteType> {
    var result = List<Analysis.SpiteType>()
    result.append(first)
    return result
}

func two_types(first: Analysis.SpiteType, second: Analysis.SpiteType): List<Analysis.SpiteType> {
    var result = List<Analysis.SpiteType>()
    result.append(first)
    result.append(second)
    return result
}

func resolve_nullable_argument(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    if named.arguments.count() != 1 {
        report("Nullable takes exactly one type argument")
        return null
    }
    var type_argument = shape.as_type_argument(named.arguments[0])
    if not type_argument {
        report("Nullable's argument must be a type")
        return null
    }
    assert type_argument.value
    var inner = resolve_type(type_argument.value, current_namespace)
    if inner {
        return nullable_type_of(inner)
    }
    return null
}

func null_code(inner: Analysis.SpiteType): String {
    if type_shape.as_string(inner) or type_shape.is_symbol(inner) {
        return "SPITE_STRING_NULL"
    }
    if tagged_shape_of(inner) {
        return "SPITE_TAGGED_NULL"
    }
    return "0"
}

func present_code(code: String, inner: Analysis.SpiteType): String {
    if type_shape.as_string(inner) or type_shape.is_symbol(inner) {
        return "(!SPITE_STRING_IS_NULL({code}))"
    }
    if tagged_shape_of(inner) {
        return "SPITE_TAGGED_PRESENT({code})"
    }
    return "(({code}) != 0)"
}

func type_is_reference(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return true
    }
    if type_shape.as_list(spite_type) {
        return true
    }
    if type_shape.as_dictionary(spite_type) {
        return true
    }
    if type_shape.as_union(spite_type) {
        return true
    }
    if type_shape.as_class_ref(spite_type) {
        return true
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.inner
        return type_is_reference(nullable_inner)
    }
    return false
}

func type_needs_drop(spite_type: Analysis.SpiteType): Boolean {
    return type_is_reference(spite_type)
}

func types_equal(left_type: Analysis.SpiteType, right_type: Analysis.SpiteType): Boolean {
    var left_scalar = type_shape.as_scalar(left_type)
    if left_scalar {
        var right_scalar = type_shape.as_scalar(right_type)
        if right_scalar {
            return left_scalar.kind == right_scalar.kind
        }
        return false
    }
    if type_shape.as_string(left_type) {
        return type_shape.as_string(right_type)
    }
    if type_shape.is_symbol(left_type) {
        return type_shape.is_symbol(right_type)
    }
    var left_class = type_shape.as_class_ref(left_type)
    if left_class {
        var right_class = type_shape.as_class_ref(right_type)
        if right_class {
            return left_class.c_name == right_class.c_name and same_signature(left_class, right_class)
        }
        return false
    }
    var left_union = type_shape.as_union(left_type)
    if left_union {
        var right_union = type_shape.as_union(right_type)
        if right_union {
            return left_union.c_name == right_union.c_name
        }
        return false
    }
    var left_dictionary = type_shape.as_dictionary(left_type)
    if left_dictionary {
        var right_dictionary = type_shape.as_dictionary(right_type)
        if right_dictionary {
            var left_dictionary_element = left_dictionary.element
            var right_dictionary_element = right_dictionary.element
            var left_key = left_dictionary.key
            var right_key = right_dictionary.key
            return types_equal(left_dictionary_element, right_dictionary_element) and types_equal(left_key, right_key)
        }
        return false
    }
    var left_list = type_shape.as_list(left_type)
    if left_list {
        var right_list = type_shape.as_list(right_type)
        if right_list {
            var left_list_element = left_list.element
            var right_list_element = right_list.element
            return types_equal(left_list_element, right_list_element)
        }
        return false
    }
    var left_enum = type_shape.as_enum(left_type)
    if left_enum {
        var right_enum = type_shape.as_enum(right_type)
        if right_enum {
            return left_enum.c_name == right_enum.c_name
        }
        return false
    }
    var left_nullable = type_shape.as_nullable(left_type)
    if left_nullable {
        var right_nullable = type_shape.as_nullable(right_type)
        if right_nullable {
            var left_nullable_inner = left_nullable.inner
            var right_nullable_inner = right_nullable.inner
            return types_equal(left_nullable_inner, right_nullable_inner)
        }
        return false
    }
    if type_shape.is_void(left_type) {
        return type_shape.is_void(right_type)
    }
    if type_shape.is_arguments(left_type) {
        return type_shape.is_arguments(right_type)
    }
    return false
}

func numeric_c_name(kind: Analysis.Types.NumericKind): String {
    switch kind {
        'integer_kind': return "int32_t"
        'long_kind': return "int64_t"
        'tiny_kind': return "int8_t"
        'short_kind': return "int16_t"
        'byte_kind': return "uint8_t"
        'unsigned_short_kind': return "uint16_t"
        'unsigned_integer_kind': return "uint32_t"
        'unsigned_long_kind': return "uint64_t"
        'address_kind': return "int64_t"
        'float_kind': return "float"
        'double_kind': return "double"
        _: return "bool"
    }
}

func type_label(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        switch scalar.kind {
            'integer_kind': return "Integer"
            'long_kind': return "Long"
            'tiny_kind': return "Tiny"
            'short_kind': return "Short"
            'byte_kind': return "Byte"
            'unsigned_short_kind': return "UnsignedShort"
            'unsigned_integer_kind': return "UnsignedInteger"
            'unsigned_long_kind': return "UnsignedLong"
            'address_kind': return "Memory_Address"
            'float_kind': return "Float"
            'double_kind': return "Double"
            _: return "Boolean"
        }
    }
    if type_shape.as_string(spite_type) {
        return "String"
    }
    if type_shape.is_symbol(spite_type) {
        return "Symbol"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return class_ref.c_name
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        return enum_type.c_name
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        return "List_{type_label(list_type_element)}"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.element
        return "Dictionary_{type_label(dictionary_type_element)}{dictionary_key_suffix(dictionary_type)}"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.inner
        return "Nullable_{type_label(nullable_inner)}"
    }
    return "Value"
}

func ensure_nullable_scalar_typedef(inner: Analysis.SpiteType): String {
    var label = type_label(inner)
    var struct_name = "Nullable_{label}"
    if not nullable_scalar_labels.contains(label) {
        nullable_scalar_labels.append(label)
        var value_c_type = c_type_name(inner)
        builder.add_typedef("typedef struct \{ bool has_value; {value_c_type} value; } {struct_name};")
    }
    return struct_name
}

func c_value_name(name: String): String {
    return "{name}_"
}

func c_parameter_names(parameters: List<Analysis.ParamInfo>): List<String> {
    var names = List<String>()
    var index = 0
    while index < parameters.count() {
        var parameter_code = c_value_name(parameters[index].name)
        names.append(parameter_code)
        index = index + 1
    }
    return names
}

func c_type_name(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return numeric_c_name(scalar.kind)
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "SpiteString"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}*"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.inner
        if type_is_reference(inner) {
            return c_type_name(inner)
        }
        return ensure_nullable_scalar_typedef(inner)
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        return enum_type.c_name
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        return "{ensure_list(list_type_element)}*"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return "{ensure_dictionary(dictionary_type)}*"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name
    }
    if type_shape.is_void(spite_type) {
        return "void"
    }
    if type_shape.is_arguments(spite_type) {
        return "SpiteArguments"
    }
    return "void*"
}

func default_value_for_type(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        switch scalar.kind {
            'boolean_kind': return "false"
            'float_kind': return "0.0"
            'double_kind': return "0.0"
            _: return "0"
        }
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "SPITE_STRING_EMPTY"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}___default()"
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        var first_value = enum_type.values.first()
        crash first_value
        return "{enum_type.c_name}_{first_value}"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        return "{ensure_list(list_type_element)}___make()"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return "{ensure_dictionary(dictionary_type)}___make()"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var union_information = find_union_by_c_name(union_type.c_name)
        if union_information {
            if union_information.is_shape {
                return shape_default(union_information)
            }
            var first_member = union_information.members.first()
            crash first_member
            return "(({union_type.c_name}){first_member.c_name}___default())"
        }
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.inner
        if type_is_reference(inner) {
            return null_code(inner)
        }
        var struct_name = ensure_nullable_scalar_typedef(inner)
        return "(({struct_name})\{ .has_value = false, .value = {default_value_for_type(inner)} })"
    }
    return "0"
}

func is_float_kind(kind: Analysis.Types.NumericKind): Boolean {
    if kind == 'float_kind' {
        return true
    }
    return kind == 'double_kind'
}

func string_conversion(code: String, from: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(from)
    if scalar {
        var value_class = value_class_of(scalar.kind)
        if value_class {
            var string_function = value_class.find_function("to_string")
            if string_function {
                return "{string_function.c_name}({code})"
            }
        }
        report(
            "{type_with_article(from)} becomes text through the to_string() function of its class in library/, and that class declares none",
        )
        return "SPITE_STRING_EMPTY"
    }
    var enum_type = type_shape.as_enum(from)
    if enum_type {
        return "spite_string_from_cstring_owned({enum_type.c_name}___name({code}))"
    }
    return code
}

func long_text(code: String): String {
    var wide_type = long_type()
    return string_conversion("((int64_t)({code}))", wide_type)
}

func allocator_text(): String {
    var prelude = Prelude()
    if debug_memory {
        return prelude.table_allocator()
    }
    var counted = prelude.counted_allocator()
    var plain = prelude.plain_allocator()
    return builder.type_placeholder_if_kept("Memory_Heap_live_allocations", counted, plain)
}

func debug_registration(pointer: String, class_id: String): String {
    if not debug_memory {
        return ""
    }
    return "#ifdef SPITE_DEBUG_MEMORY\nspite_debug_register_object({pointer}, {class_id});\n#endif\n"
}

func emit_allocation_table() {
    var allocation_table = find_class_by_qualified("AllocationTable")
    crash allocation_table
    var table = allocation_table.c_name
    var entered = "{table}* spite_table = spite_allocation_table_enter();"
    var leave = "spite_allocation_table_leave();"
    var lines = List<String>()
    lines.append("#ifdef SPITE_DEBUG_MEMORY")
    lines.append("static {table}* spite_allocation_table = 0;")
    lines.append("static SPITE_THREAD_LOCAL bool spite_allocation_table_busy = false;")
    lines.append("#ifdef SPITE_THREADS")
    lines.append("static int32_t spite_allocation_table_lock = 0;")
    lines.append("#endif")
    lines.append("static void spite_allocation_table_leave(void) \{")
    lines.append("spite_allocation_table_busy = false;")
    lines.append("#ifdef SPITE_THREADS")
    lines.append("__atomic_store_n(&spite_allocation_table_lock, 0, __ATOMIC_RELEASE);")
    lines.append("#endif")
    lines.append("}")
    lines.append("static {table}* spite_allocation_table_enter(void) \{")
    lines.append("#ifdef SPITE_THREADS")
    lines.append("while (__atomic_exchange_n(&spite_allocation_table_lock, 1, __ATOMIC_ACQUIRE) != 0) \{}")
    lines.append("#endif")
    lines.append("spite_allocation_table_busy = true;")
    lines.append("if (spite_allocation_table == 0) spite_allocation_table = {table}___make();")
    lines.append("return spite_allocation_table;")
    lines.append("}")
    lines.append("void* spite_debug_realloc(void* pointer, size_t size) \{")
    lines.append("if (spite_allocation_table_busy) return realloc(pointer, size);")
    lines.append(entered)
    lines.append(
        "void* result = (void*)(intptr_t){table}_resize(spite_table, (int64_t)(intptr_t)pointer, (int64_t)size);",
    )
    lines.append(leave)
    lines.append("return result;")
    lines.append("}")
    lines.append("void spite_debug_free(void* pointer) \{")
    lines.append("if (pointer == 0) return;")
    lines.append("if (spite_allocation_table_busy) \{ free(pointer); return; }")
    lines.append(entered)
    lines.append("{table}_free(spite_table, (int64_t)(intptr_t)pointer);")
    lines.append(leave)
    lines.append("}")
    lines.append("void spite_debug_register_object(void* pointer, int32_t class_id) \{")
    lines.append("if (pointer == 0 || spite_allocation_table_busy) return;")
    lines.append(entered)
    lines.append("{table}_register_object(spite_table, (int64_t)(intptr_t)pointer, class_id);")
    lines.append(leave)
    lines.append("}")
    lines.append("void spite_debug_set_class_names(const char* const* names, int64_t count) \{")
    lines.append(entered)
    lines.append("{table}_name_classes(spite_table, (int64_t)(intptr_t)names, count);")
    lines.append(leave)
    lines.append("}")
    lines.append("void spite_debug_report(void) \{")
    lines.append(entered)
    lines.append("{table}_report(spite_table);")
    lines.append(leave)
    lines.append("}")
    lines.append("int64_t spite_live_allocation_count(void) \{")
    lines.append(entered)
    lines.append("int64_t count = {table}_live_allocations(spite_table);")
    lines.append(leave)
    lines.append("return count;")
    lines.append("}")
    lines.append("int64_t spite_live_byte_count(void) \{")
    lines.append(entered)
    lines.append("int64_t bytes = {table}_live_bytes(spite_table);")
    lines.append(leave)
    lines.append("return bytes;")
    lines.append("}")
    lines.append("#endif")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func parsed_number(code: String, from: Analysis.SpiteType, to: Analysis.SpiteType): String {
    if not type_shape.as_string(from) or not type_shape.as_scalar(to) {
        return ""
    }
    var target_label = type_label(to)
    var conversion_name = words_of(target_label).join("_")
    var conversion = written_string_function("to_{conversion_name}")
    if not conversion {
        return ""
    }
    return "{conversion.c_name}({code})"
}

func cast(code: String, from: Analysis.SpiteType, to: Analysis.SpiteType): String {
    if types_equal(from, to) {
        return code
    }
    if type_shape.is_symbol(from) and type_shape.as_string(to) {
        return code
    }
    if type_shape.as_string(from) and type_shape.is_symbol(to) {
        report(
            "text is not a Symbol: a Symbol is written 'name', and text becomes one with Symbol(text), which answers Symbol? (null unless the program already uses that symbol)",
        )
        return code
    }
    var from_function = type_shape.as_class_ref(from)
    var to_function = type_shape.as_class_ref(to)
    if from_function {
        if to_function {
            if from_function.has_signature and not to_function.has_signature and to_function.c_name == "Spite_Function" {
                return code
            }
        }
    }
    if type_shape.is_void(from) {
        var nothing_class = type_shape.as_class_ref(to)
        if nothing_class {
            if nothing_class.c_name == "Nothing" {
                return "(\{ {code}; Nothing___default(); })"
            }
        }
    }
    var to_nullable = type_shape.as_nullable(to)
    if to_nullable {
        var inner = to_nullable.inner
        var parsed = parsed_number(code, from, inner)
        if not parsed.is_empty() {
            return parsed
        }
        var named_enum = type_shape.as_enum(inner)
        if named_enum and type_shape.as_string(from) {
            return enum_from_text(code, "", named_enum)
        }
        var inner_code = cast(code, from, inner)
        if type_is_reference(inner) {
            return inner_code
        }
        return "(({c_type_name(to)})\{ .has_value = true, .value = {inner_code} })"
    }
    var to_union = type_shape.as_union(to)
    if to_union {
        var from_class_ref = type_shape.as_class_ref(from)
        if from_class_ref {
            var admitted_union = find_union_by_c_name(to_union.c_name)
            var admitted_class = find_class_by_c_name(from_class_ref.c_name)
            if admitted_union {
                if admitted_union.is_tagged {
                    return tagged_value(code, from, admitted_union)
                }
                if admitted_class {
                    admit_to_union(admitted_union, admitted_class)
                }
            }
            return "(({to_union.c_name})({code}))"
        }
        var shaped_union = find_union_by_c_name(to_union.c_name)
        if shaped_union {
            if shaped_union.is_shape {
                return shaped_value(code, from, to, shaped_union)
            }
        }
        if type_shape.as_string(from) {
            return "(({to_union.c_name})({boxed_text(code)}))"
        }
        return "(({to_union.c_name})({code}))"
    }
    if type_shape.as_string(to) {
        if type_shape.as_scalar(from) {
            return string_conversion(code, from)
        }
        if is_enum_type(from) {
            return string_conversion(code, from)
        }
        report_mismatch(from, to, code)
        return code
    }
    if type_shape.as_string(from) {
        if type_shape.as_enum(to) {
            var enum_label = type_display_name(to)
            report(
                "text is not {with_article(enum_label)} until it is read as one, and text that names none of its values has none to give: read it with '{enum_reading_name(enum_label)}()', which answers '{enum_label}?', null when the text names none of its values, and narrow it, or declare the value '{enum_label}?'",
            )
            return code
        }
        if type_shape.as_scalar(to) {
            var target_label = type_label(to)
            var conversion_name = words_of(target_label).join("_")
            report(
                "text is not {with_article(target_label)} until it is read as one, and text that is not a number has none to give: read it with 'to_{conversion_name}()', which answers '{target_label}?', null when the text is not a number that fits, and narrow it, or declare the value '{target_label}?'",
            )
            return code
        }
    }
    var to_scalar_plain = type_shape.as_scalar(to)
    if to_scalar_plain {
        if type_shape.as_scalar(from) {
            var narrowed = checked_narrowing(code, from, to)
            if not narrowed.is_empty() {
                return narrowed
            }
            var conversion = numeric_conversion(from, to)
            if conversion.is_empty() {
                return "(({c_type_name(to)})({code}))"
            }
            return "{conversion}({code})"
        }
        report_mismatch(from, to, code)
        return code
    }
    report_mismatch(from, to, code)
    return code
}

func checked_narrowing(code: String, from: Analysis.SpiteType, to: Analysis.SpiteType): String {
    var from_scalar = type_shape.as_scalar(from)
    var to_scalar = type_shape.as_scalar(to)
    crash from_scalar
    crash to_scalar
    if not is_checked_whole_kind(to_scalar.kind) {
        return ""
    }
    var decimal = is_float_kind(from_scalar.kind)
    if not decimal and not is_checked_whole_kind(from_scalar.kind) {
        return ""
    }
    if not decimal and code_fits(code, to_scalar.kind) {
        return ""
    }
    if not decimal and widens_without_check(from_scalar.kind, to_scalar.kind) {
        return ""
    }
    var value = next_temporary()
    var outside = outside_condition(value, from_scalar.kind, to_scalar.kind)
    if outside.is_empty() {
        return ""
    }
    var failure = narrowing_failure(from_scalar.kind)
    var where = located(current_path, current_line, current_owner, current_function)
    var from_display = type_display_name(from)
    var to_display = type_display_name(to)
    var from_name = with_article(from_display)
    var to_name = with_article(to_display)
    var to_c_type = c_type_name(to)
    var widened = "(double)"
    if not decimal {
        widened = operand_cast(from_scalar.kind)
    }
    return "(\{ {c_type_name(from)} {value} = {code}; if (__builtin_expect({outside}, 0)) {failure}({widened}{value}, \"{from_name}\", \"{to_name}\", {where}); ({to_c_type}){value}; })"
}

func widens_without_check(from: Analysis.Types.NumericKind, to: Analysis.Types.NumericKind): Boolean {
    var from_bits = scalar_bits(from)
    var to_bits = scalar_bits(to)
    if from_bits > to_bits {
        return false
    }
    var from_signed = is_signed_kind(from)
    var to_signed = is_signed_kind(to)
    if from_signed == to_signed {
        return true
    }
    return not from_signed and from_bits < to_bits
}

func code_literal(code: String): Long? {
    var digits = code
    while digits.starts_with("(") and digits.ends_with(")") {
        var length = digits.length()
        digits = digits.slice(1, length - 1)
    }
    var negative = digits.starts_with("-")
    if negative {
        var length = digits.length()
        digits = digits.slice(1, length)
    }
    while digits.starts_with("(") and digits.ends_with(")") {
        var length = digits.length()
        digits = digits.slice(1, length - 1)
    }
    assert not digits.is_empty() and digits.length() <= 19
    var index = 0
    while index < digits.length() {
        var character = digits.slice(index, index + 1)
        assert "0123456789".contains(character)
        index = index + 1
    }
    var magnitude = digits.to_long()
    assert magnitude
    if negative {
        return -magnitude
    }
    return magnitude
}

func kind_lowest(kind: Analysis.Types.NumericKind): Long {
    switch kind {
        'tiny_kind': return -128
        'short_kind': return -32768
        'integer_kind': return -2147483648
        'long_kind': return Long.smallest
        _: return 0
    }
}

func kind_highest(kind: Analysis.Types.NumericKind): Long {
    switch kind {
        'tiny_kind': return 127
        'byte_kind': return 255
        'short_kind': return 32767
        'unsigned_short_kind': return 65535
        'integer_kind': return 2147483647
        'unsigned_integer_kind': return 4294967295
        _: return Long.largest
    }
}

func code_fits(code: String, kind: Analysis.Types.NumericKind): Boolean {
    var value = code_literal(code)
    if not value {
        return false
    }
    if value >= kind_lowest(kind) and value <= kind_highest(kind) or literal_fit_reported or errors_reported_at == "{current_path}:{current_line}" {
        return true
    }
    var kind_name = kind_display_name(kind)
    report(
        "{value} does not fit in {with_article(kind_name)}, whose numbers run from {kind_lowest(kind)} to {kind_range_top(kind)}: store it in a wider type, or use a number that fits",
    )
    return true
}

func kind_range_top(kind: Analysis.Types.NumericKind): String {
    if kind == 'unsigned_long_kind' {
        return "18446744073709551615"
    }
    var highest = kind_highest(kind)
    return highest.to_string()
}

func kind_display_name(kind: Analysis.Types.NumericKind): String {
    switch kind {
        'tiny_kind': return "Tiny"
        'byte_kind': return "Byte"
        'short_kind': return "Short"
        'unsigned_short_kind': return "UnsignedShort"
        'integer_kind': return "Integer"
        'unsigned_integer_kind': return "UnsignedInteger"
        'long_kind': return "Long"
        _: return "UnsignedLong"
    }
}

func outside_condition(value: String, from: Analysis.Types.NumericKind, to: Analysis.Types.NumericKind): String {
    var limit = c_limit_name(to)
    var to_bits = scalar_bits(to)
    if is_float_kind(from) {
        if is_unsigned_whole_kind(to) {
            return "!((double){value} > -1.0 && (double){value} < {power_of_two_text(to_bits)})"
        }
        if to_bits == 64 {
            return "!((double){value} >= -9223372036854775808.0 && (double){value} < 9223372036854775808.0)"
        }
        return "!((double){value} > (double){limit}_MIN - 1.0 && (double){value} < (double){limit}_MAX + 1.0)"
    }
    var from_signed = is_signed_kind(from)
    var to_signed = is_signed_kind(to)
    if from_signed and to_signed {
        return "{value} < {limit}_MIN || {value} > {limit}_MAX"
    }
    if from_signed {
        return "{value} < 0 || {value} > {limit}_MAX"
    }
    return "{value} > {limit}_MAX"
}

func power_of_two_text(bits: Integer): String {
    switch bits {
        8: return "256.0"
        16: return "65536.0"
        32: return "4294967296.0"
        _: return "18446744073709551616.0"
    }
}

func c_limit_name(kind: Analysis.Types.NumericKind): String {
    switch kind {
        'tiny_kind': return "INT8"
        'byte_kind': return "UINT8"
        'short_kind': return "INT16"
        'unsigned_short_kind': return "UINT16"
        'integer_kind': return "INT32"
        'unsigned_integer_kind': return "UINT32"
        'long_kind': return "INT64"
        _: return "UINT64"
    }
}

func narrowing_failure(kind: Analysis.Types.NumericKind): String {
    if is_float_kind(kind) {
        ensure_decimal_narrowing_check()
        return "spite_narrowed_decimal"
    }
    if is_signed_kind(kind) {
        ensure_narrowing_check()
        return "spite_narrowed"
    }
    ensure_unsigned_narrowing_check()
    return "spite_narrowed_unsigned"
}

func ensure_narrowing_check() {
    assert not narrowing_check_written
    narrowing_check_written = true
    builder.add_prototype(
        "static void spite_narrowed(int64_t value, const char* from, const char* to, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_narrowed(int64_t value, const char* from, const char* to, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: %lld, %s, does not fit in %s, at %s\\n\", (long long)value, from, to, where);\nexit(1);\n}",
    )
}

func ensure_unsigned_narrowing_check() {
    assert not unsigned_narrowing_check_written
    unsigned_narrowing_check_written = true
    builder.add_prototype(
        "static void spite_narrowed_unsigned(uint64_t value, const char* from, const char* to, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_narrowed_unsigned(uint64_t value, const char* from, const char* to, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: %llu, %s, does not fit in %s, at %s\\n\", (unsigned long long)value, from, to, where);\nexit(1);\n}",
    )
}

func ensure_decimal_narrowing_check() {
    assert not decimal_narrowing_check_written
    decimal_narrowing_check_written = true
    builder.add_prototype(
        "static void spite_narrowed_decimal(double value, const char* from, const char* to, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_narrowed_decimal(double value, const char* from, const char* to, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: %.17g, %s, does not fit in %s, at %s\\n\", value, from, to, where);\nexit(1);\n}",
    )
}

func numeric_conversion(from: Analysis.SpiteType, to: Analysis.SpiteType): String {
    var from_label = type_label(from)
    var to_label = type_label(to)
    var key = "{from_label} {to_label}"
    if conversion_names.has(key) {
        crash conversion_names[key]
        return conversion_names[key]
    }
    var conversion_name = ""
    var from_scalar = type_shape.as_scalar(from)
    crash from_scalar
    var source_class = value_class_of(from_scalar.kind)
    if source_class {
        var target_words = words_of(to_label)
        var target_name = target_words.join("_")
        var conversion = find_or_instantiate_function(source_class, "to_{target_name}")
        if conversion {
            conversion_name = conversion.c_name
            conversion_names[key] = conversion_name
        }
    }
    return conversion_name
}

func null_opening(code: String, type_text: String): String {
    if code.is_empty() or code != unproven_read_code {
        return "this value may be null (it is {type_text})"
    }
    return "'{unproven_read_path}' may be missing, since every '[ ]' answers a 'T?' (this one is {type_text})"
}

func null_advice(code: String): String {
    if code.is_empty() or code != unproven_read_code {
        return "narrow it first with 'if value \{ }', 'assert value' or 'crash value'"
    }
    var path = unproven_read_path
    return "narrow it first with 'crash {path}', 'assert {path}' or 'if {path} \{ }'{unproven_read_bound}"
}

func noted_read(
    read: ExpressionResult,
    index_expression: Syntax.Expressions.IndexExpression,
    object_type: Analysis.SpiteType,
): ExpressionResult {
    var read_type = read.type
    if not type_shape.as_nullable(read_type) {
        return read
    }
    var path = operand_text(index_expression)
    if path.is_empty() {
        return read
    }
    crash index_expression.object
    crash index_expression.index
    unproven_read_code = read.code
    unproven_read_path = path
    unproven_read_bound = ""
    var object_text = operand_text(index_expression.object)
    var bounded = false
    if type_shape.as_list(object_type) {
        bounded = true
    }
    var object_class_ref = type_shape.as_class_ref(object_type)
    if object_class_ref {
        var object_class = find_class_by_c_name(object_class_ref.c_name)
        if object_class {
            bounded = is_library_collection(object_class)
        }
    }
    if not bounded or object_text.is_empty() {
        return read
    }
    var literal = shape.as_integer_literal(index_expression.index)
    if literal {
        unproven_read_bound = ", or prove the count first, 'crash {object_text}.count() > {literal.value}'"
        return read
    }
    var index_text = Syntax.SourcePrinter().source_expression(index_expression.index)
    unproven_read_bound = ", or read it where a bound proves it, inside 'while {index_text} < {object_text}.count()'"
    return read
}

func report_mismatch(from: Analysis.SpiteType, to: Analysis.SpiteType, code: String) {
    assert not (type_shape.is_void(from) or type_shape.is_void(to))
    var names = type_display_names(from, to)
    var first_name = names.first()
    crash first_name
    var last_name = names.last()
    crash last_name
    var found_name = with_article(first_name)
    var wanted_name = with_article(last_name)
    if type_shape.as_nullable(from) {
        report("{null_opening(code, found_name)}, but {wanted_name} is needed: {null_advice(code)}")
        return
    }
    report("{found_name} cannot be used where {wanted_name} is needed")
}

func retain_call(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}___retain({code})"
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "SpiteString___retain({code})"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        return "{ensure_list(list_type_element)}___retain({code})"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return "{ensure_dictionary(dictionary_type)}___retain({code})"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return "{union_type.c_name}___retain({code})"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.inner
        return retain_call(nullable_inner, code)
    }
    return code
}

func release_call(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}___release({code})"
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "SpiteString___release({code})"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        return "{ensure_list(list_type_element)}___release({code})"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return "{ensure_dictionary(dictionary_type)}___release({code})"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return "{union_type.c_name}___release({code})"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.inner
        return release_call(nullable_inner, code)
    }
    return code
}

func owns(result: ExpressionResult, expression: Syntax.Expressions.Expression): Boolean {
    if result.owning_override == true {
        return true
    }
    if result.owning_override == false {
        return false
    }
    return is_owning_shape(expression)
}

func is_owning_shape(expression: Syntax.Expressions.Expression): Boolean {
    var identifier = shape.as_identifier(expression)
    if identifier {
        return false
    }
    var indexed = shape.as_index(expression)
    if indexed {
        if is_bound_attributes_index(indexed) {
            return false
        }
        if is_bound_member_index(indexed) {
            var read = bound_member_expression(indexed)
            return is_owning_shape(read)
        }
    }
    var member = shape.as_member(expression)
    if member {
        if member.name == "class" or member.name == "attributes" or member.name == "functions" {
            return true
        }
        crash member.object
        var object_identifier = shape.as_identifier(member.object)
        if object_identifier {
            if arguments_parameter_names.contains(object_identifier.name) {
                return true
            }
        }
        return is_owning_shape(member.object)
    }
    return true
}

func coerce_for_store(
    expression_ast: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if shape.is_null_literal(expression_ast) {
        return default_value_for_type(expected_type)
    }
    var list_literal = shape.as_list_literal(expression_ast)
    if list_literal {
        var expected_inner_type = expected_type_without_nullable(expected_type)
        var expected_list = type_shape.as_list(expected_inner_type)
        if expected_list {
            var expected_list_element = expected_list.element
            var literal_result = generate_list_literal(list_literal, expected_list_element, scope, class_information)
            return literal_result.code
        }
    }
    var dictionary_literal = shape.as_object_literal(expression_ast)
    if dictionary_literal {
        var expected_inner_type = expected_type_without_nullable(expected_type)
        var expected_dictionary = type_shape.as_dictionary(expected_inner_type)
        if expected_dictionary and dictionary_literal.is_dictionary {
            var made = generate_dictionary_literal(dictionary_literal, expected_dictionary, scope, class_information)
            return made.code
        }
    }
    var enum_literal = shape.as_enum_literal(expression_ast)
    if enum_literal {
        var expected_inner_type = expected_type_without_nullable(expected_type)
        if type_shape.is_symbol(expected_inner_type) {
            return ensure_symbol(enum_literal.value)
        }
        if type_shape.as_string(expected_inner_type) {
            report(
                "'{enum_literal.value}' in single quotes is a symbol, and text is wanted here: text is always written in double quotes, so write \"{enum_literal.value}\"",
            )
            return "SPITE_STRING_EMPTY"
        }
        var expected_enum = expected_enum_of(expected_type)
        if expected_enum {
            var value_code = enum_value_code(enum_literal, expected_enum)
            expected_inner_type = expected_type_without_nullable(expected_type)
            return cast(value_code, expected_inner_type, expected_type)
        }
    }
    var passed_class = class_passed_as_object(expression_ast, expected_type, scope, class_information)
    if passed_class {
        var passed_type = instance_type_of(passed_class)
        return class_object_call(passed_type)
    }
    var site = borrow_site
    borrow_site = ""
    var saved_counter = temporary_counter
    var result = generate_expression(expression_ast, scope, class_information)
    if site.starts_with("lent:") {
        var lent_type = result.type
        return cast(result.code, lent_type, expected_type)
    }
    if site == "return" and not result.borrowed_from.is_empty() and lends_this_return(expression_ast, class_information) {
        var lent_type = result.type
        return cast(result.code, lent_type, expected_type)
    }
    argument_expected_type = expected_type
    report_kept_borrow(expression_ast, result, site, scope, class_information)
    argument_expected_type = null
    var result_type = result.type
    if joins_into(result_type, expected_type) {
        rewind_temporaries(saved_counter)
        var joined_ast = implicit_join_ast(expression_ast)
        return coerce_for_store(joined_ast, expected_type, scope, class_information)
    }
    if becomes_text(result_type, expected_type) {
        rewind_temporaries(saved_counter)
        var text_ast = to_string_ast(expression_ast)
        return coerce_for_store(text_ast, expected_type, scope, class_information)
    }
    var expected_union = expected_type_without_nullable(expected_type)
    if type_shape.as_string(result_type) and type_shape.as_union(expected_union) {
        var owned_text = result.code
        if not owns(result, expression_ast) and not constant_texts.has(result.code) {
            owned_text = retain_call(result_type, result.code)
        }
        return cast(owned_text, result_type, expected_type)
    }
    var casted = cast(result.code, result_type, expected_type)
    if type_needs_drop(expected_type) {
        if owns(result, expression_ast) or is_boxed_into_shape(result_type, expected_type) {
            return casted
        }
        if made_into_text(result_type, expected_type) {
            return casted
        }
        if in_vector_library(class_information) and not borrowed_text_of(expression_ast, result, scope).is_empty() {
            return casted
        }
        return retain_call(expected_type, casted)
    }
    return casted
}

func joinable_handle(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(spite_type)
    assert class_ref
    var handle = find_class_by_c_name(class_ref.c_name)
    assert handle
    var is_handle = handle.qualified_dotted == "Concurrent" or handle.qualified_dotted == "Parallel"
    assert is_handle and not handle.is_generic_template and not handle.codegen_types.is_empty()
    var result_class = type_shape.as_class_ref(handle.codegen_types[0])
    if result_class {
        assert result_class.c_name != "Nothing"
    }
    return handle
}

func joins_into(result_type: Analysis.SpiteType, expected_type: Analysis.SpiteType): Boolean {
    if not joinable_handle(result_type) {
        return false
    }
    var expected_inner = expected_type_without_nullable(expected_type)
    return not types_equal(result_type, expected_inner)
}

func implicit_join_ast(handle_ast: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var joining = Syntax.Expressions.MemberExpression(handle_ast, "_result")
    implicit_joins.append(joining)
    var no_arguments = List<Syntax.Expressions.Expression>()
    return Syntax.Expressions.CallExpression(joining, no_arguments)
}

func is_implicit_join(member: Syntax.Expressions.MemberExpression): Boolean {
    if member.name != "_result" {
        return false
    }
    var index = 0
    while index < implicit_joins.count() {
        if implicit_joins[index] == member {
            return true
        }
        index = index + 1
    }
    return false
}

func forwards_to_result(handle: Analysis.ClassInfo, name: String): Boolean {
    var every_object_has = name == "class" or name == "attributes" or name == "functions"
    if name == "finished" or every_object_has or name.starts_with("_") {
        return false
    }
    if handle.find_function(name) {
        return false
    }
    return true
}

func generate_joined(
    expression_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var saved_counter = temporary_counter
    var result = generate_expression(expression_ast, scope, class_information)
    var result_type = result.type
    if not joinable_handle(result_type) {
        return result
    }
    rewind_temporaries(saved_counter)
    var joined_ast = implicit_join_ast(expression_ast)
    var joined = generate_expression(joined_ast, scope, class_information)
    joined.owning_override = true
    return joined
}

func expected_type_without_nullable(expected_type: Analysis.SpiteType): Analysis.SpiteType {
    var nullable = type_shape.as_nullable(expected_type)
    if nullable {
        return nullable.inner
    }
    return expected_type
}

func is_enum_literal(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_enum_literal(expression) {
        return true
    }
    return false
}

func is_enum_type(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_enum(spite_type) {
        return true
    }
    return false
}

func expected_enum_of(expected_type: Analysis.SpiteType): Analysis.Types.EnumType? {
    var expected_inner_type = expected_type_without_nullable(expected_type)
    return type_shape.as_enum(expected_inner_type)
}

func next_temporary(): String {
    temporary_counter = temporary_counter + 1
    return "spite_temp_{temporary_counter}"
}

func hex_digit(value: Integer): String {
    var digits = "0123456789abcdef"
    return digits.character_at(value)
}

func hex_escape(code: Integer): String {
    var high = code / 16
    var low = code % 16
    return "\\x{hex_digit(high)}{hex_digit(low)}"
}

func escape_c_string(value: String): String {
    var result = ""
    var index = 0
    while index < value.length() {
        var code = value.code_at(index)
        if code == 34 {
            result = "{result}\\\""
        } else if code == 92 {
            result = "{result}\\\\"
        } else if code == 10 {
            result = "{result}\\n"
        } else if code == 13 {
            result = "{result}\\r"
        } else if code == 9 {
            result = "{result}\\t"
        } else if code < 32 or code > 126 {
            result = result + hex_escape(code)
        } else {
            result = result + value.character_at(index)
        }
        index = index + 1
    }
    return result
}

func render_string_literal(value: String): String {
    literal_counter = literal_counter + 1
    var literal_name = "spite_lit_{literal_counter}"
    var escaped = escape_c_string(value)
    builder.add_typedef("static SpiteString {literal_name} = SPITE_STATIC_STRING(\"{escaped}\", {value.length()});")
    constant_texts[literal_name] = value
    return literal_name
}

func lookup_static_type(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var identifier = shape.as_identifier(expression)
    assert identifier
    if identifier.name == "self" {
        var self_type: Analysis.SpiteType = Analysis.Types.ClassRefType(class_information.c_name)
        return self_type
    }
    if identifier.name == "this" {
        return value_class_type(class_information)
    }
    var scope_type = scope.lookup_type(identifier.name)
    if scope_type {
        return scope_type
    }
    var field = class_information.find_field(identifier.name)
    if field {
        mark_attribute_read(class_information, identifier.name)
        return field.type
    }
    return null
}

func generate_integer_literal(literal: Syntax.Expressions.IntegerLiteral): ExpressionResult {
    var value = literal.value
    if value >= -2147483648 and value <= 2147483647 {
        var result_type = Analysis.Types.ScalarType('integer_kind')
        return ExpressionResult(value, result_type)
    }
    var result_type = Analysis.Types.ScalarType('long_kind')
    return ExpressionResult(value, result_type)
}

func generate_identifier(
    identifier: Syntax.Expressions.IdentifierExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if identifier.name == "self" {
        var self_type = Analysis.Types.ClassRefType(class_information.c_name)
        return ExpressionResult("self", self_type)
    }
    if identifier.name == "this" {
        var receiver_type = value_class_type(class_information)
        return ExpressionResult("self", receiver_type)
    }
    if reflected_binding(identifier.name) {
        return reflected_identifier(identifier, scope, class_information)
    }
    var override = scope.lookup_override(identifier.name)
    var scope_type = scope.lookup_type(identifier.name)
    if scope_type {
        if override {
            return ExpressionResult(override, scope_type)
        }
        var local_code = c_value_name(identifier.name)
        return ExpressionResult(local_code, scope_type)
    }
    var field = class_information.find_field(identifier.name)
    if field {
        mark_attribute_read(class_information, identifier.name)
        if identifier.name == "_namespace" and class_information.c_name == "Spite_Class" {
            namespace_read_used = true
            note_fact("flag namespace_read_used")
        }
        if class_information.is_value_class and class_information.c_name != "SpiteString" {
            report(
                "'{identifier.name}' is the memory {class_information.simple_name} is kept in, and the compiler keeps the value itself there: write 'this'",
            )
            return void_result()
        }
        var field_type = field.type
        if class_information.c_name == "SpiteString" {
            return string_storage_code(identifier.name, "self", field_type)
        }
        if atomic_owner == class_information.c_name and atomic_fields.contains(identifier.name) {
            var loaded_place = field_place("self", class_information, identifier.name)
            var loaded = "SPITE_SINGLETON_LOAD({class_information.c_name}, {loaded_place})"
            return ExpressionResult(loaded, field_type)
        }
        var read_place = field_place("self", class_information, identifier.name)
        return ExpressionResult(read_place, field_type)
    }
    if identifier.name == "class" {
        var self_type = Analysis.Types.ClassRefType(class_information.c_name)
        var self_result = ExpressionResult("self", self_type)
        var class_of_self = generate_reflection_read("class", self_result, identifier)
        if class_of_self {
            class_of_self.owning_override = true
            return class_of_self
        }
    }
    var named_function = find_or_instantiate_function(class_information, identifier.name)
    if named_function {
        if not named_function.is_constructor {
            var class_type = class_type_of(class_information)
            var bound_receiver = ExpressionResult("self", class_type)
            return function_value(class_information, named_function, bound_receiver, identifier)
        }
    }
    var named_class = find_class(identifier.name, class_information.qualified_dotted)
    if named_class {
        report(
            "'{identifier.name}' is a class, not a value: write '{identifier.name}()' to make one, and give it a name with 'var ... = '; for the class itself, pass it where a 'Spite.Class' is wanted",
        )
    } else if identifier.name == "Math" or identifier.name == "Maths" {
        report(
            "Spite has no '{identifier.name}': maths is a function of the number itself, like 'value.square_root()', and a constant is the number class's, like 'Float.pi'",
        )
    } else {
        report("unknown identifier '{identifier.name}'")
    }
    return void_result()
}

func maths_spelling(name: String): String {
    var spelling = maths.spelled(name)
    if spelling.is_empty() {
        return name
    }
    return spelling
}

func is_boolean_result_operator(operator: Syntax.Expressions.BinaryOperator): Boolean {
    switch operator {
        'add': return false
        'subtract': return false
        'multiply': return false
        'divide': return false
        'modulo': return false
        _: return true
    }
}

func binary_operator_symbol(operator: Syntax.Expressions.BinaryOperator): String {
    switch operator {
        'add': return "+"
        'subtract': return "-"
        'multiply': return "*"
        'divide': return "/"
        'modulo': return "%"
        'equal': return "=="
        'not_equal': return "!="
        'less': return "<"
        'less_equal': return "<="
        'greater': return ">"
        'greater_equal': return ">="
        'logical_and': return "&&"
        _: return "||"
    }
}

func text_converter(value_type: Analysis.SpiteType): Analysis.FunctionInfo? {
    var class_ref = type_shape.as_class_ref(value_type)
    assert class_ref
    assert not class_ref.has_signature
    var described = find_class_by_c_name(class_ref.c_name)
    assert described
    var converter = described.find_function("to_string")
    assert converter
    assert converter.parameters.is_empty()
    return converter
}

func text_of_class(
    value_ast: Syntax.Expressions.Expression,
    value: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var value_type = value.type
    if not text_converter(value_type) {
        return value
    }
    var called = to_string_ast(value_ast)
    return generate_expression(called, scope, class_information)
}

func to_string_ast(value_ast: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(value_ast, "to_string")
    var no_arguments = List<Syntax.Expressions.Expression>()
    return Syntax.Expressions.CallExpression(callee, no_arguments)
}

func made_into_text(value_type: Analysis.SpiteType, expected_type: Analysis.SpiteType): Boolean {
    var wanted = expected_type_without_nullable(expected_type)
    if not type_shape.as_string(wanted) {
        return false
    }
    return type_shape.as_scalar(value_type) or is_enum_type(value_type)
}

func becomes_text(value_type: Analysis.SpiteType, expected_type: Analysis.SpiteType): Boolean {
    var wanted = expected_type_without_nullable(expected_type)
    if not type_shape.as_string(wanted) {
        return false
    }
    if not text_converter(value_type) {
        return false
    }
    return true
}

func generate_string_binary(
    operator: Syntax.Expressions.BinaryOperator,
    left_result: ExpressionResult,
    left_ast: Syntax.Expressions.Expression,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var right_result = generate_joined(right_ast, scope, class_information)
    var right_became_text = false
    if operator == 'add' {
        var right_value_type = right_result.type
        if text_converter(right_value_type) {
            right_became_text = true
        }
        right_result = text_of_class(right_ast, right_result, scope, class_information)
    }
    var right_result_type = right_result.type
    var text_type = Analysis.Types.StringType()
    var right_code_casted = cast(right_result.code, right_result_type, text_type)
    var left_temporary = next_temporary()
    var right_temporary = next_temporary()
    var lines = List<String>()
    lines.append("SpiteString {left_temporary} = {left_result.code};")
    lines.append("SpiteString {right_temporary} = {right_code_casted};")
    var result_type: Analysis.SpiteType = Analysis.Types.StringType()
    var combine = ""
    if operator == 'add' {
        combine = "SpiteString_sum({left_temporary}, SpiteString___retain({right_temporary}))"
    } else {
        result_type = Analysis.Types.ScalarType('boolean_kind')
        combine = text_comparison(operator, left_temporary, right_temporary)
    }
    var result_temporary = next_temporary()
    lines.append("{c_type_name(result_type)} {result_temporary} = {combine};")
    if owns(left_result, left_ast) {
        lines.append("SpiteString___release({left_temporary});")
    }
    var right_was_converted = not type_shape.as_string(right_result_type)
    if owns(right_result, right_ast) or right_was_converted or right_became_text {
        lines.append("SpiteString___release({right_temporary});")
    }
    lines.append("{result_temporary};")
    return ExpressionResult("(\{ {lines.join(" ")} })", result_type)
}

func generate_text_join(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var pieces = List<Syntax.Expressions.Expression>()
    var leftmost = text_join_leftmost(binary, pieces)
    if not shape.as_string_literal(leftmost) {
        var saved_counter = temporary_counter
        var probe = generate_joined(leftmost, scope, class_information)
        rewind_temporaries(saved_counter)
        var probe_text = as_text(probe)
        var probe_type = probe_text.type
        assert type_shape.as_string(probe_type)
    }
    var join = TextJoin()
    var first = generate_joined(leftmost, scope, class_information)
    first = as_text(first)
    var first_owned = owns(first, leftmost)
    var piece_codes = List<String>()
    var pieces_owned = List<Boolean>()
    var checkpoints = List<Integer>()
    piece_codes.append(first.code)
    pieces_owned.append(first_owned)
    note_checkpoint(checkpoints)
    if not resumable_mode {
        add_text_piece(join, first.code, first_owned)
    }
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var piece_result = generate_joined(piece, scope, class_information)
        var piece_value_type = piece_result.type
        var became_text = false
        if text_converter(piece_value_type) {
            became_text = true
        }
        piece_result = text_of_class(piece, piece_result, scope, class_information)
        var piece_type = piece_result.type
        var string_spite_type = string_type()
        var piece_code = cast(piece_result.code, piece_type, string_spite_type)
        var converted = not type_shape.as_string(piece_type)
        var owned = owns(piece_result, piece) or converted or became_text
        piece_codes.append(piece_code)
        pieces_owned.append(owned)
        note_checkpoint(checkpoints)
        if not resumable_mode {
            add_text_piece(join, piece_code, owned)
        }
        index = index + 1
    }
    if resumable_mode {
        keep_pieces_in_order(piece_codes, pieces_owned, checkpoints)
        index = 0
        while index < piece_codes.count() {
            var piece_owned = pieces_owned[index] == true
            add_text_piece(join, piece_codes[index], piece_owned)
            index = index + 1
        }
    }
    flush_constant_text(join)
    var text_type = string_type()
    if join.codes.is_empty() {
        var empty = render_string_literal("")
        return ExpressionResult(empty, text_type)
    }
    if join.codes.count() == 1 and join.views.contains(join.codes[0]) {
        crash join.originals[0]
        return ExpressionResult(join.originals[0], text_type)
    }
    if join.codes.count() == 1 {
        var only = join.codes[0]
        if join.lines.is_empty() or join.released.contains(only) {
            join.lines.append("{only};")
        } else {
            join.lines.append("SpiteString___retain({only});")
        }
        return ExpressionResult("(\{ {join.lines.join(" ")} })", text_type)
    }
    var parts = next_temporary()
    var result = next_temporary()
    join.lines.append("SpiteString {parts}[] = \{{join.codes.join(", ")}};")
    join.lines.append("SpiteString {result} = spite_string_join({join.codes.count()}, {parts});")
    var released_index = 0
    while released_index < join.released.count() {
        join.lines.append("SpiteString___release({join.released[released_index]});")
        released_index = released_index + 1
    }
    join.lines.append("{result};")
    return ExpressionResult("(\{ {join.lines.join(" ")} })", text_type)
}

func note_checkpoint(checkpoints: List<Integer>) {
    var position = builder.user_count()
    checkpoints.append(position)
    var marks_count = wait_mark_counters.count()
    checkpoints.append(marks_count)
    checkpoints.append(temporary_counter)
}

func keep_pieces_in_order(codes: List<String>, owned: List<Boolean>, checkpoints: List<Integer>) {
    var index = codes.count() - 1
    while index >= 0 {
        crash codes[index]
        crash checkpoints[index * 3]
        crash checkpoints[index * 3 + 1]
        crash checkpoints[index * 3 + 2]
        var code = codes[index]
        var waited = waited_since(checkpoints[index * 3 + 1])
        if waited and not stable_code(code) and not constant_texts.has(code) {
            var kept = code
            if owned[index] != true {
                kept = "SpiteString___retain({code})"
                owned[index] = true
            }
            var spilled = next_temporary()
            insert_wait_line(
                checkpoints[index * 3],
                checkpoints[index * 3 + 2],
                "SpiteString {spilled} = {kept};",
                spilled,
            )
            codes[index] = spilled
        }
        index = index - 1
    }
}

func text_join_leftmost(
    binary: Syntax.Expressions.BinaryExpression,
    pieces: List<Syntax.Expressions.Expression>,
): Syntax.Expressions.Expression {
    crash binary.left
    crash binary.right
    var leftmost = binary.left
    var left_binary = shape.as_binary(binary.left)
    if left_binary {
        if left_binary.operator == 'add' {
            leftmost = text_join_leftmost(left_binary, pieces)
        }
    }
    pieces.append(binary.right)
    return leftmost
}

func add_text_piece(join: TextJoin, code: String, owned: Boolean) {
    var digits = digits_of(code)
    if not digits.is_empty() {
        flush_constant_text(join)
        var view = next_temporary()
        var viewed = digits_view(view, digits)
        join.lines.append(viewed)
        join.codes.append(view)
        join.views.append(view)
        join.originals.append(code)
        return
    }
    if constant_texts[code] {
        join.constant = "{join.constant}{constant_texts[code]}"
        return
    }
    flush_constant_text(join)
    var temporary = next_temporary()
    join.lines.append("SpiteString {temporary} = {code};")
    join.codes.append(temporary)
    if owned {
        join.released.append(temporary)
    }
}

func digits_view(view: String, digits: String): String {
    return "char {view}_digits[24]; SpiteString {view} = SPITE_STATIC_STRING({view}_digits, spite_long_digits({view}_digits, (int64_t)({digits})));"
}

func digits_of(code: String): String {
    var names = ["Integer", "Long"]
    var index = 0
    while index < names.count() {
        var name = names[index]
        var value_class = find_class_by_c_name("Spite{name}")
        crash value_class
        var converter = value_class.find_function("to_string")
        crash converter
        var prefix = "{converter.c_name}("
        var written_in = converter.source_path
        if written_in.is_empty() {
            written_in = value_class.source_path
        }
        var file_name = words_of(name).join("_")
        var own_converter = written_in.ends_with("library/{file_name}.spite")
        if own_converter and code.starts_with(prefix) and code.ends_with(")") {
            var prefix_length = prefix.length()
            var code_length = code.length()
            var inner = code.slice(prefix_length, code_length - 1)
            if not balanced_parentheses(inner) {
                return ""
            }
            return inner
        }
        index = index + 1
    }
    return ""
}

func balanced_parentheses(code: String): Boolean {
    var depth = 0
    var index = 0
    while index < code.length() {
        var code_point = code.code_at(index)
        if code_point == 40 {
            depth = depth + 1
        } else if code_point == 41 {
            depth = depth - 1
        }
        if depth < 0 {
            return false
        }
        index = index + 1
    }
    return depth == 0
}

func flush_constant_text(join: TextJoin) {
    assert not join.constant.is_empty()
    var literal = render_string_literal(join.constant)
    join.codes.append(literal)
    join.constant = ""
}

func text_comparison(
    operator: Syntax.Expressions.BinaryOperator,
    left_temporary: String,
    right_temporary: String,
): String {
    switch operator {
        'equal': return "SpiteString_equals({left_temporary}, SpiteString___retain({right_temporary}))"
        'not_equal': return "(!(SpiteString_equals({left_temporary}, SpiteString___retain({right_temporary}))))"
        'less': return "SpiteString_less_than({left_temporary}, SpiteString___retain({right_temporary}))"
        'greater': return "SpiteString_greater_than({left_temporary}, SpiteString___retain({right_temporary}))"
        'less_equal': return "(!(SpiteString_greater_than({left_temporary}, SpiteString___retain({right_temporary}))))"
        _: return "(!(SpiteString_less_than({left_temporary}, SpiteString___retain({right_temporary}))))"
    }
}

func maybe_null_only_on_the_right(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash binary.left
    crash binary.right
    if shape.is_null_literal(binary.right) or is_enum_literal(binary.left) or is_enum_literal(binary.right) {
        return false
    }
    var saved_counter = temporary_counter
    var left_probe = generate_expression(binary.left, scope, class_information)
    var right_probe = generate_expression(binary.right, scope, class_information)
    rewind_temporaries(saved_counter)
    var right_probe_type = right_probe.type
    var left_probe_type = left_probe.type
    return type_shape.as_nullable(right_probe_type) and not type_shape.as_nullable(left_probe_type)
}

func static_class_read(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var read = shape.as_member(expression)
    assert read
    assert read.name == "class"
    crash read.object
    assert is_plain_path(read.object)
    var walked = shape.as_identifier(read.object)
    if walked {
        if walked.name == bound_symbol_name and not bound_symbol_name.is_empty() {
            assert bound_field_type
            assert not type_shape.as_nullable(bound_field_type)
            return class_of_type(bound_field_type)
        }
    }
    var saved_counter = temporary_counter
    var probe = generate_expression(read.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var probe_class = type_shape.as_class_ref(probe_type)
    assert probe_class
    assert not probe_class.has_signature
    var found = find_class_by_c_name(probe_class.c_name)
    assert found
    assert found.c_name != "Spite_Class" and not found.is_generic_template
    return found
}

func is_plain_path(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_identifier(expression) {
        return true
    }
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    return is_plain_path(member.object)
}

func tested_class_of(
    expression: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var tested = resolve_tested_class(expression, class_information)
    assert tested
    var value_type = instance_type_of(tested)
    var boxed_class = boxed_class_of(value_type)
    if boxed_class {
        ensure_box(boxed_class, value_type)
    }
    return tested
}

func resolve_tested_class(
    expression: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var codegen_type = shape.as_generic_identifier(expression)
    if codegen_type {
        return codegen_tested_class(codegen_type.name, class_information)
    }
    var named = shape.as_generic_call(expression)
    if named {
        assert named.names_class
        crash named.callee
        var template = try_resolve_static_path(named.callee, class_information.qualified_dotted)
        assert template
        if not template.is_generic_template {
            report(
                "'{template.simple_name}' takes no codegen values: write '{template.simple_name}' alone to test for it",
            )
            return null
        }
        return instantiate_generic(template, named.type_arguments, class_information.qualified_dotted)
    }
    return try_resolve_static_path(expression, class_information.qualified_dotted)
}

func codegen_tested_class(name: String, class_information: Analysis.ClassInfo): Analysis.ClassInfo? {
    var bare_name = without_dollar(name)
    var bound = codegen_index(class_information, bare_name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    crash class_information.codegen_types[bound]
    return class_of_type(class_information.codegen_types[bound])
}

func codegen_is_class(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): Boolean {
    var codegen_type = shape.as_generic_identifier(expression)
    if not codegen_type {
        return false
    }
    if codegen_tested_class(codegen_type.name, class_information) {
        return true
    }
    return false
}

func class_of_type(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return find_class_by_c_name(class_ref.c_name)
    }
    if type_shape.as_string(spite_type) {
        return find_class_by_c_name("SpiteString")
    }
    var boxed_class = boxed_class_of(spite_type)
    if boxed_class {
        return boxed_class
    }
    return container_class_of(spite_type)
}

func known_codegen_class_test(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    crash binary.left
    crash binary.right
    assert shape.as_generic_identifier(binary.right)
    var tested_class = tested_class_of(binary.right, class_information)
    assert tested_class
    var saved_counter = temporary_counter
    var subject = generate_expression(binary.left, scope, class_information)
    rewind_temporaries(saved_counter)
    var subject_type = subject.type
    var is_nullable = false
    var nullable = type_shape.as_nullable(subject_type)
    if nullable {
        subject_type = nullable.inner
        is_nullable = true
    }
    var known = known_membership(subject_type, tested_class)
    assert known == false or known == true and not is_nullable
    if binary.operator == 'equal' {
        return known == true
    }
    return known == false
}

func known_membership(subject_type: Analysis.SpiteType, tested_class: Analysis.ClassInfo): Boolean? {
    var subject_union = type_shape.as_union(subject_type)
    if subject_union {
        var union_information = find_union_by_c_name(subject_union.c_name)
        assert union_information
        assert not union_information.is_shape
        assert not union_information.has_member(tested_class.c_name)
        return false
    }
    var subject_class = class_of_type(subject_type)
    assert subject_class
    assert subject_class.c_name != "Spite_Class" or tested_class.c_name == "Spite_Class"
    return subject_class.c_name == tested_class.c_name
}

func check_tested_member(information: Analysis.UnionInfo, tested_class: Analysis.ClassInfo) {
    assert not information.has_member(tested_class.c_name)
    if information.is_shape {
        if not specialises_shapes() {
            admit_to_union(information, tested_class)
        }
        return
    }
    report("'{tested_class.simple_name}' is not a member of union '{information.simple_name}', so this is never true")
}

func is_class_object_type(spite_type: Analysis.SpiteType): Boolean {
    var class_ref = type_shape.as_class_ref(spite_type)
    if not class_ref {
        return false
    }
    return class_ref.c_name == "Spite_Class" and not class_ref.has_signature
}

func generate_class_object_comparison(
    binary: Syntax.Expressions.BinaryExpression,
    tested: ExpressionResult,
    tested_class: Analysis.ClassInfo,
    is_nullable: Boolean,
): ExpressionResult {
    crash binary.left
    var temporary = next_temporary()
    var object_temporary = next_temporary()
    var result_temporary = next_temporary()
    var tested_type = tested.type
    var named_type = instance_type_of(tested_class)
    var lines = List<String>()
    lines.append("{c_type_name(tested_type)} {temporary} = {tested.code};")
    lines.append("Spite_Class* {object_temporary} = {class_object_call(named_type)};")
    var test = "({temporary} == {object_temporary})"
    if is_nullable {
        test = "({temporary} != 0 && {test})"
    }
    if binary.operator == 'not_equal' {
        test = "(!{test})"
    }
    lines.append("bool {result_temporary} = {test};")
    lines.append("Spite_Class___release({object_temporary});")
    if owns(tested, binary.left) {
        lines.append("{release_call(tested_type, temporary)};")
    }
    lines.append("{result_temporary};")
    var boolean_spite_type = boolean_type()
    return ExpressionResult("(\{ {lines.join(" ")} })", boolean_spite_type)
}

func class_passed_as_object(
    expression: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var expected = expected_type_without_nullable(expected_type)
    assert is_class_object_type(expected)
    assert not shape.as_call(expression)
    var identifier = shape.as_identifier(expression)
    if identifier {
        assert not scope.lookup_type(identifier.name) and not class_information.find_field(identifier.name)
    }
    return tested_class_of(expression, class_information)
}

# ../../../docs/proofs.md#proving-what-is-proven-is-an-error
func report_decided_class_test(
    binary: Syntax.Expressions.BinaryExpression,
    value_type: Analysis.SpiteType,
    tested_class: Analysis.ClassInfo,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert class_information.codegen_types.is_empty() and bound_symbol_name.is_empty() and not in_specialised_copy
    var class_ref = type_shape.as_class_ref(value_type)
    assert class_ref
    assert class_ref.c_name != "Spite_Class" and tested_class.c_name != "Spite_Class"
    crash binary.left
    var subject = operand_text(binary.left)
    assert not subject.is_empty()
    var value_class = class_of_type(value_type)
    assert value_class
    if value_class.c_name != tested_class.c_name {
        report(
            "'{subject}' is {type_with_article(value_type)} here, so it is never {tested_class.simple_name} and this test is decided while compiling: remove it",
        )
        return
    }
    var site = scope.site_of(subject)
    if site.is_empty() {
        report(
            "'{subject}' is {type_with_article(value_type)} here, so this test is decided while compiling: remove it",
        )
        return
    }
    report("'{subject}' is already {type_with_article(value_type)}, narrowed by {site}: remove this test")
}

func specialised_class_test(
    binary: Syntax.Expressions.BinaryExpression,
    value_type: Analysis.SpiteType,
    tested_class: Analysis.ClassInfo,
): ExpressionResult {
    var boolean_spite_type = boolean_type()
    var reaching = reaching_class_of(value_type)
    var same = false
    if reaching {
        same = reaching.c_name == tested_class.c_name
    }
    if binary.operator == 'not_equal' {
        same = not same
    }
    if same {
        return ExpressionResult("true", boolean_spite_type)
    }
    return ExpressionResult("false", boolean_spite_type)
}

func generate_class_test(
    binary: Syntax.Expressions.BinaryExpression,
    tested_class: Analysis.ClassInfo,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash binary.left
    crash binary.right
    if shape.as_generic_identifier(binary.right) {
        var known = known_codegen_class_test(binary, scope, class_information)
        if known == true or known == false {
            var known_type = boolean_type()
            return ExpressionResult(known == true, known_type)
        }
    }
    var tested = generate_expression(binary.left, scope, class_information)
    var value_type = tested.type
    var is_nullable = false
    var nullable = type_shape.as_nullable(value_type)
    if nullable {
        value_type = nullable.inner
        is_nullable = true
    }
    if is_class_object_type(value_type) and tested_class.c_name != "Spite_Class" {
        return generate_class_object_comparison(binary, tested, tested_class, is_nullable)
    }
    if not is_nullable {
        report_decided_class_test(binary, value_type, tested_class, scope, class_information)
    }
    var tested_union = type_shape.as_union(value_type)
    if tested_union {
        var union_information = find_union_by_c_name(tested_union.c_name)
        if union_information {
            check_tested_member(union_information, tested_class)
        }
    } else if not type_shape.as_class_ref(value_type) {
        if in_specialised_copy and not is_nullable and not owns(tested, binary.left) {
            return specialised_class_test(binary, value_type, tested_class)
        }
        report("'==' with a class asks what class a value is, and {type_with_article(value_type)} is not an object")
        var boolean_spite_type = boolean_type()
        return ExpressionResult("false", boolean_spite_type)
    }
    var temporary = next_temporary()
    var lines = List<String>()
    var tested_type = tested.type
    lines.append("{c_type_name(tested_type)} {temporary} = {tested.code};")
    var test = value_class_test(temporary, tested_type, tested_class)
    if is_nullable {
        var present = present_code(temporary, value_type)
        test = "({present} && {test})"
    }
    if binary.operator == 'not_equal' {
        test = "(!{test})"
    }
    var result_temporary = next_temporary()
    lines.append("bool {result_temporary} = {test};")
    if owns(tested, binary.left) {
        lines.append("{release_call(tested_type, temporary)};")
    }
    lines.append("{result_temporary};")
    var boolean_spite_type = boolean_type()
    return ExpressionResult("(\{ {lines.join(" ")} })", boolean_spite_type)
}

func generate_binary(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var result = generate_unfolded_binary(binary, scope, class_information)
    if item_values_on and (binary.operator == 'equal' or binary.operator == 'not_equal') {
        item_fold(binary, result, scope, class_information)
    }
    return result
}

func studies_item_values(): Boolean {
    if hot_reload or read_evaluate_print_loop or remote_loop_port != 0 or keeps_internals or development {
        return false
    }
    if reload_host {
        return false
    }
    return true
}

# ../../../docs/proofs.md#a-list-only-its-class-fills-holds-only-what-it-fills
func item_fold(
    binary: Syntax.Expressions.BinaryExpression,
    result: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash binary.left
    crash binary.right
    var right_literal = item_literal(binary.right)
    var left_literal = item_literal(binary.left)
    if not right_literal.is_empty() and left_literal.is_empty() {
        item_fold_side(binary, binary.left, right_literal, result, scope, class_information)
    } else if not left_literal.is_empty() and right_literal.is_empty() {
        item_fold_side(binary, binary.right, left_literal, result, scope, class_information)
    }
}

func item_fold_side(
    binary: Syntax.Expressions.BinaryExpression,
    operand: Syntax.Expressions.Expression,
    literal: String,
    result: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert not result.code.contains(item_values.opening)
    var function = item_scope_function(scope)
    var parts = item_term(operand, scope, class_information, function, 0)
    assert not parts.contains("?")
    var operator = "=="
    if binary.operator == 'not_equal' {
        operator = "!="
    }
    var position = item_values.fold_site(parts, operator, literal)
    result.code = "{item_values.opening}{position}*/{result.code}{item_values.closing}"
}

func item_literal(expression: Syntax.Expressions.Expression): String {
    var enum_literal = shape.as_enum_literal(expression)
    if enum_literal {
        return "e:{enum_literal.value}"
    }
    var negated = shape.as_unary(expression)
    if negated {
        crash negated.operand
        if negated.operator != 'negate' or not shape.as_integer_literal(negated.operand) {
            return ""
        }
    } else if not shape.as_integer_literal(expression) {
        return ""
    }
    var value = literal_value(expression)
    crash value
    return "i:{value}"
}

func item_plain(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_enum(spite_type) {
        return true
    }
    var scalar = type_shape.as_scalar(spite_type)
    if not scalar {
        return false
    }
    var whole = [
        'integer_kind'
        'long_kind'
        'tiny_kind'
        'short_kind'
        'byte_kind'
        'unsigned_short_kind'
        'unsigned_integer_kind'
        'unsigned_long_kind'
    ]
    return whole.contains(scalar.kind)
}

func item_scope_function(scope: Scope): Analysis.FunctionInfo? {
    assert item_function and item_function_scope
    assert item_root_scope(scope) == item_function_scope
    return item_function
}

func item_root_scope(scope: Scope): Scope {
    if scope.parent {
        return item_root_scope(scope.parent)
    }
    return scope
}

func item_reflect_type(spite_type: Analysis.SpiteType) {
    var described = class_of_type(spite_type)
    assert described
    item_values.reflect(described.qualified_dotted)
}

func item_note_insert(
    member: Syntax.Expressions.MemberExpression,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert (member.name == "append" or member.name == "prepend" or member.name == "insert") and not arguments.is_empty()
    crash member.object
    var listed = shape.as_identifier(member.object)
    assert listed and not scope.written_type(listed.name)
    assert item_values.listed(class_information.qualified_dotted, listed.name)
    var field = class_information.find_field(listed.name)
    assert field
    var list_type = type_shape.as_list(field.type)
    assert list_type
    var element = list_type.element
    assert item_plain(element)
    var value = arguments.last()
    crash value
    var function = item_scope_function(scope)
    var parts = item_term(value, scope, class_information, function, 0)
    var atom = item_values.items_atom(class_information.c_name, class_information.qualified_dotted, listed.name)
    item_values.note_term(atom, parts)
}

func item_note_call(
    target: Analysis.FunctionInfo,
    owner: Analysis.ClassInfo,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    if arguments.count() != target.parameters.count() {
        item_values.untrust(target.name)
        return
    }
    var function = item_scope_function(scope)
    var index = 0
    while index < arguments.count() {
        crash target.parameters[index]
        var parameter_type = target.parameters[index].type
        if item_plain(parameter_type) {
            var parts = item_term(arguments[index], scope, class_information, function, 0)
            var atom = item_values.parameter_atom(target.c_name, owner.qualified_dotted, target.name, index)
            item_values.note_term(atom, parts)
        }
        index = index + 1
    }
}

func item_term(
    expression: Syntax.Expressions.Expression,
    scope: Scope?,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo?,
    depth: Integer,
): List<String> {
    if depth > 6 {
        return ["?"]
    }
    var literal = item_literal(expression)
    if not literal.is_empty() {
        return [literal]
    }
    var identifier = shape.as_identifier(expression)
    if identifier {
        return item_name_term(identifier.name, scope, information, function, depth)
    }
    var indexed = shape.as_index(expression)
    if indexed {
        return item_index_term(indexed, information, function)
    }
    var call = shape.as_call(expression)
    if call {
        return item_call_term(call, scope, information, function, depth)
    }
    return ["?"]
}

func item_parameter_position(function: Analysis.FunctionInfo, name: String): Integer {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func item_declarations(statements: List<Syntax.Statements.Statement>, name: String): Integer {
    var found = 0
    var index = 0
    while index < statements.count() {
        found = found + item_declared_in(statements[index], name)
        index = index + 1
    }
    return found
}

func item_declared_in(statement: Syntax.Statements.Statement, name: String): Integer {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            if statement.name == name {
                return 1
            }
            return 0
        }
        Syntax.Statements.IfStatement: return item_declarations(statement.then_branch, name) + item_declarations(statement.else_branch, name)
        Syntax.Statements.WhileStatement: return item_declarations(statement.body, name)
        Syntax.Statements.SwitchStatement: {
            var found = 0
            var case_index = 0
            while case_index < statement.cases.count() {
                var switch_case = statement.cases[case_index]
                found = found + item_declarations(switch_case.body, name)
                case_index = case_index + 1
            }
            return found
        }
        _: return 0
    }
}

func item_name_term(
    name: String,
    scope: Scope?,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo?,
    depth: Integer,
): List<String> {
    if not function {
        return ["?"]
    }
    var position = item_parameter_position(function, name)
    var declared = item_declarations(function.body, name)
    if position >= 0 {
        if declared > 0 or assigns_name(function.body, name) {
            return ["?"]
        }
        crash function.parameters[position]
        if not item_plain(function.parameters[position].type) {
            return ["?"]
        }
        return [item_values.parameter_atom(function.c_name, information.qualified_dotted, function.name, position)]
    }
    if declared != 1 {
        return ["?"]
    }
    var key = "{function.c_name}#{name}"
    var cached = item_local_terms[key]
    if cached {
        return cached
    }
    item_local_terms[key] = ["?"]
    var parts = List<String>()
    item_assigned(function.body, name, parts, scope, information, function, depth)
    if parts.contains("?") {
        parts = ["?"]
    }
    item_local_terms[key] = parts
    return parts
}

func item_assigned(
    statements: List<Syntax.Statements.Statement>,
    name: String,
    parts: List<String>,
    scope: Scope?,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    depth: Integer,
) {
    var index = 0
    while index < statements.count() {
        item_assigned_in(statements[index], name, parts, scope, information, function, depth)
        index = index + 1
    }
}

func item_assigned_in(
    statement: Syntax.Statements.Statement,
    name: String,
    parts: List<String>,
    scope: Scope?,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    depth: Integer,
) {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            if statement.name == name {
                crash statement.value
                var declared_parts = item_term(statement.value, scope, information, function, depth + 1)
                item_merge(parts, declared_parts)
            }
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            var target = shape.as_identifier(statement.target)
            if target {
                if target.name == name {
                    crash statement.value
                    var assigned_parts = item_term(statement.value, scope, information, function, depth + 1)
                    item_merge(parts, assigned_parts)
                }
            }
        }
        Syntax.Statements.IfStatement: {
            item_assigned(statement.then_branch, name, parts, scope, information, function, depth)
            item_assigned(statement.else_branch, name, parts, scope, information, function, depth)
        }
        Syntax.Statements.WhileStatement: item_assigned(statement.body, name, parts, scope, information, function, depth)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                var switch_case = statement.cases[case_index]
                item_assigned(switch_case.body, name, parts, scope, information, function, depth)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func item_merge(parts: List<String>, more: List<String>) {
    var index = 0
    while index < more.count() {
        var part = more[index]
        if not parts.contains(part) {
            parts.append(part)
        }
        index = index + 1
    }
}

func item_index_term(
    indexed: Syntax.Expressions.IndexExpression,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo?,
): List<String> {
    crash indexed.object
    var listed = shape.as_identifier(indexed.object)
    if not listed {
        return ["?"]
    }
    if function {
        if item_parameter_position(function, listed.name) >= 0 or item_declarations(function.body, listed.name) > 0 {
            return ["?"]
        }
    }
    var field = information.find_field(listed.name)
    if not field {
        return ["?"]
    }
    var list_type = type_shape.as_list(field.type)
    if not list_type {
        return ["?"]
    }
    var element = list_type.element
    if not item_plain(element) or not item_values.listed(information.qualified_dotted, listed.name) {
        return ["?"]
    }
    return [item_values.items_atom(information.c_name, information.qualified_dotted, listed.name)]
}

func item_call_term(
    call: Syntax.Expressions.CallExpression,
    scope: Scope?,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo?,
    depth: Integer,
): List<String> {
    crash call.callee
    var callee = shape.as_identifier(call.callee)
    if callee {
        if function {
            if item_parameter_position(function, callee.name) >= 0 or item_declarations(function.body, callee.name) > 0 {
                return ["?"]
            }
        }
        var own = information.find_function(callee.name)
        if not own {
            return ["?"]
        }
        return item_returns(own, information, depth + 1)
    }
    var member = shape.as_member(call.callee)
    if not member {
        return ["?"]
    }
    crash member.object
    var receiver = item_receiver_class(member.object, scope, information, function)
    if not receiver {
        return ["?"]
    }
    var target = receiver.find_function(member.name)
    if not target {
        return ["?"]
    }
    return item_returns(target, receiver, depth + 1)
}

func item_receiver_class(
    object: Syntax.Expressions.Expression,
    scope: Scope?,
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo?,
): Analysis.ClassInfo? {
    var named = shape.as_identifier(object)
    assert named
    if function {
        var position = item_parameter_position(function, named.name)
        var declared = item_declarations(function.body, named.name)
        if position >= 0 and declared == 0 {
            crash function.parameters[position]
            return class_of_type(function.parameters[position].type)
        }
        assert position < 0 and declared <= 1
        if declared == 1 {
            assert scope
            var local_type = scope.written_type(named.name)
            assert local_type
            return class_of_type(local_type)
        }
    }
    var field = information.find_field(named.name)
    assert field
    return class_of_type(field.type)
}

func item_returns(target: Analysis.FunctionInfo, owner: Analysis.ClassInfo, depth: Integer): List<String> {
    if depth > 6 or not target.has_body {
        return ["?"]
    }
    var return_type = target.return_type
    if not item_plain(return_type) {
        return ["?"]
    }
    var parts = List<String>()
    item_returned(target.body, owner, target, depth, parts)
    if parts.contains("?") {
        return ["?"]
    }
    return parts
}

func item_returned(
    statements: List<Syntax.Statements.Statement>,
    owner: Analysis.ClassInfo,
    target: Analysis.FunctionInfo,
    depth: Integer,
    parts: List<String>,
) {
    var index = 0
    while index < statements.count() {
        item_returned_from(statements[index], owner, target, depth, parts)
        index = index + 1
    }
}

func item_returned_from(
    statement: Syntax.Statements.Statement,
    owner: Analysis.ClassInfo,
    target: Analysis.FunctionInfo,
    depth: Integer,
    parts: List<String>,
) {
    switch statement {
        Syntax.Statements.ReturnStatement: {
            crash statement.value
            var returned = item_term(statement.value, null, owner, target, depth + 1)
            item_merge(parts, returned)
        }
        Syntax.Statements.AssertStatement: {
            if not statement.is_crash {
                var defaulted = item_default_of(target)
                item_merge(parts, defaulted)
            }
        }
        Syntax.Statements.IfStatement: item_returned_if(statement, owner, target, depth, parts)
        Syntax.Statements.WhileStatement: item_returned(statement.body, owner, target, depth, parts)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                var switch_case = statement.cases[case_index]
                item_returned(switch_case.body, owner, target, depth, parts)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func item_default_of(target: Analysis.FunctionInfo): List<String> {
    var return_type = target.return_type
    if type_shape.as_scalar(return_type) {
        return ["i:0"]
    }
    return ["?"]
}

func item_returned_if(
    statement: Syntax.Statements.IfStatement,
    owner: Analysis.ClassInfo,
    target: Analysis.FunctionInfo,
    depth: Integer,
    parts: List<String>,
) {
    crash statement.condition
    if asks_only_codegen(statement.condition) {
        var unscoped = Scope(null)
        var decided = constant_condition(statement.condition, unscoped, owner)
        if decided == true {
            item_returned(statement.then_branch, owner, target, depth, parts)
            return
        }
        if decided == false {
            item_returned(statement.else_branch, owner, target, depth, parts)
            return
        }
    }
    item_returned(statement.then_branch, owner, target, depth, parts)
    item_returned(statement.else_branch, owner, target, depth, parts)
}

func generate_unfolded_binary(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash binary.left
    crash binary.right
    if binary.operator == 'equal' or binary.operator == 'not_equal' {
        var tested_class = tested_class_of(binary.right, class_information)
        if tested_class {
            if not try_resolve_static_path(binary.left, class_information.qualified_dotted) {
                return generate_class_test(binary, tested_class, scope, class_information)
            }
        }
        var read_class = static_class_read(binary.right, scope, class_information)
        if read_class {
            return generate_class_test(binary, read_class, scope, class_information)
        }
        if maybe_null_only_on_the_right(binary, scope, class_information) {
            var mirrored: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression(
                binary.operator,
                binary.right,
                binary.left,
            )
            return generate_expression(mirrored, scope, class_information)
        }
    }
    if is_enum_literal(binary.left) and not is_enum_literal(binary.right) {
        var swapped_right = generate_expression(binary.right, scope, class_information)
        var swapped_right_type = swapped_right.type
        var swapped_left_code = coerce_for_store(binary.left, swapped_right_type, scope, class_information)
        var swapped_code = "({swapped_left_code} {binary_operator_symbol(binary.operator)} {swapped_right.code})"
        var result_type = Analysis.Types.ScalarType('boolean_kind')
        return ExpressionResult(swapped_code, result_type)
    }
    if binary.operator == 'add' {
        var joined_text = generate_text_join(binary, scope, class_information)
        if joined_text {
            return joined_text
        }
    }
    var operator_name = operator_function_name(binary.operator)
    var left = operand_in_frame(binary.left, operator_name, scope, class_information)
    if not holds_in_order(left) or binary.operator == 'logical_and' or binary.operator == 'logical_or' {
        return binary_after_left(binary, left, operator_name, scope, class_information)
    }
    var held_left = hold_in_order(left, binary.left)
    crash held_left
    var made = binary_after_left(binary, held_left.operand, operator_name, scope, class_information)
    return settle_in_order(held_left, made)
}

func binary_after_left(
    binary: Syntax.Expressions.BinaryExpression,
    left: ExpressionResult,
    operator_name: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash binary.left
    crash binary.right
    var left_type = left.type
    var left_nullable = type_shape.as_nullable(left_type)
    if left_nullable {
        if binary.operator == 'equal' or binary.operator == 'not_equal' {
            var left_nullable_inner = left_nullable.inner
            return generate_nullable_equality(
                binary,
                left,
                left_nullable_inner,
                binary.left,
                binary.right,
                scope,
                class_information,
            )
        }
        if binary.operator != 'logical_and' and binary.operator != 'logical_or' {
            var shown_left_type = type_with_article(left_type)
            report(
                "{null_opening(left.code, shown_left_type)}, so '{binary_operator_symbol(binary.operator)}' cannot use it yet: {null_advice(left.code)}",
            )
            return void_result()
        }
    }
    left = as_text(left)
    left_type = left.type
    if type_shape.as_string(left_type) {
        return generate_string_binary(binary.operator, left, binary.left, binary.right, scope, class_information)
    }
    var left_shape_name = operated_shape_name(binary.operator, left_type, class_information)
    if not left_shape_name.is_empty() {
        if operates_through_shape(binary.operator, left_type) {
            return shape_operator(binary, left, scope, class_information)
        }
        report(
            "'{binary_operator_symbol(binary.operator)}' on a value read as '{left_shape_name}' needs the class that fits the type, which is not known while compiling: take the value through a codegen value the type constrains, 'generic $value_type: {left_shape_name}'",
        )
        return void_result()
    }
    var left_class_ref = type_shape.as_class_ref(left_type)
    if left_class_ref {
        var left_class = find_class_by_c_name(left_class_ref.c_name)
        if left_class {
            return generate_class_binary(
                binary.operator,
                left_class,
                left,
                binary.left,
                binary.right,
                scope,
                class_information,
            )
        }
    }
    if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
        var right_scope = Scope(scope)
        if binary.operator == 'logical_and' {
            narrow_proven_indices(binary.left, right_scope, class_information)
        }
        var right_position = builder.user_count()
        var right_marks = wait_mark_counters.count()
        var right_counter = temporary_counter
        var waits_in_place = not resumable_mode or conditional_depth != 0
        if waits_in_place {
            conditional_depth = conditional_depth + 1
        }
        var other = generate_joined(binary.right, right_scope, class_information)
        if waits_in_place {
            conditional_depth = conditional_depth - 1
        }
        report_maybe_boolean(left, "'{binary_operator_symbol(binary.operator)}'")
        report_maybe_boolean(other, "'{binary_operator_symbol(binary.operator)}'")
        if waited_since(right_marks) {
            var decided = next_temporary()
            var opening = List<String>()
            opening.append("bool {decided} = {owned_truth(left, binary.left)};")
            if binary.operator == 'logical_and' {
                opening.append("if ({decided}) \{")
            } else {
                opening.append("if (!{decided}) \{")
            }
            var closing = List<String>()
            closing.append("{decided} = {owned_truth(other, binary.right)};")
            closing.append("}")
            wrap_waits(right_position, right_marks, right_counter, opening, closing, decided)
            var decided_type = Analysis.Types.ScalarType('boolean_kind')
            return ExpressionResult(decided, decided_type)
        }
        var joined = "({owned_truth(left, binary.left)} {binary_operator_symbol(binary.operator)} {owned_truth(other, binary.right)})"
        var result_type = Analysis.Types.ScalarType('boolean_kind')
        return ExpressionResult(joined, result_type)
    }
    var right_code = ""
    var left_code = left.code
    var right_type = left_type
    var held = List<String>()
    var releases = List<String>()
    var comparing = is_boolean_result_operator(binary.operator)
    if comparing and owns(left, binary.left) and type_needs_drop(left_type) {
        var left_held = next_temporary()
        held.append("{c_type_name(left_type)} {left_held} = {left.code};")
        releases.append("{release_call(left_type, left_held)};")
        left_code = left_held
    }
    if is_enum_literal(binary.right) and is_enum_type(left_type) {
        right_code = coerce_for_store(binary.right, left_type, scope, class_information)
    } else {
        var right = generate_joined(binary.right, scope, class_information)
        right_type = right.type
        var right_value = right.code
        if comparing and owns(right, binary.right) and type_needs_drop(right_type) {
            var right_held = next_temporary()
            held.append("{c_type_name(right_type)} {right_held} = {right.code};")
            releases.append("{release_call(right_type, right_held)};")
            right_value = right_held
        }
        right_code = right_operand_code(binary, right_value, left_type, right_type)
        if not is_boolean_result_operator(binary.operator) and is_wider_right(binary, left_type, right_type) {
            report_wider_right(binary, left_type, right_type)
        }
        if is_boolean_result_operator(binary.operator) and is_wider_right(binary, left_type, right_type) {
            report_wider_comparison(binary, left_type, right_type)
        }
        report_constant_overflow(binary)
        if is_single_precision(left_type) and is_single_precision(right_type) {
            if is_decimal_literal(binary.right) and not is_decimal_literal(binary.left) {
                right_code = single_precision_literal(right_code)
            }
            if is_decimal_literal(binary.left) and not is_decimal_literal(binary.right) {
                left_code = single_precision_literal(left_code)
            }
        }
    }
    var symbol = binary_operator_symbol(binary.operator)
    var code = "({left_code} {symbol} {right_code})"
    var checked = checked_division(binary, left_code, right_code, left_type, scope)
    if not checked.is_empty() {
        code = checked
    }
    var guarded = checked_overflow(binary, left_code, right_code, left_type, right_type, scope, class_information)
    if not guarded.is_empty() {
        code = guarded
    }
    var decimal_remainder = decimal_remainder_macro(binary.operator, left_type)
    if not decimal_remainder.is_empty() {
        code = "{decimal_remainder}({left_code}, {right_code})"
    }
    if comparing {
        if not held.is_empty() {
            code = "(\{ {held.join(" ")} bool spite_same = {code}; {releases.join(" ")} spite_same; })"
        }
        var result_type = Analysis.Types.ScalarType('boolean_kind')
        return ExpressionResult(code, result_type)
    }
    return ExpressionResult(code, left_type)
}

func is_single_precision(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    if not scalar {
        return false
    }
    return scalar.kind == 'float_kind'
}

func is_decimal_literal(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_float_literal(expression) {
        return true
    }
    var unary = shape.as_unary(expression)
    if not unary {
        return false
    }
    if unary.operator != 'negate' {
        return false
    }
    crash unary.operand
    if shape.as_float_literal(unary.operand) {
        return true
    }
    return false
}

func single_precision_literal(code: String): String {
    var length = code.length()
    var end = length
    while end > 0 and code.code_at(end - 1) == 41 {
        end = end - 1
    }
    if end == 0 {
        return code
    }
    var last = code.code_at(end - 1)
    if last < 48 or last > 57 {
        return code
    }
    var digits = code.slice(0, end)
    var closing = code.slice(end, length)
    return "{digits}f{closing}"
}

func right_operand_code(
    binary: Syntax.Expressions.BinaryExpression,
    right_value: String,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
): String {
    if is_wider_right(binary, left_type, right_type) and type_shape.as_scalar(right_type) {
        return "(({c_type_name(left_type)})({right_value}))"
    }
    return cast(right_value, right_type, left_type)
}

func checked_division(
    binary: Syntax.Expressions.BinaryExpression,
    left_code: String,
    right_code: String,
    left_type: Analysis.SpiteType,
    scope: Scope,
): String {
    if binary.operator != 'divide' and binary.operator != 'modulo' {
        return ""
    }
    var scalar = type_shape.as_scalar(left_type)
    if not scalar {
        return ""
    }
    if scalar.kind == 'boolean_kind' or is_float_kind(scalar.kind) {
        return ""
    }
    crash binary.right
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = binary
    var written = printer.source_expression(expression)
    var constant = constant_integer(binary.right)
    if constant == 0 or right_code == "0" {
        report(
            "'{written}' divides by zero, which always halts the program: a whole number cannot be divided by zero, so divide by something else, or leave the step out",
        )
        return ""
    }
    var signed = is_signed_kind(scalar.kind)
    var nonzero = false
    if constant {
        if constant != -1 or not signed {
            return ""
        }
        nonzero = true
    }
    var divisor_text = operand_text(binary.right)
    if not divisor_text.is_empty() and scope.is_path_narrowed("~[{divisor_text}]") {
        nonzero = true
    }
    if nonzero and not signed {
        return ""
    }
    var c_type = c_type_name(left_type)
    var dividend = next_temporary()
    var divisor = next_temporary()
    var where = located(current_path, current_line, current_owner, current_function)
    var operation = escape_c_string(written)
    var computed = "{dividend} {binary_operator_symbol(binary.operator)} {divisor}"
    var negated = next_temporary()
    var halted = ""
    if signed and binary.operator == 'divide' {
        ensure_overflow_check()
        var divided_display = type_display_name(left_type)
        var divided_name = with_article(divided_display)
        computed = "{divisor} == -1 ? {negated} : {dividend} / {divisor}"
        halted = "{c_type} {negated} = 0; if (__builtin_expect({divisor} == -1 && __builtin_sub_overflow(({c_type})0, {dividend}, &{negated}), 0)) spite_overflowed(\"{operation}\", \"{divided_name}\", \"/\", (int64_t){dividend}, (int64_t){divisor}, {where}); "
    }
    if signed and binary.operator == 'modulo' {
        computed = "{divisor} == -1 ? ({c_type})0 : {dividend} % {divisor}"
    }
    var zero = ""
    if not nonzero {
        ensure_division_check()
        zero = "if ({divisor} == 0) spite_divided_by_zero(\"{operation}\", {where}); "
    }
    return "(\{ {c_type} {dividend} = {left_code}; {c_type} {divisor} = {right_code}; {zero}{halted}({c_type})({computed}); })"
}

func checked_overflow(
    binary: Syntax.Expressions.BinaryExpression,
    left_code: String,
    right_code: String,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if binary.operator != 'add' and binary.operator != 'subtract' and binary.operator != 'multiply' {
        return ""
    }
    if proven_to_fit(binary, scope) {
        return ""
    }
    var scalar = type_shape.as_scalar(left_type)
    if not scalar {
        return ""
    }
    if not is_checked_whole_kind(scalar.kind) {
        return ""
    }
    var refusal = range_refusal(binary, left_type, right_type, scope, class_information)
    if refusal.is_empty() {
        return ""
    }
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = binary
    var written = printer.source_expression(expression)
    optimization_report.overflow_check_kept(current_function_c_name, current_path, current_line, written, refusal)
    var failure = overflow_failure(scalar.kind)
    var c_type = c_type_name(left_type)
    var left_value = next_temporary()
    var right_value = next_temporary()
    var result = next_temporary()
    var where = located(current_path, current_line, current_owner, current_function)
    var operation = escape_c_string(written)
    var type_name = type_display_name(left_type)
    var builtin = overflow_builtin(binary.operator)
    var shown = operand_cast(scalar.kind)
    return "(\{ {c_type} {left_value} = {left_code}; {c_type} {right_value} = {right_code}; {c_type} {result}; if (__builtin_expect({builtin}({left_value}, {right_value}, &{result}), 0)) {failure}(\"{operation}\", \"{with_article(type_name)}\", \"{binary_operator_symbol(binary.operator)}\", {shown}{left_value}, {shown}{right_value}, {where}); {result}; })"
}

func proven_to_fit(binary: Syntax.Expressions.BinaryExpression, scope: Scope): Boolean {
    crash binary.left
    crash binary.right
    if constant_integer(binary.left) and constant_integer(binary.right) {
        return true
    }
    var step = shape.as_integer_literal(binary.right)
    var counter = shape.as_identifier(binary.left)
    if not step or not counter {
        return false
    }
    if step.value != 1 {
        return false
    }
    if binary.operator == 'add' {
        return scope.holds_room("~+[{counter.name}]")
    }
    if binary.operator != 'subtract' {
        return false
    }
    return scope.holds_room("~-[{counter.name}]")
}

# ../../../docs/proofs.md#a-range-proves-arithmetic-fits
func ranges_proven(): Boolean {
    return not hot_reload and not read_evaluate_print_loop and remote_loop_port == 0
}

func range_refusal(
    binary: Syntax.Expressions.BinaryExpression,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if not ranges_proven() {
        return "a --repl, --repl-port or --hot-reload build proves no ranges, since code may run between two steps"
    }
    var scalar = whole_kind_of(left_type)
    crash scalar
    crash binary.left
    crash binary.right
    var printer = Syntax.SourcePrinter()
    var left_text = printer.source_expression(binary.left)
    var right_text = printer.source_expression(binary.right)
    var type_name = type_display_name(left_type)
    var shown_type = with_article(type_name)
    var left = operand_range(binary.left, left_type, scalar.kind, scope, class_information)
    if not left {
        return "'{left_text}' can be any value {shown_type} holds, and nothing proves a smaller range for it"
    }
    var right = operand_range(binary.right, right_type, scalar.kind, scope, class_information)
    if not right {
        return "'{right_text}' can be any value {shown_type} holds, and nothing proves a smaller range for it"
    }
    var answer = combined_range(binary.operator, left, right)
    if answer and fits_kind(answer, scalar.kind) {
        return ""
    }
    var described = List<String>()
    describe_operand(left_text, left, described)
    describe_operand(right_text, right, described)
    var operands = described.join(" and ")
    return "{operands}, so the answer may not fit in {shown_type}"
}

func describe_operand(text: String, range: NumberRange, described: List<String>) {
    var value: String = range.lowest
    if range.lowest != range.highest {
        described.append("'{text}' runs from {range.lowest} to {range.highest}")
    } else if text != value {
        described.append("'{text}' is {value}")
    }
}

func negation_refusal(
    operand: Syntax.Expressions.Expression,
    operand_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if not ranges_proven() {
        return "a --repl, --repl-port or --hot-reload build proves no ranges, since code may run between two steps"
    }
    var scalar = whole_kind_of(operand_type)
    crash scalar
    var printer = Syntax.SourcePrinter()
    var negated_text = printer.source_expression(operand)
    var type_name = type_display_name(operand_type)
    var shown_type = with_article(type_name)
    var known = operand_range(operand, operand_type, scalar.kind, scope, class_information)
    if not known {
        return "'{negated_text}' can be any value {shown_type} holds, and nothing proves a smaller range for it"
    }
    var negated = known.negated()
    if fits_kind(negated, scalar.kind) {
        return ""
    }
    return "'{negated_text}' runs from {known.lowest} to {known.highest}, so its negation may not fit in {shown_type}"
}

func operand_range(
    expression: Syntax.Expressions.Expression,
    actual_type: Analysis.SpiteType,
    kind: Analysis.Types.NumericKind,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    var known = value_range(expression, scope, class_information)
    if not known {
        var actual = whole_kind_of(actual_type)
        assert actual
        known = kind_range(actual.kind)
    }
    assert known
    if fits_kind(known, kind) {
        return known
    }
    return kind_range(kind)
}

func combined_range(operator: Syntax.Expressions.BinaryOperator, left: NumberRange, right: NumberRange): NumberRange? {
    if operator == 'add' {
        return left.plus(right)
    }
    if operator == 'subtract' {
        return left.minus(right)
    }
    assert operator == 'multiply'
    return left.times(right)
}

func kind_range(kind: Analysis.Types.NumericKind): NumberRange? {
    assert is_checked_whole_kind(kind) and kind != 'long_kind' and kind != 'unsigned_long_kind'
    var lowest = kind_lowest(kind)
    var highest = kind_highest(kind)
    return NumberRange(lowest, highest)
}

func fits_kind(range: NumberRange, kind: Analysis.Types.NumericKind): Boolean {
    if kind == 'long_kind' {
        return true
    }
    if kind == 'unsigned_long_kind' {
        return range.lowest >= 0
    }
    var lowest = kind_lowest(kind)
    var highest = kind_highest(kind)
    return range.within(lowest, highest)
}

func whole_kind_of(spite_type: Analysis.SpiteType?): Analysis.Types.ScalarType? {
    assert spite_type
    var scalar = type_shape.as_scalar(spite_type)
    assert scalar
    assert is_checked_whole_kind(scalar.kind)
    return scalar
}

func is_ranged_local(name: String, scope: Scope): Boolean {
    if name == "self" or name == "this" {
        return false
    }
    if reflected_binding(name) {
        return false
    }
    var declared = scope.unnarrowed_type(name)
    if not declared {
        return false
    }
    if not whole_kind_of(declared) {
        return false
    }
    return true
}

func value_range(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    var spite_type = range_type_of(expression, scope, class_information)
    var scalar = whole_kind_of(spite_type)
    assert scalar
    var computed = computed_range(expression, scalar.kind, scope, class_information)
    if computed and fits_kind(computed, scalar.kind) {
        return computed
    }
    return kind_range(scalar.kind)
}

func computed_range(
    expression: Syntax.Expressions.Expression,
    kind: Analysis.Types.NumericKind,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    var literal = shape.as_integer_literal(expression)
    if literal {
        var exact = NumberRange(literal.value, literal.value)
        return exact.bounded(literal.value, literal.value)
    }
    var identifier = shape.as_identifier(expression)
    if identifier {
        assert is_ranged_local(identifier.name, scope)
        return scope.range_of(identifier.name)
    }
    var unary = shape.as_unary(expression)
    if unary {
        assert unary.operator == 'negate' and unary.operand
        var negated = value_range(unary.operand, scope, class_information)
        assert negated
        return negated.negated()
    }
    var binary = shape.as_binary(expression)
    if binary {
        assert binary.left and binary.right
        return binary_range(binary.operator, binary.left, binary.right, kind, scope, class_information)
    }
    var call = shape.as_call(expression)
    assert call
    assert call.callee
    var called = shape.as_member(call.callee)
    assert called
    assert called.object
    return call_range(called.name, called.object, call.arguments, kind, scope, class_information)
}

func binary_range(
    operator: Syntax.Expressions.BinaryOperator,
    left_expression: Syntax.Expressions.Expression,
    right_expression: Syntax.Expressions.Expression,
    kind: Analysis.Types.NumericKind,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    var left = fitted_range(left_expression, kind, scope, class_information)
    var right = fitted_range(right_expression, kind, scope, class_information)
    if operator == 'modulo' {
        if left {
            return left.remainder_by(right)
        }
        assert right
        var below = right.largest_magnitude() - 1
        if below < 0 {
            below = 0
        }
        var upper = NumberRange(0, below)
        var lower = upper.negated()
        return upper.joined(lower)
    }
    assert left
    if operator == 'divide' {
        return left.divided_by(right)
    }
    assert right
    assert operator == 'add' or operator == 'subtract' or operator == 'multiply'
    return combined_range(operator, left, right)
}

func fitted_range(
    expression: Syntax.Expressions.Expression,
    kind: Analysis.Types.NumericKind,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    var known = value_range(expression, scope, class_information)
    assert known
    if fits_kind(known, kind) {
        return known
    }
    return kind_range(kind)
}

func call_range(
    name: String,
    receiver: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    kind: Analysis.Types.NumericKind,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    if name == "count" or name == "length" {
        return NumberRange(0, 2147483647)
    }
    if name == "to_long" or name == "to_integer" {
        return value_range(receiver, scope, class_information)
    }
    var value = fitted_range(receiver, kind, scope, class_information)
    if name == "absolute" {
        assert value
        assert value.lowest > kind_lowest(kind) or not is_signed_kind(kind)
        var largest = value.largest_magnitude()
        var flipped = value.negated()
        var zero = NumberRange(0, 0)
        var spread = zero.joined(value)
        var both = spread.joined(flipped)
        return both.narrowed(0, largest)
    }
    var first = arguments.first()
    assert first
    var other = fitted_range(first, kind, scope, class_information)
    if name == "minimum" {
        assert value and other
        var smaller_low = value.lowest.minimum(other.lowest)
        var smaller_high = value.highest.minimum(other.highest)
        return NumberRange(smaller_low, smaller_high)
    }
    if name == "maximum" {
        assert value and other
        var larger_low = value.lowest.maximum(other.lowest)
        var larger_high = value.highest.maximum(other.highest)
        return NumberRange(larger_low, larger_high)
    }
    assert name == "clamp" and other
    var last = arguments.last()
    assert last
    var high = fitted_range(last, kind, scope, class_information)
    assert high
    var clamped_low = other.lowest.minimum(high.lowest)
    return NumberRange(clamped_low, high.highest)
}

func range_type_of(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var literal = shape.as_integer_literal(expression)
    if literal {
        if literal.value >= -2147483648 and literal.value <= 2147483647 {
            return integer_type()
        }
        return long_type()
    }
    var identifier = shape.as_identifier(expression)
    if identifier {
        return named_value_type(identifier.name, scope, class_information)
    }
    var unary = shape.as_unary(expression)
    if unary {
        assert unary.operator == 'negate' and unary.operand
        return range_type_of(unary.operand, scope, class_information)
    }
    var binary = shape.as_binary(expression)
    if binary {
        assert binary.left
        var arithmetic = binary.operator == 'add' or binary.operator == 'subtract' or binary.operator == 'multiply'
        assert arithmetic or binary.operator == 'divide' or binary.operator == 'modulo'
        return range_type_of(binary.left, scope, class_information)
    }
    var member = shape.as_member(expression)
    if member {
        assert member.object
        var owner_type = range_type_of(member.object, scope, class_information)
        assert owner_type
        return attribute_type_of(owner_type, member.name)
    }
    var index = shape.as_index(expression)
    if index {
        assert index.object
        var listed_type = range_type_of(index.object, scope, class_information)
        assert listed_type
        var listed = type_shape.as_list(listed_type)
        assert listed
        return listed.element
    }
    var call = shape.as_call(expression)
    assert call
    assert call.callee
    var called = shape.as_member(call.callee)
    assert called
    assert called.object
    var receiver_type = range_type_of(called.object, scope, class_information)
    assert receiver_type
    return called_range_type(called.name, receiver_type, call.arguments)
}

func called_range_type(
    name: String,
    receiver_type: Analysis.SpiteType,
    arguments: List<Syntax.Expressions.Expression>,
): Analysis.SpiteType? {
    if name == "count" and arguments.is_empty() {
        if type_shape.as_list(receiver_type) or type_shape.as_dictionary(receiver_type) {
            return integer_type()
        }
        assert vector_class_of(receiver_type)
        return integer_type()
    }
    if name == "length" and arguments.is_empty() {
        assert type_shape.as_string(receiver_type)
        return integer_type()
    }
    assert whole_kind_of(receiver_type)
    if name == "to_long" and arguments.is_empty() {
        return long_type()
    }
    if name == "to_integer" and arguments.is_empty() {
        return integer_type()
    }
    var takes = 0
    if name == "minimum" or name == "maximum" {
        takes = 1
    } else if name == "clamp" {
        takes = 2
    } else {
        assert name == "absolute"
    }
    assert arguments.count() == takes
    return receiver_type
}

func named_value_type(name: String, scope: Scope, class_information: Analysis.ClassInfo): Analysis.SpiteType? {
    assert not reflected_binding(name)
    if name == "self" {
        var self_type: Analysis.SpiteType = Analysis.Types.ClassRefType(class_information.c_name)
        return self_type
    }
    var local_type = scope.written_type(name)
    if local_type {
        return local_type
    }
    var field = class_information.find_field(name)
    assert field
    return field.type
}

func attribute_type_of(owner_type: Analysis.SpiteType, name: String): Analysis.SpiteType? {
    var owner_reference = type_shape.as_class_ref(owner_type)
    assert owner_reference
    var owner = find_class_by_c_name(owner_reference.c_name)
    assert owner
    var field = owner.find_field(name)
    assert field
    return field.type
}

func narrow_ranges(binary: Syntax.Expressions.BinaryExpression, scope: Scope, class_information: Analysis.ClassInfo) {
    assert ranges_proven()
    crash binary.left
    crash binary.right
    narrow_side(binary.left, binary.operator, binary.right, binary.left, scope, class_information)
    var mirrored = mirrored_comparison(binary.operator)
    narrow_side(binary.right, mirrored, binary.left, binary.left, scope, class_information)
}

func mirrored_comparison(operator: Syntax.Expressions.BinaryOperator): Syntax.Expressions.BinaryOperator {
    switch operator {
        'less': return 'greater'
        'less_equal': return 'greater_equal'
        'greater': return 'less'
        'greater_equal': return 'less_equal'
        _: return operator
    }
}

func narrow_side(
    named_expression: Syntax.Expressions.Expression,
    operator: Syntax.Expressions.BinaryOperator,
    bound_expression: Syntax.Expressions.Expression,
    compared_expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var named = shape.as_identifier(named_expression)
    assert named
    assert is_ranged_local(named.name, scope)
    var compared_type = range_type_of(compared_expression, scope, class_information)
    var compared = whole_kind_of(compared_type)
    assert compared
    var current = value_range(named_expression, scope, class_information)
    assert current
    assert fits_kind(current, compared.kind)
    var bound = fitted_range(bound_expression, compared.kind, scope, class_information)
    assert bound
    var lowest = current.lowest
    var highest = current.highest
    if operator == 'less' {
        highest = bound.highest - 1
    } else if operator == 'less_equal' {
        highest = bound.highest
    } else if operator == 'greater' {
        lowest = bound.lowest + 1
    } else if operator == 'greater_equal' {
        lowest = bound.lowest
    } else {
        assert operator == 'equal'
        lowest = bound.lowest
        highest = bound.highest
    }
    var narrowed = current.narrowed(lowest, highest)
    scope.set_range(named.name, narrowed)
}

func declare_range(declaration: Syntax.Statements.VariableDeclaration, start: NumberRange?, scope: Scope) {
    if not is_ranged_local(declaration.name, scope) {
        scope.set_range(declaration.name, null)
        return
    }
    var declared_type = scope.unnarrowed_type(declaration.name)
    var declared = whole_kind_of(declared_type)
    crash declared
    if start and fits_kind(start, declared.kind) {
        scope.set_range(declaration.name, start)
        return
    }
    var limits = kind_range(declared.kind)
    scope.set_range(declaration.name, limits)
}

func ranged_target(assignment: Syntax.Statements.AssignmentStatement, scope: Scope): String {
    if not ranges_proven() {
        return ""
    }
    crash assignment.target
    var named = shape.as_identifier(assignment.target)
    if not named {
        return ""
    }
    if not is_ranged_local(named.name, scope) {
        return ""
    }
    return named.name
}

func assigned_range(
    name: String,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    var declared_type = scope.unnarrowed_type(name)
    var declared = whole_kind_of(declared_type)
    crash declared
    var reached = value_range(value, scope, class_information)
    if reached and fits_kind(reached, declared.kind) {
        return reached
    }
    return kind_range(declared.kind)
}

func prepare_sum(
    name: String,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var loop = scope.innermost_loop()
    assert loop
    assert loop.loop_ranges
    assert loop.loop_ranges.passes_known
    var passes = loop.loop_ranges.most_passes
    var start = loop.loop_ranges.start_of_sum(name)
    assert start
    var declared_type = scope.unnarrowed_type(name)
    var declared = whole_kind_of(declared_type)
    crash declared
    var terms = summed_terms(value, name, declared.kind, scope, class_information)
    assert terms
    var earlier = passes - 1
    if earlier < 0 {
        earlier = 0
    }
    var repeats = NumberRange(0, earlier)
    var added = repeats.times(terms)
    assert added
    var reached = start.plus(added)
    assert reached
    scope.set_range(name, reached)
}

func summed_terms(
    value: Syntax.Expressions.Expression,
    name: String,
    kind: Analysis.Types.NumericKind,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    if is_identifier_named(value, name) {
        return NumberRange(0, 0)
    }
    var binary = shape.as_binary(value)
    assert binary
    assert binary.left and binary.right
    assert binary.operator == 'add' or binary.operator == 'subtract'
    var before = summed_terms(binary.left, name, kind, scope, class_information)
    assert before
    var term = fitted_range(binary.right, kind, scope, class_information)
    assert term
    if binary.operator == 'add' {
        return before.plus(term)
    }
    return before.minus(term)
}

func is_sum_of(value: Syntax.Expressions.Expression, name: String): Boolean {
    if is_identifier_named(value, name) {
        return true
    }
    var binary = shape.as_binary(value)
    if not binary {
        return false
    }
    if binary.operator != 'add' and binary.operator != 'subtract' {
        return false
    }
    crash binary.left
    crash binary.right
    var mentioned = List<String>()
    collect_mentioned_names(binary.right, mentioned)
    if mentioned.contains(name) {
        return false
    }
    return is_sum_of(binary.left, name)
}

func enter_loop_ranges(
    while_statement: Syntax.Statements.WhileStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    scope.entered_loop = null
    assert ranges_proven()
    crash while_statement.condition
    var writes = List<LoopWrite>()
    var declared = List<String>()
    collect_loop_writes(while_statement.body, writes, declared, false, true, scope)
    var names = List<String>()
    var index = 0
    while index < writes.count() {
        var write = writes[index]
        if not names.contains(write.target) {
            names.append(write.target)
        }
        index = index + 1
    }
    var hidden = names.copy()
    var declared_index = 0
    while declared_index < declared.count() {
        var declared_name = declared[declared_index]
        if is_ranged_local(declared_name, scope) and not hidden.contains(declared_name) {
            hidden.append(declared_name)
        }
        declared_index = declared_index + 1
    }
    var starts = Scope(null)
    var hidden_index = 0
    while hidden_index < hidden.count() {
        var hidden_name = hidden[hidden_index]
        var seen = scope.range_of(hidden_name)
        starts.set_range(hidden_name, seen)
        scope.set_range(hidden_name, null)
        hidden_index = hidden_index + 1
    }
    var ranges = LoopRanges()
    var heads = Scope(null)
    var name_index = 0
    while name_index < names.count() {
        var name = names[name_index]
        var own = writes_named(name, writes)
        var start = starts.range_of(name)
        var head: NumberRange? = null
        if not declared.contains(name) {
            head = loop_head_range(name, own, start, declared, while_statement.condition, scope, class_information)
            note_sum(name, own, start, ranges)
            note_passes(name, own, start, while_statement.condition, scope, class_information, ranges)
        }
        heads.set_range(name, head)
        name_index = name_index + 1
    }
    var restore_index = 0
    while restore_index < hidden.count() {
        var restored = hidden[restore_index]
        if names.contains(restored) {
            var head_range = heads.range_of(restored)
            scope.assign_range(restored, head_range)
        } else {
            var start_range = starts.range_of(restored)
            scope.set_range(restored, start_range)
        }
        restore_index = restore_index + 1
    }
    scope.entered_loop = ranges
}

func start_loop_body(body_scope: Scope) {
    assert body_scope.parent
    body_scope.loop_ranges = body_scope.parent.entered_loop
}

func collect_loop_writes(
    statements: List<Syntax.Statements.Statement>,
    writes: List<LoopWrite>,
    declared: List<String>,
    in_inner_loop: Boolean,
    in_body: Boolean,
    scope: Scope,
) {
    var index = 0
    while index < statements.count() {
        collect_statement_writes(statements[index], writes, declared, in_inner_loop, in_body, scope)
        index = index + 1
    }
}

func collect_statement_writes(
    statement: Syntax.Statements.Statement,
    writes: List<LoopWrite>,
    declared: List<String>,
    in_inner_loop: Boolean,
    in_body: Boolean,
    scope: Scope,
) {
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var target = shape.as_identifier(statement.target)
            if target and is_ranged_local(target.name, scope) {
                var write = LoopWrite(target.name, statement.value, in_inner_loop, in_body)
                writes.append(write)
            }
        }
        Syntax.Statements.VariableDeclaration: {
            if not declared.contains(statement.name) {
                declared.append(statement.name)
            }
        }
        Syntax.Statements.IfStatement: {
            collect_loop_writes(statement.then_branch, writes, declared, in_inner_loop, false, scope)
            collect_loop_writes(statement.else_branch, writes, declared, in_inner_loop, false, scope)
        }
        Syntax.Statements.WhileStatement: collect_loop_writes(statement.body, writes, declared, true, false, scope)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                var each_case = statement.cases[case_index]
                collect_loop_writes(each_case.body, writes, declared, in_inner_loop, false, scope)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func writes_named(name: String, writes: List<LoopWrite>): List<LoopWrite> {
    var own = List<LoopWrite>()
    var index = 0
    while index < writes.count() {
        var write = writes[index]
        if write.target == name {
            own.append(write)
        }
        index = index + 1
    }
    return own
}

func counter_steps(name: String, own: List<LoopWrite>, upward: Boolean): Long {
    var steps: Long = 0
    var index = 0
    while index < own.count() {
        var write = own[index]
        crash write.value
        var step = counter_step(name, write.value, upward)
        if step < 0 {
            return -1
        }
        steps = steps + step
        index = index + 1
    }
    return steps
}

func counter_step(name: String, value: Syntax.Expressions.Expression, upward: Boolean): Long {
    var binary = shape.as_binary(value)
    if not binary {
        return -1
    }
    crash binary.left
    crash binary.right
    var wanted: Syntax.Expressions.BinaryOperator = 'subtract'
    if upward {
        wanted = 'add'
    }
    if binary.operator != wanted or not is_identifier_named(binary.left, name) {
        return -1
    }
    var step = shape.as_integer_literal(binary.right)
    if not step {
        return -1
    }
    if step.value < 0 or step.value > 2147483647 {
        return -1
    }
    return step.value
}

func mentions_any(expression: Syntax.Expressions.Expression, names: List<String>): Boolean {
    var mentioned = List<String>()
    collect_mentioned_names(expression, mentioned)
    var index = 0
    while index < mentioned.count() {
        if names.contains(mentioned[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func loop_head_range(
    name: String,
    own: List<LoopWrite>,
    start: NumberRange?,
    declared: List<String>,
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NumberRange? {
    assert start
    var kind_type = scope.unnarrowed_type(name)
    var kind = whole_kind_of(kind_type)
    crash kind
    var up = counter_steps(name, own, true)
    if up >= 0 {
        var highest = kind_highest(kind.kind)
        var bound = counter_bound(name, condition, true, scope, class_information)
        if bound and not own.any_in_inner_loop() {
            highest = highest.minimum(bound + up)
        }
        highest = highest.maximum(start.highest)
        return start.bounded(start.lowest, highest)
    }
    var down = counter_steps(name, own, false)
    if down >= 0 {
        var lowest = kind_lowest(kind.kind)
        var lowest_bound = counter_bound(name, condition, false, scope, class_information)
        if lowest_bound and not own.any_in_inner_loop() {
            lowest = lowest.maximum(lowest_bound - down)
        }
        lowest = lowest.minimum(start.lowest)
        return start.bounded(lowest, start.highest)
    }
    var joined = start
    var index = 0
    while index < own.count() {
        var write = own[index]
        crash write.value
        assert not mentions_any(write.value, declared)
        var reached = assigned_range(name, write.value, scope, class_information)
        assert reached
        joined = joined.joined(reached)
        index = index + 1
    }
    return joined
}

func counter_bound(
    name: String,
    condition: Syntax.Expressions.Expression,
    upward: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Long? {
    var binary = shape.as_binary(condition)
    assert binary
    assert binary.left and binary.right
    if binary.operator == 'logical_and' {
        var left_bound = counter_bound(name, binary.left, upward, scope, class_information)
        var right_bound = counter_bound(name, binary.right, upward, scope, class_information)
        if left_bound and right_bound {
            if upward {
                return left_bound.minimum(right_bound)
            }
            return left_bound.maximum(right_bound)
        }
        if left_bound {
            return left_bound
        }
        return right_bound
    }
    assert is_identifier_named(binary.left, name)
    var kind_type = scope.unnarrowed_type(name)
    var kind = whole_kind_of(kind_type)
    assert kind
    var bound = fitted_range(binary.right, kind.kind, scope, class_information)
    assert bound
    if upward and binary.operator == 'less' {
        return bound.highest - 1
    }
    if upward and binary.operator == 'less_equal' {
        return bound.highest
    }
    if not upward and binary.operator == 'greater' {
        return bound.lowest + 1
    }
    assert not upward and binary.operator == 'greater_equal'
    return bound.lowest
}

func note_sum(name: String, own: List<LoopWrite>, start: NumberRange?, ranges: LoopRanges) {
    assert start
    assert own.count() == 1
    var write = own[0]
    crash write.value
    assert not write.in_inner_loop and not is_identifier_named(write.value, name)
    assert is_sum_of(write.value, name)
    ranges.sum_into(name, start)
}

func note_passes(
    name: String,
    own: List<LoopWrite>,
    start: NumberRange?,
    condition: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    ranges: LoopRanges,
) {
    assert start
    assert own.count() == 1
    var write = own[0]
    crash write.value
    assert write.in_body and not write.in_inner_loop
    var passes: Long = -1
    var up = counter_step(name, write.value, true)
    if up >= 1 {
        var highest = counter_bound(name, condition, true, scope, class_information)
        assert highest
        passes = 0
        if highest >= start.lowest {
            passes = (highest - start.lowest) / up + 1
        }
    }
    var down = counter_step(name, write.value, false)
    if down >= 1 {
        var lowest = counter_bound(name, condition, false, scope, class_information)
        assert lowest
        passes = 0
        if start.highest >= lowest {
            passes = (start.highest - lowest) / down + 1
        }
    }
    assert passes >= 0
    if not ranges.passes_known or passes < ranges.most_passes {
        ranges.passes_known = true
        ranges.most_passes = passes
    }
}

func overflow_builtin(operator: Syntax.Expressions.BinaryOperator): String {
    if operator == 'subtract' {
        return "__builtin_sub_overflow"
    }
    if operator == 'multiply' {
        return "__builtin_mul_overflow"
    }
    return "__builtin_add_overflow"
}

func operand_cast(kind: Analysis.Types.NumericKind): String {
    if is_signed_kind(kind) {
        return "(int64_t)"
    }
    return "(uint64_t)"
}

func overflow_failure(kind: Analysis.Types.NumericKind): String {
    if is_signed_kind(kind) {
        ensure_overflow_check()
        return "spite_overflowed"
    }
    ensure_unsigned_overflow_check()
    return "spite_overflowed_unsigned"
}

func ensure_overflow_check() {
    assert not overflow_check_written
    overflow_check_written = true
    builder.add_prototype(
        "static void spite_overflowed(const char* operation, const char* type, const char* symbol, int64_t left, int64_t right, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_overflowed(const char* operation, const char* type, const char* symbol, int64_t left, int64_t right, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: '%s' does not fit in %s (%lld %s %lld), at %s\\n\", operation, type, (long long)left, symbol, (long long)right, where);\nexit(1);\n}",
    )
}

func ensure_unsigned_overflow_check() {
    assert not unsigned_overflow_check_written
    unsigned_overflow_check_written = true
    builder.add_prototype(
        "static void spite_overflowed_unsigned(const char* operation, const char* type, const char* symbol, uint64_t left, uint64_t right, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_overflowed_unsigned(const char* operation, const char* type, const char* symbol, uint64_t left, uint64_t right, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: '%s' does not fit in %s (%llu %s %llu), at %s\\n\", operation, type, (unsigned long long)left, symbol, (unsigned long long)right, where);\nexit(1);\n}",
    )
}

func is_unsigned_whole_kind(kind: Analysis.Types.NumericKind): Boolean {
    return kind == 'byte_kind' or kind == 'unsigned_short_kind' or kind == 'unsigned_integer_kind' or kind == 'unsigned_long_kind'
}

func is_checked_whole_kind(kind: Analysis.Types.NumericKind): Boolean {
    return is_signed_kind(kind) or is_unsigned_whole_kind(kind)
}

func is_signed_kind(kind: Analysis.Types.NumericKind): Boolean {
    return kind == 'tiny_kind' or kind == 'short_kind' or kind == 'integer_kind' or kind == 'long_kind'
}

func decimal_remainder_macro(operator: Syntax.Expressions.BinaryOperator, left_type: Analysis.SpiteType): String {
    if operator != 'modulo' {
        return ""
    }
    var scalar = type_shape.as_scalar(left_type)
    if not scalar or not is_float_kind(scalar.kind) {
        return ""
    }
    var name = "spite_double_remainder"
    var library_function = "fmod"
    if scalar.kind == 'float_kind' {
        name = "spite_float_remainder"
        library_function = "fmodf"
    }
    if not decimal_remainders_written.contains(name) {
        decimal_remainders_written.append(name)
        builder.add_shaken_macro(name)
        builder.include_maths_library(name)
        builder.add_typedef("#define {name}(left, right) {library_function}((left), (right))")
    }
    return name
}

func ensure_division_check() {
    assert not division_check_written
    division_check_written = true
    builder.add_prototype("static void spite_divided_by_zero(const char* operation, const char* where);")
    builder.add_support(
        "static void spite_divided_by_zero(const char* operation, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: '%s' divided by zero, at %s\\n\", operation, where);\nexit(1);\n}",
    )
}

func is_wider_right(
    binary: Syntax.Expressions.BinaryExpression,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
): Boolean {
    var left_scalar = type_shape.as_scalar(left_type)
    var right_scalar = type_shape.as_scalar(right_type)
    if not left_scalar or not right_scalar {
        return false
    }
    if left_scalar.kind == 'boolean_kind' or right_scalar.kind == 'boolean_kind' {
        return false
    }
    crash binary.right
    if literal_fits(binary.right, left_scalar.kind) {
        return false
    }
    return is_wider_kind(right_scalar.kind, left_scalar.kind)
}

func is_wider_kind(right: Analysis.Types.NumericKind, left: Analysis.Types.NumericKind): Boolean {
    if is_float_kind(right) and not is_float_kind(left) {
        return true
    }
    return scalar_bits(right) > scalar_bits(left)
}

func scalar_bits(kind: Analysis.Types.NumericKind): Integer {
    if kind == 'tiny_kind' or kind == 'byte_kind' {
        return 8
    }
    if kind == 'short_kind' or kind == 'unsigned_short_kind' {
        return 16
    }
    if kind == 'long_kind' or kind == 'unsigned_long_kind' or kind == 'double_kind' or kind == 'address_kind' {
        return 64
    }
    return 32
}

func literal_fits(expression: Syntax.Expressions.Expression, kind: Analysis.Types.NumericKind): Boolean {
    var value = literal_value(expression)
    if not value {
        return false
    }
    var lowest: Long = 0
    var highest: Long = 9223372036854775807
    if kind == 'tiny_kind' {
        lowest = -128
        highest = 127
    } else if kind == 'byte_kind' {
        highest = 255
    } else if kind == 'short_kind' {
        lowest = -32768
        highest = 32767
    } else if kind == 'unsigned_short_kind' {
        highest = 65535
    } else if kind == 'integer_kind' {
        lowest = -2147483648
        highest = 2147483647
    } else if kind == 'unsigned_integer_kind' {
        highest = 4294967295
    } else if kind != 'unsigned_long_kind' {
        lowest = -9223372036854775807
    }
    return value >= lowest and value <= highest
}

func literal_value(expression: Syntax.Expressions.Expression): Long? {
    var literal = shape.as_integer_literal(expression)
    if literal {
        return literal.value
    }
    var negated = shape.as_unary(expression)
    assert negated
    assert negated.operator == 'negate'
    crash negated.operand
    var negated_literal = shape.as_integer_literal(negated.operand)
    assert negated_literal
    return -negated_literal.value
}

func is_bits_function(name: String): Boolean {
    return name == "bits_and" or name == "bits_or" or name == "bits_exclusive_or"
}

func report_wider_bits_operand(
    name: String,
    object_ast: Syntax.Expressions.Expression,
    argument: Syntax.Expressions.Expression,
    object_result: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var receiver_type = object_result.type
    var receiver_scalar = type_shape.as_scalar(receiver_type)
    assert receiver_scalar
    var saved_counter = temporary_counter
    var probe = generate_expression(argument, scope, class_information)
    rewind_temporaries(saved_counter)
    var argument_type = probe.type
    var argument_scalar = type_shape.as_scalar(argument_type)
    assert argument_scalar
    assert not literal_fits(argument, receiver_scalar.kind)
    var fraction = is_float_kind(argument_scalar.kind) and not is_float_kind(receiver_scalar.kind)
    assert fraction or scalar_bits(argument_scalar.kind) > scalar_bits(receiver_scalar.kind)
    var printer = Syntax.SourcePrinter()
    var argument_text = printer.source_expression(argument)
    var receiver_text = printer.source_expression(object_ast)
    var receiver_name = type_display_name(receiver_type)
    var argument_name = type_display_name(argument_type)
    report(
        "'{receiver_text}.{name}({argument_text})' works in {with_article(receiver_name)}, since a bitwise function takes its receiver's type, and '{argument_text}' is {with_article(argument_name)}, which would be cut to fit: store the receiver in {with_article(argument_name)} first ('var wide: {argument_name} = {receiver_text}'), or store '{argument_text}' in {with_article(receiver_name)} first if it fits one",
    )
}

func report_wider_right(
    binary: Syntax.Expressions.BinaryExpression,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
) {
    crash binary.left
    crash binary.right
    var printer = Syntax.SourcePrinter()
    var written = printer.source_expression(binary)
    var left_text = printer.source_expression(binary.left)
    var left_name = type_display_name(left_type)
    var right_name = type_display_name(right_type)
    var fix = "store the left side in {with_article(right_name)} first ('var wide: {right_name} = {left_text}')"
    if binary.operator == 'add' or binary.operator == 'multiply' {
        var swapped = Syntax.Expressions.BinaryExpression(binary.operator, binary.right, binary.left)
        var swapped_text = printer.source_expression(swapped)
        fix = "write the {right_name} first ('{swapped_text}')"
    }
    report(
        "'{written}' is {operation_name(binary.operator)} in {left_name}, since arithmetic takes the left side's type, and the right side is {with_article(right_name)}, which would be cut to fit: {fix}, or store the right side in {with_article(left_name)} first if it fits one",
    )
}

func report_wider_comparison(
    binary: Syntax.Expressions.BinaryExpression,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
) {
    crash binary.left
    crash binary.right
    var printer = Syntax.SourcePrinter()
    var written = printer.source_expression(binary)
    var left_text = printer.source_expression(binary.left)
    var right_text = printer.source_expression(binary.right)
    var mirrored = mirrored_comparison_symbol(binary.operator)
    var left_name = type_display_name(left_type)
    var right_name = type_display_name(right_type)
    report(
        "'{written}' compares in {left_name}, since a comparison takes the left side's type, and the right side is {with_article(right_name)}, which would be cut to fit: write the {right_name} first ('{right_text} {mirrored} {left_text}'), or store the right side in {with_article(left_name)} first if it fits one",
    )
}

func mirrored_comparison_symbol(operator: Syntax.Expressions.BinaryOperator): String {
    switch operator {
        'less': return ">"
        'less_equal': return ">="
        'greater': return "<"
        'greater_equal': return "<="
        _: return binary_operator_symbol(operator)
    }
}

func type_with_article(spite_type: Analysis.SpiteType): String {
    var name = type_display_name(spite_type)
    return with_article(name)
}

func with_article(name: String): String {
    var vowels = ["A", "E", "I", "O", "U"]
    var first_letter = name.slice(0, 1)
    if vowels.contains(first_letter) {
        return "an {name}"
    }
    return "a {name}"
}

func operation_name(operator: Syntax.Expressions.BinaryOperator): String {
    switch operator {
        'add': return "an addition"
        'subtract': return "a subtraction"
        'multiply': return "a multiplication"
        'divide': return "a division"
        _: return "a remainder"
    }
}

func report_constant_overflow(binary: Syntax.Expressions.BinaryExpression) {
    crash binary.left
    crash binary.right
    var left_value = constant_integer(binary.left)
    var right_value = constant_integer(binary.right)
    assert left_value and right_value
    var result = constant_operation(binary.operator, left_value, right_value)
    assert result
    assert result < -2147483648 or result > 2147483647
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = binary
    var written = printer.source_expression(expression)
    report(
        "'{written}' is {result}, which does not fit in an Integer, the type its arithmetic is done in, so it would wrap: write the number itself, {result}, which is a Long",
    )
}

func constant_integer(expression: Syntax.Expressions.Expression): Long? {
    var value = literal_value(expression)
    if value {
        assert value >= -2147483648 and value <= 2147483647
        return value
    }
    var binary = shape.as_binary(expression)
    assert binary
    crash binary.left
    crash binary.right
    var left_value = constant_integer(binary.left)
    var right_value = constant_integer(binary.right)
    assert left_value and right_value
    var result = constant_operation(binary.operator, left_value, right_value)
    assert result
    assert result >= -2147483648 and result <= 2147483647
    return result
}

func constant_operation(operator: Syntax.Expressions.BinaryOperator, left_value: Long, right_value: Long): Long? {
    switch operator {
        'add': return left_value + right_value
        'subtract': return left_value - right_value
        'multiply': return left_value * right_value
        _: {
            assert right_value != 0
            if operator == 'divide' {
                return left_value / right_value
            }
            assert operator == 'modulo'
            return left_value % right_value
        }
    }
}

func generate_nullable_equality(
    binary: Syntax.Expressions.BinaryExpression,
    left: ExpressionResult,
    inner: Analysis.SpiteType,
    left_ast: Syntax.Expressions.Expression,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if resumable_mode and conditional_depth == 0 {
        var right_position = builder.user_count()
        var right_marks = wait_mark_counters.count()
        var right_counter = temporary_counter
        var right_first = generate_expression(right_ast, scope, class_information)
        if waited_since(right_marks) {
            var after_wait = WaitedRight(right_first, right_position, right_marks, right_counter)
            return nullable_equality_after_wait(
                binary,
                left,
                inner,
                left_ast,
                right_ast,
                after_wait,
                scope,
                class_information,
            )
        }
        rewind_temporaries(right_counter)
    }
    var compared_name = next_temporary()
    var compared_scope = Scope(scope)
    compared_scope.declare(compared_name, inner)
    var null_check = present_code(compared_name, inner)
    if type_is_reference(inner) {
        compared_scope.set_override(compared_name, compared_name)
    } else {
        compared_scope.set_override(compared_name, "{compared_name}.value")
        null_check = "{compared_name}.has_value"
    }
    var narrowed_left: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(compared_name)
    var narrowed_comparison: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression(
        binary.operator,
        narrowed_left,
        right_ast,
    )
    conditional_depth = conditional_depth + 1
    var compared = generate_expression(narrowed_comparison, compared_scope, class_information)
    conditional_depth = conditional_depth - 1
    var when_null = "false"
    if binary.operator == 'not_equal' {
        when_null = "true"
    }
    conditional_depth = conditional_depth + 1
    var right = generate_expression(right_ast, scope, class_information)
    conditional_depth = conditional_depth - 1
    var right_type = right.type
    var right_nullable = type_shape.as_nullable(right_type)
    if right_nullable {
        var right_inner = right_nullable.inner
        var right_name = next_temporary()
        var right_present = present_code(right_name, right_inner)
        if not type_is_reference(right_inner) {
            right_present = "{right_name}.has_value"
        }
        var right_release = ""
        if owns(right, right_ast) and type_needs_drop(right_inner) {
            right_release = " {release_call(right_inner, right_name)};"
        }
        var absent = "!{right_present}"
        if binary.operator == 'not_equal' {
            absent = right_present
        }
        when_null = "(\{ {c_type_name(right_type)} {right_name} = {right.code}; bool spite_absent = {absent};{right_release} spite_absent; })"
    }
    var release = ""
    if owns(left, left_ast) and type_needs_drop(inner) {
        release = " {release_call(inner, compared_name)};"
    }
    var left_type = left.type
    var code = "(\{ {c_type_name(left_type)} {compared_name} = {left.code}; bool spite_equal = ({null_check}) ? ({compared.code}) : {when_null};{release} spite_equal; })"
    var boolean_spite_type = boolean_type()
    return ExpressionResult(code, boolean_spite_type)
}

func nullable_equality_after_wait(
    binary: Syntax.Expressions.BinaryExpression,
    left: ExpressionResult,
    inner: Analysis.SpiteType,
    left_ast: Syntax.Expressions.Expression,
    right_ast: Syntax.Expressions.Expression,
    waited: WaitedRight,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var right = waited.right
    var right_type = right.type
    var compared_name = next_temporary()
    var right_name = next_temporary()
    var compared_scope = Scope(scope)
    compared_scope.declare(compared_name, inner)
    compared_scope.declare(right_name, right_type)
    compared_scope.set_override(right_name, right_name)
    var null_check = present_code(compared_name, inner)
    if type_is_reference(inner) {
        compared_scope.set_override(compared_name, compared_name)
    } else {
        compared_scope.set_override(compared_name, "{compared_name}.value")
        null_check = "{compared_name}.has_value"
    }
    var left_type = left.type
    var opening = List<String>()
    opening.append("{c_type_name(left_type)} {compared_name} = {left.code};")
    var closing = List<String>()
    closing.append("{c_type_name(right_type)} {right_name} = {right.code};")
    wrap_waits(waited.position, waited.marks_before, waited.counter_before, opening, closing, compared_name)
    var narrowed_left: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(compared_name)
    var narrowed_right: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(right_name)
    var narrowed_comparison: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression(
        binary.operator,
        narrowed_left,
        narrowed_right,
    )
    var compared = generate_expression(narrowed_comparison, compared_scope, class_information)
    var when_null = "false"
    if binary.operator == 'not_equal' {
        when_null = "true"
    }
    var releases = ""
    var right_nullable = type_shape.as_nullable(right_type)
    if right_nullable {
        var right_inner = right_nullable.inner
        var right_present = present_code(right_name, right_inner)
        if not type_is_reference(right_inner) {
            right_present = "{right_name}.has_value"
        }
        when_null = "!{right_present}"
        if binary.operator == 'not_equal' {
            when_null = right_present
        }
        if owns(right, right_ast) and type_needs_drop(right_inner) {
            releases = " {release_call(right_inner, right_name)};"
        }
    } else if owns(right, right_ast) and type_needs_drop(right_type) {
        releases = " {release_call(right_type, right_name)};"
    }
    if owns(left, left_ast) and type_needs_drop(inner) {
        releases = "{releases} {release_call(inner, compared_name)};"
    }
    var code = "(\{ bool spite_equal = ({null_check}) ? ({compared.code}) : ({when_null});{releases} spite_equal; })"
    var boolean_spite_type = boolean_type()
    return ExpressionResult(code, boolean_spite_type)
}

func report_maybe_boolean(result: ExpressionResult, used_by: String) {
    var result_type = result.type
    var maybe = type_shape.as_nullable(result_type)
    assert maybe
    var maybe_inner = maybe.inner
    assert is_boolean_type(maybe_inner) and not asserting_boolean_truth
    report(
        "this is a Boolean? used by {used_by}, which would only test that it is there, not that it is true: prove it is there first ('crash index < flags.count()' proves 'flags[index]') or switch over it",
    )
}

func owned_truth(result: ExpressionResult, expression: Syntax.Expressions.Expression): String {
    var result_type = result.type
    if owns(result, expression) and type_needs_drop(result_type) {
        var tested = next_temporary()
        var held = ExpressionResult(tested, result_type)
        return "(\{ {c_type_name(result_type)} {tested} = {result.code}; bool spite_truth = {truth_of(held)}; {release_call(result_type, tested)}; spite_truth; })"
    }
    return truth_of(result)
}

func truth_of(result: ExpressionResult): String {
    var result_type = result.type
    var maybe_null = type_shape.as_nullable(result_type)
    if maybe_null {
        var maybe_null_inner = maybe_null.inner
        if type_is_reference(maybe_null_inner) {
            return present_code(result.code, maybe_null_inner)
        }
        return "(({result.code}).has_value)"
    }
    return "({result.code})"
}

func operated_shape_name(
    operator: Syntax.Expressions.BinaryOperator,
    left_type: Analysis.SpiteType,
    class_information: Analysis.ClassInfo,
): String {
    if operator == 'logical_and' or operator == 'logical_or' or operator == 'equal' or operator == 'not_equal' {
        return ""
    }
    var left_union = type_shape.as_union(left_type)
    if not left_union {
        return ""
    }
    var information = find_union_by_c_name(left_union.c_name)
    if not information {
        return ""
    }
    if not information.is_shape {
        return ""
    }
    if not class_information.codegen_constraints.contains(information.c_name) {
        return information.simple_name
    }
    var index = 0
    while index < failed_constraints.count() {
        if failed_constraints[index].starts_with("{information.c_name}>") {
            return ""
        }
        index = index + 1
    }
    return information.simple_name
}

func operates_through_shape(operator: Syntax.Expressions.BinaryOperator, left_type: Analysis.SpiteType): Boolean {
    var union_type = type_shape.as_union(left_type)
    if not union_type {
        return false
    }
    var information = find_union_by_c_name(union_type.c_name)
    if not information {
        return false
    }
    var word = operator_word(operator)
    if not information.is_tagged or word.is_empty() {
        return false
    }
    var function_name = operator_function_name(operator)
    var required = find_required_function(information, function_name)
    if not required {
        return false
    }
    return true
}

func shape_operator(
    binary: Syntax.Expressions.BinaryExpression,
    left: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var left_type = left.type
    var union_type = type_shape.as_union(left_type)
    crash union_type
    var information = find_union_by_c_name(union_type.c_name)
    crash information
    var right = generate_joined(binary.right, scope, class_information)
    var right_type = right.type
    var held = List<String>()
    var releases = List<String>()
    var left_held = next_temporary()
    held.append("{information.c_name} {left_held} = {left.code};")
    if owns(left, binary.left) {
        releases.append("{release_call(left_type, left_held)};")
    }
    var right_held = next_temporary()
    var right_tagged = tagged_value(right.code, right_type, information)
    held.append("{information.c_name} {right_held} = {right_tagged};")
    if owns(right, binary.right) and type_needs_drop(right_type) {
        releases.append("{release_call(left_type, right_held)};")
    }
    var helper = ensure_shape_operator(information, binary.operator)
    var constant = "false"
    crash binary.right
    var written_number = literal_value(binary.right)
    if written_number {
        constant = "true"
    }
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = binary
    var source_text = printer.source_expression(expression)
    var written = escape_c_string(source_text)
    var where = located(current_path, current_line, current_owner, current_function)
    var result_c_type = information.c_name
    var result_type = union_type_of(information)
    if is_boolean_result_operator(binary.operator) {
        result_c_type = "bool"
        result_type = boolean_type()
    }
    var code = "(\{ {held.join(" ")} {result_c_type} spite_operated = {helper}({left_held}, {right_held}, {constant}, \"{written}\", {where}); {releases.join(" ")} spite_operated; })"
    return ExpressionResult(code, result_type)
}

func operator_word(operator: Syntax.Expressions.BinaryOperator): String {
    switch operator {
        'add': return "add"
        'subtract': return "subtract"
        'multiply': return "multiply"
        'divide': return "divide"
        'modulo': return "modulo"
        'less': return "less"
        'less_equal': return "less_equal"
        'greater': return "greater"
        'greater_equal': return "greater_equal"
        _: return ""
    }
}

func ensure_shape_operator(information: Analysis.UnionInfo, operator: Syntax.Expressions.BinaryOperator): String {
    var name = "{information.c_name}___operate_{operator_word(operator)}"
    if shape_operator_names.has(name) {
        return name
    }
    shape_operator_names[name] = true
    shape_operator_unions.append(information)
    shape_operator_operators.append(operator)
    shape_operator_texts.append("")
    var returned = information.c_name
    if is_boolean_result_operator(operator) {
        returned = "bool"
    }
    builder.add_prototype(
        "{returned} {name}({information.c_name} left, {information.c_name} right, bool constant, const char* operation, const char* where);",
    )
    var position = builder.support_count()
    shape_operator_positions.append(position)
    builder.add_support("")
    ensure_operand_checks()
    return name
}

func ensure_operand_checks() {
    assert not operand_checks_written
    operand_checks_written = true
    builder.add_prototype(
        "static void spite_operand_misfit(const char* operation, const char* left, const char* right, const char* reason, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_operand_misfit(const char* operation, const char* left, const char* right, const char* reason, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: '%s' works in %s, the class of its left side, and its right side is %s, which %s, at %s\\n\", operation, left, right, reason, where);\nexit(1);\n}",
    )
    builder.add_prototype(
        "static void spite_operator_unreached(const char* operation, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_operator_unreached(const char* operation, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: '%s' was given a value of a class it is not compiled for, at %s\\n\", operation, where);\nexit(1);\n}",
    )
}

func emit_shape_operators(): Integer {
    var changed = 0
    var index = 0
    while index < shape_operator_unions.count() {
        crash shape_operator_operators[index]
        var text = shape_operator_text(shape_operator_unions[index], shape_operator_operators[index])
        crash shape_operator_texts[index]
        if text != shape_operator_texts[index] {
            crash shape_operator_positions[index]
            builder.replace_support(shape_operator_positions[index], text)
            shape_operator_texts[index] = text
            changed = changed + 1
        }
        index = index + 1
    }
    return changed
}

func operated_number_type(member: Analysis.ClassInfo): Analysis.SpiteType? {
    assert is_plain_member(member)
    crash boxed_value_types[member.c_name]
    var member_type = boxed_value_types[member.c_name]
    var scalar = type_shape.as_scalar(member_type)
    assert scalar
    assert scalar.kind != 'boolean_kind'
    return member_type
}

func shape_operator_text(information: Analysis.UnionInfo, operator: Syntax.Expressions.BinaryOperator): String {
    var returned = information.c_name
    if is_boolean_result_operator(operator) {
        returned = "bool"
    }
    var lines = List<String>()
    lines.append(
        "{returned} {information.c_name}___operate_{operator_word(operator)}({information.c_name} left, {information.c_name} right, bool constant, const char* operation, const char* where) \{",
    )
    lines.append("switch (left.tag) \{")
    var index = 0
    while index < information.members.count() {
        var member = information.members[index]
        var member_type = operated_number_type(member)
        if member_type {
            number_operator_case(information, operator, member, member_type, lines)
        } else {
            class_operator_case(information, operator, member, lines)
        }
        index = index + 1
    }
    lines.append("}")
    lines.append("spite_operator_unreached(operation, where);")
    lines.append("}")
    return lines.join("\n")
}

func number_operator_case(
    information: Analysis.UnionInfo,
    operator: Syntax.Expressions.BinaryOperator,
    member: Analysis.ClassInfo,
    member_type: Analysis.SpiteType,
    lines: List<String>,
) {
    var c_type = c_type_name(member_type)
    lines.append("case {member.class_id}: \{")
    lines.append("{c_type} spite_left = SPITE_TAGGED_VALUE(left, {c_type});")
    lines.append("{c_type} spite_right = 0;")
    lines.append("switch (right.tag) \{")
    var other_index = 0
    while other_index < information.members.count() {
        var other = information.members[other_index]
        var right_case = right_operand_case(member, member_type, other)
        lines.append(right_case)
        other_index = other_index + 1
    }
    lines.append("default: spite_operator_unreached(operation, where);")
    lines.append("}")
    operated_lines(operator, member, member_type, lines)
    lines.append("}")
}

func right_operand_case(
    member: Analysis.ClassInfo,
    member_type: Analysis.SpiteType,
    other: Analysis.ClassInfo,
): String {
    var c_type = c_type_name(member_type)
    if other.c_name == member.c_name {
        return "case {other.class_id}: spite_right = SPITE_TAGGED_VALUE(right, {c_type}); break;"
    }
    var left_shown = operand_shown(member)
    var right_shown = operand_shown(other)
    var other_type = operated_number_type(other)
    if not other_type {
        return "case {other.class_id}: spite_operand_misfit(operation, \"{left_shown}\", \"{right_shown}\", \"is not one\", where);"
    }
    var other_c_type = c_type_name(other_type)
    var given = "{other_c_type} spite_given = SPITE_TAGGED_VALUE(right, {other_c_type});"
    var scalar = type_shape.as_scalar(member_type)
    crash scalar
    var other_scalar = type_shape.as_scalar(other_type)
    crash other_scalar
    if not is_wider_kind(other_scalar.kind, scalar.kind) {
        return "case {other.class_id}: \{ {given} spite_right = ({c_type})spite_given; break; }"
    }
    var cut = "spite_operand_misfit(operation, \"{left_shown}\", \"{right_shown}\", \"would be cut to fit\", where);"
    if is_float_kind(other_scalar.kind) {
        return "case {other.class_id}: {cut}"
    }
    var fits = written_number_fits(scalar.kind)
    return "case {other.class_id}: \{ {given} if (!constant || !({fits})) {cut} spite_right = ({c_type})spite_given; break; }"
}

func written_number_fits(kind: Analysis.Types.NumericKind): String {
    if is_float_kind(kind) {
        return "true"
    }
    var lowest = "0"
    var highest = "INT64_MAX"
    if kind == 'tiny_kind' {
        lowest = "-128"
        highest = "127"
    } else if kind == 'byte_kind' {
        highest = "255"
    } else if kind == 'short_kind' {
        lowest = "-32768"
        highest = "32767"
    } else if kind == 'unsigned_short_kind' {
        highest = "65535"
    } else if kind == 'integer_kind' {
        lowest = "INT32_MIN"
        highest = "INT32_MAX"
    } else if kind == 'unsigned_integer_kind' {
        highest = "UINT32_MAX"
    } else if kind != 'unsigned_long_kind' {
        lowest = "INT64_MIN"
    }
    return "(int64_t)spite_given >= {lowest} && (int64_t)spite_given <= {highest}"
}

func operand_shown(member: Analysis.ClassInfo): String {
    var member_type = operated_number_type(member)
    if member_type {
        var number_name = type_display_name(member_type)
        return with_article(number_name)
    }
    return with_article(member.simple_name)
}

func class_operator_case(
    information: Analysis.UnionInfo,
    operator: Syntax.Expressions.BinaryOperator,
    member: Analysis.ClassInfo,
    lines: List<String>,
) {
    var function_name = operator_function_name(operator)
    var function = find_or_instantiate_function(member, function_name)
    assert function
    var shape_type = union_type_of(information)
    var left_value = member_value_code("left", shape_type, member)
    var right_value = member_value_code("right", shape_type, member)
    crash function.parameters[0]
    var right_parameter_type = function.parameters[0].type
    var right_passed = retain_call(right_parameter_type, right_value)
    var call = "{function.c_name}({left_value}, {right_passed})"
    var answer = "return {call};"
    if operator == 'greater_equal' or operator == 'less_equal' {
        answer = "return !{call};"
    } else if not is_boolean_result_operator(operator) {
        var function_return_type = function.return_type
        var tagged_answer = tagged_value(call, function_return_type, information)
        answer = "return {tagged_answer};"
    }
    lines.append("case {member.class_id}: \{")
    lines.append("switch (right.tag) \{")
    lines.append("case {member.class_id}: {answer}")
    var left_shown = operand_shown(member)
    var other_index = 0
    while other_index < information.members.count() {
        var other = information.members[other_index]
        if other.c_name != member.c_name {
            var right_shown = operand_shown(other)
            lines.append(
                "case {other.class_id}: spite_operand_misfit(operation, \"{left_shown}\", \"{right_shown}\", \"is not one\", where);",
            )
        }
        other_index = other_index + 1
    }
    lines.append("}")
    lines.append("break;")
    lines.append("}")
}

func operated_lines(
    operator: Syntax.Expressions.BinaryOperator,
    member: Analysis.ClassInfo,
    member_type: Analysis.SpiteType,
    lines: List<String>,
) {
    var symbol = binary_operator_symbol(operator)
    if is_boolean_result_operator(operator) {
        lines.append("return spite_left {symbol} spite_right;")
        return
    }
    var scalar = type_shape.as_scalar(member_type)
    crash scalar
    var c_type = c_type_name(member_type)
    var computed = "({c_type})(spite_left {symbol} spite_right)"
    var signed = is_signed_kind(scalar.kind)
    var whole = not is_float_kind(scalar.kind)
    if operator == 'modulo' and not whole {
        var decimal_remainder = decimal_remainder_macro(operator, member_type)
        lines.append("return {ensure_tag(member, member_type)}({decimal_remainder}(spite_left, spite_right));")
        return
    }
    if operator == 'divide' or operator == 'modulo' {
        if whole {
            if not division_check_written {
                ensure_division_check()
            }
            lines.append("if (spite_right == 0) spite_divided_by_zero(operation, where);")
            if signed and operator == 'divide' {
                ensure_overflow_check()
                var divided_name = type_display_name(member_type)
                lines.append("{c_type} spite_negated = 0;")
                lines.append(
                    "if (spite_right == -1 && __builtin_sub_overflow(({c_type})0, spite_left, &spite_negated)) spite_overflowed(operation, \"{with_article(divided_name)}\", \"/\", (int64_t)spite_left, (int64_t)spite_right, where);",
                )
                computed = "spite_right == -1 ? spite_negated : ({c_type})(spite_left / spite_right)"
            }
            if signed and operator == 'modulo' {
                computed = "spite_right == -1 ? ({c_type})0 : ({c_type})(spite_left % spite_right)"
            }
        }
        lines.append("return {ensure_tag(member, member_type)}({computed});")
        return
    }
    if is_checked_whole_kind(scalar.kind) {
        var failure = overflow_failure(scalar.kind)
        var builtin = overflow_builtin(operator)
        var member_name = type_display_name(member_type)
        var shown = with_article(member_name)
        var widened = operand_cast(scalar.kind)
        lines.append("{c_type} spite_result;")
        lines.append(
            "if ({builtin}(spite_left, spite_right, &spite_result)) {failure}(operation, \"{shown}\", \"{symbol}\", {widened}spite_left, {widened}spite_right, where);",
        )
        computed = "spite_result"
    }
    lines.append("return {ensure_tag(member, member_type)}({computed});")
}

func operator_function_name(operator: Syntax.Expressions.BinaryOperator): String {
    switch operator {
        'add': return "sum"
        'subtract': return "subtract"
        'multiply': return "multiply"
        'divide': return "divide"
        'modulo': return "remainder"
        _: {
            if operator == 'equal' or operator == 'not_equal' {
                return "equals"
            }
            if operator == 'less' or operator == 'greater_equal' {
                return "less_than"
            }
            if operator == 'greater' or operator == 'less_equal' {
                return "greater_than"
            }
            return ""
        }
    }
}

func generate_class_binary(
    operator: Syntax.Expressions.BinaryOperator,
    left_class: Analysis.ClassInfo,
    left_result: ExpressionResult,
    left_ast: Syntax.Expressions.Expression,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var function_name = operator_function_name(operator)
    var negated = operator == 'not_equal' or operator == 'greater_equal' or operator == 'less_equal'
    var function: Analysis.FunctionInfo? = null
    if not function_name.is_empty() {
        function = find_or_instantiate_function(left_class, function_name)
    }
    if function {
        if function.parameters.count() == 1 and not compares_identity_instead(function, left_class, right_ast, scope, class_information) {
            var operator_arguments = List<Syntax.Expressions.Expression>()
            operator_arguments.append(right_ast)
            var parameter_types = parameter_types_of(function.parameters)
            var function_return_type = function.return_type
            argument_lender_class = left_class
            argument_lender_function = function
            var called = generate_generic_call(
                function.c_name,
                left_result,
                left_ast,
                operator_arguments,
                parameter_types,
                function_return_type,
                scope,
                class_information,
            )
            if negated {
                var boolean_spite_type = boolean_type()
                return ExpressionResult("(!({called.code}))", boolean_spite_type)
            }
            called.owning_override = true
            return called
        }
    }
    if operator == 'equal' or operator == 'not_equal' {
        var right_result = generate_expression(right_ast, scope, class_information)
        var lines = List<String>()
        var left_temporary = next_temporary()
        var right_temporary = next_temporary()
        lines.append("void* {left_temporary} = {left_result.code};")
        lines.append("void* {right_temporary} = {right_result.code};")
        var comparison = "=="
        if operator == 'not_equal' {
            comparison = "!="
        }
        lines.append("bool spite_same = {left_temporary} {comparison} {right_temporary};")
        if owns(left_result, left_ast) {
            var left_result_type = left_result.type
            lines.append("{release_call(left_result_type, left_temporary)};")
        }
        var right_result_type = right_result.type
        if owns(right_result, right_ast) and type_needs_drop(right_result_type) {
            lines.append("{release_call(right_result_type, right_temporary)};")
        }
        lines.append("spite_same;")
        var boolean_spite_type = boolean_type()
        return ExpressionResult("(\{ {lines.join(" ")} })", boolean_spite_type)
    }
    report("this operator on a '{left_class.simple_name}' needs it to define '{function_name}(other)'")
    return void_result()
}

func compares_identity_instead(
    function: Analysis.FunctionInfo,
    left_class: Analysis.ClassInfo,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if function.name != "equals" {
        return false
    }
    var saved_counter = temporary_counter
    var probe = generate_expression(right_ast, scope, class_information)
    rewind_temporaries(saved_counter)
    var right_type = probe.type
    var right_nullable = type_shape.as_nullable(right_type)
    if right_nullable {
        right_type = right_nullable.inner
    }
    var right_class_ref = type_shape.as_class_ref(right_type)
    if right_class_ref {
        if right_class_ref.c_name == left_class.c_name {
            crash function.parameters[0]
            var parameter_type = function.parameters[0].type
            return not type_shape.as_class_ref(parameter_type)
        }
    }
    return false
}

func generate_unary(
    unary: Syntax.Expressions.UnaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash unary.operand
    var negation_name = ""
    if unary.operator == 'negate' {
        negation_name = "negate"
    }
    var operand = operand_in_frame(unary.operand, negation_name, scope, class_information)
    var operand_type = operand.type
    var operand_class_ref = type_shape.as_class_ref(operand_type)
    if operand_class_ref {
        var operand_class = find_class_by_c_name(operand_class_ref.c_name)
        var negating = unary.operator == 'negate'
        if operand_class {
            if negating {
                var negate = find_or_instantiate_function(operand_class, "negate")
                if negate {
                    var empty_types = no_types()
                    var negate_return_type = negate.return_type
                    var no_arguments = List<Syntax.Expressions.Expression>()
                    var negated = generate_generic_call(
                        negate.c_name,
                        operand,
                        unary.operand,
                        no_arguments,
                        empty_types,
                        negate_return_type,
                        scope,
                        class_information,
                    )
                    negated.owning_override = true
                    return negated
                }
                report("'-' on a '{operand_class.simple_name}' needs it to define 'negate()'")
            }
        }
    }
    if unary.operator == 'negate' {
        var negated = checked_negation(unary, operand.code, operand_type, scope, class_information)
        if not negated.is_empty() {
            return ExpressionResult(negated, operand_type)
        }
        return ExpressionResult("(-({operand.code}))", operand_type)
    }
    report_maybe_boolean(operand, "'not'")
    var result_type = Analysis.Types.ScalarType('boolean_kind')
    return ExpressionResult("(!{owned_truth(operand, unary.operand)})", result_type)
}

func checked_negation(
    unary: Syntax.Expressions.UnaryExpression,
    code: String,
    operand_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var scalar = type_shape.as_scalar(operand_type)
    if not scalar {
        return ""
    }
    if not is_checked_whole_kind(scalar.kind) {
        return ""
    }
    crash unary.operand
    if shape.as_integer_literal(unary.operand) {
        return ""
    }
    var refusal = negation_refusal(unary.operand, operand_type, scope, class_information)
    if refusal.is_empty() {
        return ""
    }
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = unary
    var source_text = printer.source_expression(expression)
    optimization_report.overflow_check_kept(current_function_c_name, current_path, current_line, source_text, refusal)
    var failure = overflow_failure(scalar.kind)
    var operation = escape_c_string(source_text)
    var c_type = c_type_name(operand_type)
    var value = next_temporary()
    var result = next_temporary()
    var where = located(current_path, current_line, current_owner, current_function)
    var shown = operand_cast(scalar.kind)
    var type_name = type_display_name(operand_type)
    return "(\{ {c_type} {value} = {code}; {c_type} {result}; if (__builtin_expect(__builtin_sub_overflow(({c_type})0, {value}, &{result}), 0)) {failure}(\"{operation}\", \"{with_article(type_name)}\", \"-\", {shown}0, {shown}{value}, {where}); {result}; })"
}

func checked_absolute_call(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var saved_counter = temporary_counter
    var probe = generate_expression(object_ast, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var scalar = type_shape.as_scalar(probe_type)
    assert scalar
    assert is_signed_kind(scalar.kind)
    var receiver = generate_expression(object_ast, scope, class_information)
    var receiver_type = receiver.type
    var printer = Syntax.SourcePrinter()
    var callee: Syntax.Expressions.Expression = member
    var no_arguments = List<Syntax.Expressions.Expression>()
    var call: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, no_arguments)
    var call_text = printer.source_expression(call)
    var operation = escape_c_string(call_text)
    var c_type = c_type_name(receiver_type)
    var value = next_temporary()
    var result = next_temporary()
    var where = located(current_path, current_line, current_owner, current_function)
    var failure = overflow_failure(scalar.kind)
    var shown = operand_cast(scalar.kind)
    var type_name = type_display_name(receiver_type)
    var code = "(\{ {c_type} {value} = {receiver.code}; {c_type} {result} = {value}; if ({value} < 0 && __builtin_expect(__builtin_sub_overflow(({c_type})0, {value}, &{result}), 0)) {failure}(\"{operation}\", \"{with_article(type_name)}\", \"-\", {shown}0, {shown}{value}, {where}); {result}; })"
    return ExpressionResult(code, receiver_type)
}

func generate_argument_list(
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var result = List<String>()
    var lender_class = argument_lender_class
    var lender_function = argument_lender_function
    argument_lender_class = null
    argument_lender_function = null
    var lent_positions = lent_argument_positions
    var lent_sources = lent_argument_sources
    var held_positions = held_argument_positions
    var framed_positions = framed_argument_positions
    lent_argument_positions = List<String>()
    lent_argument_sources = List<String>()
    held_argument_positions = List<String>()
    framed_argument_positions = List<String>()
    var variadic = variadic_list(expected_types)
    if variadic {
        return generate_spread_arguments(arguments_ast, expected_types, variadic, scope, class_information)
    }
    if arguments_ast.count() != expected_types.count() {
        report("this call passes {arguments_ast.count()} argument(s), but {expected_types.count()} are expected")
        return result
    }
    var callee = argument_callee
    var positions_after = List<Integer>()
    var marks_after = List<Integer>()
    var counters_after = List<Integer>()
    var index = 0
    while index < arguments_ast.count() {
        borrow_site = ""
        var lent_at = position_in(lent_positions, index)
        var held_at = position_in(held_positions, index)
        var framed_code = ""
        if lent_at < 0 and held_at < 0 {
            framed_code = argument_in_frame(
                arguments_ast[index],
                expected_types[index],
                lender_class,
                lender_function,
                index,
                scope,
                class_information,
            )
        }
        if lent_at >= 0 {
            crash lent_sources[lent_at]
            report_lent_call_resize(arguments_ast[index], lent_sources[lent_at], callee, scope, class_information)
            borrow_site = "lent:{callee}"
            var lent_code = coerce_for_store(arguments_ast[index], expected_types[index], scope, class_information)
            result.append(lent_code)
        } else if held_at >= 0 {
            var framed = position_in(framed_positions, index) >= 0
            var held_code = held_argument_code(
                arguments_ast[index],
                expected_types[index],
                framed,
                scope,
                class_information,
            )
            result.append(held_code)
        } else if framed_code.is_empty() {
            borrow_site = "argument:{callee}"
            var stored_code = coerce_for_store(arguments_ast[index], expected_types[index], scope, class_information)
            result.append(stored_code)
        } else {
            result.append(framed_code)
        }
        var position_after = builder.user_count()
        positions_after.append(position_after)
        var marks_count = wait_mark_counters.count()
        marks_after.append(marks_count)
        counters_after.append(temporary_counter)
        index = index + 1
    }
    borrow_site = ""
    if resumable_mode {
        keep_arguments_in_order(result, expected_types, positions_after, marks_after, counters_after)
    }
    return result
}

func keep_arguments_in_order(
    codes: List<String>,
    expected_types: List<Analysis.SpiteType>,
    positions_after: List<Integer>,
    marks_after: List<Integer>,
    counters_after: List<Integer>,
) {
    var index = codes.count() - 1
    while index >= 0 {
        crash codes[index]
        crash expected_types[index]
        crash positions_after[index]
        crash marks_after[index]
        crash counters_after[index]
        var code = codes[index]
        var expected = expected_types[index]
        var position = positions_after[index]
        var marks_count = marks_after[index]
        var counter = counters_after[index]
        if waited_since(marks_count) and not stable_code(code) {
            var spilled = next_temporary()
            var line = "{c_type_name(expected)} {spilled} = {code};"
            insert_wait_line(position, counter, line, spilled)
            codes[index] = spilled
        }
        index = index - 1
    }
}

func position_in(positions: List<String>, index: Integer): Integer {
    var found = 0
    while found < positions.count() {
        if positions[found] == index.to_string() {
            return found
        }
        found = found + 1
    }
    return -1
}

func objects_in_frame_allowed(class_information: Analysis.ClassInfo): Boolean {
    if keeps_internals or hot_reload or resumable_mode or remote_loop_port != 0 {
        return false
    }
    return object_frames_open and not read_evaluate_print_loop and not is_hot_class(class_information)
}

func may_be_fresh(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_call(expression) or shape.as_binary(expression) {
        return true
    }
    if shape.as_generic_call(expression) {
        return true
    }
    if shape.as_unary(expression) {
        return true
    }
    return false
}

func object_study(scope: Scope, class_information: Analysis.ClassInfo): ObjectEscape {
    var study = ObjectEscape(object_frames, this, class_information)
    study.scope = scope
    return study
}

func next_object_slot(): String {
    object_slot_counter = object_slot_counter + 1
    return "spite_slot_{object_slot_counter}"
}

func generate_into(
    expression: Syntax.Expressions.Expression,
    study: ObjectEscape,
    slot: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var outer_depth = into_claim_depth
    var outer_name = into_claim_name
    var outer_slot = into_claim_slot
    var outer_owner = into_claim_owner
    var outer_function = into_claim_function
    into_claim_depth = expression_depth + 1
    into_claim_name = study.claim_name
    into_claim_slot = slot
    into_claim_owner = study.claim_owner
    into_claim_function = study.claim_function
    var saved_counter = temporary_counter
    var result = generate_expression(expression, scope, class_information)
    into_claim_depth = outer_depth
    into_claim_name = outer_name
    into_claim_slot = outer_slot
    into_claim_owner = outer_owner
    into_claim_function = outer_function
    into_claimed = into_claimed_slot == slot
    into_claimed_slot = ""
    if not into_claimed {
        rewind_temporaries(saved_counter)
    }
    result.owning_override = true
    return result
}

func argument_in_frame(
    argument: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    lender_class: Analysis.ClassInfo?,
    lender_function: Analysis.FunctionInfo?,
    index: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if not lender_class or not lender_function or not may_be_fresh(argument) {
        return ""
    }
    if not objects_in_frame_allowed(class_information) {
        return ""
    }
    var expected_reference = type_shape.as_class_ref(expected_type)
    if not expected_reference {
        return ""
    }
    var study = object_study(scope, class_information)
    var made = study.fresh_class(argument)
    if not made {
        return ""
    }
    if made.c_name != expected_reference.c_name {
        return ""
    }
    if not object_frames.lends(this, lender_class, lender_function, index) {
        return ""
    }
    var slot = next_object_slot()
    builder.add_user("{made.c_name} {slot};")
    var into = generate_into(argument, study, "&{slot}", scope, class_information)
    if not into_claimed {
        return ""
    }
    return into.code
}

func receiver_in_frame(
    object_ast: Syntax.Expressions.Expression,
    function_name: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert may_be_fresh(object_ast) and not function_name.is_empty()
    assert objects_in_frame_allowed(class_information)
    var study = object_study(scope, class_information)
    var made = study.fresh_class(object_ast)
    assert made
    var function = made.find_function(function_name)
    assert function
    assert object_frames.lends(this, made, function, -1)
    var slot = next_object_slot()
    builder.add_user("{made.c_name} {slot};")
    var into = generate_into(object_ast, study, "&{slot}", scope, class_information)
    assert into_claimed
    into.owning_override = false
    return into
}

func lists_instances(qualified_name: String): Boolean {
    if not instance_lists_studied {
        instance_lists_studied = true
        classes.each(study_instance_lists)
    }
    return every_class_listed or instance_listed_names.contains(qualified_name)
}

func study_instance_lists(information: Analysis.ClassInfo) {
    instance_study_owner = information.qualified_dotted
    information.declared_functions.each(study_function_instance_lists)
}

func study_function_instance_lists(function: Analysis.FunctionInfo) {
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(function.body, expressions)
    expressions.each(note_instance_lists)
}

func note_instance_lists(expression: Syntax.Expressions.Expression) {
    switch expression {
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            if expression.name == "instances" {
                note_listed_class(expression.object)
            }
            note_instance_lists(expression.object)
        }
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            note_instance_lists(expression.callee)
            expression.arguments.each(note_instance_lists)
        }
        Syntax.Expressions.GenericCallExpression: expression.arguments.each(note_instance_lists)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            note_instance_lists(expression.left)
            note_instance_lists(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            note_instance_lists(expression.operand)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            note_instance_lists(expression.object)
            note_instance_lists(expression.index)
        }
        Syntax.Expressions.ListLiteralExpression: expression.elements.each(note_element_instance_lists)
        Syntax.Expressions.StringLiteralExpression: {
            if expression.value.contains("instances") {
                list_every_class("a text in '{instance_study_owner}' names 'instances'")
            }
        }
        _: return
    }
}

func note_element_instance_lists(element: Syntax.Expressions.ListElement) {
    crash element.value
    note_instance_lists(element.value)
}

func note_listed_class(listed: Syntax.Expressions.Expression) {
    var saved_owner = current_owner
    current_owner = instance_study_owner
    var found = try_resolve_static_path(listed, instance_study_owner)
    current_owner = saved_owner
    if found {
        instance_listed_names.append(found.qualified_dotted)
        return
    }
    var named = shape.as_identifier(listed)
    if named {
        instance_listed_names.append(named.name)
        return
    }
    var member = shape.as_member(listed)
    if member {
        instance_listed_names.append(member.name)
        return
    }
    list_every_class("'{instance_study_owner}' reads '.instances' of a class it does not name")
}

func list_every_class(cause: String) {
    if not every_class_listed {
        every_class_listed_by = cause
    }
    every_class_listed = true
}

func variadic_list(expected_types: List<Analysis.SpiteType>): Analysis.SpiteType? {
    assert not expected_types.is_empty()
    var last_type = expected_types.last()
    var listed = type_shape.as_list(last_type)
    if listed {
        if listed.is_variadic {
            return last_type
        }
    }
    return null
}

func generate_spread_arguments(
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    variadic: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var result = List<String>()
    var fixed_count = expected_types.count() - 1
    if arguments_ast.count() < fixed_count {
        report("this call passes {arguments_ast.count()} argument(s), but at least {fixed_count} are expected")
        return result
    }
    var elements = List<Syntax.Expressions.ListElement>()
    var index = 0
    while index < arguments_ast.count() {
        if index < expected_types.count() - 1 {
            var stored_code = coerce_for_store(arguments_ast[index], expected_types[index], scope, class_information)
            result.append(stored_code)
        } else {
            var element = Syntax.Expressions.ListElement(arguments_ast[index])
            elements.append(element)
        }
        index = index + 1
    }
    var whole_list = whole_list_passed(elements, variadic, scope, class_information)
    if whole_list {
        report(
            "this call passes a whole {type_display_name(whole_list)}, but the last parameter is written with '...', so it takes the values one by one: pass the elements themselves, separated by commas",
        )
        return result
    }
    if framing_variadic(fixed_count) {
        var framed_code = framed_variadic(elements, variadic, scope, class_information)
        result.append(framed_code)
        return result
    }
    var gathered: Syntax.Expressions.Expression = Syntax.Expressions.ListLiteralExpression(elements)
    var gathered_code = coerce_for_store(gathered, variadic, scope, class_information)
    result.append(gathered_code)
    return result
}

func framing_variadic(variadic_index: Integer): Boolean {
    if not frame_variadic_allowed or conditional_depth != 0 or resumable_mode or argument_callee.is_empty() {
        return false
    }
    var key = "{argument_callee}#{variadic_index}"
    if read_list_answers.has(key) {
        return read_list_answers[key] == true
    }
    var answer = callee_only_reads(argument_callee, variadic_index)
    read_list_answers[key] = answer
    return answer
}

func callee_only_reads(callee_c_name: String, variadic_index: Integer): Boolean {
    var class_index = 0
    while class_index < classes.count() {
        var owner = classes[class_index]
        var function_index = 0
        while function_index < owner.declared_functions.count() {
            var function = owner.declared_functions[function_index]
            if function.c_name == callee_c_name {
                if is_hot_class(owner) or not function.has_body {
                    return false
                }
                var names = List<String>()
                var parameter_lists = List<List<String>>()
                var bodies = List<List<Syntax.Statements.Statement>>()
                collect_list_parameters(owner, names, parameter_lists, bodies)
                var read_lists = placement.study_read_lists(names, parameter_lists, bodies)
                return read_lists.contains("{function.name}#{variadic_index}")
            }
            function_index = function_index + 1
        }
        class_index = class_index + 1
    }
    return false
}

func collect_list_parameters(
    owner: Analysis.ClassInfo,
    names: List<String>,
    parameter_lists: List<List<String>>,
    bodies: List<List<Syntax.Statements.Statement>>,
) {
    var index = 0
    while index < owner.declared_functions.count() {
        var function = owner.declared_functions[index]
        if function.has_body and not function.is_constructor {
            names.append(function.name)
            var list_names = list_parameter_names(function)
            parameter_lists.append(list_names)
            bodies.append(function.body)
        }
        index = index + 1
    }
}

func list_parameter_names(function: Analysis.FunctionInfo): List<String> {
    var names = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        if type_shape.as_list(parameter_type) {
            names.append(parameter.name)
        } else {
            names.append("")
        }
        index = index + 1
    }
    return names
}

func framed_variadic(
    elements: List<Syntax.Expressions.ListElement>,
    variadic: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var gathered_list = type_shape.as_list(variadic)
    crash gathered_list
    var element = gathered_list.element
    var list_name = ensure_list(element)
    ensure_framed_list_helper(list_name)
    framed_list_counter = framed_list_counter + 1
    var framed = "spite_framed_{framed_list_counter}"
    var element_c_type = c_type_name(element)
    var element_count = elements.count()
    var slots = element_count
    if slots == 0 {
        slots = 1
    }
    builder.add_user("{list_name} {framed}; {element_c_type} {framed}_items[{slots}]; int32_t {framed}_count = 0;")
    var lines = List<String>()
    var index = 0
    while index < elements.count() {
        var listed = elements[index]
        crash listed.value
        var element_code = coerce_for_store(listed.value, element, scope, class_information)
        lines.append("{framed}_items[{index}] = {element_code};")
        index = index + 1
    }
    lines.append("{framed}_count = {element_count};")
    lines.append("{list_name}___framed(&{framed}, (int64_t)(intptr_t){framed}_items, {element_count});")
    if type_needs_drop(element) {
        var released = release_call(element, "{framed}_items[spite_index]")
        framed_cleanups.append(
            "for (int32_t spite_index = 0; spite_index < {framed}_count; spite_index = spite_index + 1) \{ {released}; }",
        )
    }
    return "(\{ {lines.join(" ")} })"
}

func frames_local_list(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if keeps_internals or hot_reload or resumable_mode or remote_loop_port != 0 {
        return false
    }
    if scope.entry_names.contains(declaration.name) {
        return false
    }
    crash declaration.value
    var literal = shape.as_list_literal(declaration.value)
    var literal_count = 0
    if literal {
        literal_count = literal.elements.count()
        if literal_count <= 0 and not declaration.type_reference {
            return false
        }
    } else if not makes_empty_list(declaration.value) {
        return false
    }
    if not declares_here(declaration) {
        return false
    }
    var start = borrow_index + 1
    var appended = counted_appends(declaration.name, borrow_statements, start)
    var capacity = literal_count + appended
    if capacity > 256 {
        report_list_on_heap(declaration, "its {capacity} items are more than the 256 a list in the frame holds")
        return false
    }
    if not rest_only_reads(declaration.name, borrow_statements, start, class_information) {
        report_list_let_go(declaration, start)
        return false
    }
    var declared_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
    var listed = type_shape.as_list(declared_type)
    if not listed {
        return false
    }
    var element = listed.element
    var constant = false
    if literal {
        constant = appended == 0 and literal_is_constant(literal, element)
    }
    if not constant and capacity > 16 {
        report_list_on_heap(
            declaration,
            "its {capacity} items are more than the 16 a list in the frame holds when they are not all constants",
        )
        return false
    }
    var list_name = ensure_list(element)
    if not framed_list_helpers.contains(list_name) {
        ensure_framed_list_helper(list_name)
    }
    framed_list_counter = framed_list_counter + 1
    var framed = "spite_framed_{framed_list_counter}"
    var element_code = c_type_name(element)
    var slots = capacity
    if slots == 0 {
        slots = 1
    }
    if constant {
        crash literal
        var initializers = constant_initializers(literal, element, scope, class_information)
        builder.add_user("static const {element_code} {framed}_items[{slots}] = \{ {initializers} };")
    } else {
        builder.add_user("{element_code} {framed}_items[{slots}];")
        fill_framed_items(framed, literal, element, scope, class_information)
    }
    var local_code = c_value_name(declaration.name)
    builder.add_user("{list_name} {framed};")
    builder.add_user(
        "{list_name}* {local_code} = {list_name}___framed(&{framed}, (int64_t)(intptr_t){framed}_items, {literal_count});",
    )
    if capacity != literal_count {
        builder.add_user("{framed}.capacity_ = {capacity};")
    }
    scope.declare_owned(declaration.name, declared_type)
    var owned_local = scope.owned.last()
    crash owned_local
    owned_local.framed = true
    if not constant and type_needs_drop(element) {
        var cleared = list_function(element, "clear")
        owned_local.framed_cleanup = "{cleared}({local_code})"
    }
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    return true
}

func frames_local_object(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if not objects_in_frame_allowed(class_information) {
        return false
    }
    if scope.entry_names.contains(declaration.name) {
        return false
    }
    crash declaration.value
    if not may_be_fresh(declaration.value) or not declares_here(declaration) {
        return false
    }
    var study = object_study(scope, class_information)
    study.counted_allowed = true
    var made = study.fresh_class(declaration.value)
    if not made {
        report_unframed_value(declaration, study)
        return false
    }
    if declaration.type_reference {
        var written_type = resolve_type(declaration.type_reference, class_information.qualified_dotted)
        if not written_type {
            return false
        }
        var written_reference = type_shape.as_class_ref(written_type)
        if not written_reference {
            return false
        }
        if written_reference.c_name != made.c_name {
            return false
        }
    }
    var returning = current_return_c_name == made.c_name
    var follower = object_study(scope, class_information)
    follower.counted_allowed = true
    follower.follow_local(declaration.name, made, returning)
    if not follower.stays_after(borrow_statements, borrow_index + 1) {
        report_local_let_go(declaration, made, follower.let_go)
        return false
    }
    var slot_code = "spite_result"
    var in_result = into_function_active and returning and result_slot_local.is_empty()
    if not in_result {
        var slot = next_object_slot()
        builder.add_user("{made.c_name} {slot};")
        slot_code = "&{slot}"
    }
    var into = generate_into(declaration.value, study, slot_code, scope, class_information)
    if not into_claimed {
        return false
    }
    if in_result {
        result_slot_local = declaration.name
    }
    builder.add_user("{made.c_name}* {c_value_name(declaration.name)} = {into.code};")
    var declared_type = class_type_of(made)
    scope.declare_owned(declaration.name, declared_type)
    var owned_local = scope.owned.last()
    crash owned_local
    owned_local.framed = true
    owned_local.framed_object = true
    if object_frames.holds_counted(this, made) and not in_result {
        owned_local.framed_cleanup = "{made.c_name}___unframe({c_value_name(declaration.name)})"
    }
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    return true
}

func report_list_on_heap(declaration: Syntax.Statements.VariableDeclaration, reason: String) {
    optimization_report.list_on_heap(current_function_c_name, current_path, declaration.line, declaration.name, reason)
}

func report_list_let_go(declaration: Syntax.Statements.VariableDeclaration, start: Integer) {
    assert optimization_report.recording
    var index = start
    while index < borrow_statements.count() {
        var statement = borrow_statements[index]
        if not appends_to(declaration.name, statement) and not placement.statement_only_reads(declaration.name, statement) {
            if optimization_report.filled_in_loop(declaration.name, statement) {
                var line = statement_line(statement)
                report_list_on_heap(
                    declaration,
                    "line {line} appends to it in a loop, so how many items it holds is not known while compiling",
                )
                return
            }
            var reason = optimization_report.let_go_reason(this, statement)
            report_list_on_heap(declaration, "{reason}, and a list in the frame is only read once it is filled")
            return
        }
        index = index + 1
    }
}

func copied_value(value: Syntax.Expressions.Expression): Boolean {
    var call = shape.as_call(value)
    if not call or not call.arguments.is_empty() {
        return false
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    return member.name == "copy" or member.name == "deep_copy"
}

func called_owner(value: Syntax.Expressions.Expression, study: ObjectEscape): Analysis.ClassInfo? {
    var call = shape.as_call(value)
    assert call
    var resolved = study.resolve_call(call)
    assert resolved
    return resolved.owner
}

func report_unframed_value(declaration: Syntax.Statements.VariableDeclaration, study: ObjectEscape) {
    assert optimization_report.recording
    crash declaration.value
    var owner = called_owner(declaration.value, study)
    assert owner
    if copied_value(declaration.value) {
        var copy_text = optimization_report.statement_text(declaration)
        var copy_reason = optimization_report.copy_refusal(this, owner)
        optimization_report.copy_kept(current_function_c_name, current_path, declaration.line, copy_text, copy_reason)
        return
    }
    var call = shape.as_call(declaration.value)
    crash call
    var resolved = study.resolve_call(call)
    assert resolved
    assert resolved.constructs
    var refused = optimization_report.class_refusal(this, owner)
    if not refused.is_empty() {
        optimization_report.object_on_heap(
            current_function_c_name,
            current_path,
            declaration.line,
            declaration.name,
            owner.qualified_dotted,
            refused,
        )
    }
}

func report_local_let_go(
    declaration: Syntax.Statements.VariableDeclaration,
    made: Analysis.ClassInfo,
    let_go: Syntax.Statements.Statement?,
) {
    assert optimization_report.recording
    crash declaration.value
    var reason = optimization_report.let_go_reason(this, let_go)
    if copied_value(declaration.value) {
        var copy_text = optimization_report.statement_text(declaration)
        optimization_report.copy_kept(current_function_c_name, current_path, declaration.line, copy_text, reason)
        return
    }
    optimization_report.object_on_heap(
        current_function_c_name,
        current_path,
        declaration.line,
        declaration.name,
        made.qualified_dotted,
        reason,
    )
}

func framed_object_name(expression: Syntax.Expressions.Expression, scope: Scope): String {
    var named = shape.as_identifier(expression)
    if not named {
        return ""
    }
    if not scope.framed_object(named.name) {
        return ""
    }
    return named.name
}

func stores_framed_object(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash assignment.target
    crash assignment.value
    var name = framed_object_name(assignment.target, scope)
    if name.is_empty() {
        return false
    }
    var held_type = scope.written_type(name)
    if not held_type {
        return false
    }
    var held_reference = type_shape.as_class_ref(held_type)
    if not held_reference {
        return false
    }
    var c_name = held_reference.c_name
    var local = c_value_name(name)
    var study = object_study(scope, class_information)
    study.counted_allowed = true
    var made = study.fresh_class(assignment.value)
    var held_class = find_class_by_c_name(c_name)
    crash held_class
    var counted = object_frames.holds_counted(this, held_class)
    if made {
        if made.c_name == c_name {
            var slot = next_object_slot()
            builder.add_user("{c_name} {slot};")
            var into = generate_into(assignment.value, study, "&{slot}", scope, class_information)
            if into_claimed {
                var filled = next_temporary()
                builder.add_user("{c_name}* {filled} = {into.code};")
                if counted {
                    builder.add_user("{c_name}___unframe({local});")
                }
                builder.add_user("{c_name}___copy_fields({local}, {filled});")
                if counted {
                    builder.add_user("{c_name}___unframe({filled});")
                }
                return true
            }
        }
    }
    var value_code = coerce_for_store(assignment.value, held_type, scope, class_information)
    var temporary = next_temporary()
    builder.add_user("{c_name}* {temporary} = {value_code};")
    if counted {
        builder.add_user("{c_name}___unframe({local});")
    }
    builder.add_user("{c_name}___copy_fields({local}, {temporary});")
    builder.add_user("{release_call(held_type, temporary)};")
    return true
}

func returns_object_in_frame(
    value: Syntax.Expressions.Expression,
    return_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var returned_reference = type_shape.as_class_ref(return_type)
    if not returned_reference {
        return false
    }
    var returned_class = find_class_by_c_name(returned_reference.c_name)
    if not returned_class {
        return false
    }
    var c_name = returned_class.c_name
    var framed_name = framed_object_name(value, scope)
    if into_function_active {
        ensure_frame_helpers(returned_class)
        if not framed_name.is_empty() {
            scope.mark_used(framed_name)
            if framed_name != result_slot_local {
                builder.add_user(
                    "{c_name}___copy_fields({c_name}___framed(spite_result), {c_value_name(framed_name)});",
                )
            }
            emit_scope_drops(scope, true)
            builder.add_user("return spite_result;")
            return true
        }
        if returns_made_in_slot(value, returned_class, scope, class_information) {
            return true
        }
        if optimization_report.recording {
            var made_text = Syntax.SourcePrinter().source_expression(value)
            var made_label = type_display_name(return_type)
            optimization_report.object_on_heap(
                current_function_c_name,
                current_path,
                current_line,
                made_text,
                made_label,
                "the caller keeps the answer in its frame, but this value is not made fresh here, so it is made on the heap and copied into the caller's slot",
            )
        }
        var value_code = coerce_for_store(value, return_type, scope, class_information)
        var temporary = next_temporary()
        builder.add_user("{c_name}* {temporary} = {value_code};")
        builder.add_user("{c_name}___copy_fields({c_name}___framed(spite_result), {temporary});")
        builder.add_user("{release_call(return_type, temporary)};")
        emit_scope_drops(scope, true)
        builder.add_user("return spite_result;")
        return true
    }
    if framed_name.is_empty() {
        return false
    }
    ensure_frame_helpers(returned_class)
    scope.mark_used(framed_name)
    var moved = next_temporary()
    if object_frames.holds_counted(this, returned_class) {
        var framed_local = scope.framed_local(framed_name)
        crash framed_local
        builder.add_user("{c_name}* {moved} = {c_name}___moved({c_value_name(framed_name)});")
        var cleanup = framed_local.framed_cleanup
        framed_local.framed_cleanup = ""
        emit_scope_drops(scope, true)
        framed_local.framed_cleanup = cleanup
        builder.add_user("return {moved};")
        return true
    }
    builder.add_user("{c_name}* {moved} = {c_name}___allocate();")
    builder.add_user("{c_name}___copy_fields({moved}, {c_value_name(framed_name)});")
    emit_scope_drops(scope, true)
    builder.add_user("return {moved};")
    return true
}

func returns_made_in_slot(
    value: Syntax.Expressions.Expression,
    returned_class: Analysis.ClassInfo,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var study = object_study(scope, class_information)
    var made = study.fresh_class(value)
    if not made {
        return false
    }
    if made.c_name != returned_class.c_name {
        return false
    }
    var c_name = returned_class.c_name
    var slot_code = "spite_result"
    if not result_slot_local.is_empty() {
        var slot = next_object_slot()
        builder.add_user("{c_name} {slot};")
        slot_code = "&{slot}"
    }
    var into = generate_into(value, study, slot_code, scope, class_information)
    if not into_claimed {
        return false
    }
    var temporary = next_temporary()
    builder.add_user("{c_name}* {temporary} = {into.code};")
    if slot_code != "spite_result" {
        builder.add_user("{c_name}___copy_fields({c_name}___framed(spite_result), {temporary});")
        builder.add_user("{temporary} = spite_result;")
    }
    emit_scope_drops(scope, true)
    builder.add_user("return {temporary};")
    return true
}

func declares_here(declaration: Syntax.Statements.VariableDeclaration): Boolean {
    if borrow_index >= borrow_statements.count() {
        return false
    }
    var here = shape.as_variable_declaration(borrow_statements[borrow_index])
    if not here {
        return false
    }
    return here.name == declaration.name and here.line == declaration.line
}

func makes_empty_list(value: Syntax.Expressions.Expression): Boolean {
    var made = shape.as_generic_call(value)
    if not made {
        return false
    }
    crash made.callee
    if not is_identifier_named(made.callee, "List") {
        return false
    }
    return made.type_arguments.count() == 1 and made.arguments.is_empty()
}

func counted_appends(name: String, statements: List<Syntax.Statements.Statement>, start: Integer): Integer {
    var appended = 0
    var index = start
    while index < statements.count() {
        if appends_to(name, statements[index]) {
            appended = appended + 1
        }
        index = index + 1
    }
    return appended
}

func appends_to(name: String, statement: Syntax.Statements.Statement): Boolean {
    var expression_statement = shape.as_expression_statement(statement)
    if not expression_statement {
        return false
    }
    crash expression_statement.value
    var call = shape.as_call(expression_statement.value)
    if not call {
        return false
    }
    if call.arguments.count() != 1 {
        return false
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    if member.name != "append" {
        return false
    }
    crash member.object
    if not is_identifier_named(member.object, name) {
        return false
    }
    return placement.expression_only_reads(name, call.arguments[0])
}

func rest_only_reads(
    name: String,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    class_information: Analysis.ClassInfo,
): Boolean {
    use_class_read_lists(class_information)
    var index = start
    while index < statements.count() {
        if not appends_to(name, statements[index]) and not placement.statement_only_reads(name, statements[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

func use_class_read_lists(class_information: Analysis.ClassInfo) {
    if class_read_lists[class_information.c_name] {
        placement.read_lists = class_read_lists[class_information.c_name].split("\n")
        return
    }
    var names = List<String>()
    var parameter_lists = List<List<String>>()
    var bodies = List<List<Syntax.Statements.Statement>>()
    collect_list_parameters(class_information, names, parameter_lists, bodies)
    var read_lists = placement.study_read_lists(names, parameter_lists, bodies)
    var joined = read_lists.join("\n")
    class_read_lists[class_information.c_name] = joined
}

func literal_is_constant(literal: Syntax.Expressions.ListLiteralExpression, element: Analysis.SpiteType): Boolean {
    var index = 0
    while index < literal.elements.count() {
        var element_ast = literal.elements[index].value
        crash element_ast
        if not is_constant_element(element_ast, element) {
            return false
        }
        index = index + 1
    }
    return true
}

func is_constant_element(element_ast: Syntax.Expressions.Expression, element: Analysis.SpiteType): Boolean {
    if shape.as_string_literal(element_ast) {
        if not type_shape.as_string(element) {
            return false
        }
        return true
    }
    if not type_shape.as_scalar(element) {
        return false
    }
    if shape.as_integer_literal(element_ast) or shape.as_float_literal(element_ast) {
        return true
    }
    return shape.is_true_literal(element_ast) or shape.is_false_literal(element_ast)
}

func constant_initializers(
    literal: Syntax.Expressions.ListLiteralExpression,
    element: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var initializers = List<String>()
    var index = 0
    while index < literal.elements.count() {
        var element_ast = literal.elements[index].value
        crash element_ast
        var text = shape.as_string_literal(element_ast)
        if text {
            initializers.append("SPITE_STATIC_STRING(\"{escape_c_string(text.value)}\", {text.value.length()})")
        } else {
            var element_code = coerce_for_store(element_ast, element, scope, class_information)
            initializers.append(element_code)
        }
        index = index + 1
    }
    return initializers.join(", ")
}

func fill_framed_items(
    framed: String,
    literal: Syntax.Expressions.ListLiteralExpression?,
    element: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert literal
    var index = 0
    while index < literal.elements.count() {
        var element_ast = literal.elements[index].value
        crash element_ast
        var element_code = coerce_for_store(element_ast, element, scope, class_information)
        builder.add_user("{framed}_items[{index}] = {element_code};")
        index = index + 1
    }
}

func ensure_framed_list_helper(list_name: String) {
    assert not framed_list_helpers.contains(list_name)
    framed_list_helpers.append(list_name)
    var list_class = find_class_by_c_name(list_name)
    crash list_class
    builder.add_prototype("static {list_name}* {list_name}___framed({list_name}* self, int64_t items, int32_t count);")
    builder.add_support(
        "static {list_name}* {list_name}___framed({list_name}* self, int64_t items, int32_t count) \{\n{list_name}___init(self);\nself->header.ref_count = 2;\nself->header.class_id = {list_class.class_id};\nself->items_ = items;\nself->item_count_ = count;\nself->capacity_ = count;\nreturn self;\n}",
    )
}

func whole_list_passed(
    elements: List<Syntax.Expressions.ListElement>,
    variadic: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    assert elements.count() == 1
    var gathered_list = type_shape.as_list(variadic)
    crash gathered_list
    var element_type = gathered_list.element
    assert not type_shape.as_list(element_type) and not is_shape_type(element_type)
    var only = elements.first()
    crash only
    crash only.value
    var passed_type = lookup_static_type(only.value, scope, class_information)
    assert passed_type
    assert type_shape.as_list(passed_type)
    return passed_type
}

func parameter_types_of(parameters: List<Analysis.ParamInfo>): List<Analysis.SpiteType> {
    return parameters.map_get_types()
}

func singleton_call(target_class: Analysis.ClassInfo): String {
    var function_c_name = "spite_singleton_{target_class.c_name}"
    var display_name = singleton_display_name(target_class)
    return singleton_slot_call(target_class, function_c_name, display_name, "")
}

func singleton_slot_call(
    target_class: Analysis.ClassInfo,
    function_c_name: String,
    display_name: String,
    argument_code: String,
): String {
    var keyed = not argument_code.is_empty()
    if not keyed and not singleton_names.contains(function_c_name) and is_stateless_singleton(target_class) {
        singleton_names.append(function_c_name)
        builder.add_prototype("{target_class.c_name}* {function_c_name}(void);")
        builder.add_support(
            "{target_class.c_name}* {function_c_name}(void) \{\nstatic {target_class.c_name} spite_object = \{ \{ 1, {target_class.class_id} } };\nreturn &spite_object;\n}",
        )
    }
    if not singleton_names.contains(function_c_name) {
        singleton_names.append(function_c_name)
        singleton_classes.append(target_class)
        singleton_functions.append(function_c_name)
        singleton_displays.append(display_name)
        builder.add_typedef("static {target_class.c_name}* {function_c_name}_cache = 0;")
        builder.add_typedef("static bool {function_c_name}_destroyed = false;")
        builder.add_typedef("static int32_t {function_c_name}_lock = 0;")
        builder.add_prototype("{target_class.c_name}* {function_c_name}(void);")
        var lines = List<String>()
        lines.append("static void {function_c_name}_teardown(void) \{")
        lines.append("{target_class.c_name}* object = {function_c_name}_cache;")
        lines.append("{function_c_name}_cache = 0;")
        if not target_class.holds_nothing {
            lines.append("{function_c_name}_destroyed = true;")
        }
        lines.append("{target_class.c_name}___destroy(object);")
        lines.append("}")
        lines.append("{target_class.c_name}* {function_c_name}(void) \{")
        var shown_name = escape_c_string(display_name)
        lines.append("{target_class.c_name}* found = SPITE_SINGLETON_FOUND({function_c_name}_cache);")
        lines.append("if (found != 0) return found;")
        lines.append("spite_singleton_check_circle(\"{shown_name}\");")
        lines.append("SPITE_LOCK({function_c_name}_lock);")
        lines.append("if ({function_c_name}_cache == 0) \{")
        lines.append(
            "if ({function_c_name}_destroyed) spite_singleton_used_after_exit(\"{escape_c_string(target_class.qualified_dotted)}\");",
        )
        lines.append("spite_singleton_making(\"{shown_name}\");")
        lines.append("{target_class.c_name}* made = {target_class.c_name}___make({argument_code});")
        lines.append("spite_singleton_made();")
        lines.append("spite_singleton_created({function_c_name}_teardown);")
        lines.append("SPITE_SINGLETON_PUBLISH({function_c_name}_cache, made);")
        lines.append("}")
        lines.append("SPITE_UNLOCK({function_c_name}_lock);")
        lines.append("return {function_c_name}_cache;")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    return "{function_c_name}()"
}

func singleton_with_arguments(
    target_class: Analysis.ClassInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var printer = Syntax.SourcePrinter()
    var texts = List<String>()
    var index = 0
    while index < arguments_ast.count() {
        var argument = arguments_ast[index]
        if not is_singleton_key_literal(argument) {
            var argument_text = printer.source_expression(argument)
            report(
                "'{argument_text}' is not a literal: a singleton's arguments are literals the compiler reads, because each distinct argument list is its own instance of '{target_class.simple_name}', made the first time it is asked for",
            )
            return ""
        }
        var literal_text = printer.source_expression(argument)
        texts.append(literal_text)
        index = index + 1
    }
    var saved_counter = temporary_counter
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    rewind_temporaries(saved_counter)
    if argument_codes.count() != arguments_ast.count() {
        return ""
    }
    var display_name = "{singleton_display_name(target_class)}({texts.join(", ")})"
    var slot_number = singleton_argument_slots.count()
    if singleton_argument_slots[display_name] {
        slot_number = singleton_argument_slots[display_name]
    } else {
        singleton_argument_slots[display_name] = slot_number
    }
    var function_c_name = "spite_singleton_{target_class.c_name}___with_{slot_number}"
    var argument_code = argument_codes.join(", ")
    return singleton_slot_call(target_class, function_c_name, display_name, argument_code)
}

func is_singleton_key_literal(argument: Syntax.Expressions.Expression): Boolean {
    var negated = shape.as_unary(argument)
    if negated {
        crash negated.operand
        var negated_integer = shape.as_integer_literal(negated.operand)
        var negated_float = shape.as_float_literal(negated.operand)
        return negated.operator == 'negate' and (negated_integer or negated_float)
    }
    if shape.as_integer_literal(argument) or shape.as_float_literal(argument) {
        return true
    }
    if shape.as_string_literal(argument) or shape.as_enum_literal(argument) {
        return true
    }
    return shape.is_true_literal(argument) or shape.is_false_literal(argument)
}

func hands_function_to_task(
    target_class: Analysis.ClassInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
): Boolean {
    var task = target_class.qualified_dotted == "Concurrent" or target_class.qualified_dotted == "Parallel"
    if not task or arguments_ast.count() != 1 {
        return false
    }
    var member = shape.as_member(arguments_ast[0])
    if member {
        return true
    }
    var identifier = shape.as_identifier(arguments_ast[0])
    if identifier {
        return true
    }
    return false
}

func generate_constructor_call(
    target_class: Analysis.ClassInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if target_class.c_name == "DynamicLibrary" {
        return generate_library_constructor(arguments_ast)
    }
    if target_class.qualified_dotted == "ForeignCallback" {
        return generate_foreign_callback(target_class, arguments_ast, scope, class_information)
    }
    if target_class.qualified_dotted == "Parallel" and target_class.is_instantiated and not generating_overlap {
        check_parallel_work(arguments_ast, scope, class_information)
    }
    if target_class.is_generic_template {
        var inferred_class = inferred_instance(target_class, arguments_ast, scope, class_information)
        if inferred_class {
            return generate_constructor_call(inferred_class, arguments_ast, scope, class_information)
        }
        report(
            "'{target_class.simple_name}' takes {target_class.codegen_names.count()} codegen value(s), in this order: ${target_class.codegen_names.join(", $")}. Write them between < and > before the arguments",
        )
        return void_result()
    }
    var expected_types = List<Analysis.SpiteType>()
    if target_class.constructor {
        expected_types = parameter_types_of(target_class.constructor.parameters)
        note_wait_edge(target_class.constructor.c_name)
    }
    if target_class.is_singleton {
        var singleton_code = ""
        if expected_types.is_empty() and arguments_ast.is_empty() {
            singleton_code = singleton_call(target_class)
        } else {
            singleton_code = singleton_with_arguments(
                target_class,
                arguments_ast,
                expected_types,
                scope,
                class_information,
            )
            if singleton_code.is_empty() {
                return void_result()
            }
        }
        var class_type = Analysis.Types.ClassRefType(target_class.c_name)
        var shared = ExpressionResult(singleton_code, class_type)
        shared.owning_override = true
        return shared
    }
    var starts_concurrent = target_class.qualified_dotted == "Concurrent"
    if starts_concurrent {
        concurrent_arguments = concurrent_arguments + 1
    }
    var hands_over_value = hands_function_to_task(target_class, arguments_ast)
    if hands_over_value {
        task_value_arguments = task_value_arguments + 1
    }
    var into_slot = claimed_slot("{target_class.c_name}___make")
    if target_class.constructor {
        argument_lender_class = target_class
        argument_lender_function = target_class.constructor
    }
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    if hands_over_value {
        task_value_arguments = task_value_arguments - 1
    }
    if starts_concurrent {
        concurrent_arguments = concurrent_arguments - 1
    }
    if into_slot.is_empty() and waits_to_construct(target_class) {
        return waited_construction(target_class, argument_codes)
    }
    var call_code = "{target_class.c_name}___make({argument_codes.join(", ")})"
    if not into_slot.is_empty() {
        ensure_frame_helpers(target_class)
        into_claimed_slot = into_slot
        argument_codes.prepend(into_slot)
        call_code = "{target_class.c_name}___make_into({argument_codes.join(", ")})"
    }
    if target_class.is_value_class {
        if not target_class.constructor {
            report(
                "'{target_class.simple_name}' has no constructor: {with_article(target_class.simple_name)} is written as a literal, or cast from another value by assigning it",
            )
            return void_result()
        }
        var value_type = value_class_type(target_class)
        return ExpressionResult(call_code, value_type)
    }
    var class_type = Analysis.Types.ClassRefType(target_class.c_name)
    return ExpressionResult(call_code, class_type)
}

func inferred_instance(
    template: Analysis.ClassInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var constructor = template_constructor(template)
    assert constructor
    assert constructor.parameters.count() == arguments_ast.count()
    var inferred = Dictionary<String, Analysis.SpiteType>()
    var index = 0
    while index < constructor.parameters.count() {
        var declared = constructor.parameters[index].type_reference
        crash arguments_ast[index]
        if declared and not shape.is_null_literal(arguments_ast[index]) {
            var saved_counter = temporary_counter
            var probe = generate_expression(arguments_ast[index], scope, class_information)
            rewind_temporaries(saved_counter)
            var probe_type = probe.type
            infer_codegen_values(declared, probe_type, inferred)
        }
        index = index + 1
    }
    var types = List<Analysis.SpiteType>()
    var codes = List<String>()
    var texts = List<String>()
    var label = "{template.c_name}_"
    index = 0
    while index < template.codegen_names.count() {
        var codegen_name = template.codegen_names[index]
        assert inferred[codegen_name]
        types.append(inferred[codegen_name])
        codes.append("")
        texts.append("")
        label = "{label}_{type_label(inferred[codegen_name])}"
        index = index + 1
    }
    var existing = find_class_by_c_name(label)
    if existing {
        return existing
    }
    return instantiated_with(template, types, codes, texts, label)
}

func template_constructor(template: Analysis.ClassInfo): Syntax.Statements.FunctionDeclaration? {
    crash discovered_classes[template.entry_index]
    var file = discovered_classes[template.entry_index].file
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_function_declaration(file.statements[statement_index])
        if declaration {
            if declaration.name == template.simple_name {
                return declaration
            }
        }
        statement_index = statement_index + 1
    }
    return null
}

func infer_codegen_values(
    declared: Syntax.Types.Type,
    given: Analysis.SpiteType,
    inferred: Dictionary<String, Analysis.SpiteType>,
) {
    var generic_type = shape.as_generic_type(declared)
    if generic_type {
        var bare_name = without_dollar(generic_type.name)
        if not type_shape.is_void(given) {
            inferred[bare_name] = given
        }
        return
    }
    var named = shape.as_named_type(declared)
    assert named
    if named.path.join(".") == "Dictionary" and named.arguments.count() == 2 {
        infer_dictionary_values(named, given, inferred)
        return
    }
    var declared_inner = only_type_argument(named)
    if declared_inner {
        var given_inner = container_inner_type(named, given)
        if given_inner {
            infer_codegen_values(declared_inner, given_inner, inferred)
        }
        return
    }
    var given_function = type_shape.as_class_ref(given)
    assert given_function
    var declared_path = named.path.join(".")
    assert given_function.has_signature and declared_path == "Spite.Function"
    var index = 0
    while index < named.arguments.count() {
        var type_argument = shape.as_type_argument(named.arguments[index])
        if type_argument {
            if type_argument.value {
                if index == named.arguments.count() - 1 {
                    var returns = returned_type(given_function)
                    infer_codegen_values(type_argument.value, returns, inferred)
                } else if index < given_function.arguments.count() {
                    infer_codegen_values(type_argument.value, given_function.arguments[index], inferred)
                }
            }
        }
        index = index + 1
    }
}

func infer_dictionary_values(
    named: Syntax.Types.NamedType,
    given: Analysis.SpiteType,
    inferred: Dictionary<String, Analysis.SpiteType>,
) {
    var given_dictionary = type_shape.as_dictionary(given)
    assert given_dictionary
    var key_argument = shape.as_type_argument(named.arguments[0])
    var value_argument = shape.as_type_argument(named.arguments[1])
    assert key_argument and value_argument
    if key_argument.value {
        var given_key = given_dictionary.key
        infer_codegen_values(key_argument.value, given_key, inferred)
    }
    assert value_argument.value
    var given_value = given_dictionary.element
    infer_codegen_values(value_argument.value, given_value, inferred)
}

func only_type_argument(named: Syntax.Types.NamedType): Syntax.Types.Type? {
    var declared_path = named.path.join(".")
    assert declared_path == "Nullable" or declared_path == "List" or declared_path == "Dictionary"
    assert named.arguments.count() == 1
    var type_argument = shape.as_type_argument(named.arguments[0])
    assert type_argument
    return type_argument.value
}

func container_inner_type(named: Syntax.Types.NamedType, given: Analysis.SpiteType): Analysis.SpiteType? {
    var declared_path = named.path.join(".")
    if declared_path == "Nullable" {
        var given_nullable = type_shape.as_nullable(given)
        if given_nullable {
            return given_nullable.inner
        }
        return given
    }
    if declared_path == "List" {
        var given_list = type_shape.as_list(given)
        assert given_list
        return given_list.element
    }
    var given_dictionary = type_shape.as_dictionary(given)
    assert given_dictionary
    return given_dictionary.element
}

func returned_type(function: Analysis.Types.ClassRefType): Analysis.SpiteType {
    var nothing_class = find_class_by_qualified("Nothing")
    if function.returns {
        if not type_shape.is_void(function.returns) {
            return function.returns
        }
    }
    crash nothing_class
    return class_type_of(nothing_class)
}

func function_type_from(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    var signature = Analysis.Types.ClassRefType("Spite_Function")
    signature.has_signature = true
    var index = 0
    while index < named.arguments.count() {
        var resolved = resolve_generic_argument(named.arguments[index], current_namespace)
        assert resolved
        if index == named.arguments.count() - 1 {
            signature.returns = resolved
        } else {
            signature.arguments.append(resolved)
        }
        index = index + 1
    }
    var typed: Analysis.SpiteType = signature
    return typed
}

func same_signature(left: Analysis.Types.ClassRefType, right: Analysis.Types.ClassRefType): Boolean {
    if left.has_signature != right.has_signature {
        return false
    }
    if not left.has_signature {
        return true
    }
    if left.arguments.count() != right.arguments.count() {
        return false
    }
    var index = 0
    while index < left.arguments.count() {
        if not types_equal(left.arguments[index], right.arguments[index]) {
            return false
        }
        index = index + 1
    }
    if left.returns {
        if right.returns {
            return types_equal(left.returns, right.returns)
        }
    }
    return false
}

func signature_of(function: Analysis.FunctionInfo): Analysis.SpiteType {
    var signature = Analysis.Types.ClassRefType("Spite_Function")
    signature.has_signature = true
    var index = 0
    while index < function.parameters.count() {
        var parameter_type = function.parameters[index].type
        signature.arguments.append(parameter_type)
        index = index + 1
    }
    var function_return_type = function.return_type
    if type_shape.is_void(function_return_type) {
        signature.returns = Analysis.Types.ClassRefType("Nothing")
    } else {
        signature.returns = function.return_type
    }
    return signature
}

# ../../../docs/optimizations.md#a-loop-whose-passes-write-only-their-own-item-runs-in-bands
func borrows_its_owner(function: Analysis.FunctionInfo): Boolean {
    return function.name.starts_with("spite_band_") and function.name.ends_with("_piece")
}

func function_value(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    owner: ExpressionResult,
    owner_ast: Syntax.Expressions.Expression,
): ExpressionResult {
    report_lending_value(information, function)
    var maker = "spite_function_value_{function.c_name}"
    if task_value_arguments == 0 {
        var described_signature = signature_of(function)
        var value_signature = type_shape.as_class_ref(described_signature)
        crash value_signature
        var value_call = value_call_key(value_signature.arguments, value_signature.returns)
        wait_facts.add_edge(value_call, function.c_name)
        note_value_target(value_call, information, function)
    }
    var starts_work = concurrent_arguments > 0 or not is_library_class(information)
    if function.parameters.is_empty() and starts_work and not task_root_names.contains(function.c_name) {
        task_root_names.append(function.c_name)
        task_root_classes.append(information)
        task_root_functions.append(function)
    }
    note_fact("maker {maker}")
    if not function_value_makers.contains(maker) {
        function_value_makers.append(maker)
        remember_accessed_call(information, function)
        var argument_class = find_class_by_c_name("Spite_Argument")
        if not find_class_by_c_name("Spite_Function") or not argument_class {
            report(
                "a function value needs the standard library: library/spite/function.spite was not found from the working directory",
            )
            return void_result()
        }
        var class_type = class_type_of(argument_class)
        var arguments_list_name = ensure_list(class_type)
        var argument_lines = List<String>()
        var parameter_index = 0
        while parameter_index < function.parameters.count() {
            var parameter = function.parameters[parameter_index]
            var parameter_type = parameter.type
            argument_lines.append(
                "{arguments_list_name}_append(described->_arguments_, Spite_Argument___make({ensure_symbol(parameter.name)}, {class_object_call(parameter_type)}));",
            )
            parameter_index = parameter_index + 1
        }
        var lines = List<String>()
        lines.append("Spite_Function* {maker}({information.c_name}* owner) \{")
        lines.append(
            "Spite_Function* described = Spite_Function___make({ensure_symbol(function.name)}, {returned_class_object_call(function)});",
        )
        add_lazy_arguments(maker, argument_lines, lines)
        if borrows_its_owner(function) {
            lines.append("described->spite_owner = (void*)owner;")
            lines.append("described->spite_release_owner = 0;")
        } else {
            lines.append("described->spite_owner = {information.c_name}___retain(owner);")
            lines.append("described->spite_release_owner = (void (*)(void*)){information.c_name}___release;")
        }
        if function.parameters.count() == 0 {
            lines.append("described->spite_call = (void (*)(void*)){ensure_dropping_call(information, function)};")
        }
        lines.append("described->spite_typed_call = (void*){function.c_name};")
        lines.append("return described;")
        lines.append("}")
        builder.add_prototype("Spite_Function* {maker}({information.c_name}* owner);")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    var code = "{maker}({owner.code})"
    if framing_function_value and not owns(owner, owner_ast) {
        framing_function_value = false
        var framed_signature = signature_of(function)
        var framed = ExpressionResult(
            "&(Spite_Function)\{ .spite_owner = (void*)({owner.code}), .spite_typed_call = (void*){function.c_name} }",
            framed_signature,
        )
        framed.owning_override = false
        return framed
    }
    if owns(owner, owner_ast) {
        var owner_temporary = next_temporary()
        var value_temporary = next_temporary()
        code = "(\{ {information.c_name}* {owner_temporary} = {owner.code}; Spite_Function* {value_temporary} = {maker}({owner_temporary}); {information.c_name}___release({owner_temporary}); {value_temporary}; })"
    }
    var signature = signature_of(function)
    var made = ExpressionResult(code, signature)
    made.owning_override = true
    return made
}

func add_lazy_arguments(maker: String, argument_lines: List<String>, lines: List<String>) {
    assert not argument_lines.is_empty()
    var describer = "{maker}___arguments"
    builder.add_prototype("static void {describer}(Spite_Function* described);")
    builder.add_support("static void {describer}(Spite_Function* described) \{\n{argument_lines.join("\n")}\n}")
    lines.append("described->spite_add_arguments = {describer};")
}

func call_function_value(
    held: ExpressionResult,
    held_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var held_type = held.type
    var signature = type_shape.as_class_ref(held_type)
    crash signature
    var argument_codes = generate_argument_list(arguments_ast, signature.arguments, scope, class_information)
    var value_call = value_call_key(signature.arguments, signature.returns)
    note_wait_edge(value_call)
    var pointer_parameters = List<String>()
    pointer_parameters.append("void*")
    var index = 0
    while index < signature.arguments.count() {
        var c_type_text = c_type_name(signature.arguments[index])
        pointer_parameters.append(c_type_text)
        index = index + 1
    }
    var returned: Analysis.SpiteType = void_type()
    if signature.returns {
        var returns_class = type_shape.as_class_ref(signature.returns)
        var returns_nothing = false
        if returns_class {
            returns_nothing = returns_class.c_name == "Nothing"
        }
        if not returns_nothing {
            returned = signature.returns
        }
    }
    var returned_c = "void"
    if not type_shape.is_void(returned) {
        returned_c = c_type_name(returned)
    }
    if resumable_mode and conditional_depth == 0 and waiting_names.has(value_call) {
        var value_wait = ValueWait(value_call, signature.arguments, returned, pointer_parameters)
        return waited_value_call(held, held_ast, argument_codes, value_wait)
    }
    var function_temporary = next_temporary()
    var call_arguments = argument_codes.copy()
    call_arguments.prepend("{function_temporary}->spite_owner")
    var call_code = "(({returned_c} (*)({pointer_parameters.join(", ")})){function_temporary}->spite_typed_call)({call_arguments.join(", ")})"
    var release = ""
    if owns(held, held_ast) {
        release = " Spite_Function___release({function_temporary});"
    }
    if type_shape.is_void(returned) {
        return ExpressionResult(
            "(\{ Spite_Function* {function_temporary} = {held.code}; {call_code};{release} })",
            returned,
        )
    }
    var result_temporary = next_temporary()
    var called = ExpressionResult(
        "(\{ Spite_Function* {function_temporary} = {held.code}; {returned_c} {result_temporary} = {call_code};{release} {result_temporary}; })",
        returned,
    )
    called.owning_override = true
    return called
}

func generate_own_function_call(
    name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var passed = passed_template(class_information, name)
    if passed {
        return generate_passed_symbol_call(passed, arguments_ast, scope, class_information)
    }
    var found = find_or_instantiate_function(class_information, name)
    if found {
        if item_values_on {
            item_note_call(found, class_information, arguments_ast, scope, class_information)
        }
        var specialised = specialised_call(found, arguments_ast, scope, class_information)
        if specialised {
            return specialised
        }
        if constant_return_names.contains(found.c_name) {
            report_run_time_reflection(found)
            return void_result()
        }
    }
    var held_type = scope.lookup_type(name)
    if not held_type {
        var held_field = class_information.find_field(name)
        if held_field {
            held_type = held_field.type
        }
    }
    if held_type {
        var held_function = type_shape.as_class_ref(held_type)
        if held_function {
            if held_function.has_signature and not found {
                var held_ast: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(name)
                var held = generate_expression(held_ast, scope, class_information)
                return call_function_value(held, held_ast, arguments_ast, scope, class_information)
            }
        }
    }
    if not found and class_information.c_name == "SpiteString" {
        var receiver: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("self")
        var string_spite_type = string_type()
        var self_result = ExpressionResult("self", string_spite_type)
        return generate_string_method(name, self_result, receiver, arguments_ast, scope, class_information)
    }
    if not found {
        var missed = range_miss(class_information, name)
        if name == "print" or name == "println" or name == "echo" or name == "printf" {
            report(
                "this class has no function '{name}': printing goes through the console, so write 'var console = Console()' beside the attributes, then 'console.print(value)'",
            )
        } else if not missed.is_empty() {
            report(missed)
        } else if not misnamed_plural(class_information, name).is_empty() {
            var misnamed = misnamed_plural(class_information, name)
            report(misnamed)
        } else if maths.is_member(name) or not maths.spelled(name).is_empty() {
            report(
                "this class has no function '{name}': maths is a function of the number itself, like 'value.{maths_spelling(name)}()'",
            )
        } else if versions_holding(name) {
            var held = versions_holding(name)
            if held {
                report("this class has no function '{name}': {held}")
            }
        } else if not reported_old_spelling(name) {
            report("this class has no function '{name}'")
        }
        return void_result()
    }
    var function = specialised_for_arguments(class_information, found, arguments_ast, scope, class_information)
    var into_slot = claimed_slot(function.c_name)
    var parameter_types = parameter_types_of(function.parameters)
    held_arguments_blocked = not into_slot.is_empty()
    var called_c_name = lent_variant_name(function.c_name, arguments_ast, parameter_types, scope, class_information)
    held_arguments_blocked = false
    argument_lender_class = class_information
    argument_lender_function = function
    argument_callee = function.c_name
    var argument_codes = generate_argument_list(arguments_ast, parameter_types, scope, class_information)
    argument_callee = ""
    var full_arguments = argument_codes.copy()
    full_arguments.prepend("self")
    if not into_slot.is_empty() and called_c_name == function.c_name {
        called_c_name = ensure_into_variant(class_information, function)
        into_claimed_slot = into_slot
        full_arguments.append(into_slot)
    }
    var function_return_type = function.return_type
    record_call(called_c_name)
    var self_type = value_class_type(class_information)
    var self_result = ExpressionResult("self", self_type)
    self_result.owning_override = false
    var waited = hoisted_wait(called_c_name, self_result, false, argument_codes, function_return_type)
    if waited {
        return waited
    }
    var own_called = ExpressionResult("{called_c_name}({full_arguments.join(", ")})", function_return_type)
    lend_result(own_called, class_information, function)
    return own_called
}

func specialises_shapes(): Boolean {
    return not hot_reload and not read_evaluate_print_loop and remote_loop_port == 0 and not resumable_mode
}

func is_specialisable(function: Analysis.FunctionInfo): Boolean {
    if not function.has_body or function.is_constructor or function.result_slot or function.kept_for_prompt {
        return false
    }
    if not function.lent_parameters.is_empty() or not function.held_parameters.is_empty() {
        return false
    }
    if not function.lent_element.is_empty() or not function.specialised_from.is_empty() {
        return false
    }
    return not asks_function_waits(function.body)
}

func holds_shaped_values(information: Analysis.ClassInfo): Boolean {
    return information.is_container or is_library_class(information) and not information.codegen_types.is_empty()
}

func specialised_shape(function: Analysis.FunctionInfo, index: Integer): Analysis.UnionInfo? {
    crash function.parameters[index]
    var parameter_type = function.parameters[index].type
    var shaped = shape_of(parameter_type)
    assert shaped
    assert not assigns_name(function.body, function.parameters[index].name)
    return shaped
}

func specialised_for_arguments(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.FunctionInfo {
    if not specialises_shapes() or not is_specialisable(function) or holds_shaped_values(owner) {
        return function
    }
    if function.parameters.count() != arguments_ast.count() {
        return function
    }
    if arguments_ast.count() == 1 and spread_template(arguments_ast, class_information) {
        return function
    }
    var types = List<Analysis.SpiteType>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var chosen = parameter.type
        var shaped = specialised_shape(function, index)
        if shaped and not is_row_name(arguments_ast[index], scope) {
            var given = probed_type(arguments_ast[index], scope, class_information)
            if reaches_shape_as_itself(given, shaped) {
                chosen = given
            }
        }
        types.append(chosen)
        index = index + 1
    }
    return specialised_with(owner, function, types)
}

func specialised_with(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    types: List<Analysis.SpiteType>,
): Analysis.FunctionInfo {
    var parameters = List<Analysis.ParamInfo>()
    var label = ""
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        var kept = parameter
        if not types_equal(parameter_type, types[index]) {
            kept = Analysis.ParamInfo(parameter.name, types[index])
            var given_label = exact_type_label(types[index])
            label = "{label}_{index}_{given_label}"
        }
        parameters.append(kept)
        index = index + 1
    }
    if label.is_empty() {
        return function
    }
    var copy_c_name = "{function.c_name}___for{label}"
    var existing = function_by_c_name(owner, copy_c_name)
    if existing {
        return existing
    }
    var copy_return_type = function.return_type
    var copy = Analysis.FunctionInfo(function.name, copy_c_name, parameters, copy_return_type, function.body, false)
    copy.line = function.line
    copy.end_line = function.end_line
    copy.source_path = function.source_path
    copy.symbol_name = function.symbol_name
    copy.symbol_field_name = function.symbol_field_name
    copy.symbol_field_index = function.symbol_field_index
    copy.symbol_field_type = function.symbol_field_type
    copy.symbol_owner_c_name = function.symbol_owner_c_name
    copy.symbol_through_caller = function.symbol_through_caller
    copy.symbol_pattern = function.symbol_pattern
    copy.symbol_function_name = function.symbol_function_name
    copy.symbol_display_name = function.symbol_display_name
    copy.symbol_range = function.symbol_range
    copy.symbol_enum_c_name = function.symbol_enum_c_name
    copy.specialised_from = function.c_name
    owner.declared_functions.append(copy)
    builder.add_prototype("{function_signature(owner, copy)};")
    return copy
}

func dispatches_shapes(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    if not specialises_shapes() or not is_specialisable(function) or information.is_generic_template {
        return false
    }
    if holds_shaped_values(information) {
        return false
    }
    if dispatched_names.has(function.c_name) {
        return false
    }
    var index = 0
    while index < function.parameters.count() {
        var shaped = specialised_shape(function, index)
        if shaped {
            return true
        }
        index = index + 1
    }
    return false
}

func note_dispatcher(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    dispatched_names[function.c_name] = true
    dispatched_owners.append(information)
    dispatched_functions.append(function)
    var position = builder.support_count()
    dispatched_positions.append(position)
    dispatched_texts.append("")
    builder.add_support("")
}

func emit_dispatchers(): Integer {
    var changed = 0
    var index = 0
    while index < dispatched_functions.count() {
        var function = dispatched_functions[index]
        var written = dispatched_texts[index]
        crash written
        if not written.is_empty() or builder.mentions(function.c_name) {
            crash dispatched_owners[index]
            var text = dispatcher_text(dispatched_owners[index], function)
            if text != written {
                crash dispatched_positions[index]
                builder.replace_support(dispatched_positions[index], text)
                dispatched_texts[index] = text
                changed = changed + 1
            }
        }
        index = index + 1
    }
    return changed
}

func dispatcher_text(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var lines = List<String>()
    var signature = function_signature(information, function)
    lines.append("{signature} \{")
    var return_type = function.return_type
    var codes = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var value_name = c_value_name(parameter.name)
        codes.append(value_name)
        index = index + 1
    }
    if scheduler_used or not is_specialisable(function) {
        var passed = codes.copy()
        passed.prepend("self")
        var forwarded = returning_call("{function.c_name}___general({passed.join(", ")})", return_type)
        lines.append(forwarded)
    } else {
        var types = parameter_types_of(function.parameters)
        dispatch_lines(information, function, 0, types, codes, lines)
        lines.append(
            "fputs(\"spite.crash\\t{information.qualified_dotted}.{function.name} was given a value of a class no copy of it was made for\\n\", stderr);",
        )
        lines.append("abort();")
    }
    lines.append("}")
    return lines.join("\n")
}

func returning_call(call: String, return_type: Analysis.SpiteType): String {
    if type_shape.is_void(return_type) {
        return "{call}; return;"
    }
    return "return {call};"
}

func dispatch_lines(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    index: Integer,
    types: List<Analysis.SpiteType>,
    codes: List<String>,
    lines: List<String>,
) {
    if index == function.parameters.count() {
        var copy = specialised_with(information, function, types)
        var passed = codes.copy()
        passed.prepend("self")
        var return_type = function.return_type
        var called = returning_call("{copy.c_name}({passed.join(", ")})", return_type)
        lines.append(called)
        return
    }
    var shaped = specialised_shape(function, index)
    if not shaped {
        dispatch_lines(information, function, index + 1, types, codes, lines)
        return
    }
    crash function.parameters[index]
    var argument = c_value_name(function.parameters[index].name)
    var argument_type = function.parameters[index].type
    var switched = tagged_shape_of(argument_type)
    if switched {
        lines.append("switch (({argument}).tag) \{")
    }
    var member_index = 0
    while member_index < shaped.members.count() {
        var member = shaped.members[member_index]
        var member_type = dispatched_member_type(member)
        if member_type {
            var unboxed = "spite_dispatched_{index}"
            var tested = value_class_test(argument, argument_type, member)
            if switched and member.c_name == "SpiteString" {
                lines.append("case 0: if ((({argument}).plain == 0)) \{")
            } else if switched {
                lines.append("case {member.class_id}: \{")
            } else {
                lines.append("if {tested} \{")
            }
            var unboxing = unbox_line(member, member_type, argument, unboxed, argument_type)
            lines.append(unboxing)
            var member_types = types.copy()
            member_types[index] = member_type
            var member_codes = codes.copy()
            member_codes[index] = unboxed
            dispatch_lines(information, function, index + 1, member_types, member_codes, lines)
            lines.append("}")
            if switched {
                lines.append("break;")
            }
        }
        member_index = member_index + 1
    }
    assert switched
    lines.append("}")
}

func dispatched_member_type(member: Analysis.ClassInfo): Analysis.SpiteType? {
    if member.c_name == "SpiteString" {
        return string_type()
    }
    if boxed_value_types.has(member.c_name) {
        return boxed_value_types[member.c_name]
    }
    assert not member.is_value_class
    return instance_type_of(member)
}

func unbox_line(
    member: Analysis.ClassInfo,
    member_type: Analysis.SpiteType,
    argument: String,
    unboxed: String,
    argument_type: Analysis.SpiteType,
): String {
    var value_c_type = c_type_name(member_type)
    if tagged_shape_of(argument_type) {
        var held = member_value_code(argument, argument_type, member)
        if is_plain_member(member) or not boxed_value_types.has(member.c_name) {
            return "{value_c_type} {unboxed} = {held};"
        }
        var retained_value = retain_call(member_type, held)
        var boxed_object = object_pointer_code(argument, argument_type)
        if member.c_name == "SpiteString" {
            return "{value_c_type} {unboxed} = {retained_value}; spite_string_box_release({boxed_object});"
        }
        return "{value_c_type} {unboxed} = {retained_value}; spite_box_release({boxed_object});"
    }
    if member.c_name == "SpiteString" {
        return "SpiteString {unboxed} = SpiteString___retain(((SpiteBox_SpiteString*)({argument}))->value); spite_string_box_release({argument});"
    }
    if boxed_value_types.has(member.c_name) {
        var value = "((SpiteBox_{member.c_name}*)({argument}))->value"
        if type_needs_drop(member_type) {
            value = retain_call(member_type, value)
        }
        return "{value_c_type} {unboxed} = {value}; spite_box_release({argument});"
    }
    return "{value_c_type} {unboxed} = ({value_c_type})({argument});"
}

func reaches_shape_as_itself(given: Analysis.SpiteType, shaped: Analysis.UnionInfo): Boolean {
    var reaching = reaching_class_of(given)
    if not reaching {
        return false
    }
    if shaped.has_member(reaching.c_name) {
        return true
    }
    var problem = shape_fit_problem(shaped, reaching)
    return problem.is_empty()
}

func reaching_class_of(given: Analysis.SpiteType): Analysis.ClassInfo? {
    if type_shape.as_string(given) {
        return find_class_by_c_name("SpiteString")
    }
    var boxed_class = boxed_class_of(given)
    if boxed_class {
        return boxed_class
    }
    var container_class = container_class_of(given)
    if container_class {
        return container_class
    }
    var class_ref = type_shape.as_class_ref(given)
    assert class_ref
    assert not class_ref.has_signature
    var found = find_class_by_c_name(class_ref.c_name)
    assert found
    assert not found.is_generic_template
    return found
}

func misnamed_plural(information: Analysis.ClassInfo, name: String): String {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.passed and "{template.prefix}s" == name {
            var words = template.prefix.split("_")
            words.remove_last()
            words.append(template.symbol_parameter)
            var renamed = words.join("_")
            return "'{name}' is the plural of '{template.prefix}', but '{template.prefix}' walks nothing: its '{template.symbol_parameter}' is not a word of its name, so it is a helper compiled for the one symbol passed to it, not a template with a plural. Name it '{renamed}' and call '{renamed}s(...)'"
        }
        index = index + 1
    }
    return ""
}

func misnamed_plural_argument(arguments: List<Syntax.Expressions.Expression>, information: Analysis.ClassInfo): String {
    if arguments.count() != 1 {
        return ""
    }
    var call = shape.as_call(arguments[0])
    if not call {
        return ""
    }
    crash call.callee
    var callee = shape.as_identifier(call.callee)
    if not callee {
        return ""
    }
    return misnamed_plural(information, callee.name)
}

func passed_template(information: Analysis.ClassInfo, name: String): Analysis.TemplateInfo? {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.passed and template.prefix == name {
            return template
        }
        index = index + 1
    }
    return null
}

func passed_instance_name(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    member_name: String,
    pattern: String,
    function_name: String,
): String {
    var name = "{template.prefix}_for_{member_name}"
    if pattern.is_empty() or template_range_owner(information, template) == "pattern" {
        return name
    }
    return "{name}_in_{function_name}"
}

func passed_instance(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    registered_name: String,
): Analysis.FunctionInfo {
    var existing = information.find_function(registered_name)
    if existing {
        return existing
    }
    var member_type = template_member_type(information, template, bound_field_name)
    crash member_type
    var member_owner = template_range_owner(information, template)
    if member_owner == "function" or member_owner == "pattern" or member_owner == "namespace" or member_owner == "enum" {
        member_owner = ""
    }
    var instance = instantiate_template(
        information,
        template,
        bound_field_name,
        member_type,
        member_owner,
        registered_name,
        null,
    )
    describe_range_binding(information, template, instance)
    return instance
}

func generate_passed_symbol_call(
    template: Analysis.TemplateInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var declaration = template.declaration
    var range = range_text(template)
    var symbol_position = -1
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        if declaration.parameters[parameter_index].name == template.symbol_parameter {
            symbol_position = parameter_index
        }
        parameter_index = parameter_index + 1
    }
    var remaining = List<Syntax.Expressions.Expression>()
    var passed_name = ""
    var index = 0
    while index < arguments_ast.count() {
        var argument = arguments_ast[index]
        if index == symbol_position {
            var passed_identifier = shape.as_identifier(argument)
            if passed_identifier {
                passed_name = passed_identifier.name
            }
        } else {
            remaining.append(argument)
        }
        index = index + 1
    }
    if passed_name.is_empty() or passed_name != bound_symbol_name or range != bound_range {
        report(
            "'{template.prefix}' is compiled once for each '{template.symbol_parameter}' of 'Symbol<{range}>', so its '{template.symbol_parameter}' can only be the symbol of a template over that same range, passed by name from inside it, as in '{template.prefix}({template.symbol_parameter})'",
        )
        return void_result()
    }
    var registered_name = passed_instance_name(
        class_information,
        template,
        bound_field_name,
        bound_pattern,
        bound_function_name,
    )
    var instance = passed_instance(class_information, template, registered_name)
    var parameter_types = parameter_types_of(instance.parameters)
    var argument_codes = generate_argument_list(remaining, parameter_types, scope, class_information)
    var full_arguments = argument_codes.copy()
    full_arguments.prepend("self")
    var instance_return_type = instance.return_type
    record_call(instance.c_name)
    var self_type = value_class_type(class_information)
    var self_result = ExpressionResult("self", self_type)
    self_result.owning_override = false
    var waited = hoisted_wait(instance.c_name, self_result, false, argument_codes, instance_return_type)
    if waited {
        return waited
    }
    return ExpressionResult("{instance.c_name}({full_arguments.join(", ")})", instance_return_type)
}

func generate_generic_call(
    function_c_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    return_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var into_slot = claimed_slot(function_c_name)
    var into_owner = into_claim_owner
    var into_function = into_claim_function
    held_arguments_blocked = not into_slot.is_empty()
    var called_c_name = lent_variant_name(function_c_name, arguments_ast, expected_types, scope, class_information)
    held_arguments_blocked = false
    argument_callee = function_c_name
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    argument_callee = ""
    argument_lender_class = null
    argument_lender_function = null
    if not into_slot.is_empty() and called_c_name == function_c_name {
        var into_name = into_callee(into_owner, into_function, function_c_name)
        into_claimed_slot = into_slot
        var into_arguments = argument_codes.copy()
        into_arguments.append(into_slot)
        return finish_generic_call(into_name, object_result, object_ast, into_arguments, return_type)
    }
    return finish_generic_call(called_c_name, object_result, object_ast, argument_codes, return_type)
}

func claimed_slot(name: String): String {
    if into_claim_depth != expression_depth or into_claim_name != name {
        return ""
    }
    into_claim_depth = -1
    return into_claim_slot
}

func into_callee(owner: Analysis.ClassInfo?, function: Analysis.FunctionInfo?, function_c_name: String): String {
    crash owner
    if function {
        return ensure_into_variant(owner, function)
    }
    crash function_c_name == "{owner.c_name}_copy" or function_c_name == "{owner.c_name}___deep_copy"
    ensure_frame_helpers(owner)
    return "{owner.c_name}___copy_into"
}

func ensure_into_variant(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var variant_c_name = "{function.c_name}___into"
    if function_by_c_name(owner, variant_c_name) {
        return variant_c_name
    }
    var variant_return_type = function.return_type
    var variant = Analysis.FunctionInfo(
        function.name,
        variant_c_name,
        function.parameters,
        variant_return_type,
        function.body,
        false,
    )
    variant.line = function.line
    variant.end_line = function.end_line
    variant.source_path = function.source_path
    variant.specialisation_position = function.specialisation_position
    variant.symbol_name = function.symbol_name
    variant.symbol_field_name = function.symbol_field_name
    variant.symbol_chain_method = function.symbol_chain_method
    variant.symbol_chain_arguments = function.symbol_chain_arguments
    variant.symbol_compared_value = function.symbol_compared_value
    variant.symbol_field_index = function.symbol_field_index
    variant.symbol_field_type = function.symbol_field_type
    variant.symbol_owner_c_name = function.symbol_owner_c_name
    variant.symbol_through_caller = function.symbol_through_caller
    variant.symbol_pattern = function.symbol_pattern
    variant.symbol_function_name = function.symbol_function_name
    variant.symbol_display_name = function.symbol_display_name
    variant.symbol_range = function.symbol_range
    variant.symbol_enum_c_name = function.symbol_enum_c_name
    variant.specialised_from = function.specialised_from
    variant.result_slot = true
    owner.declared_functions.append(variant)
    builder.add_prototype("{function_signature(owner, variant)};")
    return variant_c_name
}

func ensure_frame_helpers(information: Analysis.ClassInfo) {
    var c_name = information.c_name
    assert not frame_helper_classes.contains(c_name)
    if frame_helper_classes.is_empty() {
        builder.add_typedef("#define SPITE_FRAMED_COUNT 1073741824")
    }
    frame_helper_classes.append(c_name)
    var class_id_text: String = information.class_id
    var parameters = constructor_parameter_list(information)
    var into_parameters = "{c_name}* self"
    if parameters != "void" {
        into_parameters = "{c_name}* self, {parameters}"
    }
    builder.add_prototype("static {c_name}* {c_name}___framed({c_name}* self);")
    builder.add_prototype("static void {c_name}___copy_fields({c_name}* target, {c_name}* source);")
    builder.add_prototype("static {c_name}* {c_name}___make_into({into_parameters});")
    builder.add_prototype("static {c_name}* {c_name}___copy_into({c_name}* self, {c_name}* spite_result);")
    var counted = object_frames.holds_counted(this, information)
    if counted {
        builder.add_prototype("static void {c_name}___unframe({c_name}* self);")
        builder.add_prototype("static {c_name}* {c_name}___moved({c_name}* source);")
        builder.add_support(
            "static {c_name}* {c_name}___moved({c_name}* source) \{\n{c_name}* self = ({c_name}*)SPITE_MALLOC(sizeof({c_name}));\n*self = *source;\nself->header.ref_count = 1;\n#ifdef SPITE_DEBUG_MEMORY\nspite_debug_register_object(self, {class_id_text});\n#endif\nreturn self;\n}",
        )
    }
    framed_positions[c_name] = builder.support_count()
    builder.add_support(
        "static {c_name}* {c_name}___framed({c_name}* self) \{\nself->header.ref_count = SPITE_FRAMED_COUNT;\nself->header.class_id = {class_id_text};\nreturn self;\n}",
    )
    var copy_lines = List<String>()
    copy_lines.append("static void {c_name}___copy_fields({c_name}* target, {c_name}* source) \{")
    var field_index = 0
    var unframe_lines = List<String>()
    unframe_lines.append("static void {c_name}___unframe({c_name}* self) \{")
    while field_index < information.fields.count() {
        var copied_field = information.fields[field_index]
        var field_code = c_value_name(copied_field.name)
        var copied_type = copied_field.type
        if type_needs_drop(copied_type) {
            var source_place = field_place("source", information, copied_field.name)
            copy_lines.append("target->{field_code} = {retain_call(copied_type, source_place)};")
            var released_place = field_place("self", information, copied_field.name)
            unframe_lines.append("{release_call(copied_type, released_place)};")
        } else {
            copy_lines.append("target->{field_code} = source->{field_code};")
        }
        field_index = field_index + 1
    }
    copy_lines.append("}")
    unframe_lines.append("(void)self;")
    unframe_lines.append("}")
    var joined_copy_lines = copy_lines.join("\n")
    builder.add_support(joined_copy_lines)
    if counted {
        var joined_unframe_lines = unframe_lines.join("\n")
        builder.add_support(joined_unframe_lines)
    }
    var make_lines = List<String>()
    make_lines.append("static {c_name}* {c_name}___make_into({into_parameters}) \{")
    make_lines.append("{c_name}___framed(self);")
    make_lines.append("{c_name}___init(self);")
    if information.constructor {
        var arguments = c_parameter_names(information.constructor.parameters)
        arguments.prepend("self")
        make_lines.append("{information.constructor.c_name}({arguments.join(", ")});")
    }
    make_lines.append("return self;")
    make_lines.append("}")
    var joined_make_lines = make_lines.join("\n")
    builder.add_support(joined_make_lines)
    builder.add_support(
        "static {c_name}* {c_name}___copy_into({c_name}* self, {c_name}* spite_result) \{\n{c_name}___copy_fields({c_name}___framed(spite_result), self);\nreturn spite_result;\n}",
    )
}

func lendable_item_source(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if in_vector_library(class_information) {
        return ""
    }
    var identifier = shape.as_identifier(expression)
    if identifier {
        return scope.borrow_source(identifier.name)
    }
    var indexed = shape.as_index(expression)
    if indexed {
        crash indexed.object
        if not may_lend(expression, scope, class_information) {
            return ""
        }
        var indexed_source = operand_text(indexed.object)
        if indexed_source.is_empty() {
            indexed_source = Syntax.SourcePrinter().source_expression(indexed.object)
        }
        return indexed_source
    }
    var member = shape.as_member(expression)
    if member {
        crash member.object
        var row = shape.as_identifier(member.object)
        if row {
            if not scope.row_source(row.name).is_empty() and may_lend(expression, scope, class_information) {
                return row.name
            }
        }
    }
    return ""
}

func is_row_name(expression: Syntax.Expressions.Expression, scope: Scope): Boolean {
    var identifier = shape.as_identifier(expression)
    if not identifier {
        return false
    }
    return not scope.row_source(identifier.name).is_empty()
}

func lent_variant_name(
    function_c_name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    held_argument_positions = List<String>()
    framed_argument_positions = List<String>()
    var lent_name = lent_items_variant_name(function_c_name, arguments_ast, expected_types, scope, class_information)
    return held_variant_name(lent_name, arguments_ast, expected_types, scope, class_information)
}

func lent_items_variant_name(
    function_c_name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    lent_argument_positions = List<String>()
    lent_argument_sources = List<String>()
    var positions = List<String>()
    var item_sources = List<String>()
    var sources = ""
    var index = 0
    while index < arguments_ast.count() {
        if is_row_name(arguments_ast[index], scope) {
            if index >= expected_types.count() or variadic_list(expected_types) {
                return function_c_name
            }
            if not is_shape_type(expected_types[index]) {
                return function_c_name
            }
            positions.append(index)
            item_sources.append("")
            var row_identifier = shape.as_identifier(arguments_ast[index])
            crash row_identifier
            if sources.is_empty() {
                sources = scope.row_source(row_identifier.name)
            }
        } else {
            var item_source = lendable_item_source(arguments_ast[index], scope, class_information)
            var fits = index < expected_types.count() and not variadic_list(expected_types)
            if fits {
                fits = not type_shape.as_union(expected_types[index])
            }
            if not item_source.is_empty() and fits {
                positions.append(index)
                item_sources.append(item_source)
                if sources.is_empty() {
                    sources = item_source
                }
            }
        }
        index = index + 1
    }
    if positions.is_empty() {
        return function_c_name
    }
    var owner = class_of_function_c_name(function_c_name)
    if not owner {
        return function_c_name
    }
    if owner.source_path.starts_with("library/") {
        return function_c_name
    }
    lent_argument_positions = positions
    lent_argument_sources = item_sources
    var variant_c_name = "{function_c_name}___lent_{positions.join("_")}"
    var function_index = 0
    while function_index < owner.declared_functions.count() {
        var candidate = owner.declared_functions[function_index]
        if candidate.c_name == variant_c_name {
            return variant_c_name
        }
        function_index = function_index + 1
    }
    lent_callers[variant_c_name] = "the call on line {current_line} of '{current_function}'"
    var original = function_by_c_name(owner, function_c_name)
    crash original
    add_lent_variant(owner, original, variant_c_name, positions, sources)
    return variant_c_name
}

func add_lent_variant(
    owner: Analysis.ClassInfo,
    original: Analysis.FunctionInfo,
    variant_c_name: String,
    positions: List<String>,
    sources: String,
) {
    var original_return_type = original.return_type
    var variant = Analysis.FunctionInfo(
        original.name,
        variant_c_name,
        original.parameters,
        original_return_type,
        original.body,
        false,
    )
    variant.line = original.line
    variant.source_path = original.source_path
    variant.specialisation_position = original.specialisation_position
    variant.symbol_name = original.symbol_name
    variant.symbol_field_name = original.symbol_field_name
    variant.symbol_chain_method = original.symbol_chain_method
    variant.symbol_chain_arguments = original.symbol_chain_arguments
    variant.symbol_compared_value = original.symbol_compared_value
    variant.symbol_field_index = original.symbol_field_index
    variant.symbol_field_type = original.symbol_field_type
    variant.symbol_owner_c_name = original.symbol_owner_c_name
    variant.symbol_through_caller = original.symbol_through_caller
    variant.symbol_pattern = original.symbol_pattern
    variant.symbol_function_name = original.symbol_function_name
    variant.symbol_display_name = original.symbol_display_name
    variant.symbol_range = original.symbol_range
    variant.symbol_enum_c_name = original.symbol_enum_c_name
    variant.specialised_from = original.specialised_from
    variant.lent_sources = sources
    var parameter_index = 0
    while parameter_index < original.parameters.count() {
        if positions.contains(parameter_index) {
            variant.lent_parameters.append(original.parameters[parameter_index].name)
        }
        parameter_index = parameter_index + 1
    }
    owner.declared_functions.append(variant)
    builder.add_prototype("{function_signature(owner, variant)};")
    lent_variant_lines.append("variant {variant_c_name}\t{original.c_name}\t{positions.join("_")}\t{sources}")
}

func held_variant_name(
    function_c_name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if resumable_mode or hot_reload or read_evaluate_print_loop or remote_loop_port != 0 or keeps_internals {
        return function_c_name
    }
    if held_arguments_blocked {
        return function_c_name
    }
    if variadic_list(expected_types) or arguments_ast.count() != expected_types.count() {
        return function_c_name
    }
    var candidates = List<Integer>()
    var framed_candidates = List<Integer>()
    var path_candidates = List<Integer>()
    var path_candidate_dependencies = List<String>()
    var item_candidates = List<Integer>()
    var index = 0
    while index < arguments_ast.count() {
        var index_text = index.to_string()
        if not lent_argument_positions.contains(index_text) {
            var path_dependencies = held_path_dependencies(
                arguments_ast[index],
                expected_types[index],
                scope,
                class_information,
            )
            if held_by_caller(arguments_ast[index], expected_types[index], scope) {
                candidates.append(index)
            } else if not path_dependencies.is_empty() {
                candidates.append(index)
                path_candidates.append(index)
                var joined_dependencies = path_dependencies.join(" ")
                path_candidate_dependencies.append(joined_dependencies)
            } else if held_item_argument(arguments_ast[index], expected_types[index], scope, class_information) {
                candidates.append(index)
                item_candidates.append(index)
            } else if frameable_function_value(arguments_ast[index], expected_types[index], scope, class_information) {
                candidates.append(index)
                framed_candidates.append(index)
            }
        }
        index = index + 1
    }
    if candidates.is_empty() {
        return function_c_name
    }
    var owner = class_of_function_c_name(function_c_name)
    if not owner {
        return function_c_name
    }
    if owner.source_path.starts_with("library/") or is_hot_class(owner) {
        return function_c_name
    }
    var original = function_by_c_name(owner, function_c_name)
    if not original {
        return function_c_name
    }
    if original.is_constructor or not original.has_body or original.result_slot {
        return function_c_name
    }
    var positions = List<String>()
    var framed = List<String>()
    var callee_effects = List<String>()
    var effects_known = false
    var callee_key = call_effects.effects_key(owner.qualified_dotted, original.name)
    if not path_candidates.is_empty() {
        effects_known = not callee_key.is_empty()
        callee_effects = call_effects.effects_of(owner.qualified_dotted, original.name)
    }
    var candidate_index = 0
    while candidate_index < candidates.count() {
        var position = candidates[candidate_index]
        crash original.parameters[position]
        var parameter_name = original.parameters[position].name
        var position_text = position.to_string()
        var fits = not assigns_name(original.body, parameter_name) and not original.lent_parameters.contains(parameter_name)
        crash expected_types[position]
        var shaped_type = type_shape.as_union(expected_types[position])
        if fits and shaped_type {
            fits = guards_singleton(owner, original) or not dispatches_shapes(owner, original)
        }
        if fits and item_candidates.contains(position) {
            fits = held_item_keeps(arguments_ast[position], callee_key, scope, class_information)
        }
        var path_at = path_candidates.index_of(position)
        if fits and path_at {
            crash path_candidate_dependencies[path_at]
            var dependency_text = path_candidate_dependencies[path_at]
            var dependencies = dependency_text.split(" ")
            fits = effects_known and not path_changed_by(dependencies, callee_effects)
        }
        if fits and framed_candidates.contains(position) {
            fits = block_only_calls(original.body, parameter_name)
            if fits {
                framed.append(position_text)
            }
        }
        if fits {
            positions.append(position_text)
        }
        candidate_index = candidate_index + 1
    }
    if positions.is_empty() {
        return function_c_name
    }
    held_argument_positions = positions
    framed_argument_positions = framed
    var variant_c_name = "{function_c_name}___held_{positions.join("_")}"
    var existing = function_by_c_name(owner, variant_c_name)
    if existing {
        return variant_c_name
    }
    var original_return_type = original.return_type
    var variant = Analysis.FunctionInfo(
        original.name,
        variant_c_name,
        original.parameters,
        original_return_type,
        original.body,
        false,
    )
    variant.line = original.line
    variant.source_path = original.source_path
    variant.specialisation_position = original.specialisation_position
    variant.symbol_name = original.symbol_name
    variant.symbol_field_name = original.symbol_field_name
    variant.symbol_chain_method = original.symbol_chain_method
    variant.symbol_chain_arguments = original.symbol_chain_arguments
    variant.symbol_compared_value = original.symbol_compared_value
    variant.symbol_field_index = original.symbol_field_index
    variant.symbol_field_type = original.symbol_field_type
    variant.symbol_owner_c_name = original.symbol_owner_c_name
    variant.symbol_through_caller = original.symbol_through_caller
    variant.symbol_pattern = original.symbol_pattern
    variant.symbol_function_name = original.symbol_function_name
    variant.symbol_display_name = original.symbol_display_name
    variant.symbol_range = original.symbol_range
    variant.symbol_enum_c_name = original.symbol_enum_c_name
    variant.specialised_from = original.specialised_from
    variant.lent_sources = original.lent_sources
    variant.lent_parameters = original.lent_parameters.copy()
    if lent_callers[function_c_name] {
        lent_callers[variant_c_name] = lent_callers[function_c_name]
    }
    var parameter_index = 0
    while parameter_index < original.parameters.count() {
        var parameter_text = parameter_index.to_string()
        if positions.contains(parameter_text) {
            variant.held_parameters.append(original.parameters[parameter_index].name)
        }
        parameter_index = parameter_index + 1
    }
    owner.declared_functions.append(variant)
    builder.add_prototype("{function_signature(owner, variant)};")
    return variant_c_name
}

# ../../../docs/optimizations.md#a-function-value-describes-its-arguments-when-asked
func frameable_function_value(
    argument: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if not objects_in_frame_allowed(class_information) {
        return false
    }
    var expected = type_shape.as_class_ref(expected_type)
    if not expected {
        return false
    }
    if expected.c_name != "Spite_Function" or not expected.has_signature {
        return false
    }
    var named = shape.as_identifier(argument)
    if named {
        if scope.lookup_type(named.name) or class_information.find_field(named.name) {
            return false
        }
        if find_getter(class_information, named.name, class_information) {
            return false
        }
        return own_function_value_target(class_information, named.name)
    }
    var member = shape.as_member(argument)
    if not member {
        return false
    }
    crash member.object
    var value_owner = shape.as_identifier(member.object)
    if not value_owner or member.name.starts_with("_") {
        return false
    }
    if not scope.borrow_source(value_owner.name).is_empty() or not scope.row_source(value_owner.name).is_empty() {
        return false
    }
    if not scope.holds_for_call(value_owner.name) {
        return false
    }
    var owner_type = scope.lookup_type(value_owner.name)
    if not owner_type {
        return false
    }
    var owner_reference = type_shape.as_class_ref(owner_type)
    if not owner_reference {
        return false
    }
    if owner_reference.has_signature {
        return false
    }
    var owner_class = find_class_by_c_name(owner_reference.c_name)
    if not owner_class {
        return false
    }
    if owner_class.find_field(member.name) or container_class_of(owner_type) {
        return false
    }
    if find_getter(owner_class, member.name, class_information) {
        return false
    }
    return own_function_value_target(owner_class, member.name)
}

func own_function_value_target(information: Analysis.ClassInfo, name: String): Boolean {
    if information.is_value_class or information.is_generic_template or is_hot_class(information) {
        return false
    }
    var function = information.find_function(name)
    if not function {
        return false
    }
    return not function.is_constructor and function.has_body
}

func block_only_calls(statements: List<Syntax.Statements.Statement>, name: String): Boolean {
    var index = 0
    while index < statements.count() {
        if not statement_only_calls(statements[index], name) {
            return false
        }
        index = index + 1
    }
    return true
}

func statement_only_calls(statement: Syntax.Statements.Statement, name: String): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: return statement.name != name and optional_only_calls(statement.value, name)
        Syntax.Statements.AssignmentStatement: return optional_only_calls(statement.target, name) and optional_only_calls(statement.value, name)
        Syntax.Statements.IfStatement: {
            if not optional_only_calls(statement.condition, name) {
                return false
            }
            return block_only_calls(statement.then_branch, name) and block_only_calls(statement.else_branch, name)
        }
        Syntax.Statements.WhileStatement: return optional_only_calls(statement.condition, name) and block_only_calls(statement.body, name)
        Syntax.Statements.SwitchStatement: {
            if not optional_only_calls(statement.subject, name) {
                return false
            }
            var case_index = 0
            while case_index < statement.cases.count() {
                if not block_only_calls(statement.cases[case_index].body, name) {
                    return false
                }
                case_index = case_index + 1
            }
            return true
        }
        Syntax.Statements.AssertStatement: return optional_only_calls(statement.value, name)
        Syntax.Statements.ReturnStatement: return optional_only_calls(statement.value, name)
        Syntax.Statements.ExpressionStatement: return optional_only_calls(statement.value, name)
        _: return false
    }
}

func optional_only_calls(expression: Syntax.Expressions.Expression?, name: String): Boolean {
    if not expression {
        return true
    }
    return expression_only_calls(expression, name)
}

func each_only_calls(expressions: List<Syntax.Expressions.Expression>, name: String): Boolean {
    var index = 0
    while index < expressions.count() {
        if not expression_only_calls(expressions[index], name) {
            return false
        }
        index = index + 1
    }
    return true
}

func expression_only_calls(expression: Syntax.Expressions.Expression, name: String): Boolean {
    switch expression {
        Syntax.Expressions.IdentifierExpression: return expression.name != name
        Syntax.Expressions.GenericIdentifierExpression: return expression.name != name
        Syntax.Expressions.StringLiteralExpression: return not expression.value.contains(name)
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var called = shape.as_identifier(expression.callee)
            if called {
                if called.name == name {
                    return each_only_calls(expression.arguments, name)
                }
            }
            return expression_only_calls(expression.callee, name) and each_only_calls(expression.arguments, name)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            return expression_only_calls(expression.callee, name) and each_only_calls(expression.arguments, name)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            return expression_only_calls(expression.left, name) and expression_only_calls(expression.right, name)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return expression_only_calls(expression.operand, name)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return expression_only_calls(expression.object, name)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            return expression_only_calls(expression.object, name) and expression_only_calls(expression.index, name)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                if not optional_only_calls(expression.elements[index].value, name) {
                    return false
                }
                index = index + 1
            }
            return true
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                if not optional_only_calls(expression.fields[index].value, name) {
                    return false
                }
                index = index + 1
            }
            return true
        }
        _: return true
    }
}

func may_change_kept_reads(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var expressions = List<Syntax.Expressions.Expression>()
    var named = ""
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            expressions.append(statement.value)
            named = statement.name
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var target = shape.as_identifier(statement.target)
            if not target {
                return true
            }
            expressions.append(statement.value)
            named = target.name
        }
        Syntax.Statements.ReturnStatement: collect_statement_expressions(statement, expressions)
        Syntax.Statements.AssertStatement: collect_statement_expressions(statement, expressions)
        Syntax.Statements.IfStatement: collect_statement_expressions(statement, expressions)
        _: return true
    }
    var calls = List<Syntax.Expressions.Expression>()
    collect_each_expression_call(expressions, calls)
    if not calls.is_empty() {
        return true
    }
    var index = 0
    while index < expressions.count() {
        if operates_on_objects(expressions[index], scope, class_information) {
            return true
        }
        index = index + 1
    }
    if named.is_empty() {
        return false
    }
    var kept_paths = scope.visible_kept_paths()
    var path_index = 0
    while path_index < kept_paths.count() {
        if mentions_word(kept_paths[path_index], named) {
            return true
        }
        path_index = path_index + 1
    }
    return false
}

func operates_on_objects(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch expression {
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if not plain_kept_operand(expression.left, scope, class_information) {
                return true
            }
            return operates_on_objects(expression.left, scope, class_information) or operates_on_objects(expression.right, scope, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            if not plain_kept_operand(expression.operand, scope, class_information) {
                return true
            }
            return operates_on_objects(expression.operand, scope, class_information)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return operates_on_objects(expression.object, scope, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            return operates_on_objects(expression.object, scope, class_information) or operates_on_objects(expression.index, scope, class_information)
        }
        Syntax.Expressions.IdentifierExpression: return false
        Syntax.Expressions.IntegerLiteral: return false
        Syntax.Expressions.FloatLiteral: return false
        Syntax.Expressions.TrueLiteral: return false
        Syntax.Expressions.FalseLiteral: return false
        Syntax.Expressions.StringLiteralExpression: return expression.value.contains("\{")
        _: return true
    }
}

func plain_kept_operand(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var operand_type = lookup_static_type(expression, scope, class_information)
    if not operand_type {
        return false
    }
    var nullable = type_shape.as_nullable(operand_type)
    if nullable {
        var inner = nullable.inner
        operand_type = inner
    }
    return type_shape.as_scalar(operand_type) or type_shape.as_enum(operand_type)
}

func held_by_caller(argument: Syntax.Expressions.Expression, expected_type: Analysis.SpiteType, scope: Scope): Boolean {
    var identifier = shape.as_identifier(argument)
    if not identifier {
        return false
    }
    if not holdable_type(expected_type) {
        return false
    }
    if not scope.borrow_source(identifier.name).is_empty() or not scope.row_source(identifier.name).is_empty() {
        return false
    }
    return scope.holds_for_call(identifier.name)
}

# ../../../docs/optimizations.md#an-attribute-a-call-cannot-assign-is-passed-without-counting
func held_path_dependencies(
    argument: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var unheld = List<String>()
    if not holdable_type(expected_type) {
        return unheld
    }
    var path_argument = argument
    var indexed = shape.as_index(argument)
    if indexed {
        if not is_bound_member_index(indexed) {
            return unheld
        }
        path_argument = bound_member_expression(indexed)
    }
    var names = List<String>()
    var walked = path_argument
    var member = shape.as_member(walked)
    while member {
        crash member.object
        names.prepend(member.name)
        walked = member.object
        member = shape.as_member(walked)
    }
    var root = shape.as_identifier(walked)
    if not root {
        return unheld
    }
    var current: Analysis.SpiteType? = null
    var root_local = scope.unnarrowed_type(root.name)
    if root_local {
        if names.is_empty() or not scope.holds_for_call(root.name) {
            return unheld
        }
        if not scope.borrow_source(root.name).is_empty() or not scope.row_source(root.name).is_empty() {
            return unheld
        }
        current = scope.written_type(root.name)
    } else {
        var root_field = class_information.find_field(root.name)
        if not root_field or class_information.find_function("get_{root.name}") {
            return unheld
        }
        current = root_field.type
    }
    var index = 0
    while index < names.count() {
        var name = names[index]
        var owner = held_path_class(current)
        if owner {
            var field = owner.find_field(name)
            if not field or owner.find_function("get_{name}") or owner.is_singleton or is_library_class(owner) {
                return unheld
            }
            current = field.type
        } else {
            var last_index = names.count() - 1
            var shaped_field = held_shape_field(current, name, index == last_index)
            if not shaped_field {
                return unheld
            }
            current = shaped_field
        }
        index = index + 1
    }
    var path = operand_text(path_argument)
    if path.is_empty() or path.contains("[") or path.contains("(") {
        return unheld
    }
    return proof_dependencies(path, scope, class_information)
}

func held_shape_field(spite_type: Analysis.SpiteType?, name: String, last: Boolean): Analysis.SpiteType? {
    assert spite_type
    assert last and type_shape.as_union(spite_type) and holdable_type(spite_type)
    var shaped = shape_of(spite_type)
    assert shaped
    var shaped_field = shape_field_type(shaped, name)
    assert shaped_field
    assert type_shape.as_class_ref(shaped_field)
    return shaped_field
}

# ../../../docs/optimizations.md#an-item-passed-to-a-call-that-cannot-change-its-list-is-not-counted
func held_item_argument(
    argument: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if not slot_proofs_allowed(class_information) or not holdable_type(expected_type) {
        return false
    }
    if type_shape.as_union(expected_type) {
        return false
    }
    var read = shape.as_index(argument)
    if not read {
        return false
    }
    crash read.object
    crash read.index
    if not plain_path(read.object) or operand_text(read.object).is_empty() {
        return false
    }
    if not shape.as_identifier(read.index) and not shape.as_integer_literal(read.index) {
        return false
    }
    var list_type = receiver_type_of(read.object, scope, class_information)
    if not list_type {
        return false
    }
    var listed = type_shape.as_list(list_type)
    if not listed {
        return false
    }
    var element = listed.element
    if type_shape.as_nullable(element) {
        return false
    }
    if type_shape.as_list(element) {
        return true
    }
    var class_reference = type_shape.as_class_ref(element)
    if not class_reference {
        return false
    }
    return not class_reference.has_signature
}

func held_item_keeps(
    argument: Syntax.Expressions.Expression,
    callee_key: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if callee_key.is_empty() {
        return false
    }
    var read = shape.as_index(argument)
    crash read
    var watch = slot_watch_for("", read, argument, scope, class_information)
    if not watch {
        return false
    }
    return slot_key_holds(watch, callee_key) and slot_watch_settles(watch)
}

func held_item_code(
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var read = shape.as_index(argument)
    crash read
    crash read.object
    crash read.index
    var list_type = receiver_type_of(read.object, scope, class_information)
    crash list_type
    var listed = type_shape.as_list(list_type)
    crash listed
    var list_code = generate_expression(read.object, scope, class_information)
    var integer_spite_type = integer_type()
    var index_code = coerce_for_store(read.index, integer_spite_type, scope, class_information)
    var list_temporary = next_temporary()
    var index_temporary = next_temporary()
    var item = list_item_code(listed.element, list_temporary, index_temporary)
    var outside = "{index_temporary} < 0 || {index_temporary} >= ({list_temporary})->item_count_"
    ensure_index_check()
    var printer = Syntax.SourcePrinter()
    var read_source = printer.source_expression(argument)
    var read_text = escape_c_string(read_source)
    var where = located(current_path, current_line, current_owner, current_function)
    return "(\{ {c_type_name(list_type)} {list_temporary} = {list_code.code}; int32_t {index_temporary} = {index_code}; if (__builtin_expect({outside}, 0)) spite_outside_list(\"{read_text}\", {where}); {item}; })"
}

func held_argument_code(
    argument: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    framed: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var item_argument = shape.as_index(argument)
    if item_argument and held_item_argument(argument, expected_type, scope, class_information) {
        var item_code = held_item_code(argument, scope, class_information)
        return cast(item_code, expected_type, expected_type)
    }
    framing_function_value = framed
    var held_result = generate_expression(argument, scope, class_information)
    if framed and framing_function_value {
        framing_function_value = false
        report(
            "internal: the function value passed here was to be made in the frame and was not; this is a compiler bug",
        )
    }
    var held_type = held_result.type
    var held_read = held_read_code(held_result, argument)
    return cast(held_read, held_type, expected_type)
}

# ../../../docs/optimizations.md#an-item-passed-to-a-call-that-cannot-change-its-list-is-not-counted
func item_object_uncounted(
    object_ast: Syntax.Expressions.Expression,
    generated: ExpressionResult,
    member_name: String,
    calls: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert slot_proofs_allowed(class_information)
    var generated_type = generated.type
    assert not type_shape.as_nullable(generated_type) and owns(generated, object_ast)
    var read = shape.as_index(object_ast)
    assert read
    crash read.object
    crash read.index
    assert plain_path(read.object) and not operand_text(read.object).is_empty()
    assert shape.as_identifier(read.index) or shape.as_integer_literal(read.index)
    var list_type = receiver_type_of(read.object, scope, class_information)
    assert list_type
    var listed = type_shape.as_list(list_type)
    assert listed
    var element = listed.element
    assert not type_shape.as_nullable(element)
    assert types_equal(element, generated_type)
    assert item_member_reads_only(element, member_name, calls)
    var item_code = held_item_code(object_ast, scope, class_information)
    var item = ExpressionResult(item_code, element)
    item.owning_override = false
    return item
}

func item_member_reads_only(element: Analysis.SpiteType, member_name: String, calls: Boolean): Boolean {
    if calls {
        var reading = ["count", "is_empty", "get_at", "first", "last", "contains", "index_of"]
        var listed_item = type_shape.as_list(element)
        if not listed_item {
            return false
        }
        return reading.contains(member_name)
    }
    var class_reference = type_shape.as_class_ref(element)
    if not class_reference {
        return false
    }
    if class_reference.has_signature {
        return false
    }
    var element_class = find_class_by_c_name(class_reference.c_name)
    if not element_class {
        return false
    }
    var field = element_class.find_field(member_name)
    if not field {
        return false
    }
    return not element_class.find_function("get_{member_name}")
}

func held_read_code(held_result: ExpressionResult, argument: Syntax.Expressions.Expression): String {
    if held_result.peek_union {
        return peeked_code(held_result)
    }
    if owns(held_result, argument) {
        report("internal: an argument passed as held was read with a count of its own; this is a compiler bug")
    }
    return held_result.code
}

func holdable_type(expected_type: Analysis.SpiteType): Boolean {
    if not type_needs_drop(expected_type) or type_shape.as_string(expected_type) or type_shape.is_arguments(expected_type) {
        return false
    }
    var union_type = type_shape.as_union(expected_type)
    if not union_type {
        return true
    }
    var shaped = find_union_by_c_name(union_type.c_name)
    if not shaped {
        return false
    }
    return shaped.is_shape and not shaped.is_tagged
}

func held_path_class(spite_type: Analysis.SpiteType?): Analysis.ClassInfo? {
    assert spite_type
    assert not type_shape.as_nullable(spite_type)
    var class_ref = type_shape.as_class_ref(spite_type)
    assert class_ref
    return find_class_by_c_name(class_ref.c_name)
}

func path_changed_by(dependencies: List<String>, effects: List<String>): Boolean {
    var effect_index = 0
    while effect_index < effects.count() {
        var effect = effects[effect_index]
        var index = 0
        while index < dependencies.count() {
            if dependency_changes(effect, dependencies[index]) {
                return true
            }
            index = index + 1
        }
        effect_index = effect_index + 1
    }
    return false
}

func assigns_name(statements: List<Syntax.Statements.Statement>, name: String): Boolean {
    var index = 0
    while index < statements.count() {
        if statement_assigns_name(statements[index], name) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_assigns_name(statement: Syntax.Statements.Statement, name: String): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: return statement.name == name
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            var target = shape.as_identifier(statement.target)
            if target {
                return target.name == name
            }
            return false
        }
        Syntax.Statements.IfStatement: {
            if assigns_name(statement.then_branch, name) {
                return true
            }
            return assigns_name(statement.else_branch, name)
        }
        Syntax.Statements.WhileStatement: return assigns_name(statement.body, name)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                if assigns_name(statement.cases[case_index].body, name) {
                    return true
                }
                case_index = case_index + 1
            }
            return false
        }
        _: return false
    }
}

func class_of_function_c_name(function_c_name: String): Analysis.ClassInfo? {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if function_by_c_name(information, function_c_name) {
            return information
        }
        index = index + 1
    }
    return null
}

func function_by_c_name(information: Analysis.ClassInfo, function_c_name: String): Analysis.FunctionInfo? {
    var index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if function.c_name == function_c_name and function.has_body {
            return function
        }
        index = index + 1
    }
    return null
}

func finish_generic_call(
    function_c_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    argument_codes: List<String>,
    return_type: Analysis.SpiteType,
): ExpressionResult {
    record_call(function_c_name)
    var object_owned = owns(object_result, object_ast)
    var waited = hoisted_wait(function_c_name, object_result, object_owned, argument_codes, return_type)
    if waited {
        return waited
    }
    if object_owned {
        var object_temporary = next_temporary()
        var lines = List<String>()
        var object_result_type = object_result.type
        lines.append("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
        var full_arguments = argument_codes.copy()
        full_arguments.prepend(object_temporary)
        var call_code = "{function_c_name}({full_arguments.join(", ")})"
        if type_shape.is_void(return_type) {
            lines.append("{call_code};")
            lines.append("{release_call(object_result_type, object_temporary)};")
            return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
        }
        var call_temporary = next_temporary()
        lines.append("{c_type_name(return_type)} {call_temporary} = {call_code};")
        lines.append("{release_call(object_result_type, object_temporary)};")
        lines.append("{call_temporary};")
        return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
    }
    var full_arguments = argument_codes.copy()
    full_arguments.prepend(object_result.code)
    return ExpressionResult("{function_c_name}({full_arguments.join(", ")})", return_type)
}

func generate_number_constant(information: Analysis.ClassInfo, name: String): ExpressionResult? {
    assert is_number_class(information)
    var function = find_or_instantiate_function(information, name)
    var is_constant = false
    if function {
        is_constant = maths.is_constant(name) and is_inline_supplied(function)
    }
    if not is_constant {
        report_not_a_number_constant(information, name, function)
        return void_result()
    }
    var named = "{information.qualified_dotted}.{name}"
    report("'{named}' is a constant, read as an attribute and never called: write '{named}'")
    return void_result()
}

func is_number_class(information: Analysis.ClassInfo): Boolean {
    var largest = find_or_instantiate_function(information, "largest")
    if not largest {
        return false
    }
    return is_inline_supplied(largest)
}

func number_constant_read(information: Analysis.ClassInfo, name: String): ExpressionResult? {
    assert maths.is_constant(name)
    var function = find_or_instantiate_function(information, name)
    assert function
    assert is_inline_supplied(function)
    var constant_type = function.return_type
    return ExpressionResult("{function.c_name}()", constant_type)
}

func report_not_a_number_constant(information: Analysis.ClassInfo, name: String, function: Analysis.FunctionInfo?) {
    var constants = "largest and smallest"
    if information.qualified_dotted == "Float" or information.qualified_dotted == "Double" {
        constants = "pi, tau, euler_number, infinity, not_a_number, largest and smallest"
    }
    var class_name = information.qualified_dotted
    if name.starts_with("from_") {
        report_cast_by_name(information, name)
        return
    }
    if function {
        report(
            "'{class_name}.{name}()' calls a function of a value on the class: the class {class_name} answers only its constants, {constants}, so call '{name}' on a {class_name}, like 'value.{name}()'",
        )
        return
    }
    report("the class {class_name} answers only its constants, {constants}, and '{name}' is not one of them")
}

func report_cast_by_name(information: Analysis.ClassInfo, name: String) {
    var class_name = information.qualified_dotted
    var name_length = name.length()
    var source_words = name.slice(5, name_length)
    var source_name = joined_case_spelling(source_words, true)
    var target_words = snake_words(information.simple_name)
    var assignment = "'var converted: {class_name} = value'"
    report(
        "there is no '{class_name}.{name}()': a conversion belongs to the value converted, so write 'value.to_{target_words}()' on {with_article(source_name)}, or cast by assignment: {assignment}",
    )
}

func forget_indices_if_shrinking(name: String, object_ast: Syntax.Expressions.Expression, scope: Scope) {
    assert shrinks_storage(name)
    var shrunk = operand_text(object_ast)
    assert not shrunk.is_empty()
    var crossed_loop_readers = List<String>()
    if scope.forget_path(shrunk, false, crossed_loop_readers) {
        report(
            "'{shrunk}.{name}()' inside this loop undoes what was proven about '{shrunk}' before the loop, and the next pass would read it unproven: prove it inside the loop instead",
        )
    }
}

func generate_method_call(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if member.name == bound_pattern and not bound_pattern.is_empty() {
        var matched = Syntax.Expressions.MemberExpression(object_ast, bound_function_name)
        return generate_method_call(matched, object_ast, arguments_ast, scope, class_information)
    }
    if member.written {
        report_operator_function_call(member, object_ast, arguments_ast, scope, class_information)
    }
    forget_indices_if_shrinking(member.name, object_ast, scope)
    var counted_call = counted_method(member, object_ast, arguments_ast, scope, class_information)
    if counted_call {
        return counted_call
    }
    if maths.is_member(member.name) and not maths.is_constant(member.name) {
        var folded_maths = folded_maths_call(member.name, object_ast, arguments_ast, class_information)
        if folded_maths {
            return folded_maths
        }
    }
    if member.name == "pluralize" or member.name == "singularize" {
        var folded_word = folded_inflection(member.name, object_ast, arguments_ast)
        if folded_word {
            return folded_word
        }
    }
    if member.name == "absolute" and arguments_ast.is_empty() {
        var checked_absolute = checked_absolute_call(member, object_ast, scope, class_information)
        if checked_absolute {
            return checked_absolute
        }
    }
    var fused = generate_fused_chain(member, object_ast, arguments_ast, scope, class_information)
    if fused {
        return fused
    }
    if member.name == "call_function" {
        var saved_counter = temporary_counter
        var called_probe = generate_expression(object_ast, scope, class_information)
        rewind_temporaries(saved_counter)
        var called_probe_type = called_probe.type
        var called_function = type_shape.as_class_ref(called_probe_type)
        if called_function {
            if called_function.c_name == "Spite_Function" {
                if called_function.has_signature {
                    var held = generate_expression(object_ast, scope, class_information)
                    return call_function_value(held, object_ast, arguments_ast, scope, class_information)
                }
            }
        }
    }
    var static_receiver = try_resolve_static_path(object_ast, class_information.qualified_dotted)
    if static_receiver {
        var number_constant = generate_number_constant(static_receiver, member.name)
        if number_constant {
            return number_constant
        }
        var class_value_class = find_class_by_c_name("Spite_Class")
        if class_value_class {
            var on_the_class_value = find_or_instantiate_function(class_value_class, member.name)
            if not on_the_class_value and member.name != "deep_copy" and member.name != "copy" {
                report(
                    "'{static_receiver.qualified_dotted}' is a class, not a value: write '{static_receiver.qualified_dotted}()' to make one, and give it a name with 'var ... = '",
                )
                return void_result()
            }
        }
    }
    var object_counter = temporary_counter
    var generated_member_object = member_object_in_frame(object_ast, member.name, scope, class_information)
    var uncounted_receiver = item_object_uncounted(
        object_ast,
        generated_member_object,
        member.name,
        true,
        scope,
        class_information,
    )
    if uncounted_receiver {
        generated_member_object = uncounted_receiver
    }
    var object_result = as_text(generated_member_object)
    var object_result_type = object_result.type
    var handle = joinable_handle(object_result_type)
    if handle {
        if forwards_to_result(handle, member.name) {
            rewind_temporaries(object_counter)
            var joined_ast = implicit_join_ast(object_ast)
            var forwarded = Syntax.Expressions.MemberExpression(joined_ast, member.name)
            return generate_method_call(forwarded, joined_ast, arguments_ast, scope, class_information)
        }
    }
    if not holds_in_order(object_result) {
        return method_call_on(member, object_ast, arguments_ast, object_result, scope, class_information)
    }
    var held_receiver = hold_in_order(object_result, object_ast)
    crash held_receiver
    var made = method_call_on(member, object_ast, arguments_ast, held_receiver.operand, scope, class_information)
    return settle_in_order(held_receiver, made)
}

func method_call_on(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    object_result: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var object_result_type = object_result.type
    var foreign = type_shape.as_class_ref(object_result_type)
    if foreign {
        if foreign.c_name == "DynamicLibrary" and not declared_by_dynamic_library(member.name) {
            return generate_foreign_call(
                foreign,
                object_result,
                object_ast,
                member.name,
                arguments_ast,
                scope,
                class_information,
            )
        }
    }
    if type_shape.as_string(object_result_type) {
        return generate_string_method(member.name, object_result, object_ast, arguments_ast, scope, class_information)
    }
    if type_shape.is_arguments(object_result_type) {
        if member.name == "count" {
            var integer_spite_type = integer_type()
            return ExpressionResult("((int32_t)SpiteArguments_count(&({object_result.code})))", integer_spite_type)
        }
        if member.name == "get" and arguments_ast.count() == 1 {
            var integer_spite_type = integer_type()
            var position = coerce_for_store(arguments_ast[0], integer_spite_type, scope, class_information)
            var string_spite_type = string_type()
            return ExpressionResult("SpiteArguments_get(&({object_result.code}), {position})", string_spite_type)
        }
        report("Arguments has no method '{member.name}'")
        return void_result()
    }
    var object_scalar = type_shape.as_scalar(object_result_type)
    if object_scalar {
        var reported_before = errors_reported
        if is_bits_function(member.name) and arguments_ast.count() == 1 {
            report_wider_bits_operand(
                member.name,
                object_ast,
                arguments_ast[0],
                object_result,
                scope,
                class_information,
            )
        }
        literal_fit_reported = errors_reported > reported_before
        var value_call = generate_value_method(
            object_scalar.kind,
            member.name,
            object_result,
            arguments_ast,
            scope,
            class_information,
        )
        literal_fit_reported = false
        return value_call
    }
    var object_union = type_shape.as_union(object_result_type)
    if object_union {
        item_values.untrust(member.name)
        var union_information = find_union_by_c_name(object_union.c_name)
        crash union_information
        return generate_union_dispatch(
            union_information,
            member.name,
            true,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_dictionary = type_shape.as_dictionary(object_result_type)
    if object_dictionary {
        return generate_dictionary_method(
            object_dictionary,
            member.name,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_list = type_shape.as_list(object_result_type)
    if object_list {
        var object_list_element = object_list.element
        return generate_list_method(
            object_list_element,
            member.name,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_enum = type_shape.as_enum(object_result_type)
    if object_enum {
        return generate_enum_method(object_result_type, member.name, object_result, arguments_ast)
    }
    var object_class_ref = type_shape.as_class_ref(object_result_type)
    if not object_class_ref {
        var object_type_name = type_with_article(object_result_type)
        if type_shape.as_nullable(object_result_type) {
            report(
                "{null_opening(object_result.code, object_type_name)}, so '{member.name}' cannot be called on it yet: {null_advice(object_result.code)}",
            )
        } else {
            report("{object_type_name} has no function '{member.name}'")
        }
        return void_result()
    }
    var target_class = find_class_by_c_name(object_class_ref.c_name)
    crash target_class
    var argument_count = arguments_ast.count()
    var refused_form = address_form_refusal(target_class, member.name, argument_count, class_information)
    if not refused_form.is_empty() {
        report(refused_form)
        return void_result()
    }
    if not is_implicit_join(member) and not member.walked {
        report_private_member(target_class, member.name, class_information)
    }
    var vector_like = target_class.qualified_dotted == "Vector" or is_items_class(target_class)
    if vector_like and member.name.starts_with("parallel_each_") {
        return generate_vector_parallel_each(
            target_class,
            member.name,
            object_result,
            object_ast,
            scope,
            class_information,
        )
    }
    var found = find_or_instantiate_function(target_class, member.name)
    if not found {
        if member.name == "deep_copy" {
            var ensured_class_deep_copy = ensure_class_deep_copy(target_class)
            var empty_types = no_types()
            var class_type = class_type_of(target_class)
            var deep_copied = generate_generic_call(
                ensured_class_deep_copy,
                object_result,
                object_ast,
                arguments_ast,
                empty_types,
                class_type,
                scope,
                class_information,
            )
            deep_copied.owning_override = true
            return deep_copied
        }
        if member.name == "copy" {
            var no_type_arguments = List<Analysis.SpiteType>()
            var copied_type = Analysis.Types.ClassRefType(object_class_ref.c_name)
            return generate_generic_call(
                "{object_class_ref.c_name}_copy",
                object_result,
                object_ast,
                arguments_ast,
                no_type_arguments,
                copied_type,
                scope,
                class_information,
            )
        }
        var missed = range_miss(target_class, member.name)
        if target_class.qualified_dotted == "Vector" and is_function_form(member.name, arguments_ast) {
            missed = "'{member.name}' passes each item to a function, and an item of a Vector is borrowed from it, never passed on: give the item's class a function and call it with a member template, such as '{member.name}_<function>()'"
        }
        if is_items_class(target_class) and is_function_form(member.name, arguments_ast) {
            missed = items_form_miss(target_class, member.name)
        }
        if vector_like and is_function_form(member.name, arguments_ast) {
            var unpassed = unpassed_value_miss(target_class, member.name)
            if not unpassed.is_empty() {
                missed = unpassed
            }
        }
        var listing = vector_like or is_items_class(target_class) or target_class.qualified_dotted == "Vector"
        if listing and member.name == "map" and arguments_ast.count() == 1 {
            missed = removed_map_message()
        }
        if missed.is_empty() {
            if not reported_old_spelling(member.name) {
                var receiver_type = object_result.type
                report("'{type_display_name(receiver_type)}' does not define '{member.name}'")
            }
        } else {
            report(missed)
        }
        return void_result()
    }
    if item_values_on {
        item_note_call(found, target_class, arguments_ast, scope, class_information)
    }
    var asks_functions = member.name == "has_function" or member.name == "function_waits" or member.name == "argument_count"
    if asks_functions and target_class.c_name == "Spite_Class" {
        class_level_functions_used = true
        note_fact("flag class_level_functions_used")
    }
    if member.name == "source_folder" and target_class.c_name == "Spite_Class" {
        source_folder_used = true
        note_fact("flag source_folder_used")
    }
    var specialised_on_target = specialised_method_call(
        target_class,
        found,
        object_result,
        object_ast,
        arguments_ast,
        scope,
        class_information,
    )
    if specialised_on_target {
        return specialised_on_target
    }
    var function = specialised_for_arguments(target_class, found, arguments_ast, scope, class_information)
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.return_type
    var spread = spread_template(arguments_ast, class_information)
    if spread {
        var passed = spread_into(arguments_ast, spread, target_class, function, class_information)
        if passed.count() != function.parameters.count() {
            return void_result()
        }
        return generate_sequenced_call(
            function.c_name,
            object_result,
            object_ast,
            passed,
            parameter_types,
            function_return_type,
            scope,
            class_information,
        )
    }
    argument_lender_class = target_class
    argument_lender_function = function
    var called = generate_generic_call(
        function.c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
    lend_item(called, target_class, member.name, object_ast)
    lend_result(called, target_class, function)
    return called
}

# ../../../specs/standard_library.md#bytes-are-a-listbyte
func address_form_refusal(
    target: Analysis.ClassInfo,
    name: String,
    argument_count: Integer,
    calling_class: Analysis.ClassInfo,
): String {
    if current_path.starts_with("library/") or is_library_class(calling_class) {
        return ""
    }
    var owner = target.qualified_dotted
    if owner == "File" {
        if name == "read_bytes" and argument_count == 3 {
            return "a File reads bytes into a List<Byte>, not into memory at an address: 'read_bytes_at(position, count)' answers a 'List<Byte>?' of up to 'count' bytes from 'position', and 'read_bytes()' the whole file"
        }
        if (name == "write_bytes" or name == "append_bytes") and argument_count == 2 {
            return "a File writes bytes from a List<Byte>, not from memory at an address: write '{name}(bytes)'"
        }
        return ""
    }
    if owner == "BinaryReader" and name == "read_memory" {
        return "a BinaryReader reads from a List<Byte>, not from memory at an address: write 'read(bytes)', or 'read_from(bytes, start)' to read one value and leave what follows"
    }
    if owner != "Socket" {
        return ""
    }
    var plain = name
    var library_forms = ["read_bytes_into", "read_bytes_now_into", "write_bytes_from", "write_bytes_now_from"]
    var old_forms = ["read_bytes", "read_bytes_now", "write_bytes", "write_bytes_now"]
    if library_forms.contains(name) {
        var name_length = name.length()
        plain = name.slice(0, name_length - 5)
    } else if not old_forms.contains(name) or argument_count != 2 {
        return ""
    }
    if plain == "read_bytes" {
        return "a Socket reads bytes into a List<Byte>, not into memory at an address: write 'read_bytes()', which answers a 'List<Byte>?'"
    }
    if plain == "read_bytes_now" {
        return "a Socket reads bytes into a List<Byte>, not into memory at an address: write 'read_bytes_now()', which answers a 'List<Byte>'"
    }
    return "a Socket writes bytes from a List<Byte>, not from memory at an address: write '{plain}(bytes)'"
}

func may_call_an_operator(name: String, argument_count: Integer): Boolean {
    switch name {
        "get_at": return argument_count == 1
        "set_at": return argument_count == 2
        "negate": return argument_count == 0
        _: {
            var operators = [
                "sum"
                "subtract"
                "multiply"
                "divide"
                "remainder"
                "equals"
                "less_than"
                "greater_than"
            ]
            if operators.contains(name) {
                return argument_count == 1
            }
            if name.length() <= 4 {
                return false
            }
            if name.starts_with("get_") {
                return argument_count == 0
            }
            if name.starts_with("set_") {
                return argument_count == 1
            }
            return false
        }
    }
}

func operator_written_for(name: String, receiver: String, arguments: List<String>): String {
    if name == "negate" {
        return "'negate' is what '-' calls: write '-{receiver}'"
    }
    if name.starts_with("get_") and name != "get_at" {
        var name_length = name.length()
        var attribute = name.slice(4, name_length)
        return "'{name}' is what reading '{attribute}' calls: write '{receiver}.{attribute}'"
    }
    var first = arguments.first()
    crash first
    switch name {
        "get_at": return "'get_at' is what '[]' calls: write '{receiver}[{first}]'"
        "set_at": {
            var second = arguments.last()
            crash second
            return "'set_at' is what '[] =' calls: write '{receiver}[{first}] = {second}'"
        }
        "sum": return "'sum' is what '+' calls: write '{receiver} + {first}'"
        "subtract": return "'subtract' is what '-' calls: write '{receiver} - {first}'"
        "multiply": return "'multiply' is what '*' calls: write '{receiver} * {first}'"
        "divide": return "'divide' is what '/' calls: write '{receiver} / {first}'"
        "remainder": return "'remainder' is what '%' calls: write '{receiver} % {first}'"
        "equals": return "'equals' is what '==' calls: write '{receiver} == {first}', or '{receiver} != {first}' for 'not {receiver}.equals({first})'"
        "less_than": return "'less_than' is what '<' calls: write '{receiver} < {first}'"
        "greater_than": return "'greater_than' is what '>' calls: write '{receiver} > {first}'"
        _: {
            var name_length = name.length()
            var attribute = name.slice(4, name_length)
            return "'{name}' is what writing '{attribute}' calls: write '{receiver}.{attribute} = {first}'"
        }
    }
}

func report_operator_function_call(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var name = member.name
    var argument_count = arguments_ast.count()
    assert may_call_an_operator(name, argument_count)
    assert not try_resolve_static_path(object_ast, class_information.qualified_dotted)
    var saved_counter = temporary_counter
    var probe = generate_expression(object_ast, scope, class_information)
    rewind_temporaries(saved_counter)
    var receiver_type = probe.type
    assert operator_stands_in(name, receiver_type, arguments_ast, scope, class_information)
    var printer = Syntax.SourcePrinter()
    var receiver = printer.source_receiver(object_ast)
    var arguments = List<String>()
    var argument_index = 0
    while argument_index < arguments_ast.count() {
        var argument = printer.source_expression(arguments_ast[argument_index])
        arguments.append(argument)
        argument_index = argument_index + 1
    }
    var message = operator_written_for(name, receiver, arguments)
    report(message)
}

func operator_stands_in(
    name: String,
    receiver_type: Analysis.SpiteType,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if type_shape.as_list(receiver_type) or type_shape.as_dictionary(receiver_type) {
        return name == "get_at" or name == "set_at"
    }
    if type_shape.as_string(receiver_type) {
        return name == "sum" or name == "equals" or name == "less_than" or name == "greater_than"
    }
    var receiver_union = type_shape.as_union(receiver_type)
    if receiver_union {
        var union_information = find_union_by_c_name(receiver_union.c_name)
        if not union_information {
            return false
        }
        if union_information.members.is_empty() {
            return false
        }
        var index = 0
        while index < union_information.members.count() {
            var member_class = union_information.members[index]
            if not class_offers_operator(member_class, name, arguments_ast, scope, class_information) {
                return false
            }
            index = index + 1
        }
        return true
    }
    var class_ref = type_shape.as_class_ref(receiver_type)
    if not class_ref {
        return false
    }
    var target_class = find_class_by_c_name(class_ref.c_name)
    if not target_class {
        return false
    }
    return class_offers_operator(target_class, name, arguments_ast, scope, class_information)
}

func class_offers_operator(
    target_class: Analysis.ClassInfo,
    name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if target_class.c_name == class_information.c_name and current_function == name {
        return false
    }
    var function = find_or_instantiate_function(target_class, name)
    if not function {
        return false
    }
    var wanted = arguments_ast.count()
    if function.parameters.count() != wanted {
        return false
    }
    var first_parameter = function.parameters.first()
    if not first_parameter {
        return true
    }
    var first_parameter_type = first_parameter.type
    var passed_function = type_shape.as_class_ref(first_parameter_type)
    if passed_function {
        if passed_function.has_signature {
            return false
        }
    }
    var first_argument = arguments_ast.first()
    crash first_argument
    if name == "equals" {
        return not compares_identity_instead(function, target_class, first_argument, scope, class_information)
    }
    return true
}

func spread_template(
    arguments_ast: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Analysis.TemplateInfo? {
    assert arguments_ast.count() == 1
    var call = shape.as_call(arguments_ast[0])
    assert call
    crash call.callee
    var callee = shape.as_identifier(call.callee)
    assert callee
    assert not class_information.find_function(callee.name)
    var index = 0
    while index < class_information.templates.count() {
        var template = class_information.templates[index]
        if template.range and not template.plural and template.member_name_for(callee.name) == "{template.symbol_parameter}s" {
            if template_range_owner(class_information, template) == "function" {
                return template
            }
        }
        index = index + 1
    }
    return null
}

func generate_sequenced_call(
    function_c_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    return_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    record_call(function_c_name)
    var lines = List<String>()
    var object_temporary = next_temporary()
    var object_result_type = object_result.type
    lines.append("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    var passed_arguments = List<String>()
    var index = 0
    while index < argument_codes.count() and index < expected_types.count() {
        var temporary = next_temporary()
        lines.append("{c_type_name(expected_types[index])} {temporary} = {argument_codes[index]};")
        passed_arguments.append(temporary)
        index = index + 1
    }
    var object_owned = owns(object_result, object_ast)
    var held_object = ExpressionResult(object_temporary, object_result_type)
    var waited = hoisted_wait_after(function_c_name, lines, held_object, object_owned, passed_arguments, return_type)
    if waited {
        return waited
    }
    var passed = passed_arguments.copy()
    passed.prepend(object_temporary)
    var call_code = "{function_c_name}({passed.join(", ")})"
    var release_object = ""
    if object_owned {
        release_object = "{release_call(object_result_type, object_temporary)};"
    }
    if type_shape.is_void(return_type) {
        lines.append("{call_code};")
        lines.append(release_object)
        return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
    }
    var call_temporary = next_temporary()
    lines.append("{c_type_name(return_type)} {call_temporary} = {call_code};")
    lines.append(release_object)
    lines.append("{call_temporary};")
    return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
}

func spread_into(
    arguments_ast: List<Syntax.Expressions.Expression>,
    template: Analysis.TemplateInfo,
    target_class: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    class_information: Analysis.ClassInfo,
): List<Syntax.Expressions.Expression> {
    var call = shape.as_call(arguments_ast[0])
    crash call
    var ranged = range_function(class_information, template)
    var range_owner = range_function_owner(class_information, template)
    var range = range_path(template)
    var same_function = false
    if ranged {
        if range_owner {
            same_function = ranged.c_name == function.c_name and range_owner.c_name == target_class.c_name
        }
    }
    if not same_function {
        var printer = Syntax.SourcePrinter()
        var passed_text = printer.source_expression(arguments_ast[0])
        var ranged_function = range.last()
        crash ranged_function
        report(
            "'{passed_text}' fills the arguments of '{ranged_function}', one value per argument, so it is only the whole argument list of a call to '{ranged_function}', not of '{function.name}'",
        )
        return List<Syntax.Expressions.Expression>()
    }
    var expanded = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < function.parameters.count() {
        var callee: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(
            "{template.prefix}{function.parameters[index].name}{template.suffix}",
        )
        var one: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, call.arguments)
        expanded.append(one)
        index = index + 1
    }
    return expanded
}

func generate_enum_method(
    enum_type: Analysis.SpiteType,
    name: String,
    object_result: ExpressionResult,
    arguments_ast: List<Syntax.Expressions.Expression>,
): ExpressionResult {
    if name == "to_integer" and arguments_ast.is_empty() {
        var numbering = enum_number_function(enum_type)
        if not numbering.is_empty() {
            var integer_spite_type = integer_type()
            return ExpressionResult("{numbering}({object_result.code})", integer_spite_type)
        }
    }
    var enum_class = boxed_class_of(enum_type)
    crash enum_class
    var function = find_or_instantiate_function(enum_class, name)
    if function {
        if arguments_ast.is_empty() {
            var function_return_type = function.return_type
            return ExpressionResult("{function.c_name}({object_result.code})", function_return_type)
        }
    }
    report(
        "{type_with_article(enum_type)} value has no function '{name}': an enum value answers 'to_string()', 'to_debug()' and 'to_integer()'",
    )
    return void_result()
}

func enum_number_function(enum_type: Analysis.SpiteType): String {
    var enumeration = type_shape.as_enum(enum_type)
    crash enumeration
    var information = enums.find_by_c_name(enumeration.c_name)
    crash information
    var name = "{information.c_name}___number"
    if not enum_number_functions.contains(name) {
        enum_number_functions.append(name)
        var lines = List<String>()
        lines.append("static int32_t {name}({information.c_name} value) \{")
        lines.append("switch (value) \{")
        var index = 0
        while index < information.values.count() {
            var value_name = information.values[index]
            var number = index
            if information.is_numbered() {
                crash information.numbers[index]
                number = information.numbers[index]
            }
            lines.append("case {information.c_name}_{value_name}: return {number};")
            index = index + 1
        }
        lines.append("default: break;")
        lines.append("}")
        lines.append("fflush(stdout);")
        lines.append(
            "fprintf(stderr, \"spite: a value of {information.simple_name} that the running code does not know has no number\\n\");",
        )
        lines.append("exit(1);")
        lines.append("}")
        builder.add_prototype("static int32_t {name}({information.c_name} value);")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    return name
}

func generate_value_method(
    kind: Analysis.Types.NumericKind,
    name: String,
    object_result: ExpressionResult,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var value_class = value_class_of(kind)
    if value_class {
        var function = find_or_instantiate_function(value_class, name)
        if function {
            if maths.is_constant(name) and is_inline_supplied(function) {
                report(
                    "'{name}' is a constant of the class {value_class.qualified_dotted}, not of a value: write '{value_class.qualified_dotted}.{name}'",
                )
                return void_result()
            }
            if kind == 'address_kind' and is_memory_access(name) and not is_library_class(class_information) {
                report(
                    "'{name}' reads or writes the memory at an address, which only library/ does: use a class of the standard library, or 'TypedMemory<T>' for values of any type",
                )
            }
            var converted_type = function.return_type
            var converted_scalar = type_shape.as_scalar(converted_type)
            if converted_scalar and name.starts_with("to_") and not function.has_body and arguments_ast.is_empty() {
                var object_type = object_result.type
                var converted = checked_narrowing(object_result.code, object_type, converted_type)
                if not converted.is_empty() {
                    return ExpressionResult(converted, converted_type)
                }
            }
            var parameter_types = parameter_types_of(function.parameters)
            var argument_codes = generate_argument_list(arguments_ast, parameter_types, scope, class_information)
            argument_codes.prepend(object_result.code)
            var function_return_type = function.return_type
            return ExpressionResult("{function.c_name}({argument_codes.join(", ")})", function_return_type)
        }
        var spelling = maths.spelled(name)
        if not spelling.is_empty() {
            var spelled_function = find_or_instantiate_function(value_class, spelling)
            if spelled_function {
                report(
                    "{value_class.qualified_dotted} has no function '{name}': Spite spells it '{spelling}', since no name is abbreviated",
                )
                return void_result()
            }
        }
    }
    var object_result_type = object_result.type
    if name == "text" {
        report(
            "{type_display_name(object_result_type)} turns into text with 'to_string()', a cast like 'to_integer()': write 'to_string()'",
        )
        return void_result()
    }
    if reported_old_spelling(name) {
        return void_result()
    }
    var bitwise_names = [
        "shifted_left"
        "shifted_right"
        "bits_and"
        "bits_or"
        "bits_exclusive_or"
        "bits_inverted"
        "set_bit_count"
        "leading_zero_count"
        "trailing_zero_count"
    ]
    if bitwise_names.contains(name) {
        report(
            "{type_with_article(object_result_type)} has no function '{name}': the bitwise functions are on the whole numbers, Tiny to UnsignedLong. Cast it first, like 'var whole: Long = value'",
        )
        return void_result()
    }
    if is_memory_access(name) {
        report(
            "{type_with_article(object_result_type)} has no function '{name}': reading and writing memory is a function of the address, so the value needs to be a 'Memory.Address'",
        )
        return void_result()
    }
    report("{type_with_article(object_result_type)} has no function '{name}'")
    return void_result()
}

func is_memory_access(name: String): Boolean {
    var atomics = ["exchange_long", "add_long_atomically", "compare_and_swap_long"]
    return name.starts_with("read_") or name.starts_with("write_") or atomics.contains(name)
}

func generate_written_string_call(
    written: Analysis.FunctionInfo,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var lines = List<String>()
    var release = ""
    var receiver_code = object_result.code
    if owns(object_result, object_ast) {
        var object_temporary = next_temporary()
        lines.append("SpiteString {object_temporary} = {object_result.code};")
        release = "SpiteString___release({object_temporary});"
        receiver_code = object_temporary
    }
    var parameter_types = parameter_types_of(written.parameters)
    var argument_codes = generate_argument_list(arguments_ast, parameter_types, scope, class_information)
    var full_arguments = argument_codes.copy()
    full_arguments.prepend(receiver_code)
    var call = "{written.c_name}({full_arguments.join(", ")})"
    if release.is_empty() {
        var written_return_type = written.return_type
        return ExpressionResult(call, written_return_type)
    }
    var result_temporary = next_temporary()
    var written_return_type = written.return_type
    lines.append("{c_type_name(written_return_type)} {result_temporary} = {call};")
    lines.append(release)
    lines.append("{result_temporary};")
    return ExpressionResult("(\{ {lines.join(" ")} })", written_return_type)
}

func generate_string_method(
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var written = written_string_function(name)
    if written {
        if arguments_ast.count() != written.parameters.count() {
            report(
                "'{name}' takes {written.parameters.count()} argument(s), and this call passes {arguments_ast.count()}",
            )
            return void_result()
        }
        return generate_written_string_call(written, object_result, object_ast, arguments_ast, scope, class_information)
    }
    var read_enum = read_enum_named(name, class_information)
    if read_enum and arguments_ast.is_empty() {
        var text_code = object_result.code
        var release = ""
        if owns(object_result, object_ast) {
            release = " SpiteString___release(spite_enum_text);"
        }
        var read_enum_type: Analysis.SpiteType = read_enum
        var read_code = enum_from_text(text_code, release, read_enum)
        var read_type = nullable_type_of(read_enum_type)
        return ExpressionResult(read_code, read_type)
    }
    if name == "upper" or name == "lower" {
        report("text has no '{name}()': write '{name}_case()', which names what it does without abbreviating")
        return void_result()
    }
    if not reported_old_spelling(name) {
        report("String has no method '{name}'")
    }
    return void_result()
}

func report_list_method_missing(name: String) {
    if name == "map" {
        var removed = removed_map_message()
        report(removed)
        return
    }
    if name == "add" {
        report(
            "List has no method 'add', which does not say where: write 'append' to add at the end, or 'prepend' at the start",
        )
        return
    }
    if name == "pop" {
        report("List has no method 'pop': write 'remove_last()', or 'remove_first()' to take from the start")
        return
    }
    report("List has no method '{name}'")
}

func removed_map_message(): String {
    return "there is no 'map(function)': collect a member of each element with 'map_<member>()', and a value computed from each element by giving the element's class a read-only attribute (a 'get_<name>()' with no setter) and writing 'map_<name>()'"
}

func reported_old_spelling(name: String): Boolean {
    if name == "Heap" {
        report(
            "there is no 'Heap<T>': a class, a list and a text are references already, so a class that holds one of its own kind declares an ordinary attribute, like 'var left: Expression? = null' ('Memory.Heap' is the allocator, for containers of your own)",
        )
        return true
    }
    if name == "Json" {
        report(
            "there is no 'Json': it is two classes, 'JsonWriter<T>()' whose 'write(value)' makes the text, and 'JsonReader<T>()' whose 'read(text)' answers a 'T?'",
        )
        return true
    }
    var spelled = old_spellings.new_spelling(name)
    if spelled.is_empty() {
        return false
    }
    report("'{name}' is spelled '{spelled}'")
    return true
}

func generate_list_method(
    element: Analysis.SpiteType,
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if name == "deep_copy" {
        var ensured_list_deep_copy = ensure_list_deep_copy(element)
        var empty_types = no_types()
        var list_type = list_type_of(element)
        var copied_list = generate_generic_call(
            ensured_list_deep_copy,
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            list_type,
            scope,
            class_information,
        )
        copied_list.owning_override = true
        return copied_list
    }
    var byte_access = is_byte_access(name)
    if byte_access {
        if not is_byte_element(element) {
            var listed_type = list_type_of(element)
            report(
                "'{name}' reads and writes the bytes of a List<Byte>, and this is {type_with_article(listed_type)}: only a List<Byte> answers it",
            )
            return void_result()
        }
        var proven_access = proven_byte_access(name, object_result, object_ast, arguments_ast, scope, class_information)
        if proven_access {
            return proven_access
        }
    }
    if is_function_form(name, arguments_ast) {
        var form_list = list_class_of(element)
        var form_argument = arguments_ast.first()
        return generate_function_form(
            form_list,
            element,
            name,
            object_result,
            object_ast,
            form_argument,
            scope,
            class_information,
        )
    }
    var public_names = [
        "append"
        "prepend"
        "insert"
        "set_at"
        "get_at"
        "remove_at"
        "remove_swapping"
        "remove_first"
        "remove_last"
        "truncate"
        "swap"
        "first"
        "last"
        "clear"
        "reverse"
        "is_empty"
        "count"
        "contains"
        "index_of"
        "join"
        "copy"
        "reserve"
        "to_utf8_text"
    ]
    if byte_access or public_names.contains(name) {
        var function = list_class_of(element).find_function(name)
        if function {
            var parameter_types = parameter_types_of(function.parameters)
            var function_return_type = function.return_type
            var cleared_list = object_result
            if name == "clear" and waits_for_handles(element) {
                cleared_list = waited_before_clearing(element, object_result)
            }
            var called = generate_generic_call(
                function.c_name,
                cleared_list,
                object_ast,
                arguments_ast,
                parameter_types,
                function_return_type,
                scope,
                class_information,
            )
            if name == "copy" {
                called.owning_override = true
            }
            return called
        }
    }
    var list_class = list_class_of(element)
    if name.starts_with("parallel_each_") {
        var single = List<String>()
        single.append(name)
        var parallel = generate_parallel_each(list_class, element, single)
        if not parallel {
            var void_spite_type = void_type()
            return ExpressionResult("0", void_spite_type)
        }
        var empty_types = no_types()
        var nothing_returned = parallel.return_type
        return generate_generic_call(
            parallel.c_name,
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            nothing_returned,
            scope,
            class_information,
        )
    }
    var template = element_template_of(list_class, name)
    if not template {
        report_list_method_missing(name)
        return void_result()
    }
    var function = instantiate_element_template(list_class, element, template, name, class_information)
    if not function {
        return void_result()
    }
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.return_type
    return generate_generic_call(
        function.c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func element_class_of(element: Analysis.SpiteType): Analysis.ClassInfo? {
    if type_shape.as_string(element) {
        return find_class_by_c_name("SpiteString")
    }
    var element_class_ref = type_shape.as_class_ref(element)
    assert element_class_ref
    assert not element_class_ref.has_signature
    return find_class_by_c_name(element_class_ref.c_name)
}

func member_type_of(element_class: Analysis.ClassInfo, member_name: String): Analysis.SpiteType? {
    var field = element_class.find_field(member_name)
    if field {
        return field.type
    }
    var function = member_function(element_class, member_name)
    if function {
        return function.return_type
    }
    return null
}

func member_function(element_class: Analysis.ClassInfo, member_name: String): Analysis.FunctionInfo? {
    var function = find_or_instantiate_function(element_class, member_name)
    if function {
        if function.parameters.count() == 0 {
            return function
        }
    }
    var getter = element_class.find_function("get_{member_name}")
    if getter {
        if getter.parameters.count() == 0 {
            return getter
        }
    }
    return null
}

func is_numeric_type(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return scalar.kind != 'boolean_kind'
    }
    return false
}

func is_boolean_type(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return scalar.kind == 'boolean_kind'
    }
    return false
}

func element_template_of(list_class: Analysis.ClassInfo, name: String): Analysis.TemplateInfo? {
    var index = 0
    while index < list_class.templates.count() {
        var template = list_class.templates[index]
        var member_name = template.member_name_for(name)
        if not member_name.is_empty() and template.range {
            return template
        }
        index = index + 1
    }
    return null
}

func readable_member_names(element_class: Analysis.ClassInfo): List<String> {
    var member_names = List<String>()
    var index = 0
    while index < element_class.fields.count() {
        var field_name = element_class.fields[index].name
        if not field_name.starts_with("_") {
            member_names.append(field_name)
        }
        index = index + 1
    }
    index = 0
    while index < element_class.declared_functions.count() {
        var function = element_class.declared_functions[index]
        var outside_readable = not function.name.starts_with("_")
        if outside_readable and not function.is_constructor and function.parameters.is_empty() {
            member_names.append(function.name)
            if function.name.starts_with("get_") {
                var name_length = function.name.length()
                var read_name = function.name.slice(4, name_length)
                member_names.append(read_name)
            }
        }
        index = index + 1
    }
    return member_names
}

func plain_union_of(element: Analysis.SpiteType): Analysis.UnionInfo? {
    var unioned = type_shape.as_union(element)
    assert unioned
    var found = find_union_by_c_name(unioned.c_name)
    assert found
    assert not found.is_shape
    assert not found.members.is_empty()
    return found
}

func union_member_type(information: Analysis.UnionInfo, member_name: String): Analysis.SpiteType? {
    var first_class = information.members.first()
    crash first_class
    var common = member_type_of(first_class, member_name)
    assert common
    var index = 1
    while index < information.members.count() {
        var other = member_type_of(information.members[index], member_name)
        assert other
        assert types_equal(other, common)
        index = index + 1
    }
    return common
}

func union_member_names(information: Analysis.UnionInfo): List<String> {
    var common_names = List<String>()
    var first_class = information.members.first()
    crash first_class
    var first_names = readable_member_names(first_class)
    var index = 0
    while index < first_names.count() {
        var member_name = first_names[index]
        if union_member_type(information, member_name) and not common_names.contains(member_name) {
            common_names.append(member_name)
        }
        index = index + 1
    }
    return common_names
}

func union_member_class(information: Analysis.UnionInfo, word: String): Analysis.ClassInfo? {
    var index = 0
    while index < information.members.count() {
        var member_class = information.members[index]
        var class_words = snake_words(member_class.simple_name)
        var plural = program_inflected(class_words, true)
        if plural == word {
            return member_class
        }
        index = index + 1
    }
    return null
}

# ../../../docs/collections.md#member-templates-loops-you-do-not-write
func union_class_template(
    list_class: Analysis.ClassInfo,
    member_class: Analysis.ClassInfo,
    prefix: String,
    name: String,
): Analysis.FunctionInfo? {
    var existing = list_class.find_function(name)
    if existing {
        return existing
    }
    var kept = member_class.qualified_dotted
    var dictionary = list_class.qualified_dotted == "Dictionary"
    if prefix == "remove_where_" and dictionary {
        report(
            "'{name}' removes items in place, and a dictionary's values are removed by key: walk 'keys()' and 'remove(key)' the ones whose value is a '{member_class.simple_name}'",
        )
        return null
    }
    var lines = List<String>()
    switch prefix {
        "filter_": {
            lines.append("func {name}(): List<{kept}> \{")
            lines.append("    var kept = List<{kept}>()")
        }
        "count_": {
            lines.append("func {name}(): Integer \{")
            lines.append("    var counted = 0")
        }
        "remove_where_": lines.append("func {name}() \{")
        _: lines.append("func {name}(): Boolean \{")
    }
    lines.append("    var index = 0")
    if dictionary {
        lines.append("    var listed = values()")
        lines.append("    while index < listed.count() \{")
        lines.append("        var item = listed[index]")
    } else {
        lines.append("    while index < item_count \{")
        lines.append("        var item = values.read_value(items, index)")
    }
    switch prefix {
        "filter_": {
            lines.append("        if item == {kept} \{")
            lines.append("            kept.append(item)")
            lines.append("        }")
            lines.append("        index = index + 1")
        }
        "count_": {
            lines.append("        if item == {kept} \{")
            lines.append("            counted = counted + 1")
            lines.append("        }")
            lines.append("        index = index + 1")
        }
        "any_": {
            lines.append("        if item == {kept} \{")
            lines.append("            return true")
            lines.append("        }")
            lines.append("        index = index + 1")
        }
        "all_": {
            lines.append("        if item != {kept} \{")
            lines.append("            return false")
            lines.append("        }")
            lines.append("        index = index + 1")
        }
        _: {
            lines.append("        if item == {kept} \{")
            lines.append("            remove_at(index)")
            lines.append("        } else \{")
            lines.append("            index = index + 1")
            lines.append("        }")
        }
    }
    lines.append("    }")
    switch prefix {
        "filter_": lines.append("    return kept")
        "count_": lines.append("    return counted")
        "any_": lines.append("    return false")
        "all_": lines.append("    return true")
        _: {}
    }
    lines.append("}")
    var source = lines.join("\n")
    return register_fused_function(list_class, source, name)
}

func element_member_type(element: Analysis.SpiteType, member_name: String): Analysis.SpiteType? {
    var element_class = element_class_of(element)
    if element_class {
        return member_type_of(element_class, member_name)
    }
    var element_union = plain_union_of(element)
    if element_union {
        return union_member_type(element_union, member_name)
    }
    var element_shape = shape_of(element)
    assert element_shape
    return shape_member_type(element_shape, member_name)
}

func element_member_names(element: Analysis.SpiteType): List<String> {
    var element_class = element_class_of(element)
    if element_class {
        return readable_member_names(element_class)
    }
    var element_union = plain_union_of(element)
    if element_union {
        return union_member_names(element_union)
    }
    var member_names = List<String>()
    var element_shape = shape_of(element)
    if element_shape {
        var index = 0
        while index < element_shape.shape_fields.count() {
            member_names.append(element_shape.shape_fields[index].name)
            index = index + 1
        }
    }
    return member_names
}

func asks_question(template_prefix: String): Boolean {
    return template_prefix == "filter_" or template_prefix == "any_" or template_prefix == "all_" or template_prefix == "count_" or template_prefix == "remove_where_"
}

func collected_word(member_name: String): String {
    if is_question_name(member_name) {
        return member_name
    }
    return program_inflected(member_name, true)
}

func is_question_name(member_name: String): Boolean {
    return member_name.starts_with("is_") or member_name.starts_with("has_") or member_name.starts_with("can_")
}

func plural_members(member_names: List<String>, word: String): List<String> {
    var found = List<String>()
    var index = 0
    while index < member_names.count() {
        var member_name = member_names[index]
        if not is_question_name(member_name) and program_inflected(member_name, true) == word and not found.contains(member_name) {
            found.append(member_name)
        }
        index = index + 1
    }
    return found
}

func template_member_name(template: Analysis.TemplateInfo, name: String, member_names: List<String>): String {
    var word = template.member_name_for(name)
    if word.is_empty() {
        return word
    }
    if not template.plural {
        var question = "is_{word}"
        if asks_question(template.prefix) and not member_names.contains(word) and member_names.contains(question) {
            return question
        }
        return word
    }
    if is_question_name(word) and member_names.contains(word) {
        return word
    }
    var found = plural_members(member_names, word)
    if found.count() != 1 {
        return ""
    }
    var member_name = found[0]
    if word != member_name and program_inflected(word, false) != member_name {
        return ""
    }
    return member_name
}

func plural_member_problem(
    template: Analysis.TemplateInfo,
    name: String,
    member_names: List<String>,
    element_label: String,
): String {
    var word = template.member_name_for(name)
    var found = plural_members(member_names, word)
    if found.count() > 1 {
        return "'{name}' could collect '{found.join("' or '")}' of '{element_label}', since each is '{word}' in the plural: rename one of them"
    }
    if found.count() == 1 {
        var member_name = found[0]
        var singular = program_inflected(word, false)
        return "'{name}' would collect '{member_name}', but its plural '{word}' gives back '{singular}', not '{member_name}': add the word to the irregulars by reopening 'String.Inflection', or rename '{member_name}'"
    }
    var plural_word = program_inflected(word, true)
    if member_names.contains(word) and plural_word != word {
        return "'{name}' answers every '{word}', so it is written in the plural: '{template.prefix}{plural_word}{template.suffix}'"
    }
    return ""
}

func instantiate_element_template(
    list_class: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    template: Analysis.TemplateInfo,
    name: String,
    caller: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    var member_names = element_member_names(element)
    var member_name = template_member_name(template, name, member_names)
    if template.plural and member_name.is_empty() {
        var plural_label = type_display_name(element)
        var plural_problem = plural_member_problem(template, name, member_names, plural_label)
        if not plural_problem.is_empty() {
            report(plural_problem)
            return null
        }
        member_name = template.member_name_for(name)
    }
    var element_class = element_class_of(element)
    var element_shape = shape_of(element)
    var element_union = plain_union_of(element)
    var member_type: Analysis.SpiteType? = null
    if element_class {
        member_type = member_type_of(element_class, member_name)
    } else if element_shape {
        member_type = shape_member_type(element_shape, member_name)
    } else if element_union {
        member_type = union_member_type(element_union, member_name)
    }
    var element_label = type_display_name(element)
    var asks_enum = asks_question(template.prefix) and template.suffix.is_empty() and not template.plural
    if asks_enum and not element_shape {
        var word = template.member_name_for(name)
        var listing = enum_members_listing(element, word)
        if member_type and member_name == word and not listing.is_empty() {
            report(
                "'{name}' could read the member '{word}' of '{element_label}' or compare '{listing.join("' or '")}' with '{word}', a value of its enum: rename the member '{word}'",
            )
            return null
        }
        if not member_type and listing.count() > 1 {
            report(
                "'{name}' could read '{listing.join("' or '")}', whose enums both list '{word}': write the comparison as a Boolean member of {element_label}, or pass a function",
            )
            return null
        }
        if not member_type and listing.count() == 1 {
            var existing_compared = list_class.find_function(name)
            if existing_compared {
                return existing_compared
            }
            var compared_member = listing[0]
            compared_value_name = word
            var compared_owner = element_owner_c_name(element)
            var boolean_spite_type = boolean_type()
            return instantiate_template(
                list_class,
                template,
                compared_member,
                boolean_spite_type,
                compared_owner,
                name,
                null,
            )
        }
    }
    var class_prefixes = ["filter_", "count_", "any_", "all_", "remove_where_"]
    if element_union and class_prefixes.contains(template.prefix) and template.suffix.is_empty() {
        var member_class = union_member_class(element_union, member_name)
        if member_class {
            if member_type {
                report(
                    "'{name}' could keep the '{member_class.simple_name}' items of '{element_label}' or filter by their attribute '{member_name}': rename the attribute",
                )
                return null
            }
            return union_class_template(list_class, member_class, template.prefix, name)
        }
    }
    if not member_type and not element_shape {
        var chained = chained_element_template(list_class, element, template, name)
        if chained {
            return chained
        }
    }
    if not member_type {
        var hint = passing_hint(caller, template.prefix, member_name)
        if asks_enum and not element_shape {
            hint = ", and no enum of its members lists '{member_name}'{hint}"
        }
        report("'{element_label}' has no attribute or zero argument function '{member_name}' for '{name}'{hint}")
        return null
    }
    var existing = list_class.find_function(name)
    if existing {
        return existing
    }
    var is_field = element_member_is_field(element, member_name)
    var requirement = member_requirement(template.prefix, is_field, member_name, member_type)
    if not requirement.is_empty() {
        report(
            "'{name}': the member '{member_name}' of '{element_label}' {described_member(member_type)}, but '{template.prefix}' needs it to {requirement}",
        )
        return null
    }
    var owner_c_name = element_owner_c_name(element)
    return instantiate_template(list_class, template, member_name, member_type, owner_c_name, name, null)
}

func enum_members_listing(element: Analysis.SpiteType, value: String): List<String> {
    var listing = List<String>()
    var member_names = element_member_names(element)
    var index = 0
    while index < member_names.count() {
        var candidate = member_names[index]
        var candidate_type = element_member_type(element, candidate)
        var candidate_length = candidate.length()
        var read_name = candidate.slice(4, candidate_length)
        if candidate.starts_with("get_") and member_names.contains(read_name) {
            candidate_type = null
        }
        if candidate_type {
            var listed_enum = type_shape.as_enum(candidate_type)
            if listed_enum {
                if listed_enum.values.contains(value) and not listing.contains(candidate) {
                    listing.append(candidate)
                }
            }
        }
        index = index + 1
    }
    return listing
}

func passing_hint(caller: Analysis.ClassInfo, prefix: String, member_name: String): String {
    if prefix == "find_by_" or prefix == "find_index_by_" {
        return ""
    }
    var function = caller.find_function(member_name)
    if not function {
        return ""
    }
    if function.is_constructor {
        return ""
    }
    var form_length = prefix.length() - 1
    var form = prefix.slice(0, form_length)
    return ": a template reads a member of each element, never a function of this class, so pass this class's '{member_name}' instead: '{form}({member_name})'"
}

func shape_of(spite_type: Analysis.SpiteType): Analysis.UnionInfo? {
    var shaped_union = type_shape.as_union(spite_type)
    assert shaped_union
    var shaped = find_union_by_c_name(shaped_union.c_name)
    assert shaped
    assert shaped.is_shape
    return shaped
}

func element_member_is_field(element: Analysis.SpiteType, member_name: String): Boolean {
    var element_class = element_class_of(element)
    if element_class {
        return is_field_of(element_class, member_name)
    }
    var element_union = plain_union_of(element)
    if element_union {
        var first_class = element_union.members.first()
        crash first_class
        return is_field_of(first_class, member_name)
    }
    var element_shape = shape_of(element)
    crash element_shape
    if find_required_function(element_shape, member_name) {
        return false
    }
    return true
}

func element_owner_c_name(element: Analysis.SpiteType): String {
    var element_class = element_class_of(element)
    if element_class {
        return element_class.c_name
    }
    var element_union = plain_union_of(element)
    if element_union {
        return element_union.c_name
    }
    var element_shape = shape_of(element)
    crash element_shape
    return element_shape.c_name
}

func is_field_of(element_class: Analysis.ClassInfo, member_name: String): Boolean {
    var field = element_class.find_field(member_name)
    if not field {
        return false
    }
    return true
}

func described_member(member_type: Analysis.SpiteType): String {
    if type_shape.is_void(member_type) {
        return "returns nothing"
    }
    var label = type_label(member_type)
    return "is {with_article(label)}"
}

func member_requirement(
    template_prefix: String,
    is_field: Boolean,
    member_name: String,
    member_type: Analysis.SpiteType,
): String {
    var wants_boolean = template_prefix == "filter_" or template_prefix == "any_" or template_prefix == "all_" or template_prefix == "count_" or template_prefix == "remove_where_"
    if wants_boolean and not is_boolean_type(member_type) {
        if template_prefix == "count_" and is_numeric_type(member_type) {
            return "return Boolean (to add up a numeric member use 'sum_{member_name}')"
        }
        return "return Boolean"
    }
    if template_prefix == "sum_" and not is_numeric_type(member_type) {
        return "return a numeric type"
    }
    if template_prefix == "each_" and is_field {
        return "be a function: reading an attribute and discarding it does nothing"
    }
    if template_prefix == "map_" and type_shape.is_void(member_type) {
        return "return a value (to only call it for each element, write 'each_{member_name}()')"
    }
    if template_prefix == "map_" and is_boolean_type(member_type) {
        return "be a value to collect, not a test: write 'filter_{member_name}()' to keep the elements it is true for, 'count_{member_name}()' to count them, or 'any_{member_name}()' or 'all_{member_name}()' to ask whether any or all of them pass"
    }
    var ordered = is_numeric_type(member_type) or type_shape.as_string(member_type)
    if template_prefix == "sort_by_" and not ordered {
        return "return something ordered: a number or a String"
    }
    var finds = template_prefix == "find_by_" or template_prefix == "find_index_by_"
    if finds and not joins_as_text(member_type) {
        return "return something comparable: a number, Boolean, String, Symbol or enum value"
    }
    return ""
}

func instantiate_member_templates_of(list_class: Analysis.ClassInfo) {
    var element = list_class.codegen_types.first()
    var element_class_ref = type_shape.as_class_ref(element)
    assert element_class_ref
    var element_class = find_class_by_c_name(element_class_ref.c_name)
    assert element_class
    var member_names = readable_member_names(element_class)
    var template_index = 0
    while template_index < list_class.templates.count() {
        var template = list_class.templates[template_index]
        var member_index = 0
        if not template.range {
            member_index = member_names.count()
        }
        while member_index < member_names.count() {
            var member_name = member_names[member_index]
            var member_type = member_type_of(element_class, member_name)
            if member_type {
                var is_field = is_field_of(element_class, member_name)
                var requirement = member_requirement(template.prefix, is_field, member_name, member_type)
                var word = member_name
                if template.plural and not is_question_name(member_name) {
                    word = program_inflected(member_name, true)
                }
                var name = "{template.prefix}{word}{template.suffix}"
                if requirement.is_empty() and not list_class.find_function(name) {
                    var kept = instantiate_template(
                        list_class,
                        template,
                        member_name,
                        member_type,
                        element_class.c_name,
                        name,
                        null,
                    )
                    kept.kept_for_prompt = true
                }
            }
            member_index = member_index + 1
        }
        template_index = template_index + 1
    }
}

func generate_fused_chain(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var steps = List<Syntax.Expressions.CallExpression>()
    var base = chain_base(object_ast, steps)
    assert not steps.is_empty()
    if member.name.starts_with("remove_where") {
        var chain_text = Syntax.SourcePrinter().source_expression(object_ast)
        report(
            "'{member.name}' removes from the collection it is called on, and '{chain_text}' makes a new one that nothing keeps: call it on the collection itself, with one test that says everything to remove",
        )
        return void_result()
    }
    steps.reverse()
    var last_callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(object_ast, member.name)
    var call = Syntax.Expressions.CallExpression(last_callee, arguments_ast)
    steps.append(call)
    var saved_counter = temporary_counter
    var probe = generate_expression(base, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var element = chained_element_of(probe_type)
    assert element
    var base_list = chain_class_of(probe_type, element)
    if member.name.starts_with("parallel_each_") {
        var names = step_names_of(steps)
        var parallel = generate_parallel_each(base_list, element, names)
        if not parallel {
            var void_spite_type = void_type()
            return ExpressionResult("0", void_spite_type)
        }
    }
    var owners = List<PassedFunction>()
    var function = fused_function(base_list, element, steps, owners, scope, class_information)
    assert function
    var passed = arguments_ast.copy()
    if is_function_form(member.name, arguments_ast) {
        passed = form_arguments(member.name)
    }
    var owner_index = 0
    while owner_index < owners.count() {
        var owner = owners[owner_index].owner
        passed.append(owner)
        owner_index = owner_index + 1
    }
    var generated_member_object = generate_member_object(base, scope, class_information)
    var receiver = as_text(generated_member_object)
    var receiver_type = receiver.type
    var receiver_dictionary = type_shape.as_dictionary(receiver_type)
    if receiver_dictionary {
        var dictionary_name = ensure_dictionary(receiver_dictionary)
        var empty_types = no_types()
        var list_type = list_type_of(element)
        var no_arguments = List<Syntax.Expressions.Expression>()
        receiver = generate_generic_call(
            "{dictionary_name}_values",
            receiver,
            base,
            no_arguments,
            empty_types,
            list_type,
            scope,
            class_information,
        )
        receiver.owning_override = true
    }
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.return_type
    return generate_generic_call(
        function.c_name,
        receiver,
        base,
        passed,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func fused_function(
    base_list: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    steps: List<Syntax.Expressions.CallExpression>,
    owners: List<PassedFunction>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    var names = step_names_of(steps)
    var last_name = names.last()
    crash last_name
    if last_name.starts_with("parallel_each_") {
        var joined_names = names.join("_then_")
        return base_list.find_function(joined_names)
    }
    var source = fused_chain_source(base_list, element, steps, owners, scope, class_information)
    assert not source.is_empty()
    var name_end = source.index_of("(")
    var fused_name = source.slice(5, name_end)
    var function = base_list.find_function(fused_name)
    if function {
        return function
    }
    return register_fused_function(base_list, source, fused_name)
}

func generate_parallel_each(
    base_list: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    names: List<String>,
): Analysis.FunctionInfo? {
    var fused_name = names.join("_then_")
    var existing = base_list.find_function(fused_name)
    if existing {
        return existing
    }
    var last_name = names.last()
    crash last_name
    var name_length = last_name.length()
    var member_name = last_name.slice(14, name_length)
    var element_label = type_display_name(element)
    var element_class = element_class_of(element)
    if not element_class {
        report(
            "'{last_name}' runs a member of each element on many threads, and '{element_label}' is not a class: only a list of a class has members to run there (write 'each_{member_name}' to run it on one thread)",
        )
        return null
    }
    var loop_lines = List<String>()
    var closings = List<String>()
    var indent = "        "
    var index = 0
    while index < names.count() - 1 {
        var stage_name = names[index]
        if not stage_name.starts_with("filter_") {
            report(
                "'{last_name}' can follow only 'filter_' steps: '{stage_name}' reaches another object, which several elements may share, and a parallel pass may touch only each element's own attributes",
            )
            return null
        }
        var stage_length = stage_name.length()
        var stage_member = stage_name.slice(7, stage_length)
        var stage_read = parallel_filter_read(element_class, stage_member, last_name)
        assert not stage_read.is_empty()
        loop_lines.append("{indent}if item.{stage_read} \{")
        closings.append("{indent}}")
        indent = "{indent}    "
        index = index + 1
    }
    var member = member_function(element_class, member_name)
    if not member {
        if element_class.find_field(member_name) {
            report(
                "'{last_name}': the member '{member_name}' of '{element_label}' is an attribute, but 'parallel_each_' needs a function: reading an attribute and discarding it does nothing",
            )
            return null
        }
        report("'{element_label}' has no zero argument function '{member_name}' for '{last_name}'")
        return null
    }
    var visited = List<String>()
    check_parallel_reach(element_class, member, last_name, visited)
    loop_lines.append("{indent}item.{member_name}()")
    closings.reverse()
    var piece_name = "{fused_name}_piece"
    var piece_lines = List<String>()
    piece_lines.append("func {piece_name}(first: Integer, end: Integer) \{")
    piece_lines.append("    var index = first")
    piece_lines.append("    while index < end \{")
    piece_lines.append("        var item = {chain_item_read(base_list)}")
    piece_lines.append("        index = index + 1")
    append_lines(piece_lines, loop_lines)
    append_lines(piece_lines, closings)
    piece_lines.append("    }")
    piece_lines.append("}")
    piece_lines.append("")
    var piece_source = piece_lines.join("\n")
    var piece = register_fused_function(base_list, piece_source, piece_name)
    assert piece
    var entry_source = "func {fused_name}() \{\n    var pool = ThreadPool()\n    pool.run_pieces({piece_name}, item_count)\n}\n"
    builder.threads = true
    note_fact("flag threads")
    parallel_used = true
    note_fact("flag parallel_used")
    return register_fused_function(base_list, entry_source, fused_name)
}

func parallel_filter_read(element_class: Analysis.ClassInfo, member_name: String, template_name: String): String {
    var field = element_class.find_field(member_name)
    if field {
        var field_type = field.type
        if not is_boolean_type(field_type) {
            report(
                "'{template_name}': the member '{member_name}' of '{element_class.simple_name}' {described_member(field_type)}, but 'filter_' needs it to return Boolean",
            )
            return ""
        }
        return member_name
    }
    var function = member_function(element_class, member_name)
    if not function {
        report(
            "'{element_class.simple_name}' has no attribute or zero argument function '{member_name}' for '{template_name}'",
        )
        return ""
    }
    var returned = function.return_type
    if not is_boolean_type(returned) {
        report(
            "'{template_name}': the member '{member_name}' of '{element_class.simple_name}' {described_member(returned)}, but 'filter_' needs it to return Boolean",
        )
        return ""
    }
    var visited = List<String>()
    check_parallel_reach(element_class, function, template_name, visited)
    return "{member_name}()"
}

func check_parallel_reach(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    template_name: String,
    visited: List<String>,
) {
    assert not visited.contains(function.name)
    visited.append(function.name)
    var locals = function.parameters.map_names()
    collect_declared_names(function.body, locals)
    if template_name.starts_with("Parallel(") and parallel_locked_depth == 0 {
        note_parallel_writes(owner, function.body, locals)
    }
    var locked = List<String>()
    collect_locked_work(owner, function.body, locked)
    var mentioned = List<String>()
    collect_block_names(function.body, mentioned)
    var index = 0
    while index < mentioned.count() {
        var name = mentioned[index]
        if not locals.contains(name) {
            var under_lock = locked.contains(name)
            if under_lock {
                parallel_locked_depth = parallel_locked_depth + 1
            }
            check_parallel_name(owner, function, name, template_name, visited)
            if under_lock {
                parallel_locked_depth = parallel_locked_depth - 1
            }
        }
        index = index + 1
    }
}

func holds_lock(owner: Analysis.ClassInfo, member: Syntax.Expressions.MemberExpression): Boolean {
    crash member.object
    var receiver = shape.as_identifier(member.object)
    if not receiver {
        return false
    }
    var field = owner.find_field(receiver.name)
    if not field {
        return false
    }
    var field_type = field.type
    var held = type_shape.as_class_ref(field_type)
    if not held {
        return false
    }
    var held_class = find_class_by_c_name(held.c_name)
    if not held_class {
        return false
    }
    return held_class.qualified_dotted == "Lock"
}

func collect_locked_work(
    owner: Analysis.ClassInfo,
    statements: List<Syntax.Statements.Statement>,
    locked: List<String>,
) {
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(statements, expressions)
    var index = 0
    while index < expressions.count() {
        var call = shape.as_call(expressions[index])
        if call {
            crash call.callee
            var member = shape.as_member(call.callee)
            if member {
                if member.name == "while_locked" and call.arguments.count() == 1 and holds_lock(owner, member) {
                    var named = shape.as_identifier(call.arguments[0])
                    if named {
                        locked.append(named.name)
                    }
                }
            }
        }
        index = index + 1
    }
}

func note_parallel_writes(
    owner: Analysis.ClassInfo,
    statements: List<Syntax.Statements.Statement>,
    locals: List<String>,
) {
    var roots = List<String>()
    collect_assigned_roots(statements, roots)
    var index = 0
    while index < roots.count() {
        var root = roots[index]
        var field = owner.find_field(root)
        if field and not locals.contains(root) and not parallel_writes.contains(root) {
            var field_type = field.type
            if not reaches_shared(field_type) {
                parallel_writes.append(root)
            }
        }
        index = index + 1
    }
}

func check_parallel_name(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    name: String,
    template_name: String,
    visited: List<String>,
) {
    var field = owner.find_field(name)
    if field {
        var field_type = field.type
        if reaches_shared(field_type) and template_name.starts_with("Parallel(") {
            var no_classes = List<String>()
            if not parallel_handover.is_empty() and kept_by_task_alone(owner, name, field_type, no_classes) {
                if not parallel_keeps.contains(name) {
                    parallel_keeps.append(name)
                }
                return
            }
            report(
                "'{template_name}' runs '{function.name}' on another thread, so it may reach only the attributes of its own '{owner.simple_name}' that hold values, its locals and singletons: '{name}' holds {type_with_article(field_type)}, which another thread may share. Give the work what it needs as numbers or text of its own, or make an object for the work alone that nothing else holds or touches after 'Parallel(...)'",
            )
            return
        }
        if reaches_shared(field_type) and template_name.starts_with("ForeignCallback(") {
            report(
                "'{template_name}' may be called by C on a thread of its own, so '{function.name}' may reach only the attributes of its own '{owner.simple_name}' that hold values, its locals and singletons: '{name}' holds {type_with_article(field_type)}, which another thread may share. Keep it in a singleton the callback calls, which is made safe for threads, or give the callback numbers and text of its own",
            )
            return
        }
        if reaches_shared(field_type) {
            var template_length = template_name.length()
            var one_thread = template_name.slice(9, template_length)
            report(
                "'{template_name}' runs '{function.name}' on many elements at once, so it may reach only its own '{owner.simple_name}' attributes that hold values, and its locals: '{name}' holds a '{type_display_name(field_type)}', which another element may share. Copy what the pass needs into a number or text attribute first, or write '{one_thread}' to run it on one thread",
            )
        }
        return
    }
    var own = owner.find_function(name)
    assert own
    assert not own.is_constructor
    check_parallel_reach(owner, own, template_name, visited)
}

func reaches_shared(spite_type: Analysis.SpiteType): Boolean {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.inner
        return reaches_shared(inner)
    }
    var plain_value = type_shape.as_scalar(spite_type) or type_shape.as_string(spite_type) or is_enum_type(spite_type)
    if plain_value or type_shape.is_symbol(spite_type) {
        return false
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var held = find_class_by_c_name(class_ref.c_name)
        if held {
            return not held.is_singleton and not is_thread_safe_class(held)
        }
    }
    return true
}

func is_thread_safe_class(information: Analysis.ClassInfo): Boolean {
    var shared = ["Lock", "ThreadLocal", "Atomic"]
    return shared.contains(information.qualified_dotted)
}

func check_parallel_work(
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert arguments_ast.count() == 1 and not current_path.starts_with("library/")
    var work = arguments_ast.first()
    var printer = Syntax.SourcePrinter()
    var work_text = printer.source_expression(work)
    var named = shape.as_identifier(work)
    if named {
        assert not scope.lookup_type(named.name)
        var own = class_information.find_function(named.name)
        assert own
        var visited = List<String>()
        check_parallel_reach(class_information, own, "Parallel({work_text})", visited)
        if not parallel_writes.is_empty() and not class_information.is_singleton {
            report_shared_parallel_writes("Parallel({work_text})", class_information, "this")
        }
        parallel_writes = List<String>()
        remember_parallel_site(class_information, own, work_text)
        return
    }
    var member = shape.as_member(work)
    assert member
    crash member.object
    var saved_counter = temporary_counter
    var probe = generate_expression(member.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var owner_ref = type_shape.as_class_ref(probe_type)
    assert owner_ref
    var owner = find_class_by_c_name(owner_ref.c_name)
    assert owner
    var function = owner.find_function(member.name)
    assert function
    var visited = List<String>()
    var task = "Parallel({work_text})"
    parallel_handover = handed_over_name(member.object, owner)
    parallel_keeps = List<String>()
    parallel_writes = List<String>()
    check_parallel_reach(owner, function, task, visited)
    var writes_shared = not parallel_writes.is_empty() and not owner.is_singleton
    if not parallel_keeps.is_empty() or writes_shared and not parallel_handover.is_empty() {
        report_use_after_handover(parallel_handover, task, owner)
    } else if writes_shared {
        var holder = printer.source_expression(member.object)
        report_shared_parallel_writes(task, owner, holder)
    }
    parallel_handover = ""
    parallel_keeps = List<String>()
    parallel_writes = List<String>()
    remember_parallel_site(owner, function, work_text)
}

func report_shared_parallel_writes(task: String, owner: Analysis.ClassInfo, holder: String) {
    var written = parallel_writes.join("', '")
    if holder == "this" {
        report(
            "'{task}' writes '{written}' of this '{owner.simple_name}' on another thread while this thread may write it too, so one write would be lost: move the work into a class of its own and hand a new one over ('var worker = Worker(...)' then 'Parallel(worker.work)'), answer the value from the work and read the task's result, or keep it in a singleton, which is made safe for threads",
        )
        return
    }
    report(
        "'{task}' writes '{written}' of '{holder}' on another thread, and '{holder}' is not handed over to it, so another thread may write it at the same time and one write would be lost: make a new '{owner.simple_name}' on the line before and hand it over ('var worker = {owner.simple_name}(...)' then 'Parallel(worker.work)'), answer the value from the work and read the task's result, or keep it in a singleton, which is made safe for threads",
    )
}

func handed_over_name(object_ast: Syntax.Expressions.Expression, owner: Analysis.ClassInfo): String {
    var named = shape.as_identifier(object_ast)
    if not named {
        return ""
    }
    var name = named.name
    var statements = borrow_statements
    var here = borrow_index
    if here >= statements.count() {
        return ""
    }
    var made_at = -1
    var index = 0
    while index < here {
        var declared = shape.as_variable_declaration(statements[index])
        if declared {
            if declared.name == name and constructs_class(declared.value, owner) {
                made_at = index
            }
        }
        index = index + 1
    }
    if made_at < 0 {
        return ""
    }
    index = made_at + 1
    while index < here {
        if statement_hands_out(statements[index], name, owner) {
            return ""
        }
        index = index + 1
    }
    var function_index = 0
    while function_index < owner.declared_functions.count() {
        var function = owner.declared_functions[function_index]
        if not function.is_constructor and block_keeps_this(function.body, owner) {
            return ""
        }
        function_index = function_index + 1
    }
    return name
}

func block_keeps_this(statements: List<Syntax.Statements.Statement>, information: Analysis.ClassInfo): Boolean {
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(statements, expressions)
    var index = 0
    while index < expressions.count() {
        if expression_keeps_this(expressions[index], information) {
            return true
        }
        index = index + 1
    }
    return false
}

func expression_keeps_this(expression: Syntax.Expressions.Expression, information: Analysis.ClassInfo): Boolean {
    var call = shape.as_call(expression)
    if call {
        crash call.callee
        var member = shape.as_member(call.callee)
        if member {
            var passing = ["each", "filter", "any", "all", "count", "find", "sort_by", "sum", "remove_where"]
            if passing.contains(member.name) {
                crash member.object
                if expression_keeps_this(member.object, information) {
                    return true
                }
                return any_argument_keeps_this(call.arguments, information)
            }
        }
    }
    return expression_uses_this(expression, information)
}

func any_argument_keeps_this(arguments: List<Syntax.Expressions.Expression>, information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var named = shape.as_identifier(argument)
        var own_function = false
        if named {
            if named.name != "this" and named.name != "self" and information.find_function(named.name) {
                own_function = true
            }
        }
        if not own_function and expression_keeps_this(argument, information) {
            return true
        }
        index = index + 1
    }
    return false
}

func constructs_class(value: Syntax.Expressions.Expression?, owner: Analysis.ClassInfo): Boolean {
    if not value {
        return false
    }
    var called = shape.as_call(value)
    if not called {
        return false
    }
    crash called.callee
    return called_name_of(called.callee) == owner.simple_name
}

func report_use_after_handover(name: String, task: String, owner: Analysis.ClassInfo) {
    var statements = borrow_statements
    var index = borrow_index + 1
    var kept = parallel_keeps.join("', '")
    var keeping = "keeps"
    if parallel_keeps.is_empty() {
        kept = parallel_writes.join("', '")
        keeping = "writes"
    }
    while index < statements.count() {
        var statement = statements[index]
        var mentioned = List<String>()
        collect_statement_names(statement, mentioned)
        if mentioned.contains(name) {
            var saved_line = current_line
            current_line = statement_line(statement)
            report(
                "'{name}' was handed to '{task}', which {keeping} its '{kept}' on another thread, so it is not used after that line: make another '{owner.simple_name}' for what follows, or read the task's result",
            )
            current_line = saved_line
            return
        }
        index = index + 1
    }
}

func remember_parallel_site(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo, work_text: String) {
    parallel_site_keys.append("{owner.qualified_dotted}#{function.name}")
    parallel_site_texts.append(work_text)
    parallel_site_places.append("{current_path}\n{current_line}\n{current_owner}\n{current_function}")
}

func report_weak_across_threads() {
    assert not weak_classes.is_empty()
    var index = 0
    while index < parallel_site_keys.count() {
        var keys = List<String>()
        var site_key = parallel_site_keys[index]
        keys.append(site_key)
        var reached = call_effects.reached_classes(keys)
        var weak_name = weak_class_reached(reached)
        if not weak_name.is_empty() {
            crash parallel_site_places[index]
            crash parallel_site_texts[index]
            var site_place = parallel_site_places[index]
            var place = site_place.split("\n")
            crash place.count() >= 4
            current_path = place[0]
            var line_text = place[1]
            var line_number = line_text.to_integer()
            crash line_number
            current_line = line_number
            current_owner = place[2]
            current_function = place[3]
            var work_text = parallel_site_texts[index]
            report(
                "'Parallel({work_text})' runs on another thread, and what it runs reaches '{weak_name}', which is a Weak or is held by one: a Weak is kept in one table that is not shared between threads, so a Weak and the objects it holds stay on the program's own thread. Hold the object itself in the work, or keep the Weak out of what the Parallel reaches",
            )
        }
        index = index + 1
    }
}

# ../../../docs/concurrency.md#the-thread-pool
func report_endless_parallel_work() {
    settle_wait_facts()
    var reported = Dictionary<String, Boolean>()
    var index = 0
    while index < parallel_site_keys.count() {
        var keys = List<String>()
        var site_key = parallel_site_keys[index]
        keys.append(site_key)
        var reached = call_effects.reached_functions(keys)
        var reached_keys = reached.keys()
        var key_index = 0
        while key_index < reached_keys.count() {
            report_endless_work(reached_keys[key_index], index, reported)
            key_index = key_index + 1
        }
        index = index + 1
    }
}

func report_endless_work(key: String, site: Integer, reported: Dictionary<String, Boolean>) {
    assert not reported.has(key)
    reported[key] = true
    var hash = key.index_of("#")
    assert hash > 0
    var class_name = key.slice(0, hash)
    var key_length = key.length()
    var function_name = key.slice(hash + 1, key_length)
    assert not class_name.starts_with("Spite.")
    var information = find_class_by_qualified(class_name)
    assert information
    assert not information.source_path.starts_with("library/")
    var function = information.find_function(function_name)
    assert function
    var line = endless_loop_line(function.body)
    assert line > 0 and not wait_facts.may_wait(function.c_name)
    crash parallel_site_texts[site]
    var work_text = parallel_site_texts[site]
    current_path = information.source_path
    if not function.source_path.is_empty() {
        current_path = function.source_path
    }
    current_owner = information.qualified_dotted
    current_function = function.name
    current_line = line
    report(
        "'Parallel({work_text})' runs '{information.simple_name}.{function.name}' on the thread pool, and this loop never ends and never waits, so the work never finishes and keeps its thread for good: return from the loop once the work is done, or run the loop on the program's own thread",
    )
}

func statement_hands_out(statement: Syntax.Statements.Statement, name: String, holder: Analysis.ClassInfo?): Boolean {
    var assigned = shape.as_assignment_statement(statement)
    if assigned {
        crash assigned.target
        if is_identifier_named(assigned.target, name) {
            return true
        }
    }
    var expressions = List<Syntax.Expressions.Expression>()
    collect_statement_expressions(statement, expressions)
    var index = 0
    while index < expressions.count() {
        if uses_as_value(expressions[index], name, holder) {
            return true
        }
        index = index + 1
    }
    return false
}

func uses_as_value(expression: Syntax.Expressions.Expression, name: String, holder: Analysis.ClassInfo?): Boolean {
    switch expression {
        Syntax.Expressions.IdentifierExpression: return expression.name == name
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            if is_identifier_named(expression.object, name) {
                return not holds_plain_field(holder, expression.name)
            }
            return uses_as_value(expression.object, name, holder)
        }
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var receiver = shape.as_member(expression.callee)
            var called_on_it = false
            if receiver {
                crash receiver.object
                called_on_it = is_identifier_named(receiver.object, name)
            }
            if not called_on_it and uses_as_value(expression.callee, name, holder) {
                return true
            }
            return any_use_as_value(expression.arguments, name, holder)
        }
        Syntax.Expressions.GenericCallExpression: return any_use_as_value(expression.arguments, name, holder)
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if uses_as_value(expression.left, name, holder) {
                return true
            }
            return uses_as_value(expression.right, name, holder)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return uses_as_value(expression.operand, name, holder)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            if not is_identifier_named(expression.object, name) and uses_as_value(expression.object, name, holder) {
                return true
            }
            return uses_as_value(expression.index, name, holder)
        }
        Syntax.Expressions.ListLiteralExpression: {
            var index = 0
            while index < expression.elements.count() {
                var element_value = expression.elements[index].value
                crash element_value
                if uses_as_value(element_value, name, holder) {
                    return true
                }
                index = index + 1
            }
            return false
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            var index = 0
            while index < expression.fields.count() {
                var field_value = expression.fields[index].value
                crash field_value
                if uses_as_value(field_value, name, holder) {
                    return true
                }
                index = index + 1
            }
            return false
        }
        _: return false
    }
}

func any_use_as_value(
    expressions: List<Syntax.Expressions.Expression>,
    name: String,
    holder: Analysis.ClassInfo?,
): Boolean {
    var index = 0
    while index < expressions.count() {
        if uses_as_value(expressions[index], name, holder) {
            return true
        }
        index = index + 1
    }
    return false
}

func holds_plain_field(holder: Analysis.ClassInfo?, name: String): Boolean {
    if not holder {
        return false
    }
    var field = holder.find_field(name)
    if not field {
        return false
    }
    var field_type = field.type
    return not reaches_shared(field_type)
}

func kept_by_task_alone(
    owner: Analysis.ClassInfo,
    name: String,
    field_type: Analysis.SpiteType,
    visited: List<String>,
): Boolean {
    var held = field_type
    var nullable = type_shape.as_nullable(field_type)
    if nullable {
        held = nullable.inner
    }
    if not kept_inside(owner, name, held) {
        return false
    }
    var listed = type_shape.as_list(held)
    if listed {
        var element = listed.element
        return inline_value_type(element)
    }
    var keyed = type_shape.as_dictionary(held)
    if keyed {
        var value_type = keyed.element
        return inline_value_type(value_type)
    }
    var held_class = class_behind(held)
    if not held_class or not type_shape.as_class_ref(held) {
        return false
    }
    return self_contained(held_class, visited)
}

func self_contained(information: Analysis.ClassInfo, visited: List<String>): Boolean {
    if visited.contains(information.c_name) {
        return true
    }
    visited.append(information.c_name)
    if information.source_path.starts_with("library/") or information.is_value_class {
        return false
    }
    var function_index = 0
    while function_index < information.declared_functions.count() {
        var function = information.declared_functions[function_index]
        if not function.is_constructor and block_keeps_this(function.body, information) {
            return false
        }
        function_index = function_index + 1
    }
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        if reaches_shared(field_type) and not kept_by_task_alone(information, field.name, field_type, visited) {
            return false
        }
        index = index + 1
    }
    return true
}

func kept_inside(owner: Analysis.ClassInfo, name: String, held: Analysis.SpiteType): Boolean {
    if call_effects.default_is_shared(owner.qualified_dotted, name) {
        return false
    }
    var written_outside = call_effects.writes_from_outside(owner.qualified_dotted)
    if written_outside.contains(name) {
        return false
    }
    var holder = class_behind(held)
    var function_index = 0
    while function_index < owner.declared_functions.count() {
        var function = owner.declared_functions[function_index]
        if block_hands_out(function.body, name, holder) {
            return false
        }
        function_index = function_index + 1
    }
    return true
}

func block_hands_out(
    statements: List<Syntax.Statements.Statement>,
    name: String,
    holder: Analysis.ClassInfo?,
): Boolean {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if assigns_other_than_fresh(statement, name) or statement_hands_out_value(statement, name, holder) {
            return true
        }
        if blocks_hand_out(statement, name, holder) {
            return true
        }
        index = index + 1
    }
    return false
}

func blocks_hand_out(statement: Syntax.Statements.Statement, name: String, holder: Analysis.ClassInfo?): Boolean {
    switch statement {
        Syntax.Statements.IfStatement: {
            if block_hands_out(statement.then_branch, name, holder) {
                return true
            }
            return block_hands_out(statement.else_branch, name, holder)
        }
        Syntax.Statements.WhileStatement: return block_hands_out(statement.body, name, holder)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                if block_hands_out(statement.cases[case_index].body, name, holder) {
                    return true
                }
                case_index = case_index + 1
            }
            return false
        }
        _: return false
    }
}

func assigns_other_than_fresh(statement: Syntax.Statements.Statement, name: String): Boolean {
    var assigned = shape.as_assignment_statement(statement)
    if not assigned {
        return false
    }
    crash assigned.target
    if not is_identifier_named(assigned.target, name) {
        return false
    }
    crash assigned.value
    return not call_effects.is_fresh_value(assigned.value)
}

func statement_hands_out_value(
    statement: Syntax.Statements.Statement,
    name: String,
    holder: Analysis.ClassInfo?,
): Boolean {
    var expressions = List<Syntax.Expressions.Expression>()
    var assigned = shape.as_assignment_statement(statement)
    if assigned {
        crash assigned.target
        crash assigned.value
        if not is_identifier_named(assigned.target, name) {
            expressions.append(assigned.target)
        }
        expressions.append(assigned.value)
    } else if not holds_blocks(statement) {
        collect_statement_expressions(statement, expressions)
    } else {
        add_block_condition(statement, expressions)
    }
    return any_use_as_value(expressions, name, holder)
}

func add_block_condition(statement: Syntax.Statements.Statement, expressions: List<Syntax.Expressions.Expression>) {
    switch statement {
        Syntax.Statements.IfStatement: add_optional_expression(statement.condition, expressions)
        Syntax.Statements.WhileStatement: add_optional_expression(statement.condition, expressions)
        Syntax.Statements.SwitchStatement: add_optional_expression(statement.subject, expressions)
        _: return
    }
}

func weak_class_reached(reached: Dictionary<String, Boolean>): String {
    var index = 0
    while index < weak_classes.count() {
        var held = find_class_by_c_name(weak_classes[index])
        if held {
            if reached.has(held.qualified_dotted) {
                return held.simple_name
            }
        }
        index = index + 1
    }
    index = 0
    while index < classes.count() {
        var reached_class = classes[index]
        if reached.has(reached_class.qualified_dotted) and not is_library_class(reached_class) {
            var weak_field = weak_field_of(reached_class)
            if not weak_field.is_empty() {
                return weak_field
            }
        }
        index = index + 1
    }
    return ""
}

func weak_field_of(information: Analysis.ClassInfo): String {
    var index = 0
    while index < information.fields.count() {
        var field_type = information.fields[index].type
        var inner = expected_type_without_nullable(field_type)
        var class_ref = type_shape.as_class_ref(inner)
        if class_ref {
            var held = find_class_by_c_name(class_ref.c_name)
            if held {
                if held.qualified_dotted == "Weak" {
                    return "{information.simple_name}.{information.fields[index].name}"
                }
            }
        }
        index = index + 1
    }
    return ""
}

func collect_declared_names(statements: List<Syntax.Statements.Statement>, names: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_statement_declared_names(statements[index], names)
        index = index + 1
    }
}

func collect_statement_declared_names(statement: Syntax.Statements.Statement, names: List<String>) {
    switch statement {
        Syntax.Statements.VariableDeclaration: names.append(statement.name)
        Syntax.Statements.IfStatement: {
            collect_declared_names(statement.then_branch, names)
            collect_declared_names(statement.else_branch, names)
        }
        Syntax.Statements.WhileStatement: collect_declared_names(statement.body, names)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_declared_names(statement.cases[case_index].body, names)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func step_names_of(steps: List<Syntax.Expressions.CallExpression>): List<String> {
    var names = List<String>()
    var index = 0
    while index < steps.count() {
        var callee = steps[index].callee
        crash callee
        var member = shape.as_member(callee)
        crash member
        names.append(member.name)
        index = index + 1
    }
    return names
}

func chain_base(
    expression: Syntax.Expressions.Expression,
    steps: List<Syntax.Expressions.CallExpression>,
): Syntax.Expressions.Expression {
    var called = shape.as_call(expression)
    if called {
        crash called.callee
        var callee = shape.as_member(called.callee)
        if callee {
            if streams(callee.name, called.arguments) {
                steps.append(called)
                crash callee.object
                return chain_base(callee.object, steps)
            }
        }
    }
    return expression
}

func streams(name: String, arguments: List<Syntax.Expressions.Expression>): Boolean {
    if arguments.is_empty() {
        return name.starts_with("map_") or name.starts_with("filter_")
    }
    return arguments.count() == 1 and name == "filter"
}

func chained_element_of(receiver_type: Analysis.SpiteType): Analysis.SpiteType? {
    var listed = type_shape.as_list(receiver_type)
    if listed {
        return listed.element
    }
    var dictionary = type_shape.as_dictionary(receiver_type)
    if dictionary {
        return dictionary.element
    }
    var vector_class = vector_class_of(receiver_type)
    if vector_class {
        return vector_class.codegen_types.first()
    }
    return null
}

func generate_vector_parallel_each(
    vector_class: Analysis.ClassInfo,
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var single = List<String>()
    single.append(name)
    var element = vector_class.codegen_types.first()
    crash element
    var parallel = generate_parallel_each(vector_class, element, single)
    if not parallel {
        var void_spite_type = void_type()
        return ExpressionResult("0", void_spite_type)
    }
    var empty_types = no_types()
    var no_arguments = List<Syntax.Expressions.Expression>()
    var nothing_returned = parallel.return_type
    return generate_generic_call(
        parallel.c_name,
        object_result,
        object_ast,
        no_arguments,
        empty_types,
        nothing_returned,
        scope,
        class_information,
    )
}

func vector_class_of(receiver_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var found = class_behind(receiver_type)
    assert found
    assert found.qualified_dotted == "Vector" or found.qualified_dotted == "Items"
    assert not found.codegen_types.is_empty()
    return found
}

func vector_kind(vector_class: Analysis.ClassInfo): String {
    if is_items_class(vector_class) {
        return "an Items"
    }
    return "a Vector"
}

func unpassed_value_miss(vector_class: Analysis.ClassInfo, name: String): String {
    crash vector_class.codegen_types[0]
    var item_type = vector_class.codegen_types[0]
    if inline_item_class(item_type) {
        return ""
    }
    var label = type_display_name(item_type)
    return "'{name}' passes each item to a function, which {vector_kind(vector_class)} never does: keep the values in a 'List<{label}>' to pass them on"
}

func items_form_miss(items_class: Analysis.ClassInfo, name: String): String {
    crash items_class.codegen_types[0]
    var label = type_display_name(items_class.codegen_types[0])
    var advice = "give the item's class a function and call it with a member template, such as '{name}_<function>()'"
    if items_fit_vector(items_class) {
        return "'{name}' passes each item to a function, and '{label}' fits a Vector, so an item of these Items is borrowed from them, never passed on: {advice}"
    }
    return "'{name}' passes each item to a function, which Items does not do whichever storage it chose, since an item that fits a Vector is borrowed and never passed on: {advice}"
}

func chain_class_of(receiver_type: Analysis.SpiteType, element: Analysis.SpiteType): Analysis.ClassInfo {
    var vector_class = vector_class_of(receiver_type)
    if vector_class {
        return vector_class
    }
    return list_class_of(element)
}

func chain_item_read(base_list: Analysis.ClassInfo): String {
    if base_list.qualified_dotted == "Vector" {
        return "values.item_at(items, index)"
    }
    if not is_items_class(base_list) {
        return "values.read_value(items, index)"
    }
    if items_fit_vector(base_list) {
        return "inline.item_at(items, index)"
    }
    return "references.read_value(items, index)"
}

func fused_step(
    base_list: Analysis.ClassInfo,
    current_type: Analysis.SpiteType,
    call: Syntax.Expressions.CallExpression,
    owners: List<PassedFunction>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): FusedStep? {
    crash call.callee
    var callee = shape.as_member(call.callee)
    assert callee
    var name = callee.name
    if is_function_form(name, call.arguments) {
        var inline_items = base_list.qualified_dotted == "Vector" or is_items_class(base_list)
        assert not inline_items or plain_item_type(current_type)
        var argument = call.arguments.first()
        var passed = resolve_passed_function(argument, scope, class_information)
        assert passed
        var problem = passed_function_problem(name, argument, passed, current_type)
        assert problem.is_empty()
        var owner_count = owners.count()
        var fused_owner = fused_owner_name(owner_count)
        var owner_type = passed.owner_type
        assert not fused_owner.is_empty() and not fused_type_spelling(owner_type).is_empty()
        owners.append(passed)
        var passed_returned = passed.returned
        var step_prefix = form_prefix(name)
        var step = FusedStep(step_prefix, passed_returned, passed.function_name)
        step.owner_name = fused_owner
        return step
    }
    var template = element_template_of(base_list, name)
    assert template
    var step_member_names = element_member_names(current_type)
    var member_name = template_member_name(template, name, step_member_names)
    var element_class = element_class_of(current_type)
    assert element_class
    var member_type = member_type_of(element_class, member_name)
    assert member_type
    var is_field = is_field_of(element_class, member_name)
    var requirement = member_requirement(template.prefix, is_field, member_name, member_type)
    assert requirement.is_empty()
    var read = member_name
    if not is_field {
        var function = member_function(element_class, member_name)
        crash function
        if function.name == member_name {
            read = "{member_name}()"
        }
    }
    return FusedStep(template.prefix, member_type, read)
}

func fused_step_name(
    call: Syntax.Expressions.CallExpression,
    owners: List<PassedFunction>,
    owner_index: Integer,
): String {
    crash call.callee
    var callee = shape.as_member(call.callee)
    crash callee
    if not is_function_form(callee.name, call.arguments) {
        return callee.name
    }
    crash owner_index < owners.count()
    return "{callee.name}_{owners[owner_index].label}"
}

func fused_owner_name(owner_count: Integer): String {
    var names = ["owner", "second_owner", "third_owner", "fourth_owner", "fifth_owner", "sixth_owner"]
    if owner_count < names.count() {
        return names[owner_count]
    }
    return ""
}

func fused_type_spelling(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        if class_ref.has_signature {
            return fused_signature_spelling(class_ref)
        }
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return described.qualified_dotted
        }
        return ""
    }
    if type_shape.as_string(spite_type) or type_shape.as_scalar(spite_type) {
        return type_display_name(spite_type)
    }
    return ""
}

func fused_signature_spelling(signature: Analysis.Types.ClassRefType): String {
    var spellings = List<String>()
    var index = 0
    while index < signature.arguments.count() {
        var spelling = fused_type_spelling(signature.arguments[index])
        if spelling.is_empty() {
            return ""
        }
        spellings.append(spelling)
        index = index + 1
    }
    var returned = returned_type(signature)
    var returned_spelling = fused_type_spelling(returned)
    if returned_spelling.is_empty() {
        return ""
    }
    spellings.append(returned_spelling)
    return "Spite.Function<{spellings.join(", ")}>"
}

func fused_value_name(mapped_count: Integer): String {
    var names = ["mapped", "second_mapped", "third_mapped", "fourth_mapped", "fifth_mapped", "sixth_mapped"]
    if mapped_count < names.count() {
        return names[mapped_count]
    }
    return ""
}

func fused_chain_source(
    base_list: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    steps: List<Syntax.Expressions.CallExpression>,
    owners: List<PassedFunction>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var loop_lines = List<String>()
    var current_type = element
    var current_name = "item"
    var indent = "        "
    var closings = List<String>()
    var mapped_count = 0
    var step_names = List<String>()
    var index = 0
    while index < steps.count() - 1 {
        var owner_count = owners.count()
        var step = fused_step(base_list, current_type, steps[index], owners, scope, class_information)
        if not step {
            return ""
        }
        crash steps[index]
        var step_name = fused_step_name(steps[index], owners, owner_count)
        step_names.append(step_name)
        var stage_read = step.read_of(current_name)
        if step.prefix == "filter_" {
            loop_lines.append("{indent}if {stage_read} \{")
            closings.append("{indent}}")
            indent = "{indent}    "
        } else {
            var mapped_type = step.member_type
            var next_name = fused_value_name(mapped_count)
            if next_name.is_empty() or fused_type_spelling(mapped_type).is_empty() {
                return ""
            }
            loop_lines.append("{indent}var {next_name} = {stage_read}")
            mapped_count = mapped_count + 1
            current_name = next_name
            current_type = mapped_type
        }
        index = index + 1
    }
    var owner_count = owners.count()
    var last_call = steps.last()
    crash last_call
    var last = fused_step(base_list, current_type, last_call, owners, scope, class_information)
    if not last {
        return ""
    }
    var last_step_name = fused_step_name(last_call, owners, owner_count)
    step_names.append(last_step_name)
    var last_member_type = last.member_type
    var element_spelling = fused_type_spelling(current_type)
    var member_spelling = fused_type_spelling(last_member_type)
    var read = last.read_of(current_name)
    var collection_base = base_list.qualified_dotted == "Vector" or is_items_class(base_list)
    if collection_base and current_name == "item" {
        if last.prefix == "sort_by_" {
            return ""
        }
        if last.prefix == "find_by_" and holds_items_inline(base_list) {
            return ""
        }
    }
    var fused_name = step_names.join("_then_")
    var parameters = List<String>()
    var returns = ""
    var before = List<String>()
    var after = List<String>()
    if last.prefix == "sum_" {
        returns = ": {member_spelling}"
        before.append("    var total: {member_spelling} = 0")
        loop_lines.append("{indent}total = total + {read}")
        after.append("    return total")
    } else if last.prefix == "count_" {
        returns = ": Integer"
        before.append("    var counted = 0")
        loop_lines.append("{indent}if {read} \{\n{indent}    counted = counted + 1\n{indent}}")
        after.append("    return counted")
    } else if last.prefix == "any_" {
        returns = ": Boolean"
        loop_lines.append("{indent}if {read} \{\n{indent}    return true\n{indent}}")
        after.append("    return false")
    } else if last.prefix == "all_" {
        returns = ": Boolean"
        loop_lines.append("{indent}if not {read} \{\n{indent}    return false\n{indent}}")
        after.append("    return true")
    } else if last.prefix == "find_by_" {
        parameters.append("value: {member_spelling}")
        returns = ": {element_spelling}?"
        loop_lines.append("{indent}if {read} == value \{\n{indent}    return {current_name}\n{indent}}")
        after.append("    return null")
    } else if last.prefix == "each_" {
        loop_lines.append("{indent}{read}")
    } else if last.prefix == "map_" {
        returns = ": List<{member_spelling}>"
        before.append("    var collected = List<{member_spelling}>()")
        loop_lines.append("{indent}var value = {read}\n{indent}collected.append(value)")
        after.append("    return collected")
    } else if last.prefix == "filter_" and base_list.qualified_dotted == "Vector" and current_name == "item" {
        returns = ": Vector<{element_spelling}>"
        before.append("    var collected = Vector<{element_spelling}>()")
        loop_lines.append("{indent}if {read} \{\n{indent}    collected._append_copy(items, index - 1)\n{indent}}")
        after.append("    return collected")
    } else if last.prefix == "filter_" and is_items_class(base_list) and current_name == "item" {
        returns = ": Items<{element_spelling}>"
        before.append("    var collected = Items<{element_spelling}>()")
        loop_lines.append("{indent}if {read} \{\n{indent}    collected._append_copy(items, index - 1)\n{indent}}")
        after.append("    return collected")
    } else if last.prefix == "filter_" {
        returns = ": List<{element_spelling}>"
        before.append("    var collected = List<{element_spelling}>()")
        loop_lines.append("{indent}if {read} \{\n{indent}    collected.append({current_name})\n{indent}}")
        after.append("    return collected")
    } else if last.prefix == "sort_by_" {
        returns = ": List<{element_spelling}>"
        before.append("    var sorted = List<{element_spelling}>()")
        before.append("    var keys = List<{member_spelling}>()")
        loop_lines.append(
            "{indent}var key = {read}\n{indent}var previous = keys.count() - 1\n{indent}while previous >= 0 and previous < keys.count() and keys[previous] > key \{\n{indent}    previous = previous - 1\n{indent}}\n{indent}keys.insert(previous + 1, key)\n{indent}sorted.insert(previous + 1, {current_name})",
        )
        after.append("    return sorted")
    } else {
        return ""
    }
    var voided = type_shape.is_void(last_member_type)
    if element_spelling.is_empty() or member_spelling.is_empty() and not voided {
        return ""
    }
    var owner_index = 0
    while owner_index < owners.count() {
        var owner_type = owners[owner_index].owner_type
        parameters.append("{fused_owner_name(owner_index)}: {fused_type_spelling(owner_type)}")
        owner_index = owner_index + 1
    }
    closings.reverse()
    var lines = List<String>()
    lines.append("func {fused_name}({parameters.join(", ")}){returns} \{")
    append_lines(lines, before)
    lines.append("    var index = 0")
    lines.append("    while index < item_count \{")
    lines.append("        var item = {chain_item_read(base_list)}")
    lines.append("        index = index + 1")
    append_lines(lines, loop_lines)
    append_lines(lines, closings)
    lines.append("    }")
    append_lines(lines, after)
    lines.append("}")
    lines.append("")
    return lines.join("\n")
}

func is_function_form(name: String, arguments: List<Syntax.Expressions.Expression>): Boolean {
    var forms = ["each", "filter", "any", "all", "count", "find", "sort_by", "sum", "remove_where"]
    return arguments.count() == 1 and forms.contains(name)
}

func form_prefix(name: String): String {
    if name == "find" {
        return "find_by_"
    }
    return "{name}_"
}

func form_arguments(name: String): List<Syntax.Expressions.Expression> {
    var arguments = List<Syntax.Expressions.Expression>()
    if name == "find" {
        var found: Syntax.Expressions.Expression = Syntax.Expressions.TrueLiteral()
        arguments.append(found)
    }
    return arguments
}

func resolve_passed_function(
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): PassedFunction? {
    var bound = bound_function_of(argument, scope, class_information)
    if bound {
        return bound
    }
    var saved_counter = temporary_counter
    var probe = generate_expression(argument, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var signature = type_shape.as_class_ref(probe_type)
    assert signature
    assert signature.has_signature
    var returned = void_type()
    var returns_nothing = false
    if signature.returns {
        var returns_class = type_shape.as_class_ref(signature.returns)
        if returns_class {
            returns_nothing = returns_class.c_name == "Nothing"
        }
        if not returns_nothing {
            returned = signature.returns
        }
    }
    var passed = PassedFunction(argument, probe_type, "", returned)
    passed.parameter_types = signature.arguments
    var returned_c_name = c_type_name(returned)
    passed.label = "function_value_{identifier_text(returned_c_name)}"
    return passed
}

func bound_function_of(
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): PassedFunction? {
    var identifier = shape.as_identifier(argument)
    if identifier {
        assert not scope.lookup_type(identifier.name) and not class_information.find_field(identifier.name)
        var own: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("self")
        return passed_member_function(own, class_information, identifier.name)
    }
    var member = shape.as_member(argument)
    assert member
    crash member.object
    assert not try_resolve_static_path(member.object, class_information.qualified_dotted)
    var saved_counter = temporary_counter
    var probe = generate_expression(member.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var listed = type_shape.as_list(probe_type)
    if listed {
        var listed_element = listed.element
        var list_class = list_class_of(listed_element)
        return passed_library_function(member.object, probe_type, list_class, member.name)
    }
    var owner_ref = type_shape.as_class_ref(probe_type)
    if not owner_ref {
        var library_class = class_of_type(probe_type)
        assert library_class
        return passed_library_function(member.object, probe_type, library_class, member.name)
    }
    assert not owner_ref.has_signature
    var owner_class = find_class_by_c_name(owner_ref.c_name)
    assert owner_class
    assert not owner_class.find_field(member.name)
    return passed_member_function(member.object, owner_class, member.name)
}

func passed_member_function(
    owner: Syntax.Expressions.Expression,
    owner_class: Analysis.ClassInfo,
    name: String,
): PassedFunction? {
    assert not owner_class.is_value_class and not owner_class.is_generic_template and owner_class.codegen_names.is_empty()
    var function = find_or_instantiate_function(owner_class, name)
    assert function
    assert not function.is_constructor
    report_lending_value(owner_class, function)
    var owner_type: Analysis.SpiteType = Analysis.Types.ClassRefType(owner_class.c_name)
    var returned = function.return_type
    var passed = PassedFunction(owner, owner_type, name, returned)
    passed.parameter_types = parameter_types_of(function.parameters)
    passed.label = "{name}_for_{owner_class.c_name.lower_case()}"
    return passed
}

func passed_library_function(
    owner: Syntax.Expressions.Expression,
    owner_type: Analysis.SpiteType,
    library_class: Analysis.ClassInfo,
    name: String,
): PassedFunction? {
    assert not name.starts_with("_")
    var function = find_or_instantiate_function(library_class, name)
    assert function
    assert not function.is_constructor
    var returned = function.return_type
    var passed = PassedFunction(owner, owner_type, name, returned)
    passed.parameter_types = parameter_types_of(function.parameters)
    passed.label = "{name}_for_{library_class.c_name.lower_case()}"
    return passed
}

func identifier_text(text: String): String {
    var kept = List<String>()
    var index = 0
    while index < text.length() {
        if is_attribute_name_code(text, index) {
            var kept_character = text.slice(index, index + 1)
            kept.append(kept_character)
        }
        index = index + 1
    }
    var joined = kept.join("")
    return joined.lower_case()
}

func passed_function_problem(
    name: String,
    argument: Syntax.Expressions.Expression,
    passed: PassedFunction,
    element: Analysis.SpiteType,
): String {
    var label = Syntax.SourcePrinter().source_expression(argument)
    var element_label = type_display_name(element)
    var parameter_count = passed.parameter_types.count()
    if parameter_count != 1 {
        return "'{name}' calls '{label}' with each '{element_label}' as its only argument, but '{label}' takes {parameter_count}"
    }
    var parameter_type = passed.parameter_types.first()
    if not types_equal(parameter_type, element) {
        return "'{name}' calls '{label}' with each '{element_label}', but '{label}' takes '{type_display_name(parameter_type)}'"
    }
    var returned = passed.returned
    var requirement = form_requirement(name, label, returned)
    if requirement.is_empty() {
        return ""
    }
    var described = described_member(returned)
    if type_shape.as_nullable(returned) {
        described = "returns {type_with_article(returned)}"
    }
    return "'{name}({label})': '{label}' {described}, but '{name}' needs it to {requirement}"
}

func form_requirement(name: String, label: String, returned: Analysis.SpiteType): String {
    var tests = ["filter", "any", "all", "count", "find", "remove_where"]
    if tests.contains(name) and not is_boolean_type(returned) {
        if name == "count" and is_numeric_type(returned) {
            return "return Boolean (to add up what it returns use 'sum({label})')"
        }
        return "return Boolean"
    }
    if name == "sum" and not is_numeric_type(returned) {
        return "return a numeric type"
    }
    var ordered = is_numeric_type(returned) or type_shape.as_string(returned)
    if name == "sort_by" and type_shape.as_nullable(returned) {
        return "return something ordered, a number or a String, and a value that may be null has no place in the order: pass a function of your own that narrows it and returns the plain value"
    }
    if name == "sort_by" and not ordered {
        return "return something ordered: a number or a String"
    }
    return ""
}

func function_form_instance(
    list_class: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    name: String,
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): PassedFunction? {
    var passed = resolve_passed_function(argument, scope, class_information)
    if not passed {
        var argument_member = shape.as_member(argument)
        if argument_member {
            var qualified = class_qualified_function_message(argument_member, class_information)
            assert qualified.is_empty()
        }
        var printed = Syntax.SourcePrinter().source_expression(argument)
        report(
            "'{name}' takes a function to call with each element, such as '{name}(say_hello)' or '{name}(greeter.say_hello)', and '{printed}' is not one",
        )
        return null
    }
    var problem = passed_function_problem(name, argument, passed, element)
    if not problem.is_empty() {
        report(problem)
        return null
    }
    var prefix = form_prefix(name)
    var template = template_with_prefix(list_class, prefix)
    crash template
    var instance_name = "{prefix}{passed.label}"
    var existing = list_class.find_function(instance_name)
    if existing {
        passed.instance = existing
        return passed
    }
    var owner_type = passed.owner_type
    var owner_c_name = "Spite_Function"
    var owner_ref = type_shape.as_class_ref(owner_type)
    if owner_ref {
        if not owner_ref.has_signature {
            owner_c_name = owner_ref.c_name
        }
    }
    var passed_returned = passed.returned
    passed.instance = instantiate_template(
        list_class,
        template,
        passed.function_name,
        passed_returned,
        owner_c_name,
        instance_name,
        owner_type,
    )
    return passed
}

func template_with_prefix(list_class: Analysis.ClassInfo, prefix: String): Analysis.TemplateInfo? {
    var index = 0
    while index < list_class.templates.count() {
        var template = list_class.templates[index]
        if template.prefix == prefix and template.suffix.is_empty() and template.range {
            return template
        }
        index = index + 1
    }
    return null
}

func generate_function_form(
    list_class: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    name: String,
    receiver: ExpressionResult,
    receiver_ast: Syntax.Expressions.Expression,
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var passed = function_form_instance(list_class, element, name, argument, scope, class_information)
    if not passed {
        return void_result()
    }
    var function = passed.instance
    var passed_arguments = form_arguments(name)
    var owner = passed.owner
    passed_arguments.append(owner)
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.return_type
    return generate_generic_call(
        function.c_name,
        receiver,
        receiver_ast,
        passed_arguments,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func append_lines(lines: List<String>, added: List<String>) {
    var index = 0
    while index < added.count() {
        var line = added[index]
        lines.append(line)
        index = index + 1
    }
}

func register_fused_function(
    base_list: Analysis.ClassInfo,
    source: String,
    fused_name: String,
): Analysis.FunctionInfo? {
    var lexer = Syntax.Lexer(source)
    var parser = Syntax.Parser(lexer.tokens)
    var file = parser.parse_file()
    assert not lexer.has_error and not parser.has_error and not file.statements.is_empty()
    var first_statement = file.statements.first()
    var declaration = shape.as_function_declaration(first_statement)
    assert declaration
    declaration.source_path = base_list.source_path
    var saved_owner = current_owner
    var saved_class = current_class
    var saved_path = current_path
    var saved_line = current_line
    var saved_function = current_function
    current_owner = base_list.qualified_dotted
    current_class = base_list
    current_path = base_list.source_path
    resolve_function(declaration, base_list)
    current_owner = saved_owner
    current_class = saved_class
    current_path = saved_path
    current_line = saved_line
    current_function = saved_function
    var function = base_list.find_function(fused_name)
    if function {
        builder.add_prototype("{function_signature(base_list, function)};")
    }
    return function
}

func is_listed_class(information: Analysis.ClassInfo): Boolean {
    if information.is_generic_template {
        return false
    }
    if information.c_name.starts_with("Object_") or information.c_name.starts_with("Spite_") {
        return false
    }
    var prelude_path = Prelude().path()
    if information.source_path.starts_with("library/") or information.source_path.starts_with("launcher/") {
        return false
    }
    if information.source_path == prelude_path {
        return false
    }
    return information.c_name != "Nothing"
}

func describes_members(information: Analysis.ClassInfo): Boolean {
    if information.is_generic_template or information.is_value_class {
        return false
    }
    if information.c_name.starts_with("Object_") {
        return false
    }
    return information.c_name != "Nothing"
}

func folded_source_folder(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    crash member.object
    var asked = source_folder_class(member.object, scope, class_information)
    assert asked
    var folder = absolute_source_folder(asked)
    var folder_code = render_string_literal(folder)
    var text_type = string_type()
    return ExpressionResult(folder_code, text_type)
}

func source_folder_class(
    object: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var identifier = shape.as_identifier(object)
    if identifier {
        if identifier.name == "class" {
            return class_information
        }
    }
    var generic_identifier = shape.as_generic_identifier(object)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var bound = codegen_index(class_information, bare_name)
        assert bound >= 0
        crash class_information.codegen_types[bound]
        var bound_class_ref = type_shape.as_class_ref(class_information.codegen_types[bound])
        assert bound_class_ref
        return find_class_by_c_name(bound_class_ref.c_name)
    }
    var read = shape.as_member(object)
    if read {
        if is_symbol_class_read(object) {
            crash bound_field_type
            var walked_ref = type_shape.as_class_ref(bound_field_type)
            assert walked_ref
            return find_class_by_c_name(walked_ref.c_name)
        }
        if read.name == "class" {
            crash read.object
            var saved_counter = temporary_counter
            var probe = generate_expression(read.object, scope, class_information)
            rewind_temporaries(saved_counter)
            var probe_type = probe.type
            var probe_ref = type_shape.as_class_ref(probe_type)
            assert probe_ref
            assert not probe_ref.has_signature
            return find_class_by_c_name(probe_ref.c_name)
        }
    }
    var named = try_resolve_static_path(object, class_information.qualified_dotted)
    assert named
    assert not named.find_function("source_folder")
    return named
}

func absolute_source_folder(information: Analysis.ClassInfo): String {
    var path = information.source_path.replace("\\", "/")
    var base = working_folder.replace("\\", "/")
    if path.starts_with("library/") or path.starts_with("launcher/") {
        base = language_folder.replace("\\", "/")
    }
    var joined = "{base}/{path}"
    if path.starts_with("/") or path.slice(1, 2) == ":" {
        joined = path
    }
    return normalized_folder(joined)
}

func normalized_folder(joined: String): String {
    var segments = joined.split("/")
    segments.remove_last()
    var kept = List<String>()
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        if segment == ".." {
            kept.remove_last()
        } else if segment != "." and not segment.is_empty() {
            kept.append(segment)
        }
        index = index + 1
    }
    var folder = kept.join("/")
    if joined.starts_with("/") {
        return "/{folder}"
    }
    return folder
}

func attribute_declaration_list_name(): String {
    var declaration_class = find_class_by_c_name("Spite_AttributeDeclaration")
    crash declaration_class
    var class_type = class_type_of(declaration_class)
    return ensure_list(class_type)
}

func ensure_attribute_declarations(information: Analysis.ClassInfo): String {
    var function_c_name = "spite_attribute_declarations_{information.c_name}"
    if attributes_function_names.contains(function_c_name) {
        return function_c_name
    }
    attributes_function_names.append(function_c_name)
    var list_name = attribute_declaration_list_name()
    var lines = List<String>()
    lines.append("{list_name}* {function_c_name}(void) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    var collection = information.qualified_dotted == "List" or information.qualified_dotted == "Dictionary"
    var index = 0
    while index < information.fields.count() and not information.is_value_class and not collection {
        var field = information.fields[index]
        var field_type = field.type
        lines.append(
            "\{ Spite_AttributeDeclaration* declared = Spite_AttributeDeclaration___make({ensure_symbol(field.name)}, {class_object_call(field_type)});",
        )
        lines.append("declared->_index_ = {index};")
        lines.append("{list_name}_append(result, declared); }")
        index = index + 1
    }
    lines.append("return result;")
    lines.append("}")
    builder.add_prototype("{list_name}* {function_c_name}(void);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func functions_readers(class_object: String): String {
    return "{class_object} & Spite_Class_get_functions Spite_Class_has_function Spite_Class_function_waits Spite_Class_argument_count"
}

func emit_class_object_bodies() {
    while class_objects_emitted < class_object_names.count() {
        var position = class_objects_emitted
        class_objects_emitted = class_objects_emitted + 1
        crash class_object_names[position]
        var function_c_name = class_object_names[position]
        crash class_object_labels[position]
        var described = find_class_by_c_name(class_object_labels[position])
        var refitted = ""
        if described and is_hot_class(described) {
            refitted = "{function_c_name}_cache->_fits_vector_ = (*{described.c_name}___layout_now())->fits != 0;"
        }
        var lines = List<String>()
        lines.append("Spite_Class* {function_c_name}(void) \{")
        if not refitted.is_empty() {
            lines.append(
                "if (SPITE_SINGLETON_FOUND({function_c_name}_ready)) \{ {refitted} return Spite_Class___retain({function_c_name}_cache); }",
            )
        } else {
            lines.append(
                "if (SPITE_SINGLETON_FOUND({function_c_name}_ready)) return Spite_Class___retain({function_c_name}_cache);",
            )
        }
        lines.append("spite_described_enter();")
        lines.append("if ({function_c_name}_cache == 0) \{")
        crash class_object_displays[position]
        lines.append("{function_c_name}_cache = Spite_Class___make({ensure_symbol(class_object_displays[position])});")
        var kind = class_object_kinds[function_c_name]
        if run_time_kinds_used and kind {
            lines.append("{function_c_name}_cache->_{kind}_ = true;")
        }
        if described {
            if run_time_kinds_used {
                var visited = List<String>()
                if class_has_state(described, visited) {
                    lines.append("{function_c_name}_cache->_stateful_ = true;")
                }
            }
            if described.is_singleton {
                lines.append("{function_c_name}_cache->_singleton_ = true;")
            }
            if not refitted.is_empty() {
                lines.append(refitted)
            } else if class_fits_vector(described) {
                lines.append("{function_c_name}_cache->_fits_vector_ = true;")
            }
            if source_folder_used {
                var described_folder = absolute_source_folder(described)
                lines.append("{function_c_name}_cache->_source_folder_ = {render_string_literal(described_folder)};")
            }
            if source_paths_used {
                emit_source_paths(lines, "{function_c_name}_cache", described.source_paths, false)
            }
            if namespace_read_used {
                crash class_object_namespaces[position]
                var described_namespace = class_object_namespaces[position]
                if not described_namespace.is_empty() {
                    lines.append(
                        "{function_c_name}_cache->_namespace_ = {ensure_namespace_object(described_namespace)}();",
                    )
                }
            }
            if class_level_attributes_used and describes_members(described) {
                var declarations_function = ensure_attribute_declarations(described)
                var attribute_list_name = attribute_declaration_list_name()
                lines.append("{attribute_list_name}___release({function_c_name}_cache->_attributes_);")
                lines.append("{function_c_name}_cache->_attributes_ = {declarations_function}();")
            }
            if class_level_functions_used and describes_members(described) and described.c_name != entry_class_c_name {
                var functions_function = ensure_functions_function(described)
                var maker = "{described.c_name}___default()"
                var thunk = "spite_class_functions_{described.c_name}"
                var listed_class = find_class_by_c_name("Spite_Function")
                crash listed_class
                var class_type = class_type_of(listed_class)
                var listed_name = ensure_list(class_type)
                class_type = class_type_of(listed_class)
                var list_type = list_type_of(class_type)
                var listed_c_type = c_type_name(list_type)
                builder.add_prototype("{listed_c_type} {thunk}(void);")
                var kept_code = kept_stand_in(described, thunk)
                builder.add_support(
                    "{listed_c_type} {thunk}(void) \{\n{described.c_name}* fresh = {maker};\n{untracked_stand_in(described)}\n{listed_c_type} listed = {functions_function}(fresh);\n{kept_code}\nreturn listed;\n}",
                )
                var filled = "{listed_name}___release({function_c_name}_cache->_functions_);\n{function_c_name}_cache->_functions_ = {thunk}();"
                var readers = functions_readers(function_c_name)
                var filled_if_read = builder.placeholder_if_kept(readers, filled, "")
                lines.append(filled_if_read)
            }
            if class_level_functions_used and describes_members(described) and described.c_name == entry_class_c_name {
                var unbound_function = ensure_functions_function(described)
                entry_functions_cache = "{function_c_name}_cache"
                var unbound = "{entry_functions_cache}->_unbound_functions_ = {unbound_function}(0);"
                var unbound_readers = functions_readers(function_c_name)
                var unbound_if_read = builder.placeholder_if_kept(unbound_readers, unbound, "")
                lines.append(unbound_if_read)
            }
        }
        lines.append("}")
        lines.append("spite_described_leave(&{function_c_name}_ready);")
        lines.append("return Spite_Class___retain({function_c_name}_cache);")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
}

func singleton_destroyed(information: Analysis.ClassInfo): String {
    var lines = List<String>()
    lines.append("void {information.c_name}___destroy({information.c_name}* self) \{")
    lines.append("if (self == 0) return;")
    if information.drop_function {
        lines.append("{information.drop_function.c_name}(self);")
    }
    lines.append("{information.c_name}___discard(self);")
    lines.append("}")
    return lines.join("\n")
}

func untracked_stand_in(described: Analysis.ClassInfo): String {
    return "#ifdef SPITE_TRACKS_{described.c_name}\nspite_untrack_{described.c_name}(fresh);\n#endif"
}

func released_stand_in(described: Analysis.ClassInfo): String {
    if described.is_singleton and not described.is_stateless_singleton {
        return "{described.c_name}___discard(fresh);"
    }
    return "{described.c_name}___release(fresh);"
}

func kept_stand_in(described: Analysis.ClassInfo, thunk: String): String {
    if not described.is_singleton or described.is_stateless_singleton {
        return "{described.c_name}___release(fresh);"
    }
    var kept = "{thunk}_stand_in"
    builder.add_support(
        "static {described.c_name}* {kept} = 0;\nstatic void {kept}_teardown(void) \{\n{described.c_name}___discard({kept});\n{kept} = 0;\n}",
    )
    return "{kept} = fresh;\nspite_singleton_created({kept}_teardown);"
}

func emit_all_classes_function() {
    assert all_classes_used
    var class_class = find_class_by_c_name("Spite_Class")
    assert class_class
    var class_type = class_type_of(class_class)
    var list_name = ensure_list(class_type)
    var lines = List<String>()
    lines.append("{list_name}* spite_all_classes(void) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    var index = 0
    while index < classes.count() {
        if is_listed_class(classes[index]) {
            var listed_class_type = class_type_of(classes[index])
            lines.append("{list_name}_append(result, {class_object_call(listed_class_type)});")
        }
        index = index + 1
    }
    lines.append("return result;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func ensure_live_instances(information: Analysis.ClassInfo): String {
    var name = information.c_name
    var function_c_name = "{name}___instances"
    if tracked_class_names.contains(name) {
        return function_c_name
    }
    tracked_class_names.append(name)
    var class_type = class_type_of(information)
    var list_name = ensure_list(class_type)
    var registry = "spite_instances_{name}"
    builder.add_typedef(
        "#define SPITE_TRACKS_{name}\nstatic {name}** {registry} = 0;\nstatic int64_t {registry}_count = 0;\nstatic int64_t {registry}_capacity = 0;",
    )
    builder.add_prototype("void spite_track_{name}({name}* self);")
    builder.add_prototype("void spite_untrack_{name}({name}* self);")
    builder.add_prototype("{list_name}* {function_c_name}(void);")
    builder.add_support(
        "void spite_track_{name}({name}* self) \{\nif ({registry}_count == {registry}_capacity) \{\n{registry}_capacity = {registry}_capacity == 0 ? 8 : {registry}_capacity * 2;\n{registry} = ({name}**)realloc({registry}, (size_t){registry}_capacity * sizeof({name}*));\n}\n{registry}[{registry}_count] = self;\n{registry}_count = {registry}_count + 1;\n}",
    )
    builder.add_support(
        "void spite_untrack_{name}({name}* self) \{\nfor (int64_t spite_index = 0; spite_index < {registry}_count; spite_index = spite_index + 1) \{\nif ({registry}[spite_index] == self) \{\nfor (int64_t spite_shift = spite_index; spite_shift < {registry}_count - 1; spite_shift = spite_shift + 1) \{ {registry}[spite_shift] = {registry}[spite_shift + 1]; }\n{registry}_count = {registry}_count - 1;\nreturn;\n}\n}\n}",
    )
    builder.add_support(
        "{list_name}* {function_c_name}(void) \{\n{list_name}* result = {list_name}___make();\nfor (int64_t spite_index = 0; spite_index < {registry}_count; spite_index = spite_index + 1) \{ {list_name}_append(result, {name}___retain({registry}[spite_index])); }\nreturn result;\n}",
    )
    singleton_releases.append("if ({registry} != 0) free({registry});")
    return function_c_name
}

func run_time_kind_word(name: String): Boolean {
    var words = ["is_stateful", "is_list", "is_dictionary", "is_optional", "is_enum", "is_mutated", "returned_literal"]
    return words.contains(name)
}

func type_kind(spite_type: Analysis.SpiteType): String {
    if type_shape.as_list(spite_type) {
        return "list"
    }
    if type_shape.as_dictionary(spite_type) {
        return "dictionary"
    }
    if type_shape.as_nullable(spite_type) {
        return "optional"
    }
    if type_shape.as_enum(spite_type) {
        return "enum"
    }
    return ""
}

func ensure_namespace_object(namespace_dotted: String): String {
    var function_c_name = "spite_namespace_object_{namespace_dotted.replace(".", "_")}"
    if namespace_object_keys.contains(namespace_dotted) {
        return function_c_name
    }
    if not find_class_by_c_name("Spite_Namespace") {
        report(
            "reflection needs the standard library: library/spite/namespace.spite was not found from the working directory",
        )
        return function_c_name
    }
    namespace_object_keys.append(namespace_dotted)
    builder.add_typedef("static Spite_Namespace* {function_c_name}_cache = 0;")
    add_described_lock(function_c_name)
    builder.add_prototype("Spite_Namespace* {function_c_name}(void);")
    return function_c_name
}

func emit_namespace_object_bodies() {
    while namespace_objects_emitted < namespace_object_keys.count() {
        var position = namespace_objects_emitted
        namespace_objects_emitted = namespace_objects_emitted + 1
        crash namespace_object_keys[position]
        var namespace_dotted = namespace_object_keys[position]
        var function_c_name = "spite_namespace_object_{namespace_dotted.replace(".", "_")}"
        var segments = namespace_dotted.split(".")
        var namespace_name = segments.last()
        crash namespace_name
        var lines = List<String>()
        lines.append("Spite_Namespace* {function_c_name}(void) \{")
        lines.append(
            "if (SPITE_SINGLETON_FOUND({function_c_name}_ready)) return Spite_Namespace___retain({function_c_name}_cache);",
        )
        lines.append("spite_described_enter();")
        lines.append("if ({function_c_name}_cache == 0) \{")
        lines.append(
            "{function_c_name}_cache = Spite_Namespace___make({ensure_symbol(namespace_name)}, {ensure_symbol(namespace_dotted)});",
        )
        if source_paths_used {
            var namespace_paths = namespace_source_paths(namespace_dotted)
            emit_source_paths(lines, "{function_c_name}_cache", namespace_paths, true)
        }
        if segments.count() > 1 {
            var parent_segments = segments.copy()
            parent_segments.remove_last()
            var joined_parent_segments = parent_segments.join(".")
            lines.append("{function_c_name}_cache->_parent_ = {ensure_namespace_object(joined_parent_segments)}();")
        }
        if namespace_tree_used {
            var class_class = find_class_by_c_name("Spite_Class")
            var namespace_class = find_class_by_c_name("Spite_Namespace")
            crash class_class
            crash namespace_class
            var class_type = class_type_of(class_class)
            var classes_list_name = ensure_list(class_type)
            var namespace_class_type = class_type_of(namespace_class)
            var namespaces_list_name = ensure_list(namespace_class_type)
            var class_index = 0
            while class_index < classes.count() {
                if is_listed_class(classes[class_index]) {
                    if classes[class_index].namespace_dotted == namespace_dotted {
                        var listed_class_type = class_type_of(classes[class_index])
                        lines.append(
                            "{classes_list_name}_append({function_c_name}_cache->_classes_, {class_object_call(listed_class_type)});",
                        )
                    }
                }
                class_index = class_index + 1
            }
            var child_namespaces = List<String>()
            class_index = 0
            while class_index < classes.count() {
                if is_listed_class(classes[class_index]) {
                    var child_dotted = classes[class_index].namespace_dotted
                    if child_dotted.starts_with("{namespace_dotted}.") {
                        if child_dotted.split(".").count() == segments.count() + 1 {
                            if not child_namespaces.contains(child_dotted) {
                                child_namespaces.append(child_dotted)
                            }
                        }
                    }
                }
                class_index = class_index + 1
            }
            var child_position = 0
            while child_position < child_namespaces.count() {
                lines.append(
                    "{namespaces_list_name}_append({function_c_name}_cache->_namespaces_, {ensure_namespace_object(child_namespaces[child_position])}());",
                )
                child_position = child_position + 1
            }
            var declared_enums = enums_in_namespace(namespace_dotted)
            var enum_position = 0
            while enum_position < declared_enums.count() {
                var declared_enum_type = enum_type_of(declared_enums[enum_position])
                lines.append(
                    "{classes_list_name}_append({function_c_name}_cache->_enums_, {class_object_call(declared_enum_type)});",
                )
                enum_position = enum_position + 1
            }
        }
        lines.append("}")
        lines.append("spite_described_leave(&{function_c_name}_ready);")
        lines.append("return Spite_Namespace___retain({function_c_name}_cache);")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
}

func ensure_class_object(display_name: String, namespace: String, label: String): String {
    var function_c_name = "spite_class_object_{label}"
    if class_object_names.contains(function_c_name) {
        return function_c_name
    }
    if not find_class_by_c_name("Spite_Class") {
        report(
            "reflection needs the standard library: library/spite/class.spite was not found from the working directory",
        )
        return function_c_name
    }
    class_object_names.append(function_c_name)
    class_object_displays.append(display_name)
    class_object_namespaces.append(namespace)
    class_object_labels.append(label)
    builder.add_typedef("static Spite_Class* {function_c_name}_cache = 0;")
    add_described_lock(function_c_name)
    builder.add_prototype("Spite_Class* {function_c_name}(void);")
    return function_c_name
}

func add_described_lock(function_c_name: String) {
    builder.add_typedef("static bool {function_c_name}_ready = false;")
    assert not described_lock_emitted
    described_lock_emitted = true
    builder.add_typedef(
        "static int64_t spite_described_owner = 0;\nstatic int32_t spite_described_depth = 0;\nstatic SPITE_THREAD_LOCAL char spite_described_thread;\nstatic void spite_described_enter(void) \{\n#ifdef SPITE_THREADS\nint64_t spite_me = (int64_t)(intptr_t)&spite_described_thread;\nif (__atomic_load_n(&spite_described_owner, __ATOMIC_ACQUIRE) != spite_me) \{\nint64_t spite_free = 0;\nwhile (!__atomic_compare_exchange_n(&spite_described_owner, &spite_free, spite_me, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) \{ spite_free = 0; }\n}\n#endif\nspite_described_depth = spite_described_depth + 1;\n}\nstatic void spite_described_leave(bool* ready) \{\nspite_described_depth = spite_described_depth - 1;\nif (spite_described_depth > 0) return;\n#ifdef SPITE_THREADS\n__atomic_store_n(ready, true, __ATOMIC_RELEASE);\n__atomic_store_n(&spite_described_owner, 0, __ATOMIC_RELEASE);\n#else\n*ready = true;\n#endif\n}",
    )
}

func class_object_call(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return "{ensure_class_object(described.simple_name, described.namespace_dotted, described.c_name)}()"
        }
    }
    var label = type_label(spite_type)
    var display_name = type_display_name(spite_type)
    var kind = type_kind(spite_type)
    if not kind.is_empty() {
        class_object_kinds["spite_class_object_{label}"] = kind
    }
    return "{ensure_class_object(display_name, "", label)}()"
}

func display_names_of(sources: List<Analysis.SpiteType>): List<String> {
    var answers = List<String>()
    var index = 0
    while index < sources.count() {
        var answer = type_display_name(sources[index])
        answers.append(answer)
        index = index + 1
    }
    return answers
}

func type_display_name(spite_type: Analysis.SpiteType): String {
    return type_name_written(spite_type, false)
}

func type_display_names(first: Analysis.SpiteType, second: Analysis.SpiteType): List<String> {
    var first_name = type_name_written(first, false)
    var second_name = type_name_written(second, false)
    if first_name == second_name {
        first_name = type_name_written(first, true)
        second_name = type_name_written(second, true)
    }
    if first_name == second_name {
        first_name = with_class_arguments(first, first_name)
        second_name = with_class_arguments(second, second_name)
    }
    var names = List<String>()
    names.append(first_name)
    names.append(second_name)
    return names
}

func with_class_arguments(spite_type: Analysis.SpiteType, name: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if not class_ref {
        return name
    }
    var described = find_class_by_c_name(class_ref.c_name)
    if not described or described.codegen_types.is_empty() {
        return name
    }
    var names = display_names_of(described.codegen_types)
    return "{name}<{names.join(", ")}>"
}

func type_name_written(spite_type: Analysis.SpiteType, qualified: Boolean): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        if class_ref.has_signature {
            var named_types = List<String>()
            var argument_index = 0
            while argument_index < class_ref.arguments.count() {
                var display_name = type_name_written(class_ref.arguments[argument_index], qualified)
                named_types.append(display_name)
                argument_index = argument_index + 1
            }
            if class_ref.returns {
                var display_name = type_name_written(class_ref.returns, qualified)
                named_types.append(display_name)
            }
            return "Spite.Function<{named_types.join(", ")}>"
        }
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            if qualified and described.qualified_dotted != "" {
                return described.qualified_dotted
            }
            return described.simple_name
        }
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        var enum_information = enums.find_by_c_name(enum_type.c_name)
        if enum_information {
            if qualified and enum_information.owner_qualified != "" {
                return "{enum_information.owner_qualified}.{enum_information.simple_name}"
            }
            return enum_information.simple_name
        }
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var union_information = find_union_by_c_name(union_type.c_name)
        if union_information {
            if qualified and union_information.owner_qualified != "" {
                return "{union_information.owner_qualified}.{union_information.simple_name}"
            }
            return union_information.simple_name
        }
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        return "List<{type_name_written(list_type_element, qualified)}>"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.element
        var dictionary_type_key = dictionary_type.key
        return "Dictionary<{type_name_written(dictionary_type_key, qualified)}, {type_name_written(dictionary_type_element, qualified)}>"
    }
    var nullable_type = type_shape.as_nullable(spite_type)
    if nullable_type {
        var nullable_type_inner = nullable_type.inner
        return "{type_name_written(nullable_type_inner, qualified)}?"
    }
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        if scalar.kind == 'address_kind' {
            return "Memory.Address"
        }
    }
    return type_label(spite_type)
}

func spite_class_type(): Analysis.SpiteType {
    return Analysis.Types.ClassRefType("Spite_Class")
}

func ensure_attributes_function(information: Analysis.ClassInfo): String {
    item_values.reflect(information.qualified_dotted)
    if information.qualified_dotted == "List" and information.codegen_types.count() == 1 {
        return ensure_list_attributes_function(information.codegen_types[0])
    }
    if information.qualified_dotted == "Dictionary" and information.codegen_types.count() == 2 {
        var fixed = fixed_dictionary_type(information)
        var dictionary = type_shape.as_dictionary(fixed)
        crash dictionary
        return ensure_dictionary_attributes_function(dictionary)
    }
    var function_c_name = "{information.c_name}___attributes"
    if attributes_function_names.contains(function_c_name) {
        return function_c_name
    }
    attributes_function_names.append(function_c_name)
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        report(
            "reflection needs the standard library: library/spite/attribute.spite was not found from the working directory",
        )
        return function_c_name
    }
    var class_type = class_type_of(attribute_class)
    var list_name = ensure_list(class_type)
    var lines = List<String>()
    lines.append("{list_name}* {function_c_name}({information.c_name}* self) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    if read_evaluate_print_loop {
        mark_every_attribute_read(information)
        builder.add_prototype("{list_name}* {function_c_name}({information.c_name}* self);")
        append_live_attributes(information, list_name, lines)
        var joined_lines = lines.join("\n")
        note_support_slot(information, "'s attributes")
        builder.add_support(joined_lines)
        return function_c_name
    }
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var field_code = field_place("self", information, field.name)
        if information.is_stateless_singleton {
            field_code = "({field.default_value_code})"
        }
        lines.append(
            "\{ Spite_Attribute* spite_field = Spite_Attribute___make({ensure_symbol(field.name)}, {class_object_call(field_type)});",
        )
        lines.append("spite_field->_value_ = {ensure_attribute_object(field_type)}({field_code});")
        lines.append("spite_field->_index_ = {index};")
        lines.append("{list_name}_append(result, spite_field); }")
        index = index + 1
    }
    lines.append("(void)self;")
    lines.append("return result;")
    lines.append("}")
    builder.add_prototype("{list_name}* {function_c_name}({information.c_name}* self);")
    var joined_lines = lines.join("\n")
    note_support_slot(information, "'s attributes")
    builder.add_support(joined_lines)
    return function_c_name
}

func attribute_object_shape(): Analysis.UnionInfo {
    var found = find_union_qualified("Nothing", "Anything")
    crash found
    return found
}

func ensure_attribute_object(spite_type: Analysis.SpiteType): String {
    var function_c_name = "spite_attribute_object_{reflected_label(spite_type)}"
    if attribute_object_names.contains(function_c_name) {
        return function_c_name
    }
    attribute_object_names.append(function_c_name)
    attribute_object_types.append(spite_type)
    var information = attribute_object_shape()
    builder.add_prototype("{information.c_name} {function_c_name}({c_type_name(spite_type)} value);")
    return function_c_name
}

func emit_attribute_object_bodies() {
    assert attribute_objects_emitted < attribute_object_names.count()
    var information = attribute_object_shape()
    var shape_type = union_type_of(information)
    while attribute_objects_emitted < attribute_object_names.count() {
        var position = attribute_objects_emitted
        attribute_objects_emitted = attribute_objects_emitted + 1
        crash attribute_object_types[position]
        var object_code = null_code(shape_type)
        if attribute_object_used {
            object_code = attribute_object_code(attribute_object_types[position], "value", shape_type)
        }
        crash attribute_object_types[position]
        crash attribute_object_names[position]
        builder.add_support(
            "{information.c_name} {attribute_object_names[position]}({c_type_name(attribute_object_types[position])} value) \{\n(void)value;\nreturn {object_code};\n}",
        )
    }
}

func attribute_object_code(spite_type: Analysis.SpiteType, code: String, shape_type: Analysis.SpiteType): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.inner
        if type_is_reference(inner) {
            return "({present_code(code, inner)} ? {attribute_object_code(inner, code, shape_type)} : {null_code(shape_type)})"
        }
        return "({code}.has_value ? {attribute_object_code(inner, "{code}.value", shape_type)} : {null_code(shape_type)})"
    }
    if boxed_class_of(spite_type) {
        return cast(code, spite_type, shape_type)
    }
    if type_shape.is_symbol(spite_type) {
        var string_spite_type = string_type()
        var retained_text = retain_call(string_spite_type, code)
        return cast(retained_text, string_spite_type, shape_type)
    }
    if not has_attribute_object(spite_type) {
        return "0"
    }
    var retained = retain_call(spite_type, code)
    return cast(retained, spite_type, shape_type)
}

func has_attribute_object(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_class_ref(spite_type) or type_shape.as_string(spite_type) or type_shape.as_union(spite_type) {
        return true
    }
    if type_shape.as_list(spite_type) or type_shape.as_dictionary(spite_type) {
        return true
    }
    return false
}

func ensure_union_attributes(information: Analysis.UnionInfo): String {
    var function_c_name = "{information.c_name}___attributes"
    note_fact("flag attributes of {information.c_name}")
    if not information.attributes_used {
        information.attributes_used = true
        var attribute_class = find_class_by_c_name("Spite_Attribute")
        crash attribute_class
        var class_type = class_type_of(attribute_class)
        var list_name = ensure_list(class_type)
        builder.add_prototype("{list_name}* {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func attributes_described(member: Analysis.ClassInfo): Boolean {
    return not boxed_value_types.has(member.c_name) and not member.is_value_class and not member.is_container
}

func ensure_union_attribute_members() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.attributes_used {
            var member_index = 0
            while member_index < information.members.count() {
                var member = information.members[member_index]
                if attributes_described(member) {
                    mark_every_attribute_read(member)
                    ensure_attributes_function(member)
                }
                member_index = member_index + 1
            }
        }
        index = index + 1
    }
}

func shape_member_total(): Integer {
    var total = 0
    var index = 0
    while index < unions.count() {
        total = total + unions[index].members.count()
        index = index + 1
    }
    return total
}

func settle_shape_members() {
    var before = -1
    var after = shape_member_total()
    while before != after or attribute_objects_emitted < attribute_object_names.count() {
        before = after
        ensure_union_attribute_members()
        emit_attribute_object_bodies()
        emit_class_object_bodies()
        emit_pending_functions()
        after = shape_member_total()
    }
}

func emit_union_attributes_bodies() {
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    assert attribute_class
    var class_type = class_type_of(attribute_class)
    var list_name = ensure_list(class_type)
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.attributes_used {
            var lines = List<String>()
            lines.append("{list_name}* {information.c_name}___attributes({information.c_name} self) \{")
            var member_index = 0
            while member_index < information.members.count() {
                var member = information.members[member_index]
                if attributes_described(member) {
                    var described = ensure_attributes_function(member)
                    var attributes_type = union_type_of(information)
                    var attributes_test = value_class_test("self", attributes_type, member)
                    var attributes_object = member_value_code("self", attributes_type, member)
                    lines.append("if {attributes_test} return {described}({attributes_object});")
                }
                member_index = member_index + 1
            }
            lines.append("return {list_name}___make();")
            lines.append("}")
            var joined_lines = lines.join("\n")
            note_union_slot(information, "'s attributes")
            builder.add_support(joined_lines)
        }
        index = index + 1
    }
}

func returned_class_object_call(function: Analysis.FunctionInfo): String {
    var function_return_type = function.return_type
    if type_shape.is_void(function_return_type) {
        var nothing = find_class_by_c_name("Nothing")
        if nothing {
            var class_type = class_type_of(nothing)
            return class_object_call(class_type)
        }
        return "{ensure_class_object("Nothing", "", "Nothing")}()"
    }
    return class_object_call(function_return_type)
}

func ensure_functions_function(information: Analysis.ClassInfo): String {
    item_values.untrust_class(information.qualified_dotted)
    var function_c_name = "{information.c_name}___functions"
    if functions_function_names.contains(function_c_name) {
        return function_c_name
    }
    functions_function_names.append(function_c_name)
    functions_function_classes.append(information)
    var early_function_class = find_class_by_c_name("Spite_Function")
    if early_function_class {
        var class_type = class_type_of(early_function_class)
        builder.add_prototype("{ensure_list(class_type)}* {function_c_name}({information.c_name}* self);")
    }
    return function_c_name
}

func emit_functions_function(information: Analysis.ClassInfo) {
    var function_class = find_class_by_c_name("Spite_Function")
    var argument_class = find_class_by_c_name("Spite_Argument")
    if not function_class {
        report(
            "reflection needs the standard library: library/spite/function.spite was not found from the working directory",
        )
        return
    }
    if not argument_class {
        report(
            "reflection needs the standard library: library/spite/argument.spite was not found from the working directory",
        )
        return
    }
    var class_type = class_type_of(function_class)
    var list_name = ensure_list(class_type)
    var argument_class_type = class_type_of(argument_class)
    var arguments_list_name = ensure_list(argument_class_type)
    if information.is_container {
        instantiate_member_templates_of(information)
    }
    if hot_reload {
        add_hot_functions_slot(information, list_name)
    }
    var declared_count = information.declared_functions.count()
    var listed = functions_list_text(information, list_name, arguments_list_name)
    listed_function_classes.append(information)
    listed_function_counts.append(declared_count)
    var position = builder.support_count()
    listed_function_positions.append(position)
    builder.add_support(listed)
}

func refresh_functions_lists(): Boolean {
    var refreshed = false
    var index = 0
    while index < listed_function_classes.count() {
        var information = listed_function_classes[index]
        var count = information.declared_functions.count()
        crash listed_function_counts[index]
        if count != listed_function_counts[index] {
            listed_function_counts[index] = count
            var function_class = find_class_by_c_name("Spite_Function")
            var argument_class = find_class_by_c_name("Spite_Argument")
            crash function_class and argument_class
            var class_type = class_type_of(function_class)
            var list_name = ensure_list(class_type)
            var argument_class_type = class_type_of(argument_class)
            var arguments_list_name = ensure_list(argument_class_type)
            var listed = functions_list_text(information, list_name, arguments_list_name)
            crash listed_function_positions[index]
            var position = listed_function_positions[index]
            builder.replace_support(position, listed)
            refreshed = true
        }
        index = index + 1
    }
    return refreshed
}

func functions_list_text(information: Analysis.ClassInfo, list_name: String, arguments_list_name: String): String {
    var function_c_name = "{information.c_name}___functions"
    var lines = List<String>()
    var defined_name = function_c_name
    if hot_reload {
        defined_name = "{function_c_name}___hot"
    }
    lines.append("{list_name}* {defined_name}({information.c_name}* self) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    var index = 0
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        var listed = not information.is_container or not function.symbol_owner_c_name.is_empty()
        var specialised = function.specialisation_position >= 0
        if listed and not function.is_constructor and not function.symbol_through_caller and not specialised {
            lines.append("\{")
            lines.append(
                "Spite_Function* described = Spite_Function___make({ensure_symbol(function.name)}, {returned_class_object_call(function)});",
            )
            var parameter_index = 0
            while parameter_index < function.parameters.count() {
                var parameter = function.parameters[parameter_index]
                var parameter_type = parameter.type
                lines.append(
                    "\{ Spite_Argument* listed_argument = Spite_Argument___make({ensure_symbol(parameter.name)}, {class_object_call(parameter_type)});",
                )
                lines.append("listed_argument->_index_ = {parameter_index};")
                if run_time_kinds_used and function.has_body {
                    var slot: String = parameter_index
                    if parameter_writes.answer(this, information, function, slot) {
                        lines.append("listed_argument->_mutated_ = true;")
                    }
                }
                lines.append("{arguments_list_name}_append(described->_arguments_, listed_argument); }")
                parameter_index = parameter_index + 1
            }
            if run_time_kinds_used and literal_body(function) {
                var literal = returned_literal(function)
                if literal {
                    lines.append("described->_returned_literal_ = {render_string_literal(literal)};")
                    lines.append("described->_has_returned_literal_ = true;")
                }
            }
            var retained_self = "{information.c_name}___retain(self)"
            if hot_reload {
                retained_self = "(\{ if (self != 0) SPITE_COUNT_UP(self->header.ref_count); self; })"
            }
            lines.append("described->spite_owner = {retained_self};")
            lines.append("described->spite_release_owner = (void (*)(void*)){information.c_name}___release;")
            var callable = not is_inline_supplied(function)
            if callable and function.parameters.count() == 0 {
                lines.append("described->spite_call = (void (*)(void*)){ensure_dropping_call(information, function)};")
            }
            if callable {
                lines.append("described->spite_typed_call = (void*){function.c_name};")
            }
            if callable and not listed_typed_calls.contains(function.c_name) {
                listed_typed_calls.append(function.c_name)
            }
            if callable {
                remember_accessed_call(information, function)
            }
            if callable and read_evaluate_print_loop {
                var text_call = ensure_text_call(information, function)
                if not text_call.is_empty() {
                    lines.append("described->spite_text_call = (void*){text_call};")
                }
            }
            lines.append("{list_name}_append(result, described);")
            lines.append("}")
        }
        index = index + 1
    }
    lines.append("return result;")
    lines.append("}")
    return lines.join("\n")
}

func emit_functions_function_bodies() {
    while functions_functions_emitted < functions_function_classes.count() {
        emit_functions_function(functions_function_classes[functions_functions_emitted])
        functions_functions_emitted = functions_functions_emitted + 1
    }
}

func hidden_attribute_links_cleared(target: String): String {
    return "{target}->spite_owner = 0; {target}->spite_release_owner = 0; {target}->spite_assign = 0; {target}->spite_store = 0; {target}->spite_held_class = 0; {target}->spite_held = 0; {target}->spite_release_held = 0; {target}->spite_held_attributes = 0; {target}->spite_held_functions = 0; {target}->spite_held_bytes = 0; {target}->spite_stored_address = 0; {target}->spite_stored_bytes = 0; {target}->spite_buffer_address = 0; {target}->spite_buffer_bytes = 0;"
}

func append_live_attributes(information: Analysis.ClassInfo, list_name: String, lines: List<String>) {
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var reflect = ensure_reflect_function(field_type)
        lines.append("\{")
        lines.append(
            "Spite_Attribute* spite_field = {reflect}({ensure_symbol(field.name)}, {field_place("self", information, field.name)});",
        )
        lines.append(
            "spite_field->spite_stored_address = (int64_t)(intptr_t)&self->{c_value_name(field.name)}; spite_field->spite_stored_bytes = (int64_t)sizeof(self->{c_value_name(field.name)});",
        )
        lines.append("spite_field->_index_ = {index};")
        var assign = ensure_assign_function(information, field)
        var store = ensure_store_function(information, field)
        if not assign.is_empty() or not store.is_empty() {
            lines.append("spite_field->spite_owner = {information.c_name}___retain(self);")
            lines.append("spite_field->spite_release_owner = (void (*)(void*)){information.c_name}___release;")
        }
        if not assign.is_empty() {
            lines.append("spite_field->spite_assign = {assign};")
        }
        if not store.is_empty() {
            lines.append("spite_field->spite_store = {store};")
        }
        lines.append("{list_name}_append(result, spite_field);")
        lines.append("}")
        index = index + 1
    }
    lines.append("(void)self;")
    lines.append("return result;")
    lines.append("}")
}

func reflected_label(spite_type: Analysis.SpiteType): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.inner
        return "Nullable_{type_label(nullable_inner)}"
    }
    return type_label(spite_type)
}

func walkable_class(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var expected_inner_type = expected_type_without_nullable(spite_type)
    var class_ref = type_shape.as_class_ref(expected_inner_type)
    assert class_ref
    assert not class_ref.has_signature
    var described = find_class_by_c_name(class_ref.c_name)
    assert described
    assert not described.is_value_class and not described.is_generic_template
    return described
}

func ensure_reflect_function(spite_type: Analysis.SpiteType): String {
    var function_c_name = "spite_reflect_{reflected_label(spite_type)}"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var signature = "Spite_Attribute* {function_c_name}(SpiteString name, {c_type_name(spite_type)} value)"
    builder.add_prototype("{signature};")
    var lines = List<String>()
    lines.append("{signature} \{")
    lines.append("Spite_Attribute* reflected = Spite_Attribute___make(name, {class_object_call(spite_type)});")
    lines.append("reflected->_value_ = {ensure_attribute_object(spite_type)}(value);")
    var walked = walkable_class(spite_type)
    if walked {
        lines.append("reflected->spite_held = {walked.c_name}___retain(value);")
        lines.append("reflected->spite_release_held = (void (*)(void*)){walked.c_name}___release;")
        lines.append("reflected->spite_held_attributes = (void* (*)(void*)){ensure_attributes_function(walked)};")
        lines.append("reflected->spite_held_functions = (void* (*)(void*)){ensure_functions_function(walked)};")
        lines.append("reflected->spite_held_bytes = {ensure_byte_count_function(walked)}();")
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        var list_name = ensure_list(list_type_element)
        lines.append("reflected->spite_held = {list_name}___retain(value);")
        lines.append("reflected->spite_release_held = (void (*)(void*)){list_name}___release;")
        lines.append("reflected->spite_held_bytes = (int64_t)sizeof({list_name});")
        lines.append(
            "if (value != 0) \{ reflected->spite_buffer_address = (int64_t)(intptr_t)value->items_; reflected->spite_buffer_bytes = (int64_t)value->item_count_ * (int64_t)sizeof({c_type_name(list_type_element)}); }",
        )
        lines.append(
            "reflected->spite_held_attributes = (void* (*)(void*)){ensure_list_attributes_function(list_type_element)};",
        )
        if read_evaluate_print_loop and type_shape.as_class_ref(list_type_element) {
            var list_class = list_class_of(list_type_element)
            lines.append("reflected->spite_held_functions = (void* (*)(void*)){ensure_functions_function(list_class)};")
        }
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_name = ensure_dictionary(dictionary_type)
        lines.append("reflected->spite_held = {dictionary_name}___retain(value);")
        lines.append("reflected->spite_release_held = (void (*)(void*)){dictionary_name}___release;")
        lines.append(
            "reflected->spite_held_attributes = (void* (*)(void*)){ensure_dictionary_attributes_function(dictionary_type)};",
        )
    }
    if read_evaluate_print_loop {
        var union_lines = union_member_links(spite_type)
        lines.append(union_lines)
    }
    lines.append("return reflected;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func union_member_links(spite_type: Analysis.SpiteType): String {
    var inner = expected_type_without_nullable(spite_type)
    var union_type = type_shape.as_union(inner)
    if not union_type {
        return ""
    }
    var information = find_union_by_c_name(union_type.c_name)
    crash information
    var links = List<String>()
    var index = 0
    while index < information.members.count() {
        var member = information.members[index]
        var walkable = not member.is_value_class and not member.is_generic_template
        if walkable and member.c_name != "SpiteString" and not boxed_value_types.has(member.c_name) {
            var held_object = member_value_code("value", spite_type, member)
            var retained = "{member.c_name}___retain({held_object})"
            var held_present = present_code("value", inner)
            var held_test = value_class_test("value", spite_type, member)
            links.append(
                "if ({held_present} && {held_test}) \{ reflected->spite_held = {retained}; reflected->spite_release_held = (void (*)(void*)){member.c_name}___release; reflected->spite_held_attributes = (void* (*)(void*)){ensure_attributes_function(member)}; reflected->spite_held_functions = (void* (*)(void*)){ensure_functions_function(member)}; reflected->spite_held_bytes = {ensure_byte_count_function(member)}(); reflected->spite_held_class = (void* (*)(void)){ensure_class_object(member.simple_name, member.namespace_dotted, member.c_name)}; }",
            )
        }
        index = index + 1
    }
    return links.join("\n")
}

func ensure_list_attributes_function(element: Analysis.SpiteType): String {
    var list_name = ensure_list(element)
    var function_c_name = "{list_name}___attributes"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    crash attribute_class
    var class_type = class_type_of(attribute_class)
    var attributes_list = ensure_list(class_type)
    var signature = "{attributes_list}* {function_c_name}({list_name}* self)"
    builder.add_prototype("{signature};")
    var reflect = ensure_reflect_function(element)
    builder.add_support(
        "{signature} \{\n{attributes_list}* result = {attributes_list}___make();\nfor (int64_t spite_index = 0; spite_index < self->item_count_; spite_index = spite_index + 1) \{ Spite_Attribute* spite_item = {reflect}({long_text("spite_index")}, {list_item_code(element, "self", "spite_index")}); spite_item->spite_stored_address = (int64_t)(intptr_t)&{list_item_code(element, "self", "spite_index")}; spite_item->spite_stored_bytes = (int64_t)sizeof({c_type_name(element)}); {element_hooks(element, "spite_item", "self")}{attributes_list}_append(result, spite_item); }\nreturn result;\n}",
    )
    return function_c_name
}

func element_hooks(element: Analysis.SpiteType, target: String, owner: String): String {
    if not read_evaluate_print_loop {
        return ""
    }
    var assign = ensure_slot_assign_function(element)
    var store = ensure_slot_store_function(element)
    if assign.is_empty() and store.is_empty() {
        return ""
    }
    var hooks = "{target}->spite_owner = {owner}; {target}->spite_release_owner = 0; "
    if not assign.is_empty() {
        hooks = "{hooks}{target}->spite_assign = {assign}; "
    }
    if not store.is_empty() {
        hooks = "{hooks}{target}->spite_store = {store}; "
    }
    return hooks
}

func ensure_dictionary_attributes_function(dictionary: Analysis.Types.DictionaryType): String {
    var element = dictionary.element
    var dictionary_name = ensure_dictionary(dictionary)
    var function_c_name = "{dictionary_name}___attributes"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    crash attribute_class
    var class_type = class_type_of(attribute_class)
    var attributes_list = ensure_list(class_type)
    var signature = "{attributes_list}* {function_c_name}({dictionary_name}* self)"
    builder.add_prototype("{signature};")
    var reflect = ensure_reflect_function(element)
    var key_type = dictionary.key
    var key = list_item_code(key_type, "self->entry_keys_", "spite_index")
    var key_text = "SpiteString___retain({key})"
    if not type_shape.as_string(key_type) {
        key_text = long_text("(int64_t)({key})")
    }
    var entry = list_item_code(element, "self->entry_values_", "spite_index")
    builder.add_support(
        "{signature} \{\n{attributes_list}* result = {attributes_list}___make();\nfor (int64_t spite_index = 0; spite_index < self->entry_keys_->item_count_; spite_index = spite_index + 1) \{ Spite_Attribute* spite_item = {reflect}({key_text}, {entry}); spite_item->spite_stored_address = (int64_t)(intptr_t)&{entry}; spite_item->spite_stored_bytes = (int64_t)sizeof({c_type_name(element)}); {element_hooks(element, "spite_item", "self")}{attributes_list}_append(result, spite_item); }\nreturn result;\n}",
    )
    return function_c_name
}

func enum_from_text(code: String, release: String, enum_type: Analysis.Types.EnumType): String {
    var first_value = enum_type.values.first()
    crash first_value
    var enum_spite_type: Analysis.SpiteType = enum_type
    var nullable_enum = nullable_type_of(enum_spite_type)
    var nullable_name = c_type_name(nullable_enum)
    var chosen_code = enum_from_text_lines(
        enum_type,
        "spite_enum_text",
        "spite_enum_value.value",
        "spite_enum_value.has_value = false;",
    )
    return "(\{ SpiteString spite_enum_text = {code}; {nullable_name} spite_enum_value = \{ .has_value = true, .value = {enum_type.c_name}_{first_value} }; {chosen_code}{release} spite_enum_value; })"
}

func enum_reading_name(enum_label: String): String {
    var label_words = enum_label.split(".")
    var last_word = label_words.last()
    crash last_word
    return "to_{words_of(last_word).join("_")}"
}

func read_enum_named(reading: String, class_information: Analysis.ClassInfo): Analysis.Types.EnumType? {
    assert reading.starts_with("to_")
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        if enum_reading_name(candidate.simple_name) == reading {
            var no_arguments = List<Syntax.Types.GenericArgument>()
            var path = List<String>()
            path.append(candidate.simple_name)
            var named = Syntax.Types.NamedType(path, no_arguments)
            var resolved = resolve_named_type(named, class_information.qualified_dotted)
            assert resolved
            return type_shape.as_enum(resolved)
        }
        index = index + 1
    }
    return null
}

func enum_from_text_lines(enum_type: Analysis.Types.EnumType, text: String, target: String, failure: String): String {
    var chain = List<String>()
    var index = 0
    while index < enum_type.values.count() {
        var value = enum_type.values[index]
        chain.append("if (SpiteString_equals({text}, {ensure_symbol(value)})) {target} = {enum_type.c_name}_{value};")
        index = index + 1
    }
    chain.append(failure)
    return chain.join(" else ")
}

func scalar_from_text_lines(scalar_type: Analysis.SpiteType, text: String, target: String, failure: String): String {
    var label = type_label(scalar_type)
    if label == "Boolean" {
        return "if (SpiteString_equals({text}, {ensure_symbol("true")})) {target} = true; else if (SpiteString_equals({text}, {ensure_symbol("false")})) {target} = false; else {failure}"
    }
    var conversion_name = words_of(label).join("_")
    var conversion = written_string_function("to_{conversion_name}")
    var converted = "{target} = spite_parsed.value;"
    if not conversion {
        var scalar = type_shape.as_scalar(scalar_type)
        crash scalar
        var widest = "to_long"
        if is_float_kind(scalar.kind) {
            widest = "to_double"
        }
        conversion = written_string_function(widest)
        converted = "{target} = ({c_type_name(scalar_type)})spite_parsed.value;"
    }
    crash conversion
    var parsed_type = conversion.return_type
    return "\{ {c_type_name(parsed_type)} spite_parsed = {conversion.c_name}({text}); if (!spite_parsed.has_value) {failure} {converted} }"
}

func parsed_value_lines(spite_type: Analysis.SpiteType, text: String, target: String, failure: String): String {
    switch spite_type {
        Analysis.Types.StringType: return "{target} = SpiteString___retain({text});"
        Analysis.Types.ScalarType: return scalar_from_text_lines(spite_type, text, target, failure)
        Analysis.Types.EnumType: return enum_from_text_lines(spite_type, text, target, failure)
        _: {}
    }
    var nullable = type_shape.as_nullable(spite_type)
    if not nullable {
        return ""
    }
    var inner = nullable.inner
    var null_test = "SPITE_STRING_IS_NULL({text})"
    var c_type = c_type_name(spite_type)
    if c_type.starts_with("Nullable_") {
        var inner_lines = parsed_value_lines(inner, text, "{target}.value", failure)
        if inner_lines.is_empty() {
            return ""
        }
        return "if ({null_test}) \{ {target}.has_value = false; } else \{ {target}.has_value = true; {inner_lines} }"
    }
    if type_shape.as_string(inner) {
        return "if ({null_test}) {target} = SPITE_STRING_NULL; else {target} = SpiteString___retain({text});"
    }
    return "if ({null_test}) {target} = {null_code(inner)}; else {failure}"
}

func ensure_assign_function(information: Analysis.ClassInfo, field: Analysis.FieldInfo): String {
    var field_type = field.type
    var function_c_name = "{information.c_name}___assign_{field.name}"
    var assigned_c = c_type_name(field_type)
    var parsed = parsed_value_lines(field_type, "text", "assigned", "return false;")
    if parsed.is_empty() {
        return ""
    }
    var lines = List<String>()
    lines.append("bool {function_c_name}(void* owner, void* slot, SpiteString text) \{")
    lines.append("{information.c_name}* self = ({information.c_name}*)owner;")
    lines.append("(void)slot;")
    if not type_shape.as_nullable(field_type) {
        lines.append("if (SPITE_STRING_IS_NULL(text)) return false;")
    }
    lines.append("{assigned_c} assigned;")
    lines.append(parsed)
    var written = field_written_lines(information, field, "assigned")
    lines.append(written)
    lines.append("return true;")
    lines.append("}")
    builder.add_prototype("bool {function_c_name}(void* owner, void* slot, SpiteString text);")
    var joined_lines = lines.join("\n")
    note_support_slot(information, "'s assignment of {field.name}")
    builder.add_support(joined_lines)
    return function_c_name
}

func field_written_lines(information: Analysis.ClassInfo, field: Analysis.FieldInfo, value: String): String {
    var field_type = field.type
    var setter = information.find_function("set_{field.name}")
    if setter and setter.parameters.count() == 1 {
        return "{setter.c_name}(self, {value});"
    }
    var assigned_place = field_place("self", information, field.name)
    if type_needs_drop(field_type) {
        return "{release_call(field_type, assigned_place)};\n{assigned_place} = {value};"
    }
    return "{assigned_place} = {value};"
}

func stored_class(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var inner = expected_type_without_nullable(spite_type)
    var class_ref = type_shape.as_class_ref(inner)
    assert class_ref
    assert not class_ref.has_signature
    var stored = find_class_by_c_name(class_ref.c_name)
    assert stored
    assert not stored.is_value_class and not stored.is_generic_template
    return stored
}

func ensure_store_function(information: Analysis.ClassInfo, field: Analysis.FieldInfo): String {
    if not read_evaluate_print_loop {
        return ""
    }
    var field_type = field.type
    var stored = stored_class(field_type)
    if not stored {
        return ""
    }
    var function_c_name = "{information.c_name}___store_{field.name}"
    var lines = List<String>()
    lines.append("bool {function_c_name}(void* owner, void* slot, void* object) \{")
    lines.append("{information.c_name}* self = ({information.c_name}*)owner;")
    lines.append("(void)slot;")
    lines.append("if (object == 0 || !{class_id_test("object", stored)}) return false;")
    lines.append("{stored.c_name}* assigned = {stored.c_name}___retain(({stored.c_name}*)object);")
    var written = field_written_lines(information, field, "assigned")
    lines.append(written)
    lines.append("return true;")
    lines.append("}")
    builder.add_prototype("bool {function_c_name}(void* owner, void* slot, void* object);")
    var joined_lines = lines.join("\n")
    note_support_slot(information, "'s assignment of {field.name}")
    builder.add_support(joined_lines)
    return function_c_name
}

func ensure_slot_assign_function(element: Analysis.SpiteType): String {
    var function_c_name = "spite_assign_slot_{reflected_label(element)}"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    var element_c = c_type_name(element)
    var parsed = parsed_value_lines(element, "text", "assigned", "return false;")
    if parsed.is_empty() {
        return ""
    }
    reflect_function_names.append(function_c_name)
    var lines = List<String>()
    lines.append("bool {function_c_name}(void* owner, void* slot, SpiteString text) \{")
    lines.append("(void)owner;")
    lines.append("if (slot == 0) return false;")
    if not type_shape.as_nullable(element) {
        lines.append("if (SPITE_STRING_IS_NULL(text)) return false;")
    }
    lines.append("{element_c} assigned;")
    lines.append(parsed)
    lines.append("{element_c}* place = ({element_c}*)slot;")
    if type_needs_drop(element) {
        lines.append("{release_call(element, "(*place)")};")
    }
    lines.append("*place = assigned;")
    lines.append("return true;")
    lines.append("}")
    builder.add_prototype("bool {function_c_name}(void* owner, void* slot, SpiteString text);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func ensure_slot_store_function(element: Analysis.SpiteType): String {
    var stored = stored_class(element)
    if not stored {
        return ""
    }
    var function_c_name = "spite_store_slot_{reflected_label(element)}"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var element_c = c_type_name(element)
    var lines = List<String>()
    lines.append("bool {function_c_name}(void* owner, void* slot, void* object) \{")
    lines.append("(void)owner;")
    lines.append("if (slot == 0 || object == 0 || !{class_id_test("object", stored)}) return false;")
    lines.append("{element_c}* place = ({element_c}*)slot;")
    lines.append("{stored.c_name}* assigned = {stored.c_name}___retain(({stored.c_name}*)object);")
    lines.append("{release_call(element, "(*place)")};")
    lines.append("*place = assigned;")
    lines.append("return true;")
    lines.append("}")
    builder.add_prototype("bool {function_c_name}(void* owner, void* slot, void* object);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func ensure_dropping_call(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var return_spite_type = function.return_type
    if type_shape.is_void(return_spite_type) {
        return function.c_name
    }
    var function_c_name = "{function.c_name}___dropping_call"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var lines = List<String>()
    lines.append("void {function_c_name}(void* owner) \{")
    var call = "{function.c_name}(({information.c_name}*)owner)"
    if type_needs_drop(return_spite_type) {
        lines.append("{c_type_name(return_spite_type)} returned = {call};")
        lines.append("{release_call(return_spite_type, "returned")};")
    } else {
        lines.append("(void){call};")
    }
    lines.append("}")
    builder.add_prototype("void {function_c_name}(void* owner);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func ensure_text_call(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var function_c_name = "{function.c_name}___text_call"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    var string_spite_type = string_type()
    var strings = ensure_list(string_spite_type)
    var lines = List<String>()
    lines.append("Spite_Attribute* {function_c_name}(void* owner, {strings}* arguments) \{")
    lines.append("if (arguments->item_count_ != {function.parameters.count()}) return 0;")
    var call_arguments = List<String>()
    call_arguments.append("({information.c_name}*)owner")
    var index = 0
    while index < function.parameters.count() {
        var parameter_type = function.parameters[index].type
        string_spite_type = string_type()
        var item = list_item_code(string_spite_type, "arguments", index)
        switch parameter_type {
            Analysis.Types.StringType: call_arguments.append("SpiteString___retain({item})")
            Analysis.Types.ScalarType: {
                lines.append("{c_type_name(parameter_type)} argument_{index};")
                var from_text_lines = scalar_from_text_lines(parameter_type, item, "argument_{index}", "return 0;")
                lines.append(from_text_lines)
                call_arguments.append("argument_{index}")
            }
            Analysis.Types.EnumType: {
                lines.append("{parameter_type.c_name} argument_{index};")
                var from_text_lines = enum_from_text_lines(parameter_type, item, "argument_{index}", "return 0;")
                lines.append(from_text_lines)
                call_arguments.append("argument_{index}")
            }
            _: return ""
        }
        index = index + 1
    }
    reflect_function_names.append(function_c_name)
    var call = "{function.c_name}({call_arguments.join(", ")})"
    var return_spite_type = function.return_type
    var result_symbol = ensure_symbol("result")
    if type_shape.is_void(return_spite_type) {
        lines.append("{call};")
        lines.append("return Spite_Attribute___make({result_symbol}, {returned_class_object_call(function)});")
    } else {
        lines.append("{c_type_name(return_spite_type)} returned = {call};")
        lines.append(
            "Spite_Attribute* reflected = {ensure_reflect_function(return_spite_type)}({result_symbol}, returned);",
        )
        if type_needs_drop(return_spite_type) {
            lines.append("{release_call(return_spite_type, "returned")};")
        }
        lines.append("return reflected;")
    }
    lines.append("}")
    builder.add_prototype("Spite_Attribute* {function_c_name}(void* owner, {strings}* arguments);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func string_storage_read(
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var string_class = find_class_by_c_name("SpiteString")
    crash string_class
    var field = string_class.find_field(name)
    assert field
    mark_attribute_read(string_class, name)
    if class_information.c_name != string_class.c_name {
        report_private_member(string_class, name, class_information)
        return void_result()
    }
    var field_type = field.type
    if owns(object_result, object_ast) {
        report("'{name}' is read from a String that has a name: name this text with 'var' first")
        return void_result()
    }
    return string_storage_code(name, object_result.code, field_type)
}

func string_storage_code(name: String, code: String, field_type: Analysis.SpiteType): ExpressionResult {
    if name == "_bytes" {
        return ExpressionResult("((int64_t)(intptr_t)spite_string_bytes(&({code})))", field_type)
    }
    if name == "_length" {
        return ExpressionResult("spite_string_length({code})", field_type)
    }
    report("a String is its characters and their length: read '_bytes' or '_length'")
    return void_result()
}

func generate_memory_read(
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    in_frame: Boolean,
): ExpressionResult? {
    var object_type = object_result.type
    var described_ref = type_shape.as_class_ref(object_type)
    if described_ref {
        var described = find_class_by_c_name(described_ref.c_name)
        if described {
            assert not described.find_field("memory")
            assert not described.find_function("get_memory")
        }
    }
    var memory_class = find_class_by_qualified("Spite.Memory")
    if not memory_class {
        report(
            "reflection needs the standard library: library/spite/memory.spite was not found from the working directory",
        )
        return null
    }
    var memory_type = class_type_of(memory_class)
    var object_c_type = c_type_name(object_type)
    var owned = owns(object_result, object_ast) and type_needs_drop(object_type)
    var held = "spite_described"
    var address = "(int64_t)(intptr_t)({held})"
    var bytes = "(int64_t)sizeof(*({held}))"
    var section = "Spite_Memory_Section_heap"
    if type_shape.as_string(object_type) {
        var where_inline = "Spite_Memory_Section_stack"
        var named = not owned and not is_owning_shape(object_ast)
        if object_result.code.contains("->") or not named {
            where_inline = "Spite_Memory_Section_heap"
        }
        address = "(int64_t)(intptr_t)spite_string_bytes(&({held}))"
        if named {
            address = "(int64_t)(intptr_t)spite_string_bytes(&({object_result.code}))"
        }
        bytes = "spite_string_length({held})"
        section = "(SPITE_STRING_IS_HEAP({held}) ? Spite_Memory_Section_heap : SPITE_STRING_IS_INLINE({held}) ? {where_inline} : Spite_Memory_Section_constant)"
    } else if type_shape.as_scalar(object_type) or is_enum_type(object_type) {
        if owned or is_owning_shape(object_ast) {
            report("only a named value has memory of its own: give this value a name with 'var' first")
            return null
        }
        address = "(int64_t)(intptr_t)&({object_result.code})"
        bytes = "(int64_t)sizeof({object_c_type})"
        var scalar_described = type_shape.as_scalar(object_type)
        if scalar_described {
            var number_class = value_class_of(scalar_described.kind)
            if number_class {
                bytes = "(int64_t){number_class.memory_bytes}"
            }
        }
        if not object_result.code.contains("->") {
            section = "Spite_Memory_Section_stack"
        }
        var scalar_memory = ExpressionResult("Spite_Memory___make({address}, {bytes}, {section})", memory_type)
        scalar_memory.owning_override = true
        return scalar_memory
    } else if not type_needs_drop(object_type) or type_shape.as_nullable(object_type) or type_shape.as_union(object_type) {
        report("{type_with_article(object_type)} has no memory of its own to describe")
        return null
    }
    if in_frame {
        section = "Spite_Memory_Section_stack"
    }
    var release_object = ""
    if owned {
        release_object = "{release_call(object_type, held)};"
    }
    var described_memory = ExpressionResult(
        "(\{ {object_c_type} {held} = {object_result.code}; Spite_Memory* spite_memory = Spite_Memory___make({address}, {bytes}, {section}); {release_object} spite_memory; })",
        memory_type,
    )
    described_memory.owning_override = true
    return described_memory
}

func generate_reflection_read(
    member_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
): ExpressionResult? {
    assert member_name == "class" or member_name == "attributes" or member_name == "functions"
    var object_type = object_result.type
    var object_c_type = c_type_name(object_type)
    var owning_object = owns(object_result, object_ast) and type_needs_drop(object_type)
    var release_object = ""
    if owning_object {
        release_object = "{release_call(object_type, "spite_reflected")};"
    }
    var object_class_ref = type_shape.as_class_ref(object_type)
    if object_class_ref {
        if object_class_ref.c_name == "Spite_Class" and member_name == "functions" {
            class_level_functions_used = true
            note_fact("flag class_level_functions_used")
        }
        if object_class_ref.c_name == "Spite_Class" and member_name == "attributes" {
            class_level_attributes_used = true
            note_fact("flag class_level_attributes_used")
        }
        var object_class = find_class_by_c_name(object_class_ref.c_name)
        if object_class {
            assert not object_class.find_function("get_{member_name}")
            var real_field = object_class.find_field(member_name)
            if real_field {
                mark_attribute_read(object_class, member_name)
                var real_field_type = real_field.type
                var reflected_place = field_place("spite_reflected", object_class, member_name)
                var retained_field = retain_call(real_field_type, reflected_place)
                return ExpressionResult(
                    "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(real_field_type)} spite_reflected_value = {retained_field}; {release_object} spite_reflected_value; })",
                    real_field_type,
                )
            }
            if member_name == "functions" {
                var functions_function = ensure_functions_function(object_class)
                var described_class = find_class_by_c_name("Spite_Function")
                if described_class {
                    var class_type = class_type_of(described_class)
                    var functions_type = list_type_of(class_type)
                    return ExpressionResult(
                        "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(functions_type)} spite_reflected_value = {functions_function}(spite_reflected); {release_object} spite_reflected_value; })",
                        functions_type,
                    )
                }
                return null
            }
            if member_name == "attributes" {
                mark_every_attribute_read(object_class)
                var attributes_function = ensure_attributes_function(object_class)
                var attribute_class = find_class_by_c_name("Spite_Attribute")
                if attribute_class {
                    var class_type = class_type_of(attribute_class)
                    var attributes_type = list_type_of(class_type)
                    return ExpressionResult(
                        "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(attributes_type)} spite_reflected_value = {attributes_function}(spite_reflected); {release_object} spite_reflected_value; })",
                        attributes_type,
                    )
                }
                return null
            }
        }
    }
    var attributes_union = type_shape.as_union(object_type)
    if member_name == "attributes" and attributes_union {
        var attributes_information = find_union_by_c_name(attributes_union.c_name)
        crash attributes_information
        var dispatch = ensure_union_attributes(attributes_information)
        var attribute_class = find_class_by_c_name("Spite_Attribute")
        crash attribute_class
        var listed_type = class_type_of(attribute_class)
        var attributes_type = list_type_of(listed_type)
        return ExpressionResult(
            "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(attributes_type)} spite_reflected_value = {dispatch}(spite_reflected); {release_object} spite_reflected_value; })",
            attributes_type,
        )
    }
    if member_name == "class" {
        assert not type_shape.is_void(object_type)
        var object_union = type_shape.as_union(object_type)
        if object_union {
            var union_information = find_union_by_c_name(object_union.c_name)
            if union_information {
                var class_of = ensure_union_class_of(union_information)
                var class_object_type = spite_class_type()
                return ExpressionResult(
                    "(\{ {object_c_type} spite_reflected = {object_result.code}; Spite_Class* spite_reflected_class = {class_of}(spite_reflected); {release_object} spite_reflected_class; })",
                    class_object_type,
                )
            }
        }
        var class_object_type = spite_class_type()
        return ExpressionResult(
            "(\{ {object_c_type} spite_reflected = {object_result.code}; {release_object} (void)spite_reflected; {class_object_call(object_type)}; })",
            class_object_type,
        )
    }
    return null
}

func report_private_member(target_class: Analysis.ClassInfo, name: String, class_information: Analysis.ClassInfo) {
    assert name.starts_with("_") and target_class.c_name != class_information.c_name
    var name_length = name.length()
    var public_name = name.slice(1, name_length)
    if target_class.find_function("get_{public_name}") {
        report(
            "'{name}' is private to '{target_class.simple_name}': a name starting with '_' is used only inside its own class, and '{public_name}' reads it from outside",
        )
        return
    }
    report(
        "'{name}' is private to '{target_class.simple_name}': a name starting with '_' is used only inside its own class",
    )
}

func find_getter(
    target_class: Analysis.ClassInfo,
    attribute_name: String,
    calling_class: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    var getter_name = "get_{attribute_name}"
    assert target_class.c_name != calling_class.c_name or current_function != getter_name
    var getter = find_or_instantiate_function(target_class, getter_name)
    if getter {
        if getter.parameters.count() == 0 {
            return getter
        }
    }
    return null
}

func find_setter(
    target_class: Analysis.ClassInfo,
    attribute_name: String,
    calling_class: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    var setter_name = "set_{attribute_name}"
    assert target_class.c_name != calling_class.c_name or current_function != setter_name
    var setter = target_class.find_function(setter_name)
    if target_class.find_field(attribute_name) {
        setter = find_or_instantiate_function(target_class, setter_name)
    }
    if setter {
        if setter.parameters.count() == 1 {
            return setter
        }
    }
    return null
}

func deep_copy_code(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var copied_class = find_class_by_c_name(class_ref.c_name)
        if copied_class {
            var held = weak_held_class(copied_class)
            if held {
                var weak_copy = ensure_weak_deep_copy(copied_class, held)
                return "{weak_copy}({code})"
            }
            if not copied_class.is_singleton {
                var own_deep_copy = find_or_instantiate_function(copied_class, "deep_copy")
                if own_deep_copy {
                    return "(({code}) == 0 ? 0 : {own_deep_copy.c_name}({code}))"
                }
                return "{ensure_class_deep_copy(copied_class)}({code})"
            }
        }
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var copied_union = find_union_by_c_name(union_type.c_name)
        if copied_union {
            return "{ensure_union_deep_copy(copied_union)}({code})"
        }
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.element
        return "{ensure_list_deep_copy(list_type_element)}({code})"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return "{ensure_dictionary_deep_copy(dictionary_type)}({code})"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.inner
        if type_is_reference(nullable_inner) {
            return deep_copy_code(nullable_inner, code)
        }
        return code
    }
    if type_needs_drop(spite_type) {
        return retain_call(spite_type, code)
    }
    return code
}

func ensure_union_deep_copy(information: Analysis.UnionInfo): String {
    var function_c_name = "{information.c_name}___deep_copy"
    if not information.deep_copy_used {
        information.deep_copy_used = true
        builder.add_prototype("{information.c_name} {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func emit_union_deep_copy_bodies() {
    var emitted_any = true
    while emitted_any {
        emitted_any = false
        var index = 0
        while index < unions.count() {
            var information = unions[index]
            if information.deep_copy_used and not information.deep_copy_emitted {
                information.deep_copy_emitted = true
                emitted_any = true
                var body = union_deep_copy_text(information)
                note_union_slot(information, "'s deep copy")
                builder.add_support(body)
            }
            index = index + 1
        }
        emit_pending_functions()
    }
}

func union_deep_copy_text(information: Analysis.UnionInfo): String {
    var name = information.c_name
    var owner_type = union_type_of(information)
    var lines = List<String>()
    lines.append("{name} {name}___deep_copy({name} self) \{")
    if information.is_tagged {
        lines.append("if (self.plain != 0 || self.value.object == 0) return self;")
    } else {
        lines.append("if (self == 0) return 0;")
    }
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var copied = copied_union_member(member, owner_type, information)
        if not copied.is_empty() {
            lines.append("if {value_class_test("self", owner_type, member)} return {copied};")
        }
        member_index = member_index + 1
    }
    lines.append("return {name}___retain(self);")
    lines.append("}")
    return lines.join("\n")
}

func copied_union_member(
    member: Analysis.ClassInfo,
    owner_type: Analysis.SpiteType,
    information: Analysis.UnionInfo,
): String {
    if member.c_name == "SpiteString" or boxed_value_types.has(member.c_name) or member.is_singleton {
        return ""
    }
    var member_type = instance_type_of(member)
    var read = member_value_code("self", owner_type, member)
    var copied = deep_copy_code(member_type, read)
    if information.is_tagged {
        return "spite_tagged_object({member.class_id}, (void*)({copied}))"
    }
    return "(({information.c_name})({copied}))"
}

func ensure_class_deep_copy(information: Analysis.ClassInfo): String {
    var function_c_name = "{information.c_name}___deep_copy"
    if deep_copy_names.contains(function_c_name) {
        return function_c_name
    }
    deep_copy_names.append(function_c_name)
    builder.add_prototype("{information.c_name}* {function_c_name}({information.c_name}* self);")
    var lines = List<String>()
    lines.append("{information.c_name}* {function_c_name}({information.c_name}* self) \{")
    lines.append("if (self == 0) return 0;")
    if information.is_singleton {
        lines.append("return {information.c_name}___retain(self);")
        lines.append("}")
        var joined_singleton_lines = lines.join("\n")
        builder.add_support(joined_singleton_lines)
        return function_c_name
    }
    var remembers = remembers_copies(information)
    if remembers {
        ensure_copy_table()
        lines.append("{information.c_name}* seen = ({information.c_name}*)spite_copy_table_find(self);")
        lines.append("if (seen != 0) return {information.c_name}___retain(seen);")
        lines.append("bool spite_opened = spite_copy_table_open();")
    }
    lines.append("{information.c_name}* copied = {information.c_name}___allocate();")
    if remembers {
        lines.append("spite_copy_table_add(self, copied);")
    }
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var target = field_place("copied", information, field.name)
        var source = field_place("self", information, field.name)
        var field_type = field.type
        var release_line = release_statement(field_type, target)
        lines.append(release_line)
        lines.append("{target} = {deep_copy_code(field_type, source)};")
        index = index + 1
    }
    if remembers {
        lines.append("if (spite_opened) spite_copy_table_close();")
    }
    lines.append("return copied;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    note_support_slot(information, "'s deep copy")
    builder.add_support(joined_lines)
    return function_c_name
}

# ../../../docs/memory.md#do-call-copydeep_copy-for-an-independent-object
func remembers_copies(information: Analysis.ClassInfo): Boolean {
    if reaching_classes.has(information.c_name) {
        var known = reaching_classes[information.c_name]
        crash known
        return known
    }
    var seen = List<String>()
    var pending = List<Analysis.SpiteType>()
    add_field_types(information, pending)
    var answer = weakly_held(information)
    while not pending.is_empty() and not answer {
        var next = pending.remove_last()
        crash next
        var reached = classes_in_type(next)
        var index = 0
        while index < reached.count() {
            var reached_class = reached[index]
            var held = weak_held_class(reached_class)
            if reached_class.c_name == information.c_name or held {
                answer = true
            } else if not seen.contains(reached_class.c_name) {
                seen.append(reached_class.c_name)
                add_field_types(reached_class, pending)
            }
            index = index + 1
        }
    }
    reaching_classes[information.c_name] = answer
    return answer
}

func weakly_held(information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < classes.count() {
        var held = weak_held_class(classes[index])
        if held {
            if held.c_name == information.c_name {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func add_field_types(information: Analysis.ClassInfo, pending: List<Analysis.SpiteType>) {
    assert not information.is_singleton
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        pending.append(field.type)
        index = index + 1
    }
}

func classes_in_type(spite_type: Analysis.SpiteType): List<Analysis.ClassInfo> {
    var found = List<Analysis.ClassInfo>()
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var referenced = find_class_by_c_name(class_ref.c_name)
        if referenced {
            found.append(referenced)
            var held = weak_held_class(referenced)
            if held {
                found.append(held)
            }
        }
        return found
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var referenced_union = find_union_by_c_name(union_type.c_name)
        if referenced_union {
            var member_index = 0
            while member_index < referenced_union.members.count() {
                found.append(referenced_union.members[member_index])
                member_index = member_index + 1
            }
        }
        return found
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        return classes_in_type(list_type.element)
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return classes_in_type(dictionary_type.element)
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        return classes_in_type(nullable.inner)
    }
    return found
}

func ensure_copy_table() {
    assert not copy_table_written
    copy_table_written = true
    builder.add_support(
        "typedef struct \{ void* from; void* to; } spite_copy_pair;\nstatic SPITE_THREAD_LOCAL spite_copy_pair* spite_copy_pairs = 0;\nstatic SPITE_THREAD_LOCAL uint64_t spite_copy_count = 0;\nstatic SPITE_THREAD_LOCAL uint64_t spite_copy_capacity = 0;\nstatic SPITE_THREAD_LOCAL bool spite_copy_open = false;\nstatic uint64_t spite_copy_slot(void* from, uint64_t capacity) \{ return (((uint64_t)(uintptr_t)from >> 4) * 11400714819323198485ull) & (capacity - 1); }\nstatic void* spite_copy_table_find(void* from) \{\nif (!spite_copy_open) return 0;\nuint64_t slot = spite_copy_slot(from, spite_copy_capacity);\nwhile (spite_copy_pairs[slot].from != 0) \{ if (spite_copy_pairs[slot].from == from) return spite_copy_pairs[slot].to; slot = (slot + 1) & (spite_copy_capacity - 1); }\nreturn 0;\n}\nstatic bool spite_copy_table_open(void) \{\nif (spite_copy_open) return false;\nspite_copy_capacity = 64;\nspite_copy_count = 0;\nspite_copy_pairs = (spite_copy_pair*)calloc(spite_copy_capacity, sizeof(spite_copy_pair));\nif (spite_copy_pairs == 0) \{ fprintf(stderr, \"spite: out of memory remembering the objects of a deep copy\\n\"); abort(); }\nspite_copy_open = true;\nreturn true;\n}\nstatic void spite_copy_table_add(void* from, void* to) \{\nif ((spite_copy_count + 1) * 2 > spite_copy_capacity) \{\nuint64_t old_capacity = spite_copy_capacity;\nspite_copy_pair* old_pairs = spite_copy_pairs;\nspite_copy_capacity = old_capacity * 2;\nspite_copy_pairs = (spite_copy_pair*)calloc(spite_copy_capacity, sizeof(spite_copy_pair));\nif (spite_copy_pairs == 0) \{ fprintf(stderr, \"spite: out of memory remembering the objects of a deep copy\\n\"); abort(); }\nfor (uint64_t index = 0; index < old_capacity; index = index + 1) \{\nif (old_pairs[index].from == 0) continue;\nuint64_t moved = spite_copy_slot(old_pairs[index].from, spite_copy_capacity);\nwhile (spite_copy_pairs[moved].from != 0) moved = (moved + 1) & (spite_copy_capacity - 1);\nspite_copy_pairs[moved] = old_pairs[index];\n}\nfree(old_pairs);\n}\nuint64_t slot = spite_copy_slot(from, spite_copy_capacity);\nwhile (spite_copy_pairs[slot].from != 0) slot = (slot + 1) & (spite_copy_capacity - 1);\nspite_copy_pairs[slot].from = from;\nspite_copy_pairs[slot].to = to;\nspite_copy_count = spite_copy_count + 1;\n}\nstatic SPITE_THREAD_LOCAL void (*spite_copy_closing)(void) = 0;\nstatic void spite_copy_table_close(void) \{\nif (spite_copy_closing != 0) spite_copy_closing();\nfree(spite_copy_pairs);\nspite_copy_pairs = 0;\nspite_copy_capacity = 0;\nspite_copy_count = 0;\nspite_copy_open = false;\n}",
    )
}

func weak_held_class(information: Analysis.ClassInfo): Analysis.ClassInfo? {
    assert information.qualified_dotted == "Weak" and information.codegen_types.count() == 1
    var held_type = information.codegen_types[0]
    var held_ref = type_shape.as_class_ref(held_type)
    assert held_ref
    return find_class_by_c_name(held_ref.c_name)
}

# ../../../docs/memory.md#do-call-copydeep_copy-for-an-independent-object
func ensure_weak_deep_copy(information: Analysis.ClassInfo, held: Analysis.ClassInfo): String {
    var function_c_name = "{information.c_name}___deep_copy"
    if deep_copy_names.contains(function_c_name) {
        return function_c_name
    }
    deep_copy_names.append(function_c_name)
    ensure_weak_runtime(held.c_name)
    ensure_copy_table()
    ensure_weak_copy_pending()
    builder.add_prototype("{information.c_name}* {function_c_name}({information.c_name}* self);")
    var box = field_place("copied", information, "_box")
    var source = field_place("self", information, "_box")
    var lines = List<String>()
    lines.append("{information.c_name}* {function_c_name}({information.c_name}* self) \{")
    lines.append("if (self == 0) return 0;")
    lines.append("{information.c_name}* copied = {information.c_name}___allocate();")
    lines.append("void* spite_object = spite_weak_object({source});")
    lines.append("void* spite_moved = spite_copy_table_find(spite_object);")
    lines.append("if (spite_moved != 0) spite_object = spite_moved;")
    lines.append("else if (spite_object != 0 && spite_copy_open) spite_weak_copy_wait(&{box}, spite_object);")
    lines.append("{box} = spite_weak_box_of(spite_object);")
    lines.append("return copied;")
    lines.append("}")
    var joined = lines.join("\n")
    builder.add_support(joined)
    return function_c_name
}

func ensure_weak_copy_pending() {
    assert not weak_copy_pending_written
    weak_copy_pending_written = true
    builder.add_support(
        "typedef struct \{ int64_t* box; void* object; } spite_weak_copy_entry;\nstatic SPITE_THREAD_LOCAL spite_weak_copy_entry* spite_weak_copies = 0;\nstatic SPITE_THREAD_LOCAL int64_t spite_weak_copy_count = 0;\nstatic SPITE_THREAD_LOCAL int64_t spite_weak_copy_capacity = 0;\nstatic void spite_weak_copies_settle(void) \{\nfor (int64_t index = 0; index < spite_weak_copy_count; index = index + 1) \{\nvoid* moved = spite_copy_table_find(spite_weak_copies[index].object);\nif (moved == 0) continue;\nint64_t old_box = *spite_weak_copies[index].box;\n*spite_weak_copies[index].box = spite_weak_box_of(moved);\nspite_weak_box_release(old_box);\n}\nfree(spite_weak_copies);\nspite_weak_copies = 0;\nspite_weak_copy_count = 0;\nspite_weak_copy_capacity = 0;\nspite_copy_closing = 0;\n}\nstatic void spite_weak_copy_wait(int64_t* box, void* object) \{\nif (spite_weak_copy_count == spite_weak_copy_capacity) \{\nspite_weak_copy_capacity = spite_weak_copy_capacity == 0 ? 16 : spite_weak_copy_capacity * 2;\nspite_weak_copies = (spite_weak_copy_entry*)realloc(spite_weak_copies, (size_t)spite_weak_copy_capacity * sizeof(spite_weak_copy_entry));\nif (spite_weak_copies == 0) \{ fprintf(stderr, \"spite: out of memory remembering the objects of a deep copy\\n\"); abort(); }\n}\nspite_weak_copies[spite_weak_copy_count].box = box;\nspite_weak_copies[spite_weak_copy_count].object = object;\nspite_weak_copy_count = spite_weak_copy_count + 1;\nspite_copy_closing = spite_weak_copies_settle;\n}",
    )
}

func ensure_list_deep_copy(element: Analysis.SpiteType): String {
    var list_name = ensure_list(element)
    var function_c_name = "{list_name}___deep_copy"
    if deep_copy_names.contains(function_c_name) {
        return function_c_name
    }
    deep_copy_names.append(function_c_name)
    builder.add_prototype("{list_name}* {function_c_name}({list_name}* self);")
    var item_code = list_item_code(element, "self", "spite_index")
    builder.add_support(
        "{list_name}* {function_c_name}({list_name}* self) \{\nif (self == 0) return 0;\n{list_name}* copied = {list_name}___make();\nfor (int64_t spite_index = 0; spite_index < self->item_count_; spite_index = spite_index + 1) \{ {list_name}_append(copied, {deep_copy_code(element, item_code)}); }\nreturn copied;\n}",
    )
    return function_c_name
}

func ensure_dictionary_deep_copy(dictionary: Analysis.Types.DictionaryType): String {
    var element = dictionary.element
    var dictionary_name = ensure_dictionary(dictionary)
    var function_c_name = "{dictionary_name}___deep_copy"
    if deep_copy_names.contains(function_c_name) {
        return function_c_name
    }
    deep_copy_names.append(function_c_name)
    builder.add_prototype("{dictionary_name}* {function_c_name}({dictionary_name}* self);")
    var key_type = dictionary.key
    var item_code = list_item_code(element, "self->entry_values_", "spite_index")
    var key_code = list_item_code(key_type, "self->entry_keys_", "spite_index")
    var kept_key = retain_call(key_type, key_code)
    builder.add_support(
        "{dictionary_name}* {function_c_name}({dictionary_name}* self) \{\nif (self == 0) return 0;\n{dictionary_name}* copied = {dictionary_name}___make();\nfor (int64_t spite_index = 0; spite_index < self->entry_keys_->item_count_; spite_index = spite_index + 1) \{ {dictionary_name}_set_at(copied, {kept_key}, {deep_copy_code(element, item_code)}); }\nreturn copied;\n}",
    )
    return function_c_name
}

func generate_list_literal(
    literal: Syntax.Expressions.ListLiteralExpression,
    element: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var list_name = ensure_list(element)
    var temporary = next_temporary()
    var lines = List<String>()
    lines.append("{list_name}* {temporary} = {list_name}___make();")
    var index = 0
    while index < literal.elements.count() {
        var element_ast = literal.elements[index].value
        crash element_ast
        lines.append(
            "{list_name}_append({temporary}, {coerce_for_store(element_ast, element, scope, class_information)});",
        )
        index = index + 1
    }
    lines.append("{temporary};")
    var list_type = list_type_of(element)
    return ExpressionResult("(\{ {lines.join(" ")} })", list_type)
}

# ../../../docs/collections.md#dictionarykey-value
func generate_dictionary_literal(
    literal: Syntax.Expressions.ObjectLiteralExpression,
    dictionary: Analysis.Types.DictionaryType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var made_type: Analysis.SpiteType = dictionary
    var element = dictionary.element
    var dictionary_name = ensure_dictionary(dictionary)
    var container = find_class_by_c_name(dictionary_name)
    crash container
    var setter = find_or_instantiate_function(container, "set_at")
    crash setter
    var temporary = next_temporary()
    var lines = List<String>()
    lines.append("{dictionary_name}* {temporary} = {dictionary_name}___make();")
    var written = List<String>()
    var index = 0
    while index < literal.fields.count() {
        var entry = literal.fields[index]
        crash entry.key
        crash entry.value
        if written.contains(entry.name) {
            report("{entry.name} is written twice in this dictionary: keep one entry for each key")
        }
        written.append(entry.name)
        var key_type = dictionary.key
        var key_code = coerce_for_store(entry.key, key_type, scope, class_information)
        var value_code = coerce_for_store(entry.value, element, scope, class_information)
        lines.append("{setter.c_name}({temporary}, {key_code}, {value_code});")
        index = index + 1
    }
    lines.append("{temporary};")
    return ExpressionResult("(\{ {lines.join(" ")} })", made_type)
}

func generate_untyped_dictionary_literal(
    literal: Syntax.Expressions.ObjectLiteralExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash literal.fields[0].value
    var saved_counter = temporary_counter
    var probe = generate_expression(literal.fields[0].value, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var key_type = literal_key_type(literal)
    var dictionary = Analysis.Types.DictionaryType(probe_type, key_type)
    return generate_dictionary_literal(literal, dictionary, scope, class_information)
}

func literal_key_type(literal: Syntax.Expressions.ObjectLiteralExpression): Analysis.SpiteType {
    var first = literal.fields.first()
    crash first
    if first.name.starts_with("\"") {
        return string_type()
    }
    return integer_type()
}

func generate_untyped_list_literal(
    literal: Syntax.Expressions.ListLiteralExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if literal.elements.is_empty() {
        report("an empty list literal needs a declared type")
        return void_result()
    }
    crash literal.elements[0].value
    var saved_counter = temporary_counter
    var probe = generate_expression(literal.elements[0].value, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    return generate_list_literal(literal, probe_type, scope, class_information)
}

func generate_generic_constructor(
    generic_call: Syntax.Expressions.GenericCallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash generic_call.callee
    if generic_call.names_class {
        report(
            "a generic class written without '(...)' names the class, which only the right side of '==' or '!=' reads: call it to make one",
        )
        return void_result()
    }
    var callee = shape.as_identifier(generic_call.callee)
    if callee {
        if callee.name == "Dictionary" and generic_call.type_arguments.count() == 2 {
            var written_dictionary = written_dictionary_type(
                generic_call.type_arguments[0],
                generic_call.type_arguments[1],
                class_information.qualified_dotted,
            )
            if written_dictionary {
                var written_type = type_shape.as_dictionary(written_dictionary)
                crash written_type
                return ExpressionResult("{ensure_dictionary(written_type)}___make()", written_dictionary)
            }
            return void_result()
        }
        if callee.name == "Dictionary" {
            var argument_count = generic_call.type_arguments.count()
            report_dictionary_arguments(argument_count)
            return void_result()
        }
        if callee.name == "List" and generic_call.type_arguments.count() == 1 {
            var element = resolve_generic_argument(generic_call.type_arguments[0], class_information.qualified_dotted)
            if element {
                var list_type = list_type_of(element)
                return ExpressionResult("{ensure_list(element)}___make()", list_type)
            }
        }
    }
    var generic_template = try_resolve_static_path(generic_call.callee, class_information.qualified_dotted)
    if generic_template {
        if generic_template.is_generic_template {
            var generic_class = instantiate_generic(
                generic_template,
                generic_call.type_arguments,
                class_information.qualified_dotted,
            )
            if generic_class {
                return generate_constructor_call(generic_class, generic_call.arguments, scope, class_information)
            }
            poison_statement()
            return void_result()
        }
        report(
            "'{generic_template.simple_name}' takes no codegen values: write '{generic_template.simple_name}(...)' without '<...>'",
        )
        poison_statement()
        return void_result()
    }
    var printer = Syntax.SourcePrinter()
    var callee_text = printer.source_expression(generic_call.callee)
    if reported_old_spelling(callee_text) {
        poison_statement()
        return void_result()
    }
    report(
        "there is no generic class '{callee_text}' here: a name is looked up in this class's own namespace, its folder, each parent folder, then the whole program",
    )
    poison_statement()
    return void_result()
}

func poison_statement() {
    statement_poisoned = true
}

func poisoned_key(name: String): String {
    return "{current_path}:{current_owner}.{current_function}:{name}"
}

func mentions_poisoned(statement: Syntax.Statements.Statement, names: List<String>): Boolean {
    if not poisoned_names.is_empty() {
        collect_statement_head_names(statement, names)
    }
    var index = 0
    while index < names.count() {
        var key = poisoned_key(names[index])
        if poisoned_names.contains(key) {
            return true
        }
        index = index + 1
    }
    return false
}

func collect_statement_head_names(statement: Syntax.Statements.Statement, names: List<String>) {
    switch statement {
        Syntax.Statements.IfStatement: collect_optional_names(statement.condition, names)
        Syntax.Statements.WhileStatement: collect_optional_names(statement.condition, names)
        Syntax.Statements.SwitchStatement: collect_optional_names(statement.subject, names)
        _: collect_statement_names(statement, names)
    }
}

func report_reads_in_template(statements: List<Syntax.Statements.Statement>) {
    var saved_line = current_line
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        current_line = statement_line(statement)
        report_reads_in_indices(statement)
        index = index + 1
    }
    current_line = saved_line
}

# ../../../docs/failure.md#an-index-reads-nothing
func report_reads_in_indices(statement: Syntax.Statements.Statement) {
    assert not walked_statement_places.has("{current_path}:{current_line}")
    switch statement {
        Syntax.Statements.VariableDeclaration: report_read_in_index(statement.value)
        Syntax.Statements.AssignmentStatement: {
            report_read_in_index(statement.target)
            report_read_in_index(statement.value)
        }
        Syntax.Statements.IfStatement: report_read_in_index(statement.condition)
        Syntax.Statements.WhileStatement: report_read_in_index(statement.condition)
        Syntax.Statements.SwitchStatement: report_read_in_index(statement.subject)
        Syntax.Statements.AssertStatement: report_read_in_index(statement.value)
        Syntax.Statements.ReturnStatement: report_read_in_index(statement.value)
        Syntax.Statements.ExpressionStatement: report_read_in_index(statement.value)
        _: return
    }
}

func report_read_in_index(expression: Syntax.Expressions.Expression?) {
    assert expression
    var outer = index_holding_read(expression)
    assert outer
    crash outer.object
    crash outer.index
    var inner = read_inside(outer.index)
    crash inner
    var printer = Syntax.SourcePrinter()
    var inner_text = printer.source_expression(inner)
    var object_text = printer.source_expression(outer.object)
    report(
        "'{inner_text}' is read inside the index of '{object_text}': compute it first into a named 'var' and pass the name",
    )
}

func index_holding_read(expression: Syntax.Expressions.Expression): Syntax.Expressions.IndexExpression? {
    var children = List<Syntax.Expressions.Expression>()
    switch expression {
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            if read_inside(expression.index) {
                return expression
            }
            children.append(expression.object)
            children.append(expression.index)
        }
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            children.append(expression.callee)
            expression.arguments.each(children.append)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            children.append(expression.callee)
            expression.arguments.each(children.append)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            children.append(expression.left)
            children.append(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            children.append(expression.operand)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            children.append(expression.object)
        }
        _: return null
    }
    var index = 0
    while index < children.count() {
        var found = index_holding_read(children[index])
        if found {
            return found
        }
        index = index + 1
    }
    return null
}

func read_inside(expression: Syntax.Expressions.Expression): Syntax.Expressions.IndexExpression? {
    switch expression {
        Syntax.Expressions.IndexExpression: return expression
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            var left_read = read_inside(expression.left)
            if left_read {
                return left_read
            }
            return read_inside(expression.right)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return read_inside(expression.operand)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return read_inside(expression.object)
        }
        _: return null
    }
}

func generate_index_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash index_expression.object
    crash index_expression.index
    var folded_entry = folded_dictionary_read(index_expression, scope, class_information)
    if folded_entry {
        return narrowed_reflection_read(folded_entry, index_expression, scope)
    }
    var reflected_read = reflected_field_read(index_expression, scope, class_information)
    if reflected_read {
        return generate_expression(reflected_read, scope, class_information)
    }
    var folded_index = folded_reflection(index_expression, scope, class_information)
    if folded_index {
        return narrowed_reflection_read(folded_index, index_expression, scope)
    }
    var named_read = named_reflection_read(index_expression, scope, class_information)
    if named_read {
        var named_result = generate_expression(named_read, scope, class_information)
        return narrowed_reflection_read(named_result, index_expression, scope)
    }
    if is_bound_member_index(index_expression) {
        return generate_bound_member_read(index_expression, scope, class_information)
    }
    if is_bound_attributes_index(index_expression) {
        crash bound_field_type
        mark_bound_attribute_read(class_information)
        var bound_place = field_place("self", class_information, bound_field_name)
        return ExpressionResult(bound_place, bound_field_type)
    }
    var walked_read_path = operand_text(index_expression)
    if not walked_read_paths.is_empty() and not walked_read_path.is_empty() {
        var walked_read = cached_walked_read(walked_read_path)
        if walked_read {
            return walked_read
        }
    }
    var counted_read = counted_item(index_expression.object, index_expression.index, scope, class_information)
    if not counted_read.is_empty() and reads_counted_item(index_expression, scope) {
        var counted_type = counted_item_type(index_expression.object, scope)
        return ExpressionResult(counted_read, counted_type)
    }
    var read_path = operand_text(index_expression)
    var proven = not read_path.is_empty() and scope.is_path_narrowed(read_path)
    var present = not read_path.is_empty() and scope.is_present_narrowed(read_path)
    var object_result = generate_expression(index_expression.object, scope, class_information)
    crash index_expression.object
    var uncounted_list = item_object_uncounted(
        index_expression.object,
        object_result,
        "get_at",
        true,
        scope,
        class_information,
    )
    if uncounted_list {
        object_result = uncounted_list
    }
    var arguments_ast = List<Syntax.Expressions.Expression>()
    arguments_ast.append(index_expression.index)
    var object_result_type = object_result.type
    var object_list = type_shape.as_list(object_result_type)
    if object_list {
        var element = object_list.element
        var unchecked = unchecked_item(object_result, index_expression, element, present, scope, class_information)
        if not unchecked.is_empty() {
            return ExpressionResult(unchecked, element)
        }
        var list_class = list_class_of(element)
        var reader = list_class.find_function("get_at")
        crash reader
        var integer_spite_type = integer_type()
        var single_types = one_type(integer_spite_type)
        var reader_type = element
        var declared_reader_type = reader.return_type
        if type_shape.as_nullable(declared_reader_type) {
            reader_type = nullable_type_of(element)
        }
        var read = generate_generic_call(
            reader.c_name,
            object_result,
            index_expression.object,
            arguments_ast,
            single_types,
            reader_type,
            scope,
            class_information,
        )
        var list_read = proven_read(read, element, proven, present, read_path)
        return noted_read(list_read, index_expression, object_result_type)
    }
    var indexed_class_ref = type_shape.as_class_ref(object_result_type)
    if indexed_class_ref {
        var indexed_class = find_class_by_c_name(indexed_class_ref.c_name)
        if indexed_class {
            var get_at = find_or_instantiate_function(indexed_class, "get_at")
            if get_at {
                var parameter_types = parameter_types_of(get_at.parameters)
                var get_at_return_type = get_at.return_type
                var got = generate_generic_call(
                    get_at.c_name,
                    object_result,
                    index_expression.object,
                    arguments_ast,
                    parameter_types,
                    get_at_return_type,
                    scope,
                    class_information,
                )
                got.owning_override = true
                lend_item(got, indexed_class, "get_at", index_expression.object)
                if is_library_collection(indexed_class) {
                    crash indexed_class.codegen_types[0]
                    var collection_read = proven_read(got, indexed_class.codegen_types[0], proven, present, read_path)
                    return noted_read(collection_read, index_expression, object_result_type)
                }
                var class_read = proven_item(got, present)
                return noted_read(class_read, index_expression, object_result_type)
            }
            report("indexing a '{indexed_class.simple_name}' needs it to define 'get_at(index)'")
            return void_result()
        }
    }
    var object_dictionary = type_shape.as_dictionary(object_result_type)
    if object_dictionary {
        var value_type = object_dictionary.element
        if proven and present and not type_is_reference(value_type) {
            var kept_value = scope.kept_read(read_path)
            if not kept_value.is_empty() {
                return ExpressionResult(kept_value, value_type)
            }
        }
        var key_parameter = dictionary_key_parameter(object_dictionary)
        var single_types = one_type(key_parameter)
        var nullable_type = nullable_type_of(value_type)
        var lookup = generate_generic_call(
            "{ensure_dictionary(object_dictionary)}_get_at",
            object_result,
            index_expression.object,
            arguments_ast,
            single_types,
            nullable_type,
            scope,
            class_information,
        )
        if not proven or not scope.is_present_narrowed(read_path) {
            return noted_read(lookup, index_expression, object_result_type)
        }
        var lookup_temporary = next_temporary()
        nullable_type = nullable_type_of(value_type)
        var lookup_declaration = "{c_type_name(nullable_type)} {lookup_temporary} = {lookup.code};"
        if type_is_reference(value_type) {
            return ExpressionResult(
                "(\{ {lookup_declaration} {present_code(lookup_temporary, value_type)} ? {lookup_temporary} : {default_value_for_type(value_type)}; })",
                value_type,
            )
        }
        return ExpressionResult(
            "(\{ {lookup_declaration} {lookup_temporary}.has_value ? {lookup_temporary}.value : {default_value_for_type(value_type)}; })",
            value_type,
        )
    }
    if type_shape.as_string(object_result_type) {
        report(
            "text is not indexed with [ ]: 'text.character_at(index)' gives one character and 'text.slice(start, end)' gives a piece",
        )
    } else {
        report(
            "{type_with_article(object_result_type)} is not indexed with [ ]: only a List<T> and a Dictionary<K, T> are",
        )
    }
    return void_result()
}

func narrowed_reflection_read(
    read: ExpressionResult,
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
): ExpressionResult {
    var read_path = operand_text(index_expression)
    if read_path.is_empty() or not scope.is_present_narrowed(read_path) {
        return read
    }
    return proven_item(read, true)
}

func proven_read(
    got: ExpressionResult,
    element: Analysis.SpiteType,
    proven: Boolean,
    present: Boolean,
    read_path: String,
): ExpressionResult {
    if type_shape.as_nullable(element) or present or not proven {
        return proven_item(got, present)
    }
    return bounded_item(got, read_path)
}

func ensure_index_check() {
    assert not index_check_written
    index_check_written = true
    builder.add_prototype(
        "static void spite_outside_list(const char* read, const char* where) __attribute__((noreturn, cold));",
    )
    builder.add_support(
        "static void spite_outside_list(const char* read, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: '%s' is outside its list: a bound proves only the top of an index, and this one is below 0 or the list changed, at %s\\n\", read, where);\nexit(1);\n}",
    )
}

func bounded_item(got: ExpressionResult, read_path: String): ExpressionResult {
    var got_type = got.type
    var nullable = type_shape.as_nullable(got_type)
    if not nullable {
        return got
    }
    var inner = nullable.inner
    ensure_index_check()
    var temporary = next_temporary()
    var where = located(current_path, current_line, current_owner, current_function)
    var read = escape_c_string(read_path)
    var declaration = "{c_type_name(got_type)} {temporary} = {got.code};"
    var halt = "spite_outside_list(\"{read}\", {where});"
    var code = "(\{ {declaration} if (__builtin_expect(!{temporary}.has_value, 0)) {halt} {temporary}.value; })"
    if type_is_reference(inner) {
        code = "(\{ {declaration} if (__builtin_expect(!({present_code(temporary, inner)}), 0)) {halt} {temporary}; })"
    }
    var bounded = ExpressionResult(code, inner)
    bounded.owning_override = got.owning_override
    bounded.borrowed_from = got.borrowed_from
    return bounded
}

# ../../../docs/proofs.md#a-proven-count-or-bound-proves-a-read-of-a-width
func is_byte_access(name: String): Boolean {
    return name == "append_bytes" or byte_access_width(name) > 0
}

func byte_access_width(name: String): Integer {
    var name_length = name.length()
    var word = ""
    if name.starts_with("read_") {
        word = name.slice(5, name_length)
    } else if name.starts_with("write_") {
        word = name.slice(6, name_length)
    } else if name.starts_with("append_") {
        word = name.slice(7, name_length)
    } else {
        return 0
    }
    var big_endian = word.ends_with("_big_endian")
    if big_endian {
        var word_length = word.length()
        word = word.slice(0, word_length - 11)
    }
    if word == "tiny" and not big_endian {
        return 1
    }
    if word == "short" or word == "unsigned_short" {
        return 2
    }
    if word == "integer" or word == "unsigned_integer" or word == "float" {
        return 4
    }
    if word == "long" or word == "unsigned_long" or word == "double" {
        return 8
    }
    return 0
}

func is_byte_element(element: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(element)
    if not scalar {
        return false
    }
    return scalar.kind == 'byte_kind'
}

func proven_byte_access(
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert not name.starts_with("append_")
    var width = byte_access_width(name)
    var position_ast = arguments_ast.first()
    assert position_ast
    var listed = shape.as_identifier(object_ast)
    assert listed
    var list_text = listed.name
    var counted_base = counted_byte_items(list_text, position_ast, width, scope)
    var counted = not counted_base.is_empty()
    var writing = name.starts_with("write_")
    assert counted or not writing
    var bottom = counted or byte_range_proven(list_text, position_ast, width, scope)
    var top_key = byte_key(list_text, position_ast, width - 1)
    assert bottom or scope.is_path_narrowed(top_key)
    var address_class = find_class_by_qualified("Memory.Address")
    assert address_class
    var primitive = find_or_instantiate_function(address_class, name)
    assert primitive
    if counted {
        var position = counted_position(position_ast, scope, class_information)
        var base = "(intptr_t)({counted_base})"
        if writing {
            crash arguments_ast[1]
            crash primitive.parameters[1]
            var value_type = primitive.parameters[1].type
            var value = coerce_for_store(arguments_ast[1], value_type, scope, class_information)
            var nothing = void_type()
            return ExpressionResult("{primitive.c_name}({base}, {position}, {value})", nothing)
        }
        var counted_type = primitive.return_type
        return ExpressionResult("{primitive.c_name}({base}, {position})", counted_type)
    }
    var read_type = primitive.return_type
    var integer_spite_type = integer_type()
    var position = coerce_for_store(position_ast, integer_spite_type, scope, class_information)
    var held = next_temporary()
    var written = Syntax.SourcePrinter().source_expression(position_ast)
    var read_text = "{list_text}.{name}({written})"
    var outside = "{held} > ({object_result.code})->item_count_ - {width}"
    if not bottom {
        outside = "{held} < 0 || {outside}"
    }
    var item = "{primitive.c_name}(({object_result.code})->items_, {held})"
    var checked = halting_read(held, position, outside, read_text, item)
    return ExpressionResult(checked, read_type)
}

func counted_position(
    position_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var integer_spite_type = integer_type()
    var stepped = shape.as_binary(position_ast)
    var counter: Syntax.Expressions.IdentifierExpression? = null
    var step: Syntax.Expressions.IntegerLiteral? = null
    if stepped {
        if stepped.operator == 'add' and stepped.left and stepped.right {
            counter = shape.as_identifier(stepped.left)
            step = shape.as_integer_literal(stepped.right)
        }
    }
    if not counter or not step {
        return coerce_for_store(position_ast, integer_spite_type, scope, class_information)
    }
    var counter_ast: Syntax.Expressions.Expression = counter
    var counter_result = generate_expression(counter_ast, scope, class_information)
    return "{counter_result.code} + {step.value}"
}

func halting_read(held: String, position: String, outside: String, read_text: String, item: String): String {
    ensure_index_check()
    var where = located(current_path, current_line, current_owner, current_function)
    var read = escape_c_string(read_text)
    var halt = "spite_outside_list(\"{read}\", {where});"
    return "(\{ int32_t {held} = {position}; if (__builtin_expect({outside}, 0)) {halt} {item}; })"
}

func unchecked_item(
    object_result: ExpressionResult,
    index_expression: Syntax.Expressions.IndexExpression,
    element: Analysis.SpiteType,
    present: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if present or not type_shape.as_scalar(element) {
        return ""
    }
    crash index_expression.object
    crash index_expression.index
    var listed = shape.as_identifier(index_expression.object)
    if not listed {
        return ""
    }
    if not byte_range_proven(listed.name, index_expression.index, 1, scope) {
        return ""
    }
    var integer_spite_type = integer_type()
    var position = coerce_for_store(index_expression.index, integer_spite_type, scope, class_information)
    var element_code = c_type_name(element)
    var held = next_temporary()
    var outside = "{held} >= ({object_result.code})->item_count_"
    var item = "(({element_code}*)(intptr_t)({object_result.code})->items_)[{held}]"
    var read_text = operand_text(index_expression)
    return halting_read(held, position, outside, read_text, item)
}

func counted_byte_items(
    list_text: String,
    position_ast: Syntax.Expressions.Expression,
    width: Integer,
    scope: Scope,
): String {
    var first_key = byte_key(list_text, position_ast, 0)
    var first = scope.counted_items_of(first_key)
    if first.is_empty() {
        return ""
    }
    var last_key = byte_key(list_text, position_ast, width - 1)
    var last = scope.counted_items_of(last_key)
    if last.is_empty() {
        return ""
    }
    return first
}

func byte_key(list_text: String, position_ast: Syntax.Expressions.Expression, offset: Integer): String {
    return "{list_text}[{offset_key(position_ast, offset)}]"
}

func offset_key(position_ast: Syntax.Expressions.Expression, offset: Integer): String {
    if offset == 0 {
        return index_key_text(position_ast)
    }
    var literal = shape.as_integer_literal(position_ast)
    if literal {
        var moved_literal: Syntax.Expressions.Expression = Syntax.Expressions.IntegerLiteral(literal.value + offset)
        return index_key_text(moved_literal)
    }
    var stepped = shape.as_binary(position_ast)
    if stepped {
        if stepped.operator == 'add' and stepped.right and stepped.left {
            var step = shape.as_integer_literal(stepped.right)
            if step {
                var moved: Syntax.Expressions.Expression = Syntax.Expressions.IntegerLiteral(step.value + offset)
                var shifted: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression(
                    'add',
                    stepped.left,
                    moved,
                )
                return index_key_text(shifted)
            }
        }
    }
    var added: Syntax.Expressions.Expression = Syntax.Expressions.IntegerLiteral(offset)
    var reached: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression('add', position_ast, added)
    return index_key_text(reached)
}

func byte_range_proven(
    list_text: String,
    position_ast: Syntax.Expressions.Expression,
    width: Integer,
    scope: Scope,
): Boolean {
    if strided_range_proven(list_text, position_ast, width, scope) {
        return true
    }
    var top_key = byte_key(list_text, position_ast, width - 1)
    if not scope.is_path_narrowed(top_key) {
        return false
    }
    return never_below_zero(position_ast, scope)
}

func never_below_zero(position_ast: Syntax.Expressions.Expression, scope: Scope): Boolean {
    var literal = shape.as_integer_literal(position_ast)
    if literal {
        return literal.value >= 0
    }
    var stepped = shape.as_binary(position_ast)
    if stepped {
        if stepped.operator != 'add' or not stepped.right or not stepped.left {
            return false
        }
        var step = shape.as_integer_literal(stepped.right)
        if not step {
            return false
        }
        return step.value >= 0 and never_below_zero(stepped.left, scope)
    }
    var text = operand_text(position_ast)
    if text.is_empty() {
        return false
    }
    if never_negative_names["{current_function_c_name}/{text}"] {
        return true
    }
    return scope.proven_inside_loop("~0[{text}]")
}

func strided_range_proven(
    list_text: String,
    position_ast: Syntax.Expressions.Expression,
    width: Integer,
    scope: Scope,
): Boolean {
    var reach = width - 1
    var inner = position_ast
    var peeled = shape.as_binary(position_ast)
    if peeled {
        if peeled.operator == 'add' and peeled.right and peeled.left {
            var tail = shape.as_integer_literal(peeled.right)
            if tail {
                if tail.value < 0 or tail.value > 4096 {
                    return false
                }
                var tail_value: Integer = tail.value
                reach = reach + tail_value
                inner = peeled.left
            }
        }
    }
    var outer = shape.as_binary(inner)
    if not outer {
        return false
    }
    var column_ast: Syntax.Expressions.Expression? = null
    var product_ast = inner
    if outer.operator == 'add' {
        column_ast = outer.right
        if not outer.left {
            return false
        }
        product_ast = outer.left
    }
    var product = shape.as_binary(product_ast)
    if not product {
        return false
    }
    var row_ast = product.left
    var stride_ast = product.right
    if product.operator != 'multiply' or not row_ast or not stride_ast {
        return false
    }
    var row = shape.as_identifier(row_ast)
    var stride = index_key_text(stride_ast)
    if not row or stride.is_empty() {
        return false
    }
    var height = narrowed_counter_bound(row.name, 0, scope)
    if height.is_empty() {
        return false
    }
    var guarded = scope.is_path_narrowed("{list_text}[<*{height}*{stride}]")
    if not guarded and not scope.is_path_narrowed("{list_text}[<*{stride}*{height}]") {
        return false
    }
    if not column_ast {
        var stride_literal = shape.as_integer_literal(stride_ast)
        if not stride_literal {
            return false
        }
        return stride_literal.value > reach
    }
    var column = shape.as_identifier(column_ast)
    if not column {
        return false
    }
    return narrowed_counter_bound(column.name, reach, scope) == stride
}

func narrowed_counter_bound(counter: String, reach: Integer, scope: Scope): String {
    var prefix = "~<[{counter}:"
    var paths = scope.visible_narrowed_paths()
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        if path.starts_with(prefix) and path.ends_with("]") {
            var path_length = path.length()
            var parts = path.slice(3, path_length - 1).split(":")
            if parts.count() == 3 {
                var kept = parts[1].to_integer()
                if kept and kept >= reach and scope.is_path_narrowed(path) {
                    return parts[2]
                }
            }
        }
        index = index + 1
    }
    return ""
}

func library_list_field(
    list_type: Analysis.SpiteType,
    name: String,
    class_information: Analysis.ClassInfo,
): Analysis.FieldInfo? {
    assert current_path.starts_with("library/") or is_library_class(class_information)
    var listed = type_shape.as_list(list_type)
    assert listed
    var element = listed.element
    return list_class_of(element).find_field(name)
}

func is_library_collection(information: Analysis.ClassInfo): Boolean {
    var named = information.qualified_dotted
    var collection = named == "Vector" or named == "Items"
    return collection and not information.codegen_types.is_empty()
}

func proven_item(got: ExpressionResult, proven: Boolean): ExpressionResult {
    var got_type = got.type
    var nullable = type_shape.as_nullable(got_type)
    if not proven {
        return got
    }
    if nullable {
        var inner = nullable.inner
        if type_is_reference(inner) {
            got.spite_type = inner
            return got
        }
        var unwrapped = ExpressionResult("({got.code}).value", inner)
        unwrapped.owning_override = got.owning_override
        unwrapped.borrowed_from = got.borrowed_from
        return unwrapped
    }
    return got
}

func ensure_list(element: Analysis.SpiteType): String {
    var list_name = "List_{type_label(element)}"
    if list_names.contains(list_name) {
        if optimization_report.recording {
            optimization_report.list_used(list_name, current_function_c_name, current_path, current_line)
        }
        return list_name
    }
    list_names.append(list_name)
    if optimization_report.recording {
        optimization_report.list_by_reference(element, list_name, current_function_c_name, current_path, current_line)
    }
    var list_template = find_class_by_qualified("List")
    if not list_template {
        report("List needs the standard library: library/list.spite was not found from the working directory")
        return list_name
    }
    var list_class = instantiated_container(list_template, element, list_name)
    supply_list_functions(list_class, element)
    return list_name
}

func instantiated_container(
    template: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    label: String,
): Analysis.ClassInfo {
    var types = List<Analysis.SpiteType>()
    types.append(element)
    var codes = List<String>()
    codes.append("")
    var texts = List<String>()
    texts.append("")
    var container = instantiated_with(template, types, codes, texts, label)
    container.is_container = true
    return container
}

func list_class_of(element: Analysis.SpiteType): Analysis.ClassInfo {
    var ensured_list = ensure_list(element)
    var list_class = find_class_by_c_name(ensured_list)
    crash list_class
    return list_class
}

func list_function(element: Analysis.SpiteType, name: String): String {
    var function = list_class_of(element).find_function(name)
    crash function
    return function.c_name
}

func list_item_code(element: Analysis.SpiteType, list_code: String, index_code: String): String {
    return "(({c_type_name(element)}*)(intptr_t)({list_code})->items_)[{index_code}]"
}

func supply_list_functions(list_class: Analysis.ClassInfo, element: Analysis.SpiteType) {
    var comparable = type_shape.as_string(element) or type_shape.is_symbol(element) or is_enum_type(element) or type_shape.as_scalar(element)
    var kept = List<Analysis.FunctionInfo>()
    var index = 0
    while index < list_class.declared_functions.count() {
        var function = list_class.declared_functions[index]
        var compares = function.name == "contains" or function.name == "index_of"
        var unsupported = compares and not comparable or function.name == "join" and not joins_as_text(element)
        if not unsupported {
            kept.append(function)
        }
        index = index + 1
    }
    list_class.declared_functions = kept
}

func supply_concurrency_functions(instance: Analysis.ClassInfo) {
    builder.threads = true
    note_fact("flag threads")
    if instance.qualified_dotted == "Parallel" {
        parallel_used = true
        note_fact("flag parallel_used")
    }
    if instance.qualified_dotted == "Concurrent" {
        use_scheduler()
        note_fact("flag scheduler_used")
    }
}

func use_scheduler() {
    if not scheduler_used {
        builder.add_typedef(
            "typedef struct SpiteFrame \{ bool (*step)(void*); int32_t state; int32_t flags; void* work; } SpiteFrame;",
        )
        builder.add_typedef(
            "#define SPITE_SUSPEND(point) do \{ spite_frame->spite_head.state = (point); return false; } while (0)",
        )
    }
    scheduler_used = true
}

func ensure_dictionary(dictionary: Analysis.Types.DictionaryType): String {
    var element = dictionary.element
    var key_type = dictionary.key
    var dictionary_name = "Dictionary_{type_label(element)}{dictionary_key_suffix(dictionary)}"
    if dictionary_names.contains(dictionary_name) {
        return dictionary_name
    }
    dictionary_names.append(dictionary_name)
    var dictionary_template = find_class_by_qualified("Dictionary")
    if not dictionary_template {
        report(
            "Dictionary needs the standard library: library/dictionary.spite was not found from the working directory",
        )
        return dictionary_name
    }
    var types = dictionary_codegen_types(dictionary_template, element, key_type)
    var codes = ["", ""]
    var texts = ["", ""]
    var container = instantiated_with(dictionary_template, types, codes, texts, dictionary_name)
    container.is_container = true
    return dictionary_name
}

func dictionary_key_suffix(dictionary: Analysis.Types.DictionaryType): String {
    var key_type = dictionary.key
    var suffix = ""
    if not type_shape.as_string(key_type) {
        suffix = "_by_{type_label(key_type)}"
    }
    return suffix
}

func dictionary_codegen_types(
    template: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    key_type: Analysis.SpiteType,
): List<Analysis.SpiteType> {
    var types = List<Analysis.SpiteType>()
    if template.codegen_names.first() == "key_type" {
        types.append(key_type)
        types.append(element)
    } else {
        types.append(element)
        types.append(key_type)
    }
    return types
}

func fixed_dictionary_type(information: Analysis.ClassInfo): Analysis.SpiteType {
    var value_index = codegen_index(information, "value_type")
    var key_index = codegen_index(information, "key_type")
    crash information.codegen_types[value_index]
    crash information.codegen_types[key_index]
    return Analysis.Types.DictionaryType(information.codegen_types[value_index], information.codegen_types[key_index])
}

func whole_number_rank(spite_type: Analysis.SpiteType): Integer {
    var scalar = type_shape.as_scalar(spite_type)
    var rank = -1
    if scalar {
        var ranked: List<Analysis.Types.NumericKind> = [
            'tiny_kind'
            'byte_kind'
            'short_kind'
            'unsigned_short_kind'
            'integer_kind'
            'unsigned_integer_kind'
            'long_kind'
            'unsigned_long_kind'
        ]
        var position = 0
        while position < ranked.count() {
            if ranked[position] == scalar.kind {
                rank = position
            }
            position = position + 1
        }
    }
    return rank
}

func is_whole_number_type(spite_type: Analysis.SpiteType): Boolean {
    return whole_number_rank(spite_type) >= 0
}

func dictionary_key_parameter(dictionary: Analysis.Types.DictionaryType): Analysis.SpiteType {
    return dictionary.key
}

func nullable_type_of(inner: Analysis.SpiteType): Analysis.SpiteType {
    if type_shape.as_nullable(inner) {
        return inner
    }
    return Analysis.Types.NullableType(inner)
}

func generate_dictionary_method(
    dictionary: Analysis.Types.DictionaryType,
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var element = dictionary.element
    if name.starts_with("remove_where") {
        report(
            "Dictionary has no method '{name}': the templates read a dictionary's values from a copy, so removing from it would change nothing; remove each key with 'remove(key)'",
        )
        return void_result()
    }
    var dictionary_name = ensure_dictionary(dictionary)
    if is_function_form(name, arguments_ast) {
        var empty_types = no_types()
        var list_type = list_type_of(element)
        var no_arguments = List<Syntax.Expressions.Expression>()
        var form_values = generate_generic_call(
            "{dictionary_name}_values",
            object_result,
            object_ast,
            no_arguments,
            empty_types,
            list_type,
            scope,
            class_information,
        )
        form_values.owning_override = true
        var form_list = list_class_of(element)
        var form_argument = arguments_ast.first()
        return generate_function_form(
            form_list,
            element,
            name,
            form_values,
            object_ast,
            form_argument,
            scope,
            class_information,
        )
    }
    if name == "set_at" {
        var key_parameter = dictionary_key_parameter(dictionary)
        var pair_types = two_types(key_parameter, element)
        var void_spite_type = void_type()
        return generate_generic_call(
            "{dictionary_name}_set_at",
            object_result,
            object_ast,
            arguments_ast,
            pair_types,
            void_spite_type,
            scope,
            class_information,
        )
    }
    if name == "get_at" {
        var key_parameter = dictionary_key_parameter(dictionary)
        var single_types = one_type(key_parameter)
        var nullable_type = nullable_type_of(element)
        return generate_generic_call(
            "{dictionary_name}_get_at",
            object_result,
            object_ast,
            arguments_ast,
            single_types,
            nullable_type,
            scope,
            class_information,
        )
    }
    if name == "deep_copy" {
        var ensured_dictionary_deep_copy = ensure_dictionary_deep_copy(dictionary)
        var empty_types = no_types()
        var dictionary_type: Analysis.SpiteType = dictionary
        var copied_dictionary = generate_generic_call(
            ensured_dictionary_deep_copy,
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            dictionary_type,
            scope,
            class_information,
        )
        copied_dictionary.owning_override = true
        return copied_dictionary
    }
    if name == "copy" {
        var empty_types = no_types()
        var dictionary_type: Analysis.SpiteType = dictionary
        var shared_dictionary = generate_generic_call(
            "{dictionary_name}_copy",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            dictionary_type,
            scope,
            class_information,
        )
        shared_dictionary.owning_override = true
        return shared_dictionary
    }
    if name == "has" {
        var key_parameter = dictionary_key_parameter(dictionary)
        var single_types = one_type(key_parameter)
        var boolean_spite_type = boolean_type()
        return generate_generic_call(
            "{dictionary_name}_has",
            object_result,
            object_ast,
            arguments_ast,
            single_types,
            boolean_spite_type,
            scope,
            class_information,
        )
    }
    if name == "remove" {
        var key_parameter = dictionary_key_parameter(dictionary)
        var single_types = one_type(key_parameter)
        var void_spite_type = void_type()
        return generate_generic_call(
            "{dictionary_name}_remove",
            object_result,
            object_ast,
            arguments_ast,
            single_types,
            void_spite_type,
            scope,
            class_information,
        )
    }
    if name == "count" {
        var empty_types = no_types()
        var integer_spite_type = integer_type()
        var counted = generate_generic_call(
            "{dictionary_name}_count",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            integer_spite_type,
            scope,
            class_information,
        )
        integer_spite_type = integer_type()
        return ExpressionResult("((int32_t)({counted.code}))", integer_spite_type)
    }
    if name == "keys" {
        var empty_types = no_types()
        var key_type = dictionary.key
        var list_type = list_type_of(key_type)
        return generate_generic_call(
            "{dictionary_name}_keys",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            list_type,
            scope,
            class_information,
        )
    }
    if name == "values" {
        var empty_types = no_types()
        var list_type = list_type_of(element)
        return generate_generic_call(
            "{dictionary_name}_values",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            list_type,
            scope,
            class_information,
        )
    }
    var dictionary_class = find_class_by_c_name(dictionary_name)
    crash dictionary_class
    var template = element_template_of(dictionary_class, name)
    if not template {
        report("Dictionary has no method '{name}'")
        return void_result()
    }
    var function = instantiate_element_template(dictionary_class, element, template, name, class_information)
    if not function {
        return void_result()
    }
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.return_type
    return generate_generic_call(
        function.c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func release_statement(spite_type: Analysis.SpiteType, code: String): String {
    if type_needs_drop(spite_type) {
        return "{release_call(spite_type, code)};"
    }
    return ""
}

func joins_as_text(element: Analysis.SpiteType): Boolean {
    return type_shape.as_string(element) or type_shape.is_symbol(element) or type_shape.as_scalar(element) or is_enum_type(element)
}

func crash_operand_statement(
    expression_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var generated_expression = generate_expression(expression_ast, scope, class_information)
    var result = as_text(generated_expression)
    var result_type = result.type
    var temporary = next_temporary()
    var written = "fwrite(spite_string_bytes(&{temporary}), 1, (size_t)spite_string_length({temporary}), stderr);"
    if crash_values_bounded {
        written = "spite_crash_text(spite_string_bytes(&{temporary}), spite_string_length({temporary}));"
    }
    if type_shape.as_string(result_type) {
        var release_line = ""
        if owns(result, expression_ast) {
            release_line = " SpiteString___release({temporary});"
        }
        return "\{ SpiteString {temporary} = {result.code}; {written}{release_line} }"
    }
    var converted = string_conversion(result.code, result_type)
    return "\{ SpiteString {temporary} = {converted}; {written} SpiteString___release({temporary}); }"
}

func collect_static_segments(expression: Syntax.Expressions.Expression, out: List<String>): Boolean {
    var identifier = shape.as_identifier(expression)
    if identifier {
        out.append(identifier.name)
        return true
    }
    var member = shape.as_member(expression)
    if member {
        crash member.object
        var ok = collect_static_segments(member.object, out)
        if not ok {
            return false
        }
        out.append(member.name)
        return true
    }
    return false
}

func try_resolve_static_path(
    expression: Syntax.Expressions.Expression,
    current_namespace: String,
): Analysis.ClassInfo? {
    var segments = List<String>()
    var ok = collect_static_segments(expression, segments)
    assert ok
    var joined = segments.join(".")
    return find_class(joined, current_namespace)
}

func member_object_in_frame(
    object_ast: Syntax.Expressions.Expression,
    function_name: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var framed = receiver_in_frame(object_ast, function_name, scope, class_information)
    if framed {
        return framed
    }
    return generate_member_object(object_ast, scope, class_information)
}

func operand_in_frame(
    operand_ast: Syntax.Expressions.Expression,
    function_name: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var framed = receiver_in_frame(operand_ast, function_name, scope, class_information)
    if framed {
        return framed
    }
    return generate_joined(operand_ast, scope, class_information)
}

func generate_member_object(
    object_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var static_class = try_resolve_static_path(object_ast, class_information.qualified_dotted)
    if static_class {
        var class_type = class_type_of(static_class)
        var class_object_code = class_object_call(class_type)
        var class_object_type = spite_class_type()
        var class_object = ExpressionResult(class_object_code, class_object_type)
        class_object.owning_override = true
        return class_object
    }
    var codegen_class = codegen_class_object(object_ast, class_information)
    if codegen_class {
        return codegen_class
    }
    return generate_expression(object_ast, scope, class_information)
}

func codegen_class_object(
    object_ast: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var generic_identifier = shape.as_generic_identifier(object_ast)
    assert generic_identifier
    var bare_name = without_dollar(generic_identifier.name)
    var bound = codegen_index(class_information, bare_name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    crash class_information.codegen_types[bound]
    var class_object_code = class_object_call(class_information.codegen_types[bound])
    var class_object_type = spite_class_type()
    var class_object = ExpressionResult(class_object_code, class_object_type)
    class_object.owning_override = true
    return class_object
}

func as_text(result: ExpressionResult): ExpressionResult {
    var result_type = result.type
    if not type_shape.is_symbol(result_type) {
        return result
    }
    var string_spite_type = string_type()
    var text = ExpressionResult(result.code, string_spite_type)
    text.owning_override = result.owning_override
    return text
}

func ensure_symbol(name: String): String {
    note_fact("symbol {name}")
    if symbol_positions.has(name) {
        crash symbol_positions[name]
        return "spite_symbol_{symbol_positions[name]}"
    }
    var position = symbol_names.count()
    symbol_names.append(name)
    symbol_positions[name] = position
    var initializer = "SPITE_STATIC_STRING(\"{escape_c_string(name)}\", {name.length()})"
    if name.length() <= 15 {
        initializer = inline_text_initializer(name)
    }
    builder.add_typedef("static SpiteString spite_symbol_{position} = {initializer};")
    constant_texts["spite_symbol_{position}"] = name
    return "spite_symbol_{position}"
}

func inline_text_initializer(text: String): String {
    var length = text.length()
    var low = ""
    var high = byte_hex(15 - length)
    var index = 7
    while index >= 0 {
        low = "{low}{hex_byte(text, index, length)}"
        if index > 0 {
            high = "{high}{hex_byte(text, index + 7, length)}"
        }
        index = index - 1
    }
    return "\{ (int64_t)0x{low}ULL, (int64_t)0x{high}ULL }"
}

func hex_byte(text: String, index: Integer, length: Integer): String {
    if index >= length {
        return "00"
    }
    var code = text.code_at(index)
    return byte_hex(code)
}

func byte_hex(code: Integer): String {
    var alphabet = "0123456789abcdef"
    var high = code / 16
    var low = code % 16
    return "{alphabet.slice(high, high + 1)}{alphabet.slice(low, low + 1)}"
}

func generate_symbol_lookup(
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if arguments_ast.count() != 1 {
        report("Symbol(text) takes the text to look up, and nothing else")
        return void_result()
    }
    if not symbol_lookup_used {
        builder.add_prototype("SpiteString spite_symbol_find(SpiteString text);")
    }
    symbol_lookup_used = true
    note_fact("flag symbol_lookup_used")
    var string_spite_type = string_type()
    var single_types = one_type(string_spite_type)
    var text_code = generate_argument_list(arguments_ast, single_types, scope, class_information)
    crash text_code.count() == 1
    var symbol_type = Analysis.Types.SymbolType()
    var nullable_type = nullable_type_of(symbol_type)
    return ExpressionResult("spite_symbol_find({text_code[0]})", nullable_type)
}

func emit_symbol_table() {
    assert symbol_lookup_used
    var entries = List<String>()
    var index = 0
    while index < symbol_names.count() {
        entries.append("&spite_symbol_{index}")
        index = index + 1
    }
    entries.append("0")
    builder.add_support(
        "static SpiteString* spite_symbol_table[] = \{ {entries.join(", ")} };\nSpiteString spite_symbol_find(SpiteString text) \{\nSpiteString found = SPITE_STRING_NULL;\nfor (int64_t index = 0; spite_symbol_table[index] != 0; index = index + 1) \{\nif (SpiteString_equals(text, *spite_symbol_table[index])) \{ found = *spite_symbol_table[index]; break; }\n}\nSpiteString___release(text);\nreturn found;\n}",
    )
}

func generate_library_constructor(arguments_ast: List<Syntax.Expressions.Expression>): ExpressionResult {
    var shape_of_call = "DynamicLibrary(...) takes three literals the compiler reads while it compiles: the file, the naming rule ('identity', 'windows' or 'camel_case') and the header"
    if arguments_ast.count() != 3 {
        report(shape_of_call)
        return void_result()
    }
    var file = shape.as_string_literal(arguments_ast[0])
    var naming = shape.as_enum_literal(arguments_ast[1])
    var header = shape.as_string_literal(arguments_ast[2])
    if not file or not naming or not header {
        report(shape_of_call)
        return void_result()
    }
    var file_segments = file.value.replace("\\", "/").split("/")
    var file_leaf = file_segments.last()
    crash file_leaf
    if not file_leaf.contains(".") {
        report(
            "'{file.value}' has no extension: name the library file exactly as it is on disk, like \"user32.dll\" or \"libc.so.6\" (a wrapper for another platform names that platform's file)",
        )
    }
    if naming.value != "identity" and naming.value != "windows" and naming.value != "camel_case" {
        report(
            "'{naming.value}' is not a naming rule: a library's functions are named 'identity', 'windows' or 'camel_case'",
        )
    }
    var library = 0
    while library < foreign_library_files.count() {
        crash library < foreign_library_namings.count()
        crash library < foreign_library_headers.count()
        var same_file = foreign_library_files[library] == file.value
        if same_file and foreign_library_namings[library] == naming.value and foreign_library_headers[library] == header.value {
            return library_value(library)
        }
        library = library + 1
    }
    foreign_library_files.append(file.value)
    foreign_library_namings.append(naming.value)
    foreign_library_headers.append(header.value)
    var accessor = "spite_foreign_library_{library}"
    builder.add_typedef("static DynamicLibrary* {accessor}_cache = 0;")
    builder.add_typedef("static bool {accessor}_tracked = false;")
    builder.add_prototype("DynamicLibrary* {accessor}(void);")
    return library_value(library)
}

func library_value(library: Integer): ExpressionResult {
    var library_type = Analysis.Types.ClassRefType("DynamicLibrary")
    library_type.foreign_library = library
    var value = ExpressionResult("spite_foreign_library_{library}()", library_type)
    value.owning_override = true
    return value
}

func declared_by_dynamic_library(name: String): Boolean {
    var library_class = find_class_by_c_name("DynamicLibrary")
    if not library_class {
        return false
    }
    var declared = library_class.find_function(name)
    if declared {
        return true
    }
    return false
}

func generate_foreign_call(
    foreign: Analysis.Types.ClassRefType,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    member_name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if foreign.foreign_library < 0 {
        report(
            "a foreign function is called through the attribute or variable that holds its DynamicLibrary(...), so the compiler knows which library to bind it in",
        )
        return void_result()
    }
    var library = foreign.foreign_library
    crash library < foreign_library_namings.count()
    var name = member_name
    var returned: Analysis.SpiteType = integer_type()
    var returned_c = "int32_t"
    if name.ends_with("_as_double") {
        var name_length = name.length()
        name = name.slice(0, name_length - 10)
        returned = Analysis.Types.ScalarType('double_kind')
        returned_c = "double"
    } else if name.ends_with("_as_long") {
        var name_length = name.length()
        name = name.slice(0, name_length - 8)
        returned = Analysis.Types.ScalarType('long_kind')
        returned_c = "int64_t"
    } else if name.ends_with("_as_text") {
        var name_length = name.length()
        name = name.slice(0, name_length - 8)
        returned = string_type()
        returned_c = "const char*"
    }
    var symbol_name = foreign_symbol_name(name, foreign_library_namings[library])
    var pointer = ensure_foreign_symbol(library, symbol_name)
    crash library < foreign_library_headers.count()
    var header = foreign_library_headers[library]
    if not header.is_empty() {
        ensure_foreign_header(header)
    }
    var lines = List<String>()
    var releases = List<String>()
    var afters = List<String>()
    var parameter_types = List<String>()
    parameter_types.append("void")
    var passed = List<String>()
    var index = 0
    while index < arguments_ast.count() {
        var generated_expression = generate_expression(arguments_ast[index], scope, class_information)
        var argument = as_text(generated_expression)
        var argument_type = argument.type
        var scalar = type_shape.as_scalar(argument_type)
        if scalar {
            var crossing = foreign_argument_c_name(scalar.kind)
            parameter_types.append(crossing)
            passed.append("({crossing})({argument.code})")
        } else if is_enum_type(argument_type) {
            parameter_types.append("int64_t")
            passed.append("(int64_t)({argument.code})")
        } else if type_shape.as_string(argument_type) {
            var text = next_temporary()
            lines.append("SpiteString {text} = {argument.code};")
            if owns(argument, arguments_ast[index]) {
                releases.append("SpiteString___release({text});")
            }
            parameter_types.append("const char*")
            passed.append("spite_string_bytes(&{text})")
        } else if passes_as_array(argument_type) {
            var held_list = next_temporary()
            lines.append("{c_type_name(argument_type)} {held_list} = {argument.code};")
            if owns(argument, arguments_ast[index]) {
                releases.append("{release_call(argument_type, held_list)};")
            }
            parameter_types.append("void*")
            passed.append("(void*)(intptr_t){held_list}->items_")
        } else if passes_as_struct(argument_type) {
            var passed_union = type_shape.as_union(argument_type)
            crash passed_union
            var shaped = find_union_by_c_name(passed_union.c_name)
            crash shaped
            var held_shape = next_temporary()
            var struct_value = next_temporary()
            lines.append("{passed_union.c_name} {held_shape} = {argument.code};")
            var initial = List<String>()
            var field_index = 0
            while field_index < shaped.shape_fields.count() {
                var field = shaped.shape_fields[field_index]
                var field_type = shape_field_type(shaped, field.name)
                crash field_type
                initial.append("{ensure_shape_reader(shaped, field.name, field_type)}({held_shape})")
                afters.append(
                    "{ensure_shape_writer(shaped, field.name, field_type)}({held_shape}, {struct_value}.{c_value_name(field.name)});",
                )
                field_index = field_index + 1
            }
            lines.append("{shape_struct_code(shaped)} {struct_value} = \{ {initial.join(", ")} };")
            crash library < foreign_library_headers.count()
            if not foreign_library_headers[library].is_empty() and foreign_library_namings[library] == "windows" {
                lines.append(
                    "_Static_assert(sizeof({words_of(shaped.simple_name).join("_").upper_case()}) == sizeof({struct_value}), \"{shaped.simple_name} does not match {words_of(shaped.simple_name).join("_").upper_case()}\");",
                )
            }
            if owns(argument, arguments_ast[index]) {
                releases.append("{passed_union.c_name}___release({held_shape});")
            }
            parameter_types.append("void*")
            passed.append("(void*)&{struct_value}")
        } else if is_function_value_type(argument_type) {
            parameter_types.append("void*")
            var trampoline_address = direct_callback_argument(argument, arguments_ast[index], lines, afters, releases)
            passed.append(trampoline_address)
        } else {
            report(
                "{type_with_article(argument_type)} cannot cross into C: a foreign function takes numbers, Boolean, enum values, text and a type whose attributes are all numbers",
            )
        }
        index = index + 1
    }
    if parameter_types.count() > 1 {
        parameter_types.remove_at(0)
    }
    if owns(object_result, object_ast) {
        var held = next_temporary()
        lines.append("DynamicLibrary* {held} = {object_result.code};")
        releases.append("DynamicLibrary___release({held});")
    }
    var result = next_temporary()
    crash library < foreign_library_files.count()
    var library_file = escape_c_string(foreign_library_files[library])
    lines.append(
        "spite_last_foreign_call = \"{symbol_name}\\tlibrary={library_file}\\tfrom={escape_c_string(current_path)}:{current_line}\";",
    )
    if header.is_empty() {
        lines.append(
            "{returned_c} {result} = (({returned_c} (*)({parameter_types.join(", ")})){pointer})({passed.join(", ")});",
        )
    } else {
        var declared_call = declared_foreign_call(symbol_name, pointer, passed, returned_c)
        lines.append("_Pragma(\"GCC diagnostic push\") _Pragma(\"GCC diagnostic ignored \\\"-Wint-conversion\\\"\")")
        lines.append("{returned_c} {result} = {declared_call};")
        lines.append("_Pragma(\"GCC diagnostic pop\")")
    }
    var joined_afters = afters.join(" ")
    lines.append(joined_afters)
    var value = result
    if type_shape.as_string(returned) {
        value = "spite_string_from_cstring_owned({result} != 0 ? {result} : \"\")"
    }
    var called = ExpressionResult(
        "(\{ {lines.join(" ")} {returned_c} spite_foreign_result = {result}; {releases.join(" ")} (void)spite_foreign_result; {value}; })",
        returned,
    )
    called.owning_override = true
    return called
}

func foreign_argument_c_name(kind: Analysis.Types.NumericKind): String {
    if kind == 'float_kind' or kind == 'double_kind' {
        return numeric_c_name(kind)
    }
    if kind == 'byte_kind' or kind == 'unsigned_short_kind' or kind == 'unsigned_integer_kind' or kind == 'unsigned_long_kind' {
        return "uint64_t"
    }
    return "int64_t"
}

func declared_foreign_call(symbol_name: String, pointer: String, passed: List<String>, returned_c: String): String {
    var call = "((__typeof__(&{symbol_name})){pointer})({passed.join(", ")})"
    return "({returned_c})__builtin_choose_expr(__builtin_types_compatible_p(__typeof__({call}), void), ({call}, ({returned_c})0), {call})"
}

func generate_foreign_callback(
    target_class: Analysis.ClassInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var shape_of_call = "ForeignCallback(...) takes a function named directly, like 'mixer.voice_ended', and where C passes it back its context: 'no_context', 'context_first' or 'context_last'"
    if arguments_ast.count() != 2 {
        report(shape_of_call)
        return refused_callback(target_class)
    }
    var where_context = shape.as_enum_literal(arguments_ast[1])
    if not where_context {
        report(shape_of_call)
        return refused_callback(target_class)
    }
    var position = where_context.value
    if position != "no_context" and position != "context_first" and position != "context_last" {
        report(
            "'{position}' is not where C passes a callback its context: write 'no_context', 'context_first' or 'context_last'",
        )
        return refused_callback(target_class)
    }
    var work = arguments_ast[0]
    var owner = callback_owner(work, scope, class_information)
    if not owner {
        report(shape_of_call)
        return refused_callback(target_class)
    }
    var function_name = callback_function_name(work)
    var function = owner.find_function(function_name)
    if not function {
        report(shape_of_call)
        return refused_callback(target_class)
    }
    var printer = Syntax.SourcePrinter()
    var work_text = printer.source_expression(work)
    var call_text = "ForeignCallback({work_text}, '{position}')"
    var parameter_types = parameter_types_of(function.parameters)
    var parameter_names = function.parameters.map_names()
    var returned = function.return_type
    if not callback_types_cross(call_text, parameter_types, parameter_names, returned) {
        return refused_callback(target_class)
    }
    builder.threads = true
    note_fact("flag threads")
    parallel_used = true
    note_fact("flag parallel_used")
    if position == "no_context" and not owner.is_singleton {
        report(
            "'{call_text}' gives C no context to find its '{owner.simple_name}' by, so '{function_name}' must belong to a singleton: move it into a singleton that tells them apart by what C passes, or hand C the context with 'context_first' or 'context_last'",
        )
        return refused_callback(target_class)
    }
    if not owner.is_singleton {
        var visited = List<String>()
        check_parallel_reach(owner, function, call_text, visited)
    }
    crash target_class.constructor
    var expected_types = parameter_types_of(target_class.constructor.parameters)
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    ensure_callback_runtime()
    var called = escape_c_string("'{owner.simple_name}.{function_name}' ({current_path}:{current_line})")
    var handle = next_temporary()
    var lines = List<String>()
    lines.append("{target_class.c_name}* {handle} = {target_class.c_name}___make({argument_codes.join(", ")});")
    if position == "no_context" {
        var trampoline = "{function.c_name}___from_c"
        var slot = "{trampoline}_owner"
        if not callback_trampolines.contains(trampoline) {
            callback_trampolines.append(trampoline)
            builder.add_typedef("static void* {slot} = 0;")
            var fetch = "void* spite_owner = __atomic_load_n(&{slot}, __ATOMIC_ACQUIRE);\nif (spite_owner == 0) spite_callback_late(\"{called}\", \"after its ForeignCallback was dropped: keep the ForeignCallback for as long as C may call it\");"
            var target = "{function.c_name}(({owner.c_name}*)spite_owner"
            emit_callback_trampoline(trampoline, parameter_types, returned, position, fetch, target)
        }
        lines.append(
            "spite_callback_register(&{slot}, ((Spite_Function*){handle}->_function_)->spite_owner, \"{called}\");",
        )
        lines.append("{handle}->_registration_ = (int64_t)(intptr_t)&{slot};")
        lines.append("{handle}->_address_ = (int64_t)(intptr_t)&{trampoline};")
    } else {
        var trampoline = context_trampoline(parameter_types, returned, position, called)
        var ticket = next_temporary()
        lines.append("int64_t* {ticket} = spite_callback_context_register({handle}->_function_);")
        lines.append("{handle}->_context_ = *{ticket};")
        lines.append("{handle}->_registration_ = (int64_t)(intptr_t){ticket};")
        lines.append("{handle}->_address_ = (int64_t)(intptr_t)&{trampoline};")
    }
    lines.append("{handle};")
    var class_type = Analysis.Types.ClassRefType(target_class.c_name)
    return ExpressionResult("(\{ {lines.join(" ")} })", class_type)
}

func refused_callback(target_class: Analysis.ClassInfo): ExpressionResult {
    var class_type = Analysis.Types.ClassRefType(target_class.c_name)
    return ExpressionResult("(({target_class.c_name}*)0)", class_type)
}

func callback_owner(
    work: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var named = shape.as_identifier(work)
    if named {
        assert not scope.lookup_type(named.name)
        return class_information
    }
    var member = shape.as_member(work)
    assert member
    crash member.object
    var saved_counter = temporary_counter
    var probe = generate_expression(member.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var owner_ref = type_shape.as_class_ref(probe_type)
    assert owner_ref
    assert not owner_ref.has_signature
    return find_class_by_c_name(owner_ref.c_name)
}

func callback_function_name(work: Syntax.Expressions.Expression): String {
    var named = shape.as_identifier(work)
    if named {
        return named.name
    }
    var member = shape.as_member(work)
    crash member
    return member.name
}

func callback_c_type(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if not scalar {
        return ""
    }
    if scalar.kind == 'boolean_kind' {
        return "int32_t"
    }
    return numeric_c_name(scalar.kind)
}

func callback_returns_nothing(returned: Analysis.SpiteType): Boolean {
    if type_shape.is_void(returned) {
        return true
    }
    var returns_class = type_shape.as_class_ref(returned)
    if not returns_class {
        return false
    }
    return returns_class.c_name == "Nothing"
}

func callback_types_cross(
    call_text: String,
    parameter_types: List<Analysis.SpiteType>,
    parameter_names: List<String>,
    returned: Analysis.SpiteType,
): Boolean {
    var index = 0
    while index < parameter_types.count() {
        if callback_c_type(parameter_types[index]).is_empty() {
            crash parameter_names[index]
            report(
                "'{call_text}' is called by C, which passes numbers and addresses: '{parameter_names[index]}' is {type_with_article(parameter_types[index])}, so take it as a number, a Boolean or a Memory.Address (text C passes is read with 'terminated_text()')",
            )
            return false
        }
        index = index + 1
    }
    if not callback_returns_nothing(returned) and callback_c_type(returned).is_empty() {
        report(
            "'{call_text}' is called by C, which takes back a number, a Boolean or nothing: it returns {type_with_article(returned)}",
        )
        return false
    }
    return true
}

func context_trampoline(
    parameter_types: List<Analysis.SpiteType>,
    returned: Analysis.SpiteType,
    position: String,
    called: String,
): String {
    ensure_callback_contexts()
    var key = "{position} {called}"
    var found = 0
    while found < callback_context_sites.count() {
        if callback_context_sites[found] == key {
            return "spite_callback_with_context_{found}"
        }
        found = found + 1
    }
    var trampoline = "spite_callback_with_context_{callback_context_sites.count()}"
    callback_context_sites.append(key)
    var fetch = "Spite_Function* spite_function = (Spite_Function*)spite_callback_context_function(spite_context);\nif (spite_function == 0) spite_callback_late(\"{called}\", \"after its ForeignCallback was dropped: keep the ForeignCallback for as long as C may call it\");"
    var target = "{typed_call_cast(parameter_types, returned)}spite_function->spite_typed_call)(spite_function->spite_owner"
    emit_callback_trampoline(trampoline, parameter_types, returned, position, fetch, target)
    return trampoline
}

func typed_call_cast(parameter_types: List<Analysis.SpiteType>, returned: Analysis.SpiteType): String {
    var pointer_parameters = List<String>()
    pointer_parameters.append("void*")
    var index = 0
    while index < parameter_types.count() {
        var parameter_c = c_type_name(parameter_types[index])
        pointer_parameters.append(parameter_c)
        index = index + 1
    }
    var returned_c = "void"
    if not callback_returns_nothing(returned) {
        returned_c = c_type_name(returned)
    }
    return "(({returned_c} (*)({pointer_parameters.join(", ")}))"
}

func emit_callback_trampoline(
    trampoline: String,
    parameter_types: List<Analysis.SpiteType>,
    returned: Analysis.SpiteType,
    position: String,
    fetch: String,
    target: String,
) {
    var parameters = List<String>()
    var passed = List<String>()
    if position == "context_first" {
        parameters.append("void* spite_context")
    }
    var index = 0
    while index < parameter_types.count() {
        var parameter_type = parameter_types[index]
        parameters.append("{callback_c_type(parameter_type)} spite_argument_{index}")
        if is_boolean_type(parameter_type) {
            passed.append("spite_argument_{index} != 0")
        } else {
            passed.append("spite_argument_{index}")
        }
        index = index + 1
    }
    if position == "context_last" {
        parameters.append("void* spite_context")
    }
    if parameters.is_empty() {
        parameters.append("void")
    }
    var call = target
    if passed.is_empty() {
        call = "{call})"
    } else {
        call = "{call}, {passed.join(", ")})"
    }
    var returned_c = "void"
    var body = "{call};"
    if not callback_returns_nothing(returned) {
        returned_c = callback_c_type(returned)
        body = "return ({returned_c})({call});"
    }
    var header = "static {returned_c} {trampoline}({parameters.join(", ")})"
    builder.add_prototype("{header};")
    builder.add_support("{header} \{\n{fetch}\n{body}\n}")
}

func ensure_callback_contexts() {
    assert not callback_contexts_written
    callback_contexts_written = true
    builder.add_prototype("static int64_t* spite_callback_context_register(void* function);")
    builder.add_prototype("static void* spite_callback_context_function(void* context);")
    var lines = List<String>()
    lines.append(
        "typedef struct SpiteCallbackContext \{ int64_t ticket; uint64_t generation; void* function; } SpiteCallbackContext;",
    )
    lines.append("static SpiteCallbackContext* spite_callback_contexts[4096];")
    lines.append("static int64_t spite_callback_context_count = 0;")
    lines.append("static int64_t spite_callback_context_cursor = 0;")
    lines.append("static char spite_callback_context_lock = 0;")
    lines.append("static SpiteCallbackContext* spite_callback_context_at(int64_t index) \{")
    lines.append("return &spite_callback_contexts[index / 4096][index % 4096];")
    lines.append("}")
    lines.append("static int64_t spite_callback_context_free(int64_t from, int64_t to) \{")
    lines.append("int64_t index = from;")
    lines.append(
        "while (index < to && __atomic_load_n(&spite_callback_context_at(index)->ticket, __ATOMIC_ACQUIRE) != 0) index = index + 1;",
    )
    lines.append("return index;")
    lines.append("}")
    lines.append("static int64_t* spite_callback_context_register(void* function) \{")
    lines.append("while (__atomic_test_and_set(&spite_callback_context_lock, __ATOMIC_ACQUIRE)) \{}")
    lines.append("int64_t count = spite_callback_context_count;")
    lines.append("int64_t index = spite_callback_context_free(spite_callback_context_cursor, count);")
    lines.append("if (index == count && count % 4096 == 0) index = spite_callback_context_free(0, count);")
    lines.append("if (index == count) \{")
    lines.append("if (count % 4096 == 0) \{")
    lines.append("if (count / 4096 == 4096) \{")
    lines.append("fflush(stdout);")
    lines.append(
        "fprintf(stderr, \"spite: more than 16777216 ForeignCallbacks that hand C a context are alive at once\\n\");",
    )
    lines.append("exit(1);")
    lines.append("}")
    lines.append(
        "spite_callback_contexts[count / 4096] = (SpiteCallbackContext*)calloc(4096, sizeof(SpiteCallbackContext));",
    )
    lines.append("if (spite_callback_contexts[count / 4096] == 0) \{")
    lines.append("fflush(stdout);")
    lines.append(
        "fprintf(stderr, \"spite: out of memory for the table of ForeignCallbacks that hand C a context\\n\");",
    )
    lines.append("exit(1);")
    lines.append("}")
    lines.append("}")
    lines.append("__atomic_store_n(&spite_callback_context_count, count + 1, __ATOMIC_RELEASE);")
    lines.append("}")
    lines.append("spite_callback_context_cursor = index + 1;")
    lines.append("SpiteCallbackContext* context = spite_callback_context_at(index);")
    lines.append("context->generation = context->generation % 4294967295u + 1;")
    lines.append("context->function = function;")
    lines.append(
        "__atomic_store_n(&context->ticket, (int64_t)((context->generation << 32) | (uint64_t)index), __ATOMIC_RELEASE);",
    )
    lines.append("__atomic_clear(&spite_callback_context_lock, __ATOMIC_RELEASE);")
    lines.append("return &context->ticket;")
    lines.append("}")
    lines.append("static void* spite_callback_context_function(void* context) \{")
    lines.append("int64_t ticket = (int64_t)(intptr_t)context;")
    lines.append("int64_t index = (int64_t)((uint64_t)ticket & 4294967295u);")
    lines.append(
        "if (ticket == 0 || index >= __atomic_load_n(&spite_callback_context_count, __ATOMIC_ACQUIRE)) return 0;",
    )
    lines.append("SpiteCallbackContext* found = spite_callback_context_at(index);")
    lines.append("if (__atomic_load_n(&found->ticket, __ATOMIC_ACQUIRE) != ticket) return 0;")
    lines.append("return found->function;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func ensure_callback_runtime() {
    assert not callback_runtime_written
    callback_runtime_written = true
    builder.add_prototype("static void spite_callback_late(const char* called, const char* reason);")
    builder.add_prototype("static void spite_callback_register(void** slot, void* owner, const char* called);")
    var lines = List<String>()
    lines.append("static void spite_callback_late(const char* called, const char* reason) \{")
    lines.append("fflush(stdout);")
    lines.append("fprintf(stderr, \"spite: C called %s %s\\n\", called, reason);")
    lines.append("exit(1);")
    lines.append("}")
    lines.append("static void spite_callback_register(void** slot, void* owner, const char* called) \{")
    lines.append("if (__atomic_exchange_n(slot, owner, __ATOMIC_ACQ_REL) != 0) \{")
    lines.append("fflush(stdout);")
    lines.append(
        "fprintf(stderr, \"spite: %s was handed to C by a second ForeignCallback while the first is alive: C calls it with no context, so a function has one at a time; keep the first and hand C its address\\n\", called);",
    )
    lines.append("exit(1);")
    lines.append("}")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func direct_callback_argument(
    argument: ExpressionResult,
    argument_ast: Syntax.Expressions.Expression,
    lines: List<String>,
    afters: List<String>,
    releases: List<String>,
): String {
    var argument_type = argument.type
    var signature = type_shape.as_class_ref(argument_type)
    crash signature
    var printer = Syntax.SourcePrinter()
    var argument_text = printer.source_expression(argument_ast)
    var names = List<String>()
    var index = 0
    while index < signature.arguments.count() {
        names.append("argument {index + 1}")
        index = index + 1
    }
    var returned = returned_type(signature)
    if not callback_types_cross(argument_text, signature.arguments, names, returned) {
        return "0"
    }
    var held = next_temporary()
    var trampoline = "spite_callback_{temporary_counter}"
    var saved = next_temporary()
    var slot = "{trampoline}_slot"
    if not callback_trampolines.contains(trampoline) {
        callback_trampolines.append(trampoline)
        ensure_callback_runtime()
        builder.add_typedef("static _Thread_local void* {slot} = 0;")
        var called = escape_c_string("'{argument_text}' ({current_path}:{current_line})")
        var fetch = "Spite_Function* spite_function = (Spite_Function*){slot};\nif (spite_function == 0) spite_callback_late(\"{called}\", \"after the foreign call that handed it over had returned, or on another thread: a function C keeps, or calls from a thread of its own, is handed over as a ForeignCallback the program keeps for as long as C may call it\");"
        var target = "{typed_call_cast(signature.arguments, returned)}spite_function->spite_typed_call)(spite_function->spite_owner"
        emit_callback_trampoline(trampoline, signature.arguments, returned, "direct", fetch, target)
    }
    lines.append("Spite_Function* {held} = {argument.code};")
    lines.append("void* {saved} = {slot};")
    lines.append("{slot} = (void*){held};")
    afters.append("{slot} = {saved};")
    if owns(argument, argument_ast) {
        releases.append("Spite_Function___release({held});")
    }
    return "(void*)&{trampoline}"
}

func is_reflection_member(name: String): Boolean {
    return name == "class" or name == "attributes" or name == "functions" or name == "memory"
}

func is_own_library_member(name: String): Boolean {
    var library_class = find_class_by_c_name("DynamicLibrary")
    crash library_class
    if library_class.find_field(name) or library_class.find_function(name) {
        return true
    }
    return false
}

func generate_foreign_constant(foreign: Analysis.Types.ClassRefType, name: String): ExpressionResult {
    if foreign.foreign_library < 0 {
        report("a foreign constant is read through the attribute or variable that holds its DynamicLibrary(...)")
        return void_result()
    }
    crash foreign.foreign_library < foreign_library_headers.count()
    var header = foreign_library_headers[foreign.foreign_library]
    if header.is_empty() {
        report(
            "'{name}' is a constant, and a constant comes from the library's header: name it as DynamicLibrary's third argument",
        )
        return void_result()
    }
    ensure_foreign_header(header)
    var integer_spite_type = integer_type()
    return ExpressionResult("((int32_t)({name.upper_case()}))", integer_spite_type)
}

func ensure_foreign_header(header: String) {
    assert not foreign_headers_included.contains(header)
    foreign_headers_included.append(header)
    if File(header).exists() {
        builder.add_typedef("#include \"{escape_c_string(header)}\"")
    } else {
        builder.add_typedef("#include <{header}>")
    }
}

func passes_as_array(spite_type: Analysis.SpiteType): Boolean {
    var listed = type_shape.as_list(spite_type)
    if listed {
        var listed_element = listed.element
        if type_shape.as_scalar(listed_element) {
            return true
        }
    }
    return false
}

func passes_as_struct(spite_type: Analysis.SpiteType): Boolean {
    var passed_union = type_shape.as_union(spite_type)
    if not passed_union {
        return false
    }
    var shaped = find_union_by_c_name(passed_union.c_name)
    if not shaped {
        return false
    }
    if not shaped.is_shape {
        return false
    }
    var index = 0
    while index < shaped.shape_fields.count() {
        var field = shaped.shape_fields[index]
        if field.is_function {
            return false
        }
        var field_type = shape_field_type(shaped, field.name)
        if not field_type {
            return false
        }
        if not type_shape.as_scalar(field_type) {
            return false
        }
        index = index + 1
    }
    return true
}

func ensure_foreign_symbol(library: Integer, c_name: String): String {
    var index = 0
    while index < foreign_symbol_names.count() {
        crash index < foreign_symbol_libraries.count()
        if foreign_symbol_libraries[index] == library and foreign_symbol_names[index] == c_name {
            return "spite_foreign_{library}_{index}"
        }
        index = index + 1
    }
    var position = foreign_symbol_names.count()
    foreign_symbol_libraries.append(library)
    foreign_symbol_names.append(c_name)
    foreign_symbol_wanted.append("{current_owner}.{current_function}")
    builder.add_typedef("static void* spite_foreign_{library}_{position} = 0;")
    return "spite_foreign_{library}_{position}"
}

func foreign_symbol_name(name: String, naming: String): String {
    if naming == "identity" {
        return name
    }
    var words = name.split("_")
    var text = ""
    var index = 0
    while index < words.count() {
        var word = words[index]
        if naming == "windows" {
            word = abbreviated(word)
        }
        if index == 0 and naming == "camel_case" {
            text = word
        } else {
            var word_length = word.length()
            text = "{text}{word.slice(0, 1).upper_case()}{word.slice(1, word_length)}"
        }
        index = index + 1
    }
    return text
}

func abbreviated(word: String): String {
    var short_words = abbreviated_words()
    var full_words = unabbreviated_words()
    var position = 0
    while position < full_words.count() {
        if full_words[position] == word {
            crash position < short_words.count()
            return short_words[position]
        }
        position = position + 1
    }
    return word
}

func owned_c_text(text: String): String {
    return "spite_string_from_cstring_owned(\"{escape_c_string(text)}\")"
}

# ../../../docs/optimizations.md#a-foreign-name-is-never-copied
func static_c_text(text: String): String {
    return "((SpiteString)SPITE_STATIC_STRING(\"{escape_c_string(text)}\", {text.length()}))"
}

func report_singleton_circles() {
    var reported = List<String>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        var checked = information.is_singleton and not information.is_stateless_singleton
        if checked and not information.is_generic_template and not reported.contains(information.c_name) {
            var path = List<String>()
            var visited = List<String>()
            if circle_from(information.c_name, information.c_name, path, visited) {
                reported.append(information.c_name)
                path.each(reported.append)
                report_singleton_circle(information, path)
            }
        }
        index = index + 1
    }
}

func circle_from(start: String, current: String, path: List<String>, visited: List<String>): Boolean {
    var information = find_class_by_c_name(current)
    if not information {
        return false
    }
    var index = 0
    while index < information.fields.count() {
        var made = classes_made_by(information.fields[index].default_value_code)
        var made_index = 0
        while made_index < made.count() {
            var target = made[made_index]
            if target == start {
                path.append(target)
                return true
            }
            if not visited.contains(target) {
                visited.append(target)
                path.append(target)
                if circle_from(start, target, path, visited) {
                    return true
                }
                path.remove_last()
            }
            made_index = made_index + 1
        }
        index = index + 1
    }
    return false
}

func classes_made_by(code: String): List<String> {
    var made = List<String>()
    var code_length = code.length()
    var position = 0
    while position < code_length {
        var name_end = position
        var character = code.code_at(name_end)
        while name_end < code_length and is_c_name_code(character) {
            name_end = name_end + 1
            character = code.code_at(name_end)
        }
        if name_end > position {
            var name = code.slice(position, name_end)
            note_made_class(name, made)
            position = name_end
        } else {
            position = position + 1
        }
    }
    return made
}

func note_made_class(name: String, made: List<String>) {
    var made_name = ""
    if name.starts_with("spite_singleton_") {
        var name_length = name.length()
        made_name = name.slice(16, name_length)
        var keyed_at = made_name.index_of("___with_")
        if keyed_at >= 0 {
            made_name = made_name.slice(0, keyed_at)
        }
    }
    var suffixes = ["___make_into", "___make", "___default", "___allocate"]
    var index = 0
    while made_name.is_empty() and index < suffixes.count() {
        var suffix = suffixes[index]
        if name.ends_with(suffix) {
            var name_length = name.length()
            var suffix_length = suffix.length()
            made_name = name.slice(0, name_length - suffix_length)
        }
        index = index + 1
    }
    assert not made_name.is_empty()
    if not made.contains(made_name) and find_class_by_c_name(made_name) {
        made.append(made_name)
    }
}

func report_singleton_circle(information: Analysis.ClassInfo, path: List<String>) {
    var parts = List<String>()
    var index = 0
    while index < path.count() {
        var step = find_class_by_c_name(path[index])
        crash step
        var verb = "makes"
        if step.is_singleton {
            verb = "binds"
        }
        var shown = "{verb} '{singleton_display_name(step)}'"
        if index > 0 {
            shown = "which {shown}"
        }
        parts.append(shown)
        index = index + 1
    }
    current_path = information.source_path
    current_line = circle_field_line(information, path)
    current_owner = information.qualified_dotted
    current_function = ""
    report(
        "singleton '{singleton_display_name(information)}' {parts.join(", ")}: singletons initialise each other in a circle, so one of them has to reach the other some other way, such as by binding it in the class that uses both",
    )
}

func circle_field_line(information: Analysis.ClassInfo, path: List<String>): Integer {
    var first = path.first()
    crash first
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var made = classes_made_by(field.default_value_code)
        if made.contains(first) {
            return field.line
        }
        index = index + 1
    }
    return 1
}

func emit_singleton_teardown() {
    builder.add_prototype("bool spite_singleton_tracked(void);")
    builder.add_prototype("void spite_singleton_created(void (*teardown)(void));")
    builder.add_prototype("void spite_singleton_used_after_exit(const char* name);")
    builder.add_prototype("void spite_singletons_destroy(void);")
    builder.add_prototype("void spite_singleton_free_later(void* object);")
    builder.add_prototype("void spite_singleton_check_circle(const char* name);")
    builder.add_prototype("void spite_singleton_making(const char* name);")
    builder.add_prototype("void spite_singleton_made(void);")
    var lines = List<String>()
    lines.append("static SPITE_THREAD_LOCAL const char* spite_singletons_making[64];")
    lines.append("static SPITE_THREAD_LOCAL int32_t spite_singletons_making_count = 0;")
    lines.append("void spite_singleton_check_circle(const char* name) \{")
    lines.append("int32_t kept = spite_singletons_making_count < 64 ? spite_singletons_making_count : 64;")
    lines.append("int32_t first = 0;")
    lines.append("while (first < kept && strcmp(spite_singletons_making[first], name) != 0) first = first + 1;")
    lines.append("if (first == kept) return;")
    lines.append("fflush(stdout);")
    lines.append("if (first + 1 == kept) \{")
    lines.append(
        "fprintf(stderr, \"spite: singleton '%s' is asked for while it is being made: a singleton cannot reach itself as it initialises\\n\", name);",
    )
    lines.append("exit(1);")
    lines.append("}")
    lines.append("fprintf(stderr, \"spite: singleton '%s'\", name);")
    lines.append("for (int32_t step = first + 1; step < kept; step = step + 1) \{")
    lines.append(
        "fprintf(stderr, step == first + 1 ? \" binds '%s'\" : \", which binds '%s'\", spite_singletons_making[step]);",
    )
    lines.append("}")
    lines.append("fprintf(stderr, \", which binds '%s'\", name);")
    lines.append("fputs(\": singletons initialise each other in a circle\\n\", stderr);")
    lines.append("exit(1);")
    lines.append("}")
    lines.append("void spite_singleton_making(const char* name) \{")
    lines.append(
        "if (spite_singletons_making_count < 64) spite_singletons_making[spite_singletons_making_count] = name;",
    )
    lines.append("spite_singletons_making_count = spite_singletons_making_count + 1;")
    lines.append("}")
    lines.append("void spite_singleton_made(void) \{")
    lines.append("spite_singletons_making_count = spite_singletons_making_count - 1;")
    lines.append("}")
    lines.append("static void (**spite_singleton_teardowns)(void) = 0;")
    lines.append("static int32_t spite_singleton_total = 0;")
    lines.append("static int32_t spite_singleton_capacity = 0;")
    lines.append("static int32_t spite_singleton_list_lock = 0;")
    lines.append("bool spite_singleton_tracked(void) \{")
    if debug_memory {
        lines.append("#ifdef SPITE_DEBUG_MEMORY")
        lines.append("return !spite_allocation_table_busy;")
        lines.append("#else")
        lines.append("return true;")
        lines.append("#endif")
    } else {
        lines.append("return true;")
    }
    lines.append("}")
    lines.append("void spite_singleton_created(void (*teardown)(void)) \{")
    lines.append("if (!spite_singleton_tracked()) return;")
    lines.append("SPITE_LOCK(spite_singleton_list_lock);")
    lines.append("if (spite_singleton_total == spite_singleton_capacity) \{")
    lines.append("spite_singleton_capacity = spite_singleton_capacity == 0 ? 16 : spite_singleton_capacity * 2;")
    lines.append(
        "spite_singleton_teardowns = (void (**)(void))realloc(spite_singleton_teardowns, (size_t)spite_singleton_capacity * sizeof(void (*)(void)));",
    )
    lines.append("}")
    lines.append("spite_singleton_teardowns[spite_singleton_total] = teardown;")
    lines.append("spite_singleton_total = spite_singleton_total + 1;")
    lines.append("SPITE_UNLOCK(spite_singleton_list_lock);")
    lines.append("}")
    lines.append("void spite_singleton_used_after_exit(const char* name) \{")
    lines.append("fflush(stdout);")
    lines.append(
        "fprintf(stderr, \"spite: a drop() at exit used the singleton %s after it was destroyed: singletons are destroyed in reverse order of when they were made, so keep %s in an attribute of the singleton whose drop() uses it\\n\", name, name);",
    )
    lines.append("exit(1);")
    lines.append("}")
    lines.append("static bool spite_singletons_ending = false;")
    lines.append("static void** spite_singletons_freed = 0;")
    lines.append("static int32_t spite_singletons_freed_total = 0;")
    lines.append("static int32_t spite_singletons_freed_capacity = 0;")
    lines.append("void spite_singleton_free_later(void* object) \{")
    lines.append("if (!spite_singletons_ending) \{ SPITE_FREE(object); return; }")
    lines.append("if (spite_singletons_freed_total == spite_singletons_freed_capacity) \{")
    lines.append(
        "spite_singletons_freed_capacity = spite_singletons_freed_capacity == 0 ? 16 : spite_singletons_freed_capacity * 2;",
    )
    lines.append(
        "spite_singletons_freed = (void**)realloc(spite_singletons_freed, (size_t)spite_singletons_freed_capacity * sizeof(void*));",
    )
    lines.append("}")
    lines.append("spite_singletons_freed[spite_singletons_freed_total] = object;")
    lines.append("spite_singletons_freed_total = spite_singletons_freed_total + 1;")
    lines.append("}")
    lines.append("void spite_singletons_destroy(void) \{")
    lines.append("fflush(stdout);")
    lines.append("spite_singletons_ending = true;")
    lines.append("while (spite_singleton_total > 0) \{")
    lines.append("spite_singleton_total = spite_singleton_total - 1;")
    lines.append("spite_singleton_teardowns[spite_singleton_total]();")
    lines.append("}")
    lines.append("free(spite_singleton_teardowns);")
    lines.append(
        "for (int32_t index = 0; index < spite_singletons_freed_total; index = index + 1) SPITE_FREE(spite_singletons_freed[index]);",
    )
    lines.append("free(spite_singletons_freed);")
    lines.append("spite_singletons_ending = false;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    builder.add_main("spite_singletons_destroy();")
    var library = foreign_library_files.count()
    while library > 0 {
        library = library - 1
        var cache = "spite_foreign_library_{library}_cache"
        builder.add_main_if_kept(
            "spite_foreign_library_{library}",
            "if (spite_foreign_library_{library}_tracked) DynamicLibrary___destroy({cache});",
        )
    }
}

func emit_foreign_libraries() {
    var library = 0
    while library < foreign_library_files.count() {
        var accessor = "spite_foreign_library_{library}"
        crash library < foreign_library_namings.count()
        crash library < foreign_library_headers.count()
        var lines = List<String>()
        lines.append("static int32_t {accessor}_lock = 0;")
        lines.append("DynamicLibrary* {accessor}(void) \{")
        lines.append("DynamicLibrary* found = SPITE_SINGLETON_FOUND({accessor}_cache);")
        lines.append("if (found != 0) return found;")
        lines.append("SPITE_LOCK({accessor}_lock);")
        lines.append("if ({accessor}_cache == 0) \{")
        lines.append(
            "DynamicLibrary* made = DynamicLibrary___make({static_c_text(foreign_library_files[library])}, {ensure_symbol(foreign_library_namings[library])}, {static_c_text(foreign_library_headers[library])});",
        )
        lines.append("{accessor}_tracked = spite_singleton_tracked();")
        lines.append("(void)&DynamicLibrary_find_symbol;")
        var index = 0
        while index < foreign_symbol_names.count() {
            crash index < foreign_symbol_libraries.count()
            crash index < foreign_symbol_wanted.count()
            if foreign_symbol_libraries[index] == library {
                var binding = builder.add_binding(
                    "spite_foreign_{library}_{index}",
                    "spite_foreign_{library}_{index} = (void*)(intptr_t)DynamicLibrary_find_symbol(made, {static_c_text(foreign_symbol_names[index])}, {static_c_text(foreign_symbol_wanted[index])});",
                )
                lines.append(binding)
            }
            index = index + 1
        }
        lines.append("SPITE_SINGLETON_PUBLISH({accessor}_cache, made);")
        lines.append("}")
        lines.append("SPITE_UNLOCK({accessor}_lock);")
        lines.append("return {accessor}_cache;")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
        library = library + 1
    }
}

func generate_call(
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash call.callee
    var callee_identifier = shape.as_identifier(call.callee)
    if callee_identifier {
        if callee_identifier.name == "load" {
            var loaded_names = List<String>()
            collect_each_mentioned_name(call.arguments, loaded_names)
            mark_names_read(class_information, loaded_names)
            if call.runs_program {
                var program_run = program_run_code()
                var run_type = void_type()
                return ExpressionResult(program_run, run_type)
            }
            var nothing_type = void_type()
            return ExpressionResult("(void)0", nothing_type)
        }
    }
    var target_class = try_resolve_static_path(call.callee, class_information.qualified_dotted)
    if target_class {
        return generate_constructor_call(target_class, call.arguments, scope, class_information)
    }
    if callee_identifier {
        if callee_identifier.name == "Symbol" {
            return generate_symbol_lookup(call.arguments, scope, class_information)
        }
        if callee_identifier.name == "Arguments" and call.arguments.is_empty() {
            var result_type = Analysis.Types.ArgumentsType()
            return ExpressionResult("spite_program_arguments", result_type)
        }
    }
    var member = shape.as_member(call.callee)
    if member {
        crash member.object
        if item_values_on {
            item_note_insert(member, call.arguments, scope, class_information)
        }
        var unrolled = unrolled_walk(member, call.arguments, scope, class_information)
        if unrolled {
            return unrolled
        }
        var folded_call = folded_reflection(call, scope, class_information)
        if folded_call {
            return folded_call
        }
        var made_from_member = reflected_construction(call.callee, call.arguments, scope, class_information)
        if made_from_member {
            return made_from_member
        }
        if member.name == "has_function" or member.name == "function_waits" or member.name == "fits_vector" or member.name == "function_writes_parameter" or member.name == "any_attribute_fits_vector" or member.name == "has_state" {
            var answered = folded_function_question(call, class_information)
            if answered == true or answered == false {
                var answer_type: Analysis.SpiteType = Analysis.Types.ScalarType('boolean_kind')
                if answered == true {
                    return ExpressionResult("true", answer_type)
                }
                return ExpressionResult("false", answer_type)
            }
        }
        if member.name == "returned_text" {
            return folded_returned_text(call, scope, class_information)
        }
        if member.name == "source_folder" and call.arguments.is_empty() {
            var folded_folder = folded_source_folder(member, scope, class_information)
            if folded_folder {
                return folded_folder
            }
        }
        if member.name == "class" {
            var walked_made = generate_walked_default(member, call.arguments, scope, class_information)
            if walked_made {
                return walked_made
            }
        }
        if member.name == "argument_count" {
            var counted = folded_argument_count(call, class_information)
            if counted {
                var count_type = integer_type()
                var count_result = ExpressionResult(counted, count_type)
                count_result.constant_text = "i:{counted}"
                return count_result
            }
        }
        return generate_method_call(member, member.object, call.arguments, scope, class_information)
    }
    var identifier = shape.as_identifier(call.callee)
    if identifier {
        var made_from_name = reflected_construction(call.callee, call.arguments, scope, class_information)
        if made_from_name {
            return made_from_name
        }
        return generate_own_function_call(identifier.name, call.arguments, scope, class_information)
    }
    var codegen = shape.as_generic_identifier(call.callee)
    if codegen {
        var made = generate_codegen_default(codegen.name, call.arguments, scope, class_information)
        if made {
            return made
        }
    }
    var held = generate_expression(call.callee, scope, class_information)
    var held_type = held.type
    var held_function = type_shape.as_class_ref(held_type)
    if held_function {
        if held_function.has_signature {
            if not holds_in_order(held) {
                return call_function_value(held, call.callee, call.arguments, scope, class_information)
            }
            var held_value = hold_in_order(held, call.callee)
            crash held_value
            var called = call_function_value(held_value.operand, call.callee, call.arguments, scope, class_information)
            return settle_in_order(held_value, called)
        }
    }
    report("unsupported call form")
    return void_result()
}

func generate_codegen_default(
    name: String,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var bound = codegen_index(class_information, name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    crash class_information.codegen_types[bound]
    var made_type = class_information.codegen_types[bound]
    return generate_default_of(made_type, "${name}", arguments, scope, class_information)
}

func generate_walked_default(
    member: Syntax.Expressions.MemberExpression,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    crash member.object
    assert member.name == "class" and not bound_symbol_name.is_empty()
    assert is_identifier_named(member.object, bound_symbol_name) and bound_field_type
    return generate_default_of(bound_field_type, "{bound_symbol_name}.class", arguments, scope, class_information)
}

func generate_default_of(
    made_type: Analysis.SpiteType,
    written: String,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var made_class_type = type_shape.as_class_ref(made_type)
    if made_class_type {
        var made_class = find_class_by_c_name(made_class_type.c_name)
        if made_class {
            return generate_constructor_call(made_class, arguments, scope, class_information)
        }
    }
    if not arguments.is_empty() {
        report(
            "'{written}' is {type_with_article(made_type)} here, which is made with no arguments: '{written}()' is its default",
        )
        return void_result()
    }
    var default_code = default_value_for_type(made_type)
    var made = ExpressionResult(default_code, made_type)
    made.owning_override = true
    return made
}

func library_function_value(
    member: Syntax.Expressions.MemberExpression,
    object_result: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert not member.name.starts_with("_")
    var object_type = object_result.type
    var owner_class = class_of_type(object_type)
    assert owner_class
    var function = find_or_instantiate_function(owner_class, member.name)
    assert function
    assert not function.is_constructor
    if maths.is_constant(member.name) and is_inline_supplied(function) {
        report(
            "'{member.name}' is a constant of the class {owner_class.qualified_dotted}, not of a value: write '{owner_class.qualified_dotted}.{member.name}'",
        )
        return void_result()
    }
    var container = container_class_of(object_type)
    if not container {
        var plain_owner = type_shape.as_string(object_type) or type_shape.as_scalar(object_type)
        if plain_owner {
            crash member.object
            return value_function_value(function, object_result, member.object, object_type)
        }
        report(
            "'{member.name}' of {type_with_article(object_type)} is passed straight to a form, like 'names.filter(text.{member.name})', and cannot be held as a value: a {type_display_name(object_type)} is not an object a function value can keep. To keep one, write a function of your own that calls it",
        )
        return void_result()
    }
    crash member.object
    report_captured_borrow(member, object_result, scope, class_information)
    return function_value(owner_class, function, object_result, member.object)
}

func value_function_value(
    function: Analysis.FunctionInfo,
    owner: ExpressionResult,
    owner_ast: Syntax.Expressions.Expression,
    owner_type: Analysis.SpiteType,
): ExpressionResult {
    var maker = "spite_value_function_{function.c_name}"
    var kept_owner = owner.code
    if not owns(owner, owner_ast) and type_needs_drop(owner_type) {
        kept_owner = retain_call(owner_type, owner.code)
    }
    var boxed_owner = ""
    var box_release = "spite_string_box_release"
    var box_type = "SpiteBox_SpiteString"
    if type_shape.as_string(owner_type) {
        boxed_owner = boxed_text(kept_owner)
    } else {
        var boxed_class = boxed_class_of(owner_type)
        crash boxed_class
        boxed_owner = "{ensure_box(boxed_class, owner_type)}({kept_owner})"
        box_release = "spite_box_release"
        box_type = "SpiteBox_{boxed_class.c_name}"
    }
    note_fact("maker {maker}")
    if not function_value_makers.contains(maker) {
        function_value_makers.append(maker)
        var argument_class = find_class_by_c_name("Spite_Argument")
        if not find_class_by_c_name("Spite_Function") or not argument_class {
            report(
                "a function value needs the standard library: library/spite/function.spite was not found from the working directory",
            )
            return void_result()
        }
        var class_type = class_type_of(argument_class)
        var arguments_list_name = ensure_list(class_type)
        var argument_lines = List<String>()
        var parameters = List<String>()
        parameters.append("void* owner")
        var forwarded = List<String>()
        forwarded.append("(({box_type}*)owner)->value")
        var parameter_index = 0
        while parameter_index < function.parameters.count() {
            var parameter = function.parameters[parameter_index]
            var parameter_type = parameter.type
            argument_lines.append(
                "{arguments_list_name}_append(described->_arguments_, Spite_Argument___make({ensure_symbol(parameter.name)}, {class_object_call(parameter_type)}));",
            )
            parameters.append("{c_type_name(parameter_type)} spite_argument_{parameter_index}")
            forwarded.append("spite_argument_{parameter_index}")
            parameter_index = parameter_index + 1
        }
        var return_spite_type = function.return_type
        var returned_c = "void"
        if not type_shape.is_void(return_spite_type) {
            returned_c = c_type_name(return_spite_type)
        }
        var forwarder = "{maker}___call"
        var forwarded_call = "{function.c_name}({forwarded.join(", ")})"
        var forwarder_body = "return {forwarded_call};"
        if returned_c == "void" {
            forwarder_body = "{forwarded_call};"
        }
        builder.add_prototype("static {returned_c} {forwarder}({parameters.join(", ")});")
        builder.add_support("static {returned_c} {forwarder}({parameters.join(", ")}) \{\n{forwarder_body}\n}")
        var lines = List<String>()
        lines.append("Spite_Function* {maker}(void* owner) \{")
        lines.append(
            "Spite_Function* described = Spite_Function___make({ensure_symbol(function.name)}, {returned_class_object_call(function)});",
        )
        if not argument_lines.is_empty() {
            add_lazy_arguments(maker, argument_lines, lines)
        }
        lines.append("described->spite_owner = owner;")
        lines.append("described->spite_release_owner = {box_release};")
        if function.parameters.is_empty() {
            var dropping = "{maker}___dropping_call"
            var dropped_lines = List<String>()
            dropped_lines.append("static void {dropping}(void* owner) \{")
            if type_needs_drop(return_spite_type) {
                dropped_lines.append("{returned_c} returned = {forwarder}(owner);")
                dropped_lines.append("{release_call(return_spite_type, "returned")};")
            } else {
                dropped_lines.append("(void){forwarder}(owner);")
            }
            dropped_lines.append("}")
            builder.add_prototype("static void {dropping}(void* owner);")
            var joined_dropped = dropped_lines.join("\n")
            builder.add_support(joined_dropped)
            lines.append("described->spite_call = (void (*)(void*)){dropping};")
        }
        lines.append("described->spite_typed_call = (void*){forwarder};")
        lines.append("return described;")
        lines.append("}")
        builder.add_prototype("Spite_Function* {maker}(void* owner);")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    var signature = signature_of(function)
    var made = ExpressionResult("{maker}({boxed_owner})", signature)
    made.owning_override = true
    return made
}

func generate_member_read(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var result = generate_member_read_raw(member, scope, class_information)
    var path = operand_text(member)
    if not path.is_empty() {
        var result_type = result.type
        var nullable = type_shape.as_nullable(result_type)
        if nullable {
            if scope.is_path_narrowed(path) {
                var unwrapped_code = result.code
                var nullable_inner = nullable.inner
                if not type_is_reference(nullable_inner) {
                    unwrapped_code = "({result.code}).value"
                }
                var unwrapped = ExpressionResult(unwrapped_code, nullable_inner)
                unwrapped.owning_override = result.owning_override
                return unwrapped
            }
        }
    }
    return result
}

func type_size_read(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    crash member.object
    var named = shape.as_identifier(member.object)
    assert named
    assert not scope.lookup_type(named.name) and not class_information.find_field(named.name)
    var sized = find_union(named.name)
    assert sized
    var struct_code = shape_struct_code(sized)
    if struct_code.is_empty() {
        report(
            "'{named.name}.size' is the size of the C struct a type is at a foreign call, and only a type whose attributes are all numbers is one",
        )
        return void_result()
    }
    var long_spite_type = long_type()
    return ExpressionResult("((int64_t)sizeof({struct_code}))", long_spite_type)
}

func shape_struct_code(shaped: Analysis.UnionInfo): String {
    if not shaped.is_shape or shaped.shape_fields.is_empty() {
        return ""
    }
    var members = List<String>()
    var index = 0
    while index < shaped.shape_fields.count() {
        var field = shaped.shape_fields[index]
        if field.is_function {
            return ""
        }
        var field_type = shape_field_type(shaped, field.name)
        if not field_type {
            return ""
        }
        if not type_shape.as_scalar(field_type) {
            return ""
        }
        members.append("{c_type_name(field_type)} {c_value_name(field.name)};")
        index = index + 1
    }
    return "struct \{ {members.join(" ")} }"
}

func generate_member_read_raw(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash member.object
    if maths.is_constant(member.name) {
        var constant_class = try_resolve_static_path(member.object, class_information.qualified_dotted)
        if constant_class {
            var constant_read = number_constant_read(constant_class, member.name)
            if constant_read {
                return constant_read
            }
            if is_number_class(constant_class) {
                report_not_a_number_constant(constant_class, member.name, null)
                return void_result()
            }
        }
    }
    var attribute_read = bound_attribute_read(member, scope, class_information)
    if attribute_read {
        return generate_expression(attribute_read, scope, class_information)
    }
    if member.name == "allocator" {
        var allocator_answer = allocator_read(member, scope, class_information)
        if allocator_answer {
            return allocator_answer
        }
    }
    var folded_member = folded_reflection(member, scope, class_information)
    if folded_member {
        return folded_member
    }
    if member.name == "size" {
        var type_size = type_size_read(member, scope, class_information)
        if type_size {
            return type_size
        }
    }
    if member.name == "instances" {
        var named_class = try_resolve_static_path(member.object, class_information.qualified_dotted)
        if named_class {
            if named_class.c_name == "Spite_Namespace" {
                var every_namespace = reflected_every_namespace()
                return namespace_list_result(every_namespace)
            }
            if named_class.c_name == "Spite_Class" {
                all_classes_used = true
                note_fact("flag all_classes_used")
                var class_type = class_type_of(named_class)
                var every_class_type = list_type_of(class_type)
                builder.add_prototype("{c_type_name(every_class_type)} spite_all_classes(void);")
                var every_class = ExpressionResult("spite_all_classes()", every_class_type)
                every_class.owning_override = true
                return every_class
            }
            if named_class.is_generic_template {
                report("'{named_class.simple_name}.instances' is not available for this class")
                return void_result()
            }
            var class_type = class_type_of(named_class)
            var list_type = list_type_of(class_type)
            var live = ExpressionResult("{ensure_live_instances(named_class)}()", list_type)
            live.owning_override = true
            return live
        }
    }
    var symbol_identifier = shape.as_identifier(member.object)
    if symbol_identifier {
        if symbol_identifier.name == bound_symbol_name and member.name == "name" and not bound_symbol_name.is_empty() {
            var shown_name = bound_field_name
            if not bound_display_name.is_empty() {
                shown_name = bound_display_name
            }
            var rendered_string_literal = render_string_literal(shown_name)
            var string_spite_type = string_type()
            return ExpressionResult(rendered_string_literal, string_spite_type)
        }
        var spelled = member.name == "camel_case_name" or member.name == "pascal_case_name"
        if symbol_identifier.name == bound_symbol_name and spelled and not bound_symbol_name.is_empty() {
            var capitalised_first = member.name == "pascal_case_name"
            var spelling = joined_case_spelling(bound_field_name, capitalised_first)
            var rendered_spelling = render_string_literal(spelling)
            var spelling_type = string_type()
            var spelled_result = ExpressionResult(rendered_spelling, spelling_type)
            spelled_result.constant_text = "s:{spelling}"
            return spelled_result
        }
        if symbol_identifier.name == bound_symbol_name and member.name == "value" and not bound_enum_c_name.is_empty() {
            var bound_enum = enums.find_by_c_name(bound_enum_c_name)
            crash bound_enum
            var bound_enum_type = enum_type_of(bound_enum)
            return ExpressionResult("{bound_enum_c_name}_{bound_field_name}", bound_enum_type)
        }
        if symbol_identifier.name == bound_symbol_name and member.name == "index" and not bound_symbol_name.is_empty() {
            var index_type = integer_type()
            if bound_field_index < 0 {
                report(
                    "'{bound_symbol_name}.index' is the attribute's place among the attributes walked, so it is read in a function a walk of attributes calls, such as 'fill_attribute(attribute: Symbol<Row>, ...)'",
                )
                return ExpressionResult("0", index_type)
            }
            var place = ExpressionResult(bound_field_index, index_type)
            place.constant_text = "i:{bound_field_index}"
            return place
        }
        if symbol_identifier.name == bound_symbol_name and member.name == "is_singleton" and not bound_symbol_name.is_empty() {
            var holds_singleton = "false"
            if bound_field_type and bound_field_index >= 0 {
                if singleton_type(bound_field_type) {
                    holds_singleton = "true"
                }
            }
            var holds_singleton_type = boolean_type()
            var holds_singleton_answer = ExpressionResult(holds_singleton, holds_singleton_type)
            holds_singleton_answer.constant_text = "b:{holds_singleton}"
            return holds_singleton_answer
        }
        if symbol_identifier.name == bound_symbol_name and member.name == "class" and not bound_symbol_name.is_empty() {
            crash bound_field_type
            var class_object_code = class_object_call(bound_field_type)
            var class_object_type = spite_class_type()
            return ExpressionResult(class_object_code, class_object_type)
        }
    }
    var object_counter = temporary_counter
    var object_result = generate_member_object(member.object, scope, class_information)
    var uncounted_object = item_object_uncounted(
        member.object,
        object_result,
        member.name,
        false,
        scope,
        class_information,
    )
    if uncounted_object {
        object_result = uncounted_object
    }
    var object_result_type = object_result.type
    var handle = joinable_handle(object_result_type)
    if handle {
        if forwards_to_result(handle, member.name) {
            rewind_temporaries(object_counter)
            var joined_ast = implicit_join_ast(member.object)
            var forwarded = Syntax.Expressions.MemberExpression(joined_ast, member.name)
            return generate_member_read(forwarded, scope, class_information)
        }
    }
    var foreign = type_shape.as_class_ref(object_result_type)
    if foreign {
        if foreign.c_name == "DynamicLibrary" and not is_reflection_member(member.name) and not is_own_library_member(member.name) {
            return generate_foreign_constant(foreign, member.name)
        }
    }
    if member.name == "namespace" {
        var namespace_receiver = type_shape.as_class_ref(object_result_type)
        if namespace_receiver {
            if namespace_receiver.c_name == "Spite_Class" {
                namespace_read_used = true
                note_fact("flag namespace_read_used")
            }
        }
    }
    if member.name == "value" {
        var object_receiver = type_shape.as_class_ref(object_result_type)
        if object_receiver {
            var read_by_the_loop = class_information.qualified_dotted == "ReadEvaluatePrintLoop"
            if object_receiver.c_name == "Spite_Attribute" and (read_evaluate_print_loop or not read_by_the_loop) {
                attribute_object_used = true
                note_fact("flag attribute_object_used")
            }
        }
    }
    if member.name == "source_files" or member.name == "source_directories" {
        source_paths_used = true
        note_fact("flag source_paths_used")
    }
    if run_time_kind_word(member.name) {
        var kind_receiver = type_shape.as_class_ref(object_result_type)
        if kind_receiver {
            var described_receivers = [
                "Spite_Class"
                "Spite_Attribute"
                "Spite_AttributeDeclaration"
                "Spite_Argument"
                "Spite_Function"
            ]
            if described_receivers.contains(kind_receiver.c_name) {
                run_time_kinds_used = true
                note_fact("flag run_time_kinds_used")
            }
        }
    }
    if member.name == "classes" or member.name == "namespaces" or member.name == "enums" {
        var tree_receiver = type_shape.as_class_ref(object_result_type)
        if tree_receiver {
            if tree_receiver.c_name == "Spite_Namespace" {
                namespace_tree_used = true
                note_fact("flag namespace_tree_used")
            }
        }
    }
    if member.name == "memory" {
        item_reflect_type(object_result_type)
        var in_frame = not framed_object_name(member.object, scope).is_empty()
        var memory_read = generate_memory_read(object_result, member.object, in_frame)
        if memory_read {
            return memory_read
        }
    }
    var reflection = generate_reflection_read(member.name, object_result, member.object)
    if reflection {
        return reflection
    }
    if type_shape.is_arguments(object_result_type) {
        var string_spite_type = string_type()
        var nullable_type = nullable_type_of(string_spite_type)
        var flag_name = member.name.replace("_", "-")
        var lookup_result = ExpressionResult(
            "SpiteArguments_lookup(&({object_result.code}), \"{flag_name}\")",
            nullable_type,
        )
        lookup_result.owning_override = true
        return lookup_result
    }
    var read_union = type_shape.as_union(object_result_type)
    if read_union {
        var read_union_information = find_union_by_c_name(read_union.c_name)
        crash read_union_information
        var no_arguments = List<Syntax.Expressions.Expression>()
        return generate_union_dispatch(
            read_union_information,
            member.name,
            false,
            object_result,
            member.object,
            no_arguments,
            scope,
            class_information,
        )
    }
    if type_shape.as_string(object_result_type) {
        var string_field = string_storage_read(member.name, object_result, member.object, class_information)
        if string_field {
            return string_field
        }
    }
    var list_field = library_list_field(object_result_type, member.name, class_information)
    if list_field {
        var list_field_type = list_field.type
        return ExpressionResult("({object_result.code})->{c_value_name(member.name)}", list_field_type)
    }
    var object_class_ref = type_shape.as_class_ref(object_result_type)
    if not object_class_ref {
        var held = library_function_value(member, object_result, scope, class_information)
        if held {
            return held
        }
        switch object_result_type {
            Analysis.Types.NullableType: {
                var shown_read_type = type_with_article(object_result_type)
                report(
                    "{null_opening(object_result.code, shown_read_type)}, so '{member.name}' cannot be read from it yet: {null_advice(object_result.code)}",
                )
            }
            Analysis.Types.VoidType: report("'{member.name}' cannot be read from this value")
            _: {
                report(
                    "'{member.name}' cannot be read from {type_with_article(object_result_type)}: if it is a function, call it with '{member.name}()'",
                )
            }
        }
        return void_result()
    }
    var target_class = find_class_by_c_name(object_class_ref.c_name)
    crash target_class
    if not member.walked {
        report_private_member(target_class, member.name, class_information)
    }
    mark_attribute_read(target_class, member.name)
    var getter = find_getter(target_class, member.name, class_information)
    if getter {
        var empty_types = no_types()
        var getter_return_type = getter.return_type
        var getter_arguments = List<Syntax.Expressions.Expression>()
        var getter_call = generate_generic_call(
            getter.c_name,
            object_result,
            member.object,
            getter_arguments,
            empty_types,
            getter_return_type,
            scope,
            class_information,
        )
        getter_call.owning_override = true
        return getter_call
    }
    var field = target_class.find_field(member.name)
    if not field {
        var found_function = find_or_instantiate_function(target_class, member.name)
        if found_function {
            if not found_function.is_constructor {
                report_captured_borrow(member, object_result, scope, class_information)
                return function_value(target_class, found_function, object_result, member.object)
            }
        }
        var qualified = class_qualified_function_message(member, class_information)
        if not qualified.is_empty() {
            report(qualified)
            return void_result()
        }
        report("'{type_display_name(object_result_type)}' has no attribute '{member.name}'")
        return void_result()
    }
    var hardcoded = hardcoded_setting(target_class, member.name)
    if hardcoded and not read_when_running(hardcoded, class_information) {
        return hardcoded_setting_value(hardcoded, scope, class_information)
    }
    var peeked_field_type = field.type
    var scalar_default = not type_needs_drop(peeked_field_type) and constant_scalar_code(field.default_value_code)
    if object_result.peek_union and scalar_default {
        var peeked = peeked_code(object_result)
        var peeked_temporary = next_temporary()
        var peeked_place = field_place("({peeked_temporary})", target_class, member.name)
        var peeked_read = "(\{ {c_type_name(object_result_type)} {peeked_temporary} = {peeked}; {peeked_temporary} != 0 ? {peeked_place} : ({field.default_value_code}); })"
        return ExpressionResult(peeked_read, peeked_field_type)
    }
    if stays_with_singleton(target_class, field) {
        var stable_type = field.type
        var stable_place = field_place("({object_result.code})", target_class, member.name)
        var stable_read = ExpressionResult(stable_place, stable_type)
        stable_read.owning_override = false
        return stable_read
    }
    if reads_changing_singleton(target_class, class_information) {
        return guarded_outside_read(target_class, object_result, member.object, field)
    }
    if owns(object_result, member.object) {
        var object_temporary = next_temporary()
        var field_temporary = next_temporary()
        var lines = List<String>()
        lines.append("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
        var field_code = field_place("({object_temporary})", target_class, member.name)
        var field_type = field.type
        if type_needs_drop(field_type) {
            field_code = retain_call(field_type, field_code)
        }
        lines.append("{c_type_name(field_type)} {field_temporary} = {field_code};")
        lines.append("{release_call(object_result_type, object_temporary)};")
        lines.append("{field_temporary};")
        var owned_read = ExpressionResult("(\{ {lines.join(" ")} })", field_type)
        owned_read.owning_override = true
        return owned_read
    }
    var field_type = field.type
    var alias_place = field_place("({object_result.code})", target_class, member.name)
    var alias_read = ExpressionResult(alias_place, field_type)
    alias_read.owning_override = false
    if type_needs_drop(field_type) and is_row_name(member.object, scope) {
        alias_read.borrowed_from = operand_text(member.object)
    }
    return alias_read
}

func generate_expression(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    expression_depth = expression_depth + 1
    var result = generate_expression_kind(expression, scope, class_information)
    expression_depth = expression_depth - 1
    if crash_capturing {
        capture_crash_part(expression, result)
    }
    return result
}

func capture_crash_part(expression: Syntax.Expressions.Expression, result: ExpressionResult) {
    var index = 0
    while index < crash_parts.count() {
        var part = crash_parts[index]
        var candidate = part.expression
        if candidate == expression {
            capture_into(part, expression, result)
            return
        }
        index = index + 1
    }
}

func capture_into(part: CrashPart, expression: Syntax.Expressions.Expression, result: ExpressionResult) {
    if part.is_reach {
        result.code = "({part.set_name} = true, ({result.code}))"
        return
    }
    var result_type = result.type
    assert part.is_call and is_shown_type(result_type)
    part.captured_type = result_type
    part.owned = owns(result, expression) and type_needs_drop(result_type)
    if part.owned {
        result.owning_override = false
    }
    result.code = "({part.set_name} = true, {part.value_name} = ({result.code}))"
}

func generate_expression_kind(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if shape.is_true_literal(expression) {
        var result_type = Analysis.Types.ScalarType('boolean_kind')
        return ExpressionResult("true", result_type)
    }
    if shape.is_false_literal(expression) {
        var result_type = Analysis.Types.ScalarType('boolean_kind')
        return ExpressionResult("false", result_type)
    }
    var integer_literal = shape.as_integer_literal(expression)
    if integer_literal {
        return generate_integer_literal(integer_literal)
    }
    var float_literal = shape.as_float_literal(expression)
    if float_literal {
        var literal_code: String = float_literal.value
        if not literal_code.contains(".") and not literal_code.contains("e") {
            literal_code = "{literal_code}.0"
        }
        var result_type = Analysis.Types.ScalarType('float_kind')
        return ExpressionResult(literal_code, result_type)
    }
    var string_literal = shape.as_string_literal(expression)
    if string_literal {
        var rendered_string_literal = render_string_literal(string_literal.value)
        var result_type = Analysis.Types.StringType()
        return ExpressionResult(rendered_string_literal, result_type)
    }
    var identifier = shape.as_identifier(expression)
    if identifier {
        return generate_identifier(identifier, scope, class_information)
    }
    var generic_identifier = shape.as_generic_identifier(expression)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        return generate_codegen_value(bare_name, class_information)
    }
    var enum_literal = shape.as_enum_literal(expression)
    if enum_literal {
        var only_enum = find_enum_with_value(enum_literal.value)
        if only_enum {
            var enum_type = enum_type_of(only_enum)
            return ExpressionResult("{only_enum.c_name}_{enum_literal.value}", enum_type)
        }
        report("cannot tell which enum '{enum_literal.value}' belongs to here")
        return void_result()
    }
    var list_literal = shape.as_list_literal(expression)
    if list_literal {
        return generate_untyped_list_literal(list_literal, scope, class_information)
    }
    var object_literal = shape.as_object_literal(expression)
    if object_literal {
        if object_literal.is_dictionary {
            return generate_untyped_dictionary_literal(object_literal, scope, class_information)
        }
        return generate_object_literal(object_literal, scope, class_information)
    }
    var generic_call = shape.as_generic_call(expression)
    if generic_call {
        var constructed = generate_generic_constructor(generic_call, scope, class_information)
        pending_calls.append(expression)
        pending_call_lines.append(current_line)
        return constructed
    }
    var index_expression = shape.as_index(expression)
    if index_expression {
        return generate_index_read(index_expression, scope, class_information)
    }
    var unary = shape.as_unary(expression)
    if unary {
        return generate_unary(unary, scope, class_information)
    }
    var binary = shape.as_binary(expression)
    if binary {
        return generate_binary(binary, scope, class_information)
    }
    var call = shape.as_call(expression)
    if call {
        var called = generate_call(call, scope, class_information)
        pending_calls.append(expression)
        pending_call_lines.append(current_line)
        return called
    }
    var member = shape.as_member(expression)
    if member {
        return generate_member_read(member, scope, class_information)
    }
    if shape.is_null_literal(expression) {
        report(
            "'null' is not a value to compare against or pass around: narrow the value instead, with 'if value \{ } else \{ }', 'assert value', 'crash value' or 'switch value \{ <Type>: ... Null: ... }'",
        )
        return void_result()
    }
    report("unsupported expression kind in this stage")
    return void_result()
}

func undo_proofs_after_calls(scope: Scope, class_information: Analysis.ClassInfo) {
    assert not pending_calls.is_empty()
    var calls = pending_calls
    var lines = pending_call_lines
    pending_calls = List<Syntax.Expressions.Expression>()
    pending_call_lines = List<Integer>()
    var saved_line = current_line
    var index = 0
    while index < calls.count() {
        crash lines[index]
        current_line = lines[index]
        undo_after_call(calls[index], scope, class_information)
        index = index + 1
    }
    current_line = saved_line
}

func undo_after_call(called: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo) {
    var call = shape.as_call(called)
    if call {
        crash call.callee
        undo_proofs_after_call(call.callee, call.arguments, scope, class_information)
        return
    }
    var construction = shape.as_generic_call(called)
    crash construction
    crash construction.callee
    undo_proofs_after_call(construction.callee, construction.arguments, scope, class_information)
}

func undo_proofs_after_call(
    callee: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert scope.holds_proofs()
    var effects = called_effects(callee, scope, class_information)
    assert not effects.is_empty()
    var crossed = List<String>()
    var paths = scope.visible_narrowed_paths()
    var path_index = 0
    while path_index < paths.count() {
        var path = paths[path_index]
        var dependencies = proof_dependencies(path, scope, class_information)
        var effect = changing_effect(effects, dependencies, path, arguments)
        if path.starts_with("~+[") or path.starts_with("~-[") {
            effect = ""
        }
        if not effect.is_empty() {
            var crossed_loop_readers = List<String>()
            if scope.forget_path(path, true, crossed_loop_readers) {
                crossed.append(path)
            }
        }
        path_index = path_index + 1
    }
    var attributes = scope.narrowed_attributes()
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        var attribute_dependency = ["{class_information.qualified_dotted}#{attribute}"]
        var effect = changing_effect(effects, attribute_dependency, attribute, arguments)
        if not effect.is_empty() and scope.forget_override(attribute, false) {
            crossed.append(attribute)
        }
        attribute_index = attribute_index + 1
    }
    assert not crossed.is_empty()
    var printer = Syntax.SourcePrinter()
    var callee_text = printer.source_expression(callee)
    var crossed_text = crossed.join("', '")
    report(
        "'{callee_text}()' inside this loop may change '{crossed_text}', which undoes what was proven about it before the loop, and the next pass would read it unproven: prove it inside the loop instead",
    )
}

func called_effects(
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var unknown = ["field:*", "shrink:*", "grow:*"]
    var identifier = shape.as_identifier(callee)
    if identifier {
        var held = scope.written_type(identifier.name)
        var held_field = class_information.find_field(identifier.name)
        if held or held_field {
            return unknown
        }
        if call_effects.names_a_class(identifier.name) {
            var constructed = effects_class_of(callee, class_information)
            return call_effects.effects_of(constructed, identifier.name)
        }
        return call_effects.effects_of(class_information.qualified_dotted, identifier.name)
    }
    var member = shape.as_member(callee)
    if member {
        if member.name == "call_function" {
            return unknown
        }
        if call_effects.names_a_class(member.name) {
            var constructed = effects_class_of(callee, class_information)
            return call_effects.effects_of(constructed, member.name)
        }
        crash member.object
        var owner = receiver_owner(member.object, scope, class_information)
        var effects = call_effects.effects_of(owner, member.name)
        if not resizes_unnamed_collection(member, owner) {
            return effects
        }
        var widened = effects.copy()
        if grows_storage(member.name) {
            widened.append("grow:*")
        } else {
            widened.append("shrink:*")
        }
        return widened
    }
    return unknown
}

func grows_storage(name: String): Boolean {
    var growing = ["append", "prepend", "insert", "reserve", "make_room", "_make_room", "_reserve_exactly"]
    return growing.contains(name)
}

func resizes_storage(name: String): Boolean {
    return grows_storage(name) or shrinks_storage(name)
}

func shrinks_storage(name: String): Boolean {
    var shrinking = ["remove_at", "remove_first", "remove_last", "remove_swapping", "clear", "truncate", "swap"]
    return shrinking.contains(name) or name.starts_with("remove_where")
}

func resizes_unnamed_collection(member: Syntax.Expressions.MemberExpression, owner: String): Boolean {
    var collections = ["List", "Vector", "Items", "Dictionary", "*"]
    if not resizes_storage(member.name) or not collections.contains(owner) {
        return false
    }
    crash member.object
    return not is_name_path(member.object) and not shape.as_generic_call(member.object)
}

func receiver_owner(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var construction = shape.as_generic_call(expression)
    if construction {
        crash construction.callee
        var constructed = effects_class_of(construction.callee, class_information)
        if call_effects.class_names.has(constructed) {
            return constructed
        }
        return "*"
    }
    var receiver_type = receiver_type_of(expression, scope, class_information)
    if receiver_type {
        return owner_name(receiver_type)
    }
    return "*"
}

func receiver_type_of(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var identifier = shape.as_identifier(expression)
    if identifier {
        var local_type = scope.written_type(identifier.name)
        if local_type {
            return local_type
        }
        var field = class_information.find_field(identifier.name)
        assert field
        return field.type
    }
    var construction = shape.as_generic_call(expression)
    if construction {
        var made = generic_singleton_made(construction, class_information.qualified_dotted)
        assert made
        var made_type: Analysis.SpiteType = Analysis.Types.ClassRefType(made.c_name)
        return made_type
    }
    var indexed = shape.as_index(expression)
    if indexed {
        crash indexed.object
        var listed_type = receiver_type_of(indexed.object, scope, class_information)
        return indexed_type_through(listed_type)
    }
    var call = shape.as_call(expression)
    if call {
        return call_result_type(call, scope, class_information)
    }
    var member = shape.as_member(expression)
    assert member
    crash member.object
    var object_type = receiver_type_of(member.object, scope, class_information)
    return member_type_through(object_type, member.name)
}

func indexed_type_through(spite_type: Analysis.SpiteType?): Analysis.SpiteType? {
    assert spite_type
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.inner
    }
    var listed = type_shape.as_list(plain)
    if listed {
        return listed.element
    }
    var dictionary = type_shape.as_dictionary(plain)
    if dictionary {
        return dictionary.element
    }
    return returned_type_through(plain, "get_at")
}

func call_result_type(
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    crash call.callee
    var constructed = try_resolve_static_path(call.callee, class_information.qualified_dotted)
    if constructed {
        var constructed_type: Analysis.SpiteType = Analysis.Types.ClassRefType(constructed.c_name)
        return constructed_type
    }
    var identifier = shape.as_identifier(call.callee)
    if identifier {
        assert not scope.written_type(identifier.name) and not class_information.find_field(identifier.name)
        var own = class_information.find_function(identifier.name)
        assert own
        return own.return_type
    }
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    var object_type = receiver_type_of(member.object, scope, class_information)
    return returned_type_through(object_type, member.name)
}

func returned_type_through(spite_type: Analysis.SpiteType?, name: String): Analysis.SpiteType? {
    assert spite_type
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.inner
    }
    var listed = type_shape.as_list(plain)
    if listed {
        var element = listed.element
        var list_member = list_class_of(element).find_function(name)
        assert list_member
        return list_member.return_type
    }
    var class_ref = type_shape.as_class_ref(plain)
    assert class_ref and not class_ref.has_signature
    var owner_class = find_class_by_c_name(class_ref.c_name)
    assert owner_class
    var function = owner_class.find_function(name)
    assert function
    return function.return_type
}

func changing_effect(
    effects: List<String>,
    dependencies: List<String>,
    path: String,
    arguments: List<Syntax.Expressions.Expression>,
): String {
    var index = 0
    while index < effects.count() {
        var effect = effects[index]
        if effect_changes(effect, dependencies, path, arguments) {
            return effect
        }
        index = index + 1
    }
    return ""
}

func effect_changes(
    effect: String,
    dependencies: List<String>,
    path: String,
    arguments: List<Syntax.Expressions.Expression>,
): Boolean {
    if effect.starts_with("parameter:") {
        var passed = passed_list_path(effect, arguments)
        return not passed.is_empty() and path.starts_with("{passed}[")
    }
    var index = 0
    while index < dependencies.count() {
        var dependency = dependencies[index]
        if dependency_changes(effect, dependency) {
            return true
        }
        index = index + 1
    }
    return false
}

func dependency_changes(effect: String, dependency: String): Boolean {
    if effect == "release" or effect.starts_with("grow:") or effect.starts_with("release:") or effect.starts_with("store:") {
        return false
    }
    var is_list = dependency.starts_with("list:")
    if effect == "field:*" {
        return not is_list
    }
    if effect == "shrink:*" or effect.starts_with("shrink:") and effect.ends_with("[]") {
        return is_list
    }
    var effect_length = effect.length()
    if effect.starts_with("shrink:") {
        if not is_list {
            return false
        }
        var shrunk_link = effect.slice(7, effect_length)
        var dependency_length = dependency.length()
        var list_link = dependency.slice(5, dependency_length)
        return links_meet(shrunk_link, list_link)
    }
    if is_list {
        return false
    }
    var written_link = effect.slice(6, effect_length)
    return links_meet(written_link, dependency)
}

func links_meet(changed_link: String, link: String): Boolean {
    var changed_parts = changed_link.split("#")
    var parts = link.split("#")
    if changed_parts.count() != 2 or parts.count() != 2 {
        return false
    }
    var same_class = changed_parts[0] == "*" or parts[0] == "*" or changed_parts[0] == parts[0]
    return same_class and changed_parts[1] == parts[1]
}

func passed_list_path(effect: String, arguments: List<Syntax.Expressions.Expression>): String {
    var effect_length = effect.length()
    var position_text = effect.slice(10, effect_length)
    var position = position_text.to_integer()
    crash position
    if position >= arguments.count() {
        return ""
    }
    return operand_text(arguments[position])
}

func proof_dependencies(path: String, scope: Scope, class_information: Analysis.ClassInfo): List<String> {
    var dependencies = List<String>()
    var root = scope.path_root(path)
    var current = scope.written_type(root)
    var link = "local"
    var position = root.length()
    var constructed = constructed_root_of(path)
    var root_local = scope.unnarrowed_type(root)
    if not constructed.is_empty() {
        crash constructed_roots[constructed]
        var made_type: Analysis.SpiteType = Analysis.Types.ClassRefType(constructed_roots[constructed])
        current = made_type
        position = constructed.length()
    } else if not root_local {
        link = "{class_information.qualified_dotted}#{root}"
        dependencies.append(link)
        var root_field = class_information.find_field(root)
        if root_field {
            current = root_field.type
        }
    }
    var path_length = path.length()
    while position < path_length {
        var code = path.code_at(position)
        if code == 46 {
            var name_end = scope.name_end(path, position + 1)
            var member_name = path.slice(position + 1, name_end)
            var owner = owner_name(current)
            link = "{owner}#{member_name}"
            dependencies.append(link)
            current = member_type_through(current, member_name)
            position = name_end
        } else {
            var key_end = scope.key_end(path, position)
            var key_text = path.slice(position + 1, key_end)
            collect_key_dependencies(key_text, scope, class_information, dependencies)
            dependencies.append("list:{link}")
            current = element_type_through(current)
            link = "element"
            position = key_end + 1
        }
    }
    return dependencies
}

func owner_name(spite_type: Analysis.SpiteType?): String {
    var owner_class = class_behind(spite_type)
    if owner_class {
        return owner_class.qualified_dotted
    }
    return collection_name(spite_type)
}

func collection_name(spite_type: Analysis.SpiteType?): String {
    if not spite_type {
        return ""
    }
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.inner
    }
    if type_shape.as_list(plain) {
        return "List"
    }
    if type_shape.as_dictionary(plain) {
        return "Dictionary"
    }
    if type_shape.as_string(plain) {
        return "String"
    }
    return "*"
}

func class_behind(spite_type: Analysis.SpiteType?): Analysis.ClassInfo? {
    assert spite_type
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.inner
    }
    var class_ref = type_shape.as_class_ref(plain)
    assert class_ref
    return find_class_by_c_name(class_ref.c_name)
}

func member_type_through(spite_type: Analysis.SpiteType?, member_name: String): Analysis.SpiteType? {
    var owner_class = class_behind(spite_type)
    assert owner_class
    return member_type_of(owner_class, member_name)
}

func element_type_through(spite_type: Analysis.SpiteType?): Analysis.SpiteType? {
    assert spite_type
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.inner
    }
    var listed = type_shape.as_list(plain)
    assert listed
    return listed.element
}

func collect_key_dependencies(
    key_text: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    dependencies: List<String>,
) {
    var position = 0
    var key_length = key_text.length()
    var previous = 0
    while position < key_length {
        var name_end = scope.name_end(key_text, position)
        var starts_word = name_end > position and not scope.is_name_code(previous)
        if starts_word {
            var word = key_text.slice(position, name_end)
            add_key_dependency(word, previous == 46, scope, class_information, dependencies)
            position = name_end
        } else {
            position = position + 1
        }
        previous = key_text.code_at(position - 1)
    }
}

func add_key_dependency(
    word: String,
    after_dot: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    dependencies: List<String>,
) {
    if after_dot {
        dependencies.append("*#{word}")
        return
    }
    var local = scope.unnarrowed_type(word)
    assert not local
    var field = class_information.find_field(word)
    assert field
    dependencies.append("{class_information.qualified_dotted}#{word}")
}

func narrow_by_guard(scope: Scope, guard: NullableGuard, check: String) {
    scope.note_site(guard.name, "{check} on line {current_line}")
    if guard.override_code.is_empty() {
        scope.narrow_path(guard.name)
        if not guard.kept_code.is_empty() {
            scope.keep_read(guard.name, guard.kept_code)
        }
    } else {
        scope.set_override(guard.name, guard.override_code)
        var guard_inner = guard.inner
        scope.declare(guard.name, guard_inner)
    }
}

func try_nullable_guard(
    condition_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NullableGuard? {
    var identifier = shape.as_identifier(condition_ast)
    if not identifier {
        return try_path_guard(condition_ast, scope, class_information)
    }
    var static_type = lookup_static_type(condition_ast, scope, class_information)
    assert static_type
    var handle = joinable_handle(static_type)
    if handle {
        return joined_guard(identifier.name, condition_ast, handle, scope, class_information)
    }
    var nullable = type_shape.as_nullable(static_type)
    assert nullable
    var base_result = generate_expression(condition_ast, scope, class_information)
    var inner = nullable.inner
    report_maybe_boolean(base_result, "a condition")
    var guard_code = ""
    var override_code = ""
    if type_is_reference(inner) {
        guard_code = present_code(base_result.code, inner)
        override_code = base_result.code
    } else {
        guard_code = "({base_result.code}).has_value"
        override_code = "({base_result.code}).value"
    }
    return NullableGuard(identifier.name, inner, guard_code, override_code)
}

func joined_guard(
    name: String,
    condition_ast: Syntax.Expressions.Expression,
    handle: Analysis.ClassInfo,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NullableGuard? {
    crash handle.codegen_types[0]
    var result_type = handle.codegen_types[0]
    var nullable = type_shape.as_nullable(result_type)
    assert nullable
    var joined_ast = implicit_join_ast(condition_ast)
    var joined = generate_expression(joined_ast, scope, class_information)
    report_maybe_boolean(joined, "a condition")
    var held_name = next_temporary()
    var held = c_value_name(held_name)
    builder.add_user("{c_type_name(result_type)} {held} = {joined.code};")
    scope.declare_owned(held_name, result_type)
    var inner = nullable.inner
    if type_is_reference(inner) {
        var held_present = present_code(held, inner)
        return NullableGuard(name, inner, held_present, held)
    }
    return NullableGuard(name, inner, "({held}).has_value", "({held}).value")
}

func try_path_guard(
    condition_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NullableGuard? {
    var path = operand_text(condition_ast)
    assert not path.is_empty() and not is_caller_call(condition_ast) and not is_shape_member_read(condition_ast)
    assert not is_text_member_read(condition_ast)
    var links = path_links(condition_ast, class_information.qualified_dotted)
    var keeping = keeping_guard_reads
    keeping_guard_reads = false
    var kept_code = ""
    var probe_scope = Scope(scope)
    var tests = List<String>()
    var link_tests = List<String>()
    var inner: Analysis.SpiteType? = null
    var index = 0
    while index < links.count() {
        var link = links[index]
        if index > 0 {
            conditional_depth = conditional_depth + 1
        }
        var link_result = generate_expression(link, probe_scope, class_information)
        if index > 0 {
            conditional_depth = conditional_depth - 1
        }
        inner = null
        var link_result_type = link_result.type
        var link_nullable = type_shape.as_nullable(link_result_type)
        report_maybe_boolean(link_result, "a condition")
        if link_nullable {
            var link_inner = link_nullable.inner
            inner = link_inner
            var link_condition = ""
            if keeping and index == links.count() - 1 and keeps_dictionary_read(link, link_inner, probe_scope, class_information) {
                var kept = next_temporary()
                builder.add_user("{c_type_name(link_result_type)} {kept};")
                link_condition = "(({kept} = {link_result.code}).has_value)"
                kept_code = "{kept}.value"
            }
            if link_condition.is_empty() {
                link_condition = slot_presence_test(link_result, link, link_inner, probe_scope, class_information)
            }
            if link_condition.is_empty() {
                link_condition = link_test(link_result, link, link_inner)
            }
            tests.append(link_condition)
            link_tests.append(link_condition)
        } else {
            link_tests.append("")
        }
        var link_text = operand_text(link)
        probe_scope.narrow_path(link_text)
        index = index + 1
    }
    assert inner
    var joined_tests = tests.join(" && ")
    var guard = NullableGuard(path, inner, joined_tests, "")
    guard.links = links
    guard.link_tests = link_tests
    guard.kept_code = kept_code
    return guard
}

# ../../../docs/optimizations.md#a-dictionary-hashes-a-key-once-cheaply
func keeps_dictionary_read(
    link: Syntax.Expressions.Expression,
    inner: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if type_is_reference(inner) or type_needs_drop(inner) {
        return false
    }
    var indexed = shape.as_index(link)
    if not indexed {
        return false
    }
    crash indexed.object
    var object_type = lookup_static_type(indexed.object, scope, class_information)
    if not object_type {
        return false
    }
    if type_shape.as_dictionary(object_type) {
        return true
    }
    return false
}

func path_links(
    expression: Syntax.Expressions.Expression,
    current_namespace: String,
): List<Syntax.Expressions.Expression> {
    var indexed = shape.as_index(expression)
    if indexed {
        if indexed.object {
            var indexed_links = path_links(indexed.object, current_namespace)
            indexed_links.append(expression)
            return indexed_links
        }
    }
    var member = shape.as_member(expression)
    if member {
        if member.object {
            if not try_resolve_static_path(expression, current_namespace) {
                var links = path_links(member.object, current_namespace)
                links.append(expression)
                return links
            }
        }
    }
    return List<Syntax.Expressions.Expression>()
}

func link_test(
    link_result: ExpressionResult,
    link_ast: Syntax.Expressions.Expression,
    inner: Analysis.SpiteType,
): String {
    if not type_is_reference(inner) {
        return "(({link_result.code}).has_value)"
    }
    if type_needs_drop(inner) and owns(link_result, link_ast) {
        var value_temporary = next_temporary()
        return "(\{ {c_type_name(inner)} {value_temporary} = {link_result.code}; int path_narrowed = {present_code(value_temporary, inner)}; {release_call(inner, value_temporary)}; path_narrowed; })"
    }
    return present_code(link_result.code, inner)
}

# ../../../docs/optimizations.md#a-list-item-read-only-to-test-it-is-not-counted
func slot_presence_test(
    link_result: ExpressionResult,
    link_ast: Syntax.Expressions.Expression,
    inner: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if not type_needs_drop(inner) or not owns(link_result, link_ast) {
        return ""
    }
    var read = shape.as_index(link_ast)
    if not read {
        return ""
    }
    crash read.object
    crash read.index
    if not plain_path(read.object) or not plain_index(read.index) {
        return ""
    }
    var list_type = receiver_type_of(read.object, scope, class_information)
    if not list_type {
        return ""
    }
    var listed = type_shape.as_list(list_type)
    if not listed {
        return ""
    }
    var element = listed.element
    var stored = element
    var maybe_element = type_shape.as_nullable(element)
    if maybe_element {
        stored = maybe_element.inner
    }
    var element_class = type_shape.as_class_ref(stored)
    var plain_class = false
    if element_class {
        plain_class = not element_class.has_signature
    }
    if not plain_class and not type_shape.as_string(stored) {
        return ""
    }
    var list_class = list_class_of(element)
    if not is_library_class(list_class) {
        return ""
    }
    var list_result = generate_expression(read.object, scope, class_information)
    if owns(list_result, read.object) {
        return ""
    }
    var integer_spite_type = integer_type()
    var index_code = coerce_for_store(read.index, integer_spite_type, scope, class_information)
    var list_temporary = next_temporary()
    var index_temporary = next_temporary()
    var item = list_item_code(element, list_temporary, index_temporary)
    var inside = "{index_temporary} >= 0 && {index_temporary} < ({list_temporary})->item_count_"
    return "(\{ {c_type_name(list_type)} {list_temporary} = {list_result.code}; int32_t {index_temporary} = {index_code}; ({inside}) && {present_code(item, inner)}; })"
}

func plain_index(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_identifier(expression) or shape.as_integer_literal(expression) {
        return true
    }
    if shape.as_member(expression) {
        return plain_path(expression)
    }
    var binary = shape.as_binary(expression)
    if binary {
        crash binary.left
        crash binary.right
        if binary.operator != 'add' and binary.operator != 'subtract' {
            return false
        }
        return plain_index(binary.left) and plain_index(binary.right)
    }
    return false
}

func emit_scope_drops(scope: Scope, all_the_way_up: Boolean) {
    var index = scope.owned.count() - 1
    while index >= 0 {
        crash scope.owned[index]
        var owned_local = scope.owned[index]
        var owned_local_type = owned_local.type
        var owned_code = c_value_name(owned_local.name)
        if not owned_local.framed {
            if drop_may_wait(owned_local_type) {
                wait_for_released(owned_local_type, owned_code)
            }
            builder.add_user("{release_call(owned_local_type, owned_code)};")
        }
        if not owned_local.framed_cleanup.is_empty() {
            builder.add_user("{owned_local.framed_cleanup};")
        }
        index = index - 1
    }
    assert all_the_way_up
    assert scope.parent
    emit_scope_drops(scope.parent, true)
}

func generate_variable_declaration(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var start: NumberRange? = null
    var ranged = ranges_proven()
    if ranged and declaration.value {
        start = value_range(declaration.value, scope, class_information)
    }
    store_declaration(declaration, scope, class_information)
    if ranged {
        declare_range(declaration, start, scope)
    }
}

func store_declaration(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    scope.forget_room(declaration.name)
    assert declaration.value
    report_replaced_item(declaration, scope, class_information)
    assert not constant_local(declaration, scope, class_information)
    assert not folds_dictionary_local(declaration, scope, class_information)
    folded_dictionaries.remove(declaration.name)
    if pending_allocator {
        generate_allocated_declaration(declaration, pending_allocator, scope, class_information)
        return
    }
    if declaration.type_reference and shape.is_null_literal(declaration.value) {
        var null_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
        var nothing_yet = type_shape.as_nullable(null_type) or type_shape.is_void(null_type)
        if not nothing_yet and not filled_by_walk(declaration, class_information) {
            report_null_default(declaration, null_type, "variable")
        }
    }
    var frame_key = placement.frame_key(declaration)
    var frame_placed = frame_candidates.contains("{current_path}:{current_function}:{frame_key}") and not scope.entry_names.contains(declaration.name) and placed_in_frame(declaration, scope, class_information)
    assert not frame_placed
    var borrowed = borrowed_element(declaration, scope, class_information)
    if not borrowed.is_empty() {
        var element_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
        builder.add_user("{c_type_name(element_type)} {c_value_name(declaration.name)} = {borrowed};")
        scope.declare(declaration.name, element_type)
        scope.check_last(current_line)
        check_value_name(declaration.name, "variable")
        borrowed_names.append(declaration.name)
        return
    }
    var uncounted = uncounted_slot_read(declaration, scope, class_information)
    if not uncounted.is_empty() {
        var read_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
        mark_names_used_in(declaration.value, scope)
        builder.add_user("{c_type_name(read_type)} {c_value_name(declaration.name)} = {uncounted};")
        scope.declare(declaration.name, read_type)
        scope.held_names.append(declaration.name)
        scope.check_last(current_line)
        check_value_name(declaration.name, "variable")
        return
    }
    assert not lends_to_local(declaration, scope, class_information)
    assert not lends_row(declaration, scope, class_information)
    assert not lends_walked_row(declaration, scope, class_information)
    assert not frames_local_list(declaration, scope, class_information)
    assert not frames_local_object(declaration, scope, class_information)
    var declared_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
    borrow_site = "local:{declaration.name}"
    frame_variadic_allowed = not resumable_mode
    var value_code = coerce_for_store(declaration.value, declared_type, scope, class_information)
    frame_variadic_allowed = false
    borrow_site = ""
    if not declaration.type_reference or not current_class_is_generic() {
        report_copy_for_narrowing(declaration.name, declaration.value, declared_type, scope, class_information)
    }
    if scope.entry_names.contains(declaration.name) {
        value_code = rebind(declaration.name, value_code, declared_type, scope)
    }
    builder.add_user("{c_type_name(declared_type)} {c_value_name(declaration.name)} = {value_code};")
    framed_cleanups.each(builder.add_user)
    framed_cleanups.clear()
    if type_needs_drop(declared_type) {
        scope.declare_owned(declaration.name, declared_type)
        scope.check_last(current_line)
        check_value_name(declaration.name, "variable")
    } else {
        scope.declare(declaration.name, declared_type)
        scope.check_last(current_line)
        check_value_name(declaration.name, "variable")
    }
}

func lends_items(target_class: Analysis.ClassInfo, name: String): Boolean {
    var vector_item = holds_items_inline(target_class) and lends_by_name(target_class, name)
    var inline_item = target_class.qualified_dotted == "InlineMemory" and name == "item_at"
    if not vector_item and not inline_item {
        return false
    }
    if target_class.codegen_types.count() <= 0 {
        return false
    }
    var item_class = inline_item_class(target_class.codegen_types[0])
    if not item_class {
        return false
    }
    return true
}

func lends_by_name(target_class: Analysis.ClassInfo, name: String): Boolean {
    if name == "get_at" {
        return true
    }
    var index = 0
    while index < target_class.templates.count() {
        var template = target_class.templates[index]
        var declaration = template.declaration
        if not template.member_name_for(name).is_empty() and declares_an_item(declaration) {
            return true
        }
        index = index + 1
    }
    return false
}

func declares_an_item(declaration: Syntax.Statements.FunctionDeclaration): Boolean {
    if not declaration.return_type {
        return false
    }
    var spelled = Syntax.SourcePrinter().source_type(declaration.return_type)
    return spelled == "$element_type" or spelled == "$element_type?"
}

func holds_items_inline(information: Analysis.ClassInfo): Boolean {
    if information.qualified_dotted == "Vector" {
        return true
    }
    return is_items_class(information) and items_fit_vector(information)
}

func plain_item_type(item_type: Analysis.SpiteType): Boolean {
    return type_shape.as_scalar(item_type) or is_enum_type(item_type)
}

func is_items_class(information: Analysis.ClassInfo): Boolean {
    return information.qualified_dotted == "Items" and not information.codegen_types.is_empty()
}

func items_fit_vector(information: Analysis.ClassInfo): Boolean {
    crash information.codegen_types[0]
    var problem = vector_item_problem(information.codegen_types[0])
    return problem.is_empty()
}

func items_choice(sources: String): String {
    var named = sources.split("' and '")
    var index = 0
    while index < named.count() {
        var source_name = named[index]
        if items_sources[source_name] {
            if not items_sources[source_name].is_empty() {
                return "'{items_sources[source_name]}' fits a Vector, so the items of '{named[index]}' are borrowed: "
            }
        }
        index = index + 1
    }
    return ""
}

func lend_item(
    result: ExpressionResult,
    target_class: Analysis.ClassInfo,
    name: String,
    object_ast: Syntax.Expressions.Expression,
) {
    assert lends_items(target_class, name)
    result.owning_override = false
    var source = operand_text(object_ast)
    if source.is_empty() {
        source = Syntax.SourcePrinter().source_expression(object_ast)
    }
    result.borrowed_from = source
    note_constructed_root(object_ast)
    var label = ""
    if is_items_class(target_class) {
        crash target_class.codegen_types[0]
        label = type_display_name(target_class.codegen_types[0])
    }
    items_sources[source] = label
}

func lend_result(result: ExpressionResult, target_class: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    var source = lent_result_source(target_class, function)
    assert not source.is_empty()
    result.owning_override = false
    result.borrowed_from = source
    var root_end = source.index_of("().")
    var root = source.slice(0, root_end + 2)
    crash lent_result_singletons[source]
    constructed_roots[root] = lent_result_singletons[source]
    crash lent_result_labels[source]
    items_sources[source] = lent_result_labels[source]
}

func lent_result_source(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var key = "{information.c_name}.{function.name}"
    if lent_results[key] {
        return lent_results[key]
    }
    lent_results[key] = ""
    var returns = List<Syntax.Expressions.Expression>()
    var locals = function.parameters.map_names()
    collect_returned_values(function.body, returns, locals, information)
    var index = 0
    while index < returns.count() {
        var source = lent_return_source(returns[index], information, locals)
        if not source.is_empty() {
            lent_results[key] = source
            return source
        }
        index = index + 1
    }
    return ""
}

func collect_returned_values(
    statements: List<Syntax.Statements.Statement>,
    returns: List<Syntax.Expressions.Expression>,
    locals: List<String>,
    information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < statements.count() {
        if collect_statement_returns(statements[index], returns, locals, information) {
            return true
        }
        index = index + 1
    }
    return false
}

func collect_statement_returns(
    statement: Syntax.Statements.Statement,
    returns: List<Syntax.Expressions.Expression>,
    locals: List<String>,
    information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: locals.append(statement.name)
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                returns.append(statement.value)
            }
            return true
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            var decided: Boolean? = null
            if asks_only_codegen(statement.condition) {
                var no_locals = Scope(null)
                decided = constant_condition(statement.condition, no_locals, information)
            }
            if decided == true {
                return collect_returned_values(statement.then_branch, returns, locals, information)
            }
            if decided == false {
                return collect_returned_values(statement.else_branch, returns, locals, information)
            }
            collect_returned_values(statement.then_branch, returns, locals, information)
            collect_returned_values(statement.else_branch, returns, locals, information)
        }
        Syntax.Statements.WhileStatement: collect_returned_values(statement.body, returns, locals, information)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_returned_values(statement.cases[case_index].body, returns, locals, information)
                case_index = case_index + 1
            }
        }
        _: return false
    }
    return false
}

func asks_only_codegen(condition: Syntax.Expressions.Expression): Boolean {
    if shape.as_generic_identifier(condition) {
        return true
    }
    var unary = shape.as_unary(condition)
    if unary {
        crash unary.operand
        return unary.operator == 'logical_not' and asks_only_codegen(unary.operand)
    }
    var binary = shape.as_binary(condition)
    if binary {
        crash binary.left
        crash binary.right
        if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
            return asks_only_codegen(binary.left) and asks_only_codegen(binary.right)
        }
        if binary.operator != 'equal' and binary.operator != 'not_equal' {
            return false
        }
        if not shape.as_generic_identifier(binary.left) {
            return false
        }
        return names_a_class_path(binary.right)
    }
    var call = shape.as_call(condition)
    if not call {
        return false
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    crash member.object
    if not shape.as_generic_identifier(member.object) {
        return false
    }
    if member.name == "fits_vector" {
        return call.arguments.is_empty()
    }
    if member.name != "has_function" or call.arguments.count() != 1 {
        return false
    }
    var asked = shape.as_string_literal(call.arguments[0])
    if not asked {
        return false
    }
    return not asked.value.contains("<") and not asked.value.contains("\{")
}

func names_a_class_path(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_identifier(expression) {
        return true
    }
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    return names_a_class_path(member.object)
}

func lent_return_source(
    value: Syntax.Expressions.Expression,
    information: Analysis.ClassInfo,
    locals: List<String>,
): String {
    var storage = lent_storage_path(value)
    if not storage {
        return ""
    }
    var path = List<String>()
    if not attribute_path(storage, path) {
        return ""
    }
    var root = path.first()
    crash root
    if locals.contains(root) {
        return ""
    }
    var owner = information
    var index = 0
    while index < path.count() - 1 {
        var field = owner.find_field(path[index])
        if not field {
            return ""
        }
        var field_type = field.type
        var field_class = class_behind(field_type)
        if not field_class {
            return ""
        }
        owner = field_class
        index = index + 1
    }
    if not owner.is_singleton {
        return ""
    }
    var last = path.last()
    crash last
    var storage_field = owner.find_field(last)
    if not storage_field {
        return ""
    }
    var storage_type = storage_field.type
    var storage_class = class_behind(storage_type)
    if not storage_class or not holds_items_inline(storage_class) {
        return ""
    }
    var source = "{singleton_display_name(owner)}().{last}"
    lent_result_singletons[source] = owner.c_name
    var label = ""
    if is_items_class(storage_class) {
        crash storage_class.codegen_types[0]
        label = type_display_name(storage_class.codegen_types[0])
    }
    lent_result_labels[source] = label
    return source
}

func lent_storage_path(value: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    var indexed = shape.as_index(value)
    if indexed {
        return indexed.object
    }
    var call = shape.as_call(value)
    assert call
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member and member.name == "get_at"
    return member.object
}

func attribute_path(expression: Syntax.Expressions.Expression, path: List<String>): Boolean {
    var identifier = shape.as_identifier(expression)
    if identifier {
        path.append(identifier.name)
        return true
    }
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    if not attribute_path(member.object, path) {
        return false
    }
    path.append(member.name)
    return true
}

func singleton_display_name(information: Analysis.ClassInfo): String {
    var name = information.qualified_dotted
    if name.is_empty() {
        name = information.simple_name
    }
    if information.codegen_types.is_empty() {
        return name
    }
    var shown = display_names_of(information.codegen_types)
    return "{name}<{shown.join(", ")}>"
}

func lends_this_return(expression_ast: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): Boolean {
    crash current_class
    var function = current_class.find_function(current_function)
    if not function or function.is_constructor {
        return false
    }
    var lent = lent_result_source(class_information, function)
    if lent.is_empty() {
        return false
    }
    var locals = function.parameters.map_names()
    var ignored = List<Syntax.Expressions.Expression>()
    collect_returned_values(function.body, ignored, locals, class_information)
    return lent_return_source(expression_ast, class_information, locals) == lent
}

func lent_call_source(
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var call = shape.as_call(value)
    if not call {
        return ""
    }
    crash call.callee
    var own = shape.as_identifier(call.callee)
    if own {
        if scope.written_type(own.name) {
            return ""
        }
        var own_function = class_information.find_function(own.name)
        if not own_function {
            return ""
        }
        return lent_result_source(class_information, own_function)
    }
    var member = shape.as_member(call.callee)
    if not member {
        return ""
    }
    crash member.object
    var receiver_class = lent_receiver_class(member.object, scope, class_information)
    if not receiver_class {
        return ""
    }
    var function = receiver_class.find_function(member.name)
    if not function {
        return ""
    }
    return lent_result_source(receiver_class, function)
}

func lent_receiver_class(
    receiver: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var construction = shape.as_generic_call(receiver)
    if construction {
        crash construction.callee
        assert not construction.names_class
        var template = try_resolve_static_path(construction.callee, class_information.qualified_dotted)
        assert template and template.is_generic_template and not template.is_singleton
        return instantiate_generic(template, construction.type_arguments, class_information.qualified_dotted)
    }
    var root = shape.as_identifier(receiver)
    if root {
        assert scope.written_type(root.name) or class_information.find_field(root.name)
    }
    var receiver_type = receiver_type_of(receiver, scope, class_information)
    return class_behind(receiver_type)
}

func note_constructed_root(expression: Syntax.Expressions.Expression) {
    var root = expression
    var member = shape.as_member(root)
    while member {
        crash member.object
        root = member.object
        member = shape.as_member(root)
    }
    var construction = shape.as_generic_call(root)
    assert construction
    var made = generic_singleton_made(construction, current_owner)
    assert made
    var printer = Syntax.SourcePrinter()
    var text = printer.source_expression(root)
    constructed_roots[text] = made.c_name
}

func generic_singleton_made(
    construction: Syntax.Expressions.GenericCallExpression,
    current_namespace: String,
): Analysis.ClassInfo? {
    crash construction.callee
    assert construction.arguments.is_empty() and not construction.names_class
    var template = try_resolve_static_path(construction.callee, current_namespace)
    assert template
    assert template.is_generic_template and template.is_singleton
    return instantiate_generic(template, construction.type_arguments, current_namespace)
}

func constructed_root_of(path: String): String {
    if constructed_roots.count() <= 0 {
        return ""
    }
    var texts = constructed_roots.keys()
    var index = 0
    while index < texts.count() {
        if path.starts_with("{texts[index]}.") {
            return texts[index]
        }
        index = index + 1
    }
    return ""
}

func in_vector_library(class_information: Analysis.ClassInfo): Boolean {
    var named = class_information.qualified_dotted
    var collection = named == "Vector" or named == "InlineMemory" or named == "Items"
    return collection and current_path.starts_with("library/")
}

func may_lend(value: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    var indexed = shape.as_index(value)
    if indexed {
        crash indexed.object
        return receiver_lends(indexed.object, "get_at", scope, class_information)
    }
    var row_read = shape.as_member(value)
    if row_read {
        crash row_read.object
        if not is_row_name(row_read.object, scope) {
            return false
        }
        var saved_counter = temporary_counter
        var probe = generate_expression(value, scope, class_information)
        rewind_temporaries(saved_counter)
        return not probe.borrowed_from.is_empty()
    }
    var call = shape.as_call(value)
    if not call {
        return false
    }
    if not lent_call_source(value, scope, class_information).is_empty() {
        return true
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    crash member.object
    return receiver_lends(member.object, member.name, scope, class_information)
}

func receiver_lends(
    receiver: Syntax.Expressions.Expression,
    name: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var root = shape.as_identifier(receiver)
    if root {
        if not scope.written_type(root.name) and not class_information.find_field(root.name) {
            return false
        }
    }
    var receiver_type = receiver_type_of(receiver, scope, class_information)
    var receiver_class = class_behind(receiver_type)
    if not receiver_class {
        return false
    }
    return lends_items(receiver_class, name)
}

func lends_to_local(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash declaration.value
    if declaration.type_reference or not may_lend(declaration.value, scope, class_information) {
        return false
    }
    if scope.entry_names.contains(declaration.name) {
        var saved_counter = temporary_counter
        var probe = generate_expression(declaration.value, scope, class_information)
        rewind_temporaries(saved_counter)
        report(
            "{items_choice(probe.borrowed_from)}'{declaration.name}' already names a value earlier in this block, and an item borrowed from '{probe.borrowed_from}' is given a name of its own: call it something new, such as 'var {declaration.name}_item = ...'",
        )
        scope.mark_used(declaration.name)
        return true
    }
    var lent = generate_expression(declaration.value, scope, class_information)
    var item_type = lent.type
    var unkept = unkept_lender(declaration.value)
    if not unkept.is_empty() {
        report(
            "'{declaration.name}' would be borrowed from '{unkept}', which nothing keeps, so it is let go at the end of this line and the item with it: keep it in a 'var' first and borrow from that",
        )
        scope.declare(declaration.name, item_type)
        scope.mark_used(declaration.name)
        return true
    }
    builder.add_user("{c_type_name(item_type)} {c_value_name(declaration.name)} = {lent.code};")
    scope.declare_borrowed(declaration.name, item_type, lent.borrowed_from)
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    if in_vector_library(class_information) {
        return true
    }
    if writing_lent_arguments {
        report_lent_argument_resize(declaration.name, lent.borrowed_from, scope, class_information)
    }
    if scope.row_source(lent.borrowed_from).is_empty() {
        report_borrow_past_resize(declaration.name, lent.borrowed_from, scope, class_information)
        return true
    }
    var row_paths = scope.paths_of_row(lent.borrowed_from)
    var path_index = 0
    while path_index < row_paths.count() {
        report_borrow_past_resize(declaration.name, row_paths[path_index], scope, class_information)
        path_index = path_index + 1
    }
    return true
}

func unkept_lender(value: Syntax.Expressions.Expression): String {
    var receiver: Syntax.Expressions.Expression? = null
    var indexed = shape.as_index(value)
    if indexed {
        receiver = indexed.object
    }
    var call = shape.as_call(value)
    if call {
        crash call.callee
        var member = shape.as_member(call.callee)
        if member {
            receiver = member.object
        }
    }
    if not receiver {
        return ""
    }
    if not shape.as_call(receiver) {
        return ""
    }
    return Syntax.SourcePrinter().source_expression(receiver)
}

func lends_row(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash declaration.value
    var literal = shape.as_object_literal(declaration.value)
    if not literal or in_vector_library(class_information) {
        return false
    }
    if literal.is_dictionary {
        return false
    }
    if scope.entry_names.contains(declaration.name) or not borrows_an_item(literal, scope, class_information) {
        return false
    }
    var names = List<String>()
    var types = List<Analysis.SpiteType>()
    var codes = List<String>()
    var paths = List<String>()
    var lent_names = List<String>()
    var lent_values = List<Syntax.Expressions.Expression>()
    var lent_keys = List<String>()
    var index = 0
    var mixing = walked_row_mixing
    walked_row_mixing = false
    while index < literal.fields.count() {
        var field = literal.fields[index]
        crash field.value
        var made = made_in_frame(field.value, mixing, scope, class_information)
        var window_text = lent_window_of(field.value, mixing, scope, class_information)
        if window_text {
            var lent_function = lent_element_function(field.value, mixing, scope, class_information)
            crash lent_function
            var lent_type = lent_function.return_type
            names.append(field.name)
            types.append(lent_type)
            codes.append("")
            lent_names.append(field.name)
            lent_values.append(field.value)
            lent_keys.append(window_text)
        } else if made {
            names.append(field.name)
            var made_type = made.type
            types.append(made_type)
            codes.append(made.code)
        } else {
            var field_result = generate_expression(field.value, scope, class_information)
            var field_type = field_result.type
            var borrowed_path = borrowed_path_of(field.value, field_result, scope)
            var field_code = field_result.code
            if borrowed_path.is_empty() and type_needs_drop(field_type) {
                if not mixing {
                    report(
                        "'{declaration.name}' borrows items from a Vector, so each of its attributes is a borrowed item or a plain value: '{field.name}' holds {type_with_article(field_type)}, which the row would have to keep",
                    )
                    return true
                }
                field_code = held_for_row(field_result, field.value, field_type, scope)
            }
            if not borrowed_path.is_empty() and not paths.contains(borrowed_path) {
                paths.append(borrowed_path)
            }
            names.append(field.name)
            types.append(field_type)
            codes.append(field_code)
        }
        index = index + 1
    }
    var information = literal_class(names, types)
    var storage = next_temporary()
    builder.add_user("{information.c_name} {storage} = \{ \{ 1, {information.class_id} } };")
    var assign_index = 0
    while assign_index < names.count() {
        crash codes[assign_index]
        if not lent_names.contains(names[assign_index]) {
            builder.add_user("{storage}.{c_value_name(names[assign_index])} = {codes[assign_index]};")
        }
        assign_index = assign_index + 1
    }
    var lent_index = 0
    while lent_index < lent_names.count() {
        crash lent_values[lent_index]
        crash lent_keys[lent_index]
        var lent_value = lent_values[lent_index]
        var lent_window = lent_keys[lent_index]
        var lent_name = lent_names[lent_index]
        var lent_code = lend_site(lent_value, lent_window, scope, class_information)
        builder.add_user("{storage}.{c_value_name(lent_name)} = {lent_code};")
        lent_index = lent_index + 1
    }
    var literal_type: Analysis.SpiteType = Analysis.Types.ClassRefType(information.c_name)
    var row_type = literal_type
    if declaration.type_reference {
        row_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
    }
    var row_code = cast("(&{storage})", literal_type, row_type)
    builder.add_user("{c_type_name(row_type)} {c_value_name(declaration.name)} = {row_code};")
    var sources = paths.join("' and '")
    scope.declare_row(declaration.name, row_type, sources, paths)
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    var path_index = 0
    while path_index < paths.count() {
        var path = paths[path_index]
        var start = borrow_index + 1
        var statements = borrow_statements
        var saved_line = current_line
        if report_row_call_resize(declaration.name, path, statements, start, scope, class_information) {
            current_line = saved_line
            return true
        }
        report_borrow_past_resize(declaration.name, path, scope, class_information)
        current_line = saved_line
        path_index = path_index + 1
    }
    return true
}

func lends_walked_row(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    walk_refused = ""
    walk_refused_attribute = ""
    walk_partial = null
    walked_checks.clear()
    framed_walked_locals.clear()
    var literal = walked_row_literal(declaration, scope, class_information)
    if refused_row(scope, class_information) {
        report(
            "'{declaration.name}' is a row filled by the walk on the next line, and its line for '{walk_refused_attribute}' reads '{walk_refused}', which a walked row cannot write out: the line is built from '<value>.attributes[attribute]', attribute reads, '[ ]', calls, the walk's other parameters, 'attribute.index' and whole numbers, so work out '{walk_refused}' before the walk and pass it in",
        )
        var refused_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
        scope.declare(declaration.name, refused_type)
        scope.check_last(current_line)
        var filling_statement = borrow_statements[borrow_index + 1]
        var mentioned = List<String>()
        collect_statement_names(filling_statement, mentioned)
        mentioned.each(scope.mark_used)
        walked_row_filled = true
        return true
    }
    if not literal {
        return false
    }
    emit_walked_checks(scope, class_information)
    var value: Syntax.Expressions.Expression = literal
    var row_declaration = Syntax.Statements.VariableDeclaration(declaration.name, declaration.type_reference, value)
    row_declaration.line = declaration.line
    row_declaration.source_path = declaration.source_path
    var saved_index = borrow_index
    borrow_index = borrow_index + 1
    walked_row_mixing = true
    var lent = lends_row(row_declaration, scope, class_information)
    forget_walked_reads()
    walked_row_mixing = false
    borrow_index = saved_index
    walked_row_filled = lent
    return lent
}

func lent_element_function(
    value: Syntax.Expressions.Expression,
    mixing: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    assert mixing and not in_vector_library(class_information) and not resumable_mode
    var call = shape.as_call(value)
    assert call
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member and call.arguments.count() == 1
    crash member.object
    var owner = lent_element_owner(member.object, scope, class_information)
    assert owner
    var function = find_or_instantiate_function(owner, member.name)
    assert function
    assert not lent_element_field(owner, function).is_empty()
    return function
}

func lent_window_of(
    value: Syntax.Expressions.Expression,
    mixing: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String? {
    var function = lent_element_function(value, mixing, scope, class_information)
    assert function
    var call = shape.as_call(value)
    crash call
    crash call.callee
    var member = shape.as_member(call.callee)
    crash member
    crash member.object
    var owner = lent_element_owner(member.object, scope, class_information)
    crash owner
    var field_name = lent_element_field(owner, function)
    assert not drops_reach_list(owner, field_name)
    return lend_window_text(scope, class_information)
}

func lent_element_owner(
    receiver: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var construction = shape.as_generic_call(receiver)
    if construction {
        return generic_singleton_made(construction, class_information.qualified_dotted)
    }
    var identifier = shape.as_identifier(receiver)
    assert identifier
    var receiver_type = scope.written_type(identifier.name)
    if not receiver_type {
        var field = class_information.find_field(identifier.name)
        assert field
        receiver_type = field.type
    }
    var class_ref = type_shape.as_class_ref(receiver_type)
    assert class_ref
    return find_class_by_c_name(class_ref.c_name)
}

func lent_element_field(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    if not owner.is_singleton or owner.is_generic_template or is_library_class(owner) or is_hot_class(owner) {
        return ""
    }
    if function.is_constructor or not function.has_body or function.body.is_empty() {
        return ""
    }
    if not function.lent_parameters.is_empty() or not function.held_parameters.is_empty() or function.result_slot {
        return ""
    }
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        var parameter_type = function.parameters[parameter_index].type
        if type_needs_drop(parameter_type) {
            return ""
        }
        parameter_index = parameter_index + 1
    }
    var last = function.body.last()
    if not last {
        return ""
    }
    var returned = shape.as_return_statement(last)
    if not returned or not returned.value {
        return ""
    }
    if not guards_only_the_read(function.body, returned.value) {
        return ""
    }
    var list_name = ""
    var index_ast: Syntax.Expressions.Expression? = null
    var call = shape.as_call(returned.value)
    if call {
        crash call.callee
        var member = shape.as_member(call.callee)
        if not member or member.name != "get_at" or call.arguments.count() != 1 {
            return ""
        }
        crash member.object
        var list_identifier = shape.as_identifier(member.object)
        if not list_identifier {
            return ""
        }
        list_name = list_identifier.name
        index_ast = call.arguments[0]
    }
    var indexed = shape.as_index(returned.value)
    if indexed {
        crash indexed.object
        var indexed_identifier = shape.as_identifier(indexed.object)
        if not indexed_identifier {
            return ""
        }
        list_name = indexed_identifier.name
        index_ast = indexed.index
    }
    if list_name.is_empty() or not index_ast {
        return ""
    }
    if lent_element_index_code(index_ast, function).is_empty() {
        return ""
    }
    var field = owner.find_field(list_name)
    if not field {
        return ""
    }
    var field_type = field.type
    var listed = type_shape.as_list(field_type)
    if not listed {
        return ""
    }
    var element = listed.element
    var element_class = type_shape.as_class_ref(element)
    if not element_class {
        return ""
    }
    if element_class.has_signature {
        return ""
    }
    var lent_return_type = function.return_type
    var returned_plain = lent_return_type
    var nullable = type_shape.as_nullable(lent_return_type)
    if nullable {
        returned_plain = nullable.inner
    }
    var returned_class = type_shape.as_class_ref(returned_plain)
    if not returned_class {
        return ""
    }
    if returned_class.c_name != element_class.c_name {
        return ""
    }
    if not stays_with_singleton(owner, field) {
        return ""
    }
    return list_name
}

func guards_only_the_read(
    statements: List<Syntax.Statements.Statement>,
    value: Syntax.Expressions.Expression,
): Boolean {
    var printer = Syntax.SourcePrinter()
    var read_text = printer.source_expression(value)
    var index = 0
    while index < statements.count() - 1 {
        var guard = shape.as_assert_statement(statements[index])
        if not guard {
            return false
        }
        if not guard.is_crash or not guard.value {
            return false
        }
        if printer.source_expression(guard.value) != read_text {
            return false
        }
        index = index + 1
    }
    return true
}

func lent_element_index_code(index_ast: Syntax.Expressions.Expression?, function: Analysis.FunctionInfo): String {
    if not index_ast {
        return ""
    }
    var literal = shape.as_integer_literal(index_ast)
    if literal {
        return literal.value.to_string()
    }
    var identifier = shape.as_identifier(index_ast)
    if not identifier {
        return ""
    }
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == identifier.name {
            var parameter_type = parameter.type
            var scalar = type_shape.as_scalar(parameter_type)
            if not scalar {
                return ""
            }
            if scalar.kind != 'integer_kind' {
                return ""
            }
            return c_value_name(parameter.name)
        }
        index = index + 1
    }
    return ""
}

func lend_window_text(scope: Scope, class_information: Analysis.ClassInfo): String? {
    assert not hot_reload and not read_evaluate_print_loop and remote_loop_port == 0 and not keeps_internals
    var watch = ReleaseWatch("")
    watch.strict = true
    assert watch_statements(watch, borrow_statements, borrow_index + 1, scope, class_information)
    return watch.keys.join(" ")
}

func drops_reach_list(owner: Analysis.ClassInfo, field_name: String): Boolean {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        var dropped_while_running = not information.is_singleton and not is_library_class(information)
        if dropped_while_running and information.find_function("drop") {
            var key = call_effects.effects_key(information.qualified_dotted, "drop")
            if key.is_empty() {
                return true
            }
            if drop_reaches_list(key, owner, field_name) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func drops_may_release(): Boolean {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        var dropped_while_running = not information.is_singleton and not is_library_class(information)
        if dropped_while_running and information.find_function("drop") {
            var key = call_effects.effects_key(information.qualified_dotted, "drop")
            if key.is_empty() {
                return true
            }
            var effects = call_effects.effects_of_key(key)
            if effects.contains("release") or effects.contains("field:*") {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func drop_reaches_list(key: String, owner: Analysis.ClassInfo, field_name: String): Boolean {
    var keys = [key]
    var effects = call_effects.effects_of_key(key)
    if effects.contains("field:*") {
        return true
    }
    var reached = call_effects.reached_classes(keys)
    if reached.has(owner.qualified_dotted) {
        return true
    }
    var accesses = call_effects.reached_accesses(keys)
    return accesses.contains("{owner.qualified_dotted}#{field_name}") or accesses.contains("*#{field_name}")
}

func lend_site(
    value: Syntax.Expressions.Expression,
    window_text: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var call = shape.as_call(value)
    crash call
    crash call.callee
    var member = shape.as_member(call.callee)
    crash member
    crash member.object
    var owner = lent_element_owner(member.object, scope, class_information)
    crash owner
    var function = find_or_instantiate_function(owner, member.name)
    crash function
    var variant = ensure_lent_element_variant(owner, function)
    var receiver = generate_expression(member.object, scope, class_information)
    crash function.parameters[0]
    var parameter_type = function.parameters[0].type
    var index_code = coerce_for_store(call.arguments[0], parameter_type, scope, class_information)
    var site = lend_site_owners.count()
    var element_type = function.return_type
    var held_name = next_temporary()
    var held_code = c_value_name(held_name)
    builder.add_user("spite_lend_{site}_enter();")
    builder.add_user(
        "{c_type_name(element_type)} {held_code} = spite_lend_{site}_read({variant.c_name}, {function.c_name}, {receiver.code}, {index_code});",
    )
    lend_site_owners.append(owner)
    lend_site_keys.append(window_text)
    var releasing = release_call(element_type, "value")
    lend_site_releases.append(releasing)
    scope.declare_owned(held_name, element_type)
    var held_local = scope.owned.last()
    crash held_local
    held_local.framed = true
    held_local.framed_cleanup = "spite_lend_{site}_leave({held_code})"
    return held_code
}

func ensure_lent_element_variant(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo): Analysis.FunctionInfo {
    var variant_c_name = "{function.c_name}___lent_element"
    var existing = function_by_c_name(owner, variant_c_name)
    if existing {
        return existing
    }
    var original_return_type = function.return_type
    var variant = Analysis.FunctionInfo(
        function.name,
        variant_c_name,
        function.parameters,
        original_return_type,
        function.body,
        false,
    )
    variant.line = function.line
    variant.source_path = function.source_path
    variant.specialisation_position = function.specialisation_position
    variant.lent_element = lent_element_field(owner, function)
    variant.specialised_from = function.specialised_from
    owner.declared_functions.append(variant)
    builder.add_prototype("{function_signature(owner, variant)};")
    return variant
}

func lent_element_return(function: Analysis.FunctionInfo): Syntax.Expressions.Expression? {
    var last = function.body.last()
    assert last
    var returned = shape.as_return_statement(last)
    assert returned
    return returned.value
}

func lent_element_index_of(value: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    var call = shape.as_call(value)
    if call {
        return call.arguments[0]
    }
    var indexed = shape.as_index(value)
    assert indexed
    return indexed.index
}

func lent_element_range_failed(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var returned = lent_element_return(function)
    crash returned
    var index_ast = lent_element_index_of(returned)
    var index_code = lent_element_index_code(index_ast, function)
    var list_code = field_place("self", information, function.lent_element)
    return "{index_code} < 0 || {index_code} >= ({list_code})->item_count_"
}

func lent_element_read(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var field = information.find_field(function.lent_element)
    crash field
    var field_type = field.type
    var listed = type_shape.as_list(field_type)
    crash listed
    var element = listed.element
    var returned = lent_element_return(function)
    crash returned
    var index_ast = lent_element_index_of(returned)
    var index_code = lent_element_index_code(index_ast, function)
    var list_code = field_place("self", information, field.name)
    var failed = lent_element_range_failed(information, function)
    var item = list_item_code(element, list_code, index_code)
    ensure_index_check()
    var printer = Syntax.SourcePrinter()
    var returned_text = printer.source_expression(returned)
    var read = escape_c_string(returned_text)
    var where = located(function.source_path, function.line, information.qualified_dotted, function.name)
    return "((__builtin_expect({failed}, 0)) ? (spite_outside_list(\"{read}\", {where}), {item}) : {item})"
}

func finish_lend_sites() {
    var reached = call_effects.thread_reached_classes()
    var index = 0
    while index < lend_site_owners.count() {
        var owner = lend_site_owners[index]
        var name = owner.c_name
        crash lend_site_releases[index]
        crash lend_site_keys[index]
        var releasing = lend_site_releases[index]
        var keys_text = lend_site_keys[index]
        var threaded = parallel_used and (reached.has(owner.qualified_dotted) or called_implicitly(owner))
        var lent_read = "#define spite_lend_{index}_read(lent, counted, receiver, index) lent(receiver, index)"
        if not threaded {
            builder.add_typedef("#define spite_lend_{index}_enter() ((void)0)")
            builder.add_typedef(lent_read)
            builder.add_typedef("#define spite_lend_{index}_leave(value) ((void)0)")
        } else if read_guarded_names.contains(name) and lend_window_holds(owner, keys_text) {
            builder.add_typedef(
                "#define spite_lend_{index}_enter() int64_t* spite_lend_{index} = spite_read_enter(&{name}___guard, {name}___readers)",
            )
            builder.add_typedef(lent_read)
            builder.add_typedef("#define spite_lend_{index}_leave(value) spite_read_leave(spite_lend_{index})")
        } else if lend_window_holds(owner, keys_text) {
            declare_guard(name)
            builder.add_typedef("#define spite_lend_{index}_enter() spite_guard_enter(&{name}___guard)")
            builder.add_typedef(lent_read)
            builder.add_typedef("#define spite_lend_{index}_leave(value) spite_guard_leave(&{name}___guard)")
        } else {
            builder.add_typedef("#define spite_lend_{index}_enter() ((void)0)")
            builder.add_typedef(
                "#define spite_lend_{index}_read(lent, counted, receiver, index) counted(receiver, index)",
            )
            builder.add_typedef("#define spite_lend_{index}_leave(value) {releasing}")
        }
        index = index + 1
    }
}

func declare_guard(name: String) {
    assert not emitted_guards.contains(name)
    emitted_guards.append(name)
    builder.add_support("static SpiteGuard {name}___guard = \{ 0, 0 };")
}

func lend_window_holds(owner: Analysis.ClassInfo, keys_text: String): Boolean {
    var keys = List<String>()
    if not keys_text.is_empty() {
        keys = keys_text.split(" ")
    }
    var reached = call_effects.reached_classes(keys)
    if reached.has(owner.qualified_dotted) {
        return false
    }
    var blocking = ["Parallel", "Concurrent", "ThreadPool", "Scheduler", "Lock", "Program", "Console", "File", "Socket"]
    var index = 0
    while index < blocking.count() {
        if reached.has(blocking[index]) {
            return false
        }
        index = index + 1
    }
    var accesses = call_effects.reached_accesses(keys)
    index = 0
    while index < classes.count() {
        var information = classes[index]
        if information.is_singleton and not information.is_stateless_singleton {
            if reached.has(information.qualified_dotted) or accesses_class(accesses, information) {
                return false
            }
        }
        index = index + 1
    }
    return true
}

func accesses_class(accesses: List<String>, information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < accesses.count() {
        var access = accesses[index]
        var hash = access.index_of("#")
        var access_length = access.length()
        var owner = access.slice(0, hash)
        var field_name = access.slice(hash + 1, access_length)
        if owner == information.qualified_dotted {
            return true
        }
        if owner == "*" and information.find_field(field_name) {
            return true
        }
        index = index + 1
    }
    return false
}

func lends_spread_arguments(
    statement: Syntax.Statements.ExpressionStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    if writing_lent_arguments or resumable_mode {
        return false
    }
    crash statement.value
    var call = shape.as_call(statement.value)
    if not call {
        return false
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member {
        return false
    }
    var spread = spread_template(call.arguments, class_information)
    if not spread {
        return false
    }
    var ranged = range_function(class_information, spread)
    if not ranged {
        return false
    }
    var range = range_path(spread)
    var ranged_name = range.last()
    if member.name != ranged_name and member.name != ranged.name {
        return false
    }
    var plural = shape.as_call(call.arguments[0])
    if not plural {
        return false
    }
    var saved_symbol_name = bound_symbol_name
    var saved_field_name = bound_field_name
    var saved_field_index = bound_field_index
    var saved_field_type = bound_field_type
    var saved_refused = walk_refused
    var statements = List<Syntax.Statements.Statement>()
    var names = List<String>()
    var lends = false
    var index = 0
    while index < ranged.parameters.count() {
        var parameter = ranged.parameters[index]
        bound_symbol_name = spread.symbol_parameter
        bound_field_name = parameter.name
        bound_field_index = index
        bound_field_type = parameter.type
        var lent = write_lent_argument(
            spread,
            plural,
            parameter,
            statement.line,
            statements,
            names,
            scope,
            class_information,
        )
        lends = lends or lent
        index = index + 1
    }
    bound_symbol_name = saved_symbol_name
    bound_field_name = saved_field_name
    bound_field_index = saved_field_index
    bound_field_type = saved_field_type
    walk_refused = saved_refused
    if not lends {
        return false
    }
    var passed = List<Syntax.Expressions.Expression>()
    var name_index = 0
    while name_index < names.count() {
        var passed_name: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(names[name_index])
        passed.append(passed_name)
        name_index = name_index + 1
    }
    crash member.object
    var named_callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(member.object, ranged.name)
    var lent_call: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(named_callee, passed)
    var call_statement = Syntax.Statements.ExpressionStatement(lent_call)
    call_statement.line = statement.line
    statements.append(call_statement)
    var printer = Syntax.SourcePrinter()
    lent_plural_text = printer.source_expression(statement.value)
    builder.add_user("\{")
    writing_lent_arguments = true
    generate_block(statements, scope, class_information, function_information)
    writing_lent_arguments = false
    forget_walked_reads()
    lent_plural_text = ""
    builder.add_user("}")
    return true
}

func write_lent_argument(
    spread: Analysis.TemplateInfo,
    plural: Syntax.Expressions.CallExpression,
    parameter: Analysis.ParamInfo,
    line: Integer,
    statements: List<Syntax.Statements.Statement>,
    names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var declaration = spread.declaration
    var parameters = declaration.parameters.map_names()
    var symbol_position = name_position(parameters, spread.symbol_parameter)
    if symbol_position < parameters.count() {
        parameters.remove_at(symbol_position)
    }
    var walk = RowWalk(spread.symbol_parameter, "", parameters, plural.arguments)
    var parameter_type = parameter.type
    var written = written_lent_argument(
        declaration.body,
        parameter,
        parameter_type,
        walk,
        line,
        statements,
        names,
        scope,
        class_information,
    )
    if written == true or written == false {
        return written == true
    }
    var single: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(
        "{spread.prefix}{parameter.name}{spread.suffix}",
    )
    var made: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(single, plural.arguments)
    var mentioned = List<String>()
    collect_mentioned_names(made, mentioned)
    var name = lent_argument_name(parameter.name, mentioned, names, scope, class_information)
    var fallback = Syntax.Statements.VariableDeclaration(name, null, made)
    fallback.line = line
    fallback.source_path = current_path
    statements.append(fallback)
    walked_statement_places["{current_path}:{line}"] = true
    names.append(name)
    return false
}

func written_lent_argument(
    body: List<Syntax.Statements.Statement>,
    parameter: Analysis.ParamInfo,
    parameter_type: Analysis.SpiteType,
    walk: RowWalk,
    line: Integer,
    statements: List<Syntax.Statements.Statement>,
    names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var argument_type = syntax_type_for(parameter_type)
    assert argument_type
    var written_body = folded_template_body(body, scope, class_information)
    assert written_body
    report_reads_in_template(written_body)
    var attribute = Syntax.Statements.FieldDeclaration(parameter.name, argument_type)
    var steps = List<Syntax.Statements.Statement>()
    var index = 0
    while index < written_body.count() {
        var statement = written_body[index]
        if not local_bound_for_walk(attribute, walk, statement) {
            steps.append(statement)
        }
        index = index + 1
    }
    var folded = walk_lent_checks(steps, attribute, walk, line, statements)
    var written: Boolean? = null
    if folded.count() == 1 {
        written = written_lent_value(folded[0], attribute, walk, line, statements, names, scope, class_information)
    } else if folded.count() == 3 and written_lent_row(folded, attribute, walk, line, statements, names, scope, class_information) {
        written = true
    }
    walk.clear_locals()
    return written
}

func local_bound_for_walk(
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
    statement: Syntax.Statements.Statement,
): Boolean {
    var local = shape.as_variable_declaration(statement)
    if not local {
        return false
    }
    crash local.value
    if local.type_reference or shape.is_null_literal(local.value) {
        return false
    }
    var bound = walked_value(local.value, attribute, walk)
    if not bound {
        return false
    }
    walk.bind_local(local.name, bound)
    return true
}

func walk_lent_checks(
    folded: List<Syntax.Statements.Statement>,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
    line: Integer,
    statements: List<Syntax.Statements.Statement>,
): List<Syntax.Statements.Statement> {
    var rest = List<Syntax.Statements.Statement>()
    var printer = Syntax.SourcePrinter()
    var index = 0
    while index < folded.count() {
        var check = shape.as_assert_statement(folded[index])
        var walked: Syntax.Expressions.Expression? = null
        var walked_column = 0
        if check and rest.is_empty() {
            if check.is_crash and check.value {
                walked = walked_value(check.value, attribute, walk)
                walked_column = check.column
            }
        }
        if walked {
            var walked_check = Syntax.Statements.AssertStatement(walked)
            walked_check.is_crash = true
            walked_check.condition_text = printer.source_expression(walked)
            walked_check.line = line
            walked_check.column = walked_column
            walked_check_texts.append(walked_check.condition_text)
            statements.append(walked_check)
        } else {
            rest.append(folded[index])
        }
        index = index + 1
    }
    return rest
}

func written_lent_value(
    statement: Syntax.Statements.Statement,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
    line: Integer,
    statements: List<Syntax.Statements.Statement>,
    names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var returned = shape.as_return_statement(statement)
    assert returned
    crash returned.value
    walk_refused = ""
    var value = walked_value(returned.value, attribute, walk)
    assert walk_refused.is_empty()
    crash value
    var mentioned = List<String>()
    collect_mentioned_names(value, mentioned)
    var name = lent_argument_name(attribute.name, mentioned, names, scope, class_information)
    var written = Syntax.Statements.VariableDeclaration(name, null, value)
    written.line = line
    written.source_path = current_path
    statements.append(written)
    walked_statement_places["{current_path}:{line}"] = true
    names.append(name)
    return may_lend(value, scope, class_information)
}

func written_lent_row(
    folded: List<Syntax.Statements.Statement>,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
    line: Integer,
    statements: List<Syntax.Statements.Statement>,
    names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var row = shape.as_variable_declaration(folded[0])
    if not row {
        return false
    }
    crash row.value
    if not row.type_reference or not shape.is_null_literal(row.value) {
        return false
    }
    var filling = shape.as_expression_statement(folded[1])
    if not filling {
        return false
    }
    crash filling.value
    var fill = shape.as_call(filling.value)
    if not fill {
        return false
    }
    crash fill.callee
    if not shape.as_identifier(fill.callee) {
        return false
    }
    var returned = shape.as_return_statement(folded[2])
    if not returned {
        return false
    }
    crash returned.value
    if not is_identifier_named(returned.value, row.name) {
        return false
    }
    walk_refused = ""
    var mentioned = List<String>()
    var arguments = List<Syntax.Expressions.Expression>()
    var row_index = -1
    var index = 0
    while index < fill.arguments.count() {
        var written = fill.arguments[index]
        if is_identifier_named(written, row.name) {
            row_index = index
            arguments.append(written)
        } else {
            var value = walked_value(written, attribute, walk)
            crash value
            collect_mentioned_names(value, mentioned)
            arguments.append(value)
        }
        index = index + 1
    }
    if not walk_refused.is_empty() or row_index < 0 {
        return false
    }
    var name = lent_argument_name(attribute.name, mentioned, names, scope, class_information)
    var row_reference: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(name)
    arguments[row_index] = row_reference
    var row_type = row.type_reference
    crash row_type
    if symbol_class_type(row_type, walk.symbol_parameter) {
        row_type = attribute.type_reference
        crash row_type
    }
    var nothing: Syntax.Expressions.Expression = Syntax.Expressions.NullLiteral()
    var declared = Syntax.Statements.VariableDeclaration(name, row_type, nothing)
    declared.line = line
    declared.source_path = current_path
    statements.append(declared)
    var filled_call: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(fill.callee, arguments)
    var filled = Syntax.Statements.ExpressionStatement(filled_call)
    filled.line = line
    statements.append(filled)
    walked_statement_places["{current_path}:{line}"] = true
    names.append(name)
    return true
}

func symbol_class_type(written: Syntax.Types.Type, symbol_parameter: String): Boolean {
    var named = shape.as_named_type(written)
    if not named {
        return false
    }
    return named.path.count() == 2 and named.path[0] == symbol_parameter and named.path[1] == "class"
}

func folded_template_body(
    statements: List<Syntax.Statements.Statement>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<Syntax.Statements.Statement>? {
    var folded = List<Syntax.Statements.Statement>()
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        var chosen = shape.as_if_statement(statement)
        if chosen {
            crash chosen.condition
            var decided = constant_condition(chosen.condition, scope, class_information)
            assert decided == true or decided == false
            var taken = chosen.else_branch
            if decided == true {
                taken = chosen.then_branch
            }
            var inner = folded_template_body(taken, scope, class_information)
            assert inner
            var inner_index = 0
            while inner_index < inner.count() {
                folded.append(inner[inner_index])
                inner_index = inner_index + 1
            }
        } else {
            folded.append(statement)
        }
        var last = folded.last()
        if last {
            if shape.as_return_statement(last) {
                return folded
            }
        }
        index = index + 1
    }
    return folded
}

func lent_argument_name(
    parameter_name: String,
    mentioned: List<String>,
    names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var local_name = parameter_name
    while local_name.starts_with("_") {
        var local_length = local_name.length()
        local_name = local_name.slice(1, local_length)
    }
    if local_name.is_empty() {
        local_name = "ignored"
    }
    if lent_name_free(local_name, mentioned, names, scope, class_information) {
        return local_name
    }
    return "{local_name}_argument"
}

func lent_name_free(
    name: String,
    mentioned: List<String>,
    names: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if mentioned.contains(name) or names.contains(name) {
        return false
    }
    if scope.written_type(name) or class_information.find_field(name) {
        return false
    }
    return not class_information.find_function(name)
}

func syntax_type_for(spite_type: Analysis.SpiteType): Syntax.Types.Type? {
    var no_arguments = List<Syntax.Types.GenericArgument>()
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        assert not class_ref.has_signature
        var named_class = find_class_by_c_name(class_ref.c_name)
        assert named_class
        assert not is_instantiated_class(named_class)
        var class_path = named_class.qualified_dotted.split(".")
        var named_class_type: Syntax.Types.Type = Syntax.Types.NamedType(class_path, no_arguments)
        return named_class_type
    }
    var union_type = type_shape.as_union(spite_type)
    assert union_type
    var information = find_union_by_c_name(union_type.c_name)
    assert information
    var union_path = List<String>()
    if not information.owner_qualified.is_empty() {
        union_path = information.owner_qualified.split(".")
    }
    union_path.append(information.simple_name)
    var named_union_type: Syntax.Types.Type = Syntax.Types.NamedType(union_path, no_arguments)
    return named_union_type
}

func report_lent_call_resize(
    argument: Syntax.Expressions.Expression,
    source: String,
    callee: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert not writing_lent_arguments and not source.is_empty() and borrow_index < borrow_statements.count()
    assert not lent_parameter_names.contains(source)
    var argument_root = operand_text(argument)
    assert not lent_parameter_names.contains(argument_root)
    var paths = List<String>()
    if scope.row_source(source).is_empty() {
        paths.append(source)
    } else {
        paths = scope.paths_of_row(source)
    }
    var statement = borrow_statements[borrow_index]
    var text = Syntax.SourcePrinter().source_expression(argument)
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var resize = resize_in_statement(statement, path, scope, class_information)
        if not resize.is_empty() {
            report(
                "{items_choice(path)}'{text}' is borrowed from '{path}' and lent to '{called_display_name(callee)}' for its call, and {resize} may move the items of '{path}': a function lent a borrowed item may not append to or remove from the collection it is borrowed from, directly or through what it calls; change the size of '{path}' before or after the call",
            )
            return
        }
        index = index + 1
    }
}

func called_display_name(callee: String): String {
    var owner = class_of_function_c_name(callee)
    if owner {
        var function = function_by_c_name(owner, callee)
        if function {
            return function.name
        }
    }
    return callee
}

func report_lent_argument_resize(name: String, source: String, scope: Scope, class_information: Analysis.ClassInfo) {
    var statements = borrow_statements
    var call_statement = statements.last()
    assert call_statement
    var resize = resize_in_statement(call_statement, source, scope, class_information)
    assert not resize.is_empty()
    var saved_line = current_line
    current_line = statement_line(call_statement)
    report(
        "{items_choice(source)}'{name}' is borrowed from '{source}' for the one call '{lent_plural_text}' stands for, and {resize} may move the items of '{source}': a function handed borrowed arguments may not append to or remove from the collections they borrow from, directly or through what it calls",
    )
    current_line = saved_line
}

func refused_row(scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    if not walk_partial {
        return false
    }
    return borrows_an_item(walk_partial, scope, class_information)
}

func made_in_frame(
    value: Syntax.Expressions.Expression,
    mixing: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    assert mixing
    var call = shape.as_call(value)
    assert call
    crash call.callee
    assert shape.as_identifier(call.callee)
    var made_class = try_resolve_static_path(call.callee, class_information.qualified_dotted)
    assert made_class
    assert not made_class.is_singleton and not made_class.is_value_class and not made_class.is_generic_template
    assert not is_hot_class(made_class)
    var made_type: Analysis.SpiteType = Analysis.Types.ClassRefType(made_class.c_name)
    var problem = vector_item_problem(made_type)
    assert problem.is_empty()
    var field_index = 0
    while field_index < made_class.fields.count() {
        var field_type = made_class.fields[field_index].type
        assert not type_needs_drop(field_type) or singleton_type(field_type)
        field_index = field_index + 1
    }
    var expected_types = List<Analysis.SpiteType>()
    var passed = List<String>()
    var storage = next_temporary()
    passed.append("&{storage}")
    if made_class.constructor {
        assert not block_uses_this(made_class.constructor.body, made_class)
        expected_types = parameter_types_of(made_class.constructor.parameters)
    }
    var argument_codes = generate_argument_list(call.arguments, expected_types, scope, class_information)
    builder.add_user("{made_class.c_name} {storage} = \{ \{ 1, {made_class.class_id} } };")
    builder.add_user("{made_class.c_name}___init(&{storage});")
    if made_class.constructor {
        var argument_index = 0
        while argument_index < argument_codes.count() {
            passed.append(argument_codes[argument_index])
            argument_index = argument_index + 1
        }
        builder.add_user("{made_class.constructor.c_name}({passed.join(", ")});")
    }
    var made = ExpressionResult("(&{storage})", made_type)
    made.owning_override = false
    return made
}

func held_for_row(
    field_result: ExpressionResult,
    value: Syntax.Expressions.Expression,
    field_type: Analysis.SpiteType,
    scope: Scope,
): String {
    var held_code = field_result.code
    if not owns(field_result, value) {
        held_code = retain_call(field_type, held_code)
    }
    var held_name = next_temporary()
    builder.add_user("{c_type_name(field_type)} {c_value_name(held_name)} = {held_code};")
    scope.declare_owned(held_name, field_type)
    return c_value_name(held_name)
}

func walked_row_literal(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.ObjectLiteralExpression? {
    crash declaration.value
    assert declaration.type_reference and shape.is_null_literal(declaration.value)
    assert not in_vector_library(class_information)
    var statements = borrow_statements
    var next_index = borrow_index + 1
    assert next_index < statements.count()
    var declared_statement = statements[borrow_index]
    var here = shape.as_variable_declaration(declared_statement)
    assert here
    assert here.name == declaration.name and here.line == declaration.line
    var next_statement = statements[next_index]
    var filling = shape.as_expression_statement(next_statement)
    assert filling
    crash filling.value
    var call = shape.as_call(filling.value)
    assert call
    crash call.callee
    var callee = shape.as_identifier(call.callee)
    assert callee
    var template = walk_template(class_information, callee.name)
    assert template
    var range_shape = template_range_shape(class_information, template)
    assert range_shape
    var template_declaration = template.declaration
    var parameters = template_declaration.parameters.map_names()
    var symbol_position = name_position(parameters, template.symbol_parameter)
    assert symbol_position < parameters.count()
    parameters.remove_at(symbol_position)
    assert parameters.count() == call.arguments.count()
    var row_position = row_argument_position(call.arguments, declaration.name)
    assert row_position < parameters.count()
    var plain = 0
    var plain_argument = true
    while plain_argument and plain < call.arguments.count() {
        var argument = call.arguments[plain]
        plain_argument = walk_argument_is_plain(argument, declaration.name, plain == row_position)
        plain = plain + 1
    }
    assert plain_argument
    var row_parameter = parameters[row_position]
    var filling = template_declaration.body
    var walk = RowWalk(template.symbol_parameter, row_parameter, parameters, call.arguments)
    var attributes = range_shape.shape_fields.filter_is_attribute()
    var fields = List<Syntax.Expressions.ObjectField>()
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        var member_type = template_member_type(class_information, template, attribute.name)
        assert member_type
        var filled = walked_field(filling, attribute, index, member_type, walk, scope, class_information)
        assert filled
        var field = Syntax.Expressions.ObjectField(attribute.name, filled)
        fields.append(field)
        index = index + 1
    }
    var literal = Syntax.Expressions.ObjectLiteralExpression(fields)
    if walk_refused.is_empty() {
        return literal
    }
    walk_partial = literal
    return null
}

func walked_field(
    filling: List<Syntax.Statements.Statement>,
    attribute: Syntax.Statements.FieldDeclaration,
    place: Integer,
    member_type: Analysis.SpiteType,
    walk: RowWalk,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Syntax.Expressions.Expression? {
    var saved_symbol_name = bound_symbol_name
    var saved_field_name = bound_field_name
    var saved_field_index = bound_field_index
    var saved_field_type = bound_field_type
    bound_symbol_name = walk.symbol_parameter
    bound_field_name = attribute.name
    bound_field_index = place
    bound_field_type = member_type
    var filled: Syntax.Expressions.Expression? = null
    var folded = folded_template_body(filling, scope, class_information)
    if folded {
        report_reads_in_template(folded)
        var steps = walked_steps(folded, attribute, walk)
        var assigned = walked_assignment(steps, walk)
        if assigned {
            filled = walked_assigned_value(assigned, attribute, walk)
            var first_step = walked_checks.count()
            walk_checks(steps, attribute, walk)
            frame_walked_locals(first_step, filled, scope, class_information)
        }
        walk.clear_locals()
    }
    if not walk_refused.is_empty() and walk_refused_attribute.is_empty() {
        walk_refused_attribute = attribute.name
    }
    bound_symbol_name = saved_symbol_name
    bound_field_name = saved_field_name
    bound_field_index = saved_field_index
    bound_field_type = saved_field_type
    return filled
}

func walked_steps(
    folded: List<Syntax.Statements.Statement>,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
): List<Syntax.Statements.Statement> {
    var written = List<String>()
    var index = 0
    while index < folded.count() - 1 {
        var root = written_root(folded[index])
        if not root.is_empty() {
            written.append(root)
        }
        index = index + 1
    }
    var steps = List<Syntax.Statements.Statement>()
    index = 0
    while index < folded.count() {
        var statement = folded[index]
        var local = shape.as_variable_declaration(statement)
        var bound: Syntax.Expressions.Expression? = null
        if local {
            if local.value {
                bound = walked_value(local.value, attribute, walk)
            }
        }
        if local and bound {
            if written.contains(local.name) {
                bound = made_walked_local(local, bound, walk, steps)
            }
            walk.bind_local(local.name, bound)
        } else {
            steps.append(statement)
        }
        index = index + 1
    }
    return steps
}

func made_walked_local(
    local: Syntax.Statements.VariableDeclaration,
    value: Syntax.Expressions.Expression,
    walk: RowWalk,
    steps: List<Syntax.Statements.Statement>,
): Syntax.Expressions.Expression {
    walked_local_count = walked_local_count + 1
    var made_name = "{local.name}__walked_{walked_local_count}"
    var made = Syntax.Statements.VariableDeclaration(made_name, local.type_reference, value)
    made.line = local.line
    made.source_path = local.source_path
    steps.append(made)
    walk.make_local(local.name)
    return Syntax.Expressions.IdentifierExpression(made_name)
}

func written_root(statement: Syntax.Statements.Statement): String {
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            return assigned_root(statement.target)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            if not shape.as_call(statement.value) {
                return ""
            }
            return assigned_root(statement.value)
        }
        _: return ""
    }
}

func assigned_root(target: Syntax.Expressions.Expression): String {
    switch target {
        Syntax.Expressions.CallExpression: {
            crash target.callee
            if not shape.as_member(target.callee) {
                return ""
            }
            return assigned_root(target.callee)
        }
        Syntax.Expressions.IdentifierExpression: return target.name
        Syntax.Expressions.MemberExpression: {
            crash target.object
            return assigned_root(target.object)
        }
        Syntax.Expressions.IndexExpression: {
            crash target.object
            return assigned_root(target.object)
        }
        _: return ""
    }
}

func walked_assignment(
    folded: List<Syntax.Statements.Statement>,
    walk: RowWalk,
): Syntax.Statements.AssignmentStatement? {
    var last = folded.last()
    assert last
    var index = 0
    while index < folded.count() - 1 {
        var statement = folded[index]
        assert walked_step_allowed(statement, walk)
        index = index + 1
    }
    return shape.as_assignment_statement(last)
}

func walked_step_allowed(statement: Syntax.Statements.Statement, walk: RowWalk): Boolean {
    var check = shape.as_assert_statement(statement)
    if check {
        return check.is_crash
    }
    if shape.as_variable_declaration(statement) {
        return true
    }
    var root = written_root(statement)
    return walk.made_locals.contains(root)
}

func walk_checks(
    folded: List<Syntax.Statements.Statement>,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
) {
    var index = 0
    while index < folded.count() - 1 {
        var statement = folded[index]
        var made = shape.as_variable_declaration(statement)
        var written = shape.as_assignment_statement(statement)
        var called = shape.as_expression_statement(statement)
        if made {
            walked_checks.append(statement)
        } else if called {
            crash called.value
            var walked_call = walked_value(called.value, attribute, walk)
            crash walked_call
            var walked_call_step = Syntax.Statements.ExpressionStatement(walked_call)
            walked_call_step.line = called.line
            walked_checks.append(walked_call_step)
        } else if written {
            crash written.target
            crash written.value
            var walked_target = walked_value(written.target, attribute, walk)
            crash walked_target
            var walked_written = walked_value(written.value, attribute, walk)
            crash walked_written
            var walked_step = Syntax.Statements.AssignmentStatement(walked_target, walked_written)
            walked_step.line = written.line
            walked_checks.append(walked_step)
        } else {
            var check = shape.as_assert_statement(statement)
            crash check
            crash check.value
            var walked = walked_value(check.value, attribute, walk)
            crash walked
            var walked_check = Syntax.Statements.AssertStatement(walked)
            walked_check.is_crash = true
            walked_check.column = check.column
            walked_checks.append(walked_check)
        }
        index = index + 1
    }
}

func emit_walked_checks(scope: Scope, class_information: Analysis.ClassInfo) {
    var nothing = void_type()
    var no_parameters = List<Analysis.ParamInfo>()
    var no_body = List<Syntax.Statements.Statement>()
    var walking = Analysis.FunctionInfo(current_function, "", no_parameters, nothing, no_body, false)
    var printer = Syntax.SourcePrinter()
    var index = 0
    while index < walked_checks.count() {
        var step = walked_checks[index]
        var made = shape.as_variable_declaration(step)
        var written = shape.as_assignment_statement(step)
        var called = shape.as_expression_statement(step)
        if made {
            emit_walked_local(made, scope, class_information)
        } else if called {
            generate_expression_statement(called, scope, class_information)
        } else if written {
            generate_assignment(written, scope, class_information)
        } else {
            var check = shape.as_assert_statement(step)
            crash check
            crash check.value
            check.condition_text = printer.source_expression(check.value)
            check.line = current_line
            if not emit_cached_check(check, scope, class_information, walking) {
                generate_assert_statement(check, scope, class_information, walking)
            }
        }
        index = index + 1
    }
    walked_checks.clear()
    framed_walked_locals.clear()
}

func frame_walked_locals(
    first_step: Integer,
    filled: Syntax.Expressions.Expression?,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var index = first_step
    while index < walked_checks.count() {
        var made = shape.as_variable_declaration(walked_checks[index])
        if made {
            if walked_local_fits_frame(made, index, first_step, filled, scope, class_information) {
                framed_walked_locals.append(made.name)
            }
        }
        index = index + 1
    }
}

func walked_local_fits_frame(
    made: Syntax.Statements.VariableDeclaration,
    made_index: Integer,
    first_step: Integer,
    filled: Syntax.Expressions.Expression?,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash made.value
    if not filled or not is_identifier_named(filled, made.name) or not shape.as_call(made.value) {
        return false
    }
    var made_type = infer_declared_type(made.type_reference, made.value, scope, class_information)
    var made_class = class_behind(made_type)
    if not made_class {
        return false
    }
    var index = first_step
    while index < walked_checks.count() {
        var step = walked_checks[index]
        if index != made_index and not step_fits_frame(step, made.name, made_class, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func step_fits_frame(
    step: Syntax.Statements.Statement,
    name: String,
    made_class: Analysis.ClassInfo,
    class_information: Analysis.ClassInfo,
): Boolean {
    var root = written_root(step)
    if root != name {
        var mentioned = List<String>()
        collect_statement_names(step, mentioned)
        return not mentioned.contains(name)
    }
    var mentioned_in_value = List<String>()
    var member: Syntax.Expressions.MemberExpression? = null
    var called: Analysis.FunctionInfo? = null
    var written = shape.as_assignment_statement(step)
    var call_statement = shape.as_expression_statement(step)
    if written {
        crash written.target
        collect_optional_names(written.value, mentioned_in_value)
        member = shape.as_member(written.target)
        if member {
            called = find_setter(made_class, member.name, class_information)
        }
    } else if call_statement {
        crash call_statement.value
        var call = shape.as_call(call_statement.value)
        crash call
        collect_each_mentioned_name(call.arguments, mentioned_in_value)
        crash call.callee
        member = shape.as_member(call.callee)
        if member {
            called = find_or_instantiate_function(made_class, member.name)
            if not called {
                return false
            }
        }
    }
    if not member or mentioned_in_value.contains(name) {
        return false
    }
    crash member.object
    if not is_identifier_named(member.object, name) {
        return false
    }
    if called {
        return not function_keeps_this(called, made_class, 0)
    }
    return true
}

func function_keeps_this(function: Analysis.FunctionInfo, owner: Analysis.ClassInfo, depth: Integer): Boolean {
    if depth > 8 or block_uses_this(function.body, owner) {
        return true
    }
    var expressions = List<Syntax.Expressions.Expression>()
    collect_block_expressions(function.body, expressions)
    var calls = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < expressions.count() {
        collect_expression_calls(expressions[index], calls)
        index = index + 1
    }
    index = 0
    while index < calls.count() {
        var call = shape.as_call(calls[index])
        crash call
        crash call.callee
        var own_name = ""
        var bare = shape.as_identifier(call.callee)
        if bare {
            own_name = bare.name
        }
        var member = shape.as_member(call.callee)
        if member and is_member_of_this(call.callee) {
            own_name = member.name
        }
        var own_function = owner.find_function(own_name)
        if own_function {
            if function_keeps_this(own_function, owner, depth + 1) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func emit_walked_local(
    made: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    crash made.value
    var template_local = made.name.split("__walked_")[0]
    crash template_local
    var declared_type = infer_declared_type(made.type_reference, made.value, scope, class_information)
    if framed_walked_locals.contains(made.name) {
        var framed = made_in_frame(made.value, true, scope, class_information)
        if framed {
            builder.add_user("{c_type_name(declared_type)} {c_value_name(made.name)} = {framed.code};")
            scope.declare(made.name, declared_type)
            return
        }
    }
    borrow_site = "local:{template_local}"
    var value_code = coerce_for_store(made.value, declared_type, scope, class_information)
    borrow_site = ""
    builder.add_user("{c_type_name(declared_type)} {c_value_name(made.name)} = {value_code};")
    if type_needs_drop(declared_type) {
        scope.declare_owned(made.name, declared_type)
    } else {
        scope.declare(made.name, declared_type)
    }
}

func emit_cached_check(
    check: Syntax.Statements.AssertStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    crash check.value and check.is_crash
    var checked = check.value
    var path = operand_text(checked)
    crash not path.is_empty() and shape.as_index(checked)
    var saved_counter = temporary_counter
    var read = generate_expression(checked, scope, class_information)
    var read_type = read.type
    var nullable = type_shape.as_nullable(read_type)
    if not nullable {
        rewind_temporaries(saved_counter)
        return false
    }
    var owned = owns(read, checked)
    var inner = nullable.inner
    var temporary = next_temporary()
    builder.add_user("{c_type_name(read_type)} {temporary} = {read.code};")
    var cached_code = temporary
    var present = "{temporary}.has_value"
    if type_is_reference(inner) {
        present = present_code(temporary, inner)
    } else {
        cached_code = "{temporary}.value"
    }
    record_site(check, "crash", function_information.name, scope, class_information)
    builder.add_user("if (!({present})) \{")
    emit_check_failure(check, null, false, scope, class_information, function_information)
    scope.narrow_path(path)
    var cached = ExpressionResult(cached_code, inner)
    cached.owning_override = false
    cached.borrowed_from = read.borrowed_from
    walked_read_paths.append(path)
    walked_read_results.append(cached)
    walked_read_owned.append(owned)
    return true
}

func cached_walked_read(path: String): ExpressionResult? {
    assert not path.is_empty()
    var index = walked_read_paths.count() - 1
    while index >= 0 {
        if walked_read_paths[index] == path {
            crash walked_read_results[index]
            var cached = walked_read_results[index]
            var cached_type = cached.type
            var copied = ExpressionResult(cached.code, cached_type)
            copied.owning_override = false
            copied.borrowed_from = cached.borrowed_from
            return copied
        }
        index = index - 1
    }
    return null
}

func forget_walked_reads() {
    var index = 0
    while index < walked_read_results.count() {
        crash index < walked_read_owned.count()
        if walked_read_owned[index] == true {
            var unused = walked_read_results[index]
            var unused_type = unused.type
            var released = release_statement(unused_type, unused.code)
            builder.add_user(released)
        }
        index = index + 1
    }
    walked_read_owned.clear()
    walked_check_texts.clear()
    walked_read_paths.clear()
    walked_read_results.clear()
}

func walked_assigned_value(
    assigned: Syntax.Statements.AssignmentStatement,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
): Syntax.Expressions.Expression? {
    crash assigned.target
    crash assigned.value
    var target_object = walked_object(assigned.target, walk.symbol_parameter)
    assert target_object
    assert is_identifier_named(target_object, walk.row_parameter)
    return walked_value(assigned.value, attribute, walk)
}

func walk_template(information: Analysis.ClassInfo, call_name: String): Analysis.TemplateInfo? {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.range and not template.passed and not template.plural and template.member_name_for(call_name) == "{template.symbol_parameter}s" {
            return template
        }
        index = index + 1
    }
    return null
}

func row_argument_position(arguments: List<Syntax.Expressions.Expression>, row_name: String): Integer {
    var position = 0
    var found = false
    while not found and position < arguments.count() {
        var argument = arguments[position]
        found = is_identifier_named(argument, row_name)
        position = position + 1
    }
    if found {
        return position - 1
    }
    return position
}

func name_position(names: List<String>, name: String): Integer {
    var position = 0
    while position < names.count() and names[position] != name {
        position = position + 1
    }
    return position
}

func walk_argument_is_plain(argument: Syntax.Expressions.Expression, row_name: String, is_row: Boolean): Boolean {
    switch argument {
        Syntax.Expressions.IdentifierExpression: return is_row == (argument.name == row_name)
        Syntax.Expressions.MemberExpression: return not is_row and is_attribute_path(argument)
        Syntax.Expressions.IntegerLiteral: return not is_row
        Syntax.Expressions.FloatLiteral: return not is_row
        Syntax.Expressions.TrueLiteral: return not is_row
        Syntax.Expressions.FalseLiteral: return not is_row
        _: return false
    }
}

func is_attribute_path(argument: Syntax.Expressions.Expression): Boolean {
    switch argument {
        Syntax.Expressions.IdentifierExpression: return true
        Syntax.Expressions.MemberExpression: {
            crash argument.object
            return is_attribute_path(argument.object)
        }
        _: return false
    }
}

func walked_object(
    expression: Syntax.Expressions.Expression,
    symbol_parameter: String,
): Syntax.Expressions.Expression? {
    var indexed = shape.as_index(expression)
    assert indexed
    crash indexed.object
    crash indexed.index
    assert is_identifier_named(indexed.index, symbol_parameter)
    var attributes = shape.as_member(indexed.object)
    assert attributes
    assert attributes.name == "attributes"
    return attributes.object
}

func walked_value(
    expression: Syntax.Expressions.Expression,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
): Syntax.Expressions.Expression? {
    var walked = walked_object(expression, walk.symbol_parameter)
    if walked {
        var walked_owner = walked_value(walked, attribute, walk)
        assert walked_owner
        var read: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(walked_owner, attribute.name)
        return read
    }
    switch expression {
        Syntax.Expressions.IdentifierExpression: return walk.argument_for(expression)
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            if is_identifier_named(expression.object, walk.symbol_parameter) {
                return walked_symbol_member(expression)
            }
            var member_owner = walked_value(expression.object, attribute, walk)
            assert member_owner
            var member: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(
                member_owner,
                expression.name,
            )
            return member
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            var indexed_owner = walked_value(expression.object, attribute, walk)
            assert indexed_owner
            var position = walked_value(expression.index, attribute, walk)
            assert position
            var indexed: Syntax.Expressions.Expression = Syntax.Expressions.IndexExpression(indexed_owner, position)
            return indexed
        }
        Syntax.Expressions.GenericCallExpression: return walked_generic_call(expression, attribute, walk)
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            var callee = walked_value(expression.callee, attribute, walk)
            assert callee
            var arguments = walked_arguments(expression.arguments, attribute, walk)
            assert arguments
            var called: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, arguments)
            return called
        }
        Syntax.Expressions.IntegerLiteral: return expression
        _: return refused_in_walk(expression)
    }
}

func walked_symbol_member(read: Syntax.Expressions.MemberExpression): Syntax.Expressions.Expression? {
    if read.name == "index" and bound_field_index >= 0 {
        var place: Syntax.Expressions.Expression = Syntax.Expressions.IntegerLiteral(bound_field_index)
        return place
    }
    return refused_in_walk(read)
}

func refused_in_walk(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    if walk_refused.is_empty() {
        var printer = Syntax.SourcePrinter()
        walk_refused = printer.source_expression(expression)
    }
    var placeholder: Syntax.Expressions.Expression = Syntax.Expressions.IntegerLiteral(0)
    return placeholder
}

func walked_arguments(
    arguments: List<Syntax.Expressions.Expression>,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
): List<Syntax.Expressions.Expression>? {
    var walked_arguments_list = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < arguments.count() {
        var written = arguments[index]
        var argument = walked_value(written, attribute, walk)
        assert argument
        walked_arguments_list.append(argument)
        index = index + 1
    }
    return walked_arguments_list
}

func walked_generic_call(
    generic_call: Syntax.Expressions.GenericCallExpression,
    attribute: Syntax.Statements.FieldDeclaration,
    walk: RowWalk,
): Syntax.Expressions.Expression? {
    crash generic_call.callee
    assert shape.as_identifier(generic_call.callee) and not generic_call.names_class
    crash attribute.type_reference
    var type_arguments = List<Syntax.Types.GenericArgument>()
    var index = 0
    while index < generic_call.type_arguments.count() {
        var type_argument = generic_call.type_arguments[index]
        var walked_type = walked_type_argument(type_argument, walk.symbol_parameter)
        if walked_type {
            var walked_reference = qualified_type_reference(bound_field_type, attribute.type_reference)
            var attribute_class: Syntax.Types.GenericArgument = Syntax.Types.TypeArgument(walked_reference)
            type_arguments.append(attribute_class)
        } else {
            type_arguments.append(type_argument)
        }
        index = index + 1
    }
    var arguments = walked_arguments(generic_call.arguments, attribute, walk)
    assert arguments
    var made: Syntax.Expressions.Expression = Syntax.Expressions.GenericCallExpression(
        generic_call.callee,
        type_arguments,
        arguments,
    )
    return made
}

func qualified_type_reference(spite_type: Analysis.SpiteType?, written: Syntax.Types.Type): Syntax.Types.Type {
    var walked_class = class_behind(spite_type)
    if walked_class {
        if walked_class.codegen_types.is_empty() and not walked_class.qualified_dotted.is_empty() {
            var no_arguments = List<Syntax.Types.GenericArgument>()
            var path = walked_class.qualified_dotted.split(".")
            return Syntax.Types.NamedType(path, no_arguments)
        }
    }
    return written
}

func walked_type_argument(type_argument: Syntax.Types.GenericArgument, symbol_parameter: String): Boolean {
    var written = shape.as_type_argument(type_argument)
    if not written {
        return false
    }
    crash written.value
    var named = shape.as_named_type(written.value)
    if not named {
        return false
    }
    return named.path.count() == 2 and named.path[0] == symbol_parameter and named.path[1] == "class"
}

func borrows_an_item(
    literal: Syntax.Expressions.ObjectLiteralExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < literal.fields.count() {
        var value = literal.fields[index].value
        crash value
        if may_lend(value, scope, class_information) {
            return true
        }
        var named = shape.as_identifier(value)
        if named {
            if not scope.borrow_source(named.name).is_empty() {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func borrowed_path_of(value: Syntax.Expressions.Expression, result: ExpressionResult, scope: Scope): String {
    if not result.borrowed_from.is_empty() {
        return result.borrowed_from
    }
    var named = shape.as_identifier(value)
    if not named {
        return ""
    }
    return scope.borrow_source(named.name)
}

func report_row_call_resize(
    name: String,
    source: String,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = start
    while index < statements.count() {
        var statement = statements[index]
        if row_call_resizes_within(name, source, statement, scope, class_information) {
            return true
        }
        var mentioned = List<String>()
        collect_statement_names(statement, mentioned)
        if mentioned.contains(name) and not holds_blocks(statement) {
            var resize = resize_in_statement(statement, source, scope, class_information)
            if not resize.is_empty() {
                var saved_line = current_line
                current_line = statement_line(statement)
                report(
                    "{items_choice(source)}'{name}' borrows items from '{source}' for the call it is passed to, and {resize} may move the items of '{source}': a function that is handed a row may not append to or remove from the vectors it borrows from, directly or through what it calls",
                )
                current_line = saved_line
                return true
            }
        }
        index = index + 1
    }
    return false
}

func holds_blocks(statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.IfStatement: return true
        Syntax.Statements.WhileStatement: return true
        Syntax.Statements.SwitchStatement: return true
        _: return false
    }
}

func row_call_resizes_within(
    name: String,
    source: String,
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.IfStatement: {
            if report_row_call_resize(name, source, statement.then_branch, 0, scope, class_information) {
                return true
            }
            return report_row_call_resize(name, source, statement.else_branch, 0, scope, class_information)
        }
        Syntax.Statements.WhileStatement: return report_row_call_resize(name, source, statement.body, 0, scope, class_information)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                var body = statement.cases[case_index].body
                if report_row_call_resize(name, source, body, 0, scope, class_information) {
                    return true
                }
                case_index = case_index + 1
            }
            return false
        }
        _: return false
    }
}

func literal_class(names: List<String>, types: List<Analysis.SpiteType>): Analysis.ClassInfo {
    var label = "Object"
    var index = 0
    while index < names.count() {
        crash types[index]
        label = "{label}_{names[index]}_{type_label(types[index])}"
        index = index + 1
    }
    var information = find_class_by_c_name(label)
    if information {
        return information
    }
    var class_id = allocate_class_id(label)
    var created = Analysis.ClassInfo(label, "Object", "", label, class_id)
    note_literal_class(names, types)
    var field_index = 0
    while field_index < names.count() {
        var listed_name = names[field_index]
        var listed_type = types[field_index]
        crash listed_type
        var default_value_code = default_value_for_type(listed_type)
        var listed_field = Analysis.FieldInfo(listed_name, listed_type, default_value_code)
        created.fields.append(listed_field)
        field_index = field_index + 1
    }
    classes.append(created)
    builder.add_typedef("typedef struct {label} {label};")
    var saved_owner = current_owner
    emit_class(created)
    current_owner = saved_owner
    return created
}

func borrowed_text_of(expression_ast: Syntax.Expressions.Expression, result: ExpressionResult, scope: Scope): String {
    if not result.borrowed_from.is_empty() {
        return Syntax.SourcePrinter().source_expression(expression_ast)
    }
    var identifier = shape.as_identifier(expression_ast)
    if not identifier {
        return ""
    }
    if scope.borrow_source(identifier.name).is_empty() {
        return ""
    }
    return identifier.name
}

func borrowed_source_of(expression_ast: Syntax.Expressions.Expression, result: ExpressionResult, scope: Scope): String {
    if not result.borrowed_from.is_empty() {
        return result.borrowed_from
    }
    var identifier = shape.as_identifier(expression_ast)
    if not identifier {
        return ""
    }
    return scope.borrow_source(identifier.name)
}

func report_kept_borrow(
    expression_ast: Syntax.Expressions.Expression,
    result: ExpressionResult,
    site: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert not in_vector_library(class_information)
    var text = borrowed_text_of(expression_ast, result, scope)
    assert not text.is_empty()
    var source = borrowed_source_of(expression_ast, result, scope)
    var site_length = site.length()
    if result.borrowed_from.is_empty() and not scope.row_source(text).is_empty() {
        report_kept_row(text, source, site)
        return
    }
    if result.borrowed_from.is_empty() and lent_parameter_names.contains(text) {
        report_kept_lent(text, site)
        return
    }
    var copied = "'{text}.copy()', an independent object"
    var reason = items_choice(source)
    if site == "return" {
        report(
            "{reason}'{text}' is borrowed from '{source}' and cannot be returned: return {copied}{lent_result_hint()}{handed_on_hint(source)}",
        )
        return
    }
    if site.starts_with("attribute:") {
        var attribute = site.slice(10, site_length)
        report(
            "{reason}'{text}' is borrowed from '{source}' and cannot be kept in the attribute '{attribute}': keep {copied}",
        )
        return
    }
    if site.starts_with("local:") {
        var local = site.slice(6, site_length)
        report(
            "{reason}'{text}' is borrowed from '{source}', and a borrowed item has one name: use '{text}' itself instead of '{local}', or keep {copied}",
        )
        return
    }
    var into_list = site == "list"
    if site.starts_with("argument:List_") {
        into_list = site.ends_with("_append") or site.ends_with("_prepend") or site.ends_with("_insert") or site.ends_with("_set_at")
    }
    if into_list {
        report("{reason}'{text}' is borrowed from '{source}' and cannot be put in a list: a list keeps {copied}")
        return
    }
    if site.starts_with("argument:") {
        var callee = site.slice(9, site_length)
        report(
            "{reason}'{text}' is borrowed from '{source}', and {unlent_argument_reason(text, callee, expression_ast)}",
        )
        return
    }
    report("{reason}'{text}' is borrowed from '{source}' and cannot be kept past the line that reads it: keep {copied}")
}

func unlent_argument_reason(text: String, callee: String, expression: Syntax.Expressions.Expression): String {
    var name = called_display_name(callee)
    if name.is_empty() {
        name = "the function"
    } else {
        name = "'{name}'"
    }
    var owner = class_of_function_c_name(callee)
    if owner {
        if owner.source_path.starts_with("library/") {
            return "{name} is a library function, which is never lent an item: pass the attributes it needs, or '{text}.copy()' where a snapshot is what it wants"
        }
    }
    if argument_expected_type {
        if type_shape.as_union(argument_expected_type) {
            return "{name} takes it as a union, which holds its own values and is never lent an item: pass the attributes it needs, or give {name} a parameter of the item's own class"
        }
    }
    var identifier = shape.as_identifier(expression)
    var indexed = shape.as_index(expression)
    if not identifier and not indexed {
        return "only a named item, an item read with '[ ]' or a row's attribute is lent to a call: name it first, 'var item = {text}', and pass 'item'"
    }
    return "{name} is not lent it for the call: pass the attributes it needs"
}

func report_kept_lent(text: String, site: String) {
    var lent = "'{text}' is lent to '{current_function}' for one call, by {lent_parameter_caller}: it is the caller's item, read and written in place,"
    if lent_parameter_caller.is_empty() {
        lent = "'{text}' is lent to '{current_function}' for one call: it is the caller's item, read and written in place,"
    }
    var site_length = site.length()
    if site == "return" {
        report("{lent} so '{current_function}' does not return it: return the values the caller needs")
        return
    }
    if site.starts_with("attribute:") {
        var attribute = site.slice(10, site_length)
        report(
            "{lent} so '{current_function}' does not keep it in the attribute '{attribute}': keep the values it needs, or have the caller pass something '{current_function}' may keep",
        )
        return
    }
    if site.starts_with("local:") {
        var local = site.slice(6, site_length)
        report("{lent} and a lent item has one name: use '{text}' itself instead of '{local}'")
        return
    }
    var into_list = site == "list"
    if site.starts_with("argument:List_") {
        into_list = site.ends_with("_append") or site.ends_with("_prepend") or site.ends_with("_insert") or site.ends_with("_set_at")
    }
    if into_list {
        report(
            "{lent} so '{current_function}' does not put it in a list, which would keep it: keep the values it needs",
        )
        return
    }
    if site.starts_with("argument:") {
        var callee = site.slice(9, site_length)
        var named: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(text)
        report("{lent} and {unlent_argument_reason(text, callee, named)}")
        return
    }
    report("{lent} so '{current_function}' keeps it no longer than the call: keep the values it needs")
}

func handed_on_hint(source: String): String {
    if not lent_result_singletons.has(source) {
        return ""
    }
    return "; a function lends its caller an item only by reading it from a singleton's Items or Vector itself, never one that was lent to it"
}

func reread_hint(source: String): String {
    if lent_result_singletons.has(source) {
        return "ask for the item again"
    }
    return "read '{source}[index]' again"
}

func report_unlent_return(
    value: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    assert not shape.is_null_literal(value) and not function_information.is_constructor
    var lent = lent_result_source(class_information, function_information)
    assert not lent.is_empty()
    assert not lends_this_return(value, class_information)
    var written = Syntax.SourcePrinter().source_expression(value)
    report(
        "'{function_information.name}' lends its caller an item of '{lent}', which the caller writes in place and never lets go, so each of its returns is an item of '{lent}' or null: '{written}' is neither, so return null for 'none', with a '?' result, or make it a function of its own",
    )
}

func report_lending_value(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    assert not function.is_constructor
    var lent = lent_result_source(information, function)
    assert not lent.is_empty()
    report(
        "'{function.name}' lends its caller an item of '{lent}', which only a call written by name can borrow: a function value's caller would let go of an item it does not own, so '{function.name}' is not made a function value; call '{function.name}(...)' by name where the item is wanted",
    )
}

func lent_result_hint(): String {
    if bound_symbol_name.is_empty() {
        return ""
    }
    crash current_class
    return lent_result_hint_of(current_class)
}

func lent_result_hint_of(information: Analysis.ClassInfo): String {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        var declaration = template.declaration
        var returns = false
        if declaration.return_type {
            returns = true
        }
        if template.symbol_parameter == bound_symbol_name and template.range and not template.passed and returns {
            if template_range_owner(information, template) == "function" {
                var range = range_path(template)
                var ranged = range.last()
                crash ranged
                return "; a template over the arguments of '{ranged}' may hand back a borrowed item only through its plural, as the whole argument list of the one call it fills: '{ranged}({template.prefix}{template.symbol_parameter}s{template.suffix}(...))'"
            }
        }
        index = index + 1
    }
    return ""
}

func report_kept_row(text: String, source: String, site: String) {
    var held = "{items_choice(source)}'{text}' holds items borrowed from '{source}' for this call"
    var site_length = site.length()
    if site == "return" {
        report(
            "{held} and cannot be returned: return the values the caller needs, or a 'copy()' of one of its items{lent_result_hint()}",
        )
        return
    }
    if site.starts_with("attribute:") {
        var attribute = site.slice(10, site_length)
        report(
            "{held} and cannot be kept in the attribute '{attribute}': keep the values it needs, or a 'copy()' of one of its items",
        )
        return
    }
    if site.starts_with("local:") {
        var local = site.slice(6, site_length)
        report("{held}, and a row has one name: use '{text}' itself instead of '{local}'")
        return
    }
    var into_list = site == "list"
    if site.starts_with("argument:List_") {
        into_list = site.ends_with("_append") or site.ends_with("_prepend") or site.ends_with("_insert") or site.ends_with("_set_at")
    }
    if into_list {
        report("{held} and cannot be put in a list: a list keeps a 'copy()' of one of its items")
        return
    }
    if site.starts_with("argument:") {
        report(
            "{held} and is passed only to a function called by name whose parameter is a 'type', which borrows it for that call: pass the attributes the function needs",
        )
        return
    }
    report("{held} and cannot be kept past it: keep the values it needs, or a 'copy()' of one of its items")
}

func assignment_site(assignment: Syntax.Statements.AssignmentStatement, scope: Scope): String {
    crash assignment.target
    if shape.as_index(assignment.target) {
        return "list"
    }
    var identifier = shape.as_identifier(assignment.target)
    if identifier {
        if scope.written_type(identifier.name) {
            return "local:{identifier.name}"
        }
        return "attribute:{identifier.name}"
    }
    var member = shape.as_member(assignment.target)
    if not member {
        return ""
    }
    return "attribute:{member.name}"
}

func report_captured_borrow(
    member: Syntax.Expressions.MemberExpression,
    object_result: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert not in_vector_library(class_information)
    crash member.object
    var text = borrowed_text_of(member.object, object_result, scope)
    assert not text.is_empty()
    var source = borrowed_source_of(member.object, object_result, scope)
    if object_result.borrowed_from.is_empty() and lent_parameter_names.contains(text) {
        report(
            "'{text}.{member.name}' would keep '{text}' in a function value, and '{text}' is lent to '{current_function}' for one call, so '{current_function}' does not keep it: call '{text}.{member.name}()' directly, or keep the values it needs",
        )
        return
    }
    report(
        "{items_choice(source)}'{text}.{member.name}' would keep '{text}', which is borrowed from '{source}', in a function value: make it from a copy, 'var kept = {text}.copy()' and then 'kept.{member.name}'",
    )
}

func report_borrowed_reassignment(assignment: Syntax.Statements.AssignmentStatement, scope: Scope): Boolean {
    crash assignment.target
    var identifier = shape.as_identifier(assignment.target)
    if not identifier {
        return false
    }
    var source = scope.borrow_source(identifier.name)
    if source.is_empty() {
        return false
    }
    if not scope.row_source(identifier.name).is_empty() {
        report(
            "{items_choice(source)}'{identifier.name}' holds items borrowed from '{source}' for this call and is not assigned again: make each row with a new 'var'",
        )
        return true
    }
    report(
        "{items_choice(source)}'{identifier.name}' is borrowed from '{source}' and is not assigned again: read another item with a new 'var', such as 'var next = {source}[index]'",
    )
    return true
}

func report_borrow_past_resize(name: String, source: String, scope: Scope, class_information: Analysis.ClassInfo) {
    var statements = borrow_statements
    var start = borrow_index + 1
    var saved_line = current_line
    borrow_outlives_resize(name, source, statements, start, scope, class_information)
    current_line = saved_line
}

func borrow_outlives_resize(
    name: String,
    source: String,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = start
    var lookahead = Scope(scope)
    while index < statements.count() {
        var statement = statements[index]
        var resize = resize_in_statement(statement, source, lookahead, class_information)
        if not resize.is_empty() {
            var mentioned = List<String>()
            if shape.as_while_statement(statement) {
                collect_statement_names(statement, mentioned)
            }
            var rest_index = index + 1
            while rest_index < statements.count() {
                collect_statement_names(statements[rest_index], mentioned)
                rest_index = rest_index + 1
            }
            if mentioned.contains(name) {
                current_line = statement_line(statement)
                report(
                    "{items_choice(source)}'{name}' is borrowed from '{source}', and {resize} may move the items of '{source}', so '{name}' is not read after it: {reread_hint(source)} after that line, or keep '{name}.copy()', an independent object",
                )
                return true
            }
            if borrow_outlives_resize_within(name, source, statement, lookahead, class_information) {
                return true
            }
        }
        declare_ahead(statement, lookahead, class_information)
        index = index + 1
    }
    return false
}

func declare_ahead(statement: Syntax.Statements.Statement, lookahead: Scope, class_information: Analysis.ClassInfo) {
    var declaration = shape.as_variable_declaration(statement)
    assert declaration and not declaration.type_reference
    crash declaration.value
    var declared_type = receiver_type_of(declaration.value, lookahead, class_information)
    assert declared_type
    lookahead.declare(declaration.name, declared_type)
}

func borrow_outlives_resize_within(
    name: String,
    source: String,
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.IfStatement: {
            if borrow_outlives_resize(name, source, statement.then_branch, 0, scope, class_information) {
                return true
            }
            return borrow_outlives_resize(name, source, statement.else_branch, 0, scope, class_information)
        }
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                var body = statement.cases[case_index].body
                if borrow_outlives_resize(name, source, body, 0, scope, class_information) {
                    return true
                }
                case_index = case_index + 1
            }
            return false
        }
        _: return false
    }
}

func statement_line(statement: Syntax.Statements.Statement): Integer {
    switch statement {
        Syntax.Statements.VariableDeclaration: return statement.line
        Syntax.Statements.AssignmentStatement: return statement.line
        Syntax.Statements.IfStatement: return statement.line
        Syntax.Statements.WhileStatement: return statement.line
        Syntax.Statements.SwitchStatement: return statement.line
        Syntax.Statements.AssertStatement: return statement.line
        Syntax.Statements.ReturnStatement: return statement.line
        Syntax.Statements.ExpressionStatement: return statement.line
        _: return current_line
    }
}

func resize_in_statement(
    statement: Syntax.Statements.Statement,
    source: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var calls = List<Syntax.Expressions.Expression>()
    var assigned = List<Syntax.Expressions.Expression>()
    collect_statement_calls(statement, calls, assigned)
    var line = statement_line(statement)
    var index = 0
    while index < assigned.count() {
        var target = operand_text(assigned[index])
        if target == source or source.starts_with("{target}.") {
            return "assigning '{target}' on line {line}"
        }
        index = index + 1
    }
    index = 0
    while index < calls.count() {
        var resize = call_resizes(calls[index], source, scope, class_information)
        if not resize.is_empty() {
            return "{resize} on line {line}"
        }
        index = index + 1
    }
    return resize_in_blocks(statement, source, scope, class_information)
}

func resize_in_blocks(
    statement: Syntax.Statements.Statement,
    source: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    switch statement {
        Syntax.Statements.IfStatement: {
            var in_then = resize_in_block(statement.then_branch, source, scope, class_information)
            if not in_then.is_empty() {
                return in_then
            }
            return resize_in_block(statement.else_branch, source, scope, class_information)
        }
        Syntax.Statements.WhileStatement: return resize_in_block(statement.body, source, scope, class_information)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                var body = statement.cases[case_index].body
                var in_case = resize_in_block(body, source, scope, class_information)
                if not in_case.is_empty() {
                    return in_case
                }
                case_index = case_index + 1
            }
            return ""
        }
        _: return ""
    }
}

func resize_in_block(
    statements: List<Syntax.Statements.Statement>,
    source: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var index = 0
    while index < statements.count() {
        var resize = resize_in_statement(statements[index], source, scope, class_information)
        if not resize.is_empty() {
            return resize
        }
        index = index + 1
    }
    return ""
}

func collect_statement_calls(
    statement: Syntax.Statements.Statement,
    calls: List<Syntax.Expressions.Expression>,
    assigned: List<Syntax.Expressions.Expression>,
) {
    switch statement {
        Syntax.Statements.VariableDeclaration: collect_optional_calls(statement.value, calls)
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            assigned.append(statement.target)
            collect_optional_calls(statement.target, calls)
            collect_optional_calls(statement.value, calls)
        }
        Syntax.Statements.IfStatement: collect_optional_calls(statement.condition, calls)
        Syntax.Statements.WhileStatement: collect_optional_calls(statement.condition, calls)
        Syntax.Statements.SwitchStatement: collect_optional_calls(statement.subject, calls)
        Syntax.Statements.AssertStatement: collect_optional_calls(statement.value, calls)
        Syntax.Statements.ReturnStatement: collect_optional_calls(statement.value, calls)
        Syntax.Statements.ExpressionStatement: collect_optional_calls(statement.value, calls)
        _: return
    }
}

func collect_optional_calls(expression: Syntax.Expressions.Expression?, calls: List<Syntax.Expressions.Expression>) {
    assert expression
    collect_expression_calls(expression, calls)
}

func collect_expression_calls(expression: Syntax.Expressions.Expression, calls: List<Syntax.Expressions.Expression>) {
    switch expression {
        Syntax.Expressions.CallExpression: {
            calls.append(expression)
            collect_optional_calls(expression.callee, calls)
            collect_each_expression_call(expression.arguments, calls)
        }
        Syntax.Expressions.GenericCallExpression: {
            calls.append(expression)
            collect_each_expression_call(expression.arguments, calls)
        }
        Syntax.Expressions.BinaryExpression: {
            collect_optional_calls(expression.left, calls)
            collect_optional_calls(expression.right, calls)
        }
        Syntax.Expressions.UnaryExpression: collect_optional_calls(expression.operand, calls)
        Syntax.Expressions.MemberExpression: collect_optional_calls(expression.object, calls)
        Syntax.Expressions.IndexExpression: {
            collect_optional_calls(expression.object, calls)
            collect_optional_calls(expression.index, calls)
        }
        _: return
    }
}

func collect_each_expression_call(
    expressions: List<Syntax.Expressions.Expression>,
    calls: List<Syntax.Expressions.Expression>,
) {
    var index = 0
    while index < expressions.count() {
        collect_expression_calls(expressions[index], calls)
        index = index + 1
    }
}

func call_resizes(
    called: Syntax.Expressions.Expression,
    source: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var printer = Syntax.SourcePrinter()
    var construction = shape.as_generic_call(called)
    if construction {
        crash construction.callee
        var constructed = effects_class_of(construction.callee, class_information)
        var made_name = called_name_of(construction.callee)
        var construction_effects = call_effects.effects_of(constructed, made_name)
        if effects_resize(construction_effects, source, construction.arguments, scope, class_information) {
            return "'{printer.source_expression(construction.callee)}()'"
        }
        return ""
    }
    var call = shape.as_call(called)
    crash call
    crash call.callee
    var callee_text = printer.source_expression(call.callee)
    var member = shape.as_member(call.callee)
    if member {
        crash member.object
        if operand_text(member.object) == source and resizes_storage(member.name) {
            return "'{callee_text}()'"
        }
    }
    var effects = resize_effects_of(call.callee, scope, class_information)
    if not effects_resize(effects, source, call.arguments, scope, class_information) {
        return ""
    }
    var dispatched = dispatched_call_effects(call, scope, class_information)
    if dispatched and not effects_resize(dispatched, source, call.arguments, scope, class_information) {
        return ""
    }
    return "'{callee_text}()'"
}

func dispatched_call_effects(
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String>? {
    crash call.callee
    var key = called_effects_key(call.callee, scope, class_information)
    assert not key.is_empty() and not key.starts_with("*#")
    var variadic = call_effects.variadic_position_of(key)
    assert variadic >= -1
    var argument_count = call.arguments.count()
    var classes = DispatchClasses(argument_count)
    var spread_classes = List<String>()
    var index = 0
    while index < argument_count {
        var argument_class = argument_class_name(call.arguments[index], scope, class_information)
        if variadic >= 0 and index >= variadic {
            spread_classes.append(argument_class)
        } else {
            classes.values[index] = argument_class
        }
        index = index + 1
    }
    if variadic >= 0 and variadic < argument_count and not spread_classes.contains("") {
        classes.elements[variadic] = spread_classes.join(",")
    }
    var visiting = List<String>()
    return call_effects.resolved_effects(key, classes, visiting)
}

func called_effects_key(
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var identifier = shape.as_identifier(callee)
    if identifier {
        if scope.written_type(identifier.name) or class_information.find_field(identifier.name) {
            return ""
        }
        if call_effects.names_a_class(identifier.name) {
            var constructed = effects_class_of(callee, class_information)
            return call_effects.effects_key(constructed, identifier.name)
        }
        return call_effects.effects_key(class_information.qualified_dotted, identifier.name)
    }
    var member = shape.as_member(callee)
    if not member or member.name == "call_function" {
        return ""
    }
    if call_effects.names_a_class(member.name) {
        var constructed = effects_class_of(callee, class_information)
        return call_effects.effects_key(constructed, member.name)
    }
    crash member.object
    var root = shape.as_identifier(member.object)
    if root {
        var known = scope.written_type(root.name) or class_information.find_field(root.name)
        if not known and not call_effects.names_a_class(root.name) {
            return ""
        }
    }
    var owner = receiver_owner(member.object, scope, class_information)
    if resizes_unnamed_collection(member, owner) {
        return ""
    }
    return call_effects.effects_key(owner, member.name)
}

func argument_class_name(
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if shape.as_string_literal(argument) {
        return "String"
    }
    if shape.is_true_literal(argument) or shape.is_false_literal(argument) {
        return "Boolean"
    }
    var argument_type = argument_type_of(argument, scope, class_information)
    if not argument_type or type_shape.as_nullable(argument_type) {
        return ""
    }
    var scalar = type_shape.as_scalar(argument_type)
    if scalar {
        return type_label(argument_type)
    }
    if type_shape.as_string(argument_type) {
        return "String"
    }
    var class_reference = type_shape.as_class_ref(argument_type)
    if not class_reference or class_reference.has_signature {
        return ""
    }
    var argument_class = find_class_by_c_name(class_reference.c_name)
    if not argument_class or not call_effects.class_names.has(argument_class.qualified_dotted) {
        return ""
    }
    return argument_class.qualified_dotted
}

func argument_type_of(
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var identifier = shape.as_identifier(argument)
    if identifier {
        var local_type = scope.written_type(identifier.name)
        if local_type {
            return local_type
        }
        var field = class_information.find_field(identifier.name)
        assert field
        return field.type
    }
    var member = shape.as_member(argument)
    assert member
    crash member.object
    var object_type = argument_type_of(member.object, scope, class_information)
    assert object_type
    var plain = object_type
    var nullable = type_shape.as_nullable(object_type)
    if nullable {
        plain = nullable.inner
    }
    var united = type_shape.as_union(plain)
    if united {
        var shaped = find_union_by_c_name(united.c_name)
        assert shaped and shaped.is_shape
        return shape_field_type(shaped, member.name)
    }
    var object_class = class_of_type(plain)
    assert object_class
    var member_field = object_class.find_field(member.name)
    assert member_field
    return member_field.type
}

func resize_effects_of(
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var member = shape.as_member(callee)
    if member {
        crash member.object
        var root = shape.as_identifier(member.object)
        if root {
            var known = scope.written_type(root.name) or class_information.find_field(root.name)
            if not known and not call_effects.names_a_class(root.name) {
                return call_effects.effects_of("*", member.name)
            }
        }
    }
    return called_effects(callee, scope, class_information)
}

func effects_resize(
    effects: List<String>,
    source: String,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var links = proof_dependencies(source, scope, class_information)
    var root = scope.path_root(source)
    var local_root = false
    if scope.unnarrowed_type(root) {
        local_root = true
    }
    var index = 0
    while index < effects.count() {
        var effect = effects[index]
        if effect_resizes(effect, source, links, local_root, arguments) {
            return true
        }
        index = index + 1
    }
    return false
}

func effect_resizes(
    effect: String,
    source: String,
    links: List<String>,
    local_root: Boolean,
    arguments: List<Syntax.Expressions.Expression>,
): Boolean {
    if effect == "shrink:*" or effect == "grow:*" {
        return true
    }
    var effect_length = effect.length()
    var position_text = ""
    if effect.starts_with("parameter:") {
        position_text = effect.slice(10, effect_length)
    }
    if effect.starts_with("grow:parameter:") {
        position_text = effect.slice(15, effect_length)
    }
    if not position_text.is_empty() {
        var position = position_text.to_integer()
        crash position
        if position >= arguments.count() {
            return false
        }
        var passed = operand_text(arguments[position])
        return not passed.is_empty() and (passed == source or source.starts_with("{passed}."))
    }
    if effect.starts_with("field:") {
        if local_root {
            return false
        }
        if effect == "field:*" {
            return true
        }
        var written = effect.slice(6, effect_length)
        var link_index = 0
        while link_index < links.count() {
            if links_meet(written, links[link_index]) {
                return true
            }
            link_index = link_index + 1
        }
        return false
    }
    var resized = ""
    if effect.starts_with("shrink:") {
        resized = effect.slice(7, effect_length)
    }
    if effect.starts_with("grow:") {
        resized = effect.slice(5, effect_length)
    }
    if resized.is_empty() {
        return false
    }
    if resized.ends_with("[]") {
        return element_may_be_source(resized, links, local_root)
    }
    if local_root {
        if resized.starts_with("*#") {
            return true
        }
        var resized_class = call_effects.field_classes[resized]
        if not resized_class {
            return false
        }
        return resized_class == "Vector" or resized_class == "Items"
    }
    var vector_link = links.last()
    if not vector_link {
        return false
    }
    return links_meet(resized, vector_link)
}

func element_may_be_source(resized: String, links: List<String>, local_root: Boolean): Boolean {
    var resized_length = resized.length()
    var holder = resized.slice(0, resized_length - 2)
    if local_root or holder.ends_with("[]") {
        return true
    }
    var element_class = call_effects.element_classes[holder]
    var vector_link = links.last()
    if not element_class or not vector_link {
        return true
    }
    var source_class = call_effects.field_classes[vector_link]
    if not source_class {
        return true
    }
    var collections = ["List", "Vector", "Items", "Dictionary"]
    if not collections.contains(element_class) or not collections.contains(source_class) {
        return true
    }
    return element_class == source_class
}

# ../../../docs/optimizations.md#an-item-written-back-to-its-own-slot-is-not-written
func elides_slot_write_back(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash assignment.target
    crash assignment.value
    var target = shape.as_index(assignment.target)
    var written = shape.as_identifier(assignment.value)
    if not target or not written or not slot_proofs_allowed(class_information) {
        return false
    }
    var here = borrow_index
    if here >= borrow_statements.count() {
        return false
    }
    var at_write = shape.as_assignment_statement(borrow_statements[here])
    if not at_write {
        return false
    }
    if at_write.line != assignment.line {
        return false
    }
    var watch = slot_watch_for(written.name, target, assignment.target, scope, class_information)
    if not watch {
        return false
    }
    var read_at = slot_read_before(watch, borrow_statements, here)
    if read_at < 0 {
        return false
    }
    var written_type = scope.written_type(written.name)
    if not written_type or type_shape.as_nullable(written_type) {
        return false
    }
    var element = slot_element_type(target, scope, class_information)
    if not element or not types_equal(written_type, element) {
        return false
    }
    watch.write_back_allowed = true
    var lookahead = Scope(scope)
    if not slot_window_holds(watch, borrow_statements, read_at + 1, here, lookahead, class_information) {
        return false
    }
    return slot_watch_settles(watch)
}

# ../../../docs/optimizations.md#an-item-written-back-to-its-own-slot-is-not-written
func uncounted_slot_read(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if declaration.type_reference or not slot_proofs_allowed(class_information) {
        return ""
    }
    if scope.entry_names.contains(declaration.name) or not declares_here(declaration) {
        return ""
    }
    crash declaration.value
    var read = shape.as_index(declaration.value)
    if not read {
        return ""
    }
    crash read.object
    crash read.index
    var holder = shape.as_identifier(read.object)
    if not holder {
        return ""
    }
    var watch = slot_watch_for(declaration.name, read, declaration.value, scope, class_information)
    if not watch {
        return ""
    }
    var element = slot_element_type(read, scope, class_information)
    if not element {
        return ""
    }
    var class_reference = type_shape.as_class_ref(element)
    if not class_reference or class_reference.has_signature {
        return ""
    }
    watch.uncounted = true
    watch.write_back_allowed = true
    watch.guarded = watch.list_text.split(".")
    var declared_type = infer_declared_type(null, declaration.value, scope, class_information)
    var lookahead = Scope(scope)
    lookahead.declare(declaration.name, declared_type)
    var statements = borrow_statements
    var start = borrow_index + 1
    var end = statements.count()
    if not slot_window_holds(watch, statements, start, end, lookahead, class_information) {
        return ""
    }
    if not slot_watch_settles(watch) {
        return ""
    }
    var list_type = receiver_type_of(read.object, scope, class_information)
    crash list_type
    var list_code = generate_expression(read.object, scope, class_information)
    var integer_spite_type = integer_type()
    var index_code = coerce_for_store(read.index, integer_spite_type, scope, class_information)
    var list_temporary = next_temporary()
    var index_temporary = next_temporary()
    var item = list_item_code(element, list_temporary, index_temporary)
    var outside = "{index_temporary} < 0 || {index_temporary} >= ({list_temporary})->item_count_"
    var opening = "(\{ {c_type_name(list_type)} {list_temporary} = {list_code.code}; int32_t {index_temporary} = {index_code};"
    if type_shape.as_nullable(declared_type) {
        return "{opening} ({outside}) ? 0 : {item}; })"
    }
    ensure_index_check()
    var printer = Syntax.SourcePrinter()
    var read_source = printer.source_expression(declaration.value)
    var read_text = escape_c_string(read_source)
    var where = located(current_path, current_line, current_owner, current_function)
    return "{opening} if (__builtin_expect({outside}, 0)) spite_outside_list(\"{read_text}\", {where}); {item}; })"
}

func slot_proofs_allowed(class_information: Analysis.ClassInfo): Boolean {
    if hot_reload or read_evaluate_print_loop or remote_loop_port != 0 or keeps_internals or resumable_mode {
        return false
    }
    return not is_library_class(class_information)
}

func slot_watch_for(
    name: String,
    read: Syntax.Expressions.IndexExpression,
    slot: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): SlotWatch? {
    crash read.object
    crash read.index
    var list_text = operand_text(read.object)
    var slot_text = operand_text(slot)
    assert not list_text.is_empty() and not slot_text.is_empty() and plain_path(read.object)
    var element = slot_element_type(read, scope, class_information)
    assert element
    assert not type_shape.as_nullable(element)
    var index_name = shape.as_identifier(read.index)
    assert index_name or shape.as_integer_literal(read.index)
    var watch = SlotWatch(name, slot_text, list_text)
    watch.element = element
    watch.guarded = list_text.split(".")
    if index_name {
        watch.guarded.append(index_name.name)
    }
    assert not watch.guarded.contains(name)
    return watch
}

func plain_path(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_identifier(expression) {
        return true
    }
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    return plain_path(member.object)
}

func slot_element_type(
    read: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    crash read.object
    var list_type = receiver_type_of(read.object, scope, class_information)
    assert list_type
    var listed = type_shape.as_list(list_type)
    assert listed
    return listed.element
}

func slot_read_before(watch: SlotWatch, statements: List<Syntax.Statements.Statement>, here: Integer): Integer {
    var index = here - 1
    while index >= 0 {
        var declared = shape.as_variable_declaration(statements[index])
        if declared {
            if declared.name == watch.name {
                crash declared.value
                if declared.type_reference or not shape.as_index(declared.value) {
                    return -1
                }
                if operand_text(declared.value) != watch.slot_text {
                    return -1
                }
                return index
            }
        }
        index = index - 1
    }
    return -1
}

func slot_window_holds(
    watch: SlotWatch,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    end: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = start
    while index < end {
        if not slot_statement_holds(watch, statements[index], scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func slot_block_holds(
    watch: SlotWatch,
    statements: List<Syntax.Statements.Statement>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var inner = Scope(scope)
    var end = statements.count()
    return slot_window_holds(watch, statements, 0, end, inner, class_information)
}

func slot_statement_holds(
    watch: SlotWatch,
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            if statement.name == watch.name or watch.guarded.contains(statement.name) {
                return false
            }
            crash statement.value
            if not slot_expression_holds(watch, statement.value, scope, class_information) {
                return false
            }
            watch.locals.append(statement.name)
            declare_ahead(statement, scope, class_information)
            var declared_type = scope.written_type(statement.name)
            if not declared_type or type_needs_drop(declared_type) {
                watch.object_locals = true
            }
            return true
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            if not slot_target_holds(watch, statement.target, statement.value, scope, class_information) {
                return false
            }
            if shape.as_index(statement.target) {
                return true
            }
            return slot_expression_holds(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            if not is_identifier_named(statement.condition, watch.name) {
                if not slot_expression_holds(watch, statement.condition, scope, class_information) {
                    return false
                }
            }
            if not slot_block_holds(watch, statement.then_branch, scope, class_information) {
                return false
            }
            return slot_block_holds(watch, statement.else_branch, scope, class_information)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            if not slot_expression_holds(watch, statement.condition, scope, class_information) {
                return false
            }
            return slot_block_holds(watch, statement.body, scope, class_information)
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            if is_identifier_named(statement.value, watch.name) {
                var guarded_type = scope.written_type(watch.name)
                if not guarded_type {
                    return false
                }
                var maybe = type_shape.as_nullable(guarded_type)
                if maybe {
                    var present_type = maybe.inner
                    scope.declare(watch.name, present_type)
                }
                return true
            }
            return slot_expression_holds(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                return slot_expression_holds(watch, statement.value, scope, class_information)
            }
            return true
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return slot_expression_holds(watch, statement.value, scope, class_information)
        }
        _: return false
    }
}

func slot_target_holds(
    watch: SlotWatch,
    target: Syntax.Expressions.Expression,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var identifier = shape.as_identifier(target)
    if identifier {
        if identifier.name == watch.name or watch.guarded.contains(identifier.name) {
            return false
        }
        var local_type = scope.written_type(identifier.name)
        if local_type {
            if type_needs_drop(local_type) {
                watch.object_locals = true
            }
            return true
        }
        var field = class_information.find_field(identifier.name)
        if not field or class_information.find_function("set_{identifier.name}") {
            return false
        }
        var field_type = field.type
        if type_needs_drop(field_type) {
            watch.object_locals = true
        }
        return true
    }
    var written_slot = shape.as_index(target)
    if written_slot {
        if is_bound_member_index(written_slot) {
            return bound_attribute_write(watch, written_slot, value, scope, class_information)
        }
        if plain_list_write(watch, written_slot, value, scope, class_information) {
            return true
        }
        watch.object_locals = true
        return watch.write_back_allowed and operand_text(target) == watch.slot_text and is_identifier_named(value, watch.name)
    }
    var member = shape.as_member(target)
    if not member {
        return false
    }
    crash member.object
    if watch.guarded.contains(member.name) {
        return false
    }
    if not is_identifier_named(member.object, watch.name) {
        if not slot_expression_holds(watch, member.object, scope, class_information) {
            return false
        }
    }
    var holder_type = receiver_type_of(member.object, scope, class_information)
    if not holder_type {
        return false
    }
    var holder_class = class_behind(holder_type)
    if not holder_class or holder_class.find_function("set_{member.name}") {
        return false
    }
    var written_field = holder_class.find_field(member.name)
    if not written_field {
        return false
    }
    var written_type = written_field.type
    if type_needs_drop(written_type) {
        watch.object_locals = true
    }
    return true
}

# ../../../docs/optimizations.md#an-item-a-name-holds-from-its-list-is-not-counted
func bound_attribute_write(
    watch: SlotWatch,
    written: Syntax.Expressions.IndexExpression,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash written.object
    var member = shape.as_member(written.object)
    if not member or bound_through_caller or bound_member_is_function() {
        return false
    }
    if not bound_compared_value.is_empty() or not bound_chain_method.is_empty() {
        return false
    }
    if watch.guarded.contains(bound_field_name) or watch.name == bound_field_name {
        return false
    }
    crash member.object
    if not is_identifier_named(member.object, watch.name) {
        if not slot_expression_holds(watch, member.object, scope, class_information) {
            return false
        }
    }
    if not bound_field_type {
        watch.object_locals = true
        return slot_expression_holds(watch, value, scope, class_information)
    }
    if type_needs_drop(bound_field_type) {
        watch.object_locals = true
    }
    return slot_expression_holds(watch, value, scope, class_information)
}

func plain_list_write(
    watch: SlotWatch,
    written: Syntax.Expressions.IndexExpression,
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash written.object
    crash written.index
    var written_type = receiver_type_of(written.object, scope, class_information)
    if not written_type {
        return false
    }
    var written_list = type_shape.as_list(written_type)
    if not written_list {
        return false
    }
    var written_element = written_list.element
    if type_needs_drop(written_element) {
        return false
    }
    if not slot_expression_holds(watch, written.object, scope, class_information) {
        return false
    }
    if not slot_expression_holds(watch, written.index, scope, class_information) {
        return false
    }
    return slot_expression_holds(watch, value, scope, class_information)
}

func slot_expressions_hold(
    watch: SlotWatch,
    expressions: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < expressions.count() {
        var expression = expressions[index]
        var passed = operand_text(expression)
        var held_item = watch.uncounted and is_identifier_named(expression, watch.name)
        if passed.is_empty() and not shape.as_identifier(expression) and not shape.as_member(expression) {
            if not slot_expression_holds(watch, expression, scope, class_information) {
                return false
            }
        } else if not held_item {
            if passed == watch.list_text or watch.list_text.starts_with("{passed}.") {
                return false
            }
            if not slot_expression_holds(watch, expression, scope, class_information) {
                return false
            }
        }
        index = index + 1
    }
    return true
}

func slot_expression_holds(
    watch: SlotWatch,
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            if not slot_expressions_hold(watch, expression.arguments, scope, class_information) {
                return false
            }
            return slot_call_holds(watch, expression.callee, scope, class_information)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            if not slot_expressions_hold(watch, expression.arguments, scope, class_information) {
                return false
            }
            var constructed_class = effects_class_of(expression.callee, class_information)
            var constructed = called_name_of(expression.callee)
            var key = call_effects.effects_key(constructed_class, constructed)
            watch.constructs = true
            return slot_key_holds(watch, key)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if operators_release() {
                return false
            }
            if not slot_expression_holds(watch, expression.left, scope, class_information) {
                return false
            }
            return slot_expression_holds(watch, expression.right, scope, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return slot_expression_holds(watch, expression.operand, scope, class_information)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            if any_releases("get_{expression.name}") {
                return false
            }
            if is_identifier_named(expression.object, watch.name) {
                return true
            }
            return slot_expression_holds(watch, expression.object, scope, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            if is_bound_member_index(expression) {
                var bound_read = bound_member_expression(expression)
                return slot_expression_holds(watch, bound_read, scope, class_information)
            }
            var indexed_type = receiver_type_of(expression.object, scope, class_information)
            if not indexed_type {
                return false
            }
            if not type_shape.as_list(indexed_type) and not type_shape.as_dictionary(indexed_type) {
                return false
            }
            if not slot_expression_holds(watch, expression.object, scope, class_information) {
                return false
            }
            return slot_expression_holds(watch, expression.index, scope, class_information)
        }
        Syntax.Expressions.IdentifierExpression: return not watch.uncounted or expression.name != watch.name
        Syntax.Expressions.StringLiteralExpression: return not expression.value.contains("\{")
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        _: return false
    }
}

func slot_call_holds(
    watch: SlotWatch,
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var member = shape.as_member(callee)
    if member {
        crash member.object
        if operand_text(member.object) == watch.list_text {
            var reads = ["count", "is_empty", "get_at", "contains", "index_of", "first", "last"]
            return reads.contains(member.name)
        }
        if member.name == "call_function" {
            return false
        }
        if not is_identifier_named(member.object, watch.name) {
            if not slot_expression_holds(watch, member.object, scope, class_information) {
                return false
            }
        }
    } else if not shape.as_identifier(callee) {
        return false
    }
    var key = called_effects_key(callee, scope, class_information)
    return slot_key_holds(watch, key)
}

func slot_key_holds(watch: SlotWatch, key: String): Boolean {
    if key.is_empty() {
        return false
    }
    var effects = call_effects.by_function[key]
    if not effects {
        return false
    }
    var index = 0
    while index < effects.keys.count() {
        var effect = effects.keys[index]
        if effect == "release:value" or effect == "field:*" or effect == "grow:*" {
            return false
        }
        if effect.starts_with("store:") and store_may_reach(watch, effect) {
            return false
        }
        if effect.starts_with("shrink:") or effect.starts_with("parameter:") or effect.starts_with("grow:parameter:") {
            return false
        }
        if effect.starts_with("field:") {
            var parts = effect.split("#")
            var written = parts.last()
            if not written or watch.guarded.contains(written) {
                return false
            }
        }
        index = index + 1
    }
    watch.keys.append(key)
    return true
}

# ../../../docs/proofs.md#an-item-a-name-holds-from-its-list-is-not-counted
func store_may_reach(watch: SlotWatch, effect: String): Boolean {
    var effect_length = effect.length()
    var stored = effect.slice(6, effect_length)
    if not stored.starts_with("shrink:") or stored.ends_with("[]") {
        return true
    }
    var stored_length = stored.length()
    var path = stored.slice(7, stored_length)
    var parts = path.split("#")
    if parts.count() != 2 {
        return true
    }
    var writer_name = parts[0]
    var field_name = parts[1]
    if watch.guarded.contains(field_name) or writer_name == "*" {
        return true
    }
    var owner = find_class_by_qualified(writer_name)
    if not owner {
        return true
    }
    var field = owner.find_field(field_name)
    if not field {
        return true
    }
    if type_shape.as_dictionary(field.type) {
        return false
    }
    var listed = type_shape.as_list(field.type)
    if not listed {
        return true
    }
    var stored_element = listed.element
    if not type_needs_drop(stored_element) {
        return false
    }
    if not watch.element {
        return true
    }
    var stored_reference = type_shape.as_class_ref(stored_element)
    if not stored_reference {
        return true
    }
    if not find_class_by_c_name(stored_reference.c_name) {
        return true
    }
    return types_equal(stored_element, watch.element)
}

func slot_watch_settles(watch: SlotWatch): Boolean {
    var reached_classes = call_effects.reached_classes(watch.keys)
    var blocking = ["Parallel", "Concurrent", "ThreadPool", "Scheduler", "Lock", "Program", "Console", "File", "Socket"]
    var index = 0
    while index < blocking.count() {
        if reached_classes.has(blocking[index]) {
            return false
        }
        index = index + 1
    }
    var reached = call_effects.reached_functions(watch.keys)
    var reached_names = reached.keys()
    index = 0
    while index < reached_names.count() {
        var reached_name = reached_names[index]
        if moves_items(reached_name) {
            return false
        }
        index = index + 1
    }
    if drops_may_release() and (watch.constructs or watch.object_locals or not watch.keys.is_empty()) {
        return false
    }
    return true
}

# ../../../specs/memory.md#assigning-a-name-read-from-a-list-changes-only-the-name
func report_replaced_item(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert not is_library_class(class_information) and declares_here(declaration)
    assert not scope.entry_names.contains(declaration.name)
    crash declaration.value
    var source = item_read_of(declaration.value, scope, class_information)
    assert source
    var replaced = List<Syntax.Statements.AssignmentStatement>()
    replaced_assignments(declaration.name, borrow_statements, borrow_index + 1, replaced)
    var printer = Syntax.SourcePrinter()
    var saved_line = current_line
    var index = 0
    while index < replaced.count() {
        var assignment = replaced[index]
        crash assignment.value
        current_line = assignment.line
        var value_text = printer.source_expression(assignment.value)
        var name = declaration.name
        if source.owner.is_empty() {
            report(
                "'{name}' was read from '{source.slot}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{source.container}' still holds the old item. Write '{source.slot} = {value_text}' to replace the item, or give the new value a 'var' of its own",
            )
        } else if source.writer.is_empty() {
            report(
                "'{name}' holds '{source.slot}' of '{source.owner}', answered by '{source.call}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{source.owner}' still holds the old item. Replace it through a function of '{source.owner}' that writes '{source.slot}', or give the new value a 'var' of its own",
            )
        } else {
            report(
                "'{name}' holds '{source.slot}' of '{source.owner}', answered by '{source.call}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{source.owner}' still holds the old item. Replace it through '{source.owner}.{source.writer}', which writes '{source.container}', or give the new value a 'var' of its own",
            )
        }
        index = index + 1
    }
    current_line = saved_line
}

func item_read_of(
    value: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ReplacedItem? {
    var printer = Syntax.SourcePrinter()
    var read = shape.as_index(value)
    if read {
        crash read.object
        var holder_type = receiver_type_of(read.object, scope, class_information)
        assert holder_type and holds_list_items(holder_type)
        var slot_text = printer.source_expression(value)
        var container_text = printer.source_expression(read.object)
        return ReplacedItem(slot_text, container_text)
    }
    var call = shape.as_call(value)
    assert call
    crash call.callee
    var answering: Analysis.ClassInfo? = null
    var answered: Analysis.FunctionInfo? = null
    var named = shape.as_identifier(call.callee)
    if named {
        assert not scope.written_type(named.name) and not class_information.find_field(named.name)
        answering = class_information
        answered = class_information.find_function(named.name)
    }
    var member = shape.as_member(call.callee)
    if member {
        crash member.object
        var receiver_type = receiver_type_of(member.object, scope, class_information)
        assert receiver_type and type_shape.as_class_ref(receiver_type)
        answering = class_behind(receiver_type)
        assert answering
        answered = answering.find_function(member.name)
    }
    assert answering and answered
    var found = answered_item(answering, answered, 0)
    assert found
    found.call = printer.source_expression(value)
    return found
}

func holds_list_items(holder_type: Analysis.SpiteType): Boolean {
    if type_shape.as_nullable(holder_type) {
        return false
    }
    return type_shape.as_list(holder_type) or type_shape.as_dictionary(holder_type)
}

func answered_item(owner: Analysis.ClassInfo, function: Analysis.FunctionInfo, depth: Integer): ReplacedItem? {
    assert depth < 4 and function.has_body and not function.is_constructor and not is_library_class(owner)
    var returned = List<Syntax.Expressions.Expression>()
    collect_item_returns(function.body, returned)
    assert not returned.is_empty()
    var found: ReplacedItem? = null
    var index = 0
    while index < returned.count() {
        var value = returned[index]
        var item = returned_item(owner, function, value, depth)
        assert item
        if not found {
            found = item
        }
        index = index + 1
    }
    return found
}

func collect_item_returns(
    statements: List<Syntax.Statements.Statement>,
    returned: List<Syntax.Expressions.Expression>,
) {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        switch statement {
            Syntax.Statements.ReturnStatement: {
                if statement.value {
                    if not shape.is_null_literal(statement.value) {
                        returned.append(statement.value)
                    }
                }
            }
            Syntax.Statements.IfStatement: {
                collect_item_returns(statement.then_branch, returned)
                collect_item_returns(statement.else_branch, returned)
            }
            Syntax.Statements.WhileStatement: collect_item_returns(statement.body, returned)
            Syntax.Statements.SwitchStatement: {
                var case_index = 0
                while case_index < statement.cases.count() {
                    collect_item_returns(statement.cases[case_index].body, returned)
                    case_index = case_index + 1
                }
            }
            _: {}
        }
        index = index + 1
    }
}

func returned_item(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    value: Syntax.Expressions.Expression,
    depth: Integer,
): ReplacedItem? {
    var printer = Syntax.SourcePrinter()
    var read = shape.as_index(value)
    if read {
        crash read.object
        var holder_type = item_holder_type(owner, function, read.object)
        assert holder_type and holds_list_items(holder_type)
        var slot_text = printer.source_expression(value)
        var container_text = printer.source_expression(read.object)
        var item = ReplacedItem(slot_text, container_text)
        item.owner = owner.simple_name
        item.writer = item_writer(owner, container_text)
        return item
    }
    var call = shape.as_call(value)
    assert call
    crash call.callee
    var named = shape.as_identifier(call.callee)
    if named {
        assert not item_holder_type(owner, function, call.callee)
        var own = owner.find_function(named.name)
        assert own
        return answered_item(owner, own, depth + 1)
    }
    var member = shape.as_member(call.callee)
    assert member
    crash member.object
    var receiver_type = item_holder_type(owner, function, member.object)
    assert receiver_type and type_shape.as_class_ref(receiver_type)
    var receiver_class = class_behind(receiver_type)
    assert receiver_class
    var called = receiver_class.find_function(member.name)
    assert called
    return answered_item(receiver_class, called, depth + 1)
}

func item_holder_type(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    expression: Syntax.Expressions.Expression,
): Analysis.SpiteType? {
    var named = shape.as_identifier(expression)
    if named {
        var index = 0
        while index < function.parameters.count() {
            var parameter = function.parameters[index]
            if parameter.name == named.name {
                return parameter.type
            }
            index = index + 1
        }
        var field = owner.find_field(named.name)
        assert field and not owner.find_function("get_{named.name}")
        return field.type
    }
    var member = shape.as_member(expression)
    assert member
    crash member.object
    var holder_type = item_holder_type(owner, function, member.object)
    assert holder_type and type_shape.as_class_ref(holder_type)
    var holder_class = class_behind(holder_type)
    assert holder_class and not holder_class.find_function("get_{member.name}")
    var member_field = holder_class.find_field(member.name)
    assert member_field
    return member_field.type
}

func item_writer(owner: Analysis.ClassInfo, container_text: String): String {
    var index = 0
    while index < owner.declared_functions.count() {
        var function = owner.declared_functions[index]
        if not function.is_constructor and writes_container(function.body, container_text) {
            return function.name
        }
        index = index + 1
    }
    return ""
}

func writes_container(statements: List<Syntax.Statements.Statement>, container_text: String): Boolean {
    var printer = Syntax.SourcePrinter()
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        var assignment = shape.as_assignment_statement(statement)
        if assignment {
            crash assignment.target
            var written = shape.as_index(assignment.target)
            if written {
                crash written.object
                if printer.source_expression(written.object) == container_text {
                    return true
                }
            }
        }
        var branched = shape.as_if_statement(statement)
        if branched {
            if writes_container(branched.then_branch, container_text) or writes_container(branched.else_branch, container_text) {
                return true
            }
        }
        var looped = shape.as_while_statement(statement)
        if looped {
            if writes_container(looped.body, container_text) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func replaced_assignments(
    name: String,
    statements: List<Syntax.Statements.Statement>,
    from: Integer,
    replaced: List<Syntax.Statements.AssignmentStatement>,
) {
    var last = -1
    var index = from
    while index < statements.count() {
        var mentioned = List<String>()
        collect_statement_names(statements[index], mentioned)
        if mentioned.contains(name) {
            last = index
        }
        index = index + 1
    }
    assert last >= 0
    index = from
    while index < last {
        assert not statement_assigns(name, statements[index])
        index = index + 1
    }
    crash statements[last]
    var statement = statements[last]
    switch statement {
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            if is_identifier_named(statement.target, name) {
                replaced.append(statement)
            }
        }
        Syntax.Statements.IfStatement: {
            replaced_assignments(name, statement.then_branch, 0, replaced)
            replaced_assignments(name, statement.else_branch, 0, replaced)
        }
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                replaced_assignments(name, statement.cases[case_index].body, 0, replaced)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func moves_items(key: String): Boolean {
    var moving = ["#reverse", "#move_items", "#swap", "#_swap", "#swap_values"]
    var index = 0
    while index < moving.count() {
        if key.ends_with(moving[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func borrowed_element(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var statements = borrow_statements
    var start = borrow_index + 1
    var holder_name = "values"
    if is_items_class(class_information) {
        holder_name = "references"
    }
    if class_information.qualified_dotted != "List" and not is_items_class(class_information) {
        return ""
    }
    if declaration.type_reference or hot_reload {
        return ""
    }
    if scope.entry_names.contains(declaration.name) or class_information.codegen_types.count() <= 0 {
        return ""
    }
    crash declaration.value
    var read = shape.as_member(declaration.value)
    if read {
        return borrowed_field(declaration, read, statements, start, scope, class_information)
    }
    var call = shape.as_call(declaration.value)
    if not call or call.arguments.count() != 2 {
        return ""
    }
    crash call.callee
    var member = shape.as_member(call.callee)
    if not member or member.name != "read_value" {
        return ""
    }
    crash member.object
    if not is_identifier_named(member.object, holder_name) or not is_identifier_named(call.arguments[0], "items") {
        return ""
    }
    var element_type = class_information.codegen_types[0]
    if not type_needs_drop(element_type) or type_shape.as_nullable(element_type) {
        return ""
    }
    var watch = ReleaseWatch(declaration.name)
    watch.element_owner = watched_owner(element_type)
    if not watch_statements(watch, statements, start, scope, class_information) or window_may_run_drop(watch) {
        return ""
    }
    var integer_spite_type = integer_type()
    var index_code = coerce_for_store(call.arguments[1], integer_spite_type, scope, class_information)
    return "(({c_type_name(element_type)}*)(intptr_t)self->items_)[{index_code}]"
}

func borrowed_field(
    declaration: Syntax.Statements.VariableDeclaration,
    read: Syntax.Expressions.MemberExpression,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    crash read.object
    var holder = shape.as_identifier(read.object)
    if not holder or not borrowed_names.contains(holder.name) {
        return ""
    }
    var holder_type = scope.written_type(holder.name)
    var holder_class = class_behind(holder_type)
    if not holder_class or holder_class.find_function("get_{read.name}") {
        return ""
    }
    var field = holder_class.find_field(read.name)
    if not field {
        return ""
    }
    var field_type = field.type
    if not type_needs_drop(field_type) or type_shape.as_nullable(field_type) {
        return ""
    }
    var watch = ReleaseWatch(declaration.name)
    watch.element_owner = watched_owner(field_type)
    if not watch_statements(watch, statements, start, scope, class_information) or window_may_run_drop(watch) {
        return ""
    }
    var generated = generate_expression(declaration.value, scope, class_information)
    return generated.code
}

func watch_statements(
    watch: ReleaseWatch,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = start
    while index < statements.count() {
        if not releases_nothing(watch, statements[index], scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func releases_nothing(
    watch: ReleaseWatch,
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            if statement.name == watch.name {
                return false
            }
            watch.locals.append(statement.name)
            crash statement.value
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var target = shape.as_identifier(statement.target)
            if not target {
                return false
            }
            var local = watch.locals.contains(target.name) or scope.written_type(target.name)
            if not local or target.name == watch.name or class_information.find_field(target.name) {
                return false
            }
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            if not watch_expression(watch, statement.condition, scope, class_information) {
                return false
            }
            if not watch_statements(watch, statement.then_branch, 0, scope, class_information) {
                return false
            }
            return watch_statements(watch, statement.else_branch, 0, scope, class_information)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            if not watch_expression(watch, statement.condition, scope, class_information) {
                return false
            }
            return watch_statements(watch, statement.body, 0, scope, class_information)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                return watch_expression(watch, statement.value, scope, class_information)
            }
            return true
        }
        _: return false
    }
}

func watch_expressions(
    watch: ReleaseWatch,
    expressions: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < expressions.count() {
        if not watch_expression(watch, expressions[index], scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func watch_expression(
    watch: ReleaseWatch,
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            if not watch_expressions(watch, expression.arguments, scope, class_information) {
                return false
            }
            return watch_call(watch, expression.callee, scope, class_information)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            if not watch_expressions(watch, expression.arguments, scope, class_information) {
                return false
            }
            var constructed = called_name_of(expression.callee)
            if watch.strict {
                var constructed_class = effects_class_of(expression.callee, class_information)
                var constructed_key = call_effects.effects_key(constructed_class, constructed)
                var constructed_effects = call_effects.effects_of(constructed_class, constructed)
                if constructed_key.is_empty() or not window_keeps(constructed_effects) {
                    return false
                }
                watch.keys.append(constructed_key)
            }
            return not any_releases(constructed)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            if operators_release() {
                return false
            }
            if not watch_expression(watch, expression.left, scope, class_information) {
                return false
            }
            return watch_expression(watch, expression.right, scope, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return watch_expression(watch, expression.operand, scope, class_information)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            if any_releases("get_{expression.name}") {
                return false
            }
            if watch.strict and not reads_local_attribute(watch, expression.object, scope) {
                return false
            }
            return watch_expression(watch, expression.object, scope, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            if bound_member_owner_c_name.is_empty() or not is_bound_member_index(expression) {
                return false
            }
            var read = bound_member_expression(expression)
            return watch_expression(watch, read, scope, class_information)
        }
        Syntax.Expressions.IdentifierExpression: return true
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.StringLiteralExpression: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        _: return false
    }
}

func watch_call(
    watch: ReleaseWatch,
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var member = shape.as_member(callee)
    if member {
        crash member.object
        if member.name == "release_value" or not watch_expression(watch, member.object, scope, class_information) {
            return false
        }
        var called_name = member.name
        if watch.strict and called_name == bound_pattern and not bound_pattern.is_empty() {
            called_name = bound_function_name
        }
        if not call_effects.by_function.has("*#{called_name}") and any_releases("missing_function") {
            return false
        }
    } else {
        var identifier = shape.as_identifier(callee)
        if not identifier or watch.locals.contains(identifier.name) {
            return false
        }
        var constructs = watch.strict and call_effects.names_a_class(identifier.name)
        if not class_information.find_function(identifier.name) and not constructs {
            return false
        }
    }
    if watch.strict {
        return watch_strict_call(watch, callee, scope, class_information)
    }
    var effects = watched_effects(watch, callee, scope, class_information)
    if effects.contains("release") or effects.contains("field:*") {
        return false
    }
    var key = watched_key(watch, callee, scope, class_information)
    if key.is_empty() {
        watch.unknown_call = true
    } else {
        watch.reached.append(key)
    }
    return true
}

func watched_key(
    watch: ReleaseWatch,
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var member = shape.as_member(callee)
    if member and not watch.element_owner.is_empty() {
        crash member.object
        if is_identifier_named(member.object, watch.name) {
            return call_effects.effects_key(watch.element_owner, member.name)
        }
    }
    var key = called_effects_key(callee, scope, class_information)
    if not key.is_empty() or not member {
        return key
    }
    crash member.object
    if member.name == "call_function" or call_effects.names_a_class(member.name) {
        return ""
    }
    var owner = receiver_owner(member.object, scope, class_information)
    return call_effects.effects_key(owner, member.name)
}

func window_may_run_drop(watch: ReleaseWatch): Boolean {
    if not drops_may_release() {
        return false
    }
    if watch.unknown_call {
        return true
    }
    var constructed = call_effects.reached_constructions(watch.reached)
    var index = 0
    while index < constructed.count() {
        var made = find_class_by_qualified(constructed[index])
        if not made or not is_library_class(made) {
            return true
        }
        index = index + 1
    }
    return false
}

func watch_strict_call(
    watch: ReleaseWatch,
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var called = callee
    var member = shape.as_member(callee)
    if member {
        if member.name == bound_pattern and not bound_pattern.is_empty() {
            crash member.object
            var named: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(
                member.object,
                bound_function_name,
            )
            called = named
        }
    }
    var key = called_effects_key(called, scope, class_information)
    if key.is_empty() {
        return false
    }
    var effects = call_effects.by_function[key]
    if not effects {
        return false
    }
    if not window_keeps(effects.keys) {
        return false
    }
    watch.keys.append(key)
    return true
}

func window_keeps(effects: List<String>): Boolean {
    var index = 0
    while index < effects.count() {
        var effect = effects[index]
        if effect == "release" or effect == "field:*" or effect.starts_with("shrink:") {
            return false
        }
        index = index + 1
    }
    return true
}

func reads_local_attribute(watch: ReleaseWatch, object: Syntax.Expressions.Expression, scope: Scope): Boolean {
    var identifier = shape.as_identifier(object)
    if not identifier {
        var member = shape.as_member(object)
        if not member {
            return false
        }
        crash member.object
        return reads_local_attribute(watch, member.object, scope)
    }
    if watch.locals.contains(identifier.name) {
        return true
    }
    var local_type = scope.written_type(identifier.name)
    if not local_type {
        return false
    }
    var local_class = class_behind(local_type)
    if not local_class {
        return true
    }
    return not local_class.is_singleton
}

func watched_owner(watched_type: Analysis.SpiteType): String {
    var class_reference = type_shape.as_class_ref(watched_type)
    if not class_reference or class_reference.has_signature {
        return ""
    }
    var owner = find_class_by_c_name(class_reference.c_name)
    if not owner {
        return ""
    }
    return owner.qualified_dotted
}

func watched_effects(
    watch: ReleaseWatch,
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var member = shape.as_member(callee)
    if member and not watch.element_owner.is_empty() {
        crash member.object
        if is_identifier_named(member.object, watch.name) {
            return call_effects.effects_of(watch.element_owner, member.name)
        }
    }
    return called_effects(callee, scope, class_information)
}

func effects_class_of(named: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): String {
    var found = try_resolve_static_path(named, class_information.qualified_dotted)
    if not found {
        return "*"
    }
    return found.qualified_dotted
}

func called_name_of(callee: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(callee)
    if identifier {
        return identifier.name
    }
    var member = shape.as_member(callee)
    if not member {
        return ""
    }
    return member.name
}

func any_releases(name: String): Boolean {
    var effects = call_effects.effects_of("*", name)
    return effects.contains("release") or effects.contains("field:*")
}

func operators_release(): Boolean {
    var names = ["sum", "subtract", "multiply", "divide", "modulo", "equals", "less_than", "greater_than", "to_string"]
    return names.any(any_releases)
}

func choose_allocator_after(statements: List<Syntax.Statements.Statement>, index: Integer) {
    pending_allocator = null
    assert index + 1 < statements.count()
    var declaration = shape.as_variable_declaration(statements[index])
    assert declaration
    var setting = shape.as_assignment_statement(statements[index + 1])
    assert setting
    crash setting.target
    assert allocator_object_name(setting.target) == declaration.name
    pending_allocator = setting
    chosen_allocator_lines.append("{current_path}:{setting.line}")
}

func allocator_object_name(target: Syntax.Expressions.Expression): String {
    var chosen = shape.as_member(target)
    if not chosen {
        return ""
    }
    if chosen.name != "allocator" {
        return ""
    }
    crash chosen.object
    var memory = shape.as_member(chosen.object)
    if not memory {
        return ""
    }
    if memory.name != "memory" {
        return ""
    }
    crash memory.object
    var object_text = operand_text(memory.object)
    if object_text.is_empty() {
        return "this object"
    }
    return object_text
}

func is_name_path(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_identifier(expression) {
        return true
    }
    var member = shape.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    return is_name_path(member.object)
}

func generate_allocated_declaration(
    declaration: Syntax.Statements.VariableDeclaration,
    setting: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    pending_allocator = null
    current_line = setting.line
    var allocated = allocated_declaration(declaration, setting, scope, class_information)
    current_line = declaration.line
    if not allocated {
        generate_variable_declaration(declaration, scope, class_information)
    }
}

func allocated_declaration(
    declaration: Syntax.Statements.VariableDeclaration,
    setting: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash declaration.value
    crash setting.value
    var saved_counter = temporary_counter
    var probe = generate_expression(setting.value, scope, class_information)
    rewind_temporaries(saved_counter)
    var allocator_type = probe.type
    var allocator_class = allocator_class_of(allocator_type)
    if not allocator_class {
        return false
    }
    var allocating = allocator_class.find_function("allocate")
    var freeing = allocator_class.find_function("free")
    crash allocating
    crash freeing
    if not is_name_path(setting.value) {
        report(
            "an allocator is made on a line of its own and then named here: 'var arena = Memory.Arena(65536)', and then '{declaration.name}.memory.allocator = arena'",
        )
        return false
    }
    current_line = declaration.line
    var declared_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
    var placed_class = allocatable_class(declared_type)
    if not placed_class {
        var display_name = type_display_name(declared_type)
        current_line = setting.line
        report(
            "only an object gets an allocator of its own, and '{declaration.name}' is a value of type {display_name}, which the compiler places itself",
        )
    }
    if not placed_class {
        return false
    }
    var value_code = coerce_for_store(declaration.value, declared_type, scope, class_information)
    var allocator_name = next_temporary()
    var given_back = ensure_given_back(allocator_class, freeing)
    var head = "{allocator_name}, {given_back}, {allocating.c_name}({allocator_name}, (int64_t)sizeof({placed_class.c_name}))"
    var placed_code = allocated_code(placed_class, value_code, head)
    if placed_code.is_empty() {
        current_line = setting.line
        report(
            "'{declaration.name}' gets an allocator only on the line right after the line that makes it: a constructor, 'List<T>()' or '.copy()'",
        )
        return false
    }
    var allocator_code = coerce_for_store(setting.value, allocator_type, scope, class_information)
    builder.add_user("{c_type_name(allocator_type)} {allocator_name} = {allocator_code};")
    var declared_code = c_value_name(declaration.name)
    builder.add_user("{c_type_name(declared_type)} {declared_code} = {placed_code};")
    scope.declare_owned(declaration.name, declared_type)
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    note_fact("allocated {placed_class.c_name}")
    note_allocated_class(placed_class)
    return true
}

func note_allocated_class(placed_class: Analysis.ClassInfo) {
    if not allocated_class_names.contains(placed_class.c_name) {
        allocated_class_names.append(placed_class.c_name)
        allocated_classes.append(placed_class)
    }
}

func allocator_class_of(allocator_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var reference = type_shape.as_class_ref(allocator_type)
    if reference {
        var found = find_class_by_c_name(reference.c_name)
        if found {
            assert found.qualified_dotted != "Memory.Heap"
            if is_allocator_member(found) {
                return found
            }
            if found.is_instantiated and is_allocator_class(found) {
                report(
                    "'{type_display_name(allocator_type)}' is a generic class, and an allocator is a class of its own that is not generic, like 'Memory.Arena'",
                )
                return null
            }
        }
    }
    var display_name = type_display_name(allocator_type)
    report(
        "'{display_name}' is not an allocator: an allocator answers 'allocate(bytes: Long): Memory.Address' and 'free(address: Memory.Address)', like 'Memory.Arena'",
    )
    return null
}

func is_allocator_class(candidate: Analysis.ClassInfo): Boolean {
    if candidate.is_generic_template or candidate.is_value_class {
        return false
    }
    var allocating = candidate.find_function("allocate")
    var freeing = candidate.find_function("free")
    if not allocating or not freeing {
        return false
    }
    if allocating.parameters.count() != 1 or freeing.parameters.count() != 1 {
        return false
    }
    var allocated_from = allocating.parameters[0].type
    var freed_from = freeing.parameters[0].type
    if type_display_name(allocated_from) != "Long" or type_display_name(freed_from) != "Memory.Address" {
        return false
    }
    var allocated = allocating.return_type
    var freed = freeing.return_type
    return type_display_name(allocated) == "Memory.Address" and type_shape.is_void(freed)
}

func is_allocator_member(candidate: Analysis.ClassInfo): Boolean {
    crash allocator_union
    return allocator_union.has_member(candidate.c_name)
}

func make_allocator_union() {
    var no_member_types = List<Syntax.Types.Type>()
    var information = Analysis.UnionInfo("Spite_Allocator", "allocator", "", "", no_member_types)
    var index = 0
    while index < classes.count() {
        var candidate = classes[index]
        if is_allocator_class(candidate) {
            information.members.append(candidate)
        }
        index = index + 1
    }
    unions.append(information)
    allocator_union = information
    var name = information.c_name
    builder.add_typedef("typedef void* {name};")
    builder.add_prototype("{name} {name}___retain({name} self);")
    builder.add_prototype("void {name}___release({name} self);")
    builder.add_support(
        "{name} {name}___retain({name} self) \{\nif (self != 0) SPITE_COUNT_UP(((SpiteHeader*)self)->ref_count);\nreturn self;\n}",
    )
    emit_union_release(information)
}

func allocator_read(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    crash member.object
    var own_memory = shape.as_identifier(member.object)
    if own_memory {
        assert own_memory.name == "memory" and not scope.lookup_type("memory") and not class_information.find_field("memory")
        if class_information.is_singleton or class_information.is_value_class {
            report(
                "'memory.allocator' is the allocator of the object a function runs on, and '{class_information.simple_name}' is not made as an object of its own: only an object has an allocator",
            )
            return missing_allocator()
        }
        return allocator_of(class_information, "self")
    }
    var memory = shape.as_member(member.object)
    assert memory
    assert memory.name == "memory"
    crash memory.object
    var saved_counter = temporary_counter
    var probe = generate_expression(memory.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var described_type = probe.type
    var described_ref = type_shape.as_class_ref(described_type)
    if described_ref {
        var described = find_class_by_c_name(described_ref.c_name)
        if described {
            assert not described.find_field("memory") and not described.find_function("get_memory")
        }
    }
    var placed_class = owning_class_of(described_type)
    if not placed_class {
        report(
            "only an object has an allocator of its own, and this is a value of type {type_display_name(described_type)}, which the compiler places itself",
        )
        return missing_allocator()
    }
    if not is_name_path(memory.object) {
        report("only a named object answers its allocator: give this object a name with 'var' first")
        return missing_allocator()
    }
    var object_result = generate_expression(memory.object, scope, class_information)
    return allocator_of(placed_class, object_result.code)
}

func missing_allocator(): ExpressionResult {
    crash allocator_union
    var union_type = union_type_of(allocator_union)
    return ExpressionResult("((Spite_Allocator)0)", union_type)
}

func owning_class_of(described_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var placed_c_name = ""
    var reference = type_shape.as_class_ref(described_type)
    if reference {
        placed_c_name = reference.c_name
    }
    var listed = type_shape.as_list(described_type)
    if listed {
        var listed_element = listed.element
        placed_c_name = ensure_list(listed_element)
    }
    var dictionary = type_shape.as_dictionary(described_type)
    if dictionary {
        placed_c_name = ensure_dictionary(dictionary)
    }
    var placed_class = find_class_by_c_name(placed_c_name)
    assert placed_class
    assert not placed_class.is_singleton and not placed_class.is_value_class
    return placed_class
}

func allocator_of(placed_class: Analysis.ClassInfo, object_code: String): ExpressionResult {
    var heap_class = find_class_by_qualified("Memory.Heap")
    crash heap_class
    singleton_call(heap_class)
    if not allocator_read_names.contains(placed_class.c_name) {
        allocator_read_names.append(placed_class.c_name)
    }
    crash allocator_union
    var union_type = union_type_of(allocator_union)
    return ExpressionResult(
        "SPITE_ALLOCATOR_{placed_class.c_name}({object_code}, spite_singleton_Memory_Heap)",
        union_type,
    )
}

func finish_allocator_reads() {
    var index = 0
    while index < allocator_read_names.count() {
        var c_name = allocator_read_names[index]
        var heap = "((Spite_Allocator)heap())"
        if allocated_class_names.contains(c_name) {
            builder.add_prototype(
                "#define SPITE_ALLOCATOR_{c_name}(object, heap) ((object)->spite_allocator != 0 ? (Spite_Allocator)(object)->spite_allocator : {heap})",
            )
        } else {
            builder.add_prototype("#define SPITE_ALLOCATOR_{c_name}(object, heap) ((void)(object), {heap})")
        }
        index = index + 1
    }
}

func mark_names_used_in(expression: Syntax.Expressions.Expression, scope: Scope) {
    var mentioned = List<String>()
    collect_each_mentioned_name([expression], mentioned)
    mark_each_used(mentioned, scope)
}

func allocatable_class(declared_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var placed_c_name = ""
    var reference = type_shape.as_class_ref(declared_type)
    if reference {
        placed_c_name = reference.c_name
    }
    var listed = type_shape.as_list(declared_type)
    if listed {
        var listed_element = listed.element
        placed_c_name = ensure_list(listed_element)
    }
    var dictionary = type_shape.as_dictionary(declared_type)
    if dictionary {
        placed_c_name = ensure_dictionary(dictionary)
    }
    var placed_class = find_class_by_c_name(placed_c_name)
    assert placed_class
    assert not placed_class.is_singleton and not placed_class.is_value_class
    assert placed_class.c_name != "Spite_Function" and placed_class.c_name != "Spite_Attribute"
    return placed_class
}

func allocated_code(placed_class: Analysis.ClassInfo, value_code: String, head: String): String {
    var code_length = value_code.length()
    var made = "{placed_class.c_name}___make("
    if value_code.starts_with(made) {
        var made_length = made.length()
        var made_rest = value_code.slice(made_length, code_length)
        ensure_made_in(placed_class)
        if made_rest == ")" {
            return "{placed_class.c_name}___make_in({head})"
        }
        return "{placed_class.c_name}___make_in({head}, {made_rest}"
    }
    var copied = "{placed_class.c_name}_copy("
    if not value_code.starts_with(copied) or placed_class.find_function("copy") {
        return ""
    }
    var copied_length = copied.length()
    var copied_rest = value_code.slice(copied_length, code_length)
    if not copied_in_names.contains(placed_class.c_name) {
        copied_in_names.append(placed_class.c_name)
        builder.add_prototype(
            "{placed_class.c_name}* {placed_class.c_name}_copy_in(void* spite_allocator, void (*spite_give_back)(void*, void*), int64_t spite_address, {placed_class.c_name}* self);",
        )
    }
    return "{placed_class.c_name}_copy_in({head}, {copied_rest}"
}

func ensure_given_back(allocator_class: Analysis.ClassInfo, freeing: Analysis.FunctionInfo): String {
    var name = "spite_give_back_{allocator_class.c_name}"
    if not given_back_names.contains(name) {
        given_back_names.append(name)
        builder.add_prototype("void {name}(void* allocator, void* object);")
        builder.add_support(
            "void {name}(void* allocator, void* object) \{\n{freeing.c_name}(({allocator_class.c_name}*)allocator, (int64_t)(intptr_t)object);\n{allocator_class.c_name}___release(({allocator_class.c_name}*)allocator);\n}",
        )
    }
    return name
}

func ensure_made_in(information: Analysis.ClassInfo) {
    assert not made_in_names.contains(information.c_name)
    made_in_names.append(information.c_name)
    var parameters = "void* spite_allocator, void (*spite_give_back)(void*, void*), int64_t spite_address"
    var constructor_parameters = constructor_parameter_list(information)
    if constructor_parameters != "void" {
        parameters = "{parameters}, {constructor_parameters}"
    }
    var signature = "{information.c_name}* {information.c_name}___make_in({parameters})"
    builder.add_prototype("{signature};")
    var lines = List<String>()
    lines.append("{signature} \{")
    lines.append("{information.c_name}* self = ({information.c_name}*)(intptr_t)spite_address;")
    lines.append("self->header.ref_count = 1;")
    lines.append("self->header.class_id = {information.class_id};")
    append_live_start(lines, information, "self")
    lines.append("{information.c_name}___init(self);")
    append_live_add(lines, information, "self")
    lines.append("self->spite_allocator = spite_allocator;")
    lines.append("self->spite_give_back = spite_give_back;")
    lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    lines.append("spite_track_{information.c_name}(self);")
    lines.append("#endif")
    if information.constructor {
        var arguments = c_parameter_names(information.constructor.parameters)
        arguments.prepend("self")
        lines.append("{information.constructor.c_name}({arguments.join(", ")});")
    }
    lines.append("return self;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func finish_allocated_classes() {
    allocated_classes.each(finish_allocated_class)
}

func finish_allocated_class(information: Analysis.ClassInfo) {
    crash information.struct_position >= 0 and information.allocate_position >= 0 and information.release_position >= 0
    var laid_out = builder.typedef_at(information.struct_position)
    var with_allocator = laid_out.replace(
        "SpiteHeader header;",
        "SpiteHeader header;\nvoid* spite_allocator;\nvoid (*spite_give_back)(void*, void*);",
    )
    builder.replace_typedef(information.struct_position, with_allocator)
    var allocated = builder.support_at(information.allocate_position)
    var allocated_on_heap = allocated.replace(
        "{information.c_name}___init(self);",
        "{information.c_name}___init(self);\nself->spite_allocator = 0;",
    )
    builder.replace_support(information.allocate_position, allocated_on_heap)
    if information.constructed_allocate_position >= 0 {
        var constructed = builder.support_at(information.constructed_allocate_position)
        var constructed_on_heap = constructed.replace(
            "{information.c_name}___init_constructed(self);",
            "{information.c_name}___init_constructed(self);\nself->spite_allocator = 0;",
        )
        builder.replace_support(information.constructed_allocate_position, constructed_on_heap)
    }
    if framed_positions.has(information.c_name) {
        var framed_position = framed_positions[information.c_name]
        crash framed_position
        var framed = builder.support_at(framed_position)
        var framed_on_heap = framed.replace("return self;", "self->spite_allocator = 0;\nreturn self;")
        builder.replace_support(framed_position, framed_on_heap)
    }
    var released = builder.support_at(information.release_position)
    var given_back = released.replace(
        "SPITE_FREE(self);",
        "if (self->spite_allocator != 0) \{\nself->spite_give_back(self->spite_allocator, self);\nreturn;\n}\nSPITE_FREE(self);",
    )
    builder.replace_support(information.release_position, given_back)
    assert information.copy_position >= 0
    var class_id_line = "spite_copy->header.class_id = {information.class_id};"
    var copied = builder.support_at(information.copy_position)
    var copied_on_heap = copied.replace(class_id_line, "{class_id_line}\nspite_copy->spite_allocator = 0;")
    builder.replace_support(information.copy_position, copied_on_heap)
    assert copied_in_names.contains(information.c_name)
    var c_name = information.c_name
    var copied_in = copied.replace(
        "{c_name}* {c_name}_copy({c_name}* self) \{",
        "{c_name}* {c_name}_copy_in(void* spite_allocator, void (*spite_give_back)(void*, void*), int64_t spite_address, {c_name}* self) \{",
    )
    copied_in = copied_in.replace("({c_name}*)SPITE_MALLOC(sizeof({c_name}))", "({c_name}*)(intptr_t)spite_address")
    copied_in = copied_in.replace(
        "#ifdef SPITE_DEBUG_MEMORY\nspite_debug_register_object(spite_copy, {information.class_id});\n#endif\n",
        "",
    )
    copied_in = copied_in.replace(
        class_id_line,
        "{class_id_line}\nspite_copy->spite_allocator = spite_allocator;\nspite_copy->spite_give_back = spite_give_back;",
    )
    builder.add_support(copied_in)
}

func placed_in_frame(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash declaration.value
    var allocation = shape.as_call(declaration.value)
    crash allocation
    crash allocation.callee
    var allocating = shape.as_member(allocation.callee)
    crash allocating
    crash allocating.object
    var receiver = shape.as_identifier(allocating.object)
    crash receiver
    var receiver_result = generate_expression(allocating.object, scope, class_information)
    var receiver_type = receiver_result.type
    var heap_type = type_shape.as_class_ref(receiver_type)
    if not heap_type {
        return false
    }
    if heap_type.c_name != "Memory_Heap" {
        return false
    }
    var placed_type = address_type()
    var bytes_type = long_type()
    var bytes_code = coerce_for_store(allocation.arguments[0], bytes_type, scope, class_information)
    var frame_bytes = 256
    var literal_bytes = shape.as_integer_literal(allocation.arguments[0])
    if literal_bytes {
        if literal_bytes.value >= 1 and literal_bytes.value <= frame_bytes {
            frame_bytes = (literal_bytes.value + 7) / 8 * 8
        }
    }
    var frame = next_temporary()
    var bytes = next_temporary()
    builder.add_user("int64_t {frame}[{frame_bytes / 8}];")
    builder.add_user("int64_t {bytes} = {bytes_code};")
    builder.add_user(
        "int64_t {c_value_name(declaration.name)} = {bytes} <= {frame_bytes} ? (int64_t)(intptr_t){frame} : Memory_Heap_allocate({receiver_result.code}, {bytes});",
    )
    scope.declare(declaration.name, placed_type)
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    placed_names.append(declaration.name)
    placed_frames.append(frame)
    placed_receiver_names.append(receiver.name)
    placed_receiver_codes.append(receiver_result.code)
    return true
}

func freed_from_frame(expression_statement: Syntax.Statements.ExpressionStatement, scope: Scope): Boolean {
    crash expression_statement.value
    var index = placed_names.count() - 1
    while index >= 0 {
        crash placed_receiver_names[index]
        crash placed_frames[index]
        crash placed_receiver_codes[index]
        var receiver_name = placed_receiver_names[index]
        var freed = placement.memory_argument(expression_statement.value, receiver_name, "free")
        if freed == placed_names[index] {
            var frame = placed_frames[index]
            var receiver_code = placed_receiver_codes[index]
            scope.mark_used(freed)
            var freed_code = c_value_name(freed)
            builder.add_user(
                "if ({freed_code} != (int64_t)(intptr_t){frame}) Memory_Heap_free({receiver_code}, {freed_code});",
            )
            return true
        }
        index = index - 1
    }
    return false
}

func rebind(name: String, value_code: String, declared_type: Analysis.SpiteType, scope: Scope): String {
    var temporary = next_temporary()
    builder.add_user("{c_type_name(declared_type)} {temporary} = {value_code};")
    var index = 0
    while index < scope.owned.count() {
        if scope.owned[index].name == name {
            var old_type = scope.owned[index].type
            var old_code = c_value_name(name)
            builder.add_user("{release_call(old_type, old_code)};")
        }
        index = index + 1
    }
    scope.forget_owned(name)
    builder.add_user("\{")
    scope.rebindings = scope.rebindings + 1
    return temporary
}

func close_rebindings(scope: Scope) {
    var index = 0
    while index < scope.rebindings {
        builder.add_user("}")
        index = index + 1
    }
}

func report_copy_for_narrowing(
    name: String,
    initializer: Syntax.Expressions.Expression,
    declared_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var source = operand_text(initializer)
    assert not source.is_empty() and type_shape.as_nullable(declared_type)
    assert not source.contains("[")
    assert body_narrowed_names.contains(name) and not body_assigned_paths.contains(name)
    var index = 0
    while index < body_assigned_paths.count() {
        var assigned = body_assigned_paths[index]
        assert assigned != source and not source.starts_with("{assigned}.") and not source.starts_with("{assigned}[") and not source.contains("[{assigned}]")
        index = index + 1
    }
    var saved_counter = temporary_counter
    var copied = generate_expression(initializer, scope, class_information)
    rewind_temporaries(saved_counter)
    var copied_type = copied.type
    assert not joinable_handle(copied_type)
    var declared_maybe = type_shape.as_nullable(declared_type)
    crash declared_maybe
    var declared_inner = declared_maybe.inner
    assert type_shape.as_nullable(copied_type) or types_equal(copied_type, declared_inner)
    report(
        "'{name}' only copies '{source}' so it can be narrowed: narrow '{source}' itself ('assert {source}') and use it directly",
    )
}

func collect_body_facts(statements: List<Syntax.Statements.Statement>) {
    statements.each(collect_statement_facts)
}

func collect_statement_facts(statement: Syntax.Statements.Statement) {
    var checked = shape.as_assert_statement(statement)
    if checked {
        note_narrowed(checked.value)
    }
    var assignment = shape.as_assignment_statement(statement)
    if assignment {
        if assignment.target {
            var assigned = operand_text(assignment.target)
            if not assigned.is_empty() {
                body_assigned_paths.append(assigned)
            }
        }
    }
    var branch = shape.as_if_statement(statement)
    if branch {
        note_narrowed(branch.condition)
        collect_body_facts(branch.then_branch)
        collect_body_facts(branch.else_branch)
    }
    var loop = shape.as_while_statement(statement)
    if loop {
        note_narrowed(loop.condition)
        collect_body_facts(loop.body)
    }
    var choice = shape.as_switch_statement(statement)
    assert choice
    note_narrowed(choice.subject)
    var case_index = 0
    while case_index < choice.cases.count() {
        collect_body_facts(choice.cases[case_index].body)
        case_index = case_index + 1
    }
}

func note_narrowed(condition: Syntax.Expressions.Expression?) {
    assert condition
    var negated = shape.as_unary(condition)
    if negated {
        assert negated.operator == 'logical_not'
        note_narrowed(negated.operand)
        return
    }
    var joined = shape.as_binary(condition)
    if joined {
        assert joined.operator == 'logical_and'
        note_narrowed(joined.left)
        note_narrowed(joined.right)
        return
    }
    var identifier = shape.as_identifier(condition)
    assert identifier
    body_narrowed_names.append(identifier.name)
}

func emit_owning_assignment(
    target_code: String,
    target_type: Analysis.SpiteType,
    value_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var value_code = coerce_for_store(value_ast, target_type, scope, class_information)
    if type_needs_drop(target_type) and drop_may_wait(target_type) {
        var stored = next_temporary()
        var replaced = next_temporary()
        builder.add_user("{c_type_name(target_type)} {stored} = {value_code};")
        builder.add_user("{c_type_name(target_type)} {replaced} = {target_code};")
        builder.add_user("{target_code} = {stored};")
        wait_for_released(target_type, replaced)
        builder.add_user("{release_call(target_type, replaced)};")
        return
    }
    if type_needs_drop(target_type) {
        var temporary = next_temporary()
        builder.add_user("{c_type_name(target_type)} {temporary} = {value_code};")
        builder.add_user("{release_call(target_type, target_code)};")
        builder.add_user("{target_code} = {temporary};")
    } else {
        builder.add_user("{target_code} = {value_code};")
    }
}

func forget_narrowing_under(
    target_ast: Syntax.Expressions.Expression,
    value_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var path = operand_text(target_ast)
    assert not path.is_empty()
    var value_may_be_null = not value_is_never_null(value_ast, scope, class_information)
    if value_may_be_null and shape.as_identifier(target_ast) {
        if scope.lookup_override(path) {
            if scope.forget_override(path, false) {
                report(
                    "assigning a value that may be null to '{path}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
                )
            }
        }
    }
    var crossed_loop_readers = List<String>()
    if scope.forget_path(path, value_may_be_null, crossed_loop_readers) {
        report(
            "assigning to '{path}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
        )
    }
}

func value_is_never_null(
    value_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if shape.as_generic_call(value_ast) or shape.as_string_literal(value_ast) or shape.as_integer_literal(value_ast) {
        return true
    }
    if shape.as_binary(value_ast) or shape.as_unary(value_ast) {
        return true
    }
    var call = shape.as_call(value_ast)
    if call {
        if call.callee {
            if try_resolve_static_path(call.callee, class_information.qualified_dotted) {
                return true
            }
        }
        return false
    }
    var value_type = lookup_static_type(value_ast, scope, class_information)
    if value_type {
        if not type_shape.as_nullable(value_type) {
            return true
        }
    }
    return false
}

func generate_assignment(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert assignment.target
    assert assignment.value
    var ranged = ranged_target(assignment, scope)
    var reached: NumberRange? = null
    if not ranged.is_empty() {
        prepare_sum(ranged, assignment.value, scope, class_information)
        reached = assigned_range(ranged, assignment.value, scope, class_information)
    }
    store_assignment(assignment, scope, class_information)
    if not ranged.is_empty() {
        scope.assign_range(ranged, reached)
    }
}

func store_assignment(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert assignment.target
    assert assignment.value
    if assigns_number_constant(assignment.target, class_information) {
        mark_names_used_in(assignment.value, scope)
        return
    }
    var chosen_object = allocator_object_name(assignment.target)
    if not chosen_object.is_empty() {
        if not chosen_allocator_lines.contains("{current_path}:{assignment.line}") {
            report(
                "'{chosen_object}' was already used, so its allocator can no longer change: an object's allocator is set on the line right after it is made. To move it, copy it and set the copy's: 'var moved = {chosen_object}.copy()' and then 'moved.memory.allocator = ...'",
            )
            mark_names_used_in(assignment.value, scope)
        }
        return
    }
    var reflected_target = reflected_assignment_target(assignment.target, scope, class_information)
    if reflected_target {
        var reflected_assignment = Syntax.Statements.AssignmentStatement(reflected_target, assignment.value)
        reflected_assignment.line = assignment.line
        generate_assignment(reflected_assignment, scope, class_information)
        return
    }
    var index_target = shape.as_index(assignment.target)
    if index_target {
        if is_bound_member_index(index_target) {
            var bound_member = bound_member_expression(index_target)
            var member_assignment = Syntax.Statements.AssignmentStatement(bound_member, assignment.value)
            member_assignment.line = assignment.line
            generate_assignment(member_assignment, scope, class_information)
            return
        }
    }
    if elides_slot_write_back(assignment, scope, class_information) {
        mark_names_used_in(assignment.target, scope)
        mark_names_used_in(assignment.value, scope)
    } else if not stores_framed_object(assignment, scope, class_information) {
        generate_store(assignment, scope, class_information)
    }
    forget_narrowing_under(assignment.target, assignment.value, scope, class_information)
}

func assigns_number_constant(target: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): Boolean {
    var member = shape.as_member(target)
    if not member {
        return false
    }
    if not maths.is_constant(member.name) {
        return false
    }
    crash member.object
    var constant_class = try_resolve_static_path(member.object, class_information.qualified_dotted)
    if not constant_class {
        return false
    }
    if not number_constant_read(constant_class, member.name) {
        return false
    }
    var named = "{constant_class.qualified_dotted}.{member.name}"
    report("'{named}' is a constant, and a constant is get-only: nothing can assign it")
    return true
}

func narrowed_value_holder(override: String, declared: Analysis.SpiteType): String {
    var nullable = type_shape.as_nullable(declared)
    if nullable {
        var inner = nullable.inner
        if not type_is_reference(inner) and override.starts_with("(") and override.ends_with(").value") {
            var override_length = override.length()
            return override.slice(1, override_length - 7)
        }
    }
    return override
}

func appends_to_itself(
    value: Syntax.Expressions.Expression,
    target: String,
    pieces: List<Syntax.Expressions.Expression>,
): Boolean {
    if not text_base_is(value, target, pieces) or pieces.is_empty() {
        return false
    }
    var mentioned = List<String>()
    collect_each_mentioned_name(pieces, mentioned)
    return not mentioned.contains(target)
}

func text_base_is(
    value: Syntax.Expressions.Expression,
    target: String,
    pieces: List<Syntax.Expressions.Expression>,
): Boolean {
    if is_identifier_named(value, target) {
        return true
    }
    var binary = shape.as_binary(value)
    if binary {
        if binary.operator == 'add' {
            crash binary.left
            crash binary.right
            var written = shape.as_string_literal(binary.left)
            if written {
                return written.value.is_empty() and is_identifier_named(binary.right, target)
            }
            if text_base_is(binary.left, target, pieces) {
                pieces.append(binary.right)
                return true
            }
        }
    }
    return false
}

func is_identifier_named(value: Syntax.Expressions.Expression, name: String): Boolean {
    var identifier = shape.as_identifier(value)
    if identifier {
        return identifier.name == name
    }
    return false
}

func emit_append_in_place(
    target: String,
    pieces: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var piece_result = generate_expression(piece, scope, class_information)
        var piece_type = piece_result.type
        var string_spite_type = string_type()
        var piece_code = cast(piece_result.code, piece_type, string_spite_type)
        var temporary = next_temporary()
        var digits = digits_of(piece_code)
        if digits.is_empty() {
            builder.add_user("SpiteString {temporary} = {piece_code};")
            builder.add_user("{target} = SpiteString_append({target}, {temporary});")
            if owns(piece_result, piece) or not type_shape.as_string(piece_type) {
                builder.add_user("SpiteString___release({temporary});")
            }
        } else {
            builder.add_user(
                "\{ {digits_view(temporary, digits)} {target} = SpiteString_append({target}, {temporary}); }",
            )
        }
        index = index + 1
    }
}

func generate_store(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert assignment.target
    assert assignment.value
    var identifier = shape.as_identifier(assignment.target)
    if identifier {
        var scope_type = scope.written_type(identifier.name)
        if scope_type {
            var override = scope.lookup_override(identifier.name)
            var target_code = c_value_name(identifier.name)
            var storage_type = scope_type
            if override {
                target_code = override
                var declared = scope.unnarrowed_type(identifier.name)
                if declared {
                    storage_type = declared
                    target_code = narrowed_value_holder(override, declared)
                } else {
                    var narrowed_field = class_information.find_field(identifier.name)
                    if narrowed_field {
                        storage_type = narrowed_field.type
                    }
                }
            }
            if not override and type_shape.as_string(scope_type) {
                var pieces = List<Syntax.Expressions.Expression>()
                if appends_to_itself(assignment.value, identifier.name, pieces) {
                    scope.mark_used(identifier.name)
                    emit_append_in_place(target_code, pieces, scope, class_information)
                    return
                }
            }
            emit_owning_assignment(target_code, storage_type, assignment.value, scope, class_information)
            return
        }
        var field = class_information.find_field(identifier.name)
        if not field {
            report(
                "'{identifier.name}' is not a variable or an attribute here: declare it with 'var {identifier.name} = ...' first",
            )
            return
        }
        var field_type = field.type
        if atomic_owner == class_information.c_name and atomic_fields.contains(identifier.name) {
            emit_atomic_store(identifier.name, field_type, assignment.value, scope, class_information)
            return
        }
        var assigned_field = field_place("self", class_information, identifier.name)
        emit_owning_assignment(assigned_field, field_type, assignment.value, scope, class_information)
        return
    }
    var index_target = shape.as_index(assignment.target)
    if index_target {
        if is_bound_attributes_index(index_target) {
            crash bound_field_type
            var assigned_bound = field_place("self", class_information, bound_field_name)
            emit_owning_assignment(assigned_bound, bound_field_type, assignment.value, scope, class_information)
            return
        }
        assert index_target.object
        assert index_target.index
        var counted_write = counted_item(index_target.object, index_target.index, scope, class_information)
        if not counted_write.is_empty() {
            var counted_type = counted_item_type(index_target.object, scope)
            var stored = coerce_for_store(assignment.value, counted_type, scope, class_information)
            builder.add_user("{counted_write} = {stored};")
            return
        }
        var indexed_result = generate_expression(index_target.object, scope, class_information)
        var indexed_result_type = indexed_result.type
        var assigned_class_ref = type_shape.as_class_ref(indexed_result_type)
        if assigned_class_ref {
            var assigned_class = find_class_by_c_name(assigned_class_ref.c_name)
            if assigned_class {
                var set_at = find_or_instantiate_function(assigned_class, "set_at")
                if set_at {
                    var set_at_arguments = List<Syntax.Expressions.Expression>()
                    set_at_arguments.append(index_target.index)
                    set_at_arguments.append(assignment.value)
                    var parameter_types = parameter_types_of(set_at.parameters)
                    var set_at_return_type = set_at.return_type
                    var set_at_call = generate_generic_call(
                        set_at.c_name,
                        indexed_result,
                        index_target.object,
                        set_at_arguments,
                        parameter_types,
                        set_at_return_type,
                        scope,
                        class_information,
                    )
                    discard_call_result(set_at_call)
                    return
                }
                report(
                    "assigning through an index on a '{assigned_class.simple_name}' needs it to define 'set_at(index, value)'",
                )
                return
            }
        }
        var indexed_dictionary = type_shape.as_dictionary(indexed_result_type)
        if indexed_dictionary {
            var dictionary_arguments = List<Syntax.Expressions.Expression>()
            dictionary_arguments.append(index_target.index)
            dictionary_arguments.append(assignment.value)
            var key_parameter = dictionary_key_parameter(indexed_dictionary)
            var element = indexed_dictionary.element
            var pair_types = two_types(key_parameter, element)
            var void_spite_type = void_type()
            var dictionary_set_call = generate_generic_call(
                "{ensure_dictionary(indexed_dictionary)}_set_at",
                indexed_result,
                index_target.object,
                dictionary_arguments,
                pair_types,
                void_spite_type,
                scope,
                class_information,
            )
            builder.add_user("{dictionary_set_call.code};")
            return
        }
        var indexed_list = type_shape.as_list(indexed_result_type)
        if indexed_list {
            var set_arguments = List<Syntax.Expressions.Expression>()
            set_arguments.append(index_target.index)
            set_arguments.append(assignment.value)
            var indexed_list_element = indexed_list.element
            var list_function_name = list_function(indexed_list_element, "set_at")
            var integer_spite_type = integer_type()
            var element = indexed_list.element
            var pair_types = two_types(integer_spite_type, element)
            var void_spite_type = void_type()
            var set_call = generate_generic_call(
                list_function_name,
                indexed_result,
                index_target.object,
                set_arguments,
                pair_types,
                void_spite_type,
                scope,
                class_information,
            )
            builder.add_user("{set_call.code};")
            return
        }
    }
    var member = shape.as_member(assignment.target)
    if member {
        assert member.object
        if is_row_name(member.object, scope) {
            var row_name = operand_text(member.object)
            report(
                "'{row_name}' holds items borrowed from '{scope.row_source(row_name)}' for this call, so '{row_name}.{member.name}' is not assigned: write the item's attributes, such as '{row_name}.{member.name}.<attribute> = ...'",
            )
            return
        }
        var object_result = generate_expression(member.object, scope, class_information)
        var object_result_type = object_result.type
        var shaped_union = type_shape.as_union(object_result_type)
        if shaped_union {
            var shaped_information = find_union_by_c_name(shaped_union.c_name)
            if shaped_information {
                var written_type = shape_field_type(shaped_information, member.name)
                if shaped_information.is_shape {
                    if written_type {
                        var writer = ensure_shape_writer(shaped_information, member.name, written_type)
                        var shaped_temporary = next_temporary()
                        builder.add_user("{shaped_union.c_name} {shaped_temporary} = {object_result.code};")
                        builder.add_user(
                            "{writer}({shaped_temporary}, {coerce_for_store(assignment.value, written_type, scope, class_information)});",
                        )
                        if owns(object_result, member.object) {
                            builder.add_user("{shaped_union.c_name}___release({shaped_temporary});")
                        }
                        return
                    }
                }
            }
            report("cannot assign to '{member.name}' through this value")
            return
        }
        var written_field = library_list_field(object_result_type, member.name, class_information)
        if written_field {
            var written_field_type = written_field.type
            var stored = coerce_for_store(assignment.value, written_field_type, scope, class_information)
            builder.add_user("({object_result.code})->{c_value_name(member.name)} = {stored};")
            return
        }
        var object_class_ref = type_shape.as_class_ref(object_result_type)
        if not object_class_ref {
            if type_shape.as_nullable(object_result_type) {
                var shown_store_type = type_with_article(object_result_type)
                report(
                    "{null_opening(object_result.code, shown_store_type)}, so '{member.name}' cannot be assigned through it yet: {null_advice(object_result.code)}",
                )
            } else if not has_error {
                report("cannot assign to '{member.name}' through {type_with_article(object_result_type)}")
            }
            return
        }
        var target_class = find_class_by_c_name(object_class_ref.c_name)
        assert target_class
        if not member.walked {
            report_private_member(target_class, member.name, class_information)
        }
        var setter = find_setter(target_class, member.name, class_information)
        if setter {
            var setter_arguments = List<Syntax.Expressions.Expression>()
            setter_arguments.append(assignment.value)
            var parameter_types = parameter_types_of(setter.parameters)
            var setter_return_type = setter.return_type
            var setter_call = generate_generic_call(
                setter.c_name,
                object_result,
                member.object,
                setter_arguments,
                parameter_types,
                setter_return_type,
                scope,
                class_information,
            )
            discard_call_result(setter_call)
            return
        }
        var field = target_class.find_field(member.name)
        if not field {
            if find_getter(target_class, member.name, class_information) {
                report(
                    "'{member.name}' is read-only: '{target_class.simple_name}' answers it through get_{member.name}() and has no set_{member.name}(value)",
                )
            } else {
                report("'{target_class.simple_name}' has no attribute '{member.name}' to assign to")
            }
            return
        }
        var object_temporary = next_temporary()
        var field_type = field.type
        var watch = ReleaseWatch("")
        var plain_write = not type_needs_drop(field_type) and not guards_outside_write(target_class)
        if object_result.peek_union and plain_write and watch_expression(watch, assignment.value, scope, class_information) {
            var peeked = peeked_code(object_result)
            var scratch_start = ""
            if is_hot_class(target_class) {
                scratch_start = " = \{ 0 }"
            }
            builder.add_user("{target_class.c_name} {object_temporary}_scratch{scratch_start};")
            builder.add_user("{c_type_name(object_result_type)} {object_temporary} = {peeked};")
            builder.add_user("if ({object_temporary} == 0) {object_temporary} = &{object_temporary}_scratch;")
            var peeked_target = field_place("({object_temporary})", target_class, member.name)
            emit_owning_assignment(peeked_target, field_type, assignment.value, scope, class_information)
            return
        }
        var target_code = field_place("({object_result.code})", target_class, member.name)
        if not writes_through_local(member.object, object_result, scope) {
            builder.add_user("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
            target_code = field_place("({object_temporary})", target_class, member.name)
        }
        var lone_written = lone_atomic_fields(target_class)
        if guards_outside_write(target_class) and lone_written.contains(member.name) {
            emit_lone_atomic_write(target_class, target_code, field_type, assignment.value, scope, class_information)
        } else if guards_outside_write(target_class) {
            emit_guarded_outside_write(
                target_class,
                target_code,
                field_type,
                assignment.value,
                scope,
                class_information,
            )
        } else {
            emit_owning_assignment(target_code, field_type, assignment.value, scope, class_information)
        }
        if owns(object_result, member.object) {
            builder.add_user("{release_call(object_result_type, object_temporary)};")
        }
        return
    }
    report("unsupported assignment target")
}

func writes_through_local(object: Syntax.Expressions.Expression, result: ExpressionResult, scope: Scope): Boolean {
    var identifier = shape.as_identifier(object)
    if not identifier or not scope.written_type(identifier.name) or owns(result, object) {
        return false
    }
    return is_c_identifier(result.code)
}

func is_c_identifier(code: String): Boolean {
    if code.is_empty() {
        return false
    }
    var index = 0
    while index < code.length() {
        var character = code.code_at(index)
        var letter = character >= 97 and character <= 122 or character >= 65 and character <= 90 or character == 95
        if not letter and (index <= 0 or character < 48 or character > 57) {
            return false
        }
        index = index + 1
    }
    return true
}

func study_lent_parameters_of(information: Analysis.ClassInfo) {
    assert lent_parameters_class != information.c_name
    lent_parameters_class = information.c_name
    var names = List<String>()
    var parameter_lists = List<List<String>>()
    var bodies = List<List<Syntax.Statements.Statement>>()
    var index = 0
    var swappable = is_hot_class(information)
    while index < information.declared_functions.count() {
        var function = information.declared_functions[index]
        if function.has_body and not function.is_constructor and not swappable {
            names.append(function.name)
            var address_names = address_parameter_names(function)
            parameter_lists.append(address_names)
            bodies.append(function.body)
        }
        index = index + 1
    }
    placement.study_lent_parameters(names, parameter_lists, bodies)
}

func foreign_library_attributes(information: Analysis.ClassInfo): List<String> {
    var names = List<String>()
    assert current_path.starts_with("library/")
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var class_ref = type_shape.as_class_ref(field_type)
        if class_ref {
            if class_ref.c_name == "DynamicLibrary" {
                names.append(field.name)
            }
        }
        index = index + 1
    }
    return names
}

func typed_memory_attributes(information: Analysis.ClassInfo): List<String> {
    var names = List<String>()
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.type
        var class_ref = type_shape.as_class_ref(field_type)
        if class_ref {
            if class_ref.c_name.starts_with("TypedMemory__") {
                names.append(field.name)
            }
        }
        index = index + 1
    }
    return names
}

func address_parameter_names(function: Analysis.FunctionInfo): List<String> {
    var names = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.type
        var scalar = type_shape.as_scalar(parameter_type)
        var address = false
        if scalar {
            address = scalar.kind == 'address_kind'
        }
        if address {
            names.append(parameter.name)
        } else {
            names.append("")
        }
        index = index + 1
    }
    return names
}

# ../../../docs/control_flow.md#nothing-after-a-return
func report_after_return(statements: List<Syntax.Statements.Statement>, index: Integer) {
    assert index + 1 < statements.count()
    assert shape.as_return_statement(statements[index])
    var next = statements[index + 1]
    var saved_line = current_line
    current_line = statement_line(next)
    report("this statement comes after a 'return', so it never runs: remove it")
    current_line = saved_line
}

func generate_statement_list(
    statements: List<Syntax.Statements.Statement>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    var candidates = placement.frame_candidates(statements)
    var candidate_index = 0
    while candidate_index < candidates.count() {
        frame_candidates.append("{current_path}:{current_function}:{candidates[candidate_index]}")
        candidate_index = candidate_index + 1
    }
    var index = 0
    listed_ended_in_return = false
    var overlapped_reads = List<String>()
    while index < statements.count() {
        var overlapping = overlap_run(statements, index, scope, class_information)
        var row: RowSite? = null
        if overlapping < 2 {
            row = row_each_site(statements[index], scope, class_information)
            if not row {
                row = band_each_site(statements[index], scope, class_information)
            }
        }
        if row {
            join_overlapped_reads(overlapped_reads, scope)
            index = emit_row_each(
                statements,
                index,
                row,
                overlapped_reads,
                scope,
                class_information,
                function_information,
            )
        } else if overlapping >= 2 {
            join_overlapped_reads(overlapped_reads, scope)
            emit_overlap_group(statements, index, overlapping, scope, class_information, function_information)
            listed_ended_in_return = false
            index = index + overlapping
        } else {
            index = generate_listed_statement(
                statements,
                index,
                overlapped_reads,
                scope,
                class_information,
                function_information,
            )
        }
        if index < 0 {
            return true
        }
    }
    var ended_in_return = listed_ended_in_return
    join_overlapped_reads(overlapped_reads, scope)
    if ended_in_return {
        pending_calls = List<Syntax.Expressions.Expression>()
        pending_call_lines = List<Integer>()
    }
    undo_proofs_after_calls(scope, class_information)
    return ended_in_return
}

func generate_listed_statement(
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    overlapped_reads: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Integer {
    var index = start
    if index > 0 {
        report_template_walk(statements, index, scope, class_information)
    }
    report_value_chain(statements, index, scope, class_information)
    report_returned_local(statements, index, class_information, function_information)
    var statement = statements[index]
    crash statement
    var read_name = overlapped_read_name(statement, overlapped_reads, scope, class_information)
    if read_name.is_empty() {
        join_overlapped_reads(overlapped_reads, scope)
    }
    var overlaps = overlaps_next_read(statements, index, read_name, overlapped_reads, scope, class_information)
    if overlaps {
        statement = overlapped_declaration(statement)
    }
    choose_allocator_after(statements, index)
    borrow_statements = statements
    borrow_index = index
    var ended_in_return = generate_statement(statement, scope, class_information, function_information)
    listed_ended_in_return = ended_in_return
    pending_allocator = null
    if walked_row_filled {
        walked_row_filled = false
        index = index + 1
    }
    if overlaps {
        overlapped_reads.append(read_name)
    }
    var folded_return = ended_in_return and (statements[index] == Syntax.Statements.IfStatement or statements[index] == Syntax.Statements.AssertStatement)
    report_after_return(statements, index)
    index = index + 1
    if folded_return and index < statements.count() {
        undo_proofs_after_calls(scope, class_information)
        mark_rest_used(statements, index, scope)
        return -1
    }
    return index
}

func overlaps_next_read(
    statements: List<Syntax.Statements.Statement>,
    index: Integer,
    read_name: String,
    overlapped_reads: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if read_name.is_empty() or index + 1 >= statements.count() {
        return false
    }
    var pending = overlapped_reads.copy()
    pending.append(read_name)
    var next_index = index + 1
    crash statements[next_index]
    var next_name = overlapped_read_name(statements[next_index], pending, scope, class_information)
    return not next_name.is_empty()
}

func overlapped_read_name(
    statement: Syntax.Statements.Statement,
    pending: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var declaration = shape.as_variable_declaration(statement)
    if not declaration {
        return ""
    }
    if declaration.type_reference or not declaration.value {
        return ""
    }
    if body_assigned_paths.contains(declaration.name) {
        return ""
    }
    var call = shape.as_call(declaration.value)
    if not call {
        return ""
    }
    if not call.arguments.is_empty() or not call.callee {
        return ""
    }
    var callee = shape.as_member(call.callee)
    if not callee {
        return ""
    }
    if callee.name != "read" and callee.name != "read_line" {
        return ""
    }
    crash callee.object
    var receiver_text = operand_text(callee.object)
    if receiver_text.is_empty() or receiver_text.contains("(") {
        return ""
    }
    var mentioned = List<String>()
    collect_statement_names(statement, mentioned)
    var index = 0
    while index < pending.count() {
        if mentioned.contains(pending[index]) {
            return ""
        }
        index = index + 1
    }
    var saved_counter = temporary_counter
    var receiver = generate_expression(callee.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var receiver_type = receiver.type
    var receiver_class = type_shape.as_class_ref(receiver_type)
    if not receiver_class {
        return ""
    }
    var reads_file = receiver_class.c_name == "File" and callee.name == "read"
    var reads_socket = receiver_class.c_name == "Socket" and callee.name == "read_line"
    if not reads_file and not reads_socket {
        return ""
    }
    return declaration.name
}

func overlapped_declaration(statement: Syntax.Statements.Statement): Syntax.Statements.Statement {
    var declaration = shape.as_variable_declaration(statement)
    crash declaration
    crash declaration.value
    var call = shape.as_call(declaration.value)
    crash call
    crash call.callee
    var started_function = call.callee
    var concurrent: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("Concurrent")
    var started_arguments = List<Syntax.Expressions.Expression>()
    started_arguments.append(started_function)
    var started: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(concurrent, started_arguments)
    var overlapped = Syntax.Statements.VariableDeclaration(declaration.name, null, started)
    overlapped.line = declaration.line
    overlapped.source_path = declaration.source_path
    return overlapped
}

func overlap_run(
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Integer {
    if not overlap_allowed or generating_overlap or class_information.is_singleton or current_path.starts_with("library/") {
        return 0
    }
    var count = 0
    var index = start
    while index < statements.count() {
        if not overlap_candidate(statements[index], scope, class_information) {
            return count
        }
        count = count + 1
        index = index + 1
    }
    return count
}

# ../../../docs/optimizations.md#a-loop-over-a-list-of-different-classes-runs-them-at-once
func row_each_site(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): RowSite? {
    assert overlap_allowed and not generating_overlap and not class_information.is_singleton
    assert not current_path.starts_with("library/")
    var expression_statement = shape.as_expression_statement(statement)
    assert expression_statement and expression_statement.value
    var call = shape.as_call(expression_statement.value)
    assert call and call.callee
    var callee = shape.as_member(call.callee)
    assert callee and callee.object
    var receiver_text = operand_text(callee.object)
    assert not receiver_text.is_empty() and not receiver_text.contains("(") and not receiver_text.contains("[")
    var member_name = row_each_member(callee.name, call.arguments, class_information)
    assert not member_name.is_empty()
    var saved_counter = temporary_counter
    var receiver = generate_expression(callee.object, scope, class_information)
    rewind_temporaries(saved_counter)
    assert not owns(receiver, callee.object) and not receiver.code.contains("(\{")
    var receiver_type = receiver.type
    var listed = type_shape.as_list(receiver_type)
    assert listed
    var element = listed.element
    var element_union = type_shape.as_union(element)
    assert element_union
    var information = find_union_by_c_name(element_union.c_name)
    assert information and information.is_shape
    var wanted = find_required_function(information, member_name)
    assert wanted
    var parameter_types = shape_call_parameter_types(information, member_name)
    var returned = shape_call_return_type(information, member_name)
    assert parameter_types.is_empty() and type_shape.is_void(returned)
    var list_class = list_class_of(element)
    var site = RowSite(information.c_name, member_name, list_class.c_name)
    site.path = current_path
    site.line = statement_line(statement)
    return site
}

func row_each_member(
    name: String,
    arguments: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): String {
    if name.starts_with("each_") and arguments.is_empty() {
        var name_length = name.length()
        return name.slice(5, name_length)
    }
    if name != "each" or arguments.count() != 1 {
        return ""
    }
    var passed = shape.as_identifier(arguments[0])
    if not passed or is_library_class(class_information) {
        return ""
    }
    var function = class_information.find_function(passed.name)
    if not function or function.parameters.count() != 1 or function.body.count() != 1 {
        return ""
    }
    var parameter = function.parameters[0]
    var body_statement = shape.as_expression_statement(function.body[0])
    if not body_statement or not body_statement.value {
        return ""
    }
    var call = shape.as_call(body_statement.value)
    if not call or not call.callee or not call.arguments.is_empty() {
        return ""
    }
    var member = shape.as_member(call.callee)
    if not member or not member.object {
        return ""
    }
    var receiver = shape.as_identifier(member.object)
    if not receiver or receiver.name != parameter.name {
        return ""
    }
    return member.name
}

# ../../../docs/optimizations.md#a-loop-whose-passes-write-only-their-own-item-runs-in-bands
func band_each_site(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): RowSite? {
    assert overlap_allowed and not generating_overlap and not class_information.is_singleton
    assert not current_path.starts_with("library/")
    var expression_statement = shape.as_expression_statement(statement)
    assert expression_statement and expression_statement.value
    var call = shape.as_call(expression_statement.value)
    assert call and call.callee
    var callee = shape.as_member(call.callee)
    assert callee and callee.object
    var receiver_text = operand_text(callee.object)
    assert not receiver_text.is_empty() and not receiver_text.contains("(") and not receiver_text.contains("[")
    var member_name = row_each_member(callee.name, call.arguments, class_information)
    assert not member_name.is_empty()
    var saved_counter = temporary_counter
    var receiver = generate_expression(callee.object, scope, class_information)
    rewind_temporaries(saved_counter)
    assert not owns(receiver, callee.object) and not receiver.code.contains("(\{")
    var receiver_type = receiver.type
    assert not type_shape.as_dictionary(receiver_type)
    var element = chained_element_of(receiver_type)
    assert element
    var element_reference = type_shape.as_class_ref(element)
    assert element_reference
    var element_class = find_class_by_c_name(element_reference.c_name)
    assert element_class and not element_class.is_singleton and not element_class.is_value_class
    assert not is_library_class(element_class)
    var base_list = chain_class_of(receiver_type, element)
    var vector_like = base_list.qualified_dotted == "Vector"
    assert vector_like or base_list.qualified_dotted == "List"
    var member = find_or_instantiate_function(element_class, member_name)
    assert member and member.parameters.is_empty() and not member.is_constructor
    var returned = member.return_type
    assert type_shape.is_void(returned)
    var site = RowSite(element_class.c_name, member_name, base_list.c_name)
    site.kind = "band"
    site.member_c_name = member.c_name
    site.inline_items = vector_like
    site.path = current_path
    site.line = statement_line(statement)
    return site
}

func emit_row_each(
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    site: RowSite,
    overlapped_reads: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Integer {
    row_groups = row_groups + 1
    var group = row_groups
    var list_class = find_class_by_c_name(site.list_c_name)
    crash list_class
    var banded = site.kind == "band"
    var run = row_run_function(list_class, site.member_name, banded)
    crash run
    site.run_c_name = run.c_name
    row_sites.append(site)
    var statement = statements[start]
    var expression_statement = shape.as_expression_statement(statement)
    crash expression_statement
    crash expression_statement.value
    var call = shape.as_call(expression_statement.value)
    crash call
    crash call.callee
    var callee = shape.as_member(call.callee)
    crash callee
    crash callee.object
    var saved_counter = temporary_counter
    var receiver = generate_expression(callee.object, scope, class_information)
    rewind_temporaries(saved_counter)
    site.list_code = receiver.code
    var threads_before = builder.threads
    var parallel_before = parallel_used
    var marks_name = "spite_row_{group}_marks"
    builder.add_user("/*spite_row_{group} begin*/")
    if banded {
        builder.add_user("\{")
    } else {
        builder.add_user("\{ int64_t {marks_name}[64];")
    }
    builder.add_user("/*spite_row_{group} fits*/")
    builder.add_user("if (0) \{")
    var inner = Scope(scope)
    var run_arguments = List<Syntax.Expressions.Expression>()
    if not banded {
        var marks_type = address_type()
        inner.declare(marks_name, marks_type)
        inner.mark_used(marks_name)
        inner.set_override(marks_name, "((int64_t)(intptr_t){marks_name})")
        var marks_argument: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(marks_name)
        run_arguments.append(marks_argument)
    }
    generating_overlap = true
    var parameter_types = parameter_types_of(run.parameters)
    var run_return_type = run.return_type
    var run_code = generate_generic_call(
        run.c_name,
        receiver,
        callee.object,
        run_arguments,
        parameter_types,
        run_return_type,
        inner,
        class_information,
    )
    builder.add_user("{run_code.code};")
    emit_scope_drops(inner, false)
    generating_overlap = false
    builder.threads = threads_before
    parallel_used = parallel_before
    builder.add_user("} else \{")
    builder.add_user("/*spite_row_{group} serial*/")
    var next = generate_listed_statement(
        statements,
        start,
        overlapped_reads,
        scope,
        class_information,
        function_information,
    )
    builder.add_user("/*spite_row_{group} serial end*/")
    builder.add_user("}}")
    builder.add_user("/*spite_row_{group} end*/")
    return next
}

func row_run_function(list_class: Analysis.ClassInfo, member_name: String, banded: Boolean): Analysis.FunctionInfo? {
    var run_name = "spite_row_{member_name}"
    if banded {
        run_name = "spite_band_{member_name}"
    }
    var existing = list_class.find_function(run_name)
    if existing {
        return existing
    }
    var piece_name = "{run_name}_piece"
    var piece_lines = List<String>()
    piece_lines.append("func {piece_name}(first: Integer, end: Integer) \{")
    piece_lines.append("    var index = first")
    piece_lines.append("    while index < end \{")
    piece_lines.append("        var item = {chain_item_read(list_class)}")
    piece_lines.append("        item.{member_name}()")
    piece_lines.append("        index = index + 1")
    piece_lines.append("    }")
    piece_lines.append("}")
    piece_lines.append("")
    var piece_source = piece_lines.join("\n")
    var piece = register_fused_function(list_class, piece_source, piece_name)
    crash piece
    var run_source = "func {run_name}(marks: Memory.Address) \{\n    var pool = ThreadPool()\n    pool.run_marked({piece_name}, item_count, marks)\n}\n"
    if banded {
        run_source = "func {run_name}() \{\n    var pool = ThreadPool()\n    pool.run_bands({piece_name}, item_count)\n}\n"
    }
    return register_fused_function(list_class, run_source, run_name)
}

func overlap_candidate(
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var expression_statement = shape.as_expression_statement(statement)
    if not expression_statement or not expression_statement.value {
        return false
    }
    var call = shape.as_call(expression_statement.value)
    if not call or not call.arguments.is_empty() or not call.callee {
        return false
    }
    var own = shape.as_identifier(call.callee)
    if own {
        return overlap_own_candidate(own.name, scope, class_information)
    }
    var callee = shape.as_member(call.callee)
    if not callee or not callee.object {
        return false
    }
    var receiver_text = operand_text(callee.object)
    if receiver_text.is_empty() or receiver_text.contains("(") or receiver_text.contains("[") {
        return false
    }
    var saved_counter = temporary_counter
    var receiver = generate_expression(callee.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var receiver_type = receiver.type
    var receiver_class = type_shape.as_class_ref(receiver_type)
    if not receiver_class {
        return false
    }
    var owner = find_class_by_c_name(receiver_class.c_name)
    if not owner or owner.is_singleton or is_library_class(owner) {
        return false
    }
    var function = owner.find_function(callee.name)
    if not function or not function.parameters.is_empty() or function.is_constructor {
        return false
    }
    var returned = function.return_type
    return type_shape.is_void(returned)
}

func overlap_own_candidate(name: String, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    if scope.lookup_type(name) or is_library_class(class_information) {
        return false
    }
    var function = find_or_instantiate_function(class_information, name)
    if not function or not function.parameters.is_empty() or function.is_constructor {
        return false
    }
    var returned = function.return_type
    return type_shape.is_void(returned)
}

func emit_overlap_group(
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    count: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
) {
    overlap_groups = overlap_groups + 1
    var group = overlap_groups
    builder.add_user("/*spite_overlap_{group} sequential*/")
    var index = start
    while index < start + count {
        crash statements[index]
        generate_statement(statements[index], scope, class_information, function_information)
        builder.add_user("/*spite_overlap_{group} step*/")
        index = index + 1
    }
    builder.add_user("/*spite_overlap_{group} parallel*/")
    builder.add_user("\{")
    var inner = Scope(scope)
    var threads_before = builder.threads
    var parallel_before = parallel_used
    generating_overlap = true
    var handles = List<String>()
    index = start
    while index < start + count {
        crash statements[index]
        var item = index - start
        var handle_name = "spite_overlap_{group}_{item}"
        builder.add_user("/*spite_overlap_{group} job {item}*/")
        var started = overlap_declaration(statements[index], handle_name)
        generate_statement(started, inner, class_information, function_information)
        inner.mark_used(handle_name)
        inner.forget_owned(handle_name)
        handles.append(handle_name)
        builder.add_user("/*spite_overlap_{group} inline {item}*/")
        generate_statement(statements[index], inner, class_information, function_information)
        builder.add_user("/*spite_overlap_{group} item end*/")
        index = index + 1
    }
    join_overlap_handles(group, handles, inner)
    emit_scope_drops(inner, false)
    generating_overlap = false
    builder.threads = threads_before
    parallel_used = parallel_before
    builder.add_user("}")
    builder.add_user("/*spite_overlap_{group} end*/")
}

func overlap_declaration(statement: Syntax.Statements.Statement, handle_name: String): Syntax.Statements.Statement {
    var expression_statement = shape.as_expression_statement(statement)
    crash expression_statement
    crash expression_statement.value
    var call = shape.as_call(expression_statement.value)
    crash call
    crash call.callee
    var parallel: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("Parallel")
    var started_arguments = List<Syntax.Expressions.Expression>()
    started_arguments.append(call.callee)
    var started: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(parallel, started_arguments)
    var declared = Syntax.Statements.VariableDeclaration(handle_name, null, started)
    declared.line = statement_line(statement)
    declared.source_path = current_path
    return declared
}

func join_overlap_handles(group: Integer, handles: List<String>, scope: Scope) {
    var index = 0
    while index < handles.count() {
        var name = handles[index]
        var handle_type = scope.lookup_type(name)
        crash handle_type
        var handle_reference = type_shape.as_class_ref(handle_type)
        crash handle_reference
        var handle = find_class_by_c_name(handle_reference.c_name)
        crash handle
        var joining = find_or_instantiate_function(handle, "_join")
        crash joining
        var handle_code = c_value_name(name)
        builder.add_user("/*spite_overlap_{group} join {index}*/")
        builder.add_user("{joining.c_name}({handle_code});")
        builder.add_user("{handle.c_name}___release({handle_code});")
        builder.add_user("/*spite_overlap_{group} item end*/")
        index = index + 1
    }
}

func finish_overlap_groups() {
    var facts = OverlapFacts()
    facts.read_program(
        builder.typedefs,
        builder.prototypes,
        builder.support_bodies,
        builder.user_bodies,
        builder.main_lines,
    )
    var group = 1
    while group <= overlap_groups {
        settle_overlap_group(facts, group)
        group = group + 1
    }
}

func settle_overlap_group(facts: OverlapFacts, group: Integer) {
    var sequential = "/*spite_overlap_{group} sequential*/"
    var position = 0
    while position < builder.user_bodies.count() {
        var line = builder.user_at(position)
        if line == sequential {
            settle_overlap_at(facts, group, position)
        }
        position = position + 1
    }
}

func settle_overlap_at(facts: OverlapFacts, group: Integer, start: Integer) {
    var parallel_marker = "/*spite_overlap_{group} parallel*/"
    var step_marker = "/*spite_overlap_{group} step*/"
    var end_marker = "/*spite_overlap_{group} end*/"
    var function_lines = enclosing_function_lines(start)
    var steps = List<OverlapFact>()
    var current = List<String>()
    var position = start + 1
    var middle = -1
    while middle < 0 and position < builder.user_bodies.count() {
        var line = builder.user_at(position)
        if line == parallel_marker {
            middle = position
        } else if line == step_marker {
            var context = function_lines.copy()
            current.each(context.append)
            var fact = facts.statement_fact(current, context)
            steps.append(fact)
            current = List<String>()
        } else {
            var split = line.split("\n")
            split.each(current.append)
        }
        position = position + 1
    }
    var finish = middle
    while finish < builder.user_bodies.count() and builder.user_at(finish) != end_marker {
        finish = finish + 1
    }
    var jobs = overlap_jobs(facts, steps)
    if jobs.is_empty() or inside_coarse_loop(function_lines) {
        blank_user_range(middle, finish + 1)
        blank_markers(start, middle, step_marker)
        builder.replace_user(start, "")
        return
    }
    blank_user_range(start, middle + 1)
    builder.replace_user(finish, "")
    keep_overlap_items(group, middle, finish, jobs)
    builder.threads = true
    note_fact("flag threads")
    parallel_used = true
    note_fact("flag parallel_used")
}

func keep_overlap_items(group: Integer, start: Integer, end: Integer, jobs: List<Boolean>) {
    var item_end = "/*spite_overlap_{group} item end*/"
    var index = start
    var blanking = false
    while index < end {
        var line = builder.user_at(index)
        var marker = overlap_item_marker(group, line)
        if marker == "job" or marker == "join" {
            var item = overlap_item_number(group, line)
            blanking = jobs[item] != true
            builder.replace_user(index, "")
        } else if marker == "inline" {
            var inline_item = overlap_item_number(group, line)
            blanking = jobs[inline_item] == true
            builder.replace_user(index, "")
        } else if line == item_end {
            blanking = false
            builder.replace_user(index, "")
        } else if blanking {
            builder.replace_user(index, "")
        }
        index = index + 1
    }
}

func overlap_item_marker(group: Integer, line: String): String {
    var prefix = "/*spite_overlap_{group} "
    if not line.starts_with(prefix) or not line.ends_with("*/") {
        return ""
    }
    var prefix_length = prefix.length()
    var line_length = line.length()
    var rest = line.slice(prefix_length, line_length)
    var space = rest.index_of(" ")
    if space < 0 {
        return ""
    }
    return rest.slice(0, space)
}

func overlap_item_number(group: Integer, line: String): Integer {
    var prefix = "/*spite_overlap_{group} "
    var prefix_length = prefix.length()
    var line_length = line.length()
    var rest = line.slice(prefix_length, line_length - 2)
    var space = rest.index_of(" ")
    var rest_length = rest.length()
    var digits = rest.slice(space + 1, rest_length)
    var number = digits.to_integer()
    crash number
    return number
}

# ../../../docs/optimizations.md#a-loop-over-a-list-of-different-classes-runs-them-at-once
func finish_row_groups() {
    var facts = OverlapFacts()
    facts.read_program(
        builder.typedefs,
        builder.prototypes,
        builder.support_bodies,
        builder.user_bodies,
        builder.main_lines,
    )
    var group = 1
    while group <= row_groups {
        crash row_sites[group - 1]
        var site = row_sites[group - 1]
        var condition = ""
        if site.kind == "band" {
            condition = band_condition(facts, site)
        } else {
            condition = row_condition(facts, site, group)
        }
        settle_row_group(group, condition)
        group = group + 1
    }
}

func settle_row_group(group: Integer, condition: String) {
    var begin = "/*spite_row_{group} begin*/"
    var position = 0
    while position < builder.user_bodies.count() {
        var line = builder.user_at(position)
        if line == begin {
            settle_row_at(group, position, condition)
        }
        position = position + 1
    }
}

func settle_row_at(group: Integer, start: Integer, condition: String) {
    var fits = "/*spite_row_{group} fits*/"
    var serial = "/*spite_row_{group} serial*/"
    var serial_end = "/*spite_row_{group} serial end*/"
    var end = "/*spite_row_{group} end*/"
    var fits_at = row_marker_after(start, fits)
    var serial_at = row_marker_after(start, serial)
    var serial_end_at = row_marker_after(serial_at, serial_end)
    var end_at = row_marker_after(serial_end_at, end)
    var function_lines = enclosing_function_lines(start)
    if condition.is_empty() or inside_coarse_loop(function_lines) {
        blank_user_range(start, serial_at + 1)
        blank_user_range(serial_end_at, end_at + 1)
        return
    }
    builder.replace_user(start, "")
    builder.replace_user(fits_at, "")
    builder.replace_user(fits_at + 1, "if ({condition}) \{")
    builder.replace_user(serial_at, "")
    builder.replace_user(serial_end_at, "")
    builder.replace_user(end_at, "")
    builder.threads = true
    note_fact("flag threads")
    parallel_used = true
    note_fact("flag parallel_used")
}

func row_marker_after(start: Integer, marker: String): Integer {
    var position = start
    while position < builder.user_bodies.count() and builder.user_at(position) != marker {
        position = position + 1
    }
    crash position < builder.user_bodies.count()
    return position
}

func row_condition(facts: OverlapFacts, site: RowSite, group: Integer): String {
    var dispatcher = "{site.shape_c_name}___call_{site.member_name}"
    var lines = facts.bodies[dispatcher]
    if not lines or wait_facts.may_wait(dispatcher) {
        return ""
    }
    var ids = List<String>()
    var targets = List<String>()
    var tagged = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var marker = "->class_id == "
        if line.contains(".tag == ") {
            marker = ".tag == "
            tagged = true
        }
        var at = line.index_of(marker)
        var open = line.index_of(") \{ ")
        if at > 0 and open > at {
            var digits_start = at + marker.length()
            var digits = line.slice(digits_start, open)
            ids.append(digits)
            var rest_start = open + 4
            var line_length = line.length()
            var rest = line.slice(rest_start, line_length)
            var call_open = rest.index_of("(")
            var target_name = rest.slice(0, call_open)
            targets.append(target_name)
        }
        index = index + 1
    }
    var count = ids.count()
    if count < 2 or count > 64 {
        return ""
    }
    var member_facts = List<OverlapFact>()
    var usable = List<Boolean>()
    var heavy = List<Boolean>()
    index = 0
    while index < count {
        crash targets[index]
        var target = targets[index]
        var called = ["{target}(spite_row_item);"]
        var no_context = List<String>()
        var fact = facts.statement_fact(called, no_context)
        member_facts.append(fact)
        var fits_row = not wait_facts.may_wait(target) and not row_writes_list(facts, fact, site.list_c_name)
        if fits_row and not weak_classes.is_empty() {
            fits_row = not row_reaches_weak(target, site.member_name)
        }
        usable.append(fits_row)
        heavy.append(fits_row and fact.loops)
        index = index + 1
    }
    var table = List<String>()
    var useful = false
    var first = 0
    while first < count {
        var row = List<String>()
        var second = 0
        while second < count {
            var together = first != second and usable[first] == true and usable[second] == true
            if together {
                crash member_facts[first]
                crash member_facts[second]
                together = facts.independent(member_facts[first], member_facts[second])
            }
            if together and heavy[first] == true and heavy[second] == true {
                useful = true
            }
            if together {
                row.append("1")
            } else {
                row.append("0")
            }
            second = second + 1
        }
        table.append("\{{row.join(", ")}}")
        first = first + 1
    }
    if not useful {
        return ""
    }
    var weights = List<String>()
    var cases = List<String>()
    index = 0
    while index < count {
        if heavy[index] == true {
            weights.append("1")
        } else {
            weights.append("0")
        }
        var id = ids[index]
        cases.append("case {id}: spite_row_k = {index}; break;")
        index = index + 1
    }
    var items = "spite_row_list->items_"
    var read_class = "((SpiteHeader*)(((void**)(intptr_t){items})[spite_row_i]))->class_id"
    if tagged {
        read_class = "((SpiteTagged*)(intptr_t){items})[spite_row_i].tag"
    }
    var parts = List<String>()
    parts.append("(\{ {site.list_c_name}* spite_row_list = {site.list_code};")
    parts.append("static const unsigned char spite_row_table[{count}][{count}] = \{{table.join(", ")}};")
    parts.append("static const unsigned char spite_row_heavy[{count}] = \{{weights.join(", ")}};")
    parts.append(
        "int32_t spite_row_n = spite_row_list->item_count_; int32_t spite_row_seen[64]; int32_t spite_row_heavies = 0;",
    )
    parts.append("bool spite_row_ok = spite_row_n >= 2 && spite_row_n <= {count};")
    parts.append("for (int32_t spite_row_i = 0; spite_row_ok && spite_row_i < spite_row_n; spite_row_i++) \{")
    parts.append("int32_t spite_row_k = -1;")
    parts.append("switch ({read_class}) \{ {cases.join(" ")} default: break; }")
    parts.append("spite_row_ok = spite_row_k >= 0;")
    parts.append(
        "for (int32_t spite_row_j = 0; spite_row_ok && spite_row_j < spite_row_i; spite_row_j++) spite_row_ok = spite_row_table[spite_row_seen[spite_row_j]][spite_row_k] != 0;",
    )
    parts.append(
        "if (spite_row_ok) \{ spite_row_seen[spite_row_i] = spite_row_k; spite_row_{group}_marks[spite_row_i] = spite_row_heavy[spite_row_k]; spite_row_heavies += spite_row_heavy[spite_row_k]; }",
    )
    parts.append("}")
    parts.append("spite_row_ok && spite_row_heavies >= 2; })")
    return parts.join(" ")
}

# ../../../docs/optimizations.md#a-loop-whose-passes-write-only-their-own-item-runs-in-bands
func band_condition(facts: OverlapFacts, site: RowSite): String {
    var target = site.member_c_name
    if not facts.bodies.has(target) or wait_facts.may_wait(target) {
        return ""
    }
    if not weak_classes.is_empty() and row_reaches_weak(target, site.member_name) {
        return ""
    }
    var fact = facts.band_fact(target)
    if not facts.item_only(fact) or facts.band_counts {
        return ""
    }
    var weight = facts.weight_of(target)
    if weight < band_minimum_weight {
        return ""
    }
    var minimum = band_threshold / weight + 1
    if minimum < 2 {
        minimum = 2
    }
    var parts = List<String>()
    parts.append("(\{ {site.list_c_name}* spite_band_list = {site.list_code};")
    parts.append("int32_t spite_band_n = spite_band_list->item_count_;")
    parts.append("bool spite_band_ok = spite_band_n >= {minimum};")
    if not site.inline_items {
        parts.append(
            "for (int32_t spite_band_i = 0; spite_band_ok && spite_band_i < spite_band_n; spite_band_i++) spite_band_ok = ((SpiteHeader*)(((void**)(intptr_t)spite_band_list->items_)[spite_band_i]))->ref_count == 1;",
        )
    }
    parts.append("spite_band_ok; })")
    return parts.join(" ")
}

func row_reaches_weak(target: String, member_name: String): Boolean {
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if target == "{information.c_name}_{member_name}" {
            var keys = ["{information.qualified_dotted}#{member_name}"]
            var reached = call_effects.reached_classes(keys)
            var weak_name = weak_class_reached(reached)
            return not weak_name.is_empty()
        }
        index = index + 1
    }
    return true
}

func row_writes_list(facts: OverlapFacts, fact: OverlapFact, list_c_name: String): Boolean {
    var written = fact.writes.keys()
    var index = 0
    while index < written.count() {
        var key = written[index]
        if key == "raw" or key == "unknown" or key.starts_with("io") {
            return true
        }
        if facts.keys_touch(key, "c:{list_c_name}|*") {
            return true
        }
        index = index + 1
    }
    return false
}

func overlap_jobs(facts: OverlapFacts, steps: List<OverlapFact>): List<Boolean> {
    var jobs = List<Boolean>()
    var heavy = 0
    var last_heavy = -1
    var index = 0
    while index < steps.count() {
        var step = steps[index]
        if step.loops {
            heavy = heavy + 1
            last_heavy = index
        }
        var other = index + 1
        while other < steps.count() {
            var compared = steps[other]
            assert facts.independent(step, compared)
            other = other + 1
        }
        index = index + 1
    }
    if heavy < 2 {
        return jobs
    }
    index = 0
    while index < steps.count() {
        var step = steps[index]
        var job = step.loops and index != last_heavy
        jobs.append(job)
        index = index + 1
    }
    return jobs
}

func inside_coarse_loop(function_lines: List<String>): Boolean {
    var depth = 0
    var index = 0
    while index < function_lines.count() {
        var line = function_lines[index]
        if line.starts_with("spite_coarse_") and line.ends_with("_enter();") {
            depth = depth + 1
        }
        if line.starts_with("spite_coarse_") and line.ends_with("_leave();") {
            depth = depth - 1
        }
        index = index + 1
    }
    return depth > 0
}

func enclosing_function_lines(position: Integer): List<String> {
    var start = position
    var found = false
    while start > 0 and not found {
        start = start - 1
        var line = builder.user_at(start)
        found = opens_function(line)
    }
    var lines = List<String>()
    var index = start
    while index < position {
        var line = builder.user_at(index)
        var split = line.split("\n")
        split.each(lines.append)
        index = index + 1
    }
    return lines
}

func opens_function(line: String): Boolean {
    if line.is_empty() or not line.ends_with(") \{") {
        return false
    }
    var first = line.code_at(0)
    var letter = first == 95 or first >= 65 and first <= 90 or first >= 97 and first <= 122
    var open = line.index_of("(")
    if not letter or open < 0 {
        return false
    }
    var before = line.slice(0, open)
    var words = ["if", "while", "for", "switch", "else", "return"]
    var first_word = before
    var space = before.index_of(" ")
    if space >= 0 {
        first_word = before.slice(0, space)
    }
    return not words.contains(first_word) and not before.contains("=")
}

func blank_markers(start: Integer, end: Integer, marker: String) {
    var index = start
    while index < end {
        var line = builder.user_at(index)
        if line == marker {
            builder.replace_user(index, "")
        }
        index = index + 1
    }
}

func blank_user_range(start: Integer, end: Integer) {
    var index = start
    while index < end {
        builder.replace_user(index, "")
        index = index + 1
    }
}

func join_overlapped_reads(pending: List<String>, scope: Scope) {
    var index = 0
    while index < pending.count() {
        var name = pending[index]
        var handle_type = scope.lookup_type(name)
        crash handle_type
        var handle = joinable_handle(handle_type)
        crash handle
        var joining = find_or_instantiate_function(handle, "_join")
        crash joining
        var handle_code = c_value_name(name)
        builder.add_user("{joining.c_name}({handle_code});")
        index = index + 1
    }
    pending.clear()
}

func mark_rest_used(statements: List<Syntax.Statements.Statement>, start: Integer, scope: Scope) {
    var folded_away = List<Syntax.Statements.Statement>()
    var index = start
    while index < statements.count() {
        folded_away.append(statements[index])
        index = index + 1
    }
    mark_folded_names_used(folded_away, scope)
}

func report_template_walk(
    statements: List<Syntax.Statements.Statement>,
    position: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var statement = statements[position]
    var loop = shape.as_while_statement(statement)
    assert loop
    var before = statements[position - 1]
    var counter_declaration = shape.as_variable_declaration(before)
    assert counter_declaration
    var counter = counter_declaration.name
    assert starts_at_zero(before, counter)
    var list_expression = walked_list(loop, counter)
    assert list_expression
    var list_text = operand_text(list_expression)
    assert loop.body.count() >= 2
    var step = loop.body.last()
    assert is_counter_step(step, counter)
    var core = loop.body.copy()
    core.remove_last()
    var element_text = range_element(core, list_text, counter)
    if element_text != "{list_text}[{counter}]" {
        core.remove_first()
        var mentioned = List<String>()
        collect_block_names(core, mentioned)
        assert not mentioned.contains(counter)
    }
    var walk = template_walk_of(core, element_text, list_text)
    assert walk
    assert not walk.value_names.contains(counter) and not walk.value_names.contains(element_text)
    assert walk_fits_around(walk, statements, position, counter)
    var saved_counter = temporary_counter
    var probe = generate_expression(list_expression, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.type
    var walked_element = walked_element_type(probe_type, walk)
    assert walked_element
    var element = walked_element
    assert walk.members.is_empty() or not is_codegen_type_of(class_information, element)
    assert walked_members_exist(element, walk.members)
    assert passed_functions_fit(walk, scope, class_information)
    var saved_line = current_line
    current_line = loop.line
    report("this 'while' walks every element of '{list_text}' only {walk.purpose}: write '{walk.replacement}'")
    current_line = saved_line
}

func class_qualified_function_message(
    member: Syntax.Expressions.MemberExpression,
    class_information: Analysis.ClassInfo,
): String {
    crash member.object
    var named = try_resolve_static_path(member.object, class_information.qualified_dotted)
    if not named {
        return ""
    }
    if not named.find_function(member.name) {
        return ""
    }
    var instance_name = snake_words(named.simple_name)
    return "'{named.simple_name}.{member.name}' is not a function: '{named.simple_name}' is the class's 'Spite.Class' object, which has no '{member.name}' (the function itself is '{named.simple_name}.functions['{member.name}']'). A function value belongs to an instance: pass '{instance_name}.{member.name}', or ask each element of a list through its member template, such as 'filter_{member.name}()'"
}

func is_codegen_type_of(class_information: Analysis.ClassInfo, spite_type: Analysis.SpiteType): Boolean {
    var written = type_display_name(spite_type)
    var index = 0
    while index < class_information.codegen_types.count() {
        if type_display_name(class_information.codegen_types[index]) == written {
            return true
        }
        index = index + 1
    }
    return false
}

func walked_element_type(walked_type: Analysis.SpiteType, walk: TemplateWalk): Analysis.SpiteType? {
    var listed = type_shape.as_list(walked_type)
    if listed {
        return listed.element
    }
    var walked_class = class_behind(walked_type)
    assert walked_class
    var holds_items = walked_class.qualified_dotted == "Vector" or is_items_class(walked_class)
    assert holds_items and not walked_class.codegen_types.is_empty()
    assert walk.passed_functions.is_empty() and not walk.keeps_elements
    return walked_class.codegen_types[0]
}

func walked_list(loop: Syntax.Statements.WhileStatement, counter: String): Syntax.Expressions.Expression? {
    crash loop.condition
    var condition = shape.as_binary(loop.condition)
    assert condition
    assert condition.operator == 'less'
    crash condition.left
    crash condition.right
    var counter_text = operand_text(condition.left)
    assert counter_text == counter
    var counted = shape.as_call(condition.right)
    assert counted
    assert counted.arguments.is_empty()
    crash counted.callee
    var count_call = shape.as_member(counted.callee)
    assert count_call
    assert count_call.name == "count"
    crash count_call.object
    var list_text = operand_text(count_call.object)
    assert not list_text.is_empty()
    return count_call.object
}

func range_element(core: List<Syntax.Statements.Statement>, list_text: String, counter: String): String {
    var indexed = "{list_text}[{counter}]"
    var first = core.first()
    var read = shape.as_variable_declaration(first)
    if read and core.count() > 1 {
        crash read.value
        var read_text = operand_text(read.value)
        if read_text == indexed {
            return read.name
        }
    }
    return indexed
}

func walk_fits_around(
    walk: TemplateWalk,
    statements: List<Syntax.Statements.Statement>,
    position: Integer,
    counter: String,
): Boolean {
    var after = List<Syntax.Statements.Statement>()
    var after_index = position + 1
    while after_index < statements.count() {
        after.append(statements[after_index])
        after_index = after_index + 1
    }
    var read_after = List<String>()
    collect_block_names(after, read_after)
    if read_after.contains(counter) {
        return false
    }
    if not walk.result_name.is_empty() {
        var result_start = start_before(statements, position, walk.result_name)
        if not result_start {
            return false
        }
        if not is_new_list(result_start) {
            return false
        }
    }
    if not walk.total_name.is_empty() {
        var total_start = start_before(statements, position, walk.total_name)
        if not total_start {
            return false
        }
        if not is_zero_literal(total_start) {
            return false
        }
    }
    if not walk.returned_after.is_empty() {
        if after.is_empty() {
            return false
        }
        var next = after.first()
        var returned = shape.as_return_statement(next)
        if not returned {
            return false
        }
        if not returned.value {
            return false
        }
        var printer = Syntax.SourcePrinter()
        var returned_text = printer.source_expression(returned.value)
        if returned_text != walk.returned_after {
            return false
        }
    }
    return true
}

func start_before(
    statements: List<Syntax.Statements.Statement>,
    position: Integer,
    name: String,
): Syntax.Expressions.Expression? {
    var index = position - 2
    while index >= 0 {
        var statement = statements[index]
        var declared = shape.as_variable_declaration(statement)
        if declared and declared.name == name {
            return declared.value
        }
        var mentioned = List<String>()
        collect_statement_names(statement, mentioned)
        assert not mentioned.contains(name)
        index = index - 1
    }
    return null
}

func is_new_list(expression: Syntax.Expressions.Expression): Boolean {
    var construction = shape.as_generic_call(expression)
    if not construction {
        return false
    }
    if not construction.arguments.is_empty() {
        return false
    }
    crash construction.callee
    var callee_text = operand_text(construction.callee)
    return callee_text == "List"
}

func walked_members_exist(element: Analysis.SpiteType, members: List<String>): Boolean {
    if members.is_empty() {
        return true
    }
    var element_class = element_class_of(element)
    if not element_class {
        return false
    }
    return members_exist(element_class, members)
}

func passed_functions_fit(walk: TemplateWalk, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < walk.passed_functions.count() {
        if not passed_function_fits(walk.passed_functions[index], walk.tests, scope, class_information) {
            return false
        }
        index = index + 1
    }
    return true
}

func passed_function_fits(name: String, tests: Boolean, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    var parts = name.split(".")
    if parts.count() == 1 {
        var held = scope.lookup_type(name)
        if held {
            return not tests and is_function_value_type(held)
        }
        return takes_one_argument(class_information, name, tests)
    }
    if parts.count() != 2 {
        return false
    }
    var receiver_name = parts.first()
    crash receiver_name
    var owner_type = scope.lookup_type(receiver_name)
    if not owner_type {
        var owner_field = class_information.find_field(receiver_name)
        if not owner_field {
            return false
        }
        owner_type = owner_field.type
    }
    crash owner_type
    var owner_class_ref = type_shape.as_class_ref(owner_type)
    if not owner_class_ref {
        return false
    }
    var owner_class = find_class_by_c_name(owner_class_ref.c_name)
    if not owner_class {
        return false
    }
    var function_name = parts.last()
    crash function_name
    return takes_one_argument(owner_class, function_name, tests)
}

func takes_one_argument(information: Analysis.ClassInfo, name: String, tests: Boolean): Boolean {
    var function = information.find_function(name)
    if not function {
        return false
    }
    if function.parameters.count() != 1 or function.is_constructor {
        return false
    }
    var returned = function.return_type
    return not tests or is_boolean_type(returned)
}

func is_function_value_type(held: Analysis.SpiteType): Boolean {
    var class_ref = type_shape.as_class_ref(held)
    if not class_ref {
        return false
    }
    return class_ref.has_signature
}

func passed_call(expression: Syntax.Expressions.Expression, element_text: String): String {
    var called = shape.as_call(expression)
    if not called {
        return ""
    }
    if called.arguments.count() != 1 {
        return ""
    }
    crash called.callee
    var argument = called.arguments.first()
    var argument_text = operand_text(argument)
    if argument_text != element_text {
        return ""
    }
    var callee_text = operand_text(called.callee)
    if callee_text.is_empty() or callee_text.contains("(") or callee_text.contains("[") {
        return ""
    }
    if callee_text.contains(element_text) or callee_text.split(".").count() > 2 {
        return ""
    }
    return callee_text
}

func passed_walk(purpose: String, replacement: String, passed: String): TemplateWalk {
    var walk = TemplateWalk(purpose, replacement)
    walk.passed_functions.append(passed)
    return walk
}

func passed_test(purpose: String, replacement: String, passed: String): TemplateWalk {
    var walk = passed_walk(purpose, replacement, passed)
    walk.tests = true
    return walk
}

func members_exist(element_class: Analysis.ClassInfo, members: List<String>): Boolean {
    var index = 0
    while index < members.count() {
        var member_type = member_type_of(element_class, members[index])
        if not member_type {
            return false
        }
        index = index + 1
    }
    return true
}

func template_walk_of(core: List<Syntax.Statements.Statement>, element_text: String, list_text: String): TemplateWalk? {
    if core.count() == 2 {
        return walk_through_local(core, element_text, list_text)
    }
    assert core.count() == 1
    var only = core.first()
    crash only
    switch only {
        Syntax.Statements.ExpressionStatement: return walk_by_call(only, element_text, list_text)
        Syntax.Statements.AssignmentStatement: return walk_by_sum(only, element_text, list_text)
        Syntax.Statements.IfStatement: return walk_by_test(only, element_text, list_text)
        _: return null
    }
}

func element_member(expression: Syntax.Expressions.Expression, element_text: String): String {
    var read = expression
    var called = shape.as_call(expression)
    if called {
        if not called.arguments.is_empty() {
            return ""
        }
        crash called.callee
        read = called.callee
    }
    var member = shape.as_member(read)
    if not member {
        return ""
    }
    crash member.object
    var object_text = operand_text(member.object)
    if object_text != element_text {
        return ""
    }
    if member.name.starts_with("_") {
        return ""
    }
    return member.name
}

func append_call(statement: Syntax.Statements.Statement): Syntax.Expressions.CallExpression? {
    var expression_statement = shape.as_expression_statement(statement)
    assert expression_statement
    crash expression_statement.value
    var called = shape.as_call(expression_statement.value)
    assert called
    assert called.arguments.count() == 1
    crash called.callee
    var callee = shape.as_member(called.callee)
    assert callee
    assert callee.name == "append"
    crash callee.object
    var receiver = shape.as_identifier(callee.object)
    assert receiver
    return called
}

func appended_to(appending: Syntax.Expressions.CallExpression): String {
    crash appending.callee
    var callee = shape.as_member(appending.callee)
    crash callee
    crash callee.object
    return operand_text(callee.object)
}

func walk_by_call(
    statement: Syntax.Statements.ExpressionStatement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    crash statement.value
    var called = shape.as_call(statement.value)
    assert called
    var member = element_member(statement.value, element_text)
    if not member.is_empty() {
        var each = TemplateWalk("to call '{member}' on each", "{list_text}.each_{member}()")
        each.members.append(member)
        return each
    }
    var appending = append_call(statement)
    if not appending {
        var passed = passed_call(statement.value, element_text)
        assert not passed.is_empty()
        return passed_walk("to call '{passed}' with each", "{list_text}.each({passed})", passed)
    }
    var result = appended_to(appending)
    assert result != list_text
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    if appended_text == element_text {
        var copied = TemplateWalk("to copy it", "var {result} = {list_text}.copy()")
        copied.result_name = result
        copied.keeps_elements = true
        return copied
    }
    var mapped_member = element_member(appended, element_text)
    assert not mapped_member.is_empty()
    var mapped = TemplateWalk(
        "to collect each '{mapped_member}'",
        "var {result} = {list_text}.map_{collected_word(mapped_member)}()",
    )
    mapped.members.append(mapped_member)
    mapped.result_name = result
    return mapped
}

func walk_through_local(
    core: List<Syntax.Statements.Statement>,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    var first = core.first()
    var declared = shape.as_variable_declaration(first)
    assert declared
    crash declared.value
    var member = element_member(declared.value, element_text)
    var last = core.last()
    var appending = append_call(last)
    assert appending
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    assert appended_text == declared.name
    var result = appended_to(appending)
    assert result != list_text
    assert not member.is_empty()
    var mapped = TemplateWalk("to collect each '{member}'", "var {result} = {list_text}.map_{collected_word(member)}()")
    mapped.members.append(member)
    mapped.result_name = result
    return mapped
}

func walk_by_sum(
    statement: Syntax.Statements.AssignmentStatement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    crash statement.target
    crash statement.value
    var total = shape.as_identifier(statement.target)
    assert total
    var added = shape.as_binary(statement.value)
    assert added
    assert added.operator == 'add'
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    assert left_text == total.name
    var member = element_member(added.right, element_text)
    if member.is_empty() {
        var adder = passed_call(added.right, element_text)
        assert not adder.is_empty()
        var summed_by = passed_walk(
            "to add up what '{adder}' answers for each",
            "var {total.name} = {list_text}.sum({adder})",
            adder,
        )
        summed_by.total_name = total.name
        return summed_by
    }
    var summed = TemplateWalk("to add up '{member}'", "var {total.name} = {list_text}.sum_{member}()")
    summed.members.append(member)
    summed.total_name = total.name
    return summed
}

func walk_by_test(statement: Syntax.Statements.IfStatement, element_text: String, list_text: String): TemplateWalk? {
    assert not statement.has_else_branch and statement.then_branch.count() == 1
    crash statement.condition
    var action = statement.then_branch.first()
    var tested = element_member(statement.condition, element_text)
    if not tested.is_empty() {
        return walk_by_kept(action, tested, element_text, list_text)
    }
    var tester = passed_call(statement.condition, element_text)
    if not tester.is_empty() {
        return walk_by_passed_test(action, tester, element_text, list_text)
    }
    var negated = shape.as_unary(statement.condition)
    if negated {
        return walk_by_every(negated, action, element_text, list_text)
    }
    var compared = shape.as_binary(statement.condition)
    assert compared
    return walk_by_find(compared, action, element_text, list_text)
}

func walk_by_kept(
    action: Syntax.Statements.Statement,
    tested: String,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    var returned = shape.as_return_statement(action)
    if returned {
        assert returned.value
        assert shape.is_true_literal(returned.value)
        var any = TemplateWalk("to ask whether any element's '{tested}' is true", "return {list_text}.any_{tested}()")
        any.members.append(tested)
        any.returned_after = "false"
        return any
    }
    var counted = shape.as_assignment_statement(action)
    if counted {
        return walk_by_count(counted, tested, list_text)
    }
    var appending = append_call(action)
    assert appending
    var result = appended_to(appending)
    assert result != list_text
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    if appended_text == element_text {
        var kept = TemplateWalk(
            "to keep the elements whose '{tested}' is true",
            "var {result} = {list_text}.filter_{tested}()",
        )
        kept.members.append(tested)
        kept.result_name = result
        kept.keeps_elements = true
        return kept
    }
    var mapped_member = element_member(appended, element_text)
    assert not mapped_member.is_empty()
    var kept_and_mapped = TemplateWalk(
        "to collect '{mapped_member}' of the elements whose '{tested}' is true",
        "var {result} = {list_text}.filter_{tested}().map_{collected_word(mapped_member)}()",
    )
    kept_and_mapped.members.append(tested)
    kept_and_mapped.members.append(mapped_member)
    kept_and_mapped.result_name = result
    return kept_and_mapped
}

func walk_by_passed_test(
    action: Syntax.Statements.Statement,
    tester: String,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    var returned = shape.as_return_statement(action)
    if returned {
        assert returned.value
        if shape.is_true_literal(returned.value) {
            var any = passed_test(
                "to ask whether '{tester}' is true for any element",
                "return {list_text}.any({tester})",
                tester,
            )
            any.returned_after = "false"
            return any
        }
        var returned_text = operand_text(returned.value)
        assert returned_text == element_text
        var found = passed_test(
            "to find the first element '{tester}' is true for",
            "return {list_text}.find({tester})",
            tester,
        )
        found.returned_after = "null"
        return found
    }
    var counted = shape.as_assignment_statement(action)
    if counted {
        return walk_by_passed_count(counted, tester, list_text)
    }
    var appending = append_call(action)
    assert appending
    var result = appended_to(appending)
    assert result != list_text
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    assert appended_text == element_text
    var kept = passed_test(
        "to keep the elements '{tester}' is true for",
        "var {result} = {list_text}.filter({tester})",
        tester,
    )
    kept.result_name = result
    return kept
}

func walk_by_passed_count(
    counted: Syntax.Statements.AssignmentStatement,
    tester: String,
    list_text: String,
): TemplateWalk? {
    crash counted.target
    crash counted.value
    var total = shape.as_identifier(counted.target)
    assert total
    var added = shape.as_binary(counted.value)
    assert added
    assert added.operator == 'add'
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    assert left_text == total.name
    var step = shape.as_integer_literal(added.right)
    assert step
    assert step.value == 1
    var counting = passed_test(
        "to count the elements '{tester}' is true for",
        "var {total.name} = {list_text}.count({tester})",
        tester,
    )
    counting.total_name = total.name
    return counting
}

func walk_by_count(counted: Syntax.Statements.AssignmentStatement, tested: String, list_text: String): TemplateWalk? {
    crash counted.target
    crash counted.value
    var total = shape.as_identifier(counted.target)
    assert total
    var added = shape.as_binary(counted.value)
    assert added
    assert added.operator == 'add'
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    assert left_text == total.name
    var step = shape.as_integer_literal(added.right)
    assert step
    assert step.value == 1
    var counting = TemplateWalk(
        "to count the elements whose '{tested}' is true",
        "var {total.name} = {list_text}.count_{tested}()",
    )
    counting.members.append(tested)
    counting.total_name = total.name
    return counting
}

func walk_by_every(
    negated: Syntax.Expressions.UnaryExpression,
    action: Syntax.Statements.Statement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    assert negated.operator == 'logical_not'
    crash negated.operand
    var tested = element_member(negated.operand, element_text)
    var returned = shape.as_return_statement(action)
    assert returned
    assert returned.value
    assert shape.is_false_literal(returned.value)
    if tested.is_empty() {
        var tester = passed_call(negated.operand, element_text)
        assert not tester.is_empty()
        var every_passed = passed_test(
            "to ask whether '{tester}' is true for every element",
            "return {list_text}.all({tester})",
            tester,
        )
        every_passed.returned_after = "true"
        return every_passed
    }
    var every = TemplateWalk("to ask whether every element's '{tested}' is true", "return {list_text}.all_{tested}()")
    every.members.append(tested)
    every.returned_after = "true"
    return every
}

func walk_by_find(
    compared: Syntax.Expressions.BinaryExpression,
    action: Syntax.Statements.Statement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    assert compared.operator == 'equal'
    crash compared.left
    crash compared.right
    var tested = element_member(compared.left, element_text)
    assert not tested.is_empty()
    var returned = shape.as_return_statement(action)
    assert returned
    assert returned.value
    var returned_text = operand_text(returned.value)
    assert returned_text == element_text
    var printer = Syntax.SourcePrinter()
    var value_text = printer.source_expression(compared.right)
    var found = TemplateWalk(
        "to find the first whose '{tested}' equals '{value_text}'",
        "return {list_text}.find_by_{tested}({value_text})",
    )
    found.members.append(tested)
    found.returned_after = "null"
    collect_mentioned_names(compared.right, found.value_names)
    return found
}

func starts_at_zero(before: Syntax.Statements.Statement, counter: String): Boolean {
    var declared = shape.as_variable_declaration(before)
    if declared {
        crash declared.value
        return declared.name == counter and is_zero_literal(declared.value)
    }
    var assigned = shape.as_assignment_statement(before)
    if not assigned {
        return false
    }
    crash assigned.target
    crash assigned.value
    var target_text = operand_text(assigned.target)
    return target_text == counter and is_zero_literal(assigned.value)
}

func is_zero_literal(expression: Syntax.Expressions.Expression): Boolean {
    var integer = shape.as_integer_literal(expression)
    if not integer {
        return false
    }
    return integer.value == 0
}

func is_counter_step(statement: Syntax.Statements.Statement, counter: String): Boolean {
    var assignment = shape.as_assignment_statement(statement)
    if not assignment {
        return false
    }
    crash assignment.target
    crash assignment.value
    var target_text = operand_text(assignment.target)
    if target_text != counter {
        return false
    }
    var added = shape.as_binary(assignment.value)
    if not added {
        return false
    }
    if added.operator != 'add' {
        return false
    }
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    var right = shape.as_integer_literal(added.right)
    if not right {
        return false
    }
    return left_text == counter and right.value == 1
}

func signature_is_dictated(function: Analysis.FunctionInfo): Boolean {
    if not function.symbol_name.is_empty() {
        return true
    }
    if not function.source_path.is_empty() {
        return true
    }
    if function.name.starts_with("set_") or function.name.starts_with("get_") {
        return true
    }
    var dictated = [
        "sum"
        "subtract"
        "multiply"
        "divide"
        "remainder"
        "equals"
        "less_than"
        "greater_than"
        "negate"
        "get_at"
        "set_at"
    ]
    return dictated.contains(function.name)
}

func is_lowercase_name(name: String): Boolean {
    var index = 0
    while index < name.length() {
        var code = name.code_at(index)
        var is_lower = code >= 97 and code <= 122
        var is_digit = code >= 48 and code <= 57
        if not is_lower and not is_digit and code != 95 {
            return false
        }
        index = index + 1
    }
    return true
}

func is_pascal_name(name: String): Boolean {
    if name.is_empty() {
        return false
    }
    var first = name.code_at(0)
    if first < 65 or first > 90 {
        return false
    }
    return not name.contains("_")
}

func words_of(name: String): List<String> {
    var words = List<String>()
    var current = ""
    var index = 0
    while index < name.length() {
        var code = name.code_at(index)
        var is_upper = code >= 65 and code <= 90
        if code == 95 or is_upper {
            if not current.is_empty() {
                words.append(current)
            }
            current = ""
        }
        if code != 95 {
            current = current + name.character_at(index).lower_case()
        }
        index = index + 1
    }
    if not current.is_empty() {
        words.append(current)
    }
    return words
}

