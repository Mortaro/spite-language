var waiting_kinds = List<String>()
var waiting_positions = List<Int>()
var unwaiting_loop_path = ""
var unwaiting_loop_line = 0
var unwaiting_loop_owner = ""
var unwaiting_loop_function = ""
var development = false
var reflect_function_names = List<String>()
var live_reflection_emitted = false
var body_narrowed_names = List<String>()
var body_assigned_paths = List<String>()
var singleton_names = List<String>()
var tracked_class_names = List<String>()
var singleton_releases = List<String>()
