var shape = Analysis.AstShape()
var type_shape = Analysis.TypeShape()
var builder = CodeBuilder()
var classes = List<Analysis.ClassInfo>()
var enums = List<Analysis.EnumInfo>()
var unions = List<Analysis.UnionInfo>()
var list_names = List<String>()
var list_template_names = List<String>()
var class_object_names = List<String>()
var attributes_function_names = List<String>()
var dictionary_names = List<String>()
var support_class_names = List<String>()
var current_owner = ""
var nullable_scalar_labels = List<String>()
var has_error = false
var error_message = ""
var current_function = ""
var bound_symbol_name = ""
var bound_field_name = ""
var bound_field_type: Nullable<Analysis.SpiteType> = null
var arguments_parameter_names = List<String>()
var temporary_counter = 0
var literal_counter = 0

func Generator() { }

func report(message: String) {
    if has_error {
        return
    }
    has_error = true
    error_message = current_owner + "." + current_function + ": " + message
}

func register_system_class(name: String): Analysis.ClassInfo {
    var information = Analysis.ClassInfo(name, name, "", name, classes.count() + 1)
    information.is_builtin = true
    classes.append(information)
    return information
}

func add_builtin_function(information: Analysis.ClassInfo, name: String, parameters: List<Analysis.ParamInfo>, return_type: Analysis.SpiteType) {
    var is_constructor = name == information.simple_name
    var function = Analysis.FunctionInfo(
        name,
        information.c_name + "_" + name,
        parameters,
        return_type,
        List<Syntax.Statements.Statement>(),
        is_constructor,
    )
    if is_constructor {
        information.constructor = function
    }
    information.functions.append(function)
}

func no_parameters(): List<Analysis.ParamInfo> {
    return List<Analysis.ParamInfo>()
}

func one_parameter(name: String, spite_type: Analysis.SpiteType): List<Analysis.ParamInfo> {
    var result = List<Analysis.ParamInfo>()
    result.append(Analysis.ParamInfo(name, spite_type))
    return result
}

func register_system_classes() {
    var file = register_system_class("File")
    add_builtin_function(file, "File", one_parameter("path", string_type()), void_type())
    add_builtin_function(file, "read", no_parameters(), nullable_type_of(string_type()))
    add_builtin_function(file, "write", one_parameter("text", string_type()), boolean_type())
    add_builtin_function(file, "append", one_parameter("text", string_type()), boolean_type())
    add_builtin_function(file, "exists", no_parameters(), boolean_type())
    add_builtin_function(file, "remove", no_parameters(), boolean_type())

    var directory = register_system_class("Directory")
    add_builtin_function(directory, "Directory", one_parameter("path", string_type()), void_type())
    add_builtin_function(directory, "files", no_parameters(), list_type_of(string_type()))
    add_builtin_function(directory, "folders", no_parameters(), list_type_of(string_type()))
    add_builtin_function(directory, "exists", no_parameters(), boolean_type())
    add_builtin_function(directory, "create", no_parameters(), boolean_type())

    var process = register_system_class("Process")
    var process_parameters = one_parameter("command", string_type())
    process_parameters.append(Analysis.ParamInfo("arguments", list_type_of(string_type())))
    add_builtin_function(process, "Process", process_parameters, void_type())
    add_builtin_function(process, "run", no_parameters(), integer_type())
    add_builtin_function(process, "output", no_parameters(), string_type())

    var program = register_system_class("Program")
    add_builtin_function(program, "Program", no_parameters(), void_type())
    add_builtin_function(program, "exit", one_parameter("code", integer_type()), void_type())
    add_builtin_function(program, "sleep", one_parameter("milliseconds", integer_type()), void_type())
}

func emit_system_classes(system_structs: String, system_prototypes: String, system_bodies: String) {
    ensure_list(string_type())
    var defines = List<String>()
    var index = 0
    while index < classes.count() {
        if classes[index].is_builtin {
            defines.append(
                "#define SPITE_CLASS_ID_" + classes[index].simple_name.upper() + " " + classes[index].class_id,
            )
        }
        index = index + 1
    }
    builder.add_typedef(defines.join("\n"))
    builder.add_typedef(system_structs)
    builder.add_prototype(system_prototypes)
    builder.add_support(system_bodies)
}

func generate(discovery: Discovery.DiscoveryResult, runtime_header_text: String, system_structs: String, system_prototypes: String, system_bodies: String): String {
    builder.add_typedef(runtime_header_text)
    register_system_classes()
    register_classes(discovery.class_files)
    emit_enums()
    var forward_index = 0
    while forward_index < classes.count() {
        builder.add_typedef(
            "typedef struct " + classes[forward_index].c_name + " " + classes[forward_index].c_name + ";",
        )
        forward_index = forward_index + 1
    }
    emit_system_classes(system_structs, system_prototypes, system_bodies)
    resolve_union_members()
    emit_unions()
    resolve_classes(discovery.class_files)
    if has_error {
        return ""
    }
    var index = 0
    while index < classes.count() {
        if not classes[index].is_builtin {
            emit_class(classes[index])
        }
        index = index + 1
    }
    emit_pending_functions()
    emit_main(discovery.entry_mangled_name)
    return builder.render()
}

func register_classes(discovered: List<Discovery.DiscoveredClass>) {
    var index = 0
    var next_id = classes.count() + 1
    while index < discovered.count() {
        var entry = discovered[index]
        classes.append(
            Analysis.ClassInfo(
                entry.mangled_name,
                entry.simple_name,
                entry.namespace_dotted,
                entry.qualified_dotted,
                next_id,
            ),
        )
        register_enums(entry)
        register_unions(entry)
        next_id = next_id + 1
        index = index + 1
    }
}

func register_unions(entry: Discovery.DiscoveredClass) {
    var file = entry.get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_union_declaration(file.statements[statement_index])
        if declaration {
            unions.append(
                Analysis.UnionInfo(
                    entry.mangled_name + "_" + declaration.name,
                    declaration.name,
                    entry.qualified_dotted,
                    entry.namespace_dotted,
                    declaration.members,
                ),
            )
        }
        statement_index = statement_index + 1
    }
}

func resolve_union_members() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var member_index = 0
        while member_index < information.member_types.count() {
            var member_class = class_of_type_reference(
                information.member_types[member_index],
                information.owner_namespace,
            )
            if member_class {
                information.members.append(member_class)
            } else {
                report("a member of union '" + information.simple_name + "' is not a class")
            }
            member_index = member_index + 1
        }
        index = index + 1
    }
}

func class_of_type_reference(type_reference: Syntax.Types.Type, current_namespace: String): Nullable<Analysis.ClassInfo> {
    var named = shape.as_named_type(type_reference)
    if named {
        if named.path.count() == 1 {
            return find_class(named.path[0], current_namespace)
        }
        return find_class_by_qualified(named.path.join("."))
    }
    return null
}

func find_union(name: String): Nullable<Analysis.UnionInfo> {
    var fallback: Nullable<Analysis.UnionInfo> = null
    var index = 0
    while index < unions.count() {
        var candidate = unions[index]
        if candidate.simple_name == name {
            if candidate.owner_qualified == current_owner {
                return candidate
            }
            fallback = candidate
        }
        index = index + 1
    }
    return fallback
}

func find_union_qualified(owner_qualified: String, name: String): Nullable<Analysis.UnionInfo> {
    var index = 0
    while index < unions.count() {
        var candidate = unions[index]
        if candidate.simple_name == name and candidate.owner_qualified == owner_qualified {
            return candidate
        }
        index = index + 1
    }
    return null
}

func find_union_by_c_name(c_name: String): Nullable<Analysis.UnionInfo> {
    var index = 0
    while index < unions.count() {
        if unions[index].c_name == c_name {
            return unions[index]
        }
        index = index + 1
    }
    return null
}

func union_type_of(information: Analysis.UnionInfo): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.UnionType(information.c_name)
    return resolved
}

func class_type_of(information: Analysis.ClassInfo): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(information.c_name)
    return resolved
}

func class_id_test(code: String, information: Analysis.ClassInfo): String {
    return "(((SpiteHeader*)(" + code + "))->class_id == " + information.class_id + ")"
}

func emit_unions() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var name = information.c_name
        builder.add_typedef("typedef void* " + name + ";")
        builder.add_prototype(name + " " + name + "_retain(" + name + " self);")
        builder.add_prototype("void " + name + "_release(" + name + " self);")
        builder.add_support(
            name + " " + name + "_retain(" + name + " self) {\nif (self != 0) ((SpiteHeader*)self)->ref_count = ((SpiteHeader*)self)->ref_count + 1;\nreturn self;\n}",
        )
        var release_lines = List<String>()
        release_lines.append("void " + name + "_release(" + name + " self) {")
        release_lines.append("if (self == 0) return;")
        var member_index = 0
        while member_index < information.members.count() {
            var member = information.members[member_index]
            release_lines.append(
                "if " + class_id_test("self", member) + " { " + member.c_name + "_release((" + member.c_name + "*)self); return; }",
            )
            member_index = member_index + 1
        }
        release_lines.append("}")
        builder.add_support(release_lines.join("\n"))
        index = index + 1
    }
}

func register_enums(entry: Discovery.DiscoveredClass) {
    var file = entry.get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_enum_declaration(file.statements[statement_index])
        if declaration {
            enums.append(
                Analysis.EnumInfo(
                    entry.mangled_name + "_" + declaration.name,
                    declaration.name,
                    entry.qualified_dotted,
                    declaration.values,
                ),
            )
        }
        statement_index = statement_index + 1
    }
}

func find_enum(name: String): Nullable<Analysis.EnumInfo> {
    var fallback: Nullable<Analysis.EnumInfo> = null
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        if candidate.simple_name == name {
            if candidate.owner_qualified == current_owner {
                return candidate
            }
            fallback = candidate
        }
        index = index + 1
    }
    return fallback
}

func find_enum_qualified(owner_qualified: String, name: String): Nullable<Analysis.EnumInfo> {
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        if candidate.simple_name == name and candidate.owner_qualified == owner_qualified {
            return candidate
        }
        index = index + 1
    }
    return null
}

func find_enum_with_value(value: String): Nullable<Analysis.EnumInfo> {
    var found: Nullable<Analysis.EnumInfo> = null
    var matches = 0
    var index = 0
    while index < enums.count() {
        if enums[index].has_value(value) {
            found = enums[index]
            matches = matches + 1
        }
        index = index + 1
    }
    if matches == 1 {
        return found
    }
    return null
}

func enum_type_of(information: Analysis.EnumInfo): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.EnumType(information.c_name, information.values)
    return resolved
}

func enum_value_code(literal: Syntax.Expressions.EnumLiteralExpression, enum_type: Analysis.Types.EnumType): String {
    if not enum_type.values.contains(literal.value) {
        report("'" + literal.value + "' is not a value of this enum")
    }
    return enum_type.c_name + "_" + literal.value
}

func emit_enums() {
    var index = 0
    while index < enums.count() {
        var information = enums[index]
        var typedef_lines = List<String>()
        typedef_lines.append("typedef enum {")
        var name_lines = List<String>()
        name_lines.append("const char* " + information.c_name + "_name(" + information.c_name + " value) {")
        name_lines.append("switch (value) {")
        var value_index = 0
        while value_index < information.values.count() {
            var value_name = information.values[value_index]
            typedef_lines.append(information.c_name + "_" + value_name + ",")
            name_lines.append("case " + information.c_name + "_" + value_name + ": return \"" + value_name + "\";")
            value_index = value_index + 1
        }
        typedef_lines.append("} " + information.c_name + ";")
        name_lines.append("}")
        name_lines.append("return \"\";")
        name_lines.append("}")
        builder.add_typedef(typedef_lines.join("\n"))
        builder.add_prototype("const char* " + information.c_name + "_name(" + information.c_name + " value);")
        builder.add_support(name_lines.join("\n"))
        index = index + 1
    }
}

func find_class_by_qualified(qualified: String): Nullable<Analysis.ClassInfo> {
    var index = 0
    while index < classes.count() {
        if classes[index].qualified_dotted == qualified {
            return classes[index]
        }
        index = index + 1
    }
    return null
}

func find_class_by_c_name(c_name: String): Nullable<Analysis.ClassInfo> {
    var index = 0
    while index < classes.count() {
        if classes[index].c_name == c_name {
            return classes[index]
        }
        index = index + 1
    }
    return null
}

func find_class(name: String, current_namespace: String): Nullable<Analysis.ClassInfo> {
    if not current_namespace.is_empty() {
        var qualified = current_namespace + "." + name
        var found = find_class_by_qualified(qualified)
        if found {
            return found
        }
    }
    return find_class_by_qualified(name)
}

func resolve_classes(discovered: List<Discovery.DiscoveredClass>) {
    var index = 0
    while index < discovered.count() {
        resolve_class_body(discovered[index], classes[index + classes.count() - discovered.count()], true)
        index = index + 1
    }
    index = 0
    while index < discovered.count() {
        resolve_class_body(discovered[index], classes[index + classes.count() - discovered.count()], false)
        index = index + 1
    }
}

func resolve_class_body(entry: Discovery.DiscoveredClass, information: Analysis.ClassInfo, functions_pass: Bool) {
    var file = entry.get_file()
    current_owner = information.qualified_dotted
    var empty_scope = Scope(null)
    var statement_index = 0
    while statement_index < file.statements.count() {
        var statement = file.statements[statement_index]
        var variable_declaration = shape.as_variable_declaration(statement)
        if variable_declaration {
            if not functions_pass {
                resolve_field(variable_declaration, information, empty_scope)
            }
        }
        var function_declaration = shape.as_function_declaration(statement)
        if function_declaration {
            if functions_pass {
                resolve_function(function_declaration, information)
            }
        }
        statement_index = statement_index + 1
    }
}

func infer_declared_type(annotation: Nullable<Syntax.Types.Type>, initializer: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo): Analysis.SpiteType {
    if annotation {
        var resolved = resolve_type(annotation, class_information.namespace_dotted)
        crash resolved
        return resolved
    }
    var result = generate_expression(initializer, scope, class_information)
    return result.get_type()
}

func resolve_field(declaration: Syntax.Statements.VariableDeclaration, information: Analysis.ClassInfo, scope: Scope) {
    var initializer = declaration.value
    assert initializer
    var field_type = infer_declared_type(declaration.type_reference, initializer, scope, information)
    if type_shape.is_console(field_type) {
        information.fields.append(Analysis.FieldInfo(declaration.name, field_type, ""))
        return
    }
    var default_code = coerce_for_store(initializer, field_type, scope, information)
    information.fields.append(Analysis.FieldInfo(declaration.name, field_type, default_code))
}

func symbol_parameter_of(declaration: Syntax.Statements.FunctionDeclaration): String {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var parameter_type = parameter.type_reference
        if parameter_type {
            var named = shape.as_named_type(parameter_type)
            if named {
                if named.path.count() == 1 and named.path[0] == "Symbol" {
                    return parameter.name
                }
            }
        }
        index = index + 1
    }
    return ""
}

func register_template(declaration: Syntax.Statements.FunctionDeclaration, information: Analysis.ClassInfo): Bool {
    var symbol_parameter = symbol_parameter_of(declaration)
    if symbol_parameter.is_empty() {
        return false
    }
    var padded_name = "_" + declaration.name + "_"
    var position = padded_name.index_of("_" + symbol_parameter + "_")
    if position < 0 {
        return false
    }
    var prefix = declaration.name.slice(0, position)
    var suffix = declaration.name.slice(position + symbol_parameter.length(), declaration.name.length())
    information.templates.append(Analysis.TemplateInfo(declaration, symbol_parameter, prefix, suffix))
    return true
}

func find_or_instantiate_function(information: Analysis.ClassInfo, name: String): Nullable<Analysis.FunctionInfo> {
    var existing = information.find_function(name)
    if existing {
        return existing
    }
    var chosen: Nullable<Analysis.TemplateInfo> = null
    var chosen_field: Nullable<Analysis.FieldInfo> = null
    var matches = 0
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        var member_name = template.member_name_for(name)
        if not member_name.is_empty() {
            var field = information.find_field(member_name)
            if field {
                chosen = template
                chosen_field = field
                matches = matches + 1
            }
        }
        index = index + 1
    }
    if matches > 1 {
        report("'" + name + "' is answered by more than one Symbol codegen function of '" + information.simple_name + "'")
        return null
    }
    if chosen {
        if chosen_field {
            return instantiate_template(information, chosen, chosen_field, name)
        }
    }
    return null
}

func instantiate_template(information: Analysis.ClassInfo, template: Analysis.TemplateInfo, field: Analysis.FieldInfo, call_name: String): Analysis.FunctionInfo {
    var declaration = template.get_declaration()
    var saved_symbol_name = bound_symbol_name
    var saved_field_name = bound_field_name
    var saved_field_type = bound_field_type
    var saved_owner = current_owner
    bound_symbol_name = template.symbol_parameter
    bound_field_name = field.name
    bound_field_type = field.get_type()
    current_owner = information.qualified_dotted

    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name != template.symbol_parameter {
            var parameter_type_reference = parameter.type_reference
            if parameter_type_reference {
                var parameter_type = resolve_type(parameter_type_reference, information.namespace_dotted)
                if parameter_type {
                    parameters.append(Analysis.ParamInfo(parameter.name, parameter_type))
                }
            }
        }
        parameter_index = parameter_index + 1
    }
    var return_type = void_type()
    var return_type_reference = declaration.return_type
    if return_type_reference {
        var resolved_return = resolve_type(return_type_reference, information.namespace_dotted)
        if resolved_return {
            return_type = resolved_return
        }
    }
    var function = Analysis.FunctionInfo(call_name, information.c_name + "_" + call_name, parameters, return_type, declaration.body, false)
    function.symbol_name = template.symbol_parameter
    function.symbol_field_name = field.name
    information.functions.append(function)
    builder.add_prototype(function_signature(information, function) + ";")

    bound_symbol_name = saved_symbol_name
    bound_field_name = saved_field_name
    bound_field_type = saved_field_type
    current_owner = saved_owner
    return function
}

func bind_symbol_of(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    bound_symbol_name = function.symbol_name
    bound_field_name = function.symbol_field_name
    bound_field_type = null
    if not function.symbol_field_name.is_empty() {
        var field = information.find_field(function.symbol_field_name)
        if field {
            bound_field_type = field.get_type()
        }
    }
}

func is_bound_attributes_index(index_expression: Syntax.Expressions.IndexExpression): Bool {
    if bound_symbol_name.is_empty() {
        return false
    }
    var object_ast = index_expression.object
    var index_ast = index_expression.index
    if object_ast {
        if index_ast {
            var object_identifier = shape.as_identifier(object_ast)
            var index_identifier = shape.as_identifier(index_ast)
            if object_identifier {
                if index_identifier {
                    return object_identifier.name == "attributes" and index_identifier.name == bound_symbol_name
                }
            }
        }
    }
    return false
}

func emit_pending_functions() {
    var emitted_any = true
    while emitted_any {
        emitted_any = false
        var class_index = 0
        while class_index < classes.count() {
            var information = classes[class_index]
            if not information.is_builtin {
                var function_index = 0
                while function_index < information.functions.count() {
                    if not information.functions[function_index].is_emitted {
                        current_owner = information.qualified_dotted
                        emit_user_function(information, information.functions[function_index])
                        emitted_any = true
                    }
                    function_index = function_index + 1
                }
            }
            class_index = class_index + 1
        }
    }
}

func resolve_function(declaration: Syntax.Statements.FunctionDeclaration, information: Analysis.ClassInfo) {
    if register_template(declaration, information) {
        return
    }
    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        var parameter_type_reference = parameter.type_reference
        assert parameter_type_reference
        var parameter_type = resolve_type(parameter_type_reference, information.namespace_dotted)
        assert parameter_type
        parameters.append(Analysis.ParamInfo(parameter.name, parameter_type))
        parameter_index = parameter_index + 1
    }
    var return_type: Analysis.SpiteType = Analysis.Types.VoidType()
    var return_type_reference = declaration.return_type
    if return_type_reference {
        var resolved_return = resolve_type(return_type_reference, information.namespace_dotted)
        assert resolved_return
        return_type = resolved_return
    }
    var is_constructor = declaration.name == information.simple_name
    var c_name = information.c_name + "_" + declaration.name
    var function = Analysis.FunctionInfo(
        declaration.name,
        c_name,
        parameters,
        return_type,
        declaration.body,
        is_constructor,
    )
    if is_constructor {
        information.constructor = function
    } else if declaration.name == "drop" {
        information.drop_function = function
    }
    information.functions.append(function)
}

func resolve_type(type_reference: Syntax.Types.Type, current_namespace: String): Nullable<Analysis.SpiteType> {
    var named = shape.as_named_type(type_reference)
    if named {
        return resolve_named_type(named, current_namespace)
    }
    report("this kind of type reference is not supported yet")
    return null
}

func resolve_named_type(named: Syntax.Types.NamedType, current_namespace: String): Nullable<Analysis.SpiteType> {
    if named.path.count() == 2 and not bound_symbol_name.is_empty() {
        if named.path[0] == bound_symbol_name and named.path[1] == "class" {
            return bound_field_type
        }
    }
    if named.path.count() == 1 {
        var name = named.path[0]
        if name == "Int" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('integer_kind')
            return resolved
        }
        if name == "Long" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('long_kind')
            return resolved
        }
        if name == "Float" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('float_kind')
            return resolved
        }
        if name == "Double" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('double_kind')
            return resolved
        }
        if name == "Bool" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('boolean_kind')
            return resolved
        }
        if name == "String" {
            var resolved: Analysis.SpiteType = Analysis.Types.StringType()
            return resolved
        }
        if name == "Console" {
            var resolved: Analysis.SpiteType = Analysis.Types.ConsoleType()
            return resolved
        }
        if name == "Nullable" {
            return resolve_nullable_argument(named, current_namespace)
        }
        if name == "Arguments" {
            var resolved: Analysis.SpiteType = Analysis.Types.ArgumentsType()
            return resolved
        }
        if name == "Dictionary" {
            var dictionary_element = resolve_single_type_argument(named, current_namespace)
            if dictionary_element {
                return dictionary_type_of(dictionary_element)
            }
            return null
        }
        if name == "List" {
            var list_element = resolve_single_type_argument(named, current_namespace)
            if list_element {
                return list_type_of(list_element)
            }
            return null
        }
        var found_class = find_class(name, current_namespace)
        if found_class {
            var same_name_union = find_union_qualified(found_class.qualified_dotted, name)
            if same_name_union {
                return union_type_of(same_name_union)
            }
            var same_name_enum = find_enum_qualified(found_class.qualified_dotted, name)
            if same_name_enum {
                return enum_type_of(same_name_enum)
            }
            var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(found_class.c_name)
            return resolved
        }
        var found_enum = find_enum(name)
        if found_enum {
            return enum_type_of(found_enum)
        }
        var found_union = find_union(name)
        if found_union {
            return union_type_of(found_union)
        }
        report("unknown type '" + name + "'")
        return null
    }
    var joined = named.path.join(".")
    var owner_path = List<String>()
    var path_index = 0
    while path_index < named.path.count() - 1 {
        owner_path.append(named.path[path_index])
        path_index = path_index + 1
    }
    var qualified_enum = find_enum_qualified(owner_path.join("."), named.path.last())
    if qualified_enum {
        return enum_type_of(qualified_enum)
    }
    var qualified_union = find_union_qualified(owner_path.join("."), named.path.last())
    if qualified_union {
        return union_type_of(qualified_union)
    }
    var qualified_class = find_class_by_qualified(joined)
    if qualified_class {
        var owned_union = find_union_qualified(joined, named.path.last())
        if owned_union {
            return union_type_of(owned_union)
        }
        var owned_enum = find_enum_qualified(joined, named.path.last())
        if owned_enum {
            return enum_type_of(owned_enum)
        }

        var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(qualified_class.c_name)
        return resolved
    }
    report("unknown type '" + joined + "'")
    return null
}

func resolve_single_type_argument(named: Syntax.Types.NamedType, current_namespace: String): Nullable<Analysis.SpiteType> {
    if named.arguments.count() != 1 {
        report(named.path.last() + " takes exactly one type argument")
        return null
    }
    return resolve_generic_argument(named.arguments[0], current_namespace)
}

func resolve_generic_argument(argument: Syntax.Types.GenericArgument, current_namespace: String): Nullable<Analysis.SpiteType> {
    var type_argument = shape.as_type_argument(argument)
    if not type_argument {
        report("a type argument must be a type")
        return null
    }
    assert type_argument
    var inner_type_reference = type_argument.value
    assert inner_type_reference
    return resolve_type(inner_type_reference, current_namespace)
}

func list_type_of(element: Analysis.SpiteType): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ListType(element)
    return resolved
}

func integer_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('integer_kind')
    return resolved
}

func boolean_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('boolean_kind')
    return resolved
}

func string_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.StringType()
    return resolved
}

func long_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('long_kind')
    return resolved
}

func float_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('float_kind')
    return resolved
}

func double_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('double_kind')
    return resolved
}

func void_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.VoidType()
    return resolved
}

func no_types(): List<Analysis.SpiteType> {
    return List<Analysis.SpiteType>()
}

func one_type(first: Analysis.SpiteType): List<Analysis.SpiteType> {
    var result = List<Analysis.SpiteType>()
    result.append(first)
    return result
}

func two_types(first: Analysis.SpiteType, second: Analysis.SpiteType): List<Analysis.SpiteType> {
    var result = List<Analysis.SpiteType>()
    result.append(first)
    result.append(second)
    return result
}

func resolve_nullable_argument(named: Syntax.Types.NamedType, current_namespace: String): Nullable<Analysis.SpiteType> {
    if named.arguments.count() != 1 {
        report("Nullable takes exactly one type argument")
        return null
    }
    var type_argument = shape.as_type_argument(named.arguments[0])
    if not type_argument {
        report("Nullable's argument must be a type")
        return null
    }
    assert type_argument
    var inner_type_reference = type_argument.value
    assert inner_type_reference
    var inner = resolve_type(inner_type_reference, current_namespace)
    if inner {
        var resolved: Analysis.SpiteType = Analysis.Types.NullableType(inner)
        return resolved
    }
    return null
}

func type_is_reference(spite_type: Analysis.SpiteType): Bool {
    if type_shape.as_string(spite_type) {
        return true
    }
    if type_shape.as_list(spite_type) {
        return true
    }
    if type_shape.as_dictionary(spite_type) {
        return true
    }
    if type_shape.as_union(spite_type) {
        return true
    }
    if type_shape.as_class_ref(spite_type) {
        return true
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        return type_is_reference(nullable.get_inner())
    }
    return false
}

func type_needs_drop(spite_type: Analysis.SpiteType): Bool {
    return type_is_reference(spite_type)
}

func types_equal(left_type: Analysis.SpiteType, right_type: Analysis.SpiteType): Bool {
    var left_scalar = type_shape.as_scalar(left_type)
    if left_scalar {
        var right_scalar = type_shape.as_scalar(right_type)
        if right_scalar {
            return left_scalar.kind == right_scalar.kind
        }
        return false
    }
    if type_shape.as_string(left_type) {
        return type_shape.as_string(right_type)
    }
    var left_class = type_shape.as_class_ref(left_type)
    if left_class {
        var right_class = type_shape.as_class_ref(right_type)
        if right_class {
            return left_class.c_name == right_class.c_name
        }
        return false
    }
    var left_union = type_shape.as_union(left_type)
    if left_union {
        var right_union = type_shape.as_union(right_type)
        if right_union {
            return left_union.c_name == right_union.c_name
        }
        return false
    }
    var left_dictionary = type_shape.as_dictionary(left_type)
    if left_dictionary {
        var right_dictionary = type_shape.as_dictionary(right_type)
        if right_dictionary {
            return types_equal(left_dictionary.get_element(), right_dictionary.get_element())
        }
        return false
    }
    var left_list = type_shape.as_list(left_type)
    if left_list {
        var right_list = type_shape.as_list(right_type)
        if right_list {
            return types_equal(left_list.get_element(), right_list.get_element())
        }
        return false
    }
    var left_enum = type_shape.as_enum(left_type)
    if left_enum {
        var right_enum = type_shape.as_enum(right_type)
        if right_enum {
            return left_enum.c_name == right_enum.c_name
        }
        return false
    }
    var left_nullable = type_shape.as_nullable(left_type)
    if left_nullable {
        var right_nullable = type_shape.as_nullable(right_type)
        if right_nullable {
            return types_equal(left_nullable.get_inner(), right_nullable.get_inner())
        }
        return false
    }
    if type_shape.is_void(left_type) {
        return type_shape.is_void(right_type)
    }
    if type_shape.is_arguments(left_type) {
        return type_shape.is_arguments(right_type)
    }
    return type_shape.is_console(right_type)
}

func numeric_c_name(kind: Analysis.Types.NumericKind): String {
    if kind == 'integer_kind' {
        return "int32_t"
    }
    if kind == 'long_kind' {
        return "int64_t"
    }
    if kind == 'float_kind' {
        return "float"
    }
    if kind == 'double_kind' {
        return "double"
    }
    return "bool"
}

func type_label(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        if scalar.kind == 'integer_kind' {
            return "Int"
        }
        if scalar.kind == 'long_kind' {
            return "Long"
        }
        if scalar.kind == 'float_kind' {
            return "Float"
        }
        if scalar.kind == 'double_kind' {
            return "Double"
        }
        return "Bool"
    }
    if type_shape.as_string(spite_type) {
        return "String"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return class_ref.c_name
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        return enum_type.c_name
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        return "List_" + type_label(list_type.get_element())
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return "Dictionary_" + type_label(dictionary_type.get_element())
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name
    }
    return "Value"
}

func ensure_nullable_scalar_typedef(inner: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(inner)
    crash scalar
    var label = type_label(inner)
    var struct_name = "Nullable_" + label
    if not nullable_scalar_labels.contains(label) {
        nullable_scalar_labels.append(label)
        builder.add_typedef(
            "typedef struct { bool has_value; " + numeric_c_name(scalar.kind) + " value; } " + struct_name + ";",
        )
    }
    return struct_name
}

func c_type_name(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return numeric_c_name(scalar.kind)
    }
    if type_shape.as_string(spite_type) {
        return "SpiteString*"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return class_ref.c_name + "*"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.get_inner()
        if type_is_reference(inner) {
            return c_type_name(inner)
        }
        return ensure_nullable_scalar_typedef(inner)
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        return enum_type.c_name
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        return ensure_list(list_type.get_element()) + "*"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return ensure_dictionary(dictionary_type.get_element()) + "*"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name
    }
    if type_shape.is_void(spite_type) {
        return "void"
    }
    if type_shape.is_arguments(spite_type) {
        return "SpiteArguments"
    }
    return "void*"
}

func default_value_for_type(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        if scalar.kind == 'boolean_kind' {
            return "false"
        }
        if scalar.kind == 'float_kind' {
            return "0.0"
        }
        if scalar.kind == 'double_kind' {
            return "0.0"
        }
        return "0"
    }
    if type_shape.as_string(spite_type) {
        return "(&spite_static_string_empty)"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return class_ref.c_name + "_default()"
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        return enum_type.c_name + "_" + enum_type.values.first()
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        return ensure_list(list_type.get_element()) + "_make()"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return ensure_dictionary(dictionary_type.get_element()) + "_make()"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var union_information = find_union_by_c_name(union_type.c_name)
        if union_information {
            return "((" + union_type.c_name + ")" + union_information.members.first().c_name + "_default())"
        }
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.get_inner()
        if type_is_reference(inner) {
            return "0"
        }
        var struct_name = ensure_nullable_scalar_typedef(inner)
        return "((" + struct_name + "){ .has_value = false, .value = " + default_value_for_type(inner) + " })"
    }
    return "0"
}

func is_float_kind(kind: Analysis.Types.NumericKind): Bool {
    if kind == 'float_kind' {
        return true
    }
    return kind == 'double_kind'
}

func string_conversion(code: String, from: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(from)
    if scalar {
        if scalar.kind == 'boolean_kind' {
            return "spite_string_from_bool(" + code + ")"
        }
        if scalar.kind == 'float_kind' {
            return "spite_string_from_float32(" + code + ")"
        }
        if scalar.kind == 'double_kind' {
            return "spite_string_from_float64(" + code + ")"
        }
        return "spite_string_from_int((int64_t)(" + code + "))"
    }
    var enum_type = type_shape.as_enum(from)
    if enum_type {
        return "spite_string_from_cstring_static(" + enum_type.c_name + "_name(" + code + "))"
    }
    return code
}

func cast(code: String, from: Analysis.SpiteType, to: Analysis.SpiteType): String {
    if types_equal(from, to) {
        return code
    }
    var to_nullable = type_shape.as_nullable(to)
    if to_nullable {
        var inner = to_nullable.get_inner()
        var inner_code = cast(code, from, inner)
        if type_is_reference(inner) {
            return inner_code
        }
        return "((" + c_type_name(to) + "){ .has_value = true, .value = " + inner_code + " })"
    }
    var to_union = type_shape.as_union(to)
    if to_union {
        return "((" + to_union.c_name + ")(" + code + "))"
    }
    if type_shape.as_string(to) {
        return string_conversion(code, from)
    }
    if type_shape.as_string(from) {
        var to_scalar = type_shape.as_scalar(to)
        if to_scalar {
            if is_float_kind(to_scalar.kind) {
                return "((" + c_type_name(to) + ")(SpiteString_to_float(" + code + ")))"
            }
            return "((" + c_type_name(to) + ")(SpiteString_to_int(" + code + ")))"
        }
    }
    var to_scalar_plain = type_shape.as_scalar(to)
    if to_scalar_plain {
        return "((" + c_type_name(to) + ")(" + code + "))"
    }
    return code
}

func retain_call(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return class_ref.c_name + "_retain(" + code + ")"
    }
    if type_shape.as_string(spite_type) {
        return "SpiteString_retain(" + code + ")"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        return ensure_list(list_type.get_element()) + "_retain(" + code + ")"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return ensure_dictionary(dictionary_type.get_element()) + "_retain(" + code + ")"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name + "_retain(" + code + ")"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        return retain_call(nullable.get_inner(), code)
    }
    return code
}

func release_call(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return class_ref.c_name + "_release(" + code + ")"
    }
    if type_shape.as_string(spite_type) {
        return "SpiteString_release(" + code + ")"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        return ensure_list(list_type.get_element()) + "_release(" + code + ")"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return ensure_dictionary(dictionary_type.get_element()) + "_release(" + code + ")"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name + "_release(" + code + ")"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        return release_call(nullable.get_inner(), code)
    }
    return code
}

func owns(result: ExpressionResult, expression: Syntax.Expressions.Expression): Bool {
    var stated = result.owning_override
    if stated {
        return stated
    }
    return is_owning_shape(expression)
}

func is_owning_shape(expression: Syntax.Expressions.Expression): Bool {
    var identifier = shape.as_identifier(expression)
    if identifier {
        return false
    }
    var indexed = shape.as_index(expression)
    if indexed {
        if is_bound_attributes_index(indexed) {
            return false
        }
    }
    var member = shape.as_member(expression)
    if member {
        if member.name == "class" or member.name == "attributes" {
            return true
        }
        var object_ast = member.object
        crash object_ast
        var object_identifier = shape.as_identifier(object_ast)
        if object_identifier {
            if arguments_parameter_names.contains(object_identifier.name) {
                return true
            }
        }
        return is_owning_shape(object_ast)
    }
    return true
}

func coerce_for_store(expression_ast: Syntax.Expressions.Expression, expected_type: Analysis.SpiteType, scope: Scope, class_information: Analysis.ClassInfo): String {
    if shape.is_null_literal(expression_ast) {
        return default_value_for_type(expected_type)
    }
    var list_literal = shape.as_list_literal(expression_ast)
    if list_literal {
        var expected_list = type_shape.as_list(expected_type_without_nullable(expected_type))
        if expected_list {
            var literal_result = generate_list_literal(
                list_literal,
                expected_list.get_element(),
                scope,
                class_information,
            )
            return literal_result.code
        }
    }
    var enum_literal = shape.as_enum_literal(expression_ast)
    if enum_literal {
        var expected_enum = expected_enum_of(expected_type)
        if expected_enum {
            return cast(
                enum_value_code(enum_literal, expected_enum),
                expected_type_without_nullable(expected_type),
                expected_type,
            )
        }
    }
    var result = generate_expression(expression_ast, scope, class_information)
    var casted = cast(result.code, result.get_type(), expected_type)
    if type_needs_drop(expected_type) {
        if owns(result, expression_ast) {
            return casted
        }
        return retain_call(expected_type, casted)
    }
    return casted
}

func expected_type_without_nullable(expected_type: Analysis.SpiteType): Analysis.SpiteType {
    var nullable = type_shape.as_nullable(expected_type)
    if nullable {
        return nullable.get_inner()
    }
    return expected_type
}

func is_enum_literal(expression: Syntax.Expressions.Expression): Bool {
    if shape.as_enum_literal(expression) {
        return true
    }
    return false
}

func is_enum_type(spite_type: Analysis.SpiteType): Bool {
    if type_shape.as_enum(spite_type) {
        return true
    }
    return false
}

func expected_enum_of(expected_type: Analysis.SpiteType): Nullable<Analysis.Types.EnumType> {
    return type_shape.as_enum(expected_type_without_nullable(expected_type))
}

func next_temporary(): String {
    temporary_counter = temporary_counter + 1
    return "spite_temp_" + temporary_counter
}

func hex_digit(value: Int): String {
    var digits = "0123456789abcdef"
    return digits.character_at(value)
}

func hex_escape(code: Int): String {
    var high = code / 16
    var low = code % 16
    return "\\x" + hex_digit(high) + hex_digit(low)
}

func escape_c_string(value: String): String {
    var result = ""
    var index = 0
    while index < value.length() {
        var code = value.code_at(index)
        if code == 34 {
            result = result + "\\\""
        } else if code == 92 {
            result = result + "\\\\"
        } else if code == 10 {
            result = result + "\\n"
        } else if code == 13 {
            result = result + "\\r"
        } else if code == 9 {
            result = result + "\\t"
        } else if code < 32 or code > 126 {
            result = result + hex_escape(code)
        } else {
            result = result + value.character_at(index)
        }
        index = index + 1
    }
    return result
}

func render_string_literal(value: String): String {
    literal_counter = literal_counter + 1
    var literal_name = "spite_lit_" + literal_counter
    var escaped = escape_c_string(value)
    builder.add_typedef(
        "static SpiteString " + literal_name + " = SPITE_STATIC_STRING(\"" + escaped + "\", " + ("" + value.length()) + ");",
    )
    return "(&" + literal_name + ")"
}

func lookup_static_type(expression: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo): Nullable<Analysis.SpiteType> {
    var identifier = shape.as_identifier(expression)
    if not identifier {
        return null
    }
    assert identifier
    if identifier.name == "self" {
        var self_type: Analysis.SpiteType = Analysis.Types.ClassRefType(class_information.c_name)
        return self_type
    }
    var scope_type = scope.lookup_type(identifier.name)
    if scope_type {
        return scope_type
    }
    var field = class_information.find_field(identifier.name)
    if field {
        return field.get_type()
    }
    return null
}

func generate_integer_literal(literal: Syntax.Expressions.IntegerLiteral): ExpressionResult {
    var value = literal.value
    if value >= -2147483648 and value <= 2147483647 {
        return ExpressionResult("" + value, Analysis.Types.ScalarType('integer_kind'))
    }
    return ExpressionResult("" + value, Analysis.Types.ScalarType('long_kind'))
}

func generate_identifier(identifier: Syntax.Expressions.IdentifierExpression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    if identifier.name == "self" {
        return ExpressionResult("self", Analysis.Types.ClassRefType(class_information.c_name))
    }
    var override = scope.lookup_override(identifier.name)
    var scope_type = scope.lookup_type(identifier.name)
    if scope_type {
        if override {
            return ExpressionResult(override, scope_type)
        }
        return ExpressionResult(identifier.name, scope_type)
    }
    var field = class_information.find_field(identifier.name)
    if field {
        return ExpressionResult("self->" + identifier.name, field.get_type())
    }
    report("unknown identifier '" + identifier.name + "'")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func is_boolean_result_operator(operator: Syntax.Expressions.BinaryOperator): Bool {
    if operator == 'add' {
        return false
    }
    if operator == 'subtract' {
        return false
    }
    if operator == 'multiply' {
        return false
    }
    if operator == 'divide' {
        return false
    }
    if operator == 'modulo' {
        return false
    }
    return true
}

func binary_operator_symbol(operator: Syntax.Expressions.BinaryOperator): String {
    if operator == 'add' {
        return "+"
    }
    if operator == 'subtract' {
        return "-"
    }
    if operator == 'multiply' {
        return "*"
    }
    if operator == 'divide' {
        return "/"
    }
    if operator == 'modulo' {
        return "%"
    }
    if operator == 'equal' {
        return "=="
    }
    if operator == 'not_equal' {
        return "!="
    }
    if operator == 'less' {
        return "<"
    }
    if operator == 'less_equal' {
        return "<="
    }
    if operator == 'greater' {
        return ">"
    }
    if operator == 'greater_equal' {
        return ">="
    }
    if operator == 'logical_and' {
        return "&&"
    }
    return "||"
}

func generate_string_binary(operator: Syntax.Expressions.BinaryOperator, left_result: ExpressionResult, left_ast: Syntax.Expressions.Expression, right_ast: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var right_result = generate_expression(right_ast, scope, class_information)
    var right_code_casted = cast(right_result.code, right_result.get_type(), Analysis.Types.StringType())
    var left_temporary = next_temporary()
    var right_temporary = next_temporary()
    var lines = List<String>()
    lines.append("SpiteString* " + left_temporary + " = " + left_result.code + ";")
    lines.append("SpiteString* " + right_temporary + " = " + right_code_casted + ";")

    var result_type: Analysis.SpiteType = Analysis.Types.StringType()
    var combine = ""
    if operator == 'add' {
        combine = "SpiteString_concat(" + left_temporary + ", " + right_temporary + ")"
    } else {
        result_type = Analysis.Types.ScalarType('boolean_kind')
        if operator == 'equal' {
            combine = "SpiteString_equals(" + left_temporary + ", " + right_temporary + ")"
        } else if operator == 'not_equal' {
            combine = "(!(SpiteString_equals(" + left_temporary + ", " + right_temporary + ")))"
        } else if operator == 'less' {
            combine = "SpiteString_less(" + left_temporary + ", " + right_temporary + ")"
        } else if operator == 'greater' {
            combine = "SpiteString_greater(" + left_temporary + ", " + right_temporary + ")"
        } else if operator == 'less_equal' {
            combine = "(!(SpiteString_greater(" + left_temporary + ", " + right_temporary + ")))"
        } else {
            combine = "(!(SpiteString_less(" + left_temporary + ", " + right_temporary + ")))"
        }
    }

    var result_temporary = next_temporary()
    lines.append(c_type_name(result_type) + " " + result_temporary + " = " + combine + ";")
    if owns(left_result, left_ast) {
        lines.append("SpiteString_release(" + left_temporary + ");")
    }
    var right_was_converted = not type_shape.as_string(right_result.get_type())
    if owns(right_result, right_ast) or right_was_converted {
        lines.append("SpiteString_release(" + right_temporary + ");")
    }
    lines.append(result_temporary + ";")
    return ExpressionResult("({ " + lines.join(" ") + " })", result_type)
}

func generate_binary(binary: Syntax.Expressions.BinaryExpression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var left_ast = binary.left
    crash left_ast
    var right_ast = binary.right
    crash right_ast
    if is_enum_literal(left_ast) and not is_enum_literal(right_ast) {
        var swapped_right = generate_expression(right_ast, scope, class_information)
        var swapped_left_code = coerce_for_store(left_ast, swapped_right.get_type(), scope, class_information)
        var swapped_code = "(" + swapped_left_code + " " + binary_operator_symbol(binary.operator) + " " + swapped_right.code + ")"
        return ExpressionResult(swapped_code, Analysis.Types.ScalarType('boolean_kind'))
    }
    var left = generate_expression(left_ast, scope, class_information)
    if type_shape.as_string(left.get_type()) {
        return generate_string_binary(binary.operator, left, left_ast, right_ast, scope, class_information)
    }
    var right_code = ""
    if is_enum_literal(right_ast) and is_enum_type(left.get_type()) {
        right_code = coerce_for_store(right_ast, left.get_type(), scope, class_information)
    } else {
        var right = generate_expression(right_ast, scope, class_information)
        right_code = cast(right.code, right.get_type(), left.get_type())
    }
    var symbol = binary_operator_symbol(binary.operator)
    var code = "(" + left.code + " " + symbol + " " + right_code + ")"
    if is_boolean_result_operator(binary.operator) {
        return ExpressionResult(code, Analysis.Types.ScalarType('boolean_kind'))
    }
    return ExpressionResult(code, left.get_type())
}

func generate_unary(unary: Syntax.Expressions.UnaryExpression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var operand_ast = unary.operand
    crash operand_ast
    var operand = generate_expression(operand_ast, scope, class_information)
    if unary.operator == 'negate' {
        return ExpressionResult("(-(" + operand.code + "))", operand.get_type())
    }
    return ExpressionResult("(!(" + operand.code + "))", Analysis.Types.ScalarType('boolean_kind'))
}

func generate_argument_list(arguments_ast: List<Syntax.Expressions.Expression>, expected_types: List<Analysis.SpiteType>, scope: Scope, class_information: Analysis.ClassInfo): List<String> {
    var result = List<String>()
    var index = 0
    while index < arguments_ast.count() {
        result.append(coerce_for_store(arguments_ast[index], expected_types[index], scope, class_information))
        index = index + 1
    }
    return result
}

func parameter_types_of(parameters: List<Analysis.ParamInfo>): List<Analysis.SpiteType> {
    var result = List<Analysis.SpiteType>()
    var index = 0
    while index < parameters.count() {
        result.append(parameters[index].get_type())
        index = index + 1
    }
    return result
}

func generate_constructor_call(target_class: Analysis.ClassInfo, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var expected_types = List<Analysis.SpiteType>()
    var constructor = target_class.constructor
    if constructor {
        expected_types = parameter_types_of(constructor.parameters)
    }
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    var call_code = target_class.c_name + "_make(" + argument_codes.join(", ") + ")"
    return ExpressionResult(call_code, Analysis.Types.ClassRefType(target_class.c_name))
}

func generate_own_function_call(name: String, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var function = find_or_instantiate_function(class_information, name)
    if not function {
        report("unknown function '" + name + "'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash function
    var argument_codes = generate_argument_list(
        arguments_ast,
        parameter_types_of(function.parameters),
        scope,
        class_information,
    )
    var full_arguments = List<String>()
    full_arguments.append("self")
    var index = 0
    while index < argument_codes.count() {
        full_arguments.append(argument_codes[index])
        index = index + 1
    }
    return ExpressionResult(function.c_name + "(" + full_arguments.join(", ") + ")", function.get_return_type())
}

func generate_generic_call(function_c_name: String, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, expected_types: List<Analysis.SpiteType>, return_type: Analysis.SpiteType, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    if owns(object_result, object_ast) {
        var object_temporary = next_temporary()
        var lines = List<String>()
        lines.append(c_type_name(object_result.get_type()) + " " + object_temporary + " = " + object_result.code + ";")
        var full_arguments = List<String>()
        full_arguments.append(object_temporary)
        var index = 0
        while index < argument_codes.count() {
            full_arguments.append(argument_codes[index])
            index = index + 1
        }
        var call_code = function_c_name + "(" + full_arguments.join(", ") + ")"
        if type_shape.is_void(return_type) {
            lines.append(call_code + ";")
            lines.append(release_call(object_result.get_type(), object_temporary) + ";")
            return ExpressionResult("({ " + lines.join(" ") + " })", return_type)
        }
        var call_temporary = next_temporary()
        lines.append(c_type_name(return_type) + " " + call_temporary + " = " + call_code + ";")
        lines.append(release_call(object_result.get_type(), object_temporary) + ";")
        lines.append(call_temporary + ";")
        return ExpressionResult("({ " + lines.join(" ") + " })", return_type)
    }
    var full_arguments = List<String>()
    full_arguments.append(object_result.code)
    var index = 0
    while index < argument_codes.count() {
        full_arguments.append(argument_codes[index])
        index = index + 1
    }
    return ExpressionResult(function_c_name + "(" + full_arguments.join(", ") + ")", return_type)
}

func generate_method_call(member: Syntax.Expressions.MemberExpression, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var object_result = generate_expression(object_ast, scope, class_information)
    if type_shape.as_string(object_result.get_type()) {
        return generate_string_method(member.name, object_result, object_ast, arguments_ast, scope, class_information)
    }
    if type_shape.is_arguments(object_result.get_type()) {
        if member.name == "count" {
            return ExpressionResult("((int32_t)SpiteArguments_count(&(" + object_result.code + ")))", integer_type())
        }
        if member.name == "get" and arguments_ast.count() == 1 {
            var position = coerce_for_store(arguments_ast[0], integer_type(), scope, class_information)
            return ExpressionResult(
                "SpiteArguments_get(&(" + object_result.code + "), " + position + ")",
                string_type(),
            )
        }
        report("Arguments has no method '" + member.name + "'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var object_union = type_shape.as_union(object_result.get_type())
    if object_union {
        var union_information = find_union_by_c_name(object_union.c_name)
        crash union_information
        return generate_union_dispatch(
            union_information,
            member.name,
            true,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_dictionary = type_shape.as_dictionary(object_result.get_type())
    if object_dictionary {
        return generate_dictionary_method(
            object_dictionary.get_element(),
            member.name,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_list = type_shape.as_list(object_result.get_type())
    if object_list {
        return generate_list_method(
            object_list.get_element(),
            member.name,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_class_ref = type_shape.as_class_ref(object_result.get_type())
    if not object_class_ref {
        report("method call on a value that is not a class instance")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash object_class_ref
    var target_class = find_class_by_c_name(object_class_ref.c_name)
    crash target_class
    var function = find_or_instantiate_function(target_class, member.name)
    if not function {
        if member.name == "copy" {
            return generate_generic_call(
                object_class_ref.c_name + "_copy",
                object_result,
                object_ast,
                arguments_ast,
                List<Analysis.SpiteType>(),
                Analysis.Types.ClassRefType(object_class_ref.c_name),
                scope,
                class_information,
            )
        }
        report("'" + object_class_ref.c_name + "' does not define '" + member.name + "'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash function
    return generate_generic_call(
        function.c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types_of(function.parameters),
        function.get_return_type(),
        scope,
        class_information,
    )
}

func generate_borrowing_call(function_c_name: String, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, expected_types: List<Analysis.SpiteType>, return_type: Analysis.SpiteType, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var lines = List<String>()
    var releases = List<String>()
    var full_arguments = List<String>()
    if owns(object_result, object_ast) {
        var object_temporary = next_temporary()
        lines.append(c_type_name(object_result.get_type()) + " " + object_temporary + " = " + object_result.code + ";")
        releases.append(release_call(object_result.get_type(), object_temporary) + ";")
        full_arguments.append(object_temporary)
    } else {
        full_arguments.append(object_result.code)
    }
    var index = 0
    while index < arguments_ast.count() {
        var argument_code = coerce_for_store(arguments_ast[index], expected_types[index], scope, class_information)
        if type_needs_drop(expected_types[index]) {
            var argument_temporary = next_temporary()
            lines.append(c_type_name(expected_types[index]) + " " + argument_temporary + " = " + argument_code + ";")
            releases.append(release_call(expected_types[index], argument_temporary) + ";")
            full_arguments.append(argument_temporary)
        } else {
            full_arguments.append(argument_code)
        }
        index = index + 1
    }
    var result_temporary = next_temporary()
    lines.append(
        c_type_name(return_type) + " " + result_temporary + " = " + function_c_name + "(" + full_arguments.join(", ") + ");",
    )
    lines.append(releases.join(" "))
    lines.append(result_temporary + ";")
    return ExpressionResult("({ " + lines.join(" ") + " })", return_type)
}

func generate_string_method(name: String, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var function_c_name = "SpiteString_" + name
    if name == "length" or name == "code_at" or name == "index_of" {
        var integer_parameters = no_types()
        if name == "code_at" {
            integer_parameters = one_type(integer_type())
        }
        if name == "index_of" {
            integer_parameters = one_type(string_type())
        }
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            integer_parameters,
            integer_type(),
            scope,
            class_information,
        )
    }
    if name == "is_empty" {
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            boolean_type(),
            scope,
            class_information,
        )
    }
    if name == "trim" or name == "upper" or name == "lower" {
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            string_type(),
            scope,
            class_information,
        )
    }
    if name == "to_int" {
        return generate_borrowing_call(
            "SpiteString_to_int",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            integer_type(),
            scope,
            class_information,
        )
    }
    if name == "to_long" {
        return generate_borrowing_call(
            "SpiteString_to_int",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            long_type(),
            scope,
            class_information,
        )
    }
    if name == "to_float" {
        return generate_borrowing_call(
            "SpiteString_to_float",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            float_type(),
            scope,
            class_information,
        )
    }
    if name == "to_double" {
        return generate_borrowing_call(
            "SpiteString_to_float",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            double_type(),
            scope,
            class_information,
        )
    }
    if name == "character_at" {
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            one_type(integer_type()),
            string_type(),
            scope,
            class_information,
        )
    }
    if name == "slice" {
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            two_types(integer_type(), integer_type()),
            string_type(),
            scope,
            class_information,
        )
    }
    if name == "contains" or name == "starts_with" or name == "ends_with" {
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            one_type(string_type()),
            boolean_type(),
            scope,
            class_information,
        )
    }
    if name == "replace" {
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            two_types(string_type(), string_type()),
            string_type(),
            scope,
            class_information,
        )
    }
    if name == "split" {
        ensure_list(string_type())
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            one_type(string_type()),
            list_type_of(string_type()),
            scope,
            class_information,
        )
    }
    if name == "lines" {
        ensure_list(string_type())
        return generate_borrowing_call(
            function_c_name,
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            list_type_of(string_type()),
            scope,
            class_information,
        )
    }
    report("String has no method '" + name + "'")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func generate_list_method(element: Analysis.SpiteType, name: String, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var list_name = ensure_list(element)
    if name == "append" {
        return generate_generic_call(
            list_name + "_add",
            object_result,
            object_ast,
            arguments_ast,
            one_type(element),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "prepend" {
        return generate_generic_call(
            list_name + "_prepend",
            object_result,
            object_ast,
            arguments_ast,
            one_type(element),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "insert" {
        return generate_generic_call(
            list_name + "_insert",
            object_result,
            object_ast,
            arguments_ast,
            two_types(integer_type(), element),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "set_at" {
        return generate_generic_call(
            list_name + "_set",
            object_result,
            object_ast,
            arguments_ast,
            two_types(integer_type(), element),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "get_at" {
        return generate_generic_call(
            list_name + "_get",
            object_result,
            object_ast,
            arguments_ast,
            one_type(integer_type()),
            element,
            scope,
            class_information,
        )
    }
    if name == "remove_at" {
        return generate_generic_call(
            list_name + "_remove_at",
            object_result,
            object_ast,
            arguments_ast,
            one_type(integer_type()),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "clear" or name == "reverse" {
        return generate_generic_call(
            list_name + "_" + name,
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "is_empty" {
        return generate_generic_call(
            list_name + "_is_empty",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            boolean_type(),
            scope,
            class_information,
        )
    }
    if name == "first" or name == "last" or name == "remove_first" {
        return generate_generic_call(
            list_name + "_" + name,
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            element,
            scope,
            class_information,
        )
    }
    if name == "remove_last" {
        return generate_generic_call(
            list_name + "_pop",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            element,
            scope,
            class_information,
        )
    }
    if name == "count" {
        var counted = generate_generic_call(
            list_name + "_count",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            integer_type(),
            scope,
            class_information,
        )
        return ExpressionResult("((int32_t)(" + counted.code + "))", integer_type())
    }
    if name == "contains" {
        return generate_borrowing_call(
            list_name + "_contains",
            object_result,
            object_ast,
            arguments_ast,
            one_type(element),
            boolean_type(),
            scope,
            class_information,
        )
    }
    if name == "join" {
        return generate_borrowing_call(
            list_name + "_join",
            object_result,
            object_ast,
            arguments_ast,
            one_type(string_type()),
            string_type(),
            scope,
            class_information,
        )
    }
    var element_class_ref = type_shape.as_class_ref(element)
    if element_class_ref {
        var element_class = find_class_by_c_name(element_class_ref.c_name)
        if element_class {
            var template_prefixes = ["find_by_", "sort_by_", "filter_", "count_", "sum_", "each_", "map_", "any_", "all_"]
            var prefix_index = 0
            while prefix_index < template_prefixes.count() {
                var template_prefix = template_prefixes[prefix_index]
                if name.starts_with(template_prefix) and name.length() > template_prefix.length() {
                    var member_name = name.slice(template_prefix.length(), name.length())
                    return generate_list_template(element, element_class, list_name, template_prefix, member_name, object_result, object_ast, arguments_ast, scope, class_information)
                }
                prefix_index = prefix_index + 1
            }
        }
    }
    report("List has no method '" + name + "'")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func member_type_of(element_class: Analysis.ClassInfo, member_name: String): Nullable<Analysis.SpiteType> {
    var field = element_class.find_field(member_name)
    if field {
        return field.get_type()
    }
    var function = find_or_instantiate_function(element_class, member_name)
    if function {
        if function.parameters.count() == 0 {
            return function.get_return_type()
        }
    }
    return null
}

func member_is_function(element_class: Analysis.ClassInfo, member_name: String): Bool {
    if element_class.find_field(member_name) {
        return false
    }
    return true
}

func member_read_code(element_class: Analysis.ClassInfo, member_name: String, item_code: String): String {
    if element_class.find_field(member_name) {
        return item_code + "->" + member_name
    }
    return element_class.c_name + "_" + member_name + "(" + item_code + ")"
}

func is_numeric_type(spite_type: Analysis.SpiteType): Bool {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return scalar.kind != 'boolean_kind'
    }
    return false
}

func is_boolean_type(spite_type: Analysis.SpiteType): Bool {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return scalar.kind == 'boolean_kind'
    }
    return false
}

func generate_list_template(element: Analysis.SpiteType, element_class: Analysis.ClassInfo, list_name: String, template_prefix: String, member_name: String, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var member_type = member_type_of(element_class, member_name)
    if not member_type {
        report("'" + element_class.simple_name + "' has no attribute or zero argument function '" + member_name + "' for '" + template_prefix + member_name + "'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash member_type
    var function_c_name = list_name + "_" + template_prefix + member_name
    var item = c_type_name(element)
    var member_c_type = c_type_name(member_type)
    var computed = member_is_function(element_class, member_name)
    var owned_member = computed and type_needs_drop(member_type)
    var read = member_c_type + " member = " + member_read_code(element_class, member_name, "item") + ";"
    var release_member = ""
    if owned_member {
        release_member = release_call(member_type, "member") + ";"
    }
    var loop_open = "for (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) {\n" + item + " item = self->items[spite_index];\n"
    var self_parameter = list_name + "* self"
    var requirement = ""
    var return_type = void_type()
    var parameter_types = no_types()
    var body = ""

    if template_prefix == "filter_" or template_prefix == "any_" or template_prefix == "all_" or template_prefix == "count_" {
        if not is_boolean_type(member_type) {
            requirement = "return Bool"
            if template_prefix == "count_" and is_numeric_type(member_type) {
                requirement = "return Bool (to add up a numeric member use 'sum_" + member_name + "')"
            }
        }
    }
    if template_prefix == "sum_" and not is_numeric_type(member_type) {
        requirement = "return a numeric type"
    }
    if template_prefix == "each_" and not computed {
        requirement = "be a function: reading an attribute and discarding it does nothing"
    }
    if not requirement.is_empty() {
        report("'" + template_prefix + member_name + "': the member '" + member_name + "' of '" + element_class.simple_name + "' is a " + type_label(member_type) + ", but '" + template_prefix + "' needs it to " + requirement)
        return ExpressionResult("0", Analysis.Types.VoidType())
    }

    if template_prefix == "filter_" {
        return_type = list_type_of(element)
        body = list_name + "* result = " + list_name + "_make();\n" + loop_open + read + "\nif (member) " + list_name + "_add(result, " + retain_call(element, "item") + ");\n}\nreturn result;"
    } else if template_prefix == "any_" {
        return_type = boolean_type()
        body = loop_open + read + "\nif (member) return true;\n}\nreturn false;"
    } else if template_prefix == "all_" {
        return_type = boolean_type()
        body = loop_open + read + "\nif (!member) return false;\n}\nreturn true;"
    } else if template_prefix == "count_" {
        return_type = integer_type()
        body = "int32_t result = 0;\n" + loop_open + read + "\nif (member) result = result + 1;\n}\nreturn result;"
    } else if template_prefix == "sum_" {
        return_type = member_type
        body = member_c_type + " result = 0;\n" + loop_open + read + "\nresult = result + member;\n}\nreturn result;"
    } else if template_prefix == "each_" {
        if type_shape.is_void(member_type) {
            body = loop_open + member_read_code(element_class, member_name, "item") + ";\n}"
        } else {
            body = loop_open + read + "\n" + release_member + "\n(void)member;\n}"
        }
    } else if template_prefix == "map_" {
        return_type = list_type_of(member_type)
        var mapped_list = ensure_list(member_type)
        var stored = "member"
        if type_needs_drop(member_type) and not computed {
            stored = retain_call(member_type, "member")
        }
        body = mapped_list + "* result = " + mapped_list + "_make();\n" + loop_open + read + "\n" + mapped_list + "_add(result, " + stored + ");\n}\nreturn result;"
    } else if template_prefix == "find_by_" {
        return_type = nullable_type_of(element)
        parameter_types = one_type(member_type)
        var equal = "member == value"
        if type_shape.as_string(member_type) {
            equal = "SpiteString_equals(member, value)"
        }
        var release_value = release_statement(member_type, "value")
        body = loop_open + read + "\nbool spite_found = " + equal + ";\n" + release_member + "\nif (spite_found) { " + release_value + " return " + retain_call(element, "item") + "; }\n}\n" + release_value + "\nreturn 0;"
    } else {
        return_type = list_type_of(element)
        var before = "keys[spite_inner - 1] > key"
        if type_shape.as_string(member_type) {
            before = "SpiteString_greater(keys[spite_inner - 1], key)"
        }
        var release_keys = ""
        if owned_member {
            release_keys = "for (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) { " + release_call(member_type, "keys[spite_index]") + "; }\n"
        }
        body = list_name + "* result = " + list_name + "_make();\n" + member_c_type + "* keys = (" + member_c_type + "*)SPITE_MALLOC(sizeof(" + member_c_type + ") * (size_t)(self->count + 1));\n" + loop_open + read + "\n" + list_name + "_add(result, " + retain_call(element, "item") + ");\nkeys[spite_index] = member;\n}\nfor (int64_t spite_outer = 1; spite_outer < self->count; spite_outer = spite_outer + 1) {\n" + member_c_type + " key = keys[spite_outer];\n" + item + " moved = result->items[spite_outer];\nint64_t spite_inner = spite_outer;\nwhile (spite_inner > 0 && " + before + ") {\nkeys[spite_inner] = keys[spite_inner - 1];\nresult->items[spite_inner] = result->items[spite_inner - 1];\nspite_inner = spite_inner - 1;\n}\nkeys[spite_inner] = key;\nresult->items[spite_inner] = moved;\n}\n" + release_keys + "SPITE_FREE(keys);\nreturn result;"
    }

    if not list_template_names.contains(function_c_name) {
        list_template_names.append(function_c_name)
        var signature = c_type_name(return_type) + " " + function_c_name + "(" + self_parameter
        if template_prefix == "find_by_" {
            signature = signature + ", " + member_c_type + " value"
        }
        signature = signature + ")"
        builder.add_prototype(signature + ";")
        builder.add_support(signature + " {\n" + body + "\n}")
    }
    return generate_generic_call(function_c_name, object_result, object_ast, arguments_ast, parameter_types, return_type, scope, class_information)
}

func ensure_class_object(display_name: String, namespace: String, label: String): String {
    var function_c_name = "spite_class_object_" + label
    if class_object_names.contains(function_c_name) {
        return function_c_name
    }
    if not find_class_by_c_name("Spite_Class") {
        report("reflection needs the standard library: library/spite/class.spite was not found from the working directory")
        return function_c_name
    }
    class_object_names.append(function_c_name)
    builder.add_typedef("static Spite_Class* " + function_c_name + "_cache = 0;")
    builder.add_prototype("Spite_Class* " + function_c_name + "(void);")
    builder.add_support("Spite_Class* " + function_c_name + "(void) {\nif (" + function_c_name + "_cache == 0) " + function_c_name + "_cache = Spite_Class_make(" + render_string_literal(display_name) + ", " + render_string_literal(namespace) + ");\nreturn Spite_Class_retain(" + function_c_name + "_cache);\n}")
    return function_c_name
}

func class_object_call(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return ensure_class_object(described.simple_name, described.namespace_dotted, described.c_name) + "()"
        }
    }
    var label = type_label(spite_type)
    return ensure_class_object(type_display_name(spite_type), "", label) + "()"
}

func type_display_name(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return described.simple_name
        }
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        var enum_index = 0
        while enum_index < enums.count() {
            if enums[enum_index].c_name == enum_type.c_name {
                return enums[enum_index].simple_name
            }
            enum_index = enum_index + 1
        }
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var union_information = find_union_by_c_name(union_type.c_name)
        if union_information {
            return union_information.simple_name
        }
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        return "List<" + type_display_name(list_type.get_element()) + ">"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        return "Dictionary<" + type_display_name(dictionary_type.get_element()) + ">"
    }
    var nullable_type = type_shape.as_nullable(spite_type)
    if nullable_type {
        return "Nullable<" + type_display_name(nullable_type.get_inner()) + ">"
    }
    return type_label(spite_type)
}


func spite_class_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType("Spite_Class")
    return resolved
}

func ensure_attributes_function(information: Analysis.ClassInfo): String {
    var function_c_name = information.c_name + "_attributes"
    if attributes_function_names.contains(function_c_name) {
        return function_c_name
    }
    attributes_function_names.append(function_c_name)
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        report("reflection needs the standard library: library/spite/attribute.spite was not found from the working directory")
        return function_c_name
    }
    crash attribute_class
    var list_name = ensure_list(class_type_of(attribute_class))
    var lines = List<String>()
    lines.append(list_name + "* " + function_c_name + "(" + information.c_name + "* self) {")
    lines.append(list_name + "* result = " + list_name + "_make();")
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        if not type_shape.is_console(field.get_type()) {
            var value_code = "(&spite_static_string_empty)"
            if type_shape.as_string(field.get_type()) {
                value_code = "SpiteString_retain(self->" + field.name + ")"
            } else if type_shape.as_scalar(field.get_type()) {
                value_code = string_conversion("self->" + field.name, field.get_type())
            } else if is_enum_type(field.get_type()) {
                value_code = string_conversion("self->" + field.name, field.get_type())
            }
            lines.append(list_name + "_add(result, Spite_Attribute_make(" + render_string_literal(field.name) + ", " + class_object_call(field.get_type()) + ", " + value_code + "));")
        }
        index = index + 1
    }
    lines.append("(void)self;")
    lines.append("return result;")
    lines.append("}")
    builder.add_prototype(list_name + "* " + function_c_name + "(" + information.c_name + "* self);")
    builder.add_support(lines.join("\n"))
    return function_c_name
}

func generate_reflection_read(member_name: String, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression): Nullable<ExpressionResult> {
    if member_name != "class" and member_name != "attributes" {
        return null
    }
    var object_type = object_result.get_type()
    var object_c_type = c_type_name(object_type)
    var owning_object = owns(object_result, object_ast) and type_needs_drop(object_type)
    var release_object = ""
    if owning_object {
        release_object = release_call(object_type, "spite_reflected") + ";"
    }
    var object_class_ref = type_shape.as_class_ref(object_type)
    if object_class_ref {
        var object_class = find_class_by_c_name(object_class_ref.c_name)
        if object_class {
            var real_field = object_class.find_field(member_name)
            if real_field {
                var retained_field = retain_call(real_field.get_type(), "spite_reflected->" + member_name)
                return ExpressionResult("({ " + object_c_type + " spite_reflected = " + object_result.code + "; " + c_type_name(real_field.get_type()) + " spite_reflected_value = " + retained_field + "; " + release_object + " spite_reflected_value; })", real_field.get_type())
            }
            if member_name == "attributes" {
                var attributes_function = ensure_attributes_function(object_class)
                var attribute_class = find_class_by_c_name("Spite_Attribute")
                if attribute_class {
                    var attributes_type = list_type_of(class_type_of(attribute_class))
                    return ExpressionResult("({ " + object_c_type + " spite_reflected = " + object_result.code + "; " + c_type_name(attributes_type) + " spite_reflected_value = " + attributes_function + "(spite_reflected); " + release_object + " spite_reflected_value; })", attributes_type)
                }
                return null
            }
        }
    }
    if member_name == "class" {
        if type_shape.is_void(object_type) {
            return null
        }
        return ExpressionResult("({ " + object_c_type + " spite_reflected = " + object_result.code + "; " + release_object + " (void)spite_reflected; " + class_object_call(object_type) + "; })", spite_class_type())
    }
    return null
}

func find_getter(target_class: Analysis.ClassInfo, attribute_name: String, calling_class: Analysis.ClassInfo): Nullable<Analysis.FunctionInfo> {
    if target_class.is_builtin {
        return null
    }
    if not target_class.find_field(attribute_name) {
        return null
    }
    var getter_name = "get_" + attribute_name
    if target_class.c_name == calling_class.c_name and current_function == getter_name {
        return null
    }
    var getter = find_or_instantiate_function(target_class, getter_name)
    if getter {
        if getter.parameters.count() == 0 {
            return getter
        }
    }
    return null
}

func find_setter(target_class: Analysis.ClassInfo, attribute_name: String, calling_class: Analysis.ClassInfo): Nullable<Analysis.FunctionInfo> {
    if target_class.is_builtin {
        return null
    }
    if not target_class.find_field(attribute_name) {
        return null
    }
    var setter_name = "set_" + attribute_name
    if target_class.c_name == calling_class.c_name and current_function == setter_name {
        return null
    }
    var setter = find_or_instantiate_function(target_class, setter_name)
    if setter {
        if setter.parameters.count() == 1 {
            return setter
        }
    }
    return null
}

func generate_list_literal(

literal: Syntax.Expressions.ListLiteralExpression, element: Analysis.SpiteType, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var list_name = ensure_list(element)
    var temporary = next_temporary()
    var lines = List<String>()
    lines.append(list_name + "* " + temporary + " = " + list_name + "_make();")
    var index = 0
    while index < literal.elements.count() {
        var element_ast = literal.elements[index].value
        crash element_ast
        lines.append(
            list_name + "_add(" + temporary + ", " + coerce_for_store(element_ast, element, scope, class_information) + ");",
        )
        index = index + 1
    }
    lines.append(temporary + ";")
    return ExpressionResult("({ " + lines.join(" ") + " })", list_type_of(element))
}

func generate_untyped_list_literal(literal: Syntax.Expressions.ListLiteralExpression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    if literal.elements.is_empty() {
        report("an empty list literal needs a declared type")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var first_ast = literal.elements[0].value
    crash first_ast
    var saved_counter = temporary_counter
    var probe = generate_expression(first_ast, scope, class_information)
    temporary_counter = saved_counter
    return generate_list_literal(literal, probe.get_type(), scope, class_information)
}

func generate_generic_constructor(generic_call: Syntax.Expressions.GenericCallExpression, class_information: Analysis.ClassInfo): ExpressionResult {
    var callee_ast = generic_call.callee
    crash callee_ast
    var callee = shape.as_identifier(callee_ast)
    if callee {
        if callee.name == "Dictionary" and generic_call.type_arguments.count() == 1 {
            var dictionary_element = resolve_generic_argument(
                generic_call.type_arguments[0],
                class_information.namespace_dotted,
            )
            if dictionary_element {
                return ExpressionResult(
                    ensure_dictionary(dictionary_element) + "_make()",
                    dictionary_type_of(dictionary_element),
                )
            }
        }
        if callee.name == "List" and generic_call.type_arguments.count() == 1 {
            var element = resolve_generic_argument(generic_call.type_arguments[0], class_information.namespace_dotted)
            if element {
                return ExpressionResult(ensure_list(element) + "_make()", list_type_of(element))
            }
        }
    }
    report("this generic constructor is not supported in this stage")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func generate_index_read(index_expression: Syntax.Expressions.IndexExpression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var object_ast = index_expression.object
    crash object_ast
    var index_ast = index_expression.index
    crash index_ast
    if is_bound_attributes_index(index_expression) {
        var bound_type = bound_field_type
        crash bound_type
        return ExpressionResult("self->" + bound_field_name, bound_type)
    }
    var object_result = generate_expression(object_ast, scope, class_information)
    var arguments_ast = List<Syntax.Expressions.Expression>()
    arguments_ast.append(index_ast)
    var object_list = type_shape.as_list(object_result.get_type())
    if object_list {
        var element = object_list.get_element()
        return generate_generic_call(
            ensure_list(element) + "_get",
            object_result,
            object_ast,
            arguments_ast,
            one_type(integer_type()),
            element,
            scope,
            class_information,
        )
    }
    var object_dictionary = type_shape.as_dictionary(object_result.get_type())
    if object_dictionary {
        var value_type = object_dictionary.get_element()
        var lookup = generate_generic_call(
            ensure_dictionary(value_type) + "_get",
            object_result,
            object_ast,
            arguments_ast,
            one_type(string_type()),
            nullable_type_of(value_type),
            scope,
            class_information,
        )
        var lookup_temporary = next_temporary()
        var lookup_declaration = c_type_name(nullable_type_of(value_type)) + " " + lookup_temporary + " = " + lookup.code + ";"
        if type_is_reference(value_type) {
            return ExpressionResult(
                "({ " + lookup_declaration + " " + lookup_temporary + " != 0 ? " + lookup_temporary + " : " + default_value_for_type(
                    value_type,
                ) + "; })",
                value_type,
            )
        }
        return ExpressionResult(
            "({ " + lookup_declaration + " " + lookup_temporary + ".has_value ? " + lookup_temporary + ".value : " + default_value_for_type(
                value_type,
            ) + "; })",
            value_type,
        )
    }
    report("this value cannot be indexed")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func ensure_list(element: Analysis.SpiteType): String {
    var list_name = "List_" + type_label(element)
    if list_names.contains(list_name) {
        return list_name
    }
    list_names.append(list_name)
    support_class_names.append(list_name)
    emit_list_support(list_name, element, classes.count() + support_class_names.count())
    return list_name
}

func ensure_dictionary(element: Analysis.SpiteType): String {
    var dictionary_name = "Dictionary_" + type_label(element)
    if dictionary_names.contains(dictionary_name) {
        return dictionary_name
    }
    dictionary_names.append(dictionary_name)
    support_class_names.append(dictionary_name)
    emit_dictionary_support(dictionary_name, element, classes.count() + support_class_names.count())
    return dictionary_name
}

func dictionary_type_of(element: Analysis.SpiteType): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.DictionaryType(element)
    return resolved
}

func nullable_type_of(inner: Analysis.SpiteType): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.NullableType(inner)
    return resolved
}

func emit_dictionary_support(dictionary_name: String, element: Analysis.SpiteType, class_id: Int) {
    var item = c_type_name(element)
    var nullable_item = c_type_name(nullable_type_of(element))
    var self_parameter = dictionary_name + "* self"
    var keys_list = ensure_list(string_type())
    var values_list = ensure_list(element)
    var lookup = "int64_t existing_index = " + dictionary_name + "_index_of_key(self, key);"
    builder.add_typedef(
        "typedef struct " + dictionary_name + " " + dictionary_name + ";\nstruct " + dictionary_name + " {\nSpiteHeader header;\nSpiteString** keys;\n" + item + "* values;\nint64_t count;\nint64_t capacity;\n};",
    )

    builder.add_prototype(dictionary_name + "* " + dictionary_name + "_make(void);")
    builder.add_support(
        dictionary_name + "* " + dictionary_name + "_make(void) {\n" + dictionary_name + "* dictionary = (" + dictionary_name + "*)SPITE_MALLOC(sizeof(" + dictionary_name + "));\ndictionary->header.ref_count = 1;\ndictionary->header.class_id = " + class_id + ";\n#ifdef SPITE_DEBUG_MEMORY\nspite_debug_register_object(dictionary, " + class_id + ");\n#endif\ndictionary->keys = 0;\ndictionary->values = 0;\ndictionary->count = 0;\ndictionary->capacity = 0;\nreturn dictionary;\n}",
    )

    builder.add_prototype(dictionary_name + "* " + dictionary_name + "_retain(" + self_parameter + ");")
    builder.add_support(
        dictionary_name + "* " + dictionary_name + "_retain(" + self_parameter + ") {\nif (self != 0) self->header.ref_count = self->header.ref_count + 1;\nreturn self;\n}",
    )

    builder.add_prototype("void " + dictionary_name + "_release(" + self_parameter + ");")
    builder.add_support(
        "void " + dictionary_name + "_release(" + self_parameter + ") {\nif (self == 0) return;\nself->header.ref_count = self->header.ref_count - 1;\nif (self->header.ref_count > 0) return;\nfor (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) {\nSpiteString_release(self->keys[spite_index]);\n" + release_statement(
            element,
            "self->values[spite_index]",
        ) + "\n}\nSPITE_FREE(self->keys);\nSPITE_FREE(self->values);\nSPITE_FREE(self);\n}",
    )

    builder.add_prototype("int64_t " + dictionary_name + "_index_of_key(" + self_parameter + ", SpiteString* key);")
    builder.add_support(
        "int64_t " + dictionary_name + "_index_of_key(" + self_parameter + ", SpiteString* key) {\nfor (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) {\nif (SpiteString_equals(self->keys[spite_index], key)) return spite_index;\n}\nreturn -1;\n}",
    )

    builder.add_prototype(
        "void " + dictionary_name + "_set(" + self_parameter + ", SpiteString* key, " + item + " value);",
    )
    builder.add_support(
        "void " + dictionary_name + "_set(" + self_parameter + ", SpiteString* key, " + item + " value) {\n" + lookup + "\nif (existing_index >= 0) {\n" + release_statement(
            element,
            "self->values[existing_index]",
        ) + "\nSpiteString_release(self->keys[existing_index]);\nself->keys[existing_index] = key;\nself->values[existing_index] = value;\nreturn;\n}\nif (self->count == self->capacity) {\nint64_t new_capacity = self->capacity == 0 ? 4 : self->capacity * 2;\nself->keys = (SpiteString**)SPITE_REALLOC(self->keys, (size_t)new_capacity * sizeof(SpiteString*));\nself->values = (" + item + "*)SPITE_REALLOC(self->values, (size_t)new_capacity * sizeof(" + item + "));\nself->capacity = new_capacity;\n}\nself->keys[self->count] = key;\nself->values[self->count] = value;\nself->count = self->count + 1;\n}",
    )

    var missing_value = "0"
    var found_value = retain_call(element, "self->values[existing_index]")
    if not type_is_reference(element) {
        missing_value = "(" + nullable_item + "){ .has_value = false, .value = " + default_value_for_type(element) + " }"
        found_value = "(" + nullable_item + "){ .has_value = true, .value = self->values[existing_index] }"
    }
    builder.add_prototype(nullable_item + " " + dictionary_name + "_get(" + self_parameter + ", SpiteString* key);")
    builder.add_support(
        nullable_item + " " + dictionary_name + "_get(" + self_parameter + ", SpiteString* key) {\n" + lookup + "\nSpiteString_release(key);\nif (existing_index < 0) return " + missing_value + ";\nreturn " + found_value + ";\n}",
    )

    builder.add_prototype("bool " + dictionary_name + "_has(" + self_parameter + ", SpiteString* key);")
    builder.add_support(
        "bool " + dictionary_name + "_has(" + self_parameter + ", SpiteString* key) {\nbool spite_found = " + dictionary_name + "_index_of_key(self, key) >= 0;\nSpiteString_release(key);\nreturn spite_found;\n}",
    )

    builder.add_prototype("void " + dictionary_name + "_remove(" + self_parameter + ", SpiteString* key);")
    builder.add_support(
        "void " + dictionary_name + "_remove(" + self_parameter + ", SpiteString* key) {\n" + lookup + "\nSpiteString_release(key);\nif (existing_index < 0) return;\n" + release_statement(
            element,
            "self->values[existing_index]",
        ) + "\nSpiteString_release(self->keys[existing_index]);\nfor (int64_t spite_index = existing_index; spite_index < self->count - 1; spite_index = spite_index + 1) {\nself->keys[spite_index] = self->keys[spite_index + 1];\nself->values[spite_index] = self->values[spite_index + 1];\n}\nself->count = self->count - 1;\n}",
    )

    builder.add_prototype("int64_t " + dictionary_name + "_count(" + self_parameter + ");")
    builder.add_support("int64_t " + dictionary_name + "_count(" + self_parameter + ") {\nreturn self->count;\n}")

    builder.add_prototype(keys_list + "* " + dictionary_name + "_keys(" + self_parameter + ");")
    builder.add_support(
        keys_list + "* " + dictionary_name + "_keys(" + self_parameter + ") {\n" + keys_list + "* result = " + keys_list + "_make();\nfor (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) { " + keys_list + "_add(result, SpiteString_retain(self->keys[spite_index])); }\nreturn result;\n}",
    )

    builder.add_prototype(values_list + "* " + dictionary_name + "_values(" + self_parameter + ");")
    builder.add_support(
        values_list + "* " + dictionary_name + "_values(" + self_parameter + ") {\n" + values_list + "* result = " + values_list + "_make();\nfor (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) { " + values_list + "_add(result, " + retain_call(
            element,
            "self->values[spite_index]",
        ) + "); }\nreturn result;\n}",
    )
}

func generate_dictionary_method(element: Analysis.SpiteType, name: String, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var dictionary_name = ensure_dictionary(element)
    if name == "set" {
        return generate_generic_call(
            dictionary_name + "_set",
            object_result,
            object_ast,
            arguments_ast,
            two_types(string_type(), element),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "get" {
        return generate_generic_call(
            dictionary_name + "_get",
            object_result,
            object_ast,
            arguments_ast,
            one_type(string_type()),
            nullable_type_of(element),
            scope,
            class_information,
        )
    }
    if name == "has" {
        return generate_generic_call(
            dictionary_name + "_has",
            object_result,
            object_ast,
            arguments_ast,
            one_type(string_type()),
            boolean_type(),
            scope,
            class_information,
        )
    }
    if name == "remove" {
        return generate_generic_call(
            dictionary_name + "_remove",
            object_result,
            object_ast,
            arguments_ast,
            one_type(string_type()),
            void_type(),
            scope,
            class_information,
        )
    }
    if name == "count" {
        var counted = generate_generic_call(
            dictionary_name + "_count",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            integer_type(),
            scope,
            class_information,
        )
        return ExpressionResult("((int32_t)(" + counted.code + "))", integer_type())
    }
    if name == "keys" {
        return generate_generic_call(
            dictionary_name + "_keys",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            list_type_of(string_type()),
            scope,
            class_information,
        )
    }
    if name == "values" {
        return generate_generic_call(
            dictionary_name + "_values",
            object_result,
            object_ast,
            arguments_ast,
            no_types(),
            list_type_of(element),
            scope,
            class_information,
        )
    }
    report("Dictionary has no method '" + name + "'")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func release_statement(spite_type: Analysis.SpiteType, code: String): String {
    if type_needs_drop(spite_type) {
        return release_call(spite_type, code) + ";"
    }
    return ""
}

func emit_list_support(list_name: String, element: Analysis.SpiteType, class_id: Int) {
    var item = c_type_name(element)
    var self_parameter = list_name + "* self"
    var default_code = default_value_for_type(element)
    builder.add_typedef(
        "typedef struct " + list_name + " " + list_name + ";\nstruct " + list_name + " {\nSpiteHeader header;\n" + item + "* items;\nint64_t count;\nint64_t capacity;\n};",
    )

    var grow = "if (self->count == self->capacity) {\nint64_t new_capacity = self->capacity == 0 ? 4 : self->capacity * 2;\nself->items = (" + item + "*)SPITE_REALLOC(self->items, (size_t)new_capacity * sizeof(" + item + "));\nself->capacity = new_capacity;\n}"
    var shift_down = "for (int64_t spite_index = index; spite_index < self->count - 1; spite_index = spite_index + 1) { self->items[spite_index] = self->items[spite_index + 1]; }"

    builder.add_prototype(list_name + "* " + list_name + "_make(void);")
    builder.add_support(
        list_name + "* " + list_name + "_make(void) {\n" + list_name + "* list = (" + list_name + "*)SPITE_MALLOC(sizeof(" + list_name + "));\nlist->header.ref_count = 1;\nlist->header.class_id = " + class_id + ";\n#ifdef SPITE_DEBUG_MEMORY\nspite_debug_register_object(list, " + class_id + ");\n#endif\nlist->items = 0;\nlist->count = 0;\nlist->capacity = 0;\nreturn list;\n}",
    )

    builder.add_prototype(list_name + "* " + list_name + "_retain(" + self_parameter + ");")
    builder.add_support(
        list_name + "* " + list_name + "_retain(" + self_parameter + ") {\nif (self != 0) self->header.ref_count = self->header.ref_count + 1;\nreturn self;\n}",
    )

    builder.add_prototype("void " + list_name + "_release(" + self_parameter + ");")
    builder.add_support(
        "void " + list_name + "_release(" + self_parameter + ") {\nif (self == 0) return;\nself->header.ref_count = self->header.ref_count - 1;\nif (self->header.ref_count > 0) return;\nfor (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) { " + release_statement(
            element,
            "self->items[spite_index]",
        ) + " }\nSPITE_FREE(self->items);\nSPITE_FREE(self);\n}",
    )

    builder.add_prototype("void " + list_name + "_add(" + self_parameter + ", " + item + " value);")
    builder.add_support(
        "void " + list_name + "_add(" + self_parameter + ", " + item + " value) {\n" + grow + "\nself->items[self->count] = value;\nself->count = self->count + 1;\n}",
    )

    builder.add_prototype("int64_t " + list_name + "_count(" + self_parameter + ");")
    builder.add_support("int64_t " + list_name + "_count(" + self_parameter + ") {\nreturn self->count;\n}")

    builder.add_prototype(item + " " + list_name + "_get(" + self_parameter + ", int64_t index);")
    builder.add_support(
        item + " " + list_name + "_get(" + self_parameter + ", int64_t index) {\nif (index < 0 || index >= self->count) {\nreturn " + default_code + ";\n}\nreturn " + retain_call(
            element,
            "self->items[index]",
        ) + ";\n}",
    )

    builder.add_prototype("void " + list_name + "_set(" + self_parameter + ", int64_t index, " + item + " value);")
    builder.add_support(
        "void " + list_name + "_set(" + self_parameter + ", int64_t index, " + item + " value) {\nif (index < 0 || index >= self->count) { " + release_statement(
            element,
            "value",
        ) + " return; }\n" + release_statement(element, "self->items[index]") + "\nself->items[index] = value;\n}",
    )

    builder.add_prototype("void " + list_name + "_insert(" + self_parameter + ", int64_t index, " + item + " value);")
    builder.add_support(
        "void " + list_name + "_insert(" + self_parameter + ", int64_t index, " + item + " value) {\nint64_t clamped_index = index < 0 ? 0 : (index > self->count ? self->count : index);\n" + grow + "\nfor (int64_t spite_index = self->count; spite_index > clamped_index; spite_index = spite_index - 1) { self->items[spite_index] = self->items[spite_index - 1]; }\nself->items[clamped_index] = value;\nself->count = self->count + 1;\n}",
    )

    builder.add_prototype("void " + list_name + "_prepend(" + self_parameter + ", " + item + " value);")
    builder.add_support(
        "void " + list_name + "_prepend(" + self_parameter + ", " + item + " value) {\n" + list_name + "_insert(self, 0, value);\n}",
    )

    builder.add_prototype("void " + list_name + "_remove_at(" + self_parameter + ", int64_t index);")
    builder.add_support(
        "void " + list_name + "_remove_at(" + self_parameter + ", int64_t index) {\nif (index < 0 || index >= self->count) return;\n" + release_statement(
            element,
            "self->items[index]",
        ) + "\n" + shift_down + "\nself->count = self->count - 1;\n}",
    )

    builder.add_prototype(item + " " + list_name + "_pop(" + self_parameter + ");")
    builder.add_support(
        item + " " + list_name + "_pop(" + self_parameter + ") {\nif (self->count == 0) return " + default_code + ";\n" + item + " value = self->items[self->count - 1];\nself->count = self->count - 1;\nreturn value;\n}",
    )

    builder.add_prototype(item + " " + list_name + "_remove_first(" + self_parameter + ");")
    builder.add_support(
        item + " " + list_name + "_remove_first(" + self_parameter + ") {\nif (self->count == 0) return " + default_code + ";\n" + item + " value = self->items[0];\nint64_t index = 0;\n" + shift_down + "\nself->count = self->count - 1;\nreturn value;\n}",
    )

    builder.add_prototype(item + " " + list_name + "_first(" + self_parameter + ");")
    builder.add_support(
        item + " " + list_name + "_first(" + self_parameter + ") {\nif (self->count == 0) return " + default_code + ";\nreturn " + retain_call(
            element,
            "self->items[0]",
        ) + ";\n}",
    )

    builder.add_prototype(item + " " + list_name + "_last(" + self_parameter + ");")
    builder.add_support(
        item + " " + list_name + "_last(" + self_parameter + ") {\nif (self->count == 0) return " + default_code + ";\nreturn " + retain_call(
            element,
            "self->items[self->count - 1]",
        ) + ";\n}",
    )

    builder.add_prototype("bool " + list_name + "_is_empty(" + self_parameter + ");")
    builder.add_support("bool " + list_name + "_is_empty(" + self_parameter + ") {\nreturn self->count == 0;\n}")

    builder.add_prototype("void " + list_name + "_clear(" + self_parameter + ");")
    builder.add_support(
        "void " + list_name + "_clear(" + self_parameter + ") {\nfor (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) { " + release_statement(
            element,
            "self->items[spite_index]",
        ) + " }\nself->count = 0;\n}",
    )

    builder.add_prototype("void " + list_name + "_reverse(" + self_parameter + ");")
    builder.add_support(
        "void " + list_name + "_reverse(" + self_parameter + ") {\nfor (int64_t spite_index = 0; spite_index < self->count / 2; spite_index = spite_index + 1) {\n" + item + " spite_swap_temporary = self->items[spite_index];\nself->items[spite_index] = self->items[self->count - 1 - spite_index];\nself->items[self->count - 1 - spite_index] = spite_swap_temporary;\n}\n}",
    )

    var comparison = ""
    if type_shape.as_string(element) {
        comparison = "SpiteString_equals(self->items[spite_index], value)"
    } else if is_enum_type(element) {
        comparison = "self->items[spite_index] == value"
    } else if type_shape.as_scalar(element) {
        comparison = "self->items[spite_index] == value"
    }
    if not comparison.is_empty() {
        builder.add_prototype("bool " + list_name + "_contains(" + self_parameter + ", " + item + " value);")
        builder.add_support(
            "bool " + list_name + "_contains(" + self_parameter + ", " + item + " value) {\nfor (int64_t spite_index = 0; spite_index < self->count; spite_index = spite_index + 1) {\nif (" + comparison + ") return true;\n}\nreturn false;\n}",
        )
    }
    if type_shape.as_string(element) {
        builder.add_prototype("SpiteString* " + list_name + "_join(" + self_parameter + ", SpiteString* separator);")
        builder.add_prototype("List_String* SpiteString_split(SpiteString* self, SpiteString* separator);")
        builder.add_prototype("List_String* SpiteString_lines(SpiteString* self);")
        builder.add_support(
            "List_String* SpiteString_split(SpiteString* self, SpiteString* separator) {\nList_String* result = List_String_make();\nif (separator->length == 0) {\nfor (int64_t index = 0; index < self->length; index = index + 1) { List_String_add(result, SpiteString_character_at(self, index)); }\nreturn result;\n}\nint64_t piece_start = 0;\nint64_t index = 0;\nwhile (index <= self->length - separator->length) {\nif (memcmp(self->data + index, separator->data, (size_t)separator->length) == 0) {\nList_String_add(result, SpiteString_slice(self, piece_start, index));\nindex = index + separator->length;\npiece_start = index;\n} else {\nindex = index + 1;\n}\n}\nList_String_add(result, SpiteString_slice(self, piece_start, self->length));\nreturn result;\n}",
        )
        builder.add_support(
            "List_String* SpiteString_lines(SpiteString* self) {\nSpiteString* spite_newline = spite_string_from_cstring_owned(\"\\n\");\nList_String* result = SpiteString_split(self, spite_newline);\nSpiteString_release(spite_newline);\nreturn result;\n}",
        )

        builder.add_support(
            "SpiteString* " + list_name + "_join(" + self_parameter + ", SpiteString* separator) {\nSpiteString* result = (&spite_static_string_empty);\nfor (int64_t index = 0; index < self->count; index = index + 1) {\nSpiteString* next = index == 0 ? spite_string_from_bytes(self->items[index]->data, self->items[index]->length) : SpiteString_concat(result, self->items[index]);\nSpiteString_release(result);\nresult = next;\nif (index + 1 != self->count) {\nSpiteString* with_separator = SpiteString_concat(result, separator);\nSpiteString_release(result);\nresult = with_separator;\n}\n}\nreturn result;\n}",
        )
    }
}

func print_float_statement(code: String, stream: String, converter: String): String {
    var temporary = next_temporary()
    return "{ SpiteString* " + temporary + " = " + converter + "(" + code + "); fprintf(" + stream + ", \"%s\", " + temporary + "->data); SpiteString_release(" + temporary + "); }"
}

func printed_statement_for(expression_ast: Syntax.Expressions.Expression, stream: String, scope: Scope, class_information: Analysis.ClassInfo): String {
    var result = generate_expression(expression_ast, scope, class_information)
    var scalar = type_shape.as_scalar(result.get_type())
    if scalar {
        if scalar.kind == 'boolean_kind' {
            return "fprintf(" + stream + ", \"%s\", (" + result.code + ") ? \"true\" : \"false\");"
        }
        if scalar.kind == 'float_kind' {
            return print_float_statement(result.code, stream, "spite_string_from_float32")
        }
        if scalar.kind == 'double_kind' {
            return print_float_statement(result.code, stream, "spite_string_from_float64")
        }
        return "fprintf(" + stream + ", \"%lld\", (long long)(" + result.code + "));"
    }
    if type_shape.as_string(result.get_type()) {
        var temporary = next_temporary()
        var release_line = ""
        if owns(result, expression_ast) {
            release_line = " SpiteString_release(" + temporary + ");"
        }
        return "{ SpiteString* " + temporary + " = " + result.code + "; fprintf(" + stream + ", \"%s\", (" + temporary + ")->data);" + release_line + " }"
    }
    var printed_class = type_shape.as_class_ref(result.get_type())
    if printed_class {
        if printed_class.c_name == "Spite_Class" {
            var class_temporary = next_temporary()
            var class_release = ""
            if owns(result, expression_ast) {
                class_release = " Spite_Class_release(" + class_temporary + ");"
            }
            return "{ Spite_Class* " + class_temporary + " = " + result.code + "; fprintf(" + stream + ", \"%s\", " + class_temporary + "->name->data);" + class_release + " }"
        }
    }
    var printed_enum = type_shape.as_enum(result.get_type())
    if printed_enum {
        return "fprintf(" + stream + ", \"%s\", " + printed_enum.c_name + "_name(" + result.code + "));"
    }
    report("Console.print does not support this value's type yet")

    return ""
}

func generate_console_call(method_name: String, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var stream = "stdout"
    var trailing_newline = true
    if method_name == "error" {
        stream = "stderr"
    } else if method_name == "write" {
        trailing_newline = false
    } else if method_name != "print" {
        report("Console has no method '" + method_name + "'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var lines = List<String>()
    lines.append("{")
    var index = 0
    while index < arguments_ast.count() {
        if index > 0 {
            lines.append("fprintf(" + stream + ", \" \");")
        }
        lines.append(printed_statement_for(arguments_ast[index], stream, scope, class_information))
        index = index + 1
    }
    if trailing_newline {
        lines.append("fprintf(" + stream + ", \"\\n\");")
    }
    lines.append("}")
    return ExpressionResult(lines.join(" "), Analysis.Types.VoidType())
}

func collect_static_segments(expression: Syntax.Expressions.Expression, out: List<String>): Bool {
    var identifier = shape.as_identifier(expression)
    if identifier {
        out.append(identifier.name)
        return true
    }
    var member = shape.as_member(expression)
    if member {
        var object_ast = member.object
        crash object_ast
        var ok = collect_static_segments(object_ast, out)
        if not ok {
            return false
        }
        out.append(member.name)
        return true
    }
    return false
}

func try_resolve_static_path(expression: Syntax.Expressions.Expression, current_namespace: String): Nullable<Analysis.ClassInfo> {
    var segments = List<String>()
    var ok = collect_static_segments(expression, segments)
    if not ok {
        return null
    }
    var joined = segments.join(".")
    return find_class(joined, current_namespace)
}

func generate_call(call: Syntax.Expressions.CallExpression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var callee = call.callee
    crash callee
    var callee_identifier = shape.as_identifier(callee)
    if callee_identifier {
        if callee_identifier.name == "Console" {
            return ExpressionResult("0", Analysis.Types.ConsoleType())
        }
        if callee_identifier.name == "load" {
            return ExpressionResult("(void)0", Analysis.Types.VoidType())
        }
    }
    var target_class = try_resolve_static_path(callee, class_information.namespace_dotted)
    if target_class {
        return generate_constructor_call(target_class, call.arguments, scope, class_information)
    }
    var member = shape.as_member(callee)
    if member {
        var object_ast = member.object
        crash object_ast
        var static_type = lookup_static_type(object_ast, scope, class_information)
        if static_type {
            if type_shape.is_console(static_type) {
                return generate_console_call(member.name, call.arguments, scope, class_information)
            }
        }
        return generate_method_call(member, object_ast, call.arguments, scope, class_information)
    }
    var identifier = shape.as_identifier(callee)
    if identifier {
        return generate_own_function_call(identifier.name, call.arguments, scope, class_information)
    }
    report("unsupported call form")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func generate_member_read(member: Syntax.Expressions.MemberExpression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var object_ast = member.object
    crash object_ast
    var symbol_identifier = shape.as_identifier(object_ast)
    if symbol_identifier {
        if symbol_identifier.name == bound_symbol_name and member.name == "name" and not bound_symbol_name.is_empty() {
            return ExpressionResult(render_string_literal(bound_field_name), string_type())
        }
        if symbol_identifier.name == bound_symbol_name and member.name == "class" and not bound_symbol_name.is_empty() {
            var bound_class_type = bound_field_type
            crash bound_class_type
            return ExpressionResult(class_object_call(bound_class_type), spite_class_type())
        }
    }
    var object_result = generate_expression(object_ast, scope, class_information)
    var reflection = generate_reflection_read(member.name, object_result, object_ast)
    if reflection {
        return reflection
    }
    if type_shape.is_arguments(object_result.get_type()) {
        var lookup_result = ExpressionResult(
            "SpiteArguments_lookup(&(" + object_result.code + "), \"" + member.name + "\")",
            nullable_type_of(string_type()),
        )
        lookup_result.owning_override = true
        return lookup_result
    }
    var read_union = type_shape.as_union(object_result.get_type())
    if read_union {
        var read_union_information = find_union_by_c_name(read_union.c_name)
        crash read_union_information
        return generate_union_dispatch(
            read_union_information,
            member.name,
            false,
            object_result,
            object_ast,
            List<Syntax.Expressions.Expression>(),
            scope,
            class_information,
        )
    }
    var object_class_ref = type_shape.as_class_ref(object_result.get_type())
    if not object_class_ref {
        report("member read on a value that is not a class instance")

        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash object_class_ref
    var target_class = find_class_by_c_name(object_class_ref.c_name)
    crash target_class
    var getter = find_getter(target_class, member.name, class_information)
    if getter {
        var getter_call = generate_generic_call(getter.c_name, object_result, object_ast, List<Syntax.Expressions.Expression>(), no_types(), getter.get_return_type(), scope, class_information)
        getter_call.owning_override = true
        return getter_call
    }
    var field = target_class.find_field(member.name)
    if not field {
        report("'" + object_class_ref.c_name + "' has no field '" + member.name + "'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash field
    if owns(object_result, object_ast) {
        var object_temporary = next_temporary()
        var field_temporary = next_temporary()
        var lines = List<String>()
        lines.append(c_type_name(object_result.get_type()) + " " + object_temporary + " = " + object_result.code + ";")
        var field_code = "(" + object_temporary + ")->" + member.name
        if type_needs_drop(field.get_type()) {
            field_code = retain_call(field.get_type(), field_code)
        }
        lines.append(c_type_name(field.get_type()) + " " + field_temporary + " = " + field_code + ";")
        lines.append(release_call(object_result.get_type(), object_temporary) + ";")
        lines.append(field_temporary + ";")
        var owned_read = ExpressionResult("({ " + lines.join(" ") + " })", field.get_type())
        owned_read.owning_override = true
        return owned_read
    }
    var alias_read = ExpressionResult("(" + object_result.code + ")->" + member.name, field.get_type())
    alias_read.owning_override = false
    return alias_read
}

func generate_expression(expression: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    if shape.is_true_literal(expression) {
        return ExpressionResult("true", Analysis.Types.ScalarType('boolean_kind'))
    }
    if shape.is_false_literal(expression) {
        return ExpressionResult("false", Analysis.Types.ScalarType('boolean_kind'))
    }
    var integer_literal = shape.as_integer_literal(expression)
    if integer_literal {
        return generate_integer_literal(integer_literal)
    }
    var float_literal = shape.as_float_literal(expression)
    if float_literal {
        return ExpressionResult("" + float_literal.value, Analysis.Types.ScalarType('float_kind'))
    }
    var string_literal = shape.as_string_literal(expression)
    if string_literal {
        return ExpressionResult(render_string_literal(string_literal.value), Analysis.Types.StringType())
    }
    var identifier = shape.as_identifier(expression)
    if identifier {
        return generate_identifier(identifier, scope, class_information)
    }
    var enum_literal = shape.as_enum_literal(expression)
    if enum_literal {
        var only_enum = find_enum_with_value(enum_literal.value)
        if only_enum {
            return ExpressionResult(only_enum.c_name + "_" + enum_literal.value, enum_type_of(only_enum))
        }
        report("cannot tell which enum '" + enum_literal.value + "' belongs to here")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var list_literal = shape.as_list_literal(expression)
    if list_literal {
        return generate_untyped_list_literal(list_literal, scope, class_information)
    }
    var generic_call = shape.as_generic_call(expression)
    if generic_call {
        return generate_generic_constructor(generic_call, class_information)
    }
    var index_expression = shape.as_index(expression)
    if index_expression {
        return generate_index_read(index_expression, scope, class_information)
    }
    var unary = shape.as_unary(expression)
    if unary {
        return generate_unary(unary, scope, class_information)
    }
    var binary = shape.as_binary(expression)
    if binary {
        return generate_binary(binary, scope, class_information)
    }
    var call = shape.as_call(expression)
    if call {
        return generate_call(call, scope, class_information)
    }
    var member = shape.as_member(expression)
    if member {
        return generate_member_read(member, scope, class_information)
    }
    report("unsupported expression kind in this stage")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func try_nullable_guard(condition_ast: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo): Nullable<NullableGuard> {
    var identifier = shape.as_identifier(condition_ast)
    assert identifier
    var static_type = lookup_static_type(condition_ast, scope, class_information)
    assert static_type
    var nullable = type_shape.as_nullable(static_type)
    assert nullable
    var base_result = generate_expression(condition_ast, scope, class_information)
    var inner = nullable.get_inner()
    var guard_code = ""
    var override_code = ""
    if type_is_reference(inner) {
        guard_code = "(" + base_result.code + ") != 0"
        override_code = base_result.code
    } else {
        guard_code = "(" + base_result.code + ").has_value"
        override_code = "(" + base_result.code + ").value"
    }
    return NullableGuard(identifier.name, inner, guard_code, override_code)
}

func emit_scope_drops(scope: Scope, all_the_way_up: Bool) {
    var index = scope.owned.count() - 1
    while index >= 0 {
        var owned_local = scope.owned[index]
        builder.add_user(release_call(owned_local.get_type(), owned_local.name) + ";")
        index = index - 1
    }
    if not all_the_way_up {
        return
    }
    var parent = scope.parent
    assert parent
    emit_scope_drops(parent, true)
}

func generate_variable_declaration(declaration: Syntax.Statements.VariableDeclaration, scope: Scope, class_information: Analysis.ClassInfo) {
    var initializer = declaration.value
    assert initializer
    var declared_type = infer_declared_type(declaration.type_reference, initializer, scope, class_information)
    var value_code = coerce_for_store(initializer, declared_type, scope, class_information)
    builder.add_user(c_type_name(declared_type) + " " + declaration.name + " = " + value_code + ";")
    if type_needs_drop(declared_type) {
        scope.declare_owned(declaration.name, declared_type)
    } else {
        scope.declare(declaration.name, declared_type)
    }
}

func emit_owning_assignment(target_code: String, target_type: Analysis.SpiteType, value_ast: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo) {
    var value_code = coerce_for_store(value_ast, target_type, scope, class_information)
    if type_needs_drop(target_type) {
        var temporary = next_temporary()
        builder.add_user(c_type_name(target_type) + " " + temporary + " = " + value_code + ";")
        builder.add_user(release_call(target_type, target_code) + ";")
        builder.add_user(target_code + " = " + temporary + ";")
    } else {
        builder.add_user(target_code + " = " + value_code + ";")
    }
}

func generate_assignment(assignment: Syntax.Statements.AssignmentStatement, scope: Scope, class_information: Analysis.ClassInfo) {
    var target_ast = assignment.target
    assert target_ast
    var value_ast = assignment.value
    assert value_ast

    var identifier = shape.as_identifier(target_ast)
    if identifier {
        var scope_type = scope.lookup_type(identifier.name)
        if scope_type {
            var override = scope.lookup_override(identifier.name)
            var target_code = identifier.name
            if override {
                target_code = override
            }
            emit_owning_assignment(target_code, scope_type, value_ast, scope, class_information)
            return
        }
        var field = class_information.find_field(identifier.name)
        assert field
        emit_owning_assignment("self->" + identifier.name, field.get_type(), value_ast, scope, class_information)
        return
    }

    var index_target = shape.as_index(target_ast)
    if index_target {
        if is_bound_attributes_index(index_target) {
            var bound_target_type = bound_field_type
            crash bound_target_type
            emit_owning_assignment("self->" + bound_field_name, bound_target_type, value_ast, scope, class_information)
            return
        }
        var indexed_ast = index_target.object
        assert indexed_ast
        var position_ast = index_target.index
        assert position_ast
        var indexed_result = generate_expression(indexed_ast, scope, class_information)
        var indexed_dictionary = type_shape.as_dictionary(indexed_result.get_type())
        if indexed_dictionary {
            var dictionary_arguments = List<Syntax.Expressions.Expression>()
            dictionary_arguments.append(position_ast)
            dictionary_arguments.append(value_ast)
            var dictionary_set_call = generate_generic_call(
                ensure_dictionary(indexed_dictionary.get_element()) + "_set",
                indexed_result,
                indexed_ast,
                dictionary_arguments,
                two_types(string_type(), indexed_dictionary.get_element()),
                void_type(),
                scope,
                class_information,
            )
            builder.add_user(dictionary_set_call.code + ";")
            return
        }
        var indexed_list = type_shape.as_list(indexed_result.get_type())

        if indexed_list {
            var set_arguments = List<Syntax.Expressions.Expression>()
            set_arguments.append(position_ast)
            set_arguments.append(value_ast)
            var set_call = generate_generic_call(
                ensure_list(indexed_list.get_element()) + "_set",
                indexed_result,
                indexed_ast,
                set_arguments,
                two_types(integer_type(), indexed_list.get_element()),
                void_type(),
                scope,
                class_information,
            )
            builder.add_user(set_call.code + ";")
            return
        }
    }
    var member = shape.as_member(target_ast)
    if member {
        var object_ast = member.object
        assert object_ast
        var object_result = generate_expression(object_ast, scope, class_information)
        var object_class_ref = type_shape.as_class_ref(object_result.get_type())
        assert object_class_ref
        var target_class = find_class_by_c_name(object_class_ref.c_name)
        assert target_class
        var setter = find_setter(target_class, member.name, class_information)
        if setter {
            var setter_arguments = List<Syntax.Expressions.Expression>()
            setter_arguments.append(value_ast)
            var setter_call = generate_generic_call(setter.c_name, object_result, object_ast, setter_arguments, parameter_types_of(setter.parameters), setter.get_return_type(), scope, class_information)
            builder.add_user(setter_call.code + ";")
            return
        }
        var field = target_class.find_field(member.name)
        assert field

        var object_temporary = next_temporary()

        builder.add_user(
            c_type_name(object_result.get_type()) + " " + object_temporary + " = " + object_result.code + ";",
        )
        emit_owning_assignment(
            "(" + object_temporary + ")->" + member.name,
            field.get_type(),
            value_ast,
            scope,
            class_information,
        )
        if owns(object_result, object_ast) {
            builder.add_user(release_call(object_result.get_type(), object_temporary) + ";")
        }
        return
    }

    report("unsupported assignment target")
}

func generate_statement_list(statements: List<Syntax.Statements.Statement>, scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo): Bool {
    var index = 0
    var ended_in_return = false
    while index < statements.count() {
        ended_in_return = generate_statement(statements[index], scope, class_information, function_information)
        index = index + 1
    }
    return ended_in_return
}

func generate_block_in_scope(statements: List<Syntax.Statements.Statement>, block_scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo) {
    var ended_in_return = generate_statement_list(statements, block_scope, class_information, function_information)
    if not ended_in_return {
        emit_scope_drops(block_scope, false)
    }
}

func generate_block(statements: List<Syntax.Statements.Statement>, parent_scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo) {
    generate_block_in_scope(statements, Scope(parent_scope), class_information, function_information)
}

func generate_if_statement(if_statement: Syntax.Statements.IfStatement, scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo) {
    var condition_ast = if_statement.condition
    assert condition_ast
    var guard = try_nullable_guard(condition_ast, scope, class_information)
    if guard {
        builder.add_user("if (" + guard.guard_code + ") {")
        var then_scope = Scope(scope)
        then_scope.set_override(guard.name, guard.override_code)
        then_scope.declare(guard.name, guard.get_inner())
        generate_block_in_scope(if_statement.then_branch, then_scope, class_information, function_information)
        builder.add_user("}")
        if if_statement.has_else_branch {
            builder.add_user("else {")
            generate_block(if_statement.else_branch, scope, class_information, function_information)
            builder.add_user("}")
        }
        return
    }
    var condition_result = generate_expression(condition_ast, scope, class_information)
    builder.add_user("if (" + condition_result.code + ") {")
    generate_block(if_statement.then_branch, scope, class_information, function_information)
    builder.add_user("}")
    if if_statement.has_else_branch {
        builder.add_user("else {")
        generate_block(if_statement.else_branch, scope, class_information, function_information)
        builder.add_user("}")
    }
}

func generate_switch_statement(switch_statement: Syntax.Statements.SwitchStatement, scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo) {
    var subject_ast = switch_statement.subject
    assert subject_ast
    var subject = generate_expression(subject_ast, scope, class_information)
    var subject_union = type_shape.as_union(subject.get_type())
    if not subject_union {
        report("switch needs a union value")
        return
    }
    assert subject_union
    var information = find_union_by_c_name(subject_union.c_name)
    assert information
    var subject_temporary = next_temporary()
    builder.add_user("{")
    builder.add_user(subject_union.c_name + " " + subject_temporary + " = " + subject.code + ";")
    var subject_identifier = shape.as_identifier(subject_ast)
    var covered = 0
    var case_index = 0
    while case_index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[case_index]
        var case_type_reference = switch_case.type_reference
        assert case_type_reference
        var case_class = class_of_type_reference(case_type_reference, information.owner_namespace)
        if not case_class {
            case_class = class_of_type_reference(case_type_reference, class_information.namespace_dotted)
        }
        if case_class {
            if information.has_member(case_class.c_name) {
                covered = covered + 1
            } else {
                report("'" + case_class.simple_name + "' is not a member of union '" + information.simple_name + "'")
            }
            var keyword = "if "
            if case_index > 0 {
                keyword = "else if "
            }
            builder.add_user(keyword + class_id_test(subject_temporary, case_class) + " {")
            var case_scope = Scope(scope)
            if subject_identifier {
                case_scope.declare(subject_identifier.name, class_type_of(case_class))
                case_scope.set_override(
                    subject_identifier.name,
                    "((" + case_class.c_name + "*)" + subject_temporary + ")",
                )
            }
            generate_block_in_scope(switch_case.body, case_scope, class_information, function_information)
            builder.add_user("}")
        } else {
            report("a switch case must name a class of the union")
        }
        case_index = case_index + 1
    }
    if covered != information.members.count() {
        report("switch over '" + information.simple_name + "' does not cover every member")
    }
    if owns(subject, subject_ast) {
        builder.add_user(release_call(subject.get_type(), subject_temporary) + ";")
    }
    builder.add_user("}")
}

func generate_union_dispatch(information: Analysis.UnionInfo, member_name: String, is_call: Bool, object_result: ExpressionResult, object_ast: Syntax.Expressions.Expression, arguments_ast: List<Syntax.Expressions.Expression>, scope: Scope, class_information: Analysis.ClassInfo): ExpressionResult {
    var first_member = information.members.first()
    var result_type = void_type()
    var expected_types = no_types()
    if is_call {
        var first_function = first_member.find_function(member_name)
        if not first_function {
            report(
                "'" + first_member.simple_name + "' does not define '" + member_name + "', so it cannot be called on union '" + information.simple_name + "'",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        crash first_function
        result_type = first_function.get_return_type()
        expected_types = parameter_types_of(first_function.parameters)
    } else {
        var first_field = first_member.find_field(member_name)
        if not first_field {
            report(
                "'" + first_member.simple_name + "' has no attribute '" + member_name + "', so it cannot be read on union '" + information.simple_name + "'",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        crash first_field
        result_type = first_field.get_type()
    }
    var owning_object = owns(object_result, object_ast)
    var lines = List<String>()
    var object_temporary = next_temporary()
    lines.append(information.c_name + " " + object_temporary + " = " + object_result.code + ";")
    var argument_temporaries = List<String>()
    var argument_index = 0
    while argument_index < arguments_ast.count() {
        var argument_temporary = next_temporary()
        lines.append(
            c_type_name(expected_types[argument_index]) + " " + argument_temporary + " = " + coerce_for_store(
                arguments_ast[argument_index],
                expected_types[argument_index],
                scope,
                class_information,
            ) + ";",
        )
        argument_temporaries.append(argument_temporary)
        argument_index = argument_index + 1
    }
    var has_result = not type_shape.is_void(result_type)
    var result_temporary = next_temporary()
    if has_result {
        lines.append(
            c_type_name(result_type) + " " + result_temporary + " = " + default_value_for_scalar_or_null(result_type) + ";",
        )
    }
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var casted_object = "((" + member.c_name + "*)" + object_temporary + ")"
        var branch_code = ""
        if is_call {
            var member_function = member.find_function(member_name)
            if member_function {
                var call_arguments = List<String>()
                call_arguments.append(casted_object)
                var copy_index = 0
                while copy_index < argument_temporaries.count() {
                    call_arguments.append(argument_temporaries[copy_index])
                    copy_index = copy_index + 1
                }
                branch_code = member_function.c_name + "(" + call_arguments.join(", ") + ")"
            } else {
                report(
                    "'" + member.simple_name + "' does not define '" + member_name + "', so it cannot be called on union '" + information.simple_name + "'",
                )
            }
        } else {
            branch_code = casted_object + "->" + member_name
            if owning_object and type_needs_drop(result_type) {
                branch_code = retain_call(result_type, branch_code)
            }
        }
        var keyword = "if "
        if member_index > 0 {
            keyword = "else if "
        }
        if has_result {
            lines.append(
                keyword + class_id_test(object_temporary, member) + " { " + result_temporary + " = " + branch_code + "; }",
            )
        } else {
            lines.append(keyword + class_id_test(object_temporary, member) + " { " + branch_code + "; }")
        }
        member_index = member_index + 1
    }
    if owning_object {
        lines.append(information.c_name + "_release(" + object_temporary + ");")
    }
    if has_result {
        lines.append(result_temporary + ";")
    }
    return ExpressionResult("({ " + lines.join(" ") + " })", result_type)
}

func default_value_for_scalar_or_null(spite_type: Analysis.SpiteType): String {
    if type_is_reference(spite_type) {
        return "0"
    }
    return default_value_for_type(spite_type)
}

func generate_while_statement(while_statement: Syntax.Statements.WhileStatement, scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo) {
    var condition_ast = while_statement.condition
    assert condition_ast
    var condition_result = generate_expression(condition_ast, scope, class_information)
    builder.add_user("while (" + condition_result.code + ") {")
    generate_block(while_statement.body, scope, class_information, function_information)
    builder.add_user("}")
}

func generate_assert_statement(assert_statement: Syntax.Statements.AssertStatement, scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo) {
    var condition_ast = assert_statement.value
    assert condition_ast
    var guard = try_nullable_guard(condition_ast, scope, class_information)
    var guard_code = ""
    if guard {
        guard_code = guard.guard_code
        scope.set_override(guard.name, guard.override_code)
        scope.declare(guard.name, guard.get_inner())
    } else {
        var condition_result = generate_expression(condition_ast, scope, class_information)
        guard_code = condition_result.code
    }
    if not assert_statement.is_crash {
        if function_information.is_constructor {
            report("'assert' is not allowed in a constructor: a constructor is setup, not logic. Take already resolved values, or use 'crash' when absence is a bug")
        } else if not type_shape.is_void(function_information.get_return_type()) {
            if not type_shape.as_nullable(function_information.get_return_type()) {
                report("'assert' is only allowed in a function that returns nothing or a Nullable<T>: the caller could not tell the default from a real value. Return Nullable<T>, or use 'crash' when absence is a bug")
            }
        }
    }
    builder.add_user("if (!(" + guard_code + ")) {")
    if assert_statement.is_crash {

        builder.add_user("fflush(stdout);")
        builder.add_user("fprintf(stderr, \"spite.crash\\t" + current_owner + "\\t" + function_information.name + "\\n\");")
        builder.add_user("exit(1);")
        builder.add_user("}")
        return
    }
    emit_scope_drops(scope, true)
    if type_shape.is_void(function_information.get_return_type()) {
        builder.add_user("return;")
    } else {
        builder.add_user("return " + default_value_for_type(function_information.get_return_type()) + ";")
    }
    builder.add_user("}")
}

func generate_return_statement(return_statement: Syntax.Statements.ReturnStatement, scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo) {
    var return_type = function_information.get_return_type()
    var value_ast = return_statement.value
    if value_ast {
        var value_code = coerce_for_store(value_ast, return_type, scope, class_information)
        var temporary = next_temporary()
        builder.add_user(c_type_name(return_type) + " " + temporary + " = " + value_code + ";")
        emit_scope_drops(scope, true)
        builder.add_user("return " + temporary + ";")
    } else {
        emit_scope_drops(scope, true)
        builder.add_user("return;")
    }
}

func generate_expression_statement(expression_statement: Syntax.Statements.ExpressionStatement, scope: Scope, class_information: Analysis.ClassInfo) {
    var expression_ast = expression_statement.value
    assert expression_ast
    var result = generate_expression(expression_ast, scope, class_information)
    if type_shape.is_void(result.get_type()) {
        builder.add_user(result.code + ";")
        return
    }
    if type_needs_drop(result.get_type()) {
        if owns(result, expression_ast) {
            var temporary = next_temporary()
            builder.add_user(c_type_name(result.get_type()) + " " + temporary + " = " + result.code + ";")
            builder.add_user(release_call(result.get_type(), temporary) + ";")
            return
        }
    }
    builder.add_user("(void)(" + result.code + ");")
}

func generate_statement(statement: Syntax.Statements.Statement, scope: Scope, class_information: Analysis.ClassInfo, function_information: Analysis.FunctionInfo): Bool {
    var variable_declaration = shape.as_variable_declaration(statement)
    if variable_declaration {
        generate_variable_declaration(variable_declaration, scope, class_information)
        return false
    }
    var assignment = shape.as_assignment_statement(statement)
    if assignment {
        generate_assignment(assignment, scope, class_information)
        return false
    }
    var if_statement = shape.as_if_statement(statement)
    if if_statement {
        generate_if_statement(if_statement, scope, class_information, function_information)
        return false
    }
    var while_statement = shape.as_while_statement(statement)
    if while_statement {
        generate_while_statement(while_statement, scope, class_information, function_information)
        return false
    }
    var assert_statement = shape.as_assert_statement(statement)
    if assert_statement {
        generate_assert_statement(assert_statement, scope, class_information, function_information)
        return false
    }
    var return_statement = shape.as_return_statement(statement)
    if return_statement {
        generate_return_statement(return_statement, scope, class_information, function_information)
        return true
    }
    var switch_statement = shape.as_switch_statement(statement)
    if switch_statement {
        generate_switch_statement(switch_statement, scope, class_information, function_information)
        return false
    }
    var expression_statement = shape.as_expression_statement(statement)
    if expression_statement {
        generate_expression_statement(expression_statement, scope, class_information)
        return false
    }
    report("unsupported statement kind in this stage")
    return false
}

func constructor_parameter_list(information: Analysis.ClassInfo): String {
    var constructor = information.constructor
    if not constructor {
        return "void"
    }
    crash constructor
    var parts = List<String>()
    var index = 0
    while index < constructor.parameters.count() {
        var parameter = constructor.parameters[index]
        parts.append(c_type_name(parameter.get_type()) + " " + parameter.name)
        index = index + 1
    }
    if parts.is_empty() {
        return "void"
    }
    return parts.join(", ")
}

func function_signature(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var parts = List<String>()
    parts.append(information.c_name + "* self")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        parts.append(c_type_name(parameter.get_type()) + " " + parameter.name)
        index = index + 1
    }
    return c_type_name(function.get_return_type()) + " " + function.c_name + "(" + parts.join(", ") + ")"
}

func emit_class_prototypes(information: Analysis.ClassInfo) {
    builder.add_prototype("void " + information.c_name + "_init(" + information.c_name + "* self);")
    builder.add_prototype(information.c_name + "* " + information.c_name + "_allocate(void);")
    builder.add_prototype(information.c_name + "* " + information.c_name + "_default(void);")
    builder.add_prototype(
        information.c_name + "* " + information.c_name + "_make(" + constructor_parameter_list(information) + ");",
    )
    builder.add_prototype(information.c_name + "* " + information.c_name + "_retain(" + information.c_name + "* self);")
    builder.add_prototype("void " + information.c_name + "_release(" + information.c_name + "* self);")
    builder.add_prototype(information.c_name + "* " + information.c_name + "_copy(" + information.c_name + "* self);")
    var drop = information.drop_function
    if drop {
        builder.add_prototype("void " + drop.c_name + "(" + information.c_name + "* self);")
    }
    var function_index = 0
    while function_index < information.functions.count() {
        builder.add_prototype(function_signature(information, information.functions[function_index]) + ";")
        function_index = function_index + 1
    }
}

func emit_class_support(information: Analysis.ClassInfo) {
    var class_id_text = "" + information.class_id

    var initialize_lines = List<String>()
    initialize_lines.append("void " + information.c_name + "_init(" + information.c_name + "* self) {")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        if not type_shape.is_console(field.get_type()) {
            initialize_lines.append("self->" + field.name + " = " + field.default_value_code + ";")
        }
        field_index = field_index + 1
    }
    initialize_lines.append("}")
    builder.add_support(initialize_lines.join("\n"))

    var allocate_lines = List<String>()
    allocate_lines.append(information.c_name + "* " + information.c_name + "_allocate(void) {")
    allocate_lines.append(
        information.c_name + "* self = (" + information.c_name + "*)SPITE_MALLOC(sizeof(" + information.c_name + "));",
    )
    allocate_lines.append("self->header.ref_count = 1;")
    allocate_lines.append("self->header.class_id = " + class_id_text + ";")
    allocate_lines.append("#ifdef SPITE_DEBUG_MEMORY")
    allocate_lines.append("spite_debug_register_object(self, " + class_id_text + ");")
    allocate_lines.append("#endif")
    allocate_lines.append(information.c_name + "_init(self);")
    allocate_lines.append("return self;")
    allocate_lines.append("}")
    builder.add_support(allocate_lines.join("\n"))

    builder.add_support(
        information.c_name + "* " + information.c_name + "_default(void) { return " + information.c_name + "_allocate(); }",
    )

    var make_lines = List<String>()
    make_lines.append(
        information.c_name + "* " + information.c_name + "_make(" + constructor_parameter_list(information) + ") {",
    )
    make_lines.append(information.c_name + "* self = " + information.c_name + "_allocate();")
    var constructor = information.constructor
    if constructor {
        var arguments = List<String>()
        arguments.append("self")
        var parameter_index = 0
        while parameter_index < constructor.parameters.count() {
            arguments.append(constructor.parameters[parameter_index].name)
            parameter_index = parameter_index + 1
        }
        make_lines.append(constructor.c_name + "(" + arguments.join(", ") + ");")
    }
    make_lines.append("return self;")
    make_lines.append("}")
    builder.add_support(make_lines.join("\n"))

    builder.add_support(
        information.c_name + "* " + information.c_name + "_retain(" + information.c_name + "* self) { if (self != 0) self->header.ref_count = self->header.ref_count + 1; return self; }",
    )

    var release_lines = List<String>()
    release_lines.append("void " + information.c_name + "_release(" + information.c_name + "* self) {")
    release_lines.append("if (self == 0) return;")
    release_lines.append("self->header.ref_count = self->header.ref_count - 1;")
    release_lines.append("if (self->header.ref_count > 0) return;")
    var drop = information.drop_function
    if drop {
        release_lines.append(drop.c_name + "(self);")
    }
    var drop_field_index = 0
    while drop_field_index < information.fields.count() {
        var field = information.fields[drop_field_index]
        if type_needs_drop(field.get_type()) {
            release_lines.append(release_call(field.get_type(), "self->" + field.name) + ";")
        }
        drop_field_index = drop_field_index + 1
    }
    release_lines.append("SPITE_FREE(self);")
    release_lines.append("}")
    builder.add_support(release_lines.join("\n"))

    var copy_lines = List<String>()
    copy_lines.append(information.c_name + "* " + information.c_name + "_copy(" + information.c_name + "* self) {")
    copy_lines.append(
        information.c_name + "* spite_copy = (" + information.c_name + "*)SPITE_MALLOC(sizeof(" + information.c_name + "));",
    )
    copy_lines.append("spite_copy->header.ref_count = 1;")
    copy_lines.append("spite_copy->header.class_id = " + class_id_text + ";")
    copy_lines.append("#ifdef SPITE_DEBUG_MEMORY")
    copy_lines.append("spite_debug_register_object(spite_copy, " + class_id_text + ");")
    copy_lines.append("#endif")
    var copy_field_index = 0
    while copy_field_index < information.fields.count() {
        var field = information.fields[copy_field_index]
        if not type_shape.is_console(field.get_type()) {
            var value_code = "self->" + field.name
            if type_needs_drop(field.get_type()) {
                value_code = retain_call(field.get_type(), value_code)
            }
            copy_lines.append("spite_copy->" + field.name + " = " + value_code + ";")
        }
        copy_field_index = copy_field_index + 1
    }
    copy_lines.append("return spite_copy;")
    copy_lines.append("}")
    builder.add_support(copy_lines.join("\n"))
}

func emit_user_function(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    if function.is_emitted {
        return
    }
    function.is_emitted = true
    current_function = function.name
    bind_symbol_of(information, function)
    builder.add_user(function_signature(information, function) + " {")
    var scope = Scope(null)
    arguments_parameter_names.clear()
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        var parameter = function.parameters[parameter_index]
        if type_shape.is_arguments(parameter.get_type()) {
            arguments_parameter_names.append(parameter.name)
        }

        if type_needs_drop(parameter.get_type()) {
            scope.declare_owned(parameter.name, parameter.get_type())
        } else {
            scope.declare(parameter.name, parameter.get_type())
        }
        parameter_index = parameter_index + 1
    }
    var ended_in_return = generate_statement_list(function.body, scope, information, function)
    if not ended_in_return {
        emit_scope_drops(scope, true)
        if not type_shape.is_void(function.get_return_type()) {
            builder.add_user("return " + default_value_for_type(function.get_return_type()) + ";")
        }
    }
    builder.add_user("}")
}

func emit_class(information: Analysis.ClassInfo) {
    current_owner = information.qualified_dotted
    var struct_lines = List<String>()
    struct_lines.append("struct " + information.c_name + " {")
    struct_lines.append("SpiteHeader header;")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        if not type_shape.is_console(field.get_type()) {
            struct_lines.append(c_type_name(field.get_type()) + " " + field.name + ";")
        }
        field_index = field_index + 1
    }
    struct_lines.append("};")
    builder.add_typedef(struct_lines.join("\n"))

    emit_class_prototypes(information)
    emit_class_support(information)

    var function_index = 0
    while function_index < information.functions.count() {
        emit_user_function(information, information.functions[function_index])
        function_index = function_index + 1
    }
}

func debug_memory_class_name_table(): String {
    var names = List<String>()
    names.append("\"String\"")
    var index = 0
    while index < classes.count() {
        names.append("\"" + classes[index].c_name + "\"")
        index = index + 1
    }
    index = 0
    while index < support_class_names.count() {
        names.append("\"" + support_class_names[index] + "\"")
        index = index + 1
    }

    return "{ " + names.join(", ") + " }"
}

func emit_main(entry_mangled_name: String) {
    var entry_class = find_class_by_c_name(entry_mangled_name)
    assert entry_class
    builder.add_main("#ifdef SPITE_DEBUG_MEMORY")
    builder.add_main("static const char* spite_debug_class_name_table[] = " + debug_memory_class_name_table() + ";")
    builder.add_main(
        "spite_debug_set_class_names(spite_debug_class_name_table, " + ("" + (classes.count() + 1 + support_class_names.count(
        ))) + ");",
    )
    builder.add_main("#endif")
    builder.add_main(entry_class.c_name + "* spite_entry_instance = " + entry_class.c_name + "_allocate();")
    var constructor = entry_class.constructor
    if constructor {
        var arguments = List<String>()
        arguments.append("spite_entry_instance")
        var index = 0
        while index < constructor.parameters.count() {
            if type_shape.is_arguments(constructor.parameters[index].get_type()) {
                arguments.append(
                    "((SpiteArguments){ .count = argument_count - 1, .items = (const char**)(argument_values + 1) })",
                )
            } else {
                arguments.append(default_value_for_type(constructor.parameters[index].get_type()))
            }
            index = index + 1
        }
        builder.add_main(constructor.c_name + "(" + arguments.join(", ") + ");")
    }
    builder.add_main(entry_class.c_name + "_release(spite_entry_instance);")
    var cache_index = 0
    while cache_index < class_object_names.count() {
        builder.add_main("Spite_Class_release(" + class_object_names[cache_index] + "_cache);")
        cache_index = cache_index + 1
    }

    builder.add_main("#ifdef SPITE_DEBUG_MEMORY")
    builder.add_main("spite_debug_report_leaks();")
    builder.add_main(
        "printf(\"allocations: %lld frees: %lld\\n\", (long long)spite_debug_allocations, (long long)spite_debug_frees);",
    )
    builder.add_main("#endif")
}
