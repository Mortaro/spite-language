func report(message: String) {
    has_error = true
    assert not statement_poisoned
    assert refused_json_path.is_empty() or current_path != refused_json_path
    var line = "{current_path}:{current_line}: error: {message} (in {current_owner}.{current_function})"
    assert not error_lines.contains(line)
    if error_lines.count() == 25 {
        error_lines.append("too many errors: stopping at 25")
    }
    assert not (error_lines.count() > 25)
    error_lines.append(line)
    error_message = error_lines.join("\n")
}

func allocate_class_id(debug_name: String): Integer {
    if class_names_by_id.is_empty() {
        class_names_by_id.append("String")
    }
    if seeded_class_ids[debug_name] {
        return seeded_class_ids[debug_name]
    }
    class_names_by_id.append(debug_name)
    return class_names_by_id.count() - 1
}

func generated_functions_source(qualified: String): String {
    var text = ""
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if information.qualified_dotted == qualified and information.codegen_names.is_empty() {
            var function_index = 0
            while function_index < information.functions.count() {
                var function = information.functions[function_index]
                if not function.symbol_name.is_empty() and function.symbol_owner_c_name.is_empty() and function.has_body {
                    text = "{text}\n\n{instantiated_function_source(information, function)}"
                }
                function_index = function_index + 1
            }
        }
        index = index + 1
    }
    return text
}

func instantiated_function_source(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var field = information.find_field(function.symbol_field_name)
    var field_type = "Nothing"
    if field {
        var field_spite_type = field.get_type()
        field_type = type_display_name(field_spite_type)
    } else if function.symbol_field_type {
        field_type = type_source_name(function.symbol_field_type)
    }
    var shown_name = function.symbol_field_name
    if not function.symbol_display_name.is_empty() {
        shown_name = function.symbol_display_name
    }
    var parameters = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.get_type()
        parameters.append("{parameter.name}: {type_display_name(parameter_type)}")
        index = index + 1
    }
    var returns = ""
    var function_return_type = function.get_return_type()
    if not type_shape.is_void(function_return_type) {
        returns = ": {type_display_name(function_return_type)}"
    }
    var symbol = function.symbol_name
    var body = Syntax.SourcePrinter().source_statement_list(function.body, 1)
    body = body.replace("attributes[{symbol}]", function.symbol_field_name)
    body = body.replace("\{{symbol}.name}", shown_name)
    body = body.replace("{symbol}.name", "\"{shown_name}\"")
    if not function.symbol_enum_c_name.is_empty() {
        body = body.replace("{symbol}.value", "'{function.symbol_field_name}'")
    }
    body = body.replace("{symbol}.class", field_type)
    if not function.symbol_pattern.is_empty() {
        body = body.replace(".{function.symbol_pattern}(", ".{function.symbol_function_name}(")
    }
    body = passed_calls_source(information, function, body)
    body = replace_word(body, symbol, "'{function.symbol_field_name}'")
    return "func {function.name}({parameters.join(", ")}){returns} \{\n{body}\n}"
}

func passed_calls_source(information: Analysis.ClassInfo, function: Analysis.FunctionInfo, body: String): String {
    var result = body
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.passed and range_text(template) == function.symbol_range {
            var instance_name = passed_instance_name(
                information,
                template,
                function.symbol_field_name,
                function.symbol_pattern,
                function.symbol_function_name,
            )
            result = result.replace("{template.prefix}({function.symbol_name}, ", "{instance_name}(")
            result = result.replace("{template.prefix}({function.symbol_name})", "{instance_name}()")
        }
        index = index + 1
    }
    return result
}

func type_source_name(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return described.qualified_dotted
        }
    }
    return type_display_name(spite_type)
}

func replace_word(text: String, word: String, replacement: String): String {
    var result = ""
    var index = 0
    while index < text.length() {
        var text_length = text.length()
        var word_length = word.length()
        if text.slice(index, text_length).starts_with(word) and not is_word_character_at(text, index - 1) and not is_word_character_at(text, index + word_length) {
            result = "{result}{replacement}"
            index = index + word.length()
        } else {
            result = "{result}{text.slice(index, index + 1)}"
            index = index + 1
        }
    }
    return result
}

func is_word_character_at(text: String, index: Integer): Boolean {
    assert index >= 0 and index < text.length()
    var character = text.slice(index, index + 1)
    return character == "_" or character == "." or character.lower_case() != character.upper_case() or "0123456789".contains(character)
}

func class_view_source(information: Analysis.ClassInfo, display_name: String): String {
    var lines = List<String>()
    lines.append("type {display_name} \{")
    var field_index = 0
    while field_index < information.fields.count() {
        var field = information.fields[field_index]
        var field_type = field.get_type()
        lines.append("    {field.name}: {type_display_name(field_type)}")
        field_index = field_index + 1
    }
    var index = 0
    while index < information.functions.count() {
        var function = information.functions[index]
        if not function.is_constructor {
            lines.append("    {built_in_signature(function)}")
        }
        index = index + 1
    }
    lines.append("}")
    return lines.join("\n")
}

func is_instantiated_class(information: Analysis.ClassInfo): Boolean {
    return not information.is_generic_template and not information.is_container and not information.codegen_types.is_empty()
}

func instantiated_class_names(): List<String> {
    var names = List<String>()
    var index = 0
    while index < classes.count() {
        if is_instantiated_class(classes[index]) {
            var instantiated_name = instantiated_class_name(classes[index])
            names.append(instantiated_name)
        }
        index = index + 1
    }
    return names
}

func instantiated_class_sources(): List<String> {
    var sources = List<String>()
    var index = 0
    while index < classes.count() {
        if is_instantiated_class(classes[index]) {
            var instantiated_name = instantiated_class_name(classes[index])
            var view_source = class_view_source(classes[index], instantiated_name)
            sources.append(view_source)
        }
        index = index + 1
    }
    return sources
}

func instantiated_class_name(information: Analysis.ClassInfo): String {
    var name = information.simple_name
    var index = 0
    while index < information.codegen_types.count() {
        name = "{name}{codegen_value_name(information, index)}"
        index = index + 1
    }
    return name
}

func codegen_value_name(information: Analysis.ClassInfo, index: Integer): String {
    crash information.codegen_codes[index]
    if information.codegen_codes[index].is_empty() {
        return type_display_name(information.codegen_types[index])
    }
    var code = information.codegen_codes[index]
    var code_length = code.length()
    return "{code.slice(0, 1).upper_case()}{code.slice(1, code_length)}"
}

func emitted_qualified_names(): List<String> {
    var names = List<String>()
    var index = 0
    while index < classes.count() {
        var information = classes[index]
        if information.is_emitted and not is_instantiated_class(information) {
            names.append(information.qualified_dotted)
        }
        index = index + 1
    }
    return names
}

func built_in_signature(function: Analysis.FunctionInfo): String {
    var parameters = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter_type = function.parameters[index].get_type()
        var display_name = type_display_name(parameter_type)
        parameters.append(display_name)
        index = index + 1
    }
    var signature = "{function.name}({parameters.join(", ")})"
    var function_return_type = function.get_return_type()
    if type_shape.is_void(function_return_type) {
        return signature
    }
    return "{signature}: {type_display_name(function_return_type)}"
}

func emit_system_classes(system_structs: String, system_prototypes: String, system_bodies: String) {
    var string_spite_type = string_type()
    ensure_list(string_spite_type)
    builder.add_typedef(system_structs)
    builder.add_prototype(system_prototypes)
    builder.add_support(system_bodies)
}

func generate(
    discovery: Discovery.DiscoveryResult,
    runtime_header_text: String,
    system_structs: String,
    system_prototypes: String,
    system_bodies: String,
): String {
    entry_class_c_name = discovery.entry_mangled_name
    loaded_folders = discovery.loaded_folders
    var allocator = allocator_text()
    var header_text = runtime_header_text.replace("/*spite_allocator*/", allocator)
    builder.add_typedef(header_text)
    builder.add_typedef(
        "static const char* spite_assert_trace[32];\nstatic int64_t spite_assert_total = 0;\nstatic void spite_report_assert_trace(void) \{\nint64_t spite_kept = spite_assert_total < 32 ? spite_assert_total : 32;\nfor (int64_t spite_index = spite_assert_total - spite_kept; spite_index < spite_assert_total; spite_index = spite_index + 1) \{ fputs(spite_assert_trace[spite_index % 32], stderr); }\nif (spite_assert_total > 32) \{ fprintf(stderr, \"spite.assert\\tearlier=%lld\\n\", (long long)(spite_assert_total - 32)); }\n}",
    )
    var traced = "#define SPITE_TRACE_ASSERT(site) (spite_assert_trace[spite_assert_total % 32] = (site), spite_assert_total = spite_assert_total + 1)"
    var untraced = "#define SPITE_TRACE_ASSERT(site) ((void)0)"
    var trace_macro = builder.type_placeholder_if_kept("spite_report_assert_trace", traced, untraced)
    builder.add_typedef(trace_macro)
    register_classes(discovery.class_files)
    emit_enums()
    var string_layout_position = builder.typedef_count()
    builder.add_typedef("")
    var forward_index = 0
    while forward_index < classes.count() {
        if not classes[forward_index].is_value_class {
            builder.add_typedef("typedef struct {classes[forward_index].c_name} {classes[forward_index].c_name};")
        }
        forward_index = forward_index + 1
    }
    emit_system_classes(system_structs, system_prototypes, system_bodies)
    resolve_union_members()
    resolve_generic_constraints()
    emit_unions()
    resolve_classes(discovery.class_files)
    classes_resolved = true
    check_pending_constraints()
    report_shadowed_functions(discovery.class_files)
    call_effects.study(discovery.class_files)
    var string_layout_code = string_layout()
    builder.replace_typedef(string_layout_position, string_layout_code)
    check_number_memory()
    assert not has_error
    var index = 0
    while index < classes.count() {
        if not classes[index].is_generic_template {
            emit_class(classes[index])
        }
        index = index + 1
    }
    emit_pending_functions()
    emit_all_classes_function()
    if read_evaluate_print_loop {
        var looped_class = find_class_by_c_name(discovery.entry_mangled_name)
        if looped_class {
            ensure_symbol("program")
            var class_type = class_type_of(looped_class)
            ensure_reflect_function(class_type)
        }
    }
    var settle = 0
    while settle < 4 {
        emit_class_object_bodies()
        emit_namespace_object_bodies()
        emit_functions_function_bodies()
        emit_pending_functions()
        settle = settle + 1
    }
    settle_shape_members()
    emit_shape_bodies()
    emit_union_class_of_bodies()
    emit_union_attributes_bodies()
    var final_settle = 0
    while final_settle < 4 {
        emit_class_object_bodies()
        emit_namespace_object_bodies()
        emit_functions_function_bodies()
        emit_attribute_object_bodies()
        emit_pending_functions()
        emit_late_shape_callers()
        emit_pending_functions()
        final_settle = final_settle + 1
    }
    emit_foreign_libraries()
    emit_symbol_table()
    if debug_memory {
        emit_allocation_table()
    }
    if scheduler_used and not has_error {
        emit_state_machines()
    }
    if scheduler_used or remote_loop_port > 0 or hot_reload {
        finish_waiting_points()
    }
    if scheduler_used and not has_error {
        emit_primitive_machines()
    }
    emit_main(discovery.launcher_mangled_name)
    emit_pending_functions()
    while emit_late_shape_callers() > 0 {
        emit_pending_functions()
    }
    emit_attribute_object_bodies()
    emit_hot_reload_support()
    if parallel_used {
        finish_singleton_guards()
    }
    if not atomic_classes.is_empty() {
        finish_atomic_singletons()
    }
    if not outside_classes.is_empty() {
        finish_outside_writes()
    }
    if not has_error {
        report_unused_attributes()
    }
    finish_allocated_classes()
    builder.shakes = not keeps_internals
    builder.hot_reload = hot_reload
    builder.debug_memory = debug_memory
    return builder.render()
}

func register_classes(discovered: List<Discovery.DiscoveredClass>) {
    first_discovered_class = classes.count()
    var index = 0
    while index < discovered.count() {
        var entry = discovered[index]
        var value_type = value_type_named(entry.qualified_dotted)
        if value_type {
            var value_c_name = entry.qualified_dotted.replace(".", "_")
            var value_class = Analysis.ClassInfo(
                "Spite{value_c_name}",
                entry.qualified_dotted,
                "",
                entry.qualified_dotted,
                0,
            )
            value_class.is_value_class = true
            classes.append(value_class)
        } else {
            var class_id = allocate_class_id(entry.mangled_name)
            var discovered_class = Analysis.ClassInfo(
                entry.mangled_name,
                entry.simple_name,
                entry.namespace_dotted,
                entry.qualified_dotted,
                class_id,
            )
            classes.append(discovered_class)
        }
        var registered = classes.last()
        crash registered
        registered.source_path = entry.get_file().path
        registered.entry_index = index
        registered.codegen_names = declared_codegen_names(entry)
        registered.is_singleton = has_singleton_line(entry)
        registered.holds_nothing = registered.is_singleton and holds_nothing(entry)
        registered.is_stateless_singleton = registered.holds_nothing and not keeps_internals
        registered.is_generic_template = not registered.codegen_names.is_empty()
        discovered_classes.append(entry)
        register_enums(entry)
        register_unions(entry)
        register_shapes(entry)
        index = index + 1
    }
}

func has_singleton_line(entry: Discovery.DiscoveredClass): Boolean {
    var file = entry.get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        if shape.as_singleton_declaration(file.statements[statement_index]) {
            return true
        }
        statement_index = statement_index + 1
    }
    return false
}

func holds_nothing(entry: Discovery.DiscoveredClass): Boolean {
    var file = entry.get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var statement = file.statements[statement_index]
        var declaration = shape.as_variable_declaration(statement)
        if declaration {
            assert declaration.hardcoded_value
        }
        var function_declaration = shape.as_function_declaration(statement)
        if function_declaration {
            assert function_declaration.name != "drop"
        }
        statement_index = statement_index + 1
    }
    return true
}

func is_stateless_singleton(information: Analysis.ClassInfo): Boolean {
    return information.is_stateless_singleton
}

func declared_codegen_names(entry: Discovery.DiscoveredClass): List<String> {
    var file = entry.get_file()
    var declared = List<String>()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var generic_line = shape.as_generic_declaration(file.statements[statement_index])
        if generic_line {
            var bare_name = without_dollar(generic_line.name)
            declared.append(bare_name)
        }
        statement_index = statement_index + 1
    }
    return declared
}

func without_dollar(name: String): String {
    if name.starts_with("$") {
        var name_length = name.length()
        return name.slice(1, name_length)
    }
    return name
}

func codegen_index(information: Analysis.ClassInfo, name: String): Integer {
    var index = 0
    while index < information.codegen_names.count() {
        if information.codegen_names[index] == name {
            if index < information.codegen_types.count() {
                return index
            }
        }
        index = index + 1
    }
    return 0 - 1
}

func generate_codegen_value(name: String, class_information: Analysis.ClassInfo): ExpressionResult {
    var bound = codegen_index(class_information, name)
    if bound >= 0 {
        crash class_information.codegen_codes[bound]
        if class_information.codegen_codes[bound].is_empty() {
            report("'${name}' is a type here, so it cannot be used as a value")
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        crash class_information.codegen_types[bound]
        var bound_value = ExpressionResult(
            class_information.codegen_codes[bound],
            class_information.codegen_types[bound],
        )
        bound_value.owning_override = false
        crash class_information.codegen_texts[bound]
        bound_value.constant_text = class_information.codegen_texts[bound]
        return bound_value
    }
    report(
        "'{class_information.simple_name}' has no 'generic ${name}' line, and '$' is for generics only: a program's settings are fields of Environment -- reopen it in environment.spite with 'var {name} = ...' and read it through 'var environment = Environment()' as 'environment.{name}'",
    )
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func constant_condition(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    var generic_identifier = shape.as_generic_identifier(expression)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var value = generate_codegen_value(bare_name, class_information)
        var value_type = value.get_type()
        if is_boolean_type(value_type) {
            return value.code == "true"
        }
        return null
    }
    var asked = function_question(expression, class_information)
    if asked == true or asked == false {
        return asked
    }
    var setting_text = hardcoded_setting_text(expression, scope, class_information)
    if setting_text {
        if setting_text == "b:true" or setting_text == "b:false" {
            return setting_text == "b:true"
        }
        return null
    }
    var unary = shape.as_unary(expression)
    if unary {
        if unary.operator == 'logical_not' {
            if unary.operand {
                var inner = constant_condition(unary.operand, scope, class_information)
                if inner == true {
                    return false
                }
                if inner == false {
                    return true
                }
                return null
            }
        }
        return null
    }
    var binary = shape.as_binary(expression)
    if binary {
        if binary.left {
            if binary.right {
                if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
                    var left_constant = constant_condition(binary.left, scope, class_information)
                    var right_constant = constant_condition(binary.right, scope, class_information)
                    if (left_constant == true or left_constant == false) and (right_constant == true or right_constant == false) {
                        if binary.operator == 'logical_and' {
                            return left_constant == true and right_constant == true
                        }
                        return left_constant == true or right_constant == true
                    }
                    return null
                }
                if binary.operator == 'equal' or binary.operator == 'not_equal' {
                    if codegen_is_class(binary.right, class_information) and not shape.as_generic_identifier(binary.left) {
                        return known_codegen_class_test(binary, scope, class_information)
                    }
                    var left_generic = shape.as_generic_identifier(binary.left)
                    if left_generic {
                        var bare_name = without_dollar(left_generic.name)
                        var bound_type = codegen_bound_type(bare_name, class_information)
                        if bound_type {
                            var same_kind = type_test(bound_type, binary.right, class_information)
                            if binary.operator == 'equal' {
                                return same_kind
                            }
                            return not same_kind
                        }
                    }
                    var left_text = folded_text(binary.left, scope, class_information)
                    var right_text = constant_text(binary.right)
                    if left_text {
                        if right_text {
                            var same = left_text == right_text
                            if binary.operator == 'equal' {
                                return same
                            }
                            return not same
                        }
                    }
                }
            }
        }
    }
    return null
}

func function_question(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): Boolean? {
    var call = shape.as_call(expression)
    assert call
    return folded_function_question(call, class_information)
}

func folded_function_question(
    call: Syntax.Expressions.CallExpression,
    class_information: Analysis.ClassInfo,
): Boolean? {
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member
    assert member.name == "has_function"
    crash member.object
    var symbol_class = shape.as_member(member.object)
    if symbol_class {
        return symbol_function_question(symbol_class, call.arguments, class_information)
    }
    var generic_identifier = shape.as_generic_identifier(member.object)
    assert generic_identifier
    var bare_name = without_dollar(generic_identifier.name)
    var bound = codegen_index(class_information, bare_name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    var pattern = written_name(call.arguments)
    if pattern {
        crash class_information.codegen_types[bound]
        var bound_class_ref = type_shape.as_class_ref(class_information.codegen_types[bound])
        if bound_class_ref {
            var owner = find_class_by_c_name(bound_class_ref.c_name)
            crash owner
            return class_has_function(owner, pattern, class_information)
        }
        return false
    }
    report(
        "'${bare_name}.has_function(...)' is decided while compiling, so the name it asks for is written as a literal: '${bare_name}.has_function('run_each')', or a pattern such as \"<phase>_each\"",
    )
    return false
}

func symbol_function_question(
    symbol_class: Syntax.Expressions.MemberExpression,
    arguments: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Boolean? {
    assert symbol_class.name == "class" and not bound_symbol_name.is_empty()
    crash symbol_class.object
    var symbol_identifier = shape.as_identifier(symbol_class.object)
    assert symbol_identifier
    assert symbol_identifier.name == bound_symbol_name
    assert bound_field_type
    var pattern = written_name(arguments)
    assert pattern
    var bound_class_ref = type_shape.as_class_ref(bound_field_type)
    assert bound_class_ref
    assert not bound_class_ref.has_signature
    var owner = find_class_by_c_name(bound_class_ref.c_name)
    assert owner
    return class_has_function(owner, pattern, class_information)
}

func written_name(arguments: List<Syntax.Expressions.Expression>): String? {
    assert arguments.count() == 1
    var string_literal = shape.as_string_literal(arguments[0])
    if string_literal {
        return string_literal.value
    }
    var enum_literal = shape.as_enum_literal(arguments[0])
    assert enum_literal
    return enum_literal.value
}

func class_has_function(owner: Analysis.ClassInfo, pattern: String, asking: Analysis.ClassInfo): Boolean {
    var functions = declared_functions_of(owner)
    var names = functions.map_name()
    var opening = pattern.index_of("<")
    var closing = pattern.index_of(">")
    if opening < 0 or closing < opening {
        return names.contains(pattern)
    }
    var pattern_length = pattern.length()
    var prefix = pattern.slice(0, opening)
    var suffix = pattern.slice(closing + 1, pattern_length)
    var hole = pattern.slice(opening + 1, closing)
    var hole_values = hole_enum(asking, hole)
    if hole_values {
        var index = 0
        while index < hole_values.values.count() {
            var value = hole_values.values[index]
            if names.contains("{prefix}{value}{suffix}") {
                return true
            }
            index = index + 1
        }
        return false
    }
    var missing = missing_hole_enum(asking, hole, pattern)
    report(missing)
    return false
}

func folded_text(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String? {
    var generic_identifier = shape.as_generic_identifier(expression)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        var value = generate_codegen_value(bare_name, class_information)
        return constant_text_of_code(value)
    }
    return hardcoded_setting_text(expression, scope, class_information)
}

func hardcoded_setting_text(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String? {
    var member = shape.as_member(expression)
    if member {
        if is_hardcoded_setting_name(member.name) {
            var value = generate_member_read(member, scope, class_information)
            if not value.constant_text.is_empty() {
                return value.constant_text
            }
        }
    }
    return null
}

func codegen_bound_type(name: String, class_information: Analysis.ClassInfo): Analysis.SpiteType? {
    var bound = codegen_index(class_information, name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    return class_information.codegen_types[bound]
}

func type_test(
    bound_type: Analysis.SpiteType,
    kind: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Boolean {
    var kind_name = operand_text(kind)
    if kind_name == "List" {
        return bound_type == Analysis.Types.ListType
    }
    if kind_name == "Dictionary" {
        return bound_type == Analysis.Types.DictionaryType
    }
    if kind_name == "Null" {
        return bound_type == Analysis.Types.NullableType
    }
    if kind_name == "Symbol" {
        return is_enum_type(bound_type) or type_shape.is_symbol(bound_type)
    }
    if kind_name == "Enum" {
        return is_enum_type(bound_type)
    }
    var kind_path = kind_name.split(".")
    var kind_reference: Syntax.Types.Type = Syntax.Types.NamedType(kind_path, List<Syntax.Types.GenericArgument>())
    var saved_class = current_class
    current_class = class_information
    var kind_type = resolve_type(kind_reference, class_information.qualified_dotted)
    current_class = saved_class
    assert kind_type
    var kind_union = type_shape.as_union(kind_type)
    if kind_union {
        var union_information = find_union_by_c_name(kind_union.c_name)
        if union_information {
            var member_index = 0
            while member_index < union_information.member_types.count() {
                var member_type = resolve_type(
                    union_information.member_types[member_index],
                    union_information.owner_namespace,
                )
                if member_type {
                    if exact_type_label(member_type) == exact_type_label(bound_type) {
                        return true
                    }
                }
                member_index = member_index + 1
            }
        }
    }
    return exact_type_label(kind_type) == exact_type_label(bound_type)
}

func exact_type_label(spite_type: Analysis.SpiteType): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.get_inner()
        return "Nullable_{exact_type_label(nullable_inner)}"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_element = list_type.get_element()
        return "List_{exact_type_label(list_element)}"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_element = dictionary_type.get_element()
        return "Dictionary_{exact_type_label(dictionary_element)}"
    }
    var function_type = type_shape.as_class_ref(spite_type)
    if function_type {
        if function_type.has_signature {
            return function_type_label(function_type)
        }
    }
    return type_label(spite_type)
}

func function_type_label(function_type: Analysis.Types.ClassRefType): String {
    var label = "Spite_Function_{function_type.arguments.count()}"
    var index = 0
    while index < function_type.arguments.count() {
        label = "{label}_{exact_type_label(function_type.arguments[index])}"
        index = index + 1
    }
    if function_type.returns {
        label = "{label}_{exact_type_label(function_type.returns)}"
    }
    return label
}

func constant_text(expression: Syntax.Expressions.Expression): String? {
    var string_literal = shape.as_string_literal(expression)
    if string_literal {
        return "s:{string_literal.value}"
    }
    var integer_literal = shape.as_integer_literal(expression)
    if integer_literal {
        return "i:{integer_literal.value}"
    }
    var enum_literal = shape.as_enum_literal(expression)
    if enum_literal {
        return "e:{enum_literal.value}"
    }
    if shape.is_true_literal(expression) {
        return "b:true"
    }
    if shape.is_false_literal(expression) {
        return "b:false"
    }
    return null
}

func constant_text_of_code(value: ExpressionResult): String {
    if value.constant_text.is_empty() {
        return "?"
    }
    return value.constant_text
}

func generic_argument_label(text: String): String {
    var result = ""
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        var is_letter = code >= 65 and code <= 90 or code >= 97 and code <= 122
        var is_digit = code >= 48 and code <= 57
        if is_letter or is_digit {
            result = result + text.character_at(index)
        } else {
            result = "{result}_"
        }
        index = index + 1
    }
    return result
}

func instantiate_generic(
    template: Analysis.ClassInfo,
    arguments: List<Syntax.Types.GenericArgument>,
    current_namespace: String,
): Analysis.ClassInfo? {
    if arguments.count() != template.codegen_names.count() {
        report(
            "'{template.simple_name}' takes {template.codegen_names.count()} codegen value(s), in this order: ${template.codegen_names.join(", $")} -- but {arguments.count()} were given",
        )
        return null
    }
    var types = List<Analysis.SpiteType>()
    var codes = List<String>()
    var texts = List<String>()
    var label = "{template.c_name}_"
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var type_argument = shape.as_type_argument(argument)
        if type_argument {
            var argument_type = resolve_generic_argument(argument, current_namespace)
            assert argument_type
            types.append(argument_type)
            codes.append("")
            texts.append("")
            label = "{label}_{exact_type_label(argument_type)}"
        }
        var boolean_argument = shape.as_boolean_argument(argument)
        if boolean_argument {
            var boolean_spite_type = boolean_type()
            types.append(boolean_spite_type)
            var boolean_code = "false"
            if boolean_argument.value {
                boolean_code = "true"
            }
            codes.append(boolean_code)
            texts.append("b:{boolean_code}")
            label = "{label}_{boolean_code}"
        }
        var integer_argument = shape.as_integer_argument(argument)
        if integer_argument {
            var integer_spite_type = integer_type()
            types.append(integer_spite_type)
            var integer_code = "{integer_argument.value}"
            codes.append(integer_code)
            texts.append("i:{integer_code}")
            label = "{label}_{integer_code}"
        }
        var float_argument = shape.as_float_argument(argument)
        if float_argument {
            var float_spite_type = float_type()
            types.append(float_spite_type)
            var last_code = "{float_argument.value}"
            codes.append(last_code)
            texts.append("f:{last_code}")
            label = "{label}_{generic_argument_label(last_code)}"
        }
        var string_argument = shape.as_string_argument(argument)
        if string_argument {
            var string_spite_type = string_type()
            types.append(string_spite_type)
            var rendered_string_literal = render_string_literal(string_argument.value)
            codes.append(rendered_string_literal)
            texts.append("s:{string_argument.value}")
            label = "{label}_{generic_argument_label(string_argument.value)}"
        }
        var enum_argument = shape.as_enum_argument(argument)
        if enum_argument {
            var owner_enum = find_enum_with_value(enum_argument.value)
            if owner_enum {
                var enum_type = enum_type_of(owner_enum)
                types.append(enum_type)
                codes.append("{owner_enum.c_name}_{enum_argument.value}")
                texts.append("e:{enum_argument.value}")
                label = "{label}_{enum_argument.value}"
            } else {
                report("cannot tell which enum '{enum_argument.value}' belongs to here")
                return null
            }
        }
        index = index + 1
    }
    var existing = find_class_by_c_name(label)
    if existing {
        return existing
    }
    return instantiated_with(template, types, codes, texts, label)
}

func instantiated_with(
    template: Analysis.ClassInfo,
    types: List<Analysis.SpiteType>,
    codes: List<String>,
    texts: List<String>,
    label: String,
): Analysis.ClassInfo {
    var class_id = allocate_class_id(label)
    var instance = Analysis.ClassInfo(
        label,
        template.simple_name,
        template.namespace_dotted,
        template.qualified_dotted,
        class_id,
    )
    instance.source_path = template.source_path
    instance.entry_index = template.entry_index
    instance.codegen_names = template.codegen_names
    instance.codegen_types = types
    instance.codegen_codes = codes
    instance.codegen_texts = texts
    instance.codegen_constraints = template.codegen_constraints
    constrain_codegen_types(instance)
    instance.is_singleton = template.is_singleton
    instance.is_stateless_singleton = template.is_stateless_singleton
    instance.holds_nothing = template.holds_nothing
    instance.is_container = template.qualified_dotted == "TypedMemory"
    instance.is_instantiated = true
    if template.qualified_dotted == "Json" and not current_path.starts_with("library/") {
        var written_type = types.first()
        refuse_unwritable_json(template, written_type)
    }
    classes.append(instance)
    builder.add_typedef("typedef struct {label} {label};")
    var saved_owner = current_owner
    var saved_class = current_class
    var saved_function = current_function
    var saved_path = current_path
    var saved_line = current_line
    var saved_symbol_name = bound_symbol_name
    var saved_field_name = bound_field_name
    var saved_field_type = bound_field_type
    var saved_member_owner = bound_member_owner_c_name
    var saved_pattern = bound_pattern
    var saved_function_name = bound_function_name
    var saved_display_name = bound_display_name
    bound_symbol_name = ""
    bound_member_owner_c_name = ""
    bound_pattern = ""
    bound_function_name = ""
    bound_display_name = ""
    crash discovered_classes[template.entry_index]
    var discovered = discovered_classes[template.entry_index]
    resolve_class_body(discovered, instance, true)
    resolve_class_body(discovered, instance, false)
    if template.qualified_dotted == "Concurrent" or template.qualified_dotted == "Parallel" {
        supply_concurrency_functions(instance)
    }
    bound_symbol_name = saved_symbol_name
    bound_field_name = saved_field_name
    bound_field_type = saved_field_type
    bound_member_owner_c_name = saved_member_owner
    bound_pattern = saved_pattern
    bound_function_name = saved_function_name
    bound_display_name = saved_display_name
    current_owner = saved_owner
    current_class = saved_class
    current_function = saved_function
    current_path = saved_path
    current_line = saved_line
    return instance
}

func refuse_unwritable_json(template: Analysis.ClassInfo, written: Analysis.SpiteType) {
    var visited = List<String>()
    var problem = unwritable_json(written, "", visited)
    assert not problem.is_empty()
    var json_type_name = type_display_name(written)
    report(
        "Json cannot write or read '{json_type_name}': {problem}. Json handles classes, lists, dictionaries, enums, Symbols, numbers, Boolean, String and 'T?', so keep what it sees to those, or give Json a class of its own that holds only them",
    )
    refused_json_path = template.source_path
}

func unwritable_json(spite_type: Analysis.SpiteType, path: String, visited: List<String>): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.get_inner()
        return unwritable_json(inner, path, visited)
    }
    var listed = type_shape.as_list(spite_type)
    if listed {
        var element = listed.get_element()
        return unwritable_json(element, path, visited)
    }
    var mapped = type_shape.as_dictionary(spite_type)
    if mapped {
        var entry = mapped.get_element()
        return unwritable_json(entry, path, visited)
    }
    var shown = type_display_name(spite_type)
    var named = "it"
    if not path.is_empty() {
        named = "'{path}'"
    }
    if type_shape.as_union(spite_type) {
        return unwritable_union(spite_type, named, shown)
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    assert class_ref
    if class_ref.has_signature or class_ref.c_name == "Spite_Function" {
        return "{named} is a function value, {shown}, which has no JSON form"
    }
    assert not visited.contains(class_ref.c_name)
    visited.append(class_ref.c_name)
    var information = find_class_by_c_name(class_ref.c_name)
    assert information
    assert not information.is_value_class and not information.is_generic_template
    return unwritable_attribute(information, visited)
}

func unwritable_union(spite_type: Analysis.SpiteType, named: String, shown: String): String {
    if is_shape_type(spite_type) {
        return "{named} is typed as the 'type' {shown}, which says what it has, not what it is, so there is no class to read it back into"
    }
    return "{named} is the union {shown}, and JSON does not say which member a value is"
}

func unwritable_attribute(information: Analysis.ClassInfo, visited: List<String>): String {
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.get_type()
        var problem = unwritable_json(field_type, "{information.simple_name}.{field.name}", visited)
        if not problem.is_empty() {
            return problem
        }
        index = index + 1
    }
    return ""
}

func resolve_generic_constraints() {
    var index = 0
    while index < classes.count() {
        if classes[index].is_generic_template {
            resolve_constraints_of(classes[index])
        }
        index = index + 1
    }
}

func resolve_constraints_of(information: Analysis.ClassInfo) {
    crash discovered_classes[information.entry_index]
    var file = discovered_classes[information.entry_index].get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var generic_line = shape.as_generic_declaration(file.statements[statement_index])
        if generic_line {
            current_path = file.path
            current_line = generic_line.line
            current_owner = information.qualified_dotted
            current_function = ""
            var constraint_name = generic_constraint_name(information, generic_line)
            information.codegen_constraints.append(constraint_name)
        }
        statement_index = statement_index + 1
    }
}

func generic_constraint_name(
    information: Analysis.ClassInfo,
    generic_line: Syntax.Statements.GenericDeclaration,
): String {
    assert generic_line.constraint
    var bare_name = without_dollar(generic_line.name)
    var resolved = resolve_type(generic_line.constraint, information.namespace_dotted)
    assert resolved
    var union_type = type_shape.as_union(resolved)
    if union_type {
        var constrained = find_union_by_c_name(union_type.c_name)
        if constrained {
            if constrained.is_shape {
                return constrained.c_name
            }
        }
    }
    report(
        "'${bare_name}' is constrained by '{type_display_name(resolved)}', which is not a 'type': a constraint names a 'type' the class given must fit, like 'generic ${bare_name}: Printable'",
    )
    return ""
}

func constrain_codegen_types(instance: Analysis.ClassInfo) {
    if classes_resolved {
        check_constraints_of(instance)
        return
    }
    pending_constraint_instances.append(instance)
    pending_constraint_paths.append(current_path)
    pending_constraint_lines.append(current_line)
    pending_constraint_owners.append(current_owner)
    pending_constraint_functions.append(current_function)
}

func check_pending_constraints() {
    var index = 0
    while index < pending_constraint_instances.count() {
        current_path = pending_constraint_paths.get_at(index)
        current_line = pending_constraint_lines.get_at(index)
        current_owner = pending_constraint_owners.get_at(index)
        current_function = pending_constraint_functions.get_at(index)
        var pending_instance = pending_constraint_instances.get_at(index)
        check_constraints_of(pending_instance)
        index = index + 1
    }
}

func check_constraints_of(instance: Analysis.ClassInfo) {
    var index = 0
    while index < instance.codegen_constraints.count() and index < instance.codegen_types.count() {
        var constraint_name = instance.codegen_constraints.get_at(index)
        if not constraint_name.is_empty() {
            var constrained = find_union_by_c_name(constraint_name)
            crash constrained
            var given = instance.codegen_types.get_at(index)
            var problem = constraint_problem(constrained, given)
            if not problem.is_empty() {
                var constrained_name = instance.codegen_names.get_at(index)
                report(
                    "'{type_display_name(given)}' does not fit type '{constrained.simple_name}', which '{instance.simple_name}' requires of ${constrained_name}: {problem}",
                )
                instance.codegen_types[index] = union_type_of(constrained)
            }
        }
        index = index + 1
    }
}

func constraint_problem(constrained: Analysis.UnionInfo, given: Analysis.SpiteType): String {
    var constrained_type = union_type_of(constrained)
    assert not types_equal(given, constrained_type)
    if type_shape.as_nullable(given) {
        return "it may be null, and null has none of what the type needs"
    }
    var candidate = class_of_given(given)
    if candidate {
        var problem = shape_fit_problem(constrained, candidate)
        if not problem.is_empty() {
            failed_constraints.append("{constrained.c_name}>{candidate.c_name}")
        }
        return problem
    }
    return "only a class can fit a 'type'"
}

func class_of_given(given: Analysis.SpiteType): Analysis.ClassInfo? {
    if type_shape.as_string(given) {
        return find_class_by_c_name("SpiteString")
    }
    var boxed_class = boxed_class_of(given)
    if boxed_class {
        return boxed_class
    }
    var container_class = container_class_of(given)
    if container_class {
        return container_class
    }
    var class_ref = type_shape.as_class_ref(given)
    assert class_ref
    assert not class_ref.has_signature
    return find_class_by_c_name(class_ref.c_name)
}

func register_unions(entry: Discovery.DiscoveredClass) {
    var file = entry.get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_union_declaration(file.statements[statement_index])
        if declaration {
            current_path = file.path
            current_line = declaration.line
            current_owner = entry.qualified_dotted
            current_function = ""
            check_type_name(declaration.name, "union")
            var information = Analysis.UnionInfo(
                "{entry.mangled_name}_{declaration.name}",
                declaration.name,
                entry.qualified_dotted,
                entry.qualified_dotted,
                declaration.members,
            )
            var reopened = shape_position(information.c_name)
            if reopened < 0 {
                unions.append(information)
            } else {
                unions[reopened] = information
            }
        }
        statement_index = statement_index + 1
    }
}

func register_shapes(entry: Discovery.DiscoveredClass) {
    var file = entry.get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_type_declaration(file.statements[statement_index])
        if declaration {
            current_path = file.path
            current_line = declaration.line
            current_owner = entry.qualified_dotted
            current_function = ""
            check_type_name(declaration.name, "type")
            var no_members = List<Syntax.Types.Type>()
            var information = Analysis.UnionInfo(
                "{entry.mangled_name}_{declaration.name}",
                declaration.name,
                entry.qualified_dotted,
                entry.qualified_dotted,
                no_members,
            )
            information.is_shape = true
            information.shape_fields = declaration.fields
            var reopened = shape_position(information.c_name)
            if reopened < 0 {
                unions.append(information)
            } else {
                unions[reopened] = information
            }
        }
        statement_index = statement_index + 1
    }
}

func shape_position(c_name: String): Integer {
    var index = 0
    while index < unions.count() {
        if unions[index].c_name == c_name {
            return index
        }
        index = index + 1
    }
    return -1
}

func shape_field_type(information: Analysis.UnionInfo, field_name: String): Analysis.SpiteType? {
    var index = 0
    while index < information.shape_fields.count() {
        var field = information.shape_fields[index]
        if field.name == field_name {
            if field.type_reference {
                var saved_owner = current_owner
                current_owner = information.owner_qualified
                var resolved = resolve_type(field.type_reference, information.owner_namespace)
                current_owner = saved_owner
                return resolved
            }
        }
        index = index + 1
    }
    return null
}

func fit_subject(candidate: Analysis.ClassInfo): String {
    if candidate.c_name.starts_with("Object_") {
        return "this object literal"
    }
    var debugged_type = instance_type_of(candidate)
    return "'{type_display_name(debugged_type)}'"
}

func required_parameter_types(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
): List<Analysis.SpiteType> {
    var types = List<Analysis.SpiteType>()
    var saved_owner = current_owner
    current_owner = information.owner_qualified
    var index = 0
    while index < wanted.parameter_types.count() {
        var resolved = resolve_type(wanted.parameter_types[index], information.owner_namespace)
        if resolved {
            types.append(resolved)
        }
        index = index + 1
    }
    current_owner = saved_owner
    return types
}

func required_return_type(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
): Analysis.SpiteType {
    if wanted.returns_nothing {
        return void_type()
    }
    var resolved = shape_field_type(information, wanted.name)
    if resolved {
        return resolved
    }
    return void_type()
}

func find_required_function(information: Analysis.UnionInfo, name: String): Syntax.Statements.FieldDeclaration? {
    var index = 0
    while index < information.shape_fields.count() {
        if information.shape_fields[index].is_function and information.shape_fields[index].name == name {
            return information.shape_fields[index]
        }
        index = index + 1
    }
    return null
}

func returned_display(spite_type: Analysis.SpiteType, display_name: String): String {
    if type_shape.is_void(spite_type) {
        return "Nothing"
    }
    return with_article(display_name)
}

func required_function_problem(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
    candidate: Analysis.ClassInfo,
): String {
    var function = find_or_instantiate_function(candidate, wanted.name)
    if not function {
        return "it has no function '{wanted.name}'"
    }
    if function {
        var wanted_types = required_parameter_types(information, wanted)
        if function.parameters.count() != wanted_types.count() {
            return "its '{wanted.name}' takes {function.parameters.count()} argument(s), but the type needs {wanted_types.count()}"
        }
        var index = 0
        while index < wanted_types.count() {
            crash function.parameters[index]
            var parameter_type = function.parameters[index].get_type()
            if not types_equal(parameter_type, wanted_types[index]) {
                var names = type_display_names(parameter_type, wanted_types[index])
                var found_name = names.first()
                crash found_name
                var wanted_name = names.last()
                crash wanted_name
                return "argument {index + 1} of its '{wanted.name}' is {with_article(found_name)}, but the type needs {with_article(wanted_name)}"
            }
            index = index + 1
        }
        var wanted_return = required_return_type(information, wanted)
        var function_return_type = function.get_return_type()
        if not types_equal(function_return_type, wanted_return) {
            var names = type_display_names(function_return_type, wanted_return)
            var returned_name = names.first()
            crash returned_name
            var needed_name = names.last()
            crash needed_name
            var returned = returned_display(function_return_type, returned_name)
            var needed = returned_display(wanted_return, needed_name)
            return "its '{wanted.name}' returns {returned}, but the type needs {needed}"
        }
    }
    return ""
}

func shape_call_parameter_types(information: Analysis.UnionInfo, name: String): List<Analysis.SpiteType> {
    var wanted = find_required_function(information, name)
    assert wanted
    return required_parameter_types(information, wanted)
}

func shape_call_return_type(information: Analysis.UnionInfo, name: String): Analysis.SpiteType {
    var wanted = find_required_function(information, name)
    if wanted {
        return required_return_type(information, wanted)
    }
    return string_type()
}

func generate_shape_call(
    information: Analysis.UnionInfo,
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var wanted = find_required_function(information, name)
    if not wanted and name != "to_debug" and name != "to_string" {
        report(
            "type '{information.simple_name}' does not require a function '{name}', so it cannot be called through it",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var parameter_types = shape_call_parameter_types(information, name)
    var return_type = shape_call_return_type(information, name)
    var function_c_name = ensure_shape_caller(information, name)
    var called = generate_generic_call(
        function_c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types,
        return_type,
        scope,
        class_information,
    )
    called.owning_override = true
    return called
}

func ensure_shape_caller(information: Analysis.UnionInfo, name: String): String {
    var function_c_name = "{information.c_name}___call_{name}"
    if not information.caller_names.contains(name) {
        information.caller_names.append(name)
        var parameter_types = shape_call_parameter_types(information, name)
        var return_type = shape_call_return_type(information, name)
        var signature = "{c_type_name(return_type)} {function_c_name}({information.c_name} self"
        var index = 0
        while index < parameter_types.count() {
            signature = "{signature}, {c_type_name(parameter_types[index])} argument_{index}"
            index = index + 1
        }
        builder.add_prototype("{signature});")
    }
    return function_c_name
}

func shape_function_value(
    information: Analysis.UnionInfo,
    wanted: Syntax.Statements.FieldDeclaration,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
): ExpressionResult {
    var caller = ensure_shape_caller(information, wanted.name)
    var parameter_types = required_parameter_types(information, wanted)
    var return_type = required_return_type(information, wanted)
    var signature = Analysis.Types.ClassRefType("Spite_Function")
    signature.has_signature = true
    signature.arguments = parameter_types
    signature.returns = return_type
    if type_shape.is_void(return_type) {
        signature.returns = Analysis.Types.ClassRefType("Nothing")
    }
    var maker = "spite_function_value_{caller}"
    if not function_value_makers.contains(maker) {
        function_value_makers.append(maker)
        var argument_class = find_class_by_c_name("Spite_Argument")
        crash argument_class
        var class_type = class_type_of(argument_class)
        var arguments_list_name = ensure_list(class_type)
        var returned = signature.returns
        crash returned
        var argument_lines = List<String>()
        var parameter_index = 0
        while parameter_index < parameter_types.count() {
            var argument_symbol = ensure_symbol("argument_{parameter_index}")
            argument_lines.append(
                "{arguments_list_name}_append(described->_arguments_, Spite_Argument___make({argument_symbol}, {class_object_call(parameter_types[parameter_index])}));",
            )
            parameter_index = parameter_index + 1
        }
        var lines = List<String>()
        lines.append("Spite_Function* {maker}({information.c_name} owner) \{")
        lines.append(
            "Spite_Function* described = Spite_Function___make({ensure_symbol(wanted.name)}, {class_object_call(returned)});",
        )
        add_lazy_arguments(maker, argument_lines, lines)
        lines.append("described->spite_owner = {information.c_name}___retain(owner);")
        lines.append("described->spite_release_owner = (void (*)(void*)){information.c_name}___release;")
        if parameter_types.is_empty() and type_shape.is_void(return_type) {
            lines.append("described->spite_call = (void (*)(void*)){caller};")
        }
        lines.append("described->spite_typed_call = (void*){caller};")
        lines.append("return described;")
        lines.append("}")
        builder.add_prototype("Spite_Function* {maker}({information.c_name} owner);")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    var code = "{maker}({object_result.code})"
    if owns(object_result, object_ast) {
        var owner_temporary = next_temporary()
        var value_temporary = next_temporary()
        code = "(\{ {information.c_name} {owner_temporary} = {object_result.code}; Spite_Function* {value_temporary} = {maker}({owner_temporary}); {information.c_name}___release({owner_temporary}); {value_temporary}; })"
    }
    var typed: Analysis.SpiteType = signature
    var made = ExpressionResult(code, typed)
    made.owning_override = true
    return made
}

func shape_member_function(member: Analysis.ClassInfo, name: String): Analysis.FunctionInfo? {
    var function = find_or_instantiate_function(member, name)
    if function {
        return function
    }
    assert name == "to_string"
    return find_or_instantiate_function(member, "to_debug")
}

func emit_late_shape_callers(): Integer {
    var emitted = 0
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.is_shape and information.emitted_callers < information.caller_names.count() {
            emitted = emitted + information.caller_names.count() - information.emitted_callers
            emit_shape_callers(information)
        }
        index = index + 1
    }
    return emitted
}

func emit_shape_callers(information: Analysis.UnionInfo) {
    var caller_index = information.emitted_callers
    while caller_index < information.caller_names.count() {
        var name = information.caller_names[caller_index]
        var parameter_types = shape_call_parameter_types(information, name)
        var return_type = shape_call_return_type(information, name)
        var lines = List<String>()
        var signature = "{c_type_name(return_type)} {information.c_name}___call_{name}({information.c_name} self"
        var passed = ""
        var index = 0
        while index < parameter_types.count() {
            signature = "{signature}, {c_type_name(parameter_types[index])} argument_{index}"
            passed = "{passed}, argument_{index}"
            index = index + 1
        }
        lines.append("{signature}) \{")
        var member_index = 0
        while member_index < information.members.count() {
            var member = information.members[member_index]
            var receiver = "({member.c_name}*)self"
            if boxed_value_types.has(member.c_name) {
                receiver = "((SpiteBox_{member.c_name}*)self)->value"
            }
            var called_function = shape_member_function(member, name)
            crash called_function
            var call = "{called_function.c_name}({receiver}{passed})"
            var member_test = class_id_test("self", member)
            if type_shape.is_void(return_type) {
                lines.append("if {member_test} \{ {call}; return; }")
            } else {
                lines.append("if {member_test} return {call};")
            }
            member_index = member_index + 1
        }
        index = 0
        while index < parameter_types.count() {
            var release_line = release_statement(parameter_types[index], "argument_{index}")
            lines.append(release_line)
            index = index + 1
        }
        if not type_shape.is_void(return_type) {
            lines.append("return {default_value_for_type(return_type)};")
        }
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
        caller_index = caller_index + 1
    }
    information.emitted_callers = caller_index
}

func admit_to_union(information: Analysis.UnionInfo, candidate: Analysis.ClassInfo) {
    assert not information.has_member(candidate.c_name)
    if not information.is_shape {
        report("'{candidate.simple_name}' is not a member of union '{information.simple_name}'")
        return
    }
    var problem = shape_fit_problem(information, candidate)
    if not problem.is_empty() {
        if not failed_constraints.contains("{information.c_name}>{candidate.c_name}") {
            report("{fit_subject(candidate)} does not fit type '{information.simple_name}': {problem}")
        }
        return
    }
    information.members.append(candidate)
    admit_along_flows(information, candidate)
}

func shape_fit_problem(information: Analysis.UnionInfo, candidate: Analysis.ClassInfo): String {
    var index = 0
    while index < information.shape_fields.count() {
        var wanted = information.shape_fields[index]
        if wanted.is_function {
            var function_problem = required_function_problem(information, wanted, candidate)
            if not function_problem.is_empty() {
                return function_problem
            }
        } else {
            var found = candidate.find_field(wanted.name)
            if not found {
                return "it has no attribute '{wanted.name}'"
            }
            crash found
            var wanted_type = shape_field_type(information, wanted.name)
            if wanted_type {
                var found_type = found.get_type()
                if not types_equal(found_type, wanted_type) {
                    var names = type_display_names(found_type, wanted_type)
                    var found_name = names.first()
                    crash found_name
                    var wanted_name = names.last()
                    crash wanted_name
                    return "attribute '{wanted.name}' is {with_article(found_name)}, but the type needs {with_article(wanted_name)}"
                }
            }
        }
        index = index + 1
    }
    return ""
}

func ensure_shape_reader(information: Analysis.UnionInfo, field_name: String, field_type: Analysis.SpiteType): String {
    var function_c_name = "{information.c_name}___read_{field_name}"
    if not information.accessor_names.contains(field_name) {
        information.accessor_names.append(field_name)
        builder.add_prototype("{c_type_name(field_type)} {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func ensure_shape_writer(information: Analysis.UnionInfo, field_name: String, field_type: Analysis.SpiteType): String {
    var function_c_name = "{information.c_name}___write_{field_name}"
    if not information.writer_names.contains(field_name) {
        information.writer_names.append(field_name)
        builder.add_prototype("void {function_c_name}({information.c_name} self, {c_type_name(field_type)} value);")
    }
    return function_c_name
}

func ensure_union_class_of(information: Analysis.UnionInfo): String {
    var function_c_name = "{information.c_name}___class_of"
    if not information.class_of_used {
        information.class_of_used = true
        builder.add_prototype("Spite_Class* {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func emit_union_class_of_bodies() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.class_of_used {
            var lines = List<String>()
            lines.append("Spite_Class* {information.c_name}___class_of({information.c_name} self) \{")
            var member_index = 0
            while member_index < information.members.count() {
                var member = information.members[member_index]
                var class_type = class_type_of(member)
                if boxed_value_types.has(member.c_name) {
                    crash boxed_value_types[member.c_name]
                    class_type = boxed_value_types[member.c_name]
                }
                lines.append("if {class_id_test("self", member)} return {class_object_call(class_type)};")
                member_index = member_index + 1
            }
            lines.append(
                "return {ensure_class_object(information.simple_name, information.owner_namespace, information.c_name)}();",
            )
            lines.append("}")
            var joined_lines = lines.join("\n")
            builder.add_support(joined_lines)
        }
        index = index + 1
    }
}

func emit_union_release(information: Analysis.UnionInfo) {
    var name = information.c_name
    var release_lines = List<String>()
    release_lines.append("void {name}___release({name} self) \{")
    release_lines.append("if (self == 0) return;")
    var member_index = 0
    while member_index < information.members.count() {
        var member = information.members[member_index]
        var released = "{member.c_name}___release(({member.c_name}*)self)"
        if boxed_value_types.has(member.c_name) {
            released = "spite_box_release(self)"
        }
        release_lines.append("if {class_id_test("self", member)} \{ {released}; return; }")
        member_index = member_index + 1
    }
    release_lines.append("}")
    var joined_release_lines = release_lines.join("\n")
    builder.add_support(joined_release_lines)
}

func emit_shape_peekers(information: Analysis.UnionInfo) {
    var index = 0
    while index < information.peeker_names.count() {
        var field_name = information.peeker_names[index]
        var field_type = shape_field_type(information, field_name)
        crash field_type
        var lines = List<String>()
        lines.append("{c_type_name(field_type)} {information.c_name}___peek_{field_name}({information.c_name} self) \{")
        var member_index = 0
        while member_index < information.members.count() {
            var member = information.members[member_index]
            lines.append(
                "if {class_id_test("self", member)} return (({member.c_name}*)self)->{c_value_name(field_name)};",
            )
            member_index = member_index + 1
        }
        lines.append("return 0;")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
        index = index + 1
    }
}

func emit_shape_bodies() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.is_shape {
            emit_union_release(information)
            emit_shape_callers(information)
            var reader_index = 0
            while reader_index < information.accessor_names.count() {
                var field_name = information.accessor_names[reader_index]
                var field_type = shape_field_type(information, field_name)
                if field_type {
                    mark_members_read(information.members, field_name)
                    var lines = List<String>()
                    lines.append(
                        "{c_type_name(field_type)} {information.c_name}___read_{field_name}({information.c_name} self) \{",
                    )
                    var member_index = 0
                    while member_index < information.members.count() {
                        var member = information.members[member_index]
                        lines.append(
                            "if {class_id_test("self", member)} return {retain_call(field_type, "(({member.c_name}*)self)->{c_value_name(field_name)}")};",
                        )
                        member_index = member_index + 1
                    }
                    lines.append("return {default_value_for_type(field_type)};")
                    lines.append("}")
                    var joined_lines = lines.join("\n")
                    builder.add_support(joined_lines)
                }
                reader_index = reader_index + 1
            }
            emit_shape_peekers(information)
            var writer_index = 0
            while writer_index < information.writer_names.count() {
                var written = information.writer_names[writer_index]
                var written_type = shape_field_type(information, written)
                if written_type {
                    var writer_lines = List<String>()
                    writer_lines.append(
                        "void {information.c_name}___write_{written}({information.c_name} self, {c_type_name(written_type)} value) \{",
                    )
                    var writer_member_index = 0
                    while writer_member_index < information.members.count() {
                        var writer_member = information.members[writer_member_index]
                        var target = "(({writer_member.c_name}*)self)->{c_value_name(written)}"
                        writer_lines.append(
                            "if {class_id_test("self", writer_member)} \{ {release_statement(written_type, target)} {target} = value; return; }",
                        )
                        writer_member_index = writer_member_index + 1
                    }
                    var release_line = release_statement(written_type, "value")
                    writer_lines.append(release_line)
                    writer_lines.append("}")
                    var joined_writer_lines = writer_lines.join("\n")
                    builder.add_support(joined_writer_lines)
                }
                writer_index = writer_index + 1
            }
        }
        index = index + 1
    }
}

func generate_shape_read(
    information: Analysis.UnionInfo,
    field_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
): ExpressionResult {
    var field_type = shape_field_type(information, field_name)
    if not field_type {
        report("type '{information.simple_name}' has no attribute '{field_name}'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash field_type
    mark_members_read(information.members, field_name)
    var reader = ensure_shape_reader(information, field_name, field_type)
    var lines = List<String>()
    lines.append("{information.c_name} spite_shaped = {object_result.code};")
    lines.append("{c_type_name(field_type)} spite_shaped_value = {reader}(spite_shaped);")
    if owns(object_result, object_ast) {
        lines.append("{information.c_name}___release(spite_shaped);")
    }
    lines.append("spite_shaped_value;")
    var read = ExpressionResult("(\{ {lines.join(" ")} })", field_type)
    read.owning_override = true
    if not owns(object_result, object_ast) and not hot_reload and type_shape.as_class_ref(field_type) {
        read.peek_union = information
        read.peek_field = field_name
        read.peek_object = object_result.code
    }
    return read
}

func peeked_code(result: ExpressionResult): String {
    assert result.peek_union
    var field_type = result.get_type()
    var peeker = ensure_shape_peeker(result.peek_union, result.peek_field, field_type)
    return "{peeker}({result.peek_object})"
}

func ensure_shape_peeker(information: Analysis.UnionInfo, field_name: String, field_type: Analysis.SpiteType): String {
    var function_c_name = "{information.c_name}___peek_{field_name}"
    if not information.peeker_names.contains(field_name) {
        information.peeker_names.append(field_name)
        builder.add_prototype("{c_type_name(field_type)} {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func generate_object_literal(
    literal: Syntax.Expressions.ObjectLiteralExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var names = List<String>()
    var types = List<Analysis.SpiteType>()
    var codes = List<String>()
    var label = "Object"
    var index = 0
    while index < literal.fields.count() {
        var field = literal.fields[index]
        if field.value {
            var saved_counter = temporary_counter
            var probe = generate_expression(field.value, scope, class_information)
            rewind_temporaries(saved_counter)
            names.append(field.name)
            var probe_type = probe.get_type()
            types.append(probe_type)
            var stored_code = coerce_for_store(field.value, probe_type, scope, class_information)
            codes.append(stored_code)
            label = "{label}_{field.name}_{type_label(probe_type)}"
        }
        index = index + 1
    }
    var information = find_class_by_c_name(label)
    if not information {
        var class_id = allocate_class_id(label)
        var created = Analysis.ClassInfo(label, "Object", "", label, class_id)
        var field_index = 0
        while field_index < names.count() {
            var listed_name = names[field_index]
            var listed_type = types[field_index]
            var default_value_code = default_value_for_type(listed_type)
            created.fields.append(Analysis.FieldInfo(listed_name, listed_type, default_value_code))
            field_index = field_index + 1
        }
        classes.append(created)
        builder.add_typedef("typedef struct {label} {label};")
        var saved_owner = current_owner
        emit_class(created)
        current_owner = saved_owner
    }
    var lines = List<String>()
    var temporary = next_temporary()
    lines.append("{label}* {temporary} = {label}___allocate();")
    var assign_index = 0
    while assign_index < names.count() {
        var target = "{temporary}->{c_value_name(names[assign_index])}"
        crash codes[assign_index]
        crash types[assign_index]
        lines.append("{release_statement(types[assign_index], target)} {target} = {codes[assign_index]};")
        assign_index = assign_index + 1
    }
    lines.append("{temporary};")
    var built = ExpressionResult("(\{ {lines.join(" ")} })", Analysis.Types.ClassRefType(label))
    built.owning_override = true
    return built
}

func shape_default(information: Analysis.UnionInfo): String {
    var names = List<String>()
    var types = List<Analysis.SpiteType>()
    var label = "Object"
    var index = 0
    while index < information.shape_fields.count() {
        var field = information.shape_fields[index]
        if field.is_function {
            return "0"
        }
        var field_type = shape_field_type(information, field.name)
        crash field_type
        names.append(field.name)
        types.append(field_type)
        label = "{label}_{field.name}_{type_label(field_type)}"
        index = index + 1
    }
    var information_class = find_class_by_c_name(label)
    if not information_class {
        var class_id = allocate_class_id(label)
        var created = Analysis.ClassInfo(label, "Object", "", label, class_id)
        var field_index = 0
        while field_index < names.count() {
            var listed_name = names[field_index]
            var listed_type = types[field_index]
            var default_value_code = default_value_for_type(listed_type)
            created.fields.append(Analysis.FieldInfo(listed_name, listed_type, default_value_code))
            field_index = field_index + 1
        }
        classes.append(created)
        builder.add_typedef("typedef struct {label} {label};")
        builder.add_prototype("{label}* {label}___default(void);")
        information_class = created
    }
    crash information_class
    if not information.has_member(label) {
        admit_to_union(information, information_class)
    }
    return "(({information.c_name}){label}___default())"
}

func resolve_union_members() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var member_index = 0
        while member_index < information.member_types.count() {
            var member_class = class_of_type_reference(
                information.member_types[member_index],
                information.owner_namespace,
            )
            if member_class {
                information.members.append(member_class)
            } else {
                report("a member of union '{information.simple_name}' is not a class")
            }
            member_index = member_index + 1
        }
        index = index + 1
    }
}

func class_of_type_reference(type_reference: Syntax.Types.Type, current_namespace: String): Analysis.ClassInfo? {
    var named = shape.as_named_type(type_reference)
    if named {
        var joined_path = named.path.join(".")
        return find_class(joined_path, current_namespace)
    }
    return null
}

func find_union(name: String): Analysis.UnionInfo? {
    var fallback: Analysis.UnionInfo? = null
    var index = 0
    while index < unions.count() {
        var candidate = unions[index]
        if candidate.simple_name == name {
            if candidate.owner_qualified == current_owner {
                return candidate
            }
            fallback = candidate
        }
        index = index + 1
    }
    return fallback
}

func find_union_qualified(owner_qualified: String, name: String): Analysis.UnionInfo? {
    var index = 0
    while index < unions.count() {
        var candidate = unions[index]
        if candidate.simple_name == name and candidate.owner_qualified == owner_qualified {
            return candidate
        }
        index = index + 1
    }
    return null
}

func find_union_by_c_name(c_name: String): Analysis.UnionInfo? {
    return unions.find_by_c_name(c_name)
}

func union_type_of(information: Analysis.UnionInfo): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.UnionType(information.c_name)
    return resolved
}

func class_type_of(information: Analysis.ClassInfo): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(information.c_name)
    return resolved
}

func class_id_test(code: String, information: Analysis.ClassInfo): String {
    if information.c_name == "SpiteString" {
        return "(((SpiteHeader*)({code}))->class_id <= 0)"
    }
    return "(((SpiteHeader*)({code}))->class_id == {information.class_id})"
}

func shaped_value(
    code: String,
    from: Analysis.SpiteType,
    to: Analysis.SpiteType,
    information: Analysis.UnionInfo,
): String {
    if type_shape.as_string(from) {
        var string_class = find_class_by_c_name("SpiteString")
        crash string_class
        admit_to_union(information, string_class)
        return "(({information.c_name})({code}))"
    }
    var boxed_class = boxed_class_of(from)
    if boxed_class {
        admit_to_union(information, boxed_class)
        return "{ensure_box(boxed_class, from)}({code})"
    }
    var container_class = container_class_of(from)
    if container_class {
        admit_to_union(information, container_class)
        return "(({information.c_name})({code}))"
    }
    var from_union = type_shape.as_union(from)
    if from_union {
        var from_information = find_union_by_c_name(from_union.c_name)
        if from_information {
            var member_index = 0
            while member_index < from_information.members.count() {
                admit_to_union(information, from_information.members[member_index])
                member_index = member_index + 1
            }
            if from_information.is_shape {
                record_shape_flow(from_information, information)
            }
        }
    } else {
        report_mismatch(from, to)
    }
    return "(({information.c_name})({code}))"
}

func record_shape_flow(source: Analysis.UnionInfo, target: Analysis.UnionInfo) {
    var key = "{source.c_name}>{target.c_name}"
    assert not shape_flow_keys.contains(key)
    shape_flow_keys.append(key)
    shape_flow_sources.append(source.c_name)
    shape_flow_targets.append(target)
}

func admit_along_flows(source: Analysis.UnionInfo, candidate: Analysis.ClassInfo) {
    var index = 0
    while index < shape_flow_sources.count() {
        if shape_flow_sources[index] == source.c_name {
            crash shape_flow_targets[index]
            admit_to_union(shape_flow_targets[index], candidate)
        }
        index = index + 1
    }
}

func is_boxed_into_shape(from: Analysis.SpiteType, to: Analysis.SpiteType): Boolean {
    var to_union = type_shape.as_union(to)
    assert to_union
    var information = find_union_by_c_name(to_union.c_name)
    assert information
    assert information.is_shape
    var boxed_class = boxed_class_of(from)
    if boxed_class {
        return true
    }
    return false
}

func is_shape_type(spite_type: Analysis.SpiteType): Boolean {
    var union_type = type_shape.as_union(spite_type)
    assert union_type
    var information = find_union_by_c_name(union_type.c_name)
    assert information
    return information.is_shape
}

func container_class_of(from: Analysis.SpiteType): Analysis.ClassInfo? {
    var list_type = type_shape.as_list(from)
    if list_type {
        var element = list_type.get_element()
        return list_class_of(element)
    }
    var dictionary_type = type_shape.as_dictionary(from)
    if dictionary_type {
        var dictionary_element = dictionary_type.get_element()
        var ensured_dictionary = ensure_dictionary(dictionary_element)
        return find_class_by_c_name(ensured_dictionary)
    }
    return null
}

func instance_type_of(information: Analysis.ClassInfo): Analysis.SpiteType {
    if synthetic_value_types.has(information.c_name) {
        crash synthetic_value_types[information.c_name]
        return synthetic_value_types[information.c_name]
    }
    if information.qualified_dotted == "List" and information.codegen_types.count() == 1 {
        return list_type_of(information.codegen_types[0])
    }
    if information.qualified_dotted == "Dictionary" and information.codegen_types.count() == 1 {
        return dictionary_type_of(information.codegen_types[0])
    }
    return value_class_type(information)
}

func debug_class_of(debugged_type: Analysis.SpiteType): Analysis.ClassInfo {
    var template_name = "Spite.Debug"
    if type_shape.as_class_ref(debugged_type) {
        template_name = "Spite.DebugInstance"
    }
    var debug_template = find_class_by_qualified(template_name)
    crash debug_template
    var label = "{debug_template.c_name}__{exact_type_label(debugged_type)}"
    var existing = find_class_by_c_name(label)
    if existing {
        return existing
    }
    var types = List<Analysis.SpiteType>()
    types.append(debugged_type)
    var codes = List<String>()
    codes.append("")
    var texts = List<String>()
    texts.append("")
    return instantiated_with(debug_template, types, codes, texts, label)
}

func automatic_debug(information: Analysis.ClassInfo): Analysis.FunctionInfo? {
    assert not information.is_generic_template
    var debugged_type = instance_type_of(information)
    var debug_class = debug_class_of(debugged_type)
    var described = find_or_instantiate_function(debug_class, "text")
    crash described
    var string_spite_type = string_type()
    var no_parameters = List<Analysis.ParamInfo>()
    var no_statements = List<Syntax.Statements.Statement>()
    var function = Analysis.FunctionInfo(
        "to_debug",
        "{information.c_name}_to_debug",
        no_parameters,
        string_spite_type,
        no_statements,
        false,
    )
    function.has_body = false
    var body = "{debug_class.c_name}* spite_debug = {singleton_call(debug_class)};\nSpiteString* spite_text = {described.c_name}(spite_debug, {retain_call(debugged_type, "self")});\n{debug_class.c_name}___release(spite_debug);\nreturn spite_text;"
    function.supplied_body = body
    information.functions.append(function)
    if synthetic_value_types.has(information.c_name) {
        function.is_emitted = true
        var signature = "SpiteString* {function.c_name}({c_type_name(debugged_type)} self)"
        builder.add_prototype("{signature};")
        builder.add_support("{signature} \{\n{body}\n}")
        return function
    }
    builder.add_prototype("{function_signature(information, function)};")
    return function
}

func boxed_class_of(from: Analysis.SpiteType): Analysis.ClassInfo? {
    var scalar = type_shape.as_scalar(from)
    if scalar {
        return value_class_of(scalar.kind)
    }
    if type_shape.is_symbol(from) {
        return synthetic_value_class("SpiteSymbol", from, "return SpiteString___retain(self);")
    }
    var enum_type = type_shape.as_enum(from)
    if enum_type {
        return synthetic_value_class(
            enum_type.c_name,
            from,
            "return spite_string_from_cstring_owned({enum_type.c_name}___name(self));",
        )
    }
    return null
}

func synthetic_value_class(c_name: String, value_type: Analysis.SpiteType, to_string_body: String): Analysis.ClassInfo {
    var existing = synthetic_value_classes.find_by_c_name(c_name)
    if existing {
        return existing
    }
    var display_name = type_display_name(value_type)
    var created = Analysis.ClassInfo(c_name, display_name, "", display_name, 0)
    created.is_value_class = true
    var string_spite_type = string_type()
    var no_parameters = List<Analysis.ParamInfo>()
    var no_statements = List<Syntax.Statements.Statement>()
    var to_string = Analysis.FunctionInfo(
        "to_string",
        "{c_name}_to_string",
        no_parameters,
        string_spite_type,
        no_statements,
        false,
    )
    to_string.is_emitted = true
    created.functions.append(to_string)
    synthetic_value_classes.append(created)
    synthetic_value_types[c_name] = value_type
    var signature = "SpiteString* {c_name}_to_string({c_type_name(value_type)} self)"
    builder.add_prototype("{signature};")
    builder.add_support("{signature} \{\n{to_string_body}\n}")
    return created
}

func ensure_box(member: Analysis.ClassInfo, value_type: Analysis.SpiteType): String {
    var maker = "spite_box_{member.c_name}"
    if boxed_value_types.has(member.c_name) {
        return maker
    }
    if boxed_value_types.count() == 0 {
        builder.add_prototype("void spite_box_release(void* self);")
        builder.add_support(
            "void spite_box_release(void* self) \{\nif (SPITE_COUNT_DOWN(((SpiteHeader*)self)->ref_count) > 0) return;\nSPITE_FREE(self);\n}",
        )
    }
    boxed_value_types[member.c_name] = value_type
    member.class_id = allocate_class_id(member.simple_name)
    var box = "SpiteBox_{member.c_name}"
    var value_c_type = c_type_name(value_type)
    builder.add_typedef("typedef struct {box} \{ SpiteHeader header; {value_c_type} value; } {box};")
    builder.add_prototype("void* {maker}({value_c_type} value);")
    var registered = debug_registration("self", "{member.class_id}")
    builder.add_support(
        "void* {maker}({value_c_type} value) \{\n{box}* self = ({box}*)SPITE_MALLOC(sizeof({box}));\nself->header.ref_count = 1;\nself->header.class_id = {member.class_id};\n{registered}self->value = value;\nreturn self;\n}",
    )
    return maker
}

func emit_unions() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        var name = information.c_name
        builder.add_typedef("typedef void* {name};")
        builder.add_prototype("{name} {name}___retain({name} self);")
        builder.add_prototype("void {name}___release({name} self);")
        builder.add_support(
            "{name} {name}___retain({name} self) \{\nif (self != 0) SPITE_COUNT_UP(((SpiteHeader*)self)->ref_count);\nreturn self;\n}",
        )
        if not information.is_shape {
            emit_union_release(information)
        }
        index = index + 1
    }
}

func register_enums(entry: Discovery.DiscoveredClass) {
    var file = entry.get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_enum_declaration(file.statements[statement_index])
        if declaration {
            current_path = file.path
            current_line = declaration.line
            current_owner = entry.qualified_dotted
            current_function = ""
            check_type_name(declaration.name, "enum")
            var value_index = 0
            while value_index < declaration.values.count() {
                check_value_name(declaration.values[value_index], "enum value")
                value_index = value_index + 1
            }
            var enumeration = Analysis.EnumInfo(
                "{entry.mangled_name}_{declaration.name}",
                declaration.name,
                entry.qualified_dotted,
                declaration.values,
            )
            enums.append(enumeration)
        }
        statement_index = statement_index + 1
    }
}

func find_enum(name: String): Analysis.EnumInfo? {
    var fallback: Analysis.EnumInfo? = null
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        if candidate.simple_name == name {
            if candidate.owner_qualified == current_owner {
                return candidate
            }
            fallback = candidate
        }
        index = index + 1
    }
    return fallback
}

func find_enum_qualified(owner_qualified: String, name: String): Analysis.EnumInfo? {
    var index = 0
    while index < enums.count() {
        var candidate = enums[index]
        if candidate.simple_name == name and candidate.owner_qualified == owner_qualified {
            return candidate
        }
        index = index + 1
    }
    return null
}

func any_enum_has(value: String): Boolean {
    var index = 0
    while index < enums.count() {
        if enums[index].has_value(value) {
            return true
        }
        index = index + 1
    }
    return false
}

func find_enum_with_value(value: String): Analysis.EnumInfo? {
    var found: Analysis.EnumInfo? = null
    var matches = 0
    var index = 0
    while index < enums.count() {
        if enums[index].has_value(value) {
            found = enums[index]
            matches = matches + 1
        }
        index = index + 1
    }
    if matches == 1 {
        return found
    }
    return null
}

func enum_type_of(information: Analysis.EnumInfo): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.EnumType(information.c_name, information.values)
    return resolved
}

func enum_value_code(literal: Syntax.Expressions.EnumLiteralExpression, enum_type: Analysis.Types.EnumType): String {
    if not enum_type.values.contains(literal.value) {
        report("'{literal.value}' is not a value of this enum")
    }
    return "{enum_type.c_name}_{literal.value}"
}

func emit_enums() {
    var index = 0
    while index < enums.count() {
        var information = enums[index]
        var typedef_lines = List<String>()
        typedef_lines.append("typedef enum \{")
        var name_lines = List<String>()
        name_lines.append("const char* {information.c_name}___name({information.c_name} value) \{")
        name_lines.append("switch (value) \{")
        var value_index = 0
        while value_index < information.values.count() {
            var value_name = information.values[value_index]
            typedef_lines.append("{information.c_name}_{value_name},")
            name_lines.append("case {information.c_name}_{value_name}: return \"{value_name}\";")
            value_index = value_index + 1
        }
        typedef_lines.append("} {information.c_name};")
        name_lines.append("}")
        name_lines.append("return \"\";")
        name_lines.append("}")
        var joined_typedef_lines = typedef_lines.join("\n")
        builder.add_typedef(joined_typedef_lines)
        builder.add_prototype("const char* {information.c_name}___name({information.c_name} value);")
        var joined_name_lines = name_lines.join("\n")
        builder.add_support(joined_name_lines)
        index = index + 1
    }
}

func find_class_by_qualified(qualified: String): Analysis.ClassInfo? {
    index_new_classes()
    var position = class_by_qualified.get(qualified)
    assert position
    return classes[position]
}

func find_class_by_c_name(c_name: String): Analysis.ClassInfo? {
    index_new_classes()
    var position = class_by_c_name.get(c_name)
    assert position
    return classes[position]
}

func index_new_classes() {
    while classes_indexed < classes.count() {
        var information = classes[classes_indexed]
        if not class_by_qualified.has(information.qualified_dotted) {
            class_by_qualified.set(information.qualified_dotted, classes_indexed)
        }
        if not class_by_c_name.has(information.c_name) {
            class_by_c_name.set(information.c_name, classes_indexed)
        }
        classes_indexed = classes_indexed + 1
    }
}

func find_class(name: String, current_namespace: String): Analysis.ClassInfo? {
    var segments = current_namespace.split(".")
    if current_namespace.is_empty() {
        segments.clear()
    }
    while not segments.is_empty() {
        var inside = find_class_by_qualified("{segments.join(".")}.{name}")
        if inside {
            return inside
        }
        if segments.last() == name {
            var joined_segments = segments.join(".")
            var folder_entry = find_class_by_qualified(joined_segments)
            if folder_entry {
                return folder_entry
            }
        }
        segments.remove_last()
    }
    return find_class_by_qualified(name)
}

func nearest_declaring_owner(name: String, current_namespace: String): String {
    var segments = current_namespace.split(".")
    if current_namespace.is_empty() {
        segments.clear()
    }
    while not segments.is_empty() {
        var owner = segments.join(".")
        if declares_type_named(owner, name) {
            return owner
        }
        assert not find_class_by_qualified("{owner}.{name}")
        assert segments.last() != name or not find_class_by_qualified(owner)
        segments.remove_last()
    }
    return ""
}

func declares_type_named(owner: String, name: String): Boolean {
    if find_union_qualified(owner, name) {
        return true
    }
    if find_enum_qualified(owner, name) {
        return true
    }
    return false
}

func resolve_classes(discovered: List<Discovery.DiscoveredClass>) {
    resolve_discovered(discovered, true)
    resolve_discovered(discovered, false)
}

func resolve_discovered(discovered: List<Discovery.DiscoveredClass>, functions_pass: Boolean) {
    var index = 0
    while index < discovered.count() {
        var position = first_discovered_class + index
        crash classes[position]
        if not classes[position].is_generic_template {
            resolve_class_body(discovered[index], classes[position], functions_pass)
        }
        index = index + 1
    }
}

func resolve_class_body(entry: Discovery.DiscoveredClass, information: Analysis.ClassInfo, functions_pass: Boolean) {
    var file = entry.get_file()
    current_owner = information.qualified_dotted
    current_class = information
    current_path = information.source_path
    current_function = ""
    var empty_scope = Scope(null)
    var statement_index = 0
    while statement_index < file.statements.count() {
        var statement = file.statements[statement_index]
        current_line = statement.line
        current_path = information.source_path
        var reopened_function = shape.as_function_declaration(statement)
        if reopened_function {
            if not reopened_function.source_path.is_empty() {
                current_path = reopened_function.source_path
            }
        }
        var reopened_variable = shape.as_variable_declaration(statement)
        if reopened_variable {
            if not reopened_variable.source_path.is_empty() {
                current_path = reopened_variable.source_path
            }
        }
        var variable_declaration = shape.as_variable_declaration(statement)
        if variable_declaration {
            if not functions_pass {
                resolve_field(variable_declaration, information, empty_scope)
            }
        }
        var function_declaration = shape.as_function_declaration(statement)
        if function_declaration {
            if functions_pass {
                resolve_function(function_declaration, information)
            }
        }
        statement_index = statement_index + 1
    }
}

func infer_declared_type(
    annotation: Syntax.Types.Type?,
    initializer: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType {
    if annotation {
        var resolved = resolve_type(annotation, class_information.qualified_dotted)
        if resolved {
            return resolved
        }
        return void_type()
    }
    var result = generate_expression(initializer, scope, class_information)
    return result.get_type()
}

func resolve_field(declaration: Syntax.Statements.VariableDeclaration, information: Analysis.ClassInfo, scope: Scope) {
    assert declaration.value
    check_value_name(declaration.name, "attribute")
    report_nested_calls_in(declaration.value)
    report_long_construction(declaration)
    report_singletons_in_declared(declaration.value, information)
    report_written_handle_type(declaration)
    if information.is_value_class and information.c_name != "SpiteString" {
        var bound_singleton = constructed_singleton(declaration.value, information)
        if bound_singleton {
            information.memory_binding = declaration.name
            return
        }
        information.memory_bytes = declared_memory_bytes(declaration, information)
        information.memory_path = current_path
        information.memory_line = current_line
        var memory_type = long_type()
        information.fields.append(Analysis.FieldInfo(declaration.name, memory_type, "0"))
        return
    }
    var field_type = infer_declared_type(declaration.type_reference, declaration.value, scope, information)
    var default_code = coerce_for_store(declaration.value, field_type, scope, information)
    if declaration.hardcoded_value {
        default_code = coerce_for_store(declaration.hardcoded_value, field_type, scope, information)
        hardcoded_settings.append(declaration)
    }
    information.fields.append(Analysis.FieldInfo(declaration.name, field_type, default_code))
}

func hardcoded_setting(target_class: Analysis.ClassInfo, name: String): Syntax.Statements.VariableDeclaration? {
    assert target_class.c_name == "Build"
    return hardcoded_settings.find_by_name(name)
}

func is_hardcoded_setting_name(name: String): Boolean {
    var index = 0
    while index < hardcoded_settings.count() {
        if hardcoded_settings[index].name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func hardcoded_setting_value(
    setting: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash setting.hardcoded_value
    var value = generate_expression(setting.hardcoded_value, scope, class_information)
    value.owning_override = false
    var text = constant_text(setting.hardcoded_value)
    if text {
        value.constant_text = text
    }
    return value
}

func symbol_parameter_of(declaration: Syntax.Statements.FunctionDeclaration): String {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.type_reference {
            var named = shape.as_named_type(parameter.type_reference)
            if named {
                if named.path.count() == 1 and named.path[0] == "Symbol" {
                    return parameter.name
                }
            }
        }
        index = index + 1
    }
    return ""
}

func register_template(declaration: Syntax.Statements.FunctionDeclaration, information: Analysis.ClassInfo): Boolean {
    var symbol_parameter = symbol_parameter_of(declaration)
    assert not symbol_parameter.is_empty()
    var padded_name = "_{declaration.name}_"
    var position = padded_name.index_of("_{symbol_parameter}_")
    if position < 0 {
        var passed_range = symbol_range_of(declaration, symbol_parameter)
        assert passed_range
        var passed_template_information = Analysis.TemplateInfo(declaration, symbol_parameter, declaration.name, "")
        passed_template_information.range = passed_range
        passed_template_information.passed = true
        information.templates.append(passed_template_information)
        return true
    }
    var prefix = declaration.name.slice(0, position)
    var symbol_parameter_length = symbol_parameter.length()
    var name_length = declaration.name.length()
    var suffix = declaration.name.slice(position + symbol_parameter_length, name_length)
    var template = Analysis.TemplateInfo(declaration, symbol_parameter, prefix, suffix)
    template.range = symbol_range_of(declaration, symbol_parameter)
    if not template.range and information.qualified_dotted == "List" {
        var saved_function = current_function
        current_function = declaration.name
        report(
            "'{declaration.name}' is a template on List, whose own attributes are its buffer, so a plain 'Symbol' answers nothing: write '{symbol_parameter}: Symbol<$element_type>' to name a member of the element",
        )
        current_function = saved_function
    }
    information.templates.append(template)
    check_hole_enum(information, template)
    return true
}

func symbol_range_of(declaration: Syntax.Statements.FunctionDeclaration, symbol_parameter: String): Syntax.Types.Type? {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.name == symbol_parameter and parameter.type_reference {
            var named = shape.as_named_type(parameter.type_reference)
            if named {
                if named.arguments.count() == 1 {
                    var range_argument = shape.as_type_argument(named.arguments[0])
                    if range_argument {
                        return range_argument.value
                    }
                }
            }
        }
        index = index + 1
    }
    return null
}

func template_range_class(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.ClassInfo? {
    if not template.range {
        return information
    }
    crash template.range
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    assert range_type
    var range_class_ref = type_shape.as_class_ref(range_type)
    assert range_class_ref
    var range_class = find_class_by_c_name(range_class_ref.c_name)
    assert range_class
    assert not range_class.is_generic_template
    return range_class
}

func walks_no_class(information: Analysis.ClassInfo, template: Analysis.TemplateInfo, member_name: String): Boolean {
    assert member_name == "{template.symbol_parameter}s" and not information.is_container and template.range
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    if range_type {
        return true
    }
    return false
}

func template_range_shape(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.UnionInfo? {
    assert template.range
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    assert range_type
    var range_union = type_shape.as_union(range_type)
    assert range_union
    var shaped = find_union_by_c_name(range_union.c_name)
    assert shaped
    assert shaped.is_shape
    return shaped
}

func template_range_kind(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): String {
    assert template.range
    if is_function_range(information, template) {
        var path = range_path(template)
        var last_segment = path.last()
        crash last_segment
        if ("_{last_segment}_").contains("_{template.symbol_parameter}_") {
            return "pattern"
        }
        return "function"
    }
    var path = range_path(template)
    if path.is_empty() {
        return "class"
    }
    var first_segment = path.first()
    crash first_segment
    if first_segment.starts_with("$") {
        return "class"
    }
    var joined = path.join(".")
    if find_class(joined, information.namespace_dotted) or find_union(joined) {
        return "class"
    }
    if find_enum(joined) {
        return "enum"
    }
    var owner_path = path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    var last_segment = path.last()
    crash last_segment
    if find_union_qualified(joined_owner_path, last_segment) {
        return "class"
    }
    if find_enum_qualified(joined_owner_path, last_segment) {
        return "enum"
    }
    return "namespace"
}

func template_range_enum(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.EnumInfo? {
    assert template.range
    var kind = template_range_kind(information, template)
    if kind == "pattern" {
        return hole_enum(information, template.symbol_parameter)
    }
    assert kind == "enum"
    var saved_class = current_class
    current_class = information
    var range_type = resolve_type(template.range, information.qualified_dotted)
    current_class = saved_class
    assert range_type
    var range_enum = type_shape.as_enum(range_type)
    assert range_enum
    return enums.find_by_c_name(range_enum.c_name)
}

func pascal_name(snake_name: String): String {
    var words = snake_name.split("_")
    var capitalized = ""
    var index = 0
    while index < words.count() {
        var word = words[index]
        var word_length = word.length()
        capitalized = "{capitalized}{word.slice(0, 1).upper_case()}{word.slice(1, word_length)}"
        index = index + 1
    }
    return capitalized
}

func hole_enum(information: Analysis.ClassInfo, hole: String): Analysis.EnumInfo? {
    var name = pascal_name(hole)
    var declaring_owner = nearest_declaring_owner(name, information.qualified_dotted)
    if not declaring_owner.is_empty() {
        var declared_there = find_enum_qualified(declaring_owner, name)
        if declared_there {
            return declared_there
        }
    }
    var named = enums_named(name)
    if named.count() == 1 {
        return named.first()
    }
    return null
}

func enums_named(name: String): List<Analysis.EnumInfo> {
    var named = List<Analysis.EnumInfo>()
    var index = 0
    while index < enums.count() {
        if enums[index].simple_name == name {
            named.append(enums[index])
        }
        index = index + 1
    }
    return named
}

func enum_display_name(information: Analysis.EnumInfo): String {
    if information.owner_qualified.is_empty() {
        return information.simple_name
    }
    return "{information.owner_qualified}.{information.simple_name}"
}

func missing_hole_enum(information: Analysis.ClassInfo, hole: String, pattern: String): String {
    var name = pascal_name(hole)
    var named = enums_named(name)
    if named.count() > 1 {
        var owners = named.map_owner_qualified()
        return "the hole '<{hole}>' of '{pattern}' matches only the values of the enum '{name}', and more than one class declares one ('{owners.join("', '")}'): rename one of them, or declare '{name}' in '{information.qualified_dotted}' itself"
    }
    return "the hole '<{hole}>' of '{pattern}' matches only the values of an enum named for it, and there is no enum '{name}': declare 'enum {name}' listing the names it may match, one per line"
}

func pattern_text(template: Analysis.TemplateInfo): String {
    return "{pattern_prefix(template)}<{template.symbol_parameter}>{pattern_suffix(template)}"
}

func check_hole_enum(information: Analysis.ClassInfo, template: Analysis.TemplateInfo) {
    assert not template.passed
    assert template.range
    assert template_range_kind(information, template) == "pattern"
    assert not hole_enum(information, template.symbol_parameter)
    var declaration = template.get_declaration()
    var saved_function = current_function
    var saved_line = current_line
    current_function = declaration.name
    current_line = declaration.line
    var written_pattern = pattern_text(template)
    var missing = missing_hole_enum(information, template.symbol_parameter, written_pattern)
    report(missing)
    current_function = saved_function
    current_line = saved_line
}

func range_path(template: Analysis.TemplateInfo): List<String> {
    assert template.range
    var named = shape.as_named_type(template.range)
    assert named
    assert named.arguments.is_empty()
    return named.path
}

func is_function_range(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Boolean {
    var path = range_path(template)
    assert path.count() >= 2
    var last_segment = path.last()
    crash last_segment
    var first_segment = path.first()
    crash first_segment
    if first_segment.starts_with("$") {
        assert path.count() == 2
        var bare_name = without_dollar(first_segment)
        var bound = codegen_index(information, bare_name)
        assert bound >= 0
        crash information.codegen_codes[bound]
        assert information.codegen_codes[bound].is_empty()
        crash information.codegen_types[bound]
        var bound_type = information.codegen_types[bound]
        if type_shape.as_list(bound_type) or type_shape.as_dictionary(bound_type) or type_shape.as_nullable(bound_type) {
            return last_segment != "element_type" and last_segment != "value_type"
        }
        var bound_class_ref = type_shape.as_class_ref(bound_type)
        if bound_class_ref {
            var bound_class = find_class_by_c_name(bound_class_ref.c_name)
            crash bound_class
            return codegen_index(bound_class, last_segment) < 0
        }
        return true
    }
    var owner_path = path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    var owner = find_class(joined_owner_path, information.namespace_dotted)
    assert owner
    var joined = path.join(".")
    assert not find_class(joined, information.namespace_dotted)
    assert not find_union_qualified(owner.qualified_dotted, last_segment)
    return not find_enum_qualified(owner.qualified_dotted, last_segment)
}

func range_function_owner(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.ClassInfo? {
    var path = range_path(template)
    var first_segment = path.first()
    crash first_segment
    if first_segment.starts_with("$") {
        var bare_name = without_dollar(first_segment)
        var bound = codegen_index(information, bare_name)
        crash information.codegen_types[bound]
        var bound_class_ref = type_shape.as_class_ref(information.codegen_types[bound])
        assert bound_class_ref
        return find_class_by_c_name(bound_class_ref.c_name)
    }
    var owner_path = path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    return find_class(joined_owner_path, information.namespace_dotted)
}

func range_function_name(template: Analysis.TemplateInfo): String {
    var path = range_path(template)
    var last_segment = path.last()
    crash last_segment
    if last_segment == bound_pattern and not bound_pattern.is_empty() {
        return bound_function_name
    }
    return last_segment
}

func range_function(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): Analysis.FunctionInfo? {
    var owner = range_function_owner(information, template)
    assert owner
    var function_name = range_function_name(template)
    var function = owner.find_function(function_name)
    assert function
    assert not function.is_constructor
    return function
}

func declared_functions_of(owner: Analysis.ClassInfo): List<Analysis.FunctionInfo> {
    var declared = List<Analysis.FunctionInfo>()
    var index = 0
    while index < owner.functions.count() {
        var function = owner.functions[index]
        if not function.is_constructor and function.symbol_name.is_empty() and not function.name.starts_with("_") {
            declared.append(function)
        }
        index = index + 1
    }
    return declared
}

func pattern_prefix(template: Analysis.TemplateInfo): String {
    var path = range_path(template)
    var last_segment = path.last()
    crash last_segment
    var padded = "_{last_segment}_"
    var position = padded.index_of("_{template.symbol_parameter}_")
    assert position >= 0
    return padded.slice(1, position + 1)
}

func pattern_suffix(template: Analysis.TemplateInfo): String {
    var path = range_path(template)
    var last_segment = path.last()
    crash last_segment
    var padded = "_{last_segment}_"
    var position = padded.index_of("_{template.symbol_parameter}_")
    assert position >= 0
    var hole_end = position + template.symbol_parameter.length() + 1
    var padded_length = padded.length()
    return padded.slice(hole_end, padded_length - 1)
}

func pattern_matches(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): List<String> {
    var matches = List<String>()
    var owner = range_function_owner(information, template)
    assert owner
    var hole_values = hole_enum(information, template.symbol_parameter)
    assert hole_values
    var prefix = pattern_prefix(template)
    var suffix = pattern_suffix(template)
    var functions = declared_functions_of(owner)
    var names = functions.map_name()
    var index = 0
    while index < hole_values.values.count() {
        var value = hole_values.values[index]
        if names.contains("{prefix}{value}{suffix}") {
            matches.append(value)
        }
        index = index + 1
    }
    return matches
}

func namespace_classes(template: Analysis.TemplateInfo): List<Analysis.ClassInfo> {
    var path = range_path(template)
    var joined = path.join(".")
    var found = List<Analysis.ClassInfo>()
    var index = 0
    while index < classes.count() {
        var candidate = classes[index]
        var in_namespace = candidate.namespace_dotted == joined or candidate.namespace_dotted.ends_with(".{joined}")
        if in_namespace and not candidate.is_generic_template and not is_instantiated_class(candidate) {
            found.append(candidate)
        }
        index = index + 1
    }
    return found.sort_by_qualified_dotted()
}

func range_miss(information: Analysis.ClassInfo, name: String): String {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        var member_name = ""
        if template.range {
            member_name = template.member_name_for(name)
        }
        if not member_name.is_empty() and template_range_owner(information, template) == "namespace" {
            var path = range_path(template)
            var range = path.join(".")
            var declaration = template.get_declaration()
            var found = namespace_classes(template)
            if found.is_empty() {
                return "'{name}' is '{declaration.name}' for a class '{member_name}', but no folder is named for '{range}', so 'Symbol<{range}>' walks nothing here"
            }
            var members = found.map(class_member_name)
            return "'{name}' is '{declaration.name}' for a class '{member_name}', but the folders named for '{range}' hold only '{members.join("', '")}'"
        }
        var missed_value = value_range_miss(information, template, name, member_name)
        if not missed_value.is_empty() {
            return missed_value
        }
        index = index + 1
    }
    return ""
}

func value_range_miss(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    name: String,
    member_name: String,
): String {
    assert not member_name.is_empty() and member_name != "{template.symbol_parameter}s"
    var kind = template_range_owner(information, template)
    assert kind == "pattern" or kind == "enum"
    var range_enum = template_range_enum(information, template)
    assert range_enum
    var declaration = template.get_declaration()
    var shown_enum = enum_display_name(range_enum)
    if not range_enum.has_value(member_name) {
        return "'{name}' is '{declaration.name}' for '{member_name}', but '{member_name}' is not a value of '{shown_enum}', which has '{range_enum.values.join("', '")}'"
    }
    assert kind == "pattern"
    var owner = range_function_owner(information, template)
    crash owner
    return "'{name}' is '{declaration.name}' for '{member_name}', a value of '{shown_enum}', but '{owner.qualified_dotted}' has no function '{pattern_prefix(template)}{member_name}{pattern_suffix(template)}'"
}

func class_member_name(candidate: Analysis.ClassInfo): String {
    var segments = candidate.qualified_dotted.split(".")
    var words = List<String>()
    var index = 0
    while index < segments.count() {
        var segment_words = words_of(segments[index])
        append_lines(words, segment_words)
        index = index + 1
    }
    return words.join("_")
}

func template_range_owner(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): String {
    if template.range {
        var kind = template_range_kind(information, template)
        if kind != "class" {
            return kind
        }
    }
    var range_class = template_range_class(information, template)
    if range_class {
        return range_class.c_name
    }
    var range_shape = template_range_shape(information, template)
    if range_shape {
        return range_shape.c_name
    }
    return ""
}

func shape_member_type(shaped: Analysis.UnionInfo, member_name: String): Analysis.SpiteType? {
    var required = find_required_function(shaped, member_name)
    if required {
        assert required.parameter_types.is_empty()
        return required_return_type(shaped, required)
    }
    return shape_field_type(shaped, member_name)
}

func template_attribute_names(information: Analysis.ClassInfo, template: Analysis.TemplateInfo): List<String> {
    var kind = template_range_owner(information, template)
    if kind == "function" {
        var function = range_function(information, template)
        if function {
            return function.parameters.map_name()
        }
        return List<String>()
    }
    if kind == "pattern" {
        return pattern_matches(information, template)
    }
    if kind == "enum" {
        var range_enum = template_range_enum(information, template)
        crash range_enum
        return range_enum.values.copy()
    }
    if kind == "namespace" {
        var found = namespace_classes(template)
        return found.map(class_member_name)
    }
    var range_class = template_range_class(information, template)
    if range_class {
        return range_class.fields.map_name()
    }
    var range_shape = template_range_shape(information, template)
    if range_shape {
        return range_shape.shape_fields.filter_is_attribute().map_name()
    }
    return List<String>()
}

func find_or_instantiate_function(information: Analysis.ClassInfo, name: String): Analysis.FunctionInfo? {
    var existing = information.find_function(name)
    if existing {
        return existing
    }
    var registered_name = name
    if not bound_pattern.is_empty() and answers_through_pattern(information, name) {
        registered_name = "{name}_in_{bound_function_name}"
        var keyed = information.find_function(registered_name)
        if keyed {
            return keyed
        }
    }
    var chosen: Analysis.TemplateInfo? = null
    var chosen_member = ""
    var chosen_type: Analysis.SpiteType? = null
    var chosen_owner = ""
    var matches = 0
    var index = 0
    var every: Analysis.TemplateInfo? = null
    while index < information.templates.count() {
        var template = information.templates[index]
        var member_name = template.member_name_for(name)
        var range_owner = template_range_owner(information, template)
        if not member_name.is_empty() and not information.is_container and not range_owner.is_empty() {
            var member_type = template_member_type(information, template, member_name)
            if member_type {
                chosen = template
                chosen_member = member_name
                chosen_type = member_type
                chosen_owner = range_owner
                matches = matches + 1
            } else if member_name == "{template.symbol_parameter}s" {
                every = template
            }
        }
        if range_owner.is_empty() and walks_no_class(information, template, member_name) {
            every = template
        }
        index = index + 1
    }
    if matches > 1 {
        report("'{name}' is answered by more than one Symbol codegen function of '{information.simple_name}'")
        return null
    }
    if chosen {
        if chosen_type {
            if not chosen.range or chosen_owner == "function" or chosen_owner == "pattern" or chosen_owner == "namespace" or chosen_owner == "enum" {
                chosen_owner = ""
            }
            var instance = instantiate_template(
                information,
                chosen,
                chosen_member,
                chosen_type,
                chosen_owner,
                registered_name,
                null,
            )
            describe_range_binding(information, chosen, instance)
            return instance
        }
    }
    if every {
        var plural = instantiate_every_attribute(information, every, registered_name)
        if plural {
            plural.symbol_pattern = bound_pattern
            plural.symbol_function_name = bound_function_name
        }
        return plural
    }
    assert name == "to_debug"
    return automatic_debug(information)
}

func describe_range_binding(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    instance: Analysis.FunctionInfo,
) {
    instance.symbol_pattern = bound_pattern
    instance.symbol_function_name = bound_function_name
    assert template.range
    var kind = template_range_owner(information, template)
    if kind == "pattern" {
        var path = range_path(template)
        var pattern = path.last()
        crash pattern
        instance.symbol_pattern = pattern
        instance.symbol_function_name = "{pattern_prefix(template)}{instance.symbol_field_name}{pattern_suffix(template)}"
    }
    if kind == "pattern" or kind == "enum" {
        var range_enum = template_range_enum(information, template)
        crash range_enum
        instance.symbol_enum_c_name = range_enum.c_name
    }
    if kind == "namespace" {
        var found = namespace_classes(template)
        var index = 0
        while index < found.count() {
            if class_member_name(found[index]) == instance.symbol_field_name {
                instance.symbol_display_name = found[index].qualified_dotted
            }
            index = index + 1
        }
    }
}

func answers_through_pattern(information: Analysis.ClassInfo, name: String): Boolean {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.range and not template.member_name_for(name).is_empty() {
            if template_range_owner(information, template) == "function" {
                var path = range_path(template)
                if path.last() == bound_pattern {
                    return true
                }
            }
        }
        index = index + 1
    }
    return false
}

func type_named_by(member_name: String): Analysis.SpiteType? {
    var type_name = pascal_name(member_name)
    return value_type_named(type_name)
}

func template_member_type(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    member_name: String,
): Analysis.SpiteType? {
    if template.range {
        var kind = template_range_owner(information, template)
        if kind == "function" {
            var function = range_function(information, template)
            assert function
            var parameter = function.parameters.find_by_name(member_name)
            assert parameter
            return parameter.get_type()
        }
        if kind == "pattern" {
            var matches = pattern_matches(information, template)
            assert matches.contains(member_name)
            var symbol_type: Analysis.SpiteType = Analysis.Types.SymbolType()
            return symbol_type
        }
        if kind == "enum" {
            var range_enum = template_range_enum(information, template)
            crash range_enum
            assert range_enum.has_value(member_name)
            return enum_type_of(range_enum)
        }
        if kind == "namespace" {
            var found = namespace_classes(template)
            var index = 0
            while index < found.count() {
                if class_member_name(found[index]) == member_name {
                    return class_type_of(found[index])
                }
                index = index + 1
            }
            return null
        }
        var range_class = template_range_class(information, template)
        if range_class {
            return member_type_of(range_class, member_name)
        }
        var range_shape = template_range_shape(information, template)
        crash range_shape
        return shape_member_type(range_shape, member_name)
    }
    if template.symbol_parameter == "type" {
        return type_named_by(member_name)
    }
    var field = information.find_field(member_name)
    assert field
    return field.get_type()
}

func instantiate_every_attribute(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    call_name: String,
): Analysis.FunctionInfo? {
    var declaration = template.get_declaration()
    var kind = ""
    if template.range {
        kind = template_range_owner(information, template)
    }
    if declaration.return_type {
        if kind == "function" {
            var range = range_path(template)
            var ranged_function = range.last()
            crash ranged_function
            report(
                "'{template.prefix}{template.symbol_parameter}s{template.suffix}' makes one value for each argument of '{ranged_function}', so it can only be the whole argument list of a call to '{ranged_function}', as in '{ranged_function}({template.prefix}{template.symbol_parameter}s{template.suffix}())' -- or '{declaration.name}' has to return nothing",
            )
            return null
        }
        report(
            "'{call_name}' calls '{declaration.name}' once for every attribute, so '{declaration.name}' has to return nothing",
        )
        return null
    }
    var attribute_names = template_attribute_names(information, template)
    var saved_class = current_class
    var saved_owner = current_owner
    current_class = information
    current_owner = information.qualified_dotted
    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name != template.symbol_parameter and parameter.type_reference {
            var parameter_type = resolve_type(parameter.type_reference, information.qualified_dotted)
            if parameter_type {
                parameters.append(Analysis.ParamInfo(parameter.name, parameter_type))
            }
        }
        parameter_index = parameter_index + 1
    }
    current_class = saved_class
    current_owner = saved_owner
    var body = List<Syntax.Statements.Statement>()
    var field_index = 0
    var private_readable = kind == "function" or kind == "pattern" or kind == "namespace"
    if not private_readable {
        private_readable = template_range_owner(information, template) == information.c_name
    }
    while field_index < attribute_names.count() {
        var attribute_name = attribute_names[field_index]
        if private_readable or not attribute_name.starts_with("_") {
            var arguments = List<Syntax.Expressions.Expression>()
            var argument_index = 0
            while argument_index < parameters.count() {
                var argument: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(
                    parameters[argument_index].name,
                )
                arguments.append(argument)
                argument_index = argument_index + 1
            }
            var callee: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(
                "{template.prefix}{attribute_name}{template.suffix}",
            )
            var call: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, arguments)
            var statement: Syntax.Statements.Statement = Syntax.Statements.ExpressionStatement(call)
            body.append(statement)
        }
        field_index = field_index + 1
    }
    var returns_nothing = void_type()
    var function = Analysis.FunctionInfo(
        call_name,
        "{information.c_name}_{call_name}",
        parameters,
        returns_nothing,
        body,
        false,
    )
    function.symbol_name = template.symbol_parameter
    information.functions.append(function)
    builder.add_prototype("{function_signature(information, function)};")
    return function
}

func instantiate_template(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    member_name: String,
    member_type: Analysis.SpiteType,
    member_owner_c_name: String,
    call_name: String,
    owner_type: Analysis.SpiteType?,
): Analysis.FunctionInfo {
    var declaration = template.get_declaration()
    var saved_symbol_name = bound_symbol_name
    var saved_field_name = bound_field_name
    var saved_field_type = bound_field_type
    var saved_member_owner = bound_member_owner_c_name
    var saved_owner = current_owner
    var saved_class = current_class
    bound_symbol_name = template.symbol_parameter
    bound_field_name = member_name
    bound_field_type = member_type
    bound_member_owner_c_name = member_owner_c_name
    current_owner = information.qualified_dotted
    current_class = information
    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name != template.symbol_parameter {
            if parameter.type_reference {
                var parameter_type = resolve_type(parameter.type_reference, information.qualified_dotted)
                if parameter_type {
                    var receiving_type = received_type(parameter, parameter_type)
                    parameters.append(Analysis.ParamInfo(parameter.name, receiving_type))
                }
            }
        }
        parameter_index = parameter_index + 1
    }
    if owner_type {
        parameters.append(Analysis.ParamInfo("owner", owner_type))
    }
    var return_type = void_type()
    if declaration.return_type {
        var resolved_return = resolve_type(declaration.return_type, information.qualified_dotted)
        if resolved_return {
            return_type = resolved_return
        }
    }
    var function = Analysis.FunctionInfo(
        call_name,
        "{information.c_name}_{call_name}",
        parameters,
        return_type,
        declaration.body,
        false,
    )
    function.symbol_name = template.symbol_parameter
    function.symbol_field_name = member_name
    function.symbol_field_type = member_type
    function.symbol_owner_c_name = member_owner_c_name
    if owner_type {
        function.symbol_through_caller = true
    }
    function.symbol_range = range_text(template)
    if not declaration.has_body {
        function.has_body = false
        function.supplied_body = "#define {function.c_name}(self, value) (({c_type_name(return_type)})(value))"
        if declaration.name != "from_type" {
            report(
                "'{information.simple_name}.{declaration.name}' has no body, and only a function whose body the compiler supplies is written without one: give it a body",
            )
        }
    }
    information.functions.append(function)
    if not is_inline_supplied(function) {
        builder.add_prototype("{function_signature(information, function)};")
    }
    bound_symbol_name = saved_symbol_name
    bound_field_name = saved_field_name
    bound_field_type = saved_field_type
    bound_member_owner_c_name = saved_member_owner
    current_owner = saved_owner
    current_class = saved_class
    return function
}

func range_text(template: Analysis.TemplateInfo): String {
    if template.range {
        var named = shape.as_named_type(template.range)
        if named {
            return named.path.join(".")
        }
    }
    return ""
}

func bind_symbol_of(function: Analysis.FunctionInfo) {
    bound_range = function.symbol_range
    bound_symbol_name = function.symbol_name
    bound_field_name = function.symbol_field_name
    bound_field_type = function.symbol_field_type
    bound_member_owner_c_name = function.symbol_owner_c_name
    bound_through_caller = function.symbol_through_caller
    bound_pattern = function.symbol_pattern
    bound_function_name = function.symbol_function_name
    bound_display_name = function.symbol_display_name
    bound_enum_c_name = function.symbol_enum_c_name
}

func is_bound_member_index(index_expression: Syntax.Expressions.IndexExpression): Boolean {
    assert not bound_member_owner_c_name.is_empty()
    crash index_expression.object
    crash index_expression.index
    var member = shape.as_member(index_expression.object)
    var index_identifier = shape.as_identifier(index_expression.index)
    if member {
        if index_identifier {
            return member.name == "attributes" and index_identifier.name == bound_symbol_name
        }
    }
    return false
}

func bound_member_expression(index_expression: Syntax.Expressions.IndexExpression): Syntax.Expressions.Expression {
    var member = shape.as_member(index_expression.object)
    crash member
    crash member.object
    if bound_through_caller {
        return caller_call_expression(member.object)
    }
    var read: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(member.object, bound_field_name)
    if not bound_member_is_function() {
        return read
    }
    var no_arguments = List<Syntax.Expressions.Expression>()
    var called: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(read, no_arguments)
    return called
}

func bound_member_is_function(): Boolean {
    var owner = find_class_by_c_name(bound_member_owner_c_name)
    if owner {
        assert not owner.find_field(bound_field_name)
        assert owner.find_function(bound_field_name)
        return true
    }
    var owner_shape = find_union_by_c_name(bound_member_owner_c_name)
    crash owner_shape
    assert find_required_function(owner_shape, bound_field_name)
    return true
}

func is_shape_member_read(expression: Syntax.Expressions.Expression): Boolean {
    assert not bound_member_owner_c_name.is_empty()
    assert find_union_by_c_name(bound_member_owner_c_name)
    var indexed = shape.as_index(expression)
    assert indexed
    return is_bound_member_index(indexed)
}

func is_caller_call(expression: Syntax.Expressions.Expression): Boolean {
    assert bound_through_caller
    var indexed = shape.as_index(expression)
    assert indexed
    return is_bound_member_index(indexed)
}

func caller_call_expression(element: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var owner: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("owner")
    var arguments = List<Syntax.Expressions.Expression>()
    arguments.append(element)
    if bound_field_name.is_empty() {
        var held: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(owner, arguments)
        return held
    }
    var callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(owner, bound_field_name)
    var called: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, arguments)
    return called
}

func generate_bound_member_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var read = bound_member_expression(index_expression)
    return generate_expression(read, scope, class_information)
}

func is_bound_attributes_index(index_expression: Syntax.Expressions.IndexExpression): Boolean {
    assert not bound_symbol_name.is_empty() and bound_member_owner_c_name.is_empty()
    if index_expression.object {
        if index_expression.index {
            var object_identifier = shape.as_identifier(index_expression.object)
            var index_identifier = shape.as_identifier(index_expression.index)
            if object_identifier {
                if index_identifier {
                    return object_identifier.name == "attributes" and index_identifier.name == bound_symbol_name
                }
            }
        }
    }
    return false
}

func emit_pending_functions() {
    var emitted_any = true
    while emitted_any {
        emitted_any = false
        var class_index = 0
        while class_index < classes.count() {
            var information = classes[class_index]
            if not information.is_generic_template {
                if not information.is_emitted {
                    emit_class(information)
                    emitted_any = true
                }
                var function_index = 0
                while function_index < information.functions.count() {
                    if is_pending(information, information.functions[function_index]) {
                        current_owner = information.qualified_dotted
                        emit_user_function(information, information.functions[function_index])
                        emitted_any = true
                    }
                    function_index = function_index + 1
                }
            }
            class_index = class_index + 1
        }
    }
}

func is_pending(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): Boolean {
    assert not function.is_emitted
    if not information.is_instantiated {
        return true
    }
    return builder.mentions(function.c_name) or is_called_through_shape(information, function.name)
}

func is_called_through_shape(information: Analysis.ClassInfo, name: String): Boolean {
    var index = 0
    while index < unions.count() {
        if unions[index].is_shape and unions[index].caller_names.contains(name) {
            if unions[index].has_member(information.c_name) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func received_type(parameter: Syntax.Statements.Parameter, resolved: Analysis.SpiteType): Analysis.SpiteType {
    if not parameter.is_variadic {
        return resolved
    }
    var listed = type_shape.as_list(resolved)
    if listed {
        var element = listed.get_element()
        var spread = Analysis.Types.ListType(element)
        spread.is_variadic = true
        var typed: Analysis.SpiteType = spread
        return typed
    }
    return resolved
}

func resolve_function(declaration: Syntax.Statements.FunctionDeclaration, information: Analysis.ClassInfo) {
    assert not register_template(declaration, information)
    var parameters = List<Analysis.ParamInfo>()
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        check_value_name(parameter.name, "parameter")
        assert parameter.type_reference
        var parameter_type = resolve_type(parameter.type_reference, information.qualified_dotted)
        if parameter_type {
            var receiving_type = received_type(parameter, parameter_type)
            parameters.append(Analysis.ParamInfo(parameter.name, receiving_type))
        } else {
            var void_spite_type = void_type()
            parameters.append(Analysis.ParamInfo(parameter.name, void_spite_type))
        }
        parameter_index = parameter_index + 1
    }
    var return_type: Analysis.SpiteType = Analysis.Types.VoidType()
    if declaration.return_type {
        var resolved_return = resolve_type(declaration.return_type, information.qualified_dotted)
        if resolved_return {
            return_type = resolved_return
        }
    }
    var is_constructor = declaration.name == information.simple_name
    if is_constructor and declaration.parameters.is_empty() and declaration.body.is_empty() {
        report(
            "'{declaration.name}' has an empty constructor: delete it. A class without a constructor is already made from its defaults",
        )
    }
    var is_conversion = information.is_value_class and declaration.name.starts_with("to_")
    if not is_constructor and not is_conversion and declaration.has_body {
        check_value_name(declaration.name, "function")
    }
    var c_name = "{information.c_name}_{declaration.name}"
    var function = Analysis.FunctionInfo(
        declaration.name,
        c_name,
        parameters,
        return_type,
        declaration.body,
        is_constructor,
    )
    function.source_path = declaration.source_path
    if not declaration.has_body {
        supply_body(information, function)
    }
    if declaration.name == "is_singleton" and information.qualified_dotted != "Spite.Class" {
        report(
            "a class says it is a singleton with a 'singleton' line at the top of its file, not with a function: delete 'is_singleton()' and write 'singleton' as the file's first line",
        )
    }
    function.line = declaration.line
    if is_constructor {
        information.constructor = function
    } else if declaration.name == "drop" {
        information.drop_function = function
    }
    var existing = 0
    while existing < information.functions.count() {
        if information.functions[existing].name == declaration.name {
            var saved_line = current_line
            current_line = declaration.line
            report(
                "'{information.simple_name}' declares '{declaration.name}' twice: a later file may reopen a class and replace a function, but one file declares each name once",
            )
            current_line = saved_line
        }
        existing = existing + 1
    }
    information.functions.append(function)
}

func is_inline_supplied(function: Analysis.FunctionInfo): Boolean {
    return not function.has_body and function.supplied_body.starts_with("#define")
}

func supply_body(information: Analysis.ClassInfo, function: Analysis.FunctionInfo) {
    function.has_body = false
    var segments = information.qualified_dotted.split(".")
    var folders = List<String>()
    var index = 0
    while index < segments.count() {
        var words = words_of(segments[index])
        var folder = words.join("_")
        folders.append(folder)
        index = index + 1
    }
    var class_path = folders.join("/")
    var supplied = Prelude().supplied_body(class_path, function.name)
    if supplied {
        assert not information.is_generic_template
        function.supplied_body = supplied
        if class_path == "typed_memory" {
            function.supplied_body = typed_memory_body(information, function.name)
        }
        if class_path == "weak" {
            function.supplied_body = weak_body(information, function.name)
        }
        if class_path == "concurrent" or class_path == "thread_pool" {
            function.supplied_body = task_body(information, function.name)
        }
        if class_path == "hot_reload" and function.name != "open" {
            function.supplied_body = hot_reload_body(function.name)
        }
        if class_path == "memory/address" {
            function.supplied_body = address_body(function)
        }
        return
    }
    report(
        "'{information.simple_name}.{function.name}' has no body, and only a function whose body the compiler supplies is written without one: give it a body",
    )
}

func address_body(function: Analysis.FunctionInfo): String {
    var name = function.name
    var at = "((char*)(intptr_t)(self) + (offset))"
    if name == "copy_to" {
        return "#define {function.c_name}(self, target, bytes) memmove((void*)(intptr_t)(target), (void*)(intptr_t)(self), (size_t)(bytes))"
    }
    if name == "compare_bytes" {
        return "#define {function.c_name}(self, other, bytes) (\{ int64_t spite_bytes = (bytes); spite_bytes > 0 ? (int32_t)memcmp((const void*)(intptr_t)(self), (const void*)(intptr_t)(other), (size_t)spite_bytes) : 0; })"
    }
    if name == "exchange_long" {
        return "#define {function.c_name}(self, offset, value) __atomic_exchange_n((int64_t*){at}, (int64_t)(value), __ATOMIC_SEQ_CST)"
    }
    if name == "read_long_atomically" {
        return "#define {function.c_name}(self, offset) __atomic_load_n((int64_t*){at}, __ATOMIC_SEQ_CST)"
    }
    if name == "write_long_atomically" {
        return "#define {function.c_name}(self, offset, value) __atomic_store_n((int64_t*){at}, (int64_t)(value), __ATOMIC_SEQ_CST)"
    }
    var value_type = function.get_return_type()
    if name.starts_with("write_") {
        crash function.parameters[1]
        value_type = function.parameters[1].get_type()
        var written = c_type_name(value_type)
        return "#define {function.c_name}(self, offset, value) memcpy({at}, &({written})\{ (value) }, sizeof({written}))"
    }
    var read = c_type_name(value_type)
    return "#define {function.c_name}(self, offset) (\{ {read} spite_read; memcpy(&spite_read, {at}, sizeof(spite_read)); spite_read; })"
}

func task_body(information: Analysis.ClassInfo, name: String): String {
    if name == "address" {
        return "return (int64_t)(intptr_t)self;"
    }
    if name == "_start_frame" {
        builder.add_prototype("static void* spite_frame_start(Spite_Function* spite_work);")
        return "return (int64_t)(intptr_t)spite_frame_start(self->_work_);"
    }
    if name == "_frame_result" {
        return frame_result_body(information)
    }
    var entry = "{information.c_name}___thread_entry"
    builder.add_prototype("static void* {entry}(void* pool);")
    builder.add_support(
        "static void* {entry}(void* pool) \{\n{information.c_name}__serve(({information.c_name}*)pool);\nreturn 0;\n}",
    )
    return "return (int64_t)(intptr_t)&{entry};"
}

func weak_body(information: Analysis.ClassInfo, name: String): String {
    crash information.codegen_types[0]
    var value_type = information.codegen_types[0]
    var class_ref = type_shape.as_class_ref(value_type)
    if not class_ref {
        report(
            "Weak holds an object without counting it, and {type_with_article(value_type)} is not an object: a number, a Boolean, an enum or a T? is kept by value, so hold it as it is",
        )
        return ""
    }
    crash class_ref
    ensure_weak_runtime(class_ref.c_name)
    if name == "_box_of" {
        var released = release_call(value_type, "target_")
        return "int64_t spite_box = spite_weak_box_of((void*)target_);\n{released};\nreturn spite_box;"
    }
    if name == "get" {
        var retained = retain_call(value_type, "spite_object")
        return "{class_ref.c_name}* spite_object = ({class_ref.c_name}*)spite_weak_object(self->_box_);\nif (spite_object == 0) return 0;\nreturn {retained};"
    }
    return "spite_weak_box_release(self->_box_);"
}

func ensure_weak_runtime(c_name: String) {
    if not weak_classes.contains(c_name) {
        weak_classes.append(c_name)
        builder.add_typedef("#define SPITE_WEAK_{c_name} 1")
    }
    assert not weak_runtime_written
    weak_runtime_written = true
    builder.add_prototype("static void spite_weak_object_freed(void* object);")
    var runtime = weak_runtime()
    builder.add_support(runtime)
}

func weak_runtime(): String {
    var lines = [
        "typedef struct SpiteWeakBox \{ void* object; int64_t weak_count; } SpiteWeakBox;"
        "static SpiteWeakBox** spite_weak_table = 0;"
        "static int64_t spite_weak_capacity = 0;"
        "static int64_t spite_weak_used = 0;"
        "static int64_t spite_weak_filled = 0;"
        "#define SPITE_WEAK_GONE ((SpiteWeakBox*)(intptr_t)1)"
        "static int64_t spite_weak_find(void* object) \{"
        "if (spite_weak_capacity == 0) return -1;"
        "uint64_t spite_hash = (uint64_t)(uintptr_t)object; spite_hash ^= spite_hash >> 33; spite_hash *= 0xff51afd7ed558ccdULL; spite_hash ^= spite_hash >> 33;"
        "int64_t spite_slot = (int64_t)(spite_hash & (uint64_t)(spite_weak_capacity - 1));"
        "while (spite_weak_table[spite_slot] != 0) \{"
        "if (spite_weak_table[spite_slot] != SPITE_WEAK_GONE && spite_weak_table[spite_slot]->object == object) return spite_slot;"
        "spite_slot = (spite_slot + 1) & (spite_weak_capacity - 1);"
        "}"
        "return -1;"
        "}"
        "static void spite_weak_insert(SpiteWeakBox* box) \{"
        "if ((spite_weak_filled + 1) * 2 > spite_weak_capacity) \{"
        "SpiteWeakBox** spite_old = spite_weak_table; int64_t spite_old_capacity = spite_weak_capacity;"
        "spite_weak_capacity = spite_weak_capacity == 0 ? 16 : (spite_weak_used + 1) * 4 > spite_weak_capacity ? spite_weak_capacity * 2 : spite_weak_capacity;"
        "spite_weak_table = (SpiteWeakBox**)calloc((size_t)spite_weak_capacity, sizeof(SpiteWeakBox*));"
        "spite_weak_filled = 0; spite_weak_used = 0;"
        "for (int64_t spite_index = 0; spite_index < spite_old_capacity; spite_index = spite_index + 1) \{"
        "if (spite_old[spite_index] != 0 && spite_old[spite_index] != SPITE_WEAK_GONE) spite_weak_insert(spite_old[spite_index]);"
        "}"
        "free(spite_old);"
        "}"
        "uint64_t spite_hash = (uint64_t)(uintptr_t)box->object; spite_hash ^= spite_hash >> 33; spite_hash *= 0xff51afd7ed558ccdULL; spite_hash ^= spite_hash >> 33;"
        "int64_t spite_slot = (int64_t)(spite_hash & (uint64_t)(spite_weak_capacity - 1));"
        "while (spite_weak_table[spite_slot] != 0 && spite_weak_table[spite_slot] != SPITE_WEAK_GONE) spite_slot = (spite_slot + 1) & (spite_weak_capacity - 1);"
        "if (spite_weak_table[spite_slot] == 0) spite_weak_filled = spite_weak_filled + 1;"
        "spite_weak_table[spite_slot] = box;"
        "spite_weak_used = spite_weak_used + 1;"
        "}"
        "static void spite_weak_forget(int64_t spite_slot) \{"
        "spite_weak_table[spite_slot] = SPITE_WEAK_GONE;"
        "spite_weak_used = spite_weak_used - 1;"
        "if (spite_weak_used == 0) \{ free(spite_weak_table); spite_weak_table = 0; spite_weak_capacity = 0; spite_weak_filled = 0; }"
        "}"
        "static int64_t spite_weak_box_of(void* object) \{"
        "if (object == 0) return 0;"
        "int64_t spite_slot = spite_weak_find(object);"
        "if (spite_slot >= 0) \{ spite_weak_table[spite_slot]->weak_count = spite_weak_table[spite_slot]->weak_count + 1; return (int64_t)(intptr_t)spite_weak_table[spite_slot]; }"
        "SpiteWeakBox* box = (SpiteWeakBox*)malloc(sizeof(SpiteWeakBox));"
        "box->object = object; box->weak_count = 1;"
        "spite_weak_insert(box);"
        "return (int64_t)(intptr_t)box;"
        "}"
        "static void* spite_weak_object(int64_t box) \{"
        "if (box == 0) return 0;"
        "return ((SpiteWeakBox*)(intptr_t)box)->object;"
        "}"
        "static void spite_weak_box_release(int64_t box_address) \{"
        "SpiteWeakBox* box = (SpiteWeakBox*)(intptr_t)box_address;"
        "if (box == 0) return;"
        "box->weak_count = box->weak_count - 1;"
        "if (box->weak_count > 0) return;"
        "if (box->object != 0) \{ int64_t spite_slot = spite_weak_find(box->object); if (spite_slot >= 0) spite_weak_forget(spite_slot); }"
        "free(box);"
        "}"
        "static void spite_weak_object_freed(void* object) \{"
        "int64_t spite_slot = spite_weak_find(object);"
        "if (spite_slot < 0) return;"
        "spite_weak_table[spite_slot]->object = 0;"
        "spite_weak_forget(spite_slot);"
        "}"
    ]
    return lines.join("\n")
}

func typed_memory_body(information: Analysis.ClassInfo, name: String): String {
    crash information.codegen_types[0]
    var value_type = information.codegen_types[0]
    var slot = "(({c_type_name(value_type)}*)(intptr_t)address_)[index_]"
    if name == "read_value" {
        return "return {retain_call(value_type, slot)};"
    }
    if name == "write_value" {
        return "{slot} = value_;"
    }
    if name == "release_value" {
        return release_statement(value_type, slot)
    }
    return "return (int64_t)sizeof({c_type_name(value_type)});"
}

func resolve_type(type_reference: Syntax.Types.Type, current_namespace: String): Analysis.SpiteType? {
    var generic_type = shape.as_generic_type(type_reference)
    if generic_type {
        var generic_name = without_dollar(generic_type.name)
        if current_class {
            var bound = codegen_index(current_class, generic_name)
            if bound >= 0 {
                crash current_class.codegen_codes[bound]
                if current_class.codegen_codes[bound].is_empty() {
                    return current_class.codegen_types[bound]
                }
                report("'${generic_name}' is a value here, so it cannot be used as a type")
                return null
            }
        }
        report("this class has no 'generic ${generic_name}' line, so '${generic_name}' cannot be used as a type")
        return null
    }
    var named = shape.as_named_type(type_reference)
    if named {
        return resolve_named_type(named, current_namespace)
    }
    report("this kind of type reference is not supported yet")
    return null
}

func resolve_named_type(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    if named.path.count() > 1 and named.path[0].starts_with("$") {
        return resolve_codegen_member(named)
    }
    if named.path.count() >= 2 and not bound_symbol_name.is_empty() {
        if named.path[0] == bound_symbol_name and named.path[1] == "class" {
            return bound_type_member(named)
        }
    }
    if named.path.count() == 2 and named.path[0] == "Memory" and named.path[1] == "Address" {
        var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('address_kind')
        return resolved
    }
    if named.path.count() == 1 {
        var name = named.path[0]
        if name == "Integer" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('integer_kind')
            return resolved
        }
        if name == "Long" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('long_kind')
            return resolved
        }
        if name == "Tiny" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('tiny_kind')
            return resolved
        }
        if name == "Short" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('short_kind')
            return resolved
        }
        if name == "Byte" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('byte_kind')
            return resolved
        }
        if name == "UnsignedShort" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('unsigned_short_kind')
            return resolved
        }
        if name == "UnsignedInteger" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('unsigned_integer_kind')
            return resolved
        }
        if name == "UnsignedLong" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('unsigned_long_kind')
            return resolved
        }
        if name == "Float" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('float_kind')
            return resolved
        }
        if name == "Double" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('double_kind')
            return resolved
        }
        if name == "Boolean" {
            var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('boolean_kind')
            return resolved
        }
        if name == "String" {
            var resolved: Analysis.SpiteType = Analysis.Types.StringType()
            return resolved
        }
        if name == "Nullable" {
            return resolve_nullable_argument(named, current_namespace)
        }
        if name == "Symbol" {
            var symbol_type: Analysis.SpiteType = Analysis.Types.SymbolType()
            return symbol_type
        }
        if name == "Arguments" {
            var resolved: Analysis.SpiteType = Analysis.Types.ArgumentsType()
            return resolved
        }
        if name == "Dictionary" {
            var dictionary_element = resolve_single_type_argument(named, current_namespace)
            if dictionary_element {
                return dictionary_type_of(dictionary_element)
            }
            return null
        }
        if name == "List" {
            var list_element = resolve_single_type_argument(named, current_namespace)
            if list_element {
                return list_type_of(list_element)
            }
            return null
        }
        var declaring_owner = nearest_declaring_owner(name, current_namespace)
        if not declaring_owner.is_empty() {
            var near_union = find_union_qualified(declaring_owner, name)
            if near_union {
                return union_type_of(near_union)
            }
            var near_enum = find_enum_qualified(declaring_owner, name)
            crash near_enum
            return enum_type_of(near_enum)
        }
        var found_class = find_class(name, current_namespace)
        if found_class {
            if found_class.is_generic_template {
                var generic_instance = instantiate_generic(found_class, named.arguments, current_namespace)
                if generic_instance {
                    return class_type_of(generic_instance)
                }
                return null
            }
            var same_name_union = find_union_qualified(found_class.qualified_dotted, name)
            if same_name_union {
                return union_type_of(same_name_union)
            }
            var same_name_enum = find_enum_qualified(found_class.qualified_dotted, name)
            if same_name_enum {
                return enum_type_of(same_name_enum)
            }
            if found_class.c_name == "Spite_Function" and not named.arguments.is_empty() {
                return function_type_from(named, current_namespace)
            }
            var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(found_class.c_name)
            return resolved
        }
        var found_enum = find_enum(name)
        if found_enum {
            return enum_type_of(found_enum)
        }
        var found_union = find_union(name)
        if found_union {
            return union_type_of(found_union)
        }
        if not reported_old_spelling(name) {
            report("unknown type '{name}'")
        }
        return null
    }
    var joined = named.path.join(".")
    var owner_path = named.path.copy()
    owner_path.remove_last()
    var joined_owner_path = owner_path.join(".")
    var last_segment = named.path.last()
    crash last_segment
    var owner_class = find_class(joined_owner_path, current_namespace)
    if owner_class {
        joined_owner_path = owner_class.qualified_dotted
    }
    var qualified_enum = find_enum_qualified(joined_owner_path, last_segment)
    if qualified_enum {
        return enum_type_of(qualified_enum)
    }
    var qualified_union = find_union_qualified(joined_owner_path, last_segment)
    if qualified_union {
        return union_type_of(qualified_union)
    }
    var qualified_class = find_class(joined, current_namespace)
    if qualified_class {
        if qualified_class.is_generic_template {
            var generic_instance = instantiate_generic(qualified_class, named.arguments, current_namespace)
            if generic_instance {
                return class_type_of(generic_instance)
            }
            return null
        }
        joined = qualified_class.qualified_dotted
        var owned_union = find_union_qualified(joined, last_segment)
        if owned_union {
            return union_type_of(owned_union)
        }
        var owned_enum = find_enum_qualified(joined, last_segment)
        if owned_enum {
            return enum_type_of(owned_enum)
        }
        if qualified_class.c_name == "Spite_Function" and not named.arguments.is_empty() {
            return function_type_from(named, current_namespace)
        }
        var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType(qualified_class.c_name)
        return resolved
    }
    report("unknown type '{joined}'")
    return null
}

func resolve_single_type_argument(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    if named.arguments.count() != 1 {
        var type_name = named.path.last()
        crash type_name
        report("{type_name} takes exactly one type argument")
        return null
    }
    return resolve_generic_argument(named.arguments[0], current_namespace)
}

func bound_type_member(named: Syntax.Types.NamedType): Analysis.SpiteType? {
    var bound_type = bound_field_type
    var index = 2
    while index < named.path.count() {
        crash bound_type
        var segment = named.path.get_at(index)
        var member_type = codegen_member_type(bound_type, segment)
        if not member_type {
            report(
                "{type_with_article(bound_type)} has no codegen value named '{segment}' -- List<$element_type>, Dictionary<$value_type> and $value_type? name theirs, and a generic class names its own",
            )
            return null
        }
        bound_type = member_type
        index = index + 1
    }
    return bound_type
}

func resolve_codegen_member(named: Syntax.Types.NamedType): Analysis.SpiteType? {
    var written = named.path.first()
    crash written
    var generic_name = without_dollar(written)
    var bound_type: Analysis.SpiteType? = null
    if current_class {
        bound_type = codegen_bound_type(generic_name, current_class)
    }
    if not bound_type {
        report(
            "'${generic_name}' is not a type declared on this class's constructor, so it has no codegen values to read",
        )
        return null
    }
    var index = 1
    while index < named.path.count() {
        crash bound_type
        var segment = named.path.get_at(index)
        var member_type = codegen_member_type(bound_type, segment)
        if not member_type {
            report(
                "{type_with_article(bound_type)} has no codegen value named '${segment}' -- List<$element_type>, Dictionary<$value_type> and $value_type? name theirs, and a generic class names its own",
            )
            return null
        }
        bound_type = member_type
        index = index + 1
    }
    return bound_type
}

func codegen_member_type(owner: Analysis.SpiteType, name: String): Analysis.SpiteType? {
    var owner_list = type_shape.as_list(owner)
    if owner_list {
        assert name == "element_type"
        return owner_list.get_element()
    }
    var owner_dictionary = type_shape.as_dictionary(owner)
    if owner_dictionary {
        assert name == "value_type"
        return owner_dictionary.get_element()
    }
    var owner_nullable = type_shape.as_nullable(owner)
    if owner_nullable {
        assert name == "value_type"
        return owner_nullable.get_inner()
    }
    var owner_class_ref = type_shape.as_class_ref(owner)
    assert owner_class_ref
    var owner_class = find_class_by_c_name(owner_class_ref.c_name)
    assert owner_class
    var bound = codegen_index(owner_class, name)
    assert bound >= 0
    crash owner_class.codegen_codes[bound]
    assert owner_class.codegen_codes[bound].is_empty()
    return owner_class.codegen_types[bound]
}

func resolve_generic_argument(argument: Syntax.Types.GenericArgument, current_namespace: String): Analysis.SpiteType? {
    var type_argument = shape.as_type_argument(argument)
    if not type_argument {
        report("a type argument must be a type")
        return null
    }
    assert type_argument
    assert type_argument.value
    return resolve_type(type_argument.value, current_namespace)
}

func list_type_of(element: Analysis.SpiteType): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ListType(element)
    return resolved
}

func integer_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('integer_kind')
    return resolved
}

func boolean_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('boolean_kind')
    return resolved
}

func string_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.StringType()
    return resolved
}

func value_class_names(): List<String> {
    return [
        "Integer"
        "Long"
        "Float"
        "Double"
        "Boolean"
        "Tiny"
        "Short"
        "Byte"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Memory.Address"
    ]
}

func value_type_named(name: String): Analysis.SpiteType? {
    if name == "String" {
        return string_type()
    }
    var names = value_class_names()
    assert names.contains(name)
    var no_arguments = List<Syntax.Types.GenericArgument>()
    var path = name.split(".")
    var named = Syntax.Types.NamedType(path, no_arguments)
    return resolve_named_type(named, "")
}

func value_class_of(kind: Analysis.Types.NumericKind): Analysis.ClassInfo? {
    var scalar_type: Analysis.SpiteType = Analysis.Types.ScalarType(kind)
    var name = type_label(scalar_type)
    return find_class_by_c_name("Spite{name}")
}

func value_class_type(information: Analysis.ClassInfo): Analysis.SpiteType {
    var value_type = value_type_named(information.qualified_dotted)
    if value_type {
        return value_type
    }
    var class_type: Analysis.SpiteType = Analysis.Types.ClassRefType(information.c_name)
    return class_type
}

func address_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('address_kind')
    return resolved
}

func long_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('long_kind')
    return resolved
}

func float_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('float_kind')
    return resolved
}

func double_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ScalarType('double_kind')
    return resolved
}

func void_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.VoidType()
    return resolved
}

func no_types(): List<Analysis.SpiteType> {
    return List<Analysis.SpiteType>()
}

func one_type(first: Analysis.SpiteType): List<Analysis.SpiteType> {
    var result = List<Analysis.SpiteType>()
    result.append(first)
    return result
}

func two_types(first: Analysis.SpiteType, second: Analysis.SpiteType): List<Analysis.SpiteType> {
    var result = List<Analysis.SpiteType>()
    result.append(first)
    result.append(second)
    return result
}

func resolve_nullable_argument(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    if named.arguments.count() != 1 {
        report("Nullable takes exactly one type argument")
        return null
    }
    var type_argument = shape.as_type_argument(named.arguments[0])
    if not type_argument {
        report("Nullable's argument must be a type")
        return null
    }
    assert type_argument
    assert type_argument.value
    var inner = resolve_type(type_argument.value, current_namespace)
    if inner {
        return nullable_type_of(inner)
    }
    return null
}

func type_is_reference(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return true
    }
    if type_shape.as_list(spite_type) {
        return true
    }
    if type_shape.as_dictionary(spite_type) {
        return true
    }
    if type_shape.as_union(spite_type) {
        return true
    }
    if type_shape.as_class_ref(spite_type) {
        return true
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.get_inner()
        return type_is_reference(nullable_inner)
    }
    return false
}

func type_needs_drop(spite_type: Analysis.SpiteType): Boolean {
    return type_is_reference(spite_type)
}

func types_equal(left_type: Analysis.SpiteType, right_type: Analysis.SpiteType): Boolean {
    var left_scalar = type_shape.as_scalar(left_type)
    if left_scalar {
        var right_scalar = type_shape.as_scalar(right_type)
        if right_scalar {
            return left_scalar.kind == right_scalar.kind
        }
        return false
    }
    if type_shape.as_string(left_type) {
        return type_shape.as_string(right_type)
    }
    if type_shape.is_symbol(left_type) {
        return type_shape.is_symbol(right_type)
    }
    var left_class = type_shape.as_class_ref(left_type)
    if left_class {
        var right_class = type_shape.as_class_ref(right_type)
        if right_class {
            return left_class.c_name == right_class.c_name and same_signature(left_class, right_class)
        }
        return false
    }
    var left_union = type_shape.as_union(left_type)
    if left_union {
        var right_union = type_shape.as_union(right_type)
        if right_union {
            return left_union.c_name == right_union.c_name
        }
        return false
    }
    var left_dictionary = type_shape.as_dictionary(left_type)
    if left_dictionary {
        var right_dictionary = type_shape.as_dictionary(right_type)
        if right_dictionary {
            var left_dictionary_element = left_dictionary.get_element()
            var right_dictionary_element = right_dictionary.get_element()
            return types_equal(left_dictionary_element, right_dictionary_element)
        }
        return false
    }
    var left_list = type_shape.as_list(left_type)
    if left_list {
        var right_list = type_shape.as_list(right_type)
        if right_list {
            var left_list_element = left_list.get_element()
            var right_list_element = right_list.get_element()
            return types_equal(left_list_element, right_list_element)
        }
        return false
    }
    var left_enum = type_shape.as_enum(left_type)
    if left_enum {
        var right_enum = type_shape.as_enum(right_type)
        if right_enum {
            return left_enum.c_name == right_enum.c_name
        }
        return false
    }
    var left_nullable = type_shape.as_nullable(left_type)
    if left_nullable {
        var right_nullable = type_shape.as_nullable(right_type)
        if right_nullable {
            var left_nullable_inner = left_nullable.get_inner()
            var right_nullable_inner = right_nullable.get_inner()
            return types_equal(left_nullable_inner, right_nullable_inner)
        }
        return false
    }
    if type_shape.is_void(left_type) {
        return type_shape.is_void(right_type)
    }
    if type_shape.is_arguments(left_type) {
        return type_shape.is_arguments(right_type)
    }
    return false
}

func numeric_c_name(kind: Analysis.Types.NumericKind): String {
    if kind == 'integer_kind' {
        return "int32_t"
    }
    if kind == 'long_kind' {
        return "int64_t"
    }
    if kind == 'tiny_kind' {
        return "int8_t"
    }
    if kind == 'short_kind' {
        return "int16_t"
    }
    if kind == 'byte_kind' {
        return "uint8_t"
    }
    if kind == 'unsigned_short_kind' {
        return "uint16_t"
    }
    if kind == 'unsigned_integer_kind' {
        return "uint32_t"
    }
    if kind == 'unsigned_long_kind' {
        return "uint64_t"
    }
    if kind == 'address_kind' {
        return "int64_t"
    }
    if kind == 'float_kind' {
        return "float"
    }
    if kind == 'double_kind' {
        return "double"
    }
    return "bool"
}

func type_label(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        if scalar.kind == 'integer_kind' {
            return "Integer"
        }
        if scalar.kind == 'long_kind' {
            return "Long"
        }
        if scalar.kind == 'tiny_kind' {
            return "Tiny"
        }
        if scalar.kind == 'short_kind' {
            return "Short"
        }
        if scalar.kind == 'byte_kind' {
            return "Byte"
        }
        if scalar.kind == 'unsigned_short_kind' {
            return "UnsignedShort"
        }
        if scalar.kind == 'unsigned_integer_kind' {
            return "UnsignedInteger"
        }
        if scalar.kind == 'unsigned_long_kind' {
            return "UnsignedLong"
        }
        if scalar.kind == 'address_kind' {
            return "Memory_Address"
        }
        if scalar.kind == 'float_kind' {
            return "Float"
        }
        if scalar.kind == 'double_kind' {
            return "Double"
        }
        return "Boolean"
    }
    if type_shape.as_string(spite_type) {
        return "String"
    }
    if type_shape.is_symbol(spite_type) {
        return "Symbol"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return class_ref.c_name
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        return enum_type.c_name
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        return "List_{type_label(list_type_element)}"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.get_element()
        return "Dictionary_{type_label(dictionary_type_element)}"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.get_inner()
        return "Nullable_{type_label(nullable_inner)}"
    }
    return "Value"
}

func ensure_nullable_scalar_typedef(inner: Analysis.SpiteType): String {
    var label = type_label(inner)
    var struct_name = "Nullable_{label}"
    if not nullable_scalar_labels.contains(label) {
        nullable_scalar_labels.append(label)
        var value_c_type = c_type_name(inner)
        builder.add_typedef("typedef struct \{ bool has_value; {value_c_type} value; } {struct_name};")
    }
    return struct_name
}

func c_value_name(name: String): String {
    return "{name}_"
}

func c_parameter_names(parameters: List<Analysis.ParamInfo>): List<String> {
    var names = List<String>()
    var index = 0
    while index < parameters.count() {
        var parameter_code = c_value_name(parameters[index].name)
        names.append(parameter_code)
        index = index + 1
    }
    return names
}

func c_type_name(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return numeric_c_name(scalar.kind)
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "SpiteString*"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}*"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.get_inner()
        if type_is_reference(inner) {
            return c_type_name(inner)
        }
        return ensure_nullable_scalar_typedef(inner)
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        return enum_type.c_name
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        return "{ensure_list(list_type_element)}*"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.get_element()
        return "{ensure_dictionary(dictionary_type_element)}*"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return union_type.c_name
    }
    if type_shape.is_void(spite_type) {
        return "void"
    }
    if type_shape.is_arguments(spite_type) {
        return "SpiteArguments"
    }
    return "void*"
}

func default_value_for_type(spite_type: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        if scalar.kind == 'boolean_kind' {
            return "false"
        }
        if scalar.kind == 'float_kind' {
            return "0.0"
        }
        if scalar.kind == 'double_kind' {
            return "0.0"
        }
        return "0"
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "(&spite_static_string_empty)"
    }
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}___default()"
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        var first_value = enum_type.values.first()
        crash first_value
        return "{enum_type.c_name}_{first_value}"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        return "{ensure_list(list_type_element)}___make()"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.get_element()
        return "{ensure_dictionary(dictionary_type_element)}___make()"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var union_information = find_union_by_c_name(union_type.c_name)
        if union_information {
            if union_information.is_shape {
                return shape_default(union_information)
            }
            var first_member = union_information.members.first()
            crash first_member
            return "(({union_type.c_name}){first_member.c_name}___default())"
        }
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.get_inner()
        if type_is_reference(inner) {
            return "0"
        }
        var struct_name = ensure_nullable_scalar_typedef(inner)
        return "(({struct_name})\{ .has_value = false, .value = {default_value_for_type(inner)} })"
    }
    return "0"
}

func is_float_kind(kind: Analysis.Types.NumericKind): Boolean {
    if kind == 'float_kind' {
        return true
    }
    return kind == 'double_kind'
}

func string_conversion(code: String, from: Analysis.SpiteType): String {
    var scalar = type_shape.as_scalar(from)
    if scalar {
        var value_class = value_class_of(scalar.kind)
        if value_class {
            var string_function = value_class.find_function("to_string")
            if string_function {
                return "{string_function.c_name}({code})"
            }
        }
        report(
            "{type_with_article(from)} becomes text through the to_string() function of its class in library/, and that class declares none",
        )
        return "(&spite_static_string_empty)"
    }
    var enum_type = type_shape.as_enum(from)
    if enum_type {
        return "spite_string_from_cstring_owned({enum_type.c_name}___name({code}))"
    }
    return code
}

func long_text(code: String): String {
    var wide_type = long_type()
    return string_conversion("((int64_t)({code}))", wide_type)
}

func allocator_text(): String {
    var prelude = Prelude()
    if debug_memory {
        return prelude.table_allocator()
    }
    var counted = prelude.counted_allocator()
    var plain = prelude.plain_allocator()
    return builder.type_placeholder_if_kept("Memory_Heap_live_allocations", counted, plain)
}

func debug_registration(pointer: String, class_id: String): String {
    assert debug_memory
    return "#ifdef SPITE_DEBUG_MEMORY\nspite_debug_register_object({pointer}, {class_id});\n#endif\n"
}

func emit_allocation_table() {
    var allocation_table = find_class_by_qualified("AllocationTable")
    crash allocation_table
    var table = allocation_table.c_name
    var entered = "{table}* spite_table = spite_allocation_table_enter();"
    var leave = "spite_allocation_table_leave();"
    var lines = List<String>()
    lines.append("#ifdef SPITE_DEBUG_MEMORY")
    lines.append("static {table}* spite_allocation_table = 0;")
    lines.append("static SPITE_THREAD_LOCAL bool spite_allocation_table_busy = false;")
    lines.append("#ifdef SPITE_THREADS")
    lines.append("static int32_t spite_allocation_table_lock = 0;")
    lines.append("#endif")
    lines.append("static void spite_allocation_table_leave(void) \{")
    lines.append("spite_allocation_table_busy = false;")
    lines.append("#ifdef SPITE_THREADS")
    lines.append("__atomic_store_n(&spite_allocation_table_lock, 0, __ATOMIC_RELEASE);")
    lines.append("#endif")
    lines.append("}")
    lines.append("static {table}* spite_allocation_table_enter(void) \{")
    lines.append("#ifdef SPITE_THREADS")
    lines.append("while (__atomic_exchange_n(&spite_allocation_table_lock, 1, __ATOMIC_ACQUIRE) != 0) \{}")
    lines.append("#endif")
    lines.append("spite_allocation_table_busy = true;")
    lines.append("if (spite_allocation_table == 0) spite_allocation_table = {table}___make();")
    lines.append("return spite_allocation_table;")
    lines.append("}")
    lines.append("void* spite_debug_realloc(void* pointer, size_t size) \{")
    lines.append("if (spite_allocation_table_busy) return realloc(pointer, size);")
    lines.append(entered)
    lines.append(
        "void* result = (void*)(intptr_t){table}_resize(spite_table, (int64_t)(intptr_t)pointer, (int64_t)size);",
    )
    lines.append(leave)
    lines.append("return result;")
    lines.append("}")
    lines.append("void spite_debug_free(void* pointer) \{")
    lines.append("if (pointer == 0) return;")
    lines.append("if (spite_allocation_table_busy) \{ free(pointer); return; }")
    lines.append(entered)
    lines.append("{table}_free(spite_table, (int64_t)(intptr_t)pointer);")
    lines.append(leave)
    lines.append("}")
    lines.append("void spite_debug_register_object(void* pointer, int32_t class_id) \{")
    lines.append("if (pointer == 0 || spite_allocation_table_busy) return;")
    lines.append(entered)
    lines.append("{table}_register_object(spite_table, (int64_t)(intptr_t)pointer, class_id);")
    lines.append(leave)
    lines.append("}")
    lines.append("void spite_debug_set_class_names(const char* const* names, int64_t count) \{")
    lines.append(entered)
    lines.append("{table}_name_classes(spite_table, (int64_t)(intptr_t)names, count);")
    lines.append(leave)
    lines.append("}")
    lines.append("void spite_debug_report(void) \{")
    lines.append(entered)
    lines.append("{table}_report(spite_table);")
    lines.append(leave)
    lines.append("}")
    lines.append("int64_t spite_live_allocation_count(void) \{")
    lines.append(entered)
    lines.append("int64_t count = {table}_live_allocations(spite_table);")
    lines.append(leave)
    lines.append("return count;")
    lines.append("}")
    lines.append("#endif")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func cast(code: String, from: Analysis.SpiteType, to: Analysis.SpiteType): String {
    if types_equal(from, to) {
        return code
    }
    if type_shape.is_symbol(from) and type_shape.as_string(to) {
        return code
    }
    if type_shape.as_string(from) and type_shape.is_symbol(to) {
        report(
            "text is not a Symbol: a Symbol is written 'name', and text becomes one with Symbol(text), which answers Symbol? -- null unless the program already uses that symbol",
        )
        return code
    }
    var from_function = type_shape.as_class_ref(from)
    var to_function = type_shape.as_class_ref(to)
    if from_function {
        if to_function {
            if from_function.has_signature and not to_function.has_signature and to_function.c_name == "Spite_Function" {
                return code
            }
        }
    }
    if type_shape.is_void(from) {
        var nothing_class = type_shape.as_class_ref(to)
        if nothing_class {
            if nothing_class.c_name == "Nothing" {
                return "(\{ {code}; Nothing___default(); })"
            }
        }
    }
    var to_nullable = type_shape.as_nullable(to)
    if to_nullable {
        var inner = to_nullable.get_inner()
        var inner_code = cast(code, from, inner)
        if type_is_reference(inner) {
            return inner_code
        }
        return "(({c_type_name(to)})\{ .has_value = true, .value = {inner_code} })"
    }
    var to_union = type_shape.as_union(to)
    if to_union {
        var from_class_ref = type_shape.as_class_ref(from)
        if from_class_ref {
            var admitted_union = find_union_by_c_name(to_union.c_name)
            var admitted_class = find_class_by_c_name(from_class_ref.c_name)
            if admitted_union {
                if admitted_class {
                    admit_to_union(admitted_union, admitted_class)
                }
            }
            return "(({to_union.c_name})({code}))"
        }
        var shaped_union = find_union_by_c_name(to_union.c_name)
        if shaped_union {
            if shaped_union.is_shape {
                return shaped_value(code, from, to, shaped_union)
            }
        }
        return "(({to_union.c_name})({code}))"
    }
    if type_shape.as_string(to) {
        if type_shape.as_scalar(from) {
            return string_conversion(code, from)
        }
        if is_enum_type(from) {
            return string_conversion(code, from)
        }
        report_mismatch(from, to)
        return code
    }
    if type_shape.as_string(from) {
        var to_enum = type_shape.as_enum(to)
        if to_enum {
            crash to_enum.values.count() > 0
            var chosen_code = enum_from_text_lines(to_enum, "spite_enum_text", "spite_enum_value", ";")
            return "(\{ SpiteString* spite_enum_text = {code}; {to_enum.c_name} spite_enum_value = {to_enum.c_name}_{to_enum.values[0]}; {chosen_code} spite_enum_value; })"
        }
        var to_scalar = type_shape.as_scalar(to)
        if to_scalar {
            var target_label = type_label(to)
            var conversion_name = words_of(target_label).join("_")
            var conversion = written_string_function("to_{conversion_name}")
            if conversion {
                return "{conversion.c_name}({code})"
            }
            if is_float_kind(to_scalar.kind) {
                return "(({c_type_name(to)})(SpiteString_to_double({code})))"
            }
            return "(({c_type_name(to)})(SpiteString_to_long({code})))"
        }
    }
    var to_scalar_plain = type_shape.as_scalar(to)
    if to_scalar_plain {
        if type_shape.as_scalar(from) {
            var conversion = numeric_conversion(from, to)
            if conversion.is_empty() {
                return "(({c_type_name(to)})({code}))"
            }
            return "{conversion}(0, {code})"
        }
        report_mismatch(from, to)
        return code
    }
    report_mismatch(from, to)
    return code
}

func numeric_conversion(from: Analysis.SpiteType, to: Analysis.SpiteType): String {
    var from_label = type_label(from)
    var to_label = type_label(to)
    var key = "{from_label} {to_label}"
    if conversion_names.has(key) {
        crash conversion_names[key]
        return conversion_names[key]
    }
    var conversion_name = ""
    var to_scalar = type_shape.as_scalar(to)
    crash to_scalar
    var target_class = value_class_of(to_scalar.kind)
    if target_class {
        var source_words = words_of(from_label)
        var source_name = source_words.join("_")
        var conversion = find_or_instantiate_function(target_class, "from_{source_name}")
        if conversion {
            conversion_name = conversion.c_name
            conversion_names[key] = conversion_name
        }
    }
    return conversion_name
}

func report_mismatch(from: Analysis.SpiteType, to: Analysis.SpiteType) {
    assert not (type_shape.is_void(from) or type_shape.is_void(to))
    var names = type_display_names(from, to)
    var first_name = names.first()
    crash first_name
    var last_name = names.last()
    crash last_name
    var found_name = with_article(first_name)
    var wanted_name = with_article(last_name)
    if type_shape.as_nullable(from) {
        report(
            "this value may be null (it is {found_name}), but {wanted_name} is needed: narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
        )
        return
    }
    report("{found_name} cannot be used where {wanted_name} is needed")
}

func retain_call(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}___retain({code})"
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "SpiteString___retain({code})"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        return "{ensure_list(list_type_element)}___retain({code})"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.get_element()
        return "{ensure_dictionary(dictionary_type_element)}___retain({code})"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return "{union_type.c_name}___retain({code})"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.get_inner()
        return retain_call(nullable_inner, code)
    }
    return code
}

func release_call(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return "{class_ref.c_name}___release({code})"
    }
    if type_shape.as_string(spite_type) or type_shape.is_symbol(spite_type) {
        return "SpiteString___release({code})"
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        return "{ensure_list(list_type_element)}___release({code})"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.get_element()
        return "{ensure_dictionary(dictionary_type_element)}___release({code})"
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        return "{union_type.c_name}___release({code})"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.get_inner()
        return release_call(nullable_inner, code)
    }
    return code
}

func owns(result: ExpressionResult, expression: Syntax.Expressions.Expression): Boolean {
    if result.owning_override == true {
        return true
    }
    assert result.owning_override != false
    return is_owning_shape(expression)
}

func is_owning_shape(expression: Syntax.Expressions.Expression): Boolean {
    var identifier = shape.as_identifier(expression)
    assert not identifier
    var indexed = shape.as_index(expression)
    if indexed {
        assert not is_bound_attributes_index(indexed)
        if is_bound_member_index(indexed) {
            var read = bound_member_expression(indexed)
            return is_owning_shape(read)
        }
    }
    var member = shape.as_member(expression)
    if member {
        if member.name == "class" or member.name == "attributes" or member.name == "functions" {
            return true
        }
        crash member.object
        var object_identifier = shape.as_identifier(member.object)
        if object_identifier {
            if arguments_parameter_names.contains(object_identifier.name) {
                return true
            }
        }
        return is_owning_shape(member.object)
    }
    return true
}

func coerce_for_store(
    expression_ast: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    if shape.is_null_literal(expression_ast) {
        return default_value_for_type(expected_type)
    }
    var list_literal = shape.as_list_literal(expression_ast)
    if list_literal {
        var expected_inner_type = expected_type_without_nullable(expected_type)
        var expected_list = type_shape.as_list(expected_inner_type)
        if expected_list {
            var expected_list_element = expected_list.get_element()
            var literal_result = generate_list_literal(list_literal, expected_list_element, scope, class_information)
            return literal_result.code
        }
    }
    var enum_literal = shape.as_enum_literal(expression_ast)
    if enum_literal {
        var expected_inner_type = expected_type_without_nullable(expected_type)
        if type_shape.is_symbol(expected_inner_type) {
            return ensure_symbol(enum_literal.value)
        }
        if type_shape.as_string(expected_inner_type) and not any_enum_has(enum_literal.value) {
            var symbol_text = ensure_symbol(enum_literal.value)
            return cast(symbol_text, expected_inner_type, expected_type)
        }
        var expected_enum = expected_enum_of(expected_type)
        if expected_enum {
            var value_code = enum_value_code(enum_literal, expected_enum)
            expected_inner_type = expected_type_without_nullable(expected_type)
            return cast(value_code, expected_inner_type, expected_type)
        }
    }
    var passed_class = class_passed_as_object(expression_ast, expected_type, scope, class_information)
    if passed_class {
        var passed_type = instance_type_of(passed_class)
        return class_object_call(passed_type)
    }
    var saved_counter = temporary_counter
    var result = generate_expression(expression_ast, scope, class_information)
    var result_type = result.get_type()
    if joins_into(result_type, expected_type) {
        rewind_temporaries(saved_counter)
        var joined_ast = implicit_join_ast(expression_ast)
        return coerce_for_store(joined_ast, expected_type, scope, class_information)
    }
    var casted = cast(result.code, result_type, expected_type)
    if type_needs_drop(expected_type) {
        if owns(result, expression_ast) or is_boxed_into_shape(result_type, expected_type) {
            return casted
        }
        return retain_call(expected_type, casted)
    }
    return casted
}

func joinable_handle(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(spite_type)
    assert class_ref
    var handle = find_class_by_c_name(class_ref.c_name)
    assert handle
    var is_handle = handle.qualified_dotted == "Concurrent" or handle.qualified_dotted == "Parallel"
    assert is_handle and not handle.is_generic_template and not handle.codegen_types.is_empty()
    var result_class = type_shape.as_class_ref(handle.codegen_types[0])
    if result_class {
        assert result_class.c_name != "Nothing"
    }
    return handle
}

func joins_into(result_type: Analysis.SpiteType, expected_type: Analysis.SpiteType): Boolean {
    assert joinable_handle(result_type)
    var expected_inner = expected_type_without_nullable(expected_type)
    return not types_equal(result_type, expected_inner)
}

func implicit_join_ast(handle_ast: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var joining = Syntax.Expressions.MemberExpression(handle_ast, "_result")
    implicit_joins.append(joining)
    var no_arguments = List<Syntax.Expressions.Expression>()
    var joined: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(joining, no_arguments)
    return joined
}

func is_implicit_join(member: Syntax.Expressions.MemberExpression): Boolean {
    assert member.name == "_result"
    var index = 0
    while index < implicit_joins.count() {
        if implicit_joins.get_at(index) == member {
            return true
        }
        index = index + 1
    }
    return false
}

func forwards_to_result(handle: Analysis.ClassInfo, name: String): Boolean {
    assert name != "finished" and name != "class" and not name.starts_with("_")
    assert not handle.find_function(name)
    return true
}

func generate_joined(
    expression_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var saved_counter = temporary_counter
    var result = generate_expression(expression_ast, scope, class_information)
    var result_type = result.get_type()
    if not joinable_handle(result_type) {
        return result
    }
    rewind_temporaries(saved_counter)
    var joined_ast = implicit_join_ast(expression_ast)
    var joined = generate_expression(joined_ast, scope, class_information)
    joined.owning_override = true
    return joined
}

func expected_type_without_nullable(expected_type: Analysis.SpiteType): Analysis.SpiteType {
    var nullable = type_shape.as_nullable(expected_type)
    if nullable {
        return nullable.get_inner()
    }
    return expected_type
}

func is_enum_literal(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_enum_literal(expression) {
        return true
    }
    return false
}

func is_enum_type(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_enum(spite_type) {
        return true
    }
    return false
}

func expected_enum_of(expected_type: Analysis.SpiteType): Analysis.Types.EnumType? {
    var expected_inner_type = expected_type_without_nullable(expected_type)
    return type_shape.as_enum(expected_inner_type)
}

func next_temporary(): String {
    temporary_counter = temporary_counter + 1
    return "spite_temp_{temporary_counter}"
}

func hex_digit(value: Integer): String {
    var digits = "0123456789abcdef"
    return digits.character_at(value)
}

func hex_escape(code: Integer): String {
    var high = code / 16
    var low = code % 16
    return "\\x{hex_digit(high)}{hex_digit(low)}"
}

func escape_c_string(value: String): String {
    var result = ""
    var index = 0
    while index < value.length() {
        var code = value.code_at(index)
        if code == 34 {
            result = "{result}\\\""
        } else if code == 92 {
            result = "{result}\\\\"
        } else if code == 10 {
            result = "{result}\\n"
        } else if code == 13 {
            result = "{result}\\r"
        } else if code == 9 {
            result = "{result}\\t"
        } else if code < 32 or code > 126 {
            result = result + hex_escape(code)
        } else {
            result = result + value.character_at(index)
        }
        index = index + 1
    }
    return result
}

func render_string_literal(value: String): String {
    literal_counter = literal_counter + 1
    var literal_name = "spite_lit_{literal_counter}"
    var escaped = escape_c_string(value)
    builder.add_typedef("static SpiteString {literal_name} = SPITE_STATIC_STRING(\"{escaped}\", {value.length()});")
    constant_texts["(&{literal_name})"] = value
    return "(&{literal_name})"
}

func lookup_static_type(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var identifier = shape.as_identifier(expression)
    assert identifier
    if identifier.name == "self" {
        var self_type: Analysis.SpiteType = Analysis.Types.ClassRefType(class_information.c_name)
        return self_type
    }
    if identifier.name == "this" {
        return value_class_type(class_information)
    }
    var scope_type = scope.lookup_type(identifier.name)
    if scope_type {
        return scope_type
    }
    var field = class_information.find_field(identifier.name)
    if field {
        mark_attribute_read(class_information, identifier.name)
        return field.get_type()
    }
    return null
}

func generate_integer_literal(literal: Syntax.Expressions.IntegerLiteral): ExpressionResult {
    var value = literal.value
    if value >= -2147483648 and value <= 2147483647 {
        return ExpressionResult("{value}", Analysis.Types.ScalarType('integer_kind'))
    }
    return ExpressionResult("{value}", Analysis.Types.ScalarType('long_kind'))
}

func generate_identifier(
    identifier: Syntax.Expressions.IdentifierExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if identifier.name == "self" {
        return ExpressionResult("self", Analysis.Types.ClassRefType(class_information.c_name))
    }
    if identifier.name == "this" {
        var receiver_type = value_class_type(class_information)
        return ExpressionResult("self", receiver_type)
    }
    var override = scope.lookup_override(identifier.name)
    var scope_type = scope.lookup_type(identifier.name)
    if scope_type {
        if override {
            return ExpressionResult(override, scope_type)
        }
        var local_code = c_value_name(identifier.name)
        return ExpressionResult(local_code, scope_type)
    }
    var field = class_information.find_field(identifier.name)
    if field {
        mark_attribute_read(class_information, identifier.name)
        if identifier.name == "_namespace" and class_information.c_name == "Spite_Class" {
            namespace_read_used = true
        }
        if class_information.is_value_class and class_information.c_name != "SpiteString" {
            report(
                "'{identifier.name}' is the memory {class_information.simple_name} is kept in, and the compiler keeps the value itself there: write 'this'",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        var field_type = field.get_type()
        if atomic_owner == class_information.c_name and atomic_fields.contains(identifier.name) {
            var loaded = "SPITE_SINGLETON_LOAD({class_information.c_name}, self->{c_value_name(identifier.name)})"
            return ExpressionResult(loaded, field_type)
        }
        return ExpressionResult("self->{c_value_name(identifier.name)}", field_type)
    }
    if identifier.name == "class" {
        var self_result = ExpressionResult("self", Analysis.Types.ClassRefType(class_information.c_name))
        var class_of_self = generate_reflection_read("class", self_result, identifier)
        if class_of_self {
            class_of_self.owning_override = true
            return class_of_self
        }
    }
    var named_function = find_or_instantiate_function(class_information, identifier.name)
    if named_function {
        if not named_function.is_constructor {
            var class_type = class_type_of(class_information)
            return function_value(class_information, named_function, ExpressionResult("self", class_type), identifier)
        }
    }
    var named_class = find_class(identifier.name, class_information.qualified_dotted)
    if named_class {
        report(
            "'{identifier.name}' is a class, not a value: write '{identifier.name}()' to make one, and give it a name with 'var ... = ' -- or, for the class itself, pass it where a 'Spite.Class' is wanted",
        )
    } else {
        report("unknown identifier '{identifier.name}'")
    }
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func is_boolean_result_operator(operator: Syntax.Expressions.BinaryOperator): Boolean {
    assert operator != 'add'
    assert operator != 'subtract'
    assert operator != 'multiply'
    assert operator != 'divide'
    assert operator != 'modulo'
    return true
}

func binary_operator_symbol(operator: Syntax.Expressions.BinaryOperator): String {
    if operator == 'add' {
        return "+"
    }
    if operator == 'subtract' {
        return "-"
    }
    if operator == 'multiply' {
        return "*"
    }
    if operator == 'divide' {
        return "/"
    }
    if operator == 'modulo' {
        return "%"
    }
    if operator == 'equal' {
        return "=="
    }
    if operator == 'not_equal' {
        return "!="
    }
    if operator == 'less' {
        return "<"
    }
    if operator == 'less_equal' {
        return "<="
    }
    if operator == 'greater' {
        return ">"
    }
    if operator == 'greater_equal' {
        return ">="
    }
    if operator == 'logical_and' {
        return "&&"
    }
    return "||"
}

func text_converter(value_type: Analysis.SpiteType): Analysis.FunctionInfo? {
    var class_ref = type_shape.as_class_ref(value_type)
    assert class_ref
    assert not class_ref.has_signature
    var described = find_class_by_c_name(class_ref.c_name)
    assert described
    var converter = described.find_function("to_string")
    assert converter
    assert converter.parameters.is_empty()
    return converter
}

func text_of_class(
    value_ast: Syntax.Expressions.Expression,
    value: ExpressionResult,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var value_type = value.get_type()
    if not text_converter(value_type) {
        return value
    }
    var callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(value_ast, "to_string")
    var no_arguments = List<Syntax.Expressions.Expression>()
    var called: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, no_arguments)
    return generate_expression(called, scope, class_information)
}

func generate_string_binary(
    operator: Syntax.Expressions.BinaryOperator,
    left_result: ExpressionResult,
    left_ast: Syntax.Expressions.Expression,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var right_result = generate_joined(right_ast, scope, class_information)
    var right_became_text = false
    if operator == 'add' {
        var right_value_type = right_result.get_type()
        if text_converter(right_value_type) {
            right_became_text = true
        }
        right_result = text_of_class(right_ast, right_result, scope, class_information)
    }
    var right_result_type = right_result.get_type()
    var right_code_casted = cast(right_result.code, right_result_type, Analysis.Types.StringType())
    var left_temporary = next_temporary()
    var right_temporary = next_temporary()
    var lines = List<String>()
    lines.append("SpiteString* {left_temporary} = {left_result.code};")
    lines.append("SpiteString* {right_temporary} = {right_code_casted};")
    var result_type: Analysis.SpiteType = Analysis.Types.StringType()
    var combine = ""
    if operator == 'add' {
        combine = "SpiteString_sum({left_temporary}, SpiteString___retain({right_temporary}))"
    } else {
        result_type = Analysis.Types.ScalarType('boolean_kind')
        combine = text_comparison(operator, left_temporary, right_temporary)
    }
    var result_temporary = next_temporary()
    lines.append("{c_type_name(result_type)} {result_temporary} = {combine};")
    if owns(left_result, left_ast) {
        lines.append("SpiteString___release({left_temporary});")
    }
    var right_was_converted = not type_shape.as_string(right_result_type)
    if owns(right_result, right_ast) or right_was_converted or right_became_text {
        lines.append("SpiteString___release({right_temporary});")
    }
    lines.append("{result_temporary};")
    return ExpressionResult("(\{ {lines.join(" ")} })", result_type)
}

func generate_text_join(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var pieces = List<Syntax.Expressions.Expression>()
    var leftmost = text_join_leftmost(binary, pieces)
    if not shape.as_string_literal(leftmost) {
        var saved_counter = temporary_counter
        var probe = generate_joined(leftmost, scope, class_information)
        rewind_temporaries(saved_counter)
        var probe_text = as_text(probe)
        var probe_type = probe_text.get_type()
        assert type_shape.as_string(probe_type)
    }
    var join = TextJoin()
    var first = generate_joined(leftmost, scope, class_information)
    first = as_text(first)
    var first_owned = owns(first, leftmost)
    add_text_piece(join, first.code, first_owned)
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var piece_result = generate_joined(piece, scope, class_information)
        var piece_value_type = piece_result.get_type()
        var became_text = false
        if text_converter(piece_value_type) {
            became_text = true
        }
        piece_result = text_of_class(piece, piece_result, scope, class_information)
        var piece_type = piece_result.get_type()
        var string_spite_type = string_type()
        var piece_code = cast(piece_result.code, piece_type, string_spite_type)
        var converted = not type_shape.as_string(piece_type)
        var owned = owns(piece_result, piece) or converted or became_text
        add_text_piece(join, piece_code, owned)
        index = index + 1
    }
    flush_constant_text(join)
    var text_type = string_type()
    if join.codes.is_empty() {
        var empty = render_string_literal("")
        return ExpressionResult(empty, text_type)
    }
    crash join.codes[0]
    if join.codes.count() == 1 and join.views.contains(join.codes[0]) {
        crash join.originals[0]
        return ExpressionResult(join.originals[0], text_type)
    }
    if join.codes.count() == 1 {
        var only = join.codes[0]
        if join.lines.is_empty() or join.released.contains(only) {
            join.lines.append("{only};")
        } else {
            join.lines.append("SpiteString___retain({only});")
        }
        return ExpressionResult("(\{ {join.lines.join(" ")} })", text_type)
    }
    var parts = next_temporary()
    var result = next_temporary()
    join.lines.append("SpiteString* {parts}[] = \{{join.codes.join(", ")}};")
    join.lines.append("SpiteString* {result} = spite_string_join({join.codes.count()}, {parts});")
    var released_index = 0
    while released_index < join.released.count() {
        join.lines.append("SpiteString___release({join.released[released_index]});")
        released_index = released_index + 1
    }
    join.lines.append("{result};")
    return ExpressionResult("(\{ {join.lines.join(" ")} })", text_type)
}

func text_join_leftmost(
    binary: Syntax.Expressions.BinaryExpression,
    pieces: List<Syntax.Expressions.Expression>,
): Syntax.Expressions.Expression {
    crash binary.left
    crash binary.right
    var leftmost = binary.left
    var left_binary = shape.as_binary(binary.left)
    if left_binary {
        if left_binary.operator == 'add' {
            leftmost = text_join_leftmost(left_binary, pieces)
        }
    }
    pieces.append(binary.right)
    return leftmost
}

func add_text_piece(join: TextJoin, code: String, owned: Boolean) {
    var digits = digits_of(code)
    if not digits.is_empty() {
        flush_constant_text(join)
        var view = next_temporary()
        var viewed = digits_view(view, digits)
        join.lines.append(viewed)
        join.codes.append("(&{view})")
        join.views.append("(&{view})")
        join.originals.append(code)
        return
    }
    var constant = constant_texts.get(code)
    if constant {
        join.constant = "{join.constant}{constant}"
        return
    }
    flush_constant_text(join)
    var temporary = next_temporary()
    join.lines.append("SpiteString* {temporary} = {code};")
    join.codes.append(temporary)
    if owned {
        join.released.append(temporary)
    }
}

func digits_view(view: String, digits: String): String {
    return "char {view}_digits[24]; SpiteString {view} = SPITE_STATIC_STRING({view}_digits, spite_long_digits({view}_digits, (int64_t)({digits})));"
}

func digits_of(code: String): String {
    var names = ["Integer", "Long"]
    var index = 0
    while index < names.count() {
        var name = names[index]
        var value_class = find_class_by_c_name("Spite{name}")
        crash value_class
        var converter = value_class.find_function("to_string")
        crash converter
        var prefix = "{converter.c_name}("
        var written_in = converter.source_path
        if written_in.is_empty() {
            written_in = value_class.source_path
        }
        var file_name = words_of(name).join("_")
        var own_converter = written_in.ends_with("library/{file_name}.spite")
        if own_converter and code.starts_with(prefix) and code.ends_with(")") {
            var prefix_length = prefix.length()
            var code_length = code.length()
            var inner = code.slice(prefix_length, code_length - 1)
            assert balanced_parentheses(inner)
            return inner
        }
        index = index + 1
    }
    return ""
}

func balanced_parentheses(code: String): Boolean {
    var depth = 0
    var index = 0
    while index < code.length() {
        var code_point = code.code_at(index)
        if code_point == 40 {
            depth = depth + 1
        } else if code_point == 41 {
            depth = depth - 1
        }
        assert depth >= 0
        index = index + 1
    }
    return depth == 0
}

func flush_constant_text(join: TextJoin) {
    assert not join.constant.is_empty()
    var literal = render_string_literal(join.constant)
    join.codes.append(literal)
    join.constant = ""
}

func text_comparison(
    operator: Syntax.Expressions.BinaryOperator,
    left_temporary: String,
    right_temporary: String,
): String {
    if operator == 'equal' {
        return "SpiteString_equals({left_temporary}, SpiteString___retain({right_temporary}))"
    } else if operator == 'not_equal' {
        return "(!(SpiteString_equals({left_temporary}, SpiteString___retain({right_temporary}))))"
    } else if operator == 'less' {
        return "SpiteString_less_than({left_temporary}, SpiteString___retain({right_temporary}))"
    } else if operator == 'greater' {
        return "SpiteString_greater_than({left_temporary}, SpiteString___retain({right_temporary}))"
    } else if operator == 'less_equal' {
        return "(!(SpiteString_greater_than({left_temporary}, SpiteString___retain({right_temporary}))))"
    }
    return "(!(SpiteString_less_than({left_temporary}, SpiteString___retain({right_temporary}))))"
}

func maybe_null_only_on_the_right(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash binary.left
    crash binary.right
    assert not shape.is_null_literal(binary.right) and not is_enum_literal(binary.left) and not is_enum_literal(binary.right)
    var saved_counter = temporary_counter
    var left_probe = generate_expression(binary.left, scope, class_information)
    var right_probe = generate_expression(binary.right, scope, class_information)
    rewind_temporaries(saved_counter)
    var right_probe_type = right_probe.get_type()
    var left_probe_type = left_probe.get_type()
    return type_shape.as_nullable(right_probe_type) and not type_shape.as_nullable(left_probe_type)
}

func tested_class_of(
    expression: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var tested = resolve_tested_class(expression, class_information)
    assert tested
    var value_type = instance_type_of(tested)
    var boxed_class = boxed_class_of(value_type)
    if boxed_class {
        ensure_box(boxed_class, value_type)
    }
    return tested
}

func resolve_tested_class(
    expression: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var codegen_type = shape.as_generic_identifier(expression)
    if codegen_type {
        return codegen_tested_class(codegen_type.name, class_information)
    }
    var named = shape.as_generic_call(expression)
    if named {
        assert named.names_class
        crash named.callee
        var template = try_resolve_static_path(named.callee, class_information.qualified_dotted)
        assert template
        if not template.is_generic_template {
            report(
                "'{template.simple_name}' takes no codegen values: write '{template.simple_name}' alone to test for it",
            )
            return null
        }
        return instantiate_generic(template, named.type_arguments, class_information.qualified_dotted)
    }
    return try_resolve_static_path(expression, class_information.qualified_dotted)
}

func codegen_tested_class(name: String, class_information: Analysis.ClassInfo): Analysis.ClassInfo? {
    var bare_name = without_dollar(name)
    var bound = codegen_index(class_information, bare_name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    crash class_information.codegen_types[bound]
    return class_of_type(class_information.codegen_types[bound])
}

func codegen_is_class(expression: Syntax.Expressions.Expression, class_information: Analysis.ClassInfo): Boolean {
    var codegen_type = shape.as_generic_identifier(expression)
    assert codegen_type
    if codegen_tested_class(codegen_type.name, class_information) {
        return true
    }
    return false
}

func class_of_type(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        return find_class_by_c_name(class_ref.c_name)
    }
    if type_shape.as_string(spite_type) {
        return find_class_by_c_name("SpiteString")
    }
    var boxed_class = boxed_class_of(spite_type)
    if boxed_class {
        return boxed_class
    }
    return container_class_of(spite_type)
}

func known_codegen_class_test(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean? {
    crash binary.left
    crash binary.right
    assert shape.as_generic_identifier(binary.right)
    var tested_class = tested_class_of(binary.right, class_information)
    assert tested_class
    var saved_counter = temporary_counter
    var subject = generate_expression(binary.left, scope, class_information)
    rewind_temporaries(saved_counter)
    var subject_type = subject.get_type()
    var is_nullable = false
    var nullable = type_shape.as_nullable(subject_type)
    if nullable {
        subject_type = nullable.get_inner()
        is_nullable = true
    }
    var known = known_membership(subject_type, tested_class)
    assert known == false or known == true and not is_nullable
    if binary.operator == 'equal' {
        return known == true
    }
    return known == false
}

func known_membership(subject_type: Analysis.SpiteType, tested_class: Analysis.ClassInfo): Boolean? {
    var subject_union = type_shape.as_union(subject_type)
    if subject_union {
        var union_information = find_union_by_c_name(subject_union.c_name)
        assert union_information
        assert not union_information.is_shape
        assert not union_information.has_member(tested_class.c_name)
        return false
    }
    var subject_class = class_of_type(subject_type)
    assert subject_class
    assert subject_class.c_name != "Spite_Class" or tested_class.c_name == "Spite_Class"
    return subject_class.c_name == tested_class.c_name
}

func check_tested_member(information: Analysis.UnionInfo, tested_class: Analysis.ClassInfo) {
    assert not information.has_member(tested_class.c_name)
    if information.is_shape {
        admit_to_union(information, tested_class)
        return
    }
    report("'{tested_class.simple_name}' is not a member of union '{information.simple_name}', so this is never true")
}

func is_class_object_type(spite_type: Analysis.SpiteType): Boolean {
    var class_ref = type_shape.as_class_ref(spite_type)
    assert class_ref
    return class_ref.c_name == "Spite_Class" and not class_ref.has_signature
}

func generate_class_object_comparison(
    binary: Syntax.Expressions.BinaryExpression,
    tested: ExpressionResult,
    tested_class: Analysis.ClassInfo,
    is_nullable: Boolean,
): ExpressionResult {
    crash binary.left
    var temporary = next_temporary()
    var object_temporary = next_temporary()
    var result_temporary = next_temporary()
    var tested_type = tested.get_type()
    var named_type = instance_type_of(tested_class)
    var lines = List<String>()
    lines.append("{c_type_name(tested_type)} {temporary} = {tested.code};")
    lines.append("Spite_Class* {object_temporary} = {class_object_call(named_type)};")
    var test = "({temporary} == {object_temporary})"
    if is_nullable {
        test = "({temporary} != 0 && {test})"
    }
    if binary.operator == 'not_equal' {
        test = "(!{test})"
    }
    lines.append("bool {result_temporary} = {test};")
    lines.append("Spite_Class___release({object_temporary});")
    if owns(tested, binary.left) {
        lines.append("{release_call(tested_type, temporary)};")
    }
    lines.append("{result_temporary};")
    var boolean_spite_type = boolean_type()
    return ExpressionResult("(\{ {lines.join(" ")} })", boolean_spite_type)
}

func class_passed_as_object(
    expression: Syntax.Expressions.Expression,
    expected_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var expected = expected_type_without_nullable(expected_type)
    assert is_class_object_type(expected)
    assert not shape.as_call(expression)
    var identifier = shape.as_identifier(expression)
    if identifier {
        assert not scope.lookup_type(identifier.name) and not class_information.find_field(identifier.name)
    }
    return tested_class_of(expression, class_information)
}

func generate_class_test(
    binary: Syntax.Expressions.BinaryExpression,
    tested_class: Analysis.ClassInfo,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash binary.left
    crash binary.right
    if shape.as_generic_identifier(binary.right) {
        var known = known_codegen_class_test(binary, scope, class_information)
        if known == true or known == false {
            var known_type = boolean_type()
            return ExpressionResult("{known == true}", known_type)
        }
    }
    var tested = generate_expression(binary.left, scope, class_information)
    var value_type = tested.get_type()
    var is_nullable = false
    var nullable = type_shape.as_nullable(value_type)
    if nullable {
        value_type = nullable.get_inner()
        is_nullable = true
    }
    if is_class_object_type(value_type) and tested_class.c_name != "Spite_Class" {
        return generate_class_object_comparison(binary, tested, tested_class, is_nullable)
    }
    var tested_union = type_shape.as_union(value_type)
    if tested_union {
        var union_information = find_union_by_c_name(tested_union.c_name)
        if union_information {
            check_tested_member(union_information, tested_class)
        }
    } else if not type_shape.as_class_ref(value_type) {
        report("'==' with a class asks what class a value is, and {type_with_article(value_type)} is not an object")
        var boolean_spite_type = boolean_type()
        return ExpressionResult("false", boolean_spite_type)
    }
    var temporary = next_temporary()
    var lines = List<String>()
    var tested_type = tested.get_type()
    lines.append("{c_type_name(tested_type)} {temporary} = {tested.code};")
    var test = class_id_test(temporary, tested_class)
    if is_nullable {
        test = "({temporary} != 0 && {test})"
    }
    if binary.operator == 'not_equal' {
        test = "(!{test})"
    }
    var result_temporary = next_temporary()
    lines.append("bool {result_temporary} = {test};")
    if owns(tested, binary.left) {
        lines.append("{release_call(tested_type, temporary)};")
    }
    lines.append("{result_temporary};")
    var boolean_spite_type = boolean_type()
    return ExpressionResult("(\{ {lines.join(" ")} })", boolean_spite_type)
}

func generate_binary(
    binary: Syntax.Expressions.BinaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash binary.left
    crash binary.right
    if binary.operator == 'equal' or binary.operator == 'not_equal' {
        var tested_class = tested_class_of(binary.right, class_information)
        if tested_class {
            if not try_resolve_static_path(binary.left, class_information.qualified_dotted) {
                return generate_class_test(binary, tested_class, scope, class_information)
            }
        }
        if maybe_null_only_on_the_right(binary, scope, class_information) {
            var mirrored: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression(
                binary.operator,
                binary.right,
                binary.left,
            )
            return generate_expression(mirrored, scope, class_information)
        }
    }
    if is_enum_literal(binary.left) and not is_enum_literal(binary.right) {
        var swapped_right = generate_expression(binary.right, scope, class_information)
        var swapped_right_type = swapped_right.get_type()
        var swapped_left_code = coerce_for_store(binary.left, swapped_right_type, scope, class_information)
        var swapped_code = "({swapped_left_code} {binary_operator_symbol(binary.operator)} {swapped_right.code})"
        return ExpressionResult(swapped_code, Analysis.Types.ScalarType('boolean_kind'))
    }
    if binary.operator == 'add' {
        var joined_text = generate_text_join(binary, scope, class_information)
        if joined_text {
            return joined_text
        }
    }
    var left = generate_joined(binary.left, scope, class_information)
    var left_type = left.get_type()
    var left_nullable = type_shape.as_nullable(left_type)
    if left_nullable {
        if binary.operator == 'equal' or binary.operator == 'not_equal' {
            var left_nullable_inner = left_nullable.get_inner()
            return generate_nullable_equality(
                binary,
                left,
                left_nullable_inner,
                binary.left,
                binary.right,
                scope,
                class_information,
            )
        }
        if binary.operator != 'logical_and' and binary.operator != 'logical_or' {
            report(
                "this value may be null (it is {type_with_article(left_type)}), so '{binary_operator_symbol(binary.operator)}' cannot use it yet: narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
    }
    left = as_text(left)
    left_type = left.get_type()
    if type_shape.as_string(left_type) {
        return generate_string_binary(binary.operator, left, binary.left, binary.right, scope, class_information)
    }
    var left_class_ref = type_shape.as_class_ref(left_type)
    if left_class_ref {
        var left_class = find_class_by_c_name(left_class_ref.c_name)
        if left_class {
            return generate_class_binary(
                binary.operator,
                left_class,
                left,
                binary.left,
                binary.right,
                scope,
                class_information,
            )
        }
    }
    if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
        var right_scope = Scope(scope)
        if binary.operator == 'logical_and' {
            narrow_proven_indices(binary.left, right_scope)
        }
        conditional_depth = conditional_depth + 1
        var other = generate_joined(binary.right, right_scope, class_information)
        conditional_depth = conditional_depth - 1
        report_maybe_boolean(left, "'{binary_operator_symbol(binary.operator)}'")
        report_maybe_boolean(other, "'{binary_operator_symbol(binary.operator)}'")
        var joined = "({owned_truth(left, binary.left)} {binary_operator_symbol(binary.operator)} {owned_truth(other, binary.right)})"
        return ExpressionResult(joined, Analysis.Types.ScalarType('boolean_kind'))
    }
    var right_code = ""
    if is_enum_literal(binary.right) and is_enum_type(left_type) {
        right_code = coerce_for_store(binary.right, left_type, scope, class_information)
    } else {
        var right = generate_joined(binary.right, scope, class_information)
        var right_type = right.get_type()
        right_code = cast(right.code, right_type, left_type)
        if not is_boolean_result_operator(binary.operator) and is_wider_right(binary, left_type, right_type) {
            report_wider_right(binary, left_type, right_type)
        }
        report_constant_overflow(binary)
    }
    var symbol = binary_operator_symbol(binary.operator)
    var code = "({left.code} {symbol} {right_code})"
    var checked = checked_division(binary, left.code, right_code, left_type, scope)
    if not checked.is_empty() {
        code = checked
    }
    if is_boolean_result_operator(binary.operator) {
        return ExpressionResult(code, Analysis.Types.ScalarType('boolean_kind'))
    }
    return ExpressionResult(code, left_type)
}

func checked_division(
    binary: Syntax.Expressions.BinaryExpression,
    left_code: String,
    right_code: String,
    left_type: Analysis.SpiteType,
    scope: Scope,
): String {
    assert binary.operator == 'divide' or binary.operator == 'modulo'
    var scalar = type_shape.as_scalar(left_type)
    assert scalar
    assert scalar.kind != 'boolean_kind' and not is_float_kind(scalar.kind)
    crash binary.right
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = binary
    var written = printer.source_expression(expression)
    var constant = constant_integer(binary.right)
    if constant == 0 or right_code == "0" {
        report(
            "'{written}' divides by zero, which always halts the program: a whole number cannot be divided by zero, so divide by something else, or leave the step out",
        )
        return ""
    }
    assert not constant
    var divisor_text = operand_text(binary.right)
    assert divisor_text.is_empty() or not scope.is_path_narrowed("~[{divisor_text}]")
    ensure_division_check()
    var c_type = c_type_name(left_type)
    var dividend = next_temporary()
    var divisor = next_temporary()
    var where = escape_c_string("{current_path}:{current_line} in {current_owner}.{current_function}")
    var operation = escape_c_string(written)
    var computed = "{dividend} {binary_operator_symbol(binary.operator)} {divisor}"
    if is_signed_kind(scalar.kind) and binary.operator == 'divide' {
        computed = "{divisor} == -1 ? ({c_type})(0 - (uint64_t){dividend}) : {dividend} / {divisor}"
    }
    if is_signed_kind(scalar.kind) and binary.operator == 'modulo' {
        computed = "{divisor} == -1 ? ({c_type})0 : {dividend} % {divisor}"
    }
    return "(\{ {c_type} {dividend} = {left_code}; {c_type} {divisor} = {right_code}; if ({divisor} == 0) spite_divided_by_zero(\"{operation}\", \"{where}\"); ({c_type})({computed}); })"
}

func is_signed_kind(kind: Analysis.Types.NumericKind): Boolean {
    return kind == 'tiny_kind' or kind == 'short_kind' or kind == 'integer_kind' or kind == 'long_kind'
}

func ensure_division_check() {
    assert not division_check_written
    division_check_written = true
    builder.add_prototype("static void spite_divided_by_zero(const char* operation, const char* where);")
    builder.add_support(
        "static void spite_divided_by_zero(const char* operation, const char* where) \{\nfflush(stdout);\nfprintf(stderr, \"spite: '%s' divided by zero, at %s\\n\", operation, where);\nexit(1);\n}",
    )
}

func is_wider_right(
    binary: Syntax.Expressions.BinaryExpression,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
): Boolean {
    var left_scalar = type_shape.as_scalar(left_type)
    var right_scalar = type_shape.as_scalar(right_type)
    assert left_scalar and right_scalar
    assert left_scalar.kind != 'boolean_kind' and right_scalar.kind != 'boolean_kind'
    crash binary.right
    assert not literal_fits(binary.right, left_scalar.kind)
    if is_float_kind(right_scalar.kind) and not is_float_kind(left_scalar.kind) {
        return true
    }
    return scalar_bits(right_scalar.kind) > scalar_bits(left_scalar.kind)
}

func scalar_bits(kind: Analysis.Types.NumericKind): Integer {
    if kind == 'tiny_kind' or kind == 'byte_kind' {
        return 8
    }
    if kind == 'short_kind' or kind == 'unsigned_short_kind' {
        return 16
    }
    if kind == 'long_kind' or kind == 'unsigned_long_kind' or kind == 'double_kind' or kind == 'address_kind' {
        return 64
    }
    return 32
}

func literal_fits(expression: Syntax.Expressions.Expression, kind: Analysis.Types.NumericKind): Boolean {
    var value = literal_value(expression)
    assert value
    var lowest: Long = 0
    var highest: Long = 9223372036854775807
    if kind == 'tiny_kind' {
        lowest = -128
        highest = 127
    } else if kind == 'byte_kind' {
        highest = 255
    } else if kind == 'short_kind' {
        lowest = -32768
        highest = 32767
    } else if kind == 'unsigned_short_kind' {
        highest = 65535
    } else if kind == 'integer_kind' {
        lowest = -2147483648
        highest = 2147483647
    } else if kind == 'unsigned_integer_kind' {
        highest = 4294967295
    } else if kind != 'unsigned_long_kind' {
        lowest = -9223372036854775807
    }
    return value >= lowest and value <= highest
}

func literal_value(expression: Syntax.Expressions.Expression): Long? {
    var literal = shape.as_integer_literal(expression)
    if literal {
        return literal.value
    }
    var negated = shape.as_unary(expression)
    assert negated
    assert negated.operator == 'negate'
    crash negated.operand
    var negated_literal = shape.as_integer_literal(negated.operand)
    assert negated_literal
    return -negated_literal.value
}

func report_wider_right(
    binary: Syntax.Expressions.BinaryExpression,
    left_type: Analysis.SpiteType,
    right_type: Analysis.SpiteType,
) {
    crash binary.left
    crash binary.right
    var printer = Syntax.SourcePrinter()
    var left_text = printer.source_expression(binary.left)
    var right_text = printer.source_expression(binary.right)
    var symbol = binary_operator_symbol(binary.operator)
    var left_name = type_display_name(left_type)
    var right_name = type_display_name(right_type)
    var fix = "store the left side in {with_article(right_name)} first ('var wide: {right_name} = {left_text}')"
    if binary.operator == 'add' or binary.operator == 'multiply' {
        fix = "write the {right_name} first ('{right_text} {symbol} {left_text}')"
    }
    report(
        "'{left_text} {symbol} {right_text}' is {operation_name(binary.operator)} in {left_name}, since arithmetic takes the left side's type, and the right side is {with_article(right_name)}, which would be cut to fit: {fix}, or store the right side in {with_article(left_name)} first if it fits one",
    )
}

func type_with_article(spite_type: Analysis.SpiteType): String {
    var name = type_display_name(spite_type)
    return with_article(name)
}

func with_article(name: String): String {
    var vowels = ["A", "E", "I", "O", "U"]
    var first_letter = name.slice(0, 1)
    if vowels.contains(first_letter) {
        return "an {name}"
    }
    return "a {name}"
}

func operation_name(operator: Syntax.Expressions.BinaryOperator): String {
    if operator == 'add' {
        return "an addition"
    }
    if operator == 'subtract' {
        return "a subtraction"
    }
    if operator == 'multiply' {
        return "a multiplication"
    }
    if operator == 'divide' {
        return "a division"
    }
    return "a remainder"
}

func report_constant_overflow(binary: Syntax.Expressions.BinaryExpression) {
    crash binary.left
    crash binary.right
    var left_value = constant_integer(binary.left)
    var right_value = constant_integer(binary.right)
    assert left_value and right_value
    var result = constant_operation(binary.operator, left_value, right_value)
    assert result
    assert result < -2147483648 or result > 2147483647
    var printer = Syntax.SourcePrinter()
    var expression: Syntax.Expressions.Expression = binary
    var written = printer.source_expression(expression)
    report(
        "'{written}' is {result}, which does not fit in an Integer, the type its arithmetic is done in, so it would wrap: write the number itself, {result}, which is a Long",
    )
}

func constant_integer(expression: Syntax.Expressions.Expression): Long? {
    var value = literal_value(expression)
    if value {
        assert value >= -2147483648 and value <= 2147483647
        return value
    }
    var binary = shape.as_binary(expression)
    assert binary
    crash binary.left
    crash binary.right
    var left_value = constant_integer(binary.left)
    var right_value = constant_integer(binary.right)
    assert left_value and right_value
    var result = constant_operation(binary.operator, left_value, right_value)
    assert result
    assert result >= -2147483648 and result <= 2147483647
    return result
}

func constant_operation(operator: Syntax.Expressions.BinaryOperator, left_value: Long, right_value: Long): Long? {
    if operator == 'add' {
        return left_value + right_value
    }
    if operator == 'subtract' {
        return left_value - right_value
    }
    if operator == 'multiply' {
        return left_value * right_value
    }
    assert right_value != 0
    if operator == 'divide' {
        return left_value / right_value
    }
    assert operator == 'modulo'
    return left_value % right_value
}

func generate_nullable_equality(
    binary: Syntax.Expressions.BinaryExpression,
    left: ExpressionResult,
    inner: Analysis.SpiteType,
    left_ast: Syntax.Expressions.Expression,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var compared_name = next_temporary()
    var compared_scope = Scope(scope)
    compared_scope.declare(compared_name, inner)
    var null_check = "{compared_name} != 0"
    if type_is_reference(inner) {
        compared_scope.set_override(compared_name, compared_name)
    } else {
        compared_scope.set_override(compared_name, "{compared_name}.value")
        null_check = "{compared_name}.has_value"
    }
    var narrowed_left: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(compared_name)
    var narrowed_comparison: Syntax.Expressions.Expression = Syntax.Expressions.BinaryExpression(
        binary.operator,
        narrowed_left,
        right_ast,
    )
    conditional_depth = conditional_depth + 1
    var compared = generate_expression(narrowed_comparison, compared_scope, class_information)
    conditional_depth = conditional_depth - 1
    var when_null = "false"
    if binary.operator == 'not_equal' {
        when_null = "true"
    }
    var release = ""
    if owns(left, left_ast) and type_needs_drop(inner) {
        release = " {release_call(inner, compared_name)};"
    }
    var left_type = left.get_type()
    var code = "(\{ {c_type_name(left_type)} {compared_name} = {left.code}; bool spite_equal = ({null_check}) ? ({compared.code}) : {when_null};{release} spite_equal; })"
    var boolean_spite_type = boolean_type()
    return ExpressionResult(code, boolean_spite_type)
}

func report_maybe_boolean(result: ExpressionResult, used_by: String) {
    var result_type = result.get_type()
    var maybe = type_shape.as_nullable(result_type)
    assert maybe
    var maybe_inner = maybe.get_inner()
    assert is_boolean_type(maybe_inner)
    report(
        "this is a Boolean? used by {used_by}, which would only test that it is there, not that it is true: prove it is there first -- 'crash index < flags.count()' proves 'flags[index]' -- or switch over it",
    )
}

func owned_truth(result: ExpressionResult, expression: Syntax.Expressions.Expression): String {
    var result_type = result.get_type()
    if owns(result, expression) and type_needs_drop(result_type) {
        var tested = next_temporary()
        var held = ExpressionResult(tested, result_type)
        return "(\{ {c_type_name(result_type)} {tested} = {result.code}; bool spite_truth = {truth_of(held)}; {release_call(result_type, tested)}; spite_truth; })"
    }
    return truth_of(result)
}

func truth_of(result: ExpressionResult): String {
    var result_type = result.get_type()
    var maybe_null = type_shape.as_nullable(result_type)
    if maybe_null {
        var maybe_null_inner = maybe_null.get_inner()
        if type_is_reference(maybe_null_inner) {
            return "(({result.code}) != 0)"
        }
        return "(({result.code}).has_value)"
    }
    return "({result.code})"
}

func operator_function_name(operator: Syntax.Expressions.BinaryOperator): String {
    if operator == 'add' {
        return "sum"
    }
    if operator == 'subtract' {
        return "subtract"
    }
    if operator == 'multiply' {
        return "multiply"
    }
    if operator == 'divide' {
        return "divide"
    }
    if operator == 'modulo' {
        return "remainder"
    }
    if operator == 'equal' or operator == 'not_equal' {
        return "equals"
    }
    if operator == 'less' or operator == 'greater_equal' {
        return "less_than"
    }
    if operator == 'greater' or operator == 'less_equal' {
        return "greater_than"
    }
    return ""
}

func generate_class_binary(
    operator: Syntax.Expressions.BinaryOperator,
    left_class: Analysis.ClassInfo,
    left_result: ExpressionResult,
    left_ast: Syntax.Expressions.Expression,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var function_name = operator_function_name(operator)
    var negated = operator == 'not_equal' or operator == 'greater_equal' or operator == 'less_equal'
    var function: Analysis.FunctionInfo? = null
    if not function_name.is_empty() {
        function = find_or_instantiate_function(left_class, function_name)
    }
    if function {
        if function.parameters.count() == 1 and not compares_identity_instead(function, left_class, right_ast, scope, class_information) {
            var operator_arguments = List<Syntax.Expressions.Expression>()
            operator_arguments.append(right_ast)
            var parameter_types = parameter_types_of(function.parameters)
            var function_return_type = function.get_return_type()
            var called = generate_generic_call(
                function.c_name,
                left_result,
                left_ast,
                operator_arguments,
                parameter_types,
                function_return_type,
                scope,
                class_information,
            )
            if negated {
                var boolean_spite_type = boolean_type()
                return ExpressionResult("(!({called.code}))", boolean_spite_type)
            }
            called.owning_override = true
            return called
        }
    }
    if operator == 'equal' or operator == 'not_equal' {
        var right_result = generate_expression(right_ast, scope, class_information)
        var lines = List<String>()
        var left_temporary = next_temporary()
        var right_temporary = next_temporary()
        lines.append("void* {left_temporary} = {left_result.code};")
        lines.append("void* {right_temporary} = {right_result.code};")
        var comparison = "=="
        if operator == 'not_equal' {
            comparison = "!="
        }
        lines.append("bool spite_same = {left_temporary} {comparison} {right_temporary};")
        if owns(left_result, left_ast) {
            var left_result_type = left_result.get_type()
            lines.append("{release_call(left_result_type, left_temporary)};")
        }
        var right_result_type = right_result.get_type()
        if owns(right_result, right_ast) and type_needs_drop(right_result_type) {
            lines.append("{release_call(right_result_type, right_temporary)};")
        }
        lines.append("spite_same;")
        var boolean_spite_type = boolean_type()
        return ExpressionResult("(\{ {lines.join(" ")} })", boolean_spite_type)
    }
    report("this operator on a '{left_class.simple_name}' needs it to define '{function_name}(other)'")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func compares_identity_instead(
    function: Analysis.FunctionInfo,
    left_class: Analysis.ClassInfo,
    right_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    assert function.name == "equals"
    var saved_counter = temporary_counter
    var probe = generate_expression(right_ast, scope, class_information)
    rewind_temporaries(saved_counter)
    var right_type = probe.get_type()
    var right_nullable = type_shape.as_nullable(right_type)
    if right_nullable {
        right_type = right_nullable.get_inner()
    }
    var right_class_ref = type_shape.as_class_ref(right_type)
    if right_class_ref {
        if right_class_ref.c_name == left_class.c_name {
            crash function.parameters[0]
            var parameter_type = function.parameters[0].get_type()
            return not type_shape.as_class_ref(parameter_type)
        }
    }
    return false
}

func generate_unary(
    unary: Syntax.Expressions.UnaryExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash unary.operand
    var operand = generate_joined(unary.operand, scope, class_information)
    var operand_type = operand.get_type()
    var operand_class_ref = type_shape.as_class_ref(operand_type)
    if operand_class_ref {
        var operand_class = find_class_by_c_name(operand_class_ref.c_name)
        var negating = unary.operator == 'negate'
        if operand_class {
            if negating {
                var negate = find_or_instantiate_function(operand_class, "negate")
                if negate {
                    var empty_types = no_types()
                    var negate_return_type = negate.get_return_type()
                    var no_arguments = List<Syntax.Expressions.Expression>()
                    var negated = generate_generic_call(
                        negate.c_name,
                        operand,
                        unary.operand,
                        no_arguments,
                        empty_types,
                        negate_return_type,
                        scope,
                        class_information,
                    )
                    negated.owning_override = true
                    return negated
                }
                report("'-' on a '{operand_class.simple_name}' needs it to define 'negate()'")
            }
        }
    }
    if unary.operator == 'negate' {
        return ExpressionResult("(-({operand.code}))", operand_type)
    }
    report_maybe_boolean(operand, "'not'")
    return ExpressionResult("(!{owned_truth(operand, unary.operand)})", Analysis.Types.ScalarType('boolean_kind'))
}

func generate_argument_list(
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var result = List<String>()
    var variadic = variadic_list(expected_types)
    if variadic {
        return generate_spread_arguments(arguments_ast, expected_types, variadic, scope, class_information)
    }
    if arguments_ast.count() != expected_types.count() {
        report("this call passes {arguments_ast.count()} argument(s), but {expected_types.count()} are expected")
        return result
    }
    var index = 0
    while index < arguments_ast.count() {
        var stored_code = coerce_for_store(arguments_ast[index], expected_types[index], scope, class_information)
        result.append(stored_code)
        index = index + 1
    }
    return result
}

func variadic_list(expected_types: List<Analysis.SpiteType>): Analysis.SpiteType? {
    assert not expected_types.is_empty()
    var last_type = expected_types.last()
    var listed = type_shape.as_list(last_type)
    if listed {
        if listed.is_variadic {
            return last_type
        }
    }
    return null
}

func generate_spread_arguments(
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    variadic: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var result = List<String>()
    var fixed_count = expected_types.count() - 1
    if arguments_ast.count() < fixed_count {
        report("this call passes {arguments_ast.count()} argument(s), but at least {fixed_count} are expected")
        return result
    }
    var elements = List<Syntax.Expressions.ListElement>()
    var index = 0
    while index < arguments_ast.count() {
        if index < expected_types.count() - 1 {
            var stored_code = coerce_for_store(arguments_ast[index], expected_types[index], scope, class_information)
            result.append(stored_code)
        } else {
            elements.append(Syntax.Expressions.ListElement(arguments_ast[index]))
        }
        index = index + 1
    }
    var whole_list = whole_list_passed(elements, variadic, scope, class_information)
    if whole_list {
        report(
            "this call passes a whole {type_display_name(whole_list)}, but the last parameter is written with '...', so it takes the values one by one: pass the elements themselves, separated by commas",
        )
        return result
    }
    var gathered: Syntax.Expressions.Expression = Syntax.Expressions.ListLiteralExpression(elements)
    var gathered_code = coerce_for_store(gathered, variadic, scope, class_information)
    result.append(gathered_code)
    return result
}

func whole_list_passed(
    elements: List<Syntax.Expressions.ListElement>,
    variadic: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    assert elements.count() == 1
    var gathered_list = type_shape.as_list(variadic)
    crash gathered_list
    var element_type = gathered_list.get_element()
    assert not type_shape.as_list(element_type) and not is_shape_type(element_type)
    var only = elements.first()
    crash only
    crash only.value
    var passed_type = lookup_static_type(only.value, scope, class_information)
    assert passed_type
    assert type_shape.as_list(passed_type)
    return passed_type
}

func parameter_types_of(parameters: List<Analysis.ParamInfo>): List<Analysis.SpiteType> {
    return parameters.map_get_type()
}

func singleton_call(target_class: Analysis.ClassInfo): String {
    var function_c_name = "spite_singleton_{target_class.c_name}"
    if not singleton_names.contains(function_c_name) and is_stateless_singleton(target_class) {
        singleton_names.append(function_c_name)
        builder.add_prototype("{target_class.c_name}* {function_c_name}(void);")
        builder.add_support(
            "{target_class.c_name}* {function_c_name}(void) \{\nstatic {target_class.c_name} spite_object = \{ \{ 1, {target_class.class_id} } };\nreturn &spite_object;\n}",
        )
    }
    if not singleton_names.contains(function_c_name) {
        singleton_names.append(function_c_name)
        builder.add_typedef("static {target_class.c_name}* {function_c_name}_cache = 0;")
        builder.add_prototype("{target_class.c_name}* {function_c_name}(void);")
        var lines = List<String>()
        lines.append("static bool {function_c_name}_destroyed = false;")
        lines.append("static void {function_c_name}_teardown(void) \{")
        lines.append("{target_class.c_name}* object = {function_c_name}_cache;")
        lines.append("{function_c_name}_cache = 0;")
        if not target_class.holds_nothing {
            lines.append("{function_c_name}_destroyed = true;")
        }
        lines.append("{target_class.c_name}___destroy(object);")
        lines.append("}")
        lines.append("static int32_t {function_c_name}_lock = 0;")
        lines.append("{target_class.c_name}* {function_c_name}(void) \{")
        lines.append("{target_class.c_name}* found = SPITE_SINGLETON_FOUND({function_c_name}_cache);")
        lines.append("if (found != 0) return found;")
        lines.append("SPITE_LOCK({function_c_name}_lock);")
        lines.append("if ({function_c_name}_cache == 0) \{")
        lines.append(
            "if ({function_c_name}_destroyed) spite_singleton_used_after_exit(\"{escape_c_string(target_class.qualified_dotted)}\");",
        )
        lines.append("{target_class.c_name}* made = {target_class.c_name}___make();")
        lines.append("spite_singleton_created({function_c_name}_teardown);")
        lines.append("SPITE_SINGLETON_PUBLISH({function_c_name}_cache, made);")
        lines.append("}")
        lines.append("SPITE_UNLOCK({function_c_name}_lock);")
        lines.append("return {function_c_name}_cache;")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    return "{function_c_name}()"
}

func generate_constructor_call(
    target_class: Analysis.ClassInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if target_class.c_name == "DynamicLibrary" {
        return generate_library_constructor(arguments_ast)
    }
    if target_class.qualified_dotted == "Parallel" and target_class.is_instantiated {
        check_parallel_work(arguments_ast, scope, class_information)
    }
    if target_class.is_generic_template {
        var inferred_class = inferred_instance(target_class, arguments_ast, scope, class_information)
        if inferred_class {
            return generate_constructor_call(inferred_class, arguments_ast, scope, class_information)
        }
        report(
            "'{target_class.simple_name}' takes {target_class.codegen_names.count()} codegen value(s), in this order: ${target_class.codegen_names.join(", $")} -- write them between < and > before the arguments",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var expected_types = List<Analysis.SpiteType>()
    if target_class.constructor {
        expected_types = parameter_types_of(target_class.constructor.parameters)
    }
    if target_class.is_singleton {
        if not expected_types.is_empty() or not arguments_ast.is_empty() {
            report(
                "'{target_class.simple_name}' is a singleton, so its constructor takes no arguments: there is one instance, made the first time it is asked for",
            )
        }
        var singleton_code = singleton_call(target_class)
        var shared = ExpressionResult(singleton_code, Analysis.Types.ClassRefType(target_class.c_name))
        shared.owning_override = true
        return shared
    }
    var starts_concurrent = target_class.qualified_dotted == "Concurrent"
    if starts_concurrent {
        concurrent_arguments = concurrent_arguments + 1
    }
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    if starts_concurrent {
        concurrent_arguments = concurrent_arguments - 1
    }
    var call_code = "{target_class.c_name}___make({argument_codes.join(", ")})"
    if target_class.is_value_class {
        if not target_class.constructor {
            report(
                "'{target_class.simple_name}' has no constructor: {with_article(target_class.simple_name)} is written as a literal, or cast from another value by assigning it",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        var value_type = value_class_type(target_class)
        return ExpressionResult(call_code, value_type)
    }
    return ExpressionResult(call_code, Analysis.Types.ClassRefType(target_class.c_name))
}

func inferred_instance(
    template: Analysis.ClassInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.ClassInfo? {
    var constructor = template_constructor(template)
    assert constructor
    assert constructor.parameters.count() == arguments_ast.count()
    var inferred = Dictionary<Analysis.SpiteType>()
    var index = 0
    while index < constructor.parameters.count() {
        var declared = constructor.parameters[index].type_reference
        crash arguments_ast[index]
        if declared and not shape.is_null_literal(arguments_ast[index]) {
            var saved_counter = temporary_counter
            var probe = generate_expression(arguments_ast[index], scope, class_information)
            rewind_temporaries(saved_counter)
            var probe_type = probe.get_type()
            infer_codegen_values(declared, probe_type, inferred)
        }
        index = index + 1
    }
    var types = List<Analysis.SpiteType>()
    var codes = List<String>()
    var texts = List<String>()
    var label = "{template.c_name}_"
    index = 0
    while index < template.codegen_names.count() {
        var found = inferred.get(template.codegen_names[index])
        assert found
        types.append(found)
        codes.append("")
        texts.append("")
        label = "{label}_{type_label(found)}"
        index = index + 1
    }
    var existing = find_class_by_c_name(label)
    if existing {
        return existing
    }
    return instantiated_with(template, types, codes, texts, label)
}

func template_constructor(template: Analysis.ClassInfo): Syntax.Statements.FunctionDeclaration? {
    crash discovered_classes[template.entry_index]
    var file = discovered_classes[template.entry_index].get_file()
    var statement_index = 0
    while statement_index < file.statements.count() {
        var declaration = shape.as_function_declaration(file.statements[statement_index])
        if declaration {
            if declaration.name == template.simple_name {
                return declaration
            }
        }
        statement_index = statement_index + 1
    }
    return null
}

func infer_codegen_values(
    declared: Syntax.Types.Type,
    given: Analysis.SpiteType,
    inferred: Dictionary<Analysis.SpiteType>,
) {
    var generic_type = shape.as_generic_type(declared)
    if generic_type {
        var bare_name = without_dollar(generic_type.name)
        if not type_shape.is_void(given) {
            inferred.set(bare_name, given)
        }
        return
    }
    var named = shape.as_named_type(declared)
    assert named
    var declared_inner = only_type_argument(named)
    if declared_inner {
        var given_inner = container_inner_type(named, given)
        if given_inner {
            infer_codegen_values(declared_inner, given_inner, inferred)
        }
        return
    }
    var given_function = type_shape.as_class_ref(given)
    assert given_function
    var declared_path = named.path.join(".")
    assert given_function.has_signature and declared_path == "Spite.Function"
    var index = 0
    while index < named.arguments.count() {
        var type_argument = shape.as_type_argument(named.arguments[index])
        if type_argument {
            if type_argument.value {
                if index == named.arguments.count() - 1 {
                    var returns = returned_type(given_function)
                    infer_codegen_values(type_argument.value, returns, inferred)
                } else if index < given_function.arguments.count() {
                    infer_codegen_values(type_argument.value, given_function.arguments[index], inferred)
                }
            }
        }
        index = index + 1
    }
}

func only_type_argument(named: Syntax.Types.NamedType): Syntax.Types.Type? {
    var declared_path = named.path.join(".")
    assert declared_path == "Nullable" or declared_path == "List" or declared_path == "Dictionary"
    assert named.arguments.count() == 1
    var type_argument = shape.as_type_argument(named.arguments[0])
    assert type_argument
    return type_argument.value
}

func container_inner_type(named: Syntax.Types.NamedType, given: Analysis.SpiteType): Analysis.SpiteType? {
    var declared_path = named.path.join(".")
    if declared_path == "Nullable" {
        var given_nullable = type_shape.as_nullable(given)
        if given_nullable {
            return given_nullable.get_inner()
        }
        return given
    }
    if declared_path == "List" {
        var given_list = type_shape.as_list(given)
        assert given_list
        return given_list.get_element()
    }
    var given_dictionary = type_shape.as_dictionary(given)
    assert given_dictionary
    return given_dictionary.get_element()
}

func returned_type(function: Analysis.Types.ClassRefType): Analysis.SpiteType {
    var nothing_class = find_class_by_qualified("Nothing")
    if function.returns {
        if not type_shape.is_void(function.returns) {
            return function.returns
        }
    }
    crash nothing_class
    return class_type_of(nothing_class)
}

func function_type_from(named: Syntax.Types.NamedType, current_namespace: String): Analysis.SpiteType? {
    var signature = Analysis.Types.ClassRefType("Spite_Function")
    signature.has_signature = true
    var index = 0
    while index < named.arguments.count() {
        var resolved = resolve_generic_argument(named.arguments[index], current_namespace)
        assert resolved
        if index == named.arguments.count() - 1 {
            signature.returns = resolved
        } else {
            signature.arguments.append(resolved)
        }
        index = index + 1
    }
    var typed: Analysis.SpiteType = signature
    return typed
}

func same_signature(left: Analysis.Types.ClassRefType, right: Analysis.Types.ClassRefType): Boolean {
    assert left.has_signature == right.has_signature
    if not left.has_signature {
        return true
    }
    assert left.arguments.count() == right.arguments.count()
    var index = 0
    while index < left.arguments.count() {
        assert types_equal(left.arguments[index], right.arguments[index])
        index = index + 1
    }
    if left.returns {
        if right.returns {
            return types_equal(left.returns, right.returns)
        }
    }
    return false
}

func signature_of(function: Analysis.FunctionInfo): Analysis.SpiteType {
    var signature = Analysis.Types.ClassRefType("Spite_Function")
    signature.has_signature = true
    var index = 0
    while index < function.parameters.count() {
        var parameter_type = function.parameters[index].get_type()
        signature.arguments.append(parameter_type)
        index = index + 1
    }
    var function_return_type = function.get_return_type()
    if type_shape.is_void(function_return_type) {
        signature.returns = Analysis.Types.ClassRefType("Nothing")
    } else {
        signature.returns = function.get_return_type()
    }
    var typed: Analysis.SpiteType = signature
    return typed
}

func function_value(
    information: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    owner: ExpressionResult,
    owner_ast: Syntax.Expressions.Expression,
): ExpressionResult {
    var maker = "spite_function_value_{function.c_name}"
    var starts_work = concurrent_arguments > 0 or not is_library_class(information)
    if function.parameters.is_empty() and starts_work and not task_root_names.contains(function.c_name) {
        task_root_names.append(function.c_name)
        task_root_classes.append(information)
        task_root_functions.append(function)
    }
    if not function_value_makers.contains(maker) {
        function_value_makers.append(maker)
        var argument_class = find_class_by_c_name("Spite_Argument")
        if not find_class_by_c_name("Spite_Function") or not argument_class {
            report(
                "a function value needs the standard library: library/spite/function.spite was not found from the working directory",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        crash argument_class
        var class_type = class_type_of(argument_class)
        var arguments_list_name = ensure_list(class_type)
        var argument_lines = List<String>()
        var parameter_index = 0
        while parameter_index < function.parameters.count() {
            var parameter = function.parameters[parameter_index]
            var parameter_type = parameter.get_type()
            argument_lines.append(
                "{arguments_list_name}_append(described->_arguments_, Spite_Argument___make({ensure_symbol(parameter.name)}, {class_object_call(parameter_type)}));",
            )
            parameter_index = parameter_index + 1
        }
        var lines = List<String>()
        lines.append("Spite_Function* {maker}({information.c_name}* owner) \{")
        lines.append(
            "Spite_Function* described = Spite_Function___make({ensure_symbol(function.name)}, {returned_class_object_call(function)});",
        )
        add_lazy_arguments(maker, argument_lines, lines)
        lines.append("described->spite_owner = {information.c_name}___retain(owner);")
        lines.append("described->spite_release_owner = (void (*)(void*)){information.c_name}___release;")
        var function_return_type = function.get_return_type()
        if function.parameters.count() == 0 and type_shape.is_void(function_return_type) {
            lines.append("described->spite_call = (void (*)(void*)){function.c_name};")
        }
        lines.append("described->spite_typed_call = (void*){function.c_name};")
        lines.append("return described;")
        lines.append("}")
        builder.add_prototype("Spite_Function* {maker}({information.c_name}* owner);")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
    var code = "{maker}({owner.code})"
    if owns(owner, owner_ast) {
        var owner_temporary = next_temporary()
        var value_temporary = next_temporary()
        code = "(\{ {information.c_name}* {owner_temporary} = {owner.code}; Spite_Function* {value_temporary} = {maker}({owner_temporary}); {information.c_name}___release({owner_temporary}); {value_temporary}; })"
    }
    var signature = signature_of(function)
    var made = ExpressionResult(code, signature)
    made.owning_override = true
    return made
}

func add_lazy_arguments(maker: String, argument_lines: List<String>, lines: List<String>) {
    assert not argument_lines.is_empty()
    var describer = "{maker}___arguments"
    builder.add_prototype("static void {describer}(Spite_Function* described);")
    builder.add_support("static void {describer}(Spite_Function* described) \{\n{argument_lines.join("\n")}\n}")
    lines.append("described->spite_add_arguments = {describer};")
}

func call_function_value(
    held: ExpressionResult,
    held_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var held_type = held.get_type()
    var signature = type_shape.as_class_ref(held_type)
    crash signature
    var argument_codes = generate_argument_list(arguments_ast, signature.arguments, scope, class_information)
    var pointer_parameters = List<String>()
    pointer_parameters.append("void*")
    var index = 0
    while index < signature.arguments.count() {
        var c_type_text = c_type_name(signature.arguments[index])
        pointer_parameters.append(c_type_text)
        index = index + 1
    }
    var returned: Analysis.SpiteType = void_type()
    if signature.returns {
        var returns_class = type_shape.as_class_ref(signature.returns)
        var returns_nothing = false
        if returns_class {
            returns_nothing = returns_class.c_name == "Nothing"
        }
        if not returns_nothing {
            returned = signature.returns
        }
    }
    var returned_c = "void"
    if not type_shape.is_void(returned) {
        returned_c = c_type_name(returned)
    }
    var function_temporary = next_temporary()
    var call_arguments = argument_codes.copy()
    call_arguments.prepend("{function_temporary}->spite_owner")
    var call_code = "(({returned_c} (*)({pointer_parameters.join(", ")})){function_temporary}->spite_typed_call)({call_arguments.join(", ")})"
    var release = ""
    if owns(held, held_ast) {
        release = " Spite_Function___release({function_temporary});"
    }
    if type_shape.is_void(returned) {
        return ExpressionResult(
            "(\{ Spite_Function* {function_temporary} = {held.code}; {call_code};{release} })",
            returned,
        )
    }
    var result_temporary = next_temporary()
    var called = ExpressionResult(
        "(\{ Spite_Function* {function_temporary} = {held.code}; {returned_c} {result_temporary} = {call_code};{release} {result_temporary}; })",
        returned,
    )
    called.owning_override = true
    return called
}

func generate_own_function_call(
    name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var passed = passed_template(class_information, name)
    if passed {
        return generate_passed_symbol_call(passed, arguments_ast, scope, class_information)
    }
    var function = find_or_instantiate_function(class_information, name)
    var held_type = scope.lookup_type(name)
    if not held_type {
        var held_field = class_information.find_field(name)
        if held_field {
            held_type = held_field.get_type()
        }
    }
    if held_type {
        var held_function = type_shape.as_class_ref(held_type)
        if held_function {
            if held_function.has_signature and not function {
                var held_ast: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(name)
                var held = generate_expression(held_ast, scope, class_information)
                return call_function_value(held, held_ast, arguments_ast, scope, class_information)
            }
        }
    }
    if not function and class_information.c_name == "SpiteString" {
        var receiver: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("self")
        var string_spite_type = string_type()
        var self_result = ExpressionResult("self", string_spite_type)
        return generate_string_method(name, self_result, receiver, arguments_ast, scope, class_information)
    }
    if not function {
        var missed = range_miss(class_information, name)
        if name == "print" or name == "println" or name == "echo" or name == "printf" {
            report(
                "this class has no function '{name}': printing goes through the console -- 'var console = Console()' beside the attributes, then 'console.print(value)'",
            )
        } else if not missed.is_empty() {
            report(missed)
        } else if not reported_old_spelling(name) {
            report("this class has no function '{name}'")
        }
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash function
    var parameter_types = parameter_types_of(function.parameters)
    var argument_codes = generate_argument_list(arguments_ast, parameter_types, scope, class_information)
    var full_arguments = argument_codes.copy()
    full_arguments.prepend("self")
    var function_return_type = function.get_return_type()
    record_call(function.c_name)
    var self_type = value_class_type(class_information)
    var self_result = ExpressionResult("self", self_type)
    self_result.owning_override = false
    var waited = hoisted_wait(function.c_name, self_result, false, argument_codes, function_return_type)
    if waited {
        return waited
    }
    return ExpressionResult("{function.c_name}({full_arguments.join(", ")})", function_return_type)
}

func passed_template(information: Analysis.ClassInfo, name: String): Analysis.TemplateInfo? {
    var index = 0
    while index < information.templates.count() {
        var template = information.templates[index]
        if template.passed and template.prefix == name {
            return template
        }
        index = index + 1
    }
    return null
}

func passed_instance_name(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    member_name: String,
    pattern: String,
    function_name: String,
): String {
    var name = "{template.prefix}_for_{member_name}"
    if pattern.is_empty() or template_range_owner(information, template) == "pattern" {
        return name
    }
    return "{name}_in_{function_name}"
}

func passed_instance(
    information: Analysis.ClassInfo,
    template: Analysis.TemplateInfo,
    registered_name: String,
): Analysis.FunctionInfo {
    var existing = information.find_function(registered_name)
    if existing {
        return existing
    }
    var member_type = template_member_type(information, template, bound_field_name)
    crash member_type
    var member_owner = template_range_owner(information, template)
    if member_owner == "function" or member_owner == "pattern" or member_owner == "namespace" or member_owner == "enum" {
        member_owner = ""
    }
    var instance = instantiate_template(
        information,
        template,
        bound_field_name,
        member_type,
        member_owner,
        registered_name,
        null,
    )
    describe_range_binding(information, template, instance)
    return instance
}

func generate_passed_symbol_call(
    template: Analysis.TemplateInfo,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var declaration = template.get_declaration()
    var range = range_text(template)
    var symbol_position = -1
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        if declaration.parameters[parameter_index].name == template.symbol_parameter {
            symbol_position = parameter_index
        }
        parameter_index = parameter_index + 1
    }
    var remaining = List<Syntax.Expressions.Expression>()
    var passed_name = ""
    var index = 0
    while index < arguments_ast.count() {
        var argument = arguments_ast[index]
        if index == symbol_position {
            var passed_identifier = shape.as_identifier(argument)
            if passed_identifier {
                passed_name = passed_identifier.name
            }
        } else {
            remaining.append(argument)
        }
        index = index + 1
    }
    if passed_name.is_empty() or passed_name != bound_symbol_name or range != bound_range {
        report(
            "'{template.prefix}' is compiled once for each '{template.symbol_parameter}' of 'Symbol<{range}>', so its '{template.symbol_parameter}' can only be the symbol of a template over that same range, passed by name from inside it, as in '{template.prefix}({template.symbol_parameter})'",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var registered_name = passed_instance_name(
        class_information,
        template,
        bound_field_name,
        bound_pattern,
        bound_function_name,
    )
    var instance = passed_instance(class_information, template, registered_name)
    var parameter_types = parameter_types_of(instance.parameters)
    var argument_codes = generate_argument_list(remaining, parameter_types, scope, class_information)
    var full_arguments = argument_codes.copy()
    full_arguments.prepend("self")
    var instance_return_type = instance.get_return_type()
    return ExpressionResult("{instance.c_name}({full_arguments.join(", ")})", instance_return_type)
}

func generate_generic_call(
    function_c_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    return_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    record_call(function_c_name)
    var object_owned = owns(object_result, object_ast)
    var waited = hoisted_wait(function_c_name, object_result, object_owned, argument_codes, return_type)
    if waited {
        return waited
    }
    if object_owned {
        var object_temporary = next_temporary()
        var lines = List<String>()
        var object_result_type = object_result.get_type()
        lines.append("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
        var full_arguments = argument_codes.copy()
        full_arguments.prepend(object_temporary)
        var call_code = "{function_c_name}({full_arguments.join(", ")})"
        if type_shape.is_void(return_type) {
            lines.append("{call_code};")
            lines.append("{release_call(object_result_type, object_temporary)};")
            return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
        }
        var call_temporary = next_temporary()
        lines.append("{c_type_name(return_type)} {call_temporary} = {call_code};")
        lines.append("{release_call(object_result_type, object_temporary)};")
        lines.append("{call_temporary};")
        return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
    }
    var full_arguments = argument_codes.copy()
    full_arguments.prepend(object_result.code)
    return ExpressionResult("{function_c_name}({full_arguments.join(", ")})", return_type)
}

func forget_indices_if_shrinking(name: String, object_ast: Syntax.Expressions.Expression, scope: Scope) {
    assert name == "clear" or name == "remove_at" or name == "remove_first" or name == "remove_last"
    var shrunk = operand_text(object_ast)
    assert not shrunk.is_empty()
    if scope.forget_path(shrunk, false, List<String>()) {
        report(
            "'{shrunk}.{name}()' inside this loop undoes what was proven about '{shrunk}' before the loop, and the next pass would read it unproven: prove it inside the loop instead",
        )
    }
}

func generate_method_call(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if member.name == bound_pattern and not bound_pattern.is_empty() {
        var matched = Syntax.Expressions.MemberExpression(object_ast, bound_function_name)
        return generate_method_call(matched, object_ast, arguments_ast, scope, class_information)
    }
    forget_indices_if_shrinking(member.name, object_ast, scope)
    var fused = generate_fused_chain(member, object_ast, arguments_ast, scope, class_information)
    if fused {
        return fused
    }
    if member.name == "call_function" {
        var saved_counter = temporary_counter
        var called_probe = generate_expression(object_ast, scope, class_information)
        rewind_temporaries(saved_counter)
        var called_probe_type = called_probe.get_type()
        var called_function = type_shape.as_class_ref(called_probe_type)
        if called_function {
            if called_function.c_name == "Spite_Function" {
                if called_function.has_signature {
                    var held = generate_expression(object_ast, scope, class_information)
                    return call_function_value(held, object_ast, arguments_ast, scope, class_information)
                }
            }
        }
    }
    var static_receiver = try_resolve_static_path(object_ast, class_information.qualified_dotted)
    if static_receiver {
        var class_value_class = find_class_by_c_name("Spite_Class")
        if class_value_class {
            var on_the_class_value = find_or_instantiate_function(class_value_class, member.name)
            if not on_the_class_value and member.name != "deep_copy" and member.name != "copy" {
                report(
                    "'{static_receiver.qualified_dotted}' is a class, not a value: write '{static_receiver.qualified_dotted}()' to make one, and give it a name with 'var ... = '",
                )
                return ExpressionResult("0", Analysis.Types.VoidType())
            }
        }
    }
    var object_counter = temporary_counter
    var generated_member_object = generate_member_object(object_ast, scope, class_information)
    var object_result = as_text(generated_member_object)
    var object_result_type = object_result.get_type()
    var handle = joinable_handle(object_result_type)
    if handle {
        if forwards_to_result(handle, member.name) {
            rewind_temporaries(object_counter)
            var joined_ast = implicit_join_ast(object_ast)
            var forwarded = Syntax.Expressions.MemberExpression(joined_ast, member.name)
            return generate_method_call(forwarded, joined_ast, arguments_ast, scope, class_information)
        }
    }
    var foreign = type_shape.as_class_ref(object_result_type)
    if foreign {
        if foreign.c_name == "DynamicLibrary" and not declared_by_dynamic_library(member.name) {
            return generate_foreign_call(
                foreign,
                object_result,
                object_ast,
                member.name,
                arguments_ast,
                scope,
                class_information,
            )
        }
    }
    if type_shape.as_string(object_result_type) {
        return generate_string_method(member.name, object_result, object_ast, arguments_ast, scope, class_information)
    }
    if type_shape.is_arguments(object_result_type) {
        if member.name == "count" {
            var integer_spite_type = integer_type()
            return ExpressionResult("((int32_t)SpiteArguments_count(&({object_result.code})))", integer_spite_type)
        }
        if member.name == "get" and arguments_ast.count() == 1 {
            var integer_spite_type = integer_type()
            var position = coerce_for_store(arguments_ast[0], integer_spite_type, scope, class_information)
            var string_spite_type = string_type()
            return ExpressionResult("SpiteArguments_get(&({object_result.code}), {position})", string_spite_type)
        }
        report("Arguments has no method '{member.name}'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var object_scalar = type_shape.as_scalar(object_result_type)
    if object_scalar {
        return generate_value_method(
            object_scalar.kind,
            member.name,
            object_result,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_union = type_shape.as_union(object_result_type)
    if object_union {
        var union_information = find_union_by_c_name(object_union.c_name)
        crash union_information
        return generate_union_dispatch(
            union_information,
            member.name,
            true,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_dictionary = type_shape.as_dictionary(object_result_type)
    if object_dictionary {
        var object_dictionary_element = object_dictionary.get_element()
        return generate_dictionary_method(
            object_dictionary_element,
            member.name,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_list = type_shape.as_list(object_result_type)
    if object_list {
        var object_list_element = object_list.get_element()
        return generate_list_method(
            object_list_element,
            member.name,
            object_result,
            object_ast,
            arguments_ast,
            scope,
            class_information,
        )
    }
    var object_enum = type_shape.as_enum(object_result_type)
    if object_enum {
        return generate_enum_method(object_result_type, member.name, object_result, arguments_ast)
    }
    var object_class_ref = type_shape.as_class_ref(object_result_type)
    if not object_class_ref {
        var object_type_name = type_with_article(object_result_type)
        if type_shape.as_nullable(object_result_type) {
            report(
                "this value may be null (it is {object_type_name}), so '{member.name}' cannot be called on it yet: narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
            )
        } else {
            report("{object_type_name} has no function '{member.name}'")
        }
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash object_class_ref
    var target_class = find_class_by_c_name(object_class_ref.c_name)
    crash target_class
    if not is_implicit_join(member) {
        report_private_member(target_class, member.name, class_information)
    }
    var function = find_or_instantiate_function(target_class, member.name)
    if not function {
        if member.name == "deep_copy" {
            var ensured_class_deep_copy = ensure_class_deep_copy(target_class)
            var empty_types = no_types()
            var class_type = class_type_of(target_class)
            var deep_copied = generate_generic_call(
                ensured_class_deep_copy,
                object_result,
                object_ast,
                arguments_ast,
                empty_types,
                class_type,
                scope,
                class_information,
            )
            deep_copied.owning_override = true
            return deep_copied
        }
        if member.name == "copy" {
            var no_type_arguments = List<Analysis.SpiteType>()
            var copied_type = Analysis.Types.ClassRefType(object_class_ref.c_name)
            return generate_generic_call(
                "{object_class_ref.c_name}_copy",
                object_result,
                object_ast,
                arguments_ast,
                no_type_arguments,
                copied_type,
                scope,
                class_information,
            )
        }
        var missed = range_miss(target_class, member.name)
        if missed.is_empty() {
            if not reported_old_spelling(member.name) {
                var receiver_type = object_result.get_type()
                report("'{type_display_name(receiver_type)}' does not define '{member.name}'")
            }
        } else {
            report(missed)
        }
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash function
    if member.name == "has_function" and target_class.c_name == "Spite_Class" {
        class_level_functions_used = true
    }
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.get_return_type()
    var spread = spread_template(arguments_ast, class_information)
    if spread {
        var passed = spread_into(arguments_ast, spread, target_class, function, class_information)
        if passed.count() != function.parameters.count() {
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        return generate_sequenced_call(
            function.c_name,
            object_result,
            object_ast,
            passed,
            parameter_types,
            function_return_type,
            scope,
            class_information,
        )
    }
    return generate_generic_call(
        function.c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func spread_template(
    arguments_ast: List<Syntax.Expressions.Expression>,
    class_information: Analysis.ClassInfo,
): Analysis.TemplateInfo? {
    assert arguments_ast.count() == 1
    var call = shape.as_call(arguments_ast[0])
    assert call
    crash call.callee
    var callee = shape.as_identifier(call.callee)
    assert callee
    assert not class_information.find_function(callee.name)
    var index = 0
    while index < class_information.templates.count() {
        var template = class_information.templates[index]
        if template.range and template.member_name_for(callee.name) == "{template.symbol_parameter}s" {
            if template_range_owner(class_information, template) == "function" {
                return template
            }
        }
        index = index + 1
    }
    return null
}

func generate_sequenced_call(
    function_c_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    expected_types: List<Analysis.SpiteType>,
    return_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var lines = List<String>()
    var object_temporary = next_temporary()
    var object_result_type = object_result.get_type()
    lines.append("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
    var argument_codes = generate_argument_list(arguments_ast, expected_types, scope, class_information)
    var passed = List<String>()
    passed.append(object_temporary)
    var index = 0
    while index < argument_codes.count() and index < expected_types.count() {
        var temporary = next_temporary()
        lines.append("{c_type_name(expected_types[index])} {temporary} = {argument_codes[index]};")
        passed.append(temporary)
        index = index + 1
    }
    var call_code = "{function_c_name}({passed.join(", ")})"
    var release_object = ""
    if owns(object_result, object_ast) {
        release_object = "{release_call(object_result_type, object_temporary)};"
    }
    if type_shape.is_void(return_type) {
        lines.append("{call_code};")
        lines.append(release_object)
        return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
    }
    var call_temporary = next_temporary()
    lines.append("{c_type_name(return_type)} {call_temporary} = {call_code};")
    lines.append(release_object)
    lines.append("{call_temporary};")
    return ExpressionResult("(\{ {lines.join(" ")} })", return_type)
}

func spread_into(
    arguments_ast: List<Syntax.Expressions.Expression>,
    template: Analysis.TemplateInfo,
    target_class: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    class_information: Analysis.ClassInfo,
): List<Syntax.Expressions.Expression> {
    var call = shape.as_call(arguments_ast[0])
    crash call
    var ranged = range_function(class_information, template)
    var range_owner = range_function_owner(class_information, template)
    var range = range_path(template)
    var same_function = false
    if ranged {
        if range_owner {
            same_function = ranged.c_name == function.c_name and range_owner.c_name == target_class.c_name
        }
    }
    if not same_function {
        var printer = Syntax.SourcePrinter()
        var passed_text = printer.source_expression(arguments_ast[0])
        var ranged_function = range.last()
        crash ranged_function
        report(
            "'{passed_text}' fills the arguments of '{ranged_function}', one value per argument, so it is only the whole argument list of a call to '{ranged_function}', not of '{function.name}'",
        )
        return List<Syntax.Expressions.Expression>()
    }
    var expanded = List<Syntax.Expressions.Expression>()
    var index = 0
    while index < function.parameters.count() {
        var callee: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(
            "{template.prefix}{function.parameters[index].name}{template.suffix}",
        )
        var one: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(callee, call.arguments)
        expanded.append(one)
        index = index + 1
    }
    return expanded
}

func generate_enum_method(
    enum_type: Analysis.SpiteType,
    name: String,
    object_result: ExpressionResult,
    arguments_ast: List<Syntax.Expressions.Expression>,
): ExpressionResult {
    var enum_class = boxed_class_of(enum_type)
    crash enum_class
    var function = find_or_instantiate_function(enum_class, name)
    if function {
        if arguments_ast.is_empty() {
            var function_return_type = function.get_return_type()
            return ExpressionResult("{function.c_name}({object_result.code})", function_return_type)
        }
    }
    report(
        "{type_with_article(enum_type)} value has no function '{name}': an enum value answers 'to_string()' and 'to_debug()'",
    )
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func generate_value_method(
    kind: Analysis.Types.NumericKind,
    name: String,
    object_result: ExpressionResult,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var value_class = value_class_of(kind)
    if value_class {
        var function = find_or_instantiate_function(value_class, name)
        if function {
            if kind == 'address_kind' and is_memory_access(name) and not is_library_class(class_information) {
                report(
                    "'{name}' reads or writes the memory at an address, which only library/ does: use a class of the standard library, or 'TypedMemory<T>' for values of any type",
                )
            }
            var parameter_types = parameter_types_of(function.parameters)
            var argument_codes = generate_argument_list(arguments_ast, parameter_types, scope, class_information)
            argument_codes.prepend(object_result.code)
            var function_return_type = function.get_return_type()
            return ExpressionResult("{function.c_name}({argument_codes.join(", ")})", function_return_type)
        }
    }
    var object_result_type = object_result.get_type()
    if name == "text" {
        report(
            "{type_display_name(object_result_type)} turns into text with 'to_string()', a cast like 'to_integer()': write 'to_string()'",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    if reported_old_spelling(name) {
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var bitwise_names = [
        "shifted_left"
        "shifted_right"
        "bits_and"
        "bits_or"
        "bits_exclusive_or"
        "bits_inverted"
        "set_bit_count"
        "leading_zero_count"
        "trailing_zero_count"
    ]
    if bitwise_names.contains(name) {
        report(
            "{type_with_article(object_result_type)} has no function '{name}': the bitwise functions are on the whole numbers, Tiny to UnsignedLong. Cast it first, like 'var whole: Long = value'",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    if is_memory_access(name) {
        report(
            "{type_with_article(object_result_type)} has no function '{name}': reading and writing memory is a function of the address, so the value needs to be a 'Memory.Address'",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    report("{type_with_article(object_result_type)} has no function '{name}'")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func is_memory_access(name: String): Boolean {
    return name.starts_with("read_") or name.starts_with("write_") or name == "exchange_long"
}

func generate_written_string_call(
    written: Analysis.FunctionInfo,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var lines = List<String>()
    var release = ""
    var receiver_code = object_result.code
    if owns(object_result, object_ast) {
        var object_temporary = next_temporary()
        lines.append("SpiteString* {object_temporary} = {object_result.code};")
        release = "SpiteString___release({object_temporary});"
        receiver_code = object_temporary
    }
    var parameter_types = parameter_types_of(written.parameters)
    var argument_codes = generate_argument_list(arguments_ast, parameter_types, scope, class_information)
    var full_arguments = argument_codes.copy()
    full_arguments.prepend(receiver_code)
    var call = "{written.c_name}({full_arguments.join(", ")})"
    if release.is_empty() {
        var written_return_type = written.get_return_type()
        return ExpressionResult(call, written_return_type)
    }
    var result_temporary = next_temporary()
    var written_return_type = written.get_return_type()
    lines.append("{c_type_name(written_return_type)} {result_temporary} = {call};")
    lines.append(release)
    lines.append("{result_temporary};")
    return ExpressionResult("(\{ {lines.join(" ")} })", written_return_type)
}

func generate_string_method(
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var written = written_string_function(name)
    if written {
        if arguments_ast.count() != written.parameters.count() {
            report(
                "'{name}' takes {written.parameters.count()} argument(s), and this call passes {arguments_ast.count()}",
            )
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        return generate_written_string_call(written, object_result, object_ast, arguments_ast, scope, class_information)
    }
    if name == "upper" or name == "lower" {
        report("text has no '{name}()': write '{name}_case()', which names what it does without abbreviating")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    if not reported_old_spelling(name) {
        report("String has no method '{name}'")
    }
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func report_list_method_missing(name: String) {
    if name == "add" {
        report(
            "List has no method 'add', which does not say where: write 'append' to add at the end, or 'prepend' at the start",
        )
        return
    }
    if name == "pop" {
        report("List has no method 'pop': write 'remove_last()', or 'remove_first()' to take from the start")
        return
    }
    report("List has no method '{name}'")
}

func reported_old_spelling(name: String): Boolean {
    if name == "Heap" {
        report(
            "there is no 'Heap<T>': a class, a list and a text are references already, so a class that holds one of its own kind declares an ordinary attribute, like 'var left: Expression? = null' ('Memory.Heap' is the allocator, for containers of your own)",
        )
        return true
    }
    var spelled = old_spellings.new_spelling(name)
    assert not spelled.is_empty()
    report("'{name}' is spelled '{spelled}'")
    return true
}

func generate_list_method(
    element: Analysis.SpiteType,
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if name == "deep_copy" {
        var ensured_list_deep_copy = ensure_list_deep_copy(element)
        var empty_types = no_types()
        var list_type = list_type_of(element)
        var copied_list = generate_generic_call(
            ensured_list_deep_copy,
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            list_type,
            scope,
            class_information,
        )
        copied_list.owning_override = true
        return copied_list
    }
    if is_function_form(name, arguments_ast) {
        var form_list = list_class_of(element)
        var form_argument = arguments_ast.first()
        return generate_function_form(
            form_list,
            element,
            name,
            object_result,
            object_ast,
            form_argument,
            scope,
            class_information,
        )
    }
    var public_names = [
        "append"
        "prepend"
        "insert"
        "set_at"
        "get_at"
        "remove_at"
        "remove_first"
        "remove_last"
        "first"
        "last"
        "clear"
        "reverse"
        "is_empty"
        "count"
        "contains"
        "join"
        "copy"
    ]
    if public_names.contains(name) {
        var function = list_class_of(element).find_function(name)
        if function {
            var parameter_types = parameter_types_of(function.parameters)
            var function_return_type = function.get_return_type()
            var called = generate_generic_call(
                function.c_name,
                object_result,
                object_ast,
                arguments_ast,
                parameter_types,
                function_return_type,
                scope,
                class_information,
            )
            if name == "copy" {
                called.owning_override = true
            }
            return called
        }
    }
    var list_class = list_class_of(element)
    if name.starts_with("parallel_each_") {
        var single = List<String>()
        single.append(name)
        var parallel = generate_parallel_each(list_class, element, single)
        if not parallel {
            var void_spite_type = void_type()
            return ExpressionResult("0", void_spite_type)
        }
        crash parallel
        var empty_types = no_types()
        var nothing_returned = parallel.get_return_type()
        return generate_generic_call(
            parallel.c_name,
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            nothing_returned,
            scope,
            class_information,
        )
    }
    var template = element_template_of(list_class, name)
    if not template {
        report_list_method_missing(name)
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash template
    var function = instantiate_element_template(list_class, element, template, name, class_information)
    if not function {
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash function
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.get_return_type()
    return generate_generic_call(
        function.c_name,
        object_result,
        object_ast,
        arguments_ast,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func element_class_of(element: Analysis.SpiteType): Analysis.ClassInfo? {
    var element_class_ref = type_shape.as_class_ref(element)
    assert element_class_ref
    assert not element_class_ref.has_signature
    return find_class_by_c_name(element_class_ref.c_name)
}

func member_type_of(element_class: Analysis.ClassInfo, member_name: String): Analysis.SpiteType? {
    var field = element_class.find_field(member_name)
    if field {
        return field.get_type()
    }
    var function = member_function(element_class, member_name)
    if function {
        return function.get_return_type()
    }
    return null
}

func member_function(element_class: Analysis.ClassInfo, member_name: String): Analysis.FunctionInfo? {
    var function = find_or_instantiate_function(element_class, member_name)
    if function {
        if function.parameters.count() == 0 {
            return function
        }
    }
    var getter = element_class.find_function("get_{member_name}")
    if getter {
        if getter.parameters.count() == 0 {
            return getter
        }
    }
    return null
}

func is_numeric_type(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return scalar.kind != 'boolean_kind'
    }
    return false
}

func is_boolean_type(spite_type: Analysis.SpiteType): Boolean {
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        return scalar.kind == 'boolean_kind'
    }
    return false
}

func element_template_of(list_class: Analysis.ClassInfo, name: String): Analysis.TemplateInfo? {
    var index = 0
    while index < list_class.templates.count() {
        var template = list_class.templates[index]
        var member_name = template.member_name_for(name)
        if not member_name.is_empty() and template.range {
            return template
        }
        index = index + 1
    }
    return null
}

func instantiate_element_template(
    list_class: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    template: Analysis.TemplateInfo,
    name: String,
    caller: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    var member_name = template.member_name_for(name)
    var element_class = element_class_of(element)
    var element_shape = shape_of(element)
    var member_type: Analysis.SpiteType? = null
    if element_class {
        member_type = member_type_of(element_class, member_name)
    } else if element_shape {
        member_type = shape_member_type(element_shape, member_name)
    }
    var element_label = type_display_name(element)
    if not member_type {
        var hint = passing_hint(caller, template.prefix, member_name)
        report("'{element_label}' has no attribute or zero argument function '{member_name}' for '{name}'{hint}")
        return null
    }
    crash member_type
    var existing = list_class.find_function(name)
    if existing {
        return existing
    }
    var is_field = element_member_is_field(element, member_name)
    var requirement = member_requirement(template.prefix, is_field, member_name, member_type)
    if not requirement.is_empty() {
        report(
            "'{name}': the member '{member_name}' of '{element_label}' {described_member(member_type)}, but '{template.prefix}' needs it to {requirement}",
        )
        return null
    }
    var owner_c_name = element_owner_c_name(element)
    return instantiate_template(list_class, template, member_name, member_type, owner_c_name, name, null)
}

func passing_hint(caller: Analysis.ClassInfo, prefix: String, member_name: String): String {
    assert prefix != "find_by_"
    var function = caller.find_function(member_name)
    assert function
    assert not function.is_constructor
    var form_length = prefix.length() - 1
    var form = prefix.slice(0, form_length)
    return ": a template reads a member of each element, never a function of this class, so pass this class's '{member_name}' instead: '{form}({member_name})'"
}

func shape_of(spite_type: Analysis.SpiteType): Analysis.UnionInfo? {
    var shaped_union = type_shape.as_union(spite_type)
    assert shaped_union
    var shaped = find_union_by_c_name(shaped_union.c_name)
    assert shaped
    assert shaped.is_shape
    return shaped
}

func element_member_is_field(element: Analysis.SpiteType, member_name: String): Boolean {
    var element_class = element_class_of(element)
    if element_class {
        return is_field_of(element_class, member_name)
    }
    var element_shape = shape_of(element)
    crash element_shape
    assert not find_required_function(element_shape, member_name)
    return true
}

func element_owner_c_name(element: Analysis.SpiteType): String {
    var element_class = element_class_of(element)
    if element_class {
        return element_class.c_name
    }
    var element_shape = shape_of(element)
    crash element_shape
    return element_shape.c_name
}

func is_field_of(element_class: Analysis.ClassInfo, member_name: String): Boolean {
    var field = element_class.find_field(member_name)
    assert field
    return true
}

func described_member(member_type: Analysis.SpiteType): String {
    if type_shape.is_void(member_type) {
        return "returns nothing"
    }
    var label = type_label(member_type)
    return "is {with_article(label)}"
}

func member_requirement(
    template_prefix: String,
    is_field: Boolean,
    member_name: String,
    member_type: Analysis.SpiteType,
): String {
    var wants_boolean = template_prefix == "filter_" or template_prefix == "any_" or template_prefix == "all_" or template_prefix == "count_"
    if wants_boolean and not is_boolean_type(member_type) {
        if template_prefix == "count_" and is_numeric_type(member_type) {
            return "return Boolean (to add up a numeric member use 'sum_{member_name}')"
        }
        return "return Boolean"
    }
    if template_prefix == "sum_" and not is_numeric_type(member_type) {
        return "return a numeric type"
    }
    if template_prefix == "each_" and is_field {
        return "be a function: reading an attribute and discarding it does nothing"
    }
    if template_prefix == "map_" and type_shape.is_void(member_type) {
        return "return a value (to only call it for each element, write 'each_{member_name}()')"
    }
    var ordered = is_numeric_type(member_type) or type_shape.as_string(member_type)
    if template_prefix == "sort_by_" and not ordered {
        return "return something ordered: a number or a String"
    }
    if template_prefix == "find_by_" and not joins_as_text(member_type) {
        return "return something comparable: a number, Boolean, String, Symbol or enum value"
    }
    return ""
}

func instantiate_member_templates_of(list_class: Analysis.ClassInfo) {
    var element = list_class.codegen_types.first()
    var element_class_ref = type_shape.as_class_ref(element)
    assert element_class_ref
    var element_class = find_class_by_c_name(element_class_ref.c_name)
    assert element_class
    var member_names = List<String>()
    var index = 0
    while index < element_class.fields.count() {
        var field_name = element_class.fields[index].name
        if not field_name.starts_with("_") {
            member_names.append(field_name)
        }
        index = index + 1
    }
    index = 0
    while index < element_class.functions.count() {
        var function = element_class.functions[index]
        if not function.is_constructor and function.parameters.is_empty() {
            member_names.append(function.name)
            if function.name.starts_with("get_") {
                var name_length = function.name.length()
                var read_name = function.name.slice(4, name_length)
                member_names.append(read_name)
            }
        }
        index = index + 1
    }
    var template_index = 0
    while template_index < list_class.templates.count() {
        var template = list_class.templates[template_index]
        var member_index = 0
        if not template.range {
            member_index = member_names.count()
        }
        while member_index < member_names.count() {
            var member_name = member_names[member_index]
            var member_type = member_type_of(element_class, member_name)
            if member_type {
                var is_field = is_field_of(element_class, member_name)
                var requirement = member_requirement(template.prefix, is_field, member_name, member_type)
                var name = "{template.prefix}{member_name}{template.suffix}"
                if requirement.is_empty() and not list_class.find_function(name) {
                    instantiate_template(
                        list_class,
                        template,
                        member_name,
                        member_type,
                        element_class.c_name,
                        name,
                        null,
                    )
                }
            }
            member_index = member_index + 1
        }
        template_index = template_index + 1
    }
}

func generate_fused_chain(
    member: Syntax.Expressions.MemberExpression,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var steps = List<Syntax.Expressions.CallExpression>()
    var base = chain_base(object_ast, steps)
    assert not steps.is_empty()
    steps.reverse()
    var last_callee: Syntax.Expressions.Expression = Syntax.Expressions.MemberExpression(object_ast, member.name)
    steps.append(Syntax.Expressions.CallExpression(last_callee, arguments_ast))
    var saved_counter = temporary_counter
    var probe = generate_expression(base, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    var element = chained_element_of(probe_type)
    assert element
    var base_list = list_class_of(element)
    if member.name.starts_with("parallel_each_") {
        var names = step_names_of(steps)
        var parallel = generate_parallel_each(base_list, element, names)
        if not parallel {
            var void_spite_type = void_type()
            return ExpressionResult("0", void_spite_type)
        }
    }
    var owners = List<PassedFunction>()
    var function = fused_function(base_list, element, steps, owners, scope, class_information)
    assert function
    var passed = arguments_ast.copy()
    if is_function_form(member.name, arguments_ast) {
        passed = form_arguments(member.name)
    }
    var owner_index = 0
    while owner_index < owners.count() {
        var owner = owners[owner_index].get_owner()
        passed.append(owner)
        owner_index = owner_index + 1
    }
    var generated_member_object = generate_member_object(base, scope, class_information)
    var receiver = as_text(generated_member_object)
    var receiver_type = receiver.get_type()
    if type_shape.as_dictionary(receiver_type) {
        var dictionary_name = ensure_dictionary(element)
        var empty_types = no_types()
        var list_type = list_type_of(element)
        var no_arguments = List<Syntax.Expressions.Expression>()
        receiver = generate_generic_call(
            "{dictionary_name}_values",
            receiver,
            base,
            no_arguments,
            empty_types,
            list_type,
            scope,
            class_information,
        )
        receiver.owning_override = true
    }
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.get_return_type()
    return generate_generic_call(
        function.c_name,
        receiver,
        base,
        passed,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func fused_function(
    base_list: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    steps: List<Syntax.Expressions.CallExpression>,
    owners: List<PassedFunction>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    var names = step_names_of(steps)
    var last_name = names.last()
    crash last_name
    if last_name.starts_with("parallel_each_") {
        var joined_names = names.join("_then_")
        return base_list.find_function(joined_names)
    }
    var source = fused_chain_source(base_list, element, steps, owners, scope, class_information)
    assert not source.is_empty()
    var name_end = source.index_of("(")
    var fused_name = source.slice(5, name_end)
    var function = base_list.find_function(fused_name)
    if function {
        return function
    }
    return register_fused_function(base_list, source, fused_name)
}

func generate_parallel_each(
    base_list: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    names: List<String>,
): Analysis.FunctionInfo? {
    var fused_name = names.join("_then_")
    var existing = base_list.find_function(fused_name)
    if existing {
        return existing
    }
    var last_name = names.last()
    crash last_name
    var name_length = last_name.length()
    var member_name = last_name.slice(14, name_length)
    var element_label = type_display_name(element)
    var element_class = element_class_of(element)
    if not element_class {
        report(
            "'{last_name}' runs a member of each element on many threads, and '{element_label}' is not a class: only a list of a class has members to run there (write 'each_{member_name}' to run it on one thread)",
        )
        return null
    }
    crash element_class
    var loop_lines = List<String>()
    var closings = List<String>()
    var indent = "        "
    var index = 0
    while index < names.count() - 1 {
        var stage_name = names[index]
        if not stage_name.starts_with("filter_") {
            report(
                "'{last_name}' can follow only 'filter_' steps: '{stage_name}' reaches another object, which several elements may share, and a parallel pass may touch only each element's own attributes (D35)",
            )
            return null
        }
        var stage_length = stage_name.length()
        var stage_member = stage_name.slice(7, stage_length)
        var stage_read = parallel_filter_read(element_class, stage_member, last_name)
        assert not stage_read.is_empty()
        loop_lines.append("{indent}if item.{stage_read} \{")
        closings.append("{indent}}")
        indent = "{indent}    "
        index = index + 1
    }
    var member = member_function(element_class, member_name)
    if not member {
        if element_class.find_field(member_name) {
            report(
                "'{last_name}': the member '{member_name}' of '{element_label}' is an attribute, but 'parallel_each_' needs a function: reading an attribute and discarding it does nothing",
            )
            return null
        }
        report("'{element_label}' has no zero argument function '{member_name}' for '{last_name}'")
        return null
    }
    crash member
    var visited = List<String>()
    check_parallel_reach(element_class, member, last_name, visited)
    loop_lines.append("{indent}item.{member_name}()")
    closings.reverse()
    var piece_name = "{fused_name}_piece"
    var piece_lines = List<String>()
    piece_lines.append("func {piece_name}(first: Integer, end: Integer) \{")
    piece_lines.append("    var index = first")
    piece_lines.append("    while index < end \{")
    piece_lines.append("        var item = values.read_value(items, index)")
    piece_lines.append("        index = index + 1")
    append_lines(piece_lines, loop_lines)
    append_lines(piece_lines, closings)
    piece_lines.append("    }")
    piece_lines.append("}")
    piece_lines.append("")
    var piece_source = piece_lines.join("\n")
    var piece = register_fused_function(base_list, piece_source, piece_name)
    assert piece
    var entry_source = "func {fused_name}() \{\n    var pool = ThreadPool()\n    pool.run_pieces({piece_name}, item_count)\n}\n"
    builder.threads = true
    parallel_used = true
    return register_fused_function(base_list, entry_source, fused_name)
}

func parallel_filter_read(element_class: Analysis.ClassInfo, member_name: String, template_name: String): String {
    var field = element_class.find_field(member_name)
    if field {
        var field_type = field.get_type()
        if not is_boolean_type(field_type) {
            report(
                "'{template_name}': the member '{member_name}' of '{element_class.simple_name}' {described_member(field_type)}, but 'filter_' needs it to return Boolean",
            )
            return ""
        }
        return member_name
    }
    var function = member_function(element_class, member_name)
    if not function {
        report(
            "'{element_class.simple_name}' has no attribute or zero argument function '{member_name}' for '{template_name}'",
        )
        return ""
    }
    crash function
    var returned = function.get_return_type()
    if not is_boolean_type(returned) {
        report(
            "'{template_name}': the member '{member_name}' of '{element_class.simple_name}' {described_member(returned)}, but 'filter_' needs it to return Boolean",
        )
        return ""
    }
    var visited = List<String>()
    check_parallel_reach(element_class, function, template_name, visited)
    return "{member_name}()"
}

func check_parallel_reach(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    template_name: String,
    visited: List<String>,
) {
    assert not visited.contains(function.name)
    visited.append(function.name)
    var locals = function.parameters.map_name()
    collect_declared_names(function.body, locals)
    var mentioned = List<String>()
    collect_block_names(function.body, mentioned)
    var index = 0
    while index < mentioned.count() {
        var name = mentioned[index]
        if not locals.contains(name) {
            check_parallel_name(owner, function, name, template_name, visited)
        }
        index = index + 1
    }
}

func check_parallel_name(
    owner: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    name: String,
    template_name: String,
    visited: List<String>,
) {
    var field = owner.find_field(name)
    if field {
        var field_type = field.get_type()
        if reaches_shared(field_type) and template_name.starts_with("Parallel(") {
            report(
                "'{template_name}' runs '{function.name}' on another thread, so it may reach only the attributes of its own '{owner.simple_name}' that hold values, its locals and singletons (D179): '{name}' holds {type_with_article(field_type)}, which another thread may share. Give the work what it needs as numbers or text of its own, or make an object for the work alone and pass it in",
            )
            return
        }
        if reaches_shared(field_type) {
            var template_length = template_name.length()
            var one_thread = template_name.slice(9, template_length)
            report(
                "'{template_name}' runs '{function.name}' on many elements at once, so it may reach only its own '{owner.simple_name}' attributes that hold values, and its locals (D35): '{name}' holds a '{type_display_name(field_type)}', which another element may share. Copy what the pass needs into a number or text attribute first, or write '{one_thread}' to run it on one thread",
            )
        }
        return
    }
    var own = owner.find_function(name)
    assert own
    assert not own.is_constructor
    check_parallel_reach(owner, own, template_name, visited)
}

func reaches_shared(spite_type: Analysis.SpiteType): Boolean {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.get_inner()
        return reaches_shared(inner)
    }
    var plain_value = type_shape.as_scalar(spite_type) or type_shape.as_string(spite_type) or is_enum_type(spite_type)
    assert not plain_value and not type_shape.is_symbol(spite_type)
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var held = find_class_by_c_name(class_ref.c_name)
        if held {
            return not held.is_singleton and not is_thread_safe_class(held)
        }
    }
    return true
}

func is_thread_safe_class(information: Analysis.ClassInfo): Boolean {
    return information.qualified_dotted == "Lock" or information.qualified_dotted == "ThreadLocal"
}

func check_parallel_work(
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert arguments_ast.count() == 1 and not current_path.starts_with("library/")
    var work = arguments_ast.first()
    var printer = Syntax.SourcePrinter()
    var work_text = printer.source_expression(work)
    var named = shape.as_identifier(work)
    if named {
        assert not scope.lookup_type(named.name)
        var own = class_information.find_function(named.name)
        assert own
        var visited = List<String>()
        check_parallel_reach(class_information, own, "Parallel({work_text})", visited)
        return
    }
    var member = shape.as_member(work)
    assert member
    crash member.object
    var saved_counter = temporary_counter
    var probe = generate_expression(member.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    var owner_ref = type_shape.as_class_ref(probe_type)
    assert owner_ref
    var owner = find_class_by_c_name(owner_ref.c_name)
    assert owner
    var function = owner.find_function(member.name)
    assert function
    var visited = List<String>()
    check_parallel_reach(owner, function, "Parallel({work_text})", visited)
}

func collect_declared_names(statements: List<Syntax.Statements.Statement>, names: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_statement_declared_names(statements[index], names)
        index = index + 1
    }
}

func collect_statement_declared_names(statement: Syntax.Statements.Statement, names: List<String>) {
    switch statement {
        Syntax.Statements.VariableDeclaration: names.append(statement.name)
        Syntax.Statements.IfStatement: {
            collect_declared_names(statement.then_branch, names)
            collect_declared_names(statement.else_branch, names)
        }
        Syntax.Statements.WhileStatement: collect_declared_names(statement.body, names)
        Syntax.Statements.SwitchStatement: {
            var case_index = 0
            while case_index < statement.cases.count() {
                collect_declared_names(statement.cases[case_index].body, names)
                case_index = case_index + 1
            }
        }
        _: return
    }
}

func step_names_of(steps: List<Syntax.Expressions.CallExpression>): List<String> {
    var names = List<String>()
    var index = 0
    while index < steps.count() {
        var callee = steps[index].callee
        crash callee
        var member = shape.as_member(callee)
        crash member
        names.append(member.name)
        index = index + 1
    }
    return names
}

func chain_base(
    expression: Syntax.Expressions.Expression,
    steps: List<Syntax.Expressions.CallExpression>,
): Syntax.Expressions.Expression {
    var called = shape.as_call(expression)
    if called {
        crash called.callee
        var callee = shape.as_member(called.callee)
        if callee {
            if streams(callee.name, called.arguments) {
                steps.append(called)
                crash callee.object
                return chain_base(callee.object, steps)
            }
        }
    }
    return expression
}

func streams(name: String, arguments: List<Syntax.Expressions.Expression>): Boolean {
    if arguments.is_empty() {
        return name.starts_with("map_") or name.starts_with("filter_")
    }
    return arguments.count() == 1 and (name == "map" or name == "filter")
}

func chained_element_of(receiver_type: Analysis.SpiteType): Analysis.SpiteType? {
    var listed = type_shape.as_list(receiver_type)
    if listed {
        return listed.get_element()
    }
    var dictionary = type_shape.as_dictionary(receiver_type)
    if dictionary {
        return dictionary.get_element()
    }
    return null
}

func fused_step(
    base_list: Analysis.ClassInfo,
    current_type: Analysis.SpiteType,
    call: Syntax.Expressions.CallExpression,
    owners: List<PassedFunction>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): FusedStep? {
    crash call.callee
    var callee = shape.as_member(call.callee)
    assert callee
    var name = callee.name
    if is_function_form(name, call.arguments) {
        var argument = call.arguments.first()
        var passed = resolve_passed_function(argument, scope, class_information)
        assert passed
        var problem = passed_function_problem(name, argument, passed, current_type)
        assert problem.is_empty()
        var owner_count = owners.count()
        var fused_owner = fused_owner_name(owner_count)
        var owner_type = passed.get_owner_type()
        assert not fused_owner.is_empty() and not fused_type_spelling(owner_type).is_empty()
        owners.append(passed)
        var passed_returned = passed.get_returned()
        var step_prefix = form_prefix(name)
        var step = FusedStep(step_prefix, passed_returned, passed.function_name)
        step.owner_name = fused_owner
        return step
    }
    var template = element_template_of(base_list, name)
    assert template
    var member_name = template.member_name_for(name)
    var element_class = element_class_of(current_type)
    assert element_class
    var member_type = member_type_of(element_class, member_name)
    assert member_type
    var is_field = is_field_of(element_class, member_name)
    var requirement = member_requirement(template.prefix, is_field, member_name, member_type)
    assert requirement.is_empty()
    var read = "{member_name}()"
    if is_field {
        read = member_name
    }
    return FusedStep(template.prefix, member_type, read)
}

func fused_step_name(
    call: Syntax.Expressions.CallExpression,
    owners: List<PassedFunction>,
    owner_index: Integer,
): String {
    crash call.callee
    var callee = shape.as_member(call.callee)
    crash callee
    if not is_function_form(callee.name, call.arguments) {
        return callee.name
    }
    crash owner_index < owners.count()
    return "{callee.name}_{owners[owner_index].label}"
}

func fused_owner_name(owner_count: Integer): String {
    var names = ["owner", "second_owner", "third_owner", "fourth_owner", "fifth_owner", "sixth_owner"]
    if owner_count < names.count() {
        return names[owner_count]
    }
    return ""
}

func fused_type_spelling(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        if class_ref.has_signature {
            return fused_signature_spelling(class_ref)
        }
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return described.qualified_dotted
        }
        return ""
    }
    if type_shape.as_string(spite_type) or type_shape.as_scalar(spite_type) {
        return type_display_name(spite_type)
    }
    return ""
}

func fused_signature_spelling(signature: Analysis.Types.ClassRefType): String {
    var spellings = List<String>()
    var index = 0
    while index < signature.arguments.count() {
        var spelling = fused_type_spelling(signature.arguments[index])
        assert not spelling.is_empty()
        spellings.append(spelling)
        index = index + 1
    }
    var returned = returned_type(signature)
    var returned_spelling = fused_type_spelling(returned)
    assert not returned_spelling.is_empty()
    spellings.append(returned_spelling)
    return "Spite.Function<{spellings.join(", ")}>"
}

func fused_value_name(mapped_count: Integer): String {
    var names = ["mapped", "second_mapped", "third_mapped", "fourth_mapped", "fifth_mapped", "sixth_mapped"]
    if mapped_count < names.count() {
        return names[mapped_count]
    }
    return ""
}

func fused_chain_source(
    base_list: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    steps: List<Syntax.Expressions.CallExpression>,
    owners: List<PassedFunction>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var loop_lines = List<String>()
    var current_type = element
    var current_name = "item"
    var indent = "        "
    var closings = List<String>()
    var mapped_count = 0
    var step_names = List<String>()
    var index = 0
    while index < steps.count() - 1 {
        var owner_count = owners.count()
        var step = fused_step(base_list, current_type, steps[index], owners, scope, class_information)
        assert step
        crash steps[index]
        var step_name = fused_step_name(steps[index], owners, owner_count)
        step_names.append(step_name)
        var stage_read = step.read_of(current_name)
        if step.prefix == "filter_" {
            loop_lines.append("{indent}if {stage_read} \{")
            closings.append("{indent}}")
            indent = "{indent}    "
        } else {
            var mapped_type = step.get_member_type()
            var next_name = fused_value_name(mapped_count)
            assert not next_name.is_empty() and not fused_type_spelling(mapped_type).is_empty()
            loop_lines.append("{indent}var {next_name} = {stage_read}")
            mapped_count = mapped_count + 1
            current_name = next_name
            current_type = mapped_type
        }
        index = index + 1
    }
    var owner_count = owners.count()
    var last_call = steps.last()
    crash last_call
    var last = fused_step(base_list, current_type, last_call, owners, scope, class_information)
    assert last
    var last_step_name = fused_step_name(last_call, owners, owner_count)
    step_names.append(last_step_name)
    var last_member_type = last.get_member_type()
    var element_spelling = fused_type_spelling(current_type)
    var member_spelling = fused_type_spelling(last_member_type)
    var read = last.read_of(current_name)
    var fused_name = step_names.join("_then_")
    var parameters = List<String>()
    var returns = ""
    var before = List<String>()
    var after = List<String>()
    if last.prefix == "sum_" {
        returns = ": {member_spelling}"
        before.append("    var total: {member_spelling} = 0")
        loop_lines.append("{indent}total = total + {read}")
        after.append("    return total")
    } else if last.prefix == "count_" {
        returns = ": Integer"
        before.append("    var counted = 0")
        loop_lines.append("{indent}if {read} \{\n{indent}    counted = counted + 1\n{indent}}")
        after.append("    return counted")
    } else if last.prefix == "any_" {
        returns = ": Boolean"
        loop_lines.append("{indent}if {read} \{\n{indent}    return true\n{indent}}")
        after.append("    return false")
    } else if last.prefix == "all_" {
        returns = ": Boolean"
        loop_lines.append("{indent}assert {read}")
        after.append("    return true")
    } else if last.prefix == "find_by_" {
        parameters.append("value: {member_spelling}")
        returns = ": {element_spelling}?"
        loop_lines.append("{indent}if {read} == value \{\n{indent}    return {current_name}\n{indent}}")
        after.append("    return null")
    } else if last.prefix == "each_" {
        loop_lines.append("{indent}{read}")
    } else if last.prefix == "map_" {
        returns = ": List<{member_spelling}>"
        before.append("    var collected = List<{member_spelling}>()")
        loop_lines.append("{indent}var value = {read}\n{indent}collected.append(value)")
        after.append("    return collected")
    } else if last.prefix == "filter_" {
        returns = ": List<{element_spelling}>"
        before.append("    var collected = List<{element_spelling}>()")
        loop_lines.append("{indent}if {read} \{\n{indent}    collected.append({current_name})\n{indent}}")
        after.append("    return collected")
    } else {
        returns = ": List<{element_spelling}>"
        before.append("    var sorted = List<{element_spelling}>()")
        before.append("    var keys = List<{member_spelling}>()")
        loop_lines.append(
            "{indent}var key = {read}\n{indent}var position = keys.count()\n{indent}while position > 0 and keys.get_at(position - 1) > key \{\n{indent}    position = position - 1\n{indent}}\n{indent}keys.insert(position, key)\n{indent}sorted.insert(position, {current_name})",
        )
        after.append("    return sorted")
    }
    var voided = type_shape.is_void(last_member_type)
    assert not element_spelling.is_empty() and (not member_spelling.is_empty() or voided)
    var owner_index = 0
    while owner_index < owners.count() {
        var owner_type = owners[owner_index].get_owner_type()
        parameters.append("{fused_owner_name(owner_index)}: {fused_type_spelling(owner_type)}")
        owner_index = owner_index + 1
    }
    closings.reverse()
    var lines = List<String>()
    lines.append("func {fused_name}({parameters.join(", ")}){returns} \{")
    append_lines(lines, before)
    lines.append("    var index = 0")
    lines.append("    while index < item_count \{")
    lines.append("        var item = values.read_value(items, index)")
    lines.append("        index = index + 1")
    append_lines(lines, loop_lines)
    append_lines(lines, closings)
    lines.append("    }")
    append_lines(lines, after)
    lines.append("}")
    lines.append("")
    return lines.join("\n")
}

func is_function_form(name: String, arguments: List<Syntax.Expressions.Expression>): Boolean {
    var forms = ["each", "map", "filter", "any", "all", "count", "find", "sort_by", "sum"]
    return arguments.count() == 1 and forms.contains(name)
}

func form_prefix(name: String): String {
    if name == "find" {
        return "find_by_"
    }
    return "{name}_"
}

func form_arguments(name: String): List<Syntax.Expressions.Expression> {
    var arguments = List<Syntax.Expressions.Expression>()
    if name == "find" {
        var found: Syntax.Expressions.Expression = Syntax.Expressions.TrueLiteral()
        arguments.append(found)
    }
    return arguments
}

func resolve_passed_function(
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): PassedFunction? {
    var bound = bound_function_of(argument, scope, class_information)
    if bound {
        return bound
    }
    var saved_counter = temporary_counter
    var probe = generate_expression(argument, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    var signature = type_shape.as_class_ref(probe_type)
    assert signature
    assert signature.has_signature
    var returned = void_type()
    var returns_nothing = false
    if signature.returns {
        var returns_class = type_shape.as_class_ref(signature.returns)
        if returns_class {
            returns_nothing = returns_class.c_name == "Nothing"
        }
        if not returns_nothing {
            returned = signature.returns
        }
    }
    var passed = PassedFunction(argument, probe_type, "", returned)
    passed.parameter_types = signature.arguments
    var returned_c_name = c_type_name(returned)
    passed.label = "function_value_{identifier_text(returned_c_name)}"
    return passed
}

func bound_function_of(
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): PassedFunction? {
    var identifier = shape.as_identifier(argument)
    if identifier {
        assert not scope.lookup_type(identifier.name) and not class_information.find_field(identifier.name)
        var own: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("self")
        return passed_member_function(own, class_information, identifier.name)
    }
    var member = shape.as_member(argument)
    assert member
    crash member.object
    assert not try_resolve_static_path(member.object, class_information.qualified_dotted)
    var saved_counter = temporary_counter
    var probe = generate_expression(member.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    var owner_ref = type_shape.as_class_ref(probe_type)
    assert owner_ref
    assert not owner_ref.has_signature
    var owner_class = find_class_by_c_name(owner_ref.c_name)
    assert owner_class
    assert not owner_class.find_field(member.name)
    return passed_member_function(member.object, owner_class, member.name)
}

func passed_member_function(
    owner: Syntax.Expressions.Expression,
    owner_class: Analysis.ClassInfo,
    name: String,
): PassedFunction? {
    assert not owner_class.is_value_class and not owner_class.is_generic_template and owner_class.codegen_names.is_empty()
    var function = find_or_instantiate_function(owner_class, name)
    assert function
    assert not function.is_constructor
    var owner_type: Analysis.SpiteType = Analysis.Types.ClassRefType(owner_class.c_name)
    var returned = function.get_return_type()
    var passed = PassedFunction(owner, owner_type, name, returned)
    passed.parameter_types = parameter_types_of(function.parameters)
    passed.label = "{name}_for_{owner_class.c_name.lower_case()}"
    return passed
}

func identifier_text(text: String): String {
    var kept = List<String>()
    var index = 0
    while index < text.length() {
        if is_attribute_name_code(text, index) {
            var kept_character = text.slice(index, index + 1)
            kept.append(kept_character)
        }
        index = index + 1
    }
    var joined = kept.join("")
    return joined.lower_case()
}

func passed_function_problem(
    name: String,
    argument: Syntax.Expressions.Expression,
    passed: PassedFunction,
    element: Analysis.SpiteType,
): String {
    var label = Syntax.SourcePrinter().source_expression(argument)
    var element_label = type_display_name(element)
    var parameter_count = passed.parameter_types.count()
    if parameter_count != 1 {
        return "'{name}' calls '{label}' with each '{element_label}' as its only argument, but '{label}' takes {parameter_count}"
    }
    var parameter_type = passed.parameter_types.first()
    if not types_equal(parameter_type, element) {
        return "'{name}' calls '{label}' with each '{element_label}', but '{label}' takes '{type_display_name(parameter_type)}'"
    }
    var returned = passed.get_returned()
    var requirement = form_requirement(name, label, returned)
    assert not requirement.is_empty()
    return "'{name}({label})': '{label}' {described_member(returned)}, but '{name}' needs it to {requirement}"
}

func form_requirement(name: String, label: String, returned: Analysis.SpiteType): String {
    var tests = ["filter", "any", "all", "count", "find"]
    if tests.contains(name) and not is_boolean_type(returned) {
        if name == "count" and is_numeric_type(returned) {
            return "return Boolean (to add up what it returns use 'sum({label})')"
        }
        return "return Boolean"
    }
    if name == "sum" and not is_numeric_type(returned) {
        return "return a numeric type"
    }
    if name == "map" and type_shape.is_void(returned) {
        return "return a value (to only call it for each element, write 'each({label})')"
    }
    var ordered = is_numeric_type(returned) or type_shape.as_string(returned)
    if name == "sort_by" and not ordered {
        return "return something ordered: a number or a String"
    }
    return ""
}

func function_form_instance(
    list_class: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    name: String,
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): PassedFunction? {
    var passed = resolve_passed_function(argument, scope, class_information)
    if not passed {
        var printed = Syntax.SourcePrinter().source_expression(argument)
        report(
            "'{name}' takes a function to call with each element, such as '{name}(say_hello)' or '{name}(greeter.say_hello)', and '{printed}' is not one",
        )
        return null
    }
    crash passed
    var problem = passed_function_problem(name, argument, passed, element)
    if not problem.is_empty() {
        report(problem)
        return null
    }
    var prefix = form_prefix(name)
    var template = template_with_prefix(list_class, prefix)
    crash template
    var instance_name = "{prefix}{passed.label}"
    var existing = list_class.find_function(instance_name)
    if existing {
        passed.instance = existing
        return passed
    }
    var owner_type = passed.get_owner_type()
    var owner_c_name = "Spite_Function"
    var owner_ref = type_shape.as_class_ref(owner_type)
    if owner_ref {
        if not owner_ref.has_signature {
            owner_c_name = owner_ref.c_name
        }
    }
    var passed_returned = passed.get_returned()
    passed.instance = instantiate_template(
        list_class,
        template,
        passed.function_name,
        passed_returned,
        owner_c_name,
        instance_name,
        owner_type,
    )
    return passed
}

func template_with_prefix(list_class: Analysis.ClassInfo, prefix: String): Analysis.TemplateInfo? {
    var index = 0
    while index < list_class.templates.count() {
        var template = list_class.templates[index]
        if template.prefix == prefix and template.suffix.is_empty() and template.range {
            return template
        }
        index = index + 1
    }
    return null
}

func generate_function_form(
    list_class: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    name: String,
    receiver: ExpressionResult,
    receiver_ast: Syntax.Expressions.Expression,
    argument: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var passed = function_form_instance(list_class, element, name, argument, scope, class_information)
    if not passed {
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash passed
    var function = passed.get_instance()
    var passed_arguments = form_arguments(name)
    var owner = passed.get_owner()
    passed_arguments.append(owner)
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.get_return_type()
    return generate_generic_call(
        function.c_name,
        receiver,
        receiver_ast,
        passed_arguments,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func append_lines(lines: List<String>, added: List<String>) {
    var index = 0
    while index < added.count() {
        var line = added[index]
        lines.append(line)
        index = index + 1
    }
}

func register_fused_function(
    base_list: Analysis.ClassInfo,
    source: String,
    fused_name: String,
): Analysis.FunctionInfo? {
    var lexer = Syntax.Lexer(source)
    var parser = Syntax.Parser(lexer.tokens)
    var file = parser.parse_file()
    assert not lexer.has_error and not parser.has_error and not file.statements.is_empty()
    var first_statement = file.statements.first()
    var declaration = shape.as_function_declaration(first_statement)
    assert declaration
    declaration.source_path = base_list.source_path
    var saved_owner = current_owner
    var saved_class = current_class
    var saved_path = current_path
    var saved_line = current_line
    var saved_function = current_function
    current_owner = base_list.qualified_dotted
    current_class = base_list
    current_path = base_list.source_path
    resolve_function(declaration, base_list)
    current_owner = saved_owner
    current_class = saved_class
    current_path = saved_path
    current_line = saved_line
    current_function = saved_function
    var function = base_list.find_function(fused_name)
    if function {
        builder.add_prototype("{function_signature(base_list, function)};")
    }
    return function
}

func is_listed_class(information: Analysis.ClassInfo): Boolean {
    assert not information.is_generic_template
    assert not information.c_name.starts_with("Object_") and not information.c_name.starts_with("Spite_")
    var prelude_path = Prelude().path()
    assert not information.source_path.starts_with("library/") and not information.source_path.starts_with("launcher/")
    assert information.source_path != prelude_path
    return information.c_name != "Nothing"
}

func describes_members(information: Analysis.ClassInfo): Boolean {
    assert not information.is_generic_template and not information.is_value_class
    assert not information.c_name.starts_with("Object_")
    return information.c_name != "Nothing"
}

func emit_class_object_bodies() {
    while class_objects_emitted < class_object_names.count() {
        var position = class_objects_emitted
        class_objects_emitted = class_objects_emitted + 1
        crash class_object_names[position]
        var function_c_name = class_object_names[position]
        var lines = List<String>()
        lines.append("Spite_Class* {function_c_name}(void) \{")
        lines.append("if ({function_c_name}_cache == 0) \{")
        crash class_object_displays[position]
        lines.append("{function_c_name}_cache = Spite_Class___make({ensure_symbol(class_object_displays[position])});")
        crash class_object_labels[position]
        var described = find_class_by_c_name(class_object_labels[position])
        if described {
            if described.is_singleton {
                lines.append("{function_c_name}_cache->_singleton_ = true;")
            }
            if namespace_read_used {
                crash class_object_namespaces[position]
                var described_namespace = class_object_namespaces[position]
                if not described_namespace.is_empty() {
                    lines.append(
                        "{function_c_name}_cache->_namespace_ = {ensure_namespace_object(described_namespace)}();",
                    )
                }
            }
            if class_level_attributes_used and describes_members(described) {
                var attributes_function = ensure_attributes_function(described)
                var attribute_thunk = "spite_class_attributes_{described.c_name}"
                var attribute_listed_class = find_class_by_c_name("Spite_Attribute")
                crash attribute_listed_class
                var class_type = class_type_of(attribute_listed_class)
                var attribute_list_name = ensure_list(class_type)
                class_type = class_type_of(attribute_listed_class)
                var list_type = list_type_of(class_type)
                var attribute_list_c_type = c_type_name(list_type)
                builder.add_prototype("{attribute_list_c_type} {attribute_thunk}(void);")
                var released_code = released_stand_in(described)
                builder.add_support(
                    "{attribute_list_c_type} {attribute_thunk}(void) \{\n{described.c_name}* fresh = {described.c_name}___default();\n{untracked_stand_in(described)}\n{attribute_list_c_type} listed = {attributes_function}(fresh);\n{released_code}\nreturn listed;\n}",
                )
                lines.append("{attribute_list_name}___release({function_c_name}_cache->_attributes_);")
                lines.append("{function_c_name}_cache->_attributes_ = {attribute_thunk}();")
            }
            if class_level_functions_used and describes_members(described) and described.c_name != entry_class_c_name {
                var functions_function = ensure_functions_function(described)
                var maker = "{described.c_name}___default()"
                var thunk = "spite_class_functions_{described.c_name}"
                var listed_class = find_class_by_c_name("Spite_Function")
                crash listed_class
                var class_type = class_type_of(listed_class)
                var listed_name = ensure_list(class_type)
                class_type = class_type_of(listed_class)
                var list_type = list_type_of(class_type)
                var listed_c_type = c_type_name(list_type)
                builder.add_prototype("{listed_c_type} {thunk}(void);")
                var kept_code = kept_stand_in(described, thunk)
                builder.add_support(
                    "{listed_c_type} {thunk}(void) \{\n{described.c_name}* fresh = {maker};\n{untracked_stand_in(described)}\n{listed_c_type} listed = {functions_function}(fresh);\n{kept_code}\nreturn listed;\n}",
                )
                lines.append("{listed_name}___release({function_c_name}_cache->_functions_);")
                lines.append("{function_c_name}_cache->_functions_ = {thunk}();")
            }
        }
        lines.append("}")
        lines.append("return Spite_Class___retain({function_c_name}_cache);")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
}

func singleton_destroyed(information: Analysis.ClassInfo): String {
    var lines = List<String>()
    lines.append("void {information.c_name}___destroy({information.c_name}* self) \{")
    lines.append("if (self == 0) return;")
    if information.drop_function {
        lines.append("{information.drop_function.c_name}(self);")
    }
    lines.append("{information.c_name}___discard(self);")
    lines.append("}")
    return lines.join("\n")
}

func untracked_stand_in(described: Analysis.ClassInfo): String {
    return "#ifdef SPITE_TRACKS_{described.c_name}\nspite_untrack_{described.c_name}(fresh);\n#endif"
}

func released_stand_in(described: Analysis.ClassInfo): String {
    if described.is_singleton and not described.is_stateless_singleton {
        return "{described.c_name}___discard(fresh);"
    }
    return "{described.c_name}___release(fresh);"
}

func kept_stand_in(described: Analysis.ClassInfo, thunk: String): String {
    if not described.is_singleton or described.is_stateless_singleton {
        return "{described.c_name}___release(fresh);"
    }
    var kept = "{thunk}_stand_in"
    builder.add_support(
        "static {described.c_name}* {kept} = 0;\nstatic void {kept}_teardown(void) \{\n{described.c_name}___discard({kept});\n{kept} = 0;\n}",
    )
    return "{kept} = fresh;\nspite_singleton_created({kept}_teardown);"
}

func emit_all_classes_function() {
    assert all_classes_used
    var class_class = find_class_by_c_name("Spite_Class")
    assert class_class
    var class_type = class_type_of(class_class)
    var list_name = ensure_list(class_type)
    var lines = List<String>()
    lines.append("{list_name}* spite_all_classes(void) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    var index = 0
    while index < classes.count() {
        if is_listed_class(classes[index]) {
            var listed_class_type = class_type_of(classes[index])
            lines.append("{list_name}_append(result, {class_object_call(listed_class_type)});")
        }
        index = index + 1
    }
    lines.append("return result;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func ensure_live_instances(information: Analysis.ClassInfo): String {
    var name = information.c_name
    var function_c_name = "{name}___instances"
    if tracked_class_names.contains(name) {
        return function_c_name
    }
    tracked_class_names.append(name)
    var class_type = class_type_of(information)
    var list_name = ensure_list(class_type)
    var registry = "spite_instances_{name}"
    builder.add_typedef(
        "#define SPITE_TRACKS_{name}\nstatic {name}** {registry} = 0;\nstatic int64_t {registry}_count = 0;\nstatic int64_t {registry}_capacity = 0;",
    )
    builder.add_prototype("void spite_track_{name}({name}* self);")
    builder.add_prototype("void spite_untrack_{name}({name}* self);")
    builder.add_prototype("{list_name}* {function_c_name}(void);")
    builder.add_support(
        "void spite_track_{name}({name}* self) \{\nif ({registry}_count == {registry}_capacity) \{\n{registry}_capacity = {registry}_capacity == 0 ? 8 : {registry}_capacity * 2;\n{registry} = ({name}**)realloc({registry}, (size_t){registry}_capacity * sizeof({name}*));\n}\n{registry}[{registry}_count] = self;\n{registry}_count = {registry}_count + 1;\n}",
    )
    builder.add_support(
        "void spite_untrack_{name}({name}* self) \{\nfor (int64_t spite_index = 0; spite_index < {registry}_count; spite_index = spite_index + 1) \{\nif ({registry}[spite_index] == self) \{\nfor (int64_t spite_shift = spite_index; spite_shift < {registry}_count - 1; spite_shift = spite_shift + 1) \{ {registry}[spite_shift] = {registry}[spite_shift + 1]; }\n{registry}_count = {registry}_count - 1;\nreturn;\n}\n}\n}",
    )
    builder.add_support(
        "{list_name}* {function_c_name}(void) \{\n{list_name}* result = {list_name}___make();\nfor (int64_t spite_index = 0; spite_index < {registry}_count; spite_index = spite_index + 1) \{ {list_name}_append(result, {name}___retain({registry}[spite_index])); }\nreturn result;\n}",
    )
    singleton_releases.append("if ({registry} != 0) free({registry});")
    return function_c_name
}

func ensure_namespace_object(namespace_dotted: String): String {
    var function_c_name = "spite_namespace_object_{namespace_dotted.replace(".", "_")}"
    if namespace_object_keys.contains(namespace_dotted) {
        return function_c_name
    }
    if not find_class_by_c_name("Spite_Namespace") {
        report(
            "reflection needs the standard library: library/spite/namespace.spite was not found from the working directory",
        )
        return function_c_name
    }
    namespace_object_keys.append(namespace_dotted)
    builder.add_typedef("static Spite_Namespace* {function_c_name}_cache = 0;")
    builder.add_prototype("Spite_Namespace* {function_c_name}(void);")
    return function_c_name
}

func emit_namespace_object_bodies() {
    while namespace_objects_emitted < namespace_object_keys.count() {
        var position = namespace_objects_emitted
        namespace_objects_emitted = namespace_objects_emitted + 1
        crash namespace_object_keys[position]
        var namespace_dotted = namespace_object_keys[position]
        var function_c_name = "spite_namespace_object_{namespace_dotted.replace(".", "_")}"
        var segments = namespace_dotted.split(".")
        var namespace_name = segments.last()
        crash namespace_name
        var lines = List<String>()
        lines.append("Spite_Namespace* {function_c_name}(void) \{")
        lines.append("if ({function_c_name}_cache == 0) \{")
        lines.append(
            "{function_c_name}_cache = Spite_Namespace___make({ensure_symbol(namespace_name)}, {ensure_symbol(namespace_dotted)});",
        )
        if segments.count() > 1 {
            var parent_segments = segments.copy()
            parent_segments.remove_last()
            var joined_parent_segments = parent_segments.join(".")
            lines.append("{function_c_name}_cache->_parent_ = {ensure_namespace_object(joined_parent_segments)}();")
        }
        if namespace_tree_used {
            var class_class = find_class_by_c_name("Spite_Class")
            var namespace_class = find_class_by_c_name("Spite_Namespace")
            crash class_class
            crash namespace_class
            var class_type = class_type_of(class_class)
            var classes_list_name = ensure_list(class_type)
            var namespace_class_type = class_type_of(namespace_class)
            var namespaces_list_name = ensure_list(namespace_class_type)
            var class_index = 0
            while class_index < classes.count() {
                if is_listed_class(classes[class_index]) {
                    if classes[class_index].namespace_dotted == namespace_dotted {
                        var listed_class_type = class_type_of(classes[class_index])
                        lines.append(
                            "{classes_list_name}_append({function_c_name}_cache->_classes_, {class_object_call(listed_class_type)});",
                        )
                    }
                }
                class_index = class_index + 1
            }
            var child_namespaces = List<String>()
            class_index = 0
            while class_index < classes.count() {
                if is_listed_class(classes[class_index]) {
                    var child_dotted = classes[class_index].namespace_dotted
                    if child_dotted.starts_with("{namespace_dotted}.") {
                        if child_dotted.split(".").count() == segments.count() + 1 {
                            if not child_namespaces.contains(child_dotted) {
                                child_namespaces.append(child_dotted)
                            }
                        }
                    }
                }
                class_index = class_index + 1
            }
            var child_position = 0
            while child_position < child_namespaces.count() {
                lines.append(
                    "{namespaces_list_name}_append({function_c_name}_cache->_namespaces_, {ensure_namespace_object(child_namespaces[child_position])}());",
                )
                child_position = child_position + 1
            }
        }
        lines.append("}")
        lines.append("return Spite_Namespace___retain({function_c_name}_cache);")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
    }
}

func ensure_class_object(display_name: String, namespace: String, label: String): String {
    var function_c_name = "spite_class_object_{label}"
    if class_object_names.contains(function_c_name) {
        return function_c_name
    }
    if not find_class_by_c_name("Spite_Class") {
        report(
            "reflection needs the standard library: library/spite/class.spite was not found from the working directory",
        )
        return function_c_name
    }
    class_object_names.append(function_c_name)
    class_object_displays.append(display_name)
    class_object_namespaces.append(namespace)
    class_object_labels.append(label)
    builder.add_typedef("static Spite_Class* {function_c_name}_cache = 0;")
    builder.add_prototype("Spite_Class* {function_c_name}(void);")
    return function_c_name
}

func class_object_call(spite_type: Analysis.SpiteType): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            return "{ensure_class_object(described.simple_name, described.namespace_dotted, described.c_name)}()"
        }
    }
    var label = type_label(spite_type)
    var display_name = type_display_name(spite_type)
    return "{ensure_class_object(display_name, "", label)}()"
}

func type_display_name(spite_type: Analysis.SpiteType): String {
    return type_name_written(spite_type, false)
}

func type_display_names(first: Analysis.SpiteType, second: Analysis.SpiteType): List<String> {
    var first_name = type_name_written(first, false)
    var second_name = type_name_written(second, false)
    if first_name == second_name {
        first_name = type_name_written(first, true)
        second_name = type_name_written(second, true)
    }
    var names = List<String>()
    names.append(first_name)
    names.append(second_name)
    return names
}

func type_name_written(spite_type: Analysis.SpiteType, qualified: Boolean): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        if class_ref.has_signature {
            var named_types = List<String>()
            var argument_index = 0
            while argument_index < class_ref.arguments.count() {
                var display_name = type_name_written(class_ref.arguments[argument_index], qualified)
                named_types.append(display_name)
                argument_index = argument_index + 1
            }
            if class_ref.returns {
                var display_name = type_name_written(class_ref.returns, qualified)
                named_types.append(display_name)
            }
            return "Spite.Function<{named_types.join(", ")}>"
        }
        var described = find_class_by_c_name(class_ref.c_name)
        if described {
            if qualified and described.qualified_dotted != "" {
                return described.qualified_dotted
            }
            return described.simple_name
        }
    }
    var enum_type = type_shape.as_enum(spite_type)
    if enum_type {
        var enum_information = enums.find_by_c_name(enum_type.c_name)
        if enum_information {
            if qualified and enum_information.owner_qualified != "" {
                return "{enum_information.owner_qualified}.{enum_information.simple_name}"
            }
            return enum_information.simple_name
        }
    }
    var union_type = type_shape.as_union(spite_type)
    if union_type {
        var union_information = find_union_by_c_name(union_type.c_name)
        if union_information {
            if qualified and union_information.owner_qualified != "" {
                return "{union_information.owner_qualified}.{union_information.simple_name}"
            }
            return union_information.simple_name
        }
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        return "List<{type_name_written(list_type_element, qualified)}>"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.get_element()
        return "Dictionary<{type_name_written(dictionary_type_element, qualified)}>"
    }
    var nullable_type = type_shape.as_nullable(spite_type)
    if nullable_type {
        var nullable_type_inner = nullable_type.get_inner()
        return "{type_name_written(nullable_type_inner, qualified)}?"
    }
    var scalar = type_shape.as_scalar(spite_type)
    if scalar {
        if scalar.kind == 'address_kind' {
            return "Memory.Address"
        }
    }
    return type_label(spite_type)
}

func spite_class_type(): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.ClassRefType("Spite_Class")
    return resolved
}

func ensure_attributes_function(information: Analysis.ClassInfo): String {
    var function_c_name = "{information.c_name}___attributes"
    if attributes_function_names.contains(function_c_name) {
        return function_c_name
    }
    attributes_function_names.append(function_c_name)
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        report(
            "reflection needs the standard library: library/spite/attribute.spite was not found from the working directory",
        )
        return function_c_name
    }
    crash attribute_class
    var class_type = class_type_of(attribute_class)
    var list_name = ensure_list(class_type)
    var lines = List<String>()
    lines.append("{list_name}* {function_c_name}({information.c_name}* self) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    if read_evaluate_print_loop {
        mark_every_attribute_read(information)
        builder.add_prototype("{list_name}* {function_c_name}({information.c_name}* self);")
        append_live_attributes(information, list_name, lines)
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
        return function_c_name
    }
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.get_type()
        var field_code = "self->{c_value_name(field.name)}"
        if information.is_stateless_singleton {
            field_code = "({field.default_value_code})"
        }
        lines.append(
            "\{ Spite_Attribute* spite_field = Spite_Attribute___make({ensure_symbol(field.name)}, {class_object_call(field_type)});",
        )
        lines.append("spite_field->_value_ = {ensure_attribute_object(field_type)}({field_code});")
        lines.append("{list_name}_append(result, spite_field); }")
        index = index + 1
    }
    lines.append("(void)self;")
    lines.append("return result;")
    lines.append("}")
    builder.add_prototype("{list_name}* {function_c_name}({information.c_name}* self);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func attribute_object_shape(): Analysis.UnionInfo {
    var found = find_union_qualified("Nothing", "Anything")
    crash found
    return found
}

func ensure_attribute_object(spite_type: Analysis.SpiteType): String {
    var function_c_name = "spite_attribute_object_{reflected_label(spite_type)}"
    if attribute_object_names.contains(function_c_name) {
        return function_c_name
    }
    attribute_object_names.append(function_c_name)
    attribute_object_types.append(spite_type)
    var information = attribute_object_shape()
    builder.add_prototype("{information.c_name} {function_c_name}({c_type_name(spite_type)} value);")
    return function_c_name
}

func emit_attribute_object_bodies() {
    assert attribute_objects_emitted < attribute_object_names.count()
    var information = attribute_object_shape()
    var shape_type = union_type_of(information)
    while attribute_objects_emitted < attribute_object_names.count() {
        var position = attribute_objects_emitted
        attribute_objects_emitted = attribute_objects_emitted + 1
        crash attribute_object_types[position]
        var object_code = "0"
        if attribute_object_used {
            object_code = attribute_object_code(attribute_object_types[position], "value", shape_type)
        }
        crash attribute_object_types[position]
        crash attribute_object_names[position]
        builder.add_support(
            "{information.c_name} {attribute_object_names[position]}({c_type_name(attribute_object_types[position])} value) \{\n(void)value;\nreturn {object_code};\n}",
        )
    }
}

func attribute_object_code(spite_type: Analysis.SpiteType, code: String, shape_type: Analysis.SpiteType): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var inner = nullable.get_inner()
        if type_is_reference(inner) {
            return "({code} == 0 ? 0 : {attribute_object_code(inner, code, shape_type)})"
        }
        return "({code}.has_value ? {attribute_object_code(inner, "{code}.value", shape_type)} : 0)"
    }
    if boxed_class_of(spite_type) {
        return cast(code, spite_type, shape_type)
    }
    if type_shape.is_symbol(spite_type) {
        var string_spite_type = string_type()
        var retained_text = retain_call(string_spite_type, code)
        return cast(retained_text, string_spite_type, shape_type)
    }
    if not has_attribute_object(spite_type) {
        return "0"
    }
    var retained = retain_call(spite_type, code)
    return cast(retained, spite_type, shape_type)
}

func has_attribute_object(spite_type: Analysis.SpiteType): Boolean {
    if type_shape.as_class_ref(spite_type) or type_shape.as_string(spite_type) or type_shape.as_union(spite_type) {
        return true
    }
    if type_shape.as_list(spite_type) or type_shape.as_dictionary(spite_type) {
        return true
    }
    return false
}

func ensure_union_attributes(information: Analysis.UnionInfo): String {
    var function_c_name = "{information.c_name}___attributes"
    if not information.attributes_used {
        information.attributes_used = true
        var attribute_class = find_class_by_c_name("Spite_Attribute")
        crash attribute_class
        var class_type = class_type_of(attribute_class)
        var list_name = ensure_list(class_type)
        builder.add_prototype("{list_name}* {function_c_name}({information.c_name} self);")
    }
    return function_c_name
}

func attributes_described(member: Analysis.ClassInfo): Boolean {
    return not boxed_value_types.has(member.c_name) and not member.is_value_class and not member.is_container
}

func ensure_union_attribute_members() {
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.attributes_used {
            var member_index = 0
            while member_index < information.members.count() {
                var member = information.members[member_index]
                if attributes_described(member) {
                    mark_every_attribute_read(member)
                    ensure_attributes_function(member)
                }
                member_index = member_index + 1
            }
        }
        index = index + 1
    }
}

func shape_member_total(): Integer {
    var total = 0
    var index = 0
    while index < unions.count() {
        total = total + unions[index].members.count()
        index = index + 1
    }
    return total
}

func settle_shape_members() {
    var before = -1
    var after = shape_member_total()
    while before != after or attribute_objects_emitted < attribute_object_names.count() {
        before = after
        ensure_union_attribute_members()
        emit_attribute_object_bodies()
        emit_class_object_bodies()
        emit_pending_functions()
        after = shape_member_total()
    }
}

func emit_union_attributes_bodies() {
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    assert attribute_class
    var class_type = class_type_of(attribute_class)
    var list_name = ensure_list(class_type)
    var index = 0
    while index < unions.count() {
        var information = unions[index]
        if information.attributes_used {
            var lines = List<String>()
            lines.append("{list_name}* {information.c_name}___attributes({information.c_name} self) \{")
            var member_index = 0
            while member_index < information.members.count() {
                var member = information.members[member_index]
                if attributes_described(member) {
                    var described = ensure_attributes_function(member)
                    lines.append("if {class_id_test("self", member)} return {described}(({member.c_name}*)self);")
                }
                member_index = member_index + 1
            }
            lines.append("return {list_name}___make();")
            lines.append("}")
            var joined_lines = lines.join("\n")
            builder.add_support(joined_lines)
        }
        index = index + 1
    }
}

func returned_class_object_call(function: Analysis.FunctionInfo): String {
    var function_return_type = function.get_return_type()
    if type_shape.is_void(function_return_type) {
        var nothing = find_class_by_c_name("Nothing")
        if nothing {
            var class_type = class_type_of(nothing)
            return class_object_call(class_type)
        }
        return "{ensure_class_object("Nothing", "", "Nothing")}()"
    }
    return class_object_call(function_return_type)
}

func ensure_functions_function(information: Analysis.ClassInfo): String {
    var function_c_name = "{information.c_name}___functions"
    if functions_function_names.contains(function_c_name) {
        return function_c_name
    }
    functions_function_names.append(function_c_name)
    functions_function_classes.append(information)
    var early_function_class = find_class_by_c_name("Spite_Function")
    if early_function_class {
        var class_type = class_type_of(early_function_class)
        builder.add_prototype("{ensure_list(class_type)}* {function_c_name}({information.c_name}* self);")
    }
    return function_c_name
}

func emit_functions_function(information: Analysis.ClassInfo) {
    var function_c_name = "{information.c_name}___functions"
    var function_class = find_class_by_c_name("Spite_Function")
    var argument_class = find_class_by_c_name("Spite_Argument")
    if not function_class {
        report(
            "reflection needs the standard library: library/spite/function.spite was not found from the working directory",
        )
        return
    }
    if not argument_class {
        report(
            "reflection needs the standard library: library/spite/argument.spite was not found from the working directory",
        )
        return
    }
    assert function_class
    assert argument_class
    var class_type = class_type_of(function_class)
    var list_name = ensure_list(class_type)
    var argument_class_type = class_type_of(argument_class)
    var arguments_list_name = ensure_list(argument_class_type)
    if information.is_container {
        instantiate_member_templates_of(information)
    }
    var lines = List<String>()
    lines.append("{list_name}* {function_c_name}({information.c_name}* self) \{")
    lines.append("{list_name}* result = {list_name}___make();")
    var index = 0
    while index < information.functions.count() {
        var function = information.functions[index]
        var listed = not information.is_container or not function.symbol_owner_c_name.is_empty()
        if listed and not function.is_constructor and not function.symbol_through_caller {
            lines.append("\{")
            lines.append(
                "Spite_Function* described = Spite_Function___make({ensure_symbol(function.name)}, {returned_class_object_call(function)});",
            )
            var parameter_index = 0
            while parameter_index < function.parameters.count() {
                var parameter = function.parameters[parameter_index]
                var parameter_type = parameter.get_type()
                lines.append(
                    "{arguments_list_name}_append(described->_arguments_, Spite_Argument___make({ensure_symbol(parameter.name)}, {class_object_call(parameter_type)}));",
                )
                parameter_index = parameter_index + 1
            }
            lines.append("described->spite_owner = {information.c_name}___retain(self);")
            lines.append("described->spite_release_owner = (void (*)(void*)){information.c_name}___release;")
            var function_return_type = function.get_return_type()
            var callable = not is_inline_supplied(function)
            if callable and function.parameters.count() == 0 and type_shape.is_void(function_return_type) {
                lines.append("described->spite_call = (void (*)(void*)){function.c_name};")
            }
            if callable {
                lines.append("described->spite_typed_call = (void*){function.c_name};")
            }
            if callable and read_evaluate_print_loop {
                var text_call = ensure_text_call(information, function)
                if not text_call.is_empty() {
                    lines.append("described->spite_text_call = (void*){text_call};")
                }
            }
            lines.append("{list_name}_append(result, described);")
            lines.append("}")
        }
        index = index + 1
    }
    lines.append("return result;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func emit_functions_function_bodies() {
    while functions_functions_emitted < functions_function_classes.count() {
        emit_functions_function(functions_function_classes[functions_functions_emitted])
        functions_functions_emitted = functions_functions_emitted + 1
    }
}

func hidden_attribute_links_cleared(target: String): String {
    return "{target}->spite_owner = 0; {target}->spite_release_owner = 0; {target}->spite_assign = 0; {target}->spite_held = 0; {target}->spite_release_held = 0; {target}->spite_held_attributes = 0; {target}->spite_held_functions = 0;"
}

func append_live_attributes(information: Analysis.ClassInfo, list_name: String, lines: List<String>) {
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var field_type = field.get_type()
        var reflect = ensure_reflect_function(field_type)
        lines.append("\{")
        lines.append(
            "Spite_Attribute* spite_field = {reflect}({ensure_symbol(field.name)}, self->{c_value_name(field.name)});",
        )
        var assign = ensure_assign_function(information, field)
        if not assign.is_empty() {
            lines.append("spite_field->spite_owner = {information.c_name}___retain(self);")
            lines.append("spite_field->spite_release_owner = (void (*)(void*)){information.c_name}___release;")
            lines.append("spite_field->spite_assign = {assign};")
        }
        lines.append("{list_name}_append(result, spite_field);")
        lines.append("}")
        index = index + 1
    }
    lines.append("(void)self;")
    lines.append("return result;")
    lines.append("}")
}

func reflected_label(spite_type: Analysis.SpiteType): String {
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.get_inner()
        return "Nullable_{type_label(nullable_inner)}"
    }
    return type_label(spite_type)
}

func walkable_class(spite_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var expected_inner_type = expected_type_without_nullable(spite_type)
    var class_ref = type_shape.as_class_ref(expected_inner_type)
    assert class_ref
    assert not class_ref.has_signature
    var described = find_class_by_c_name(class_ref.c_name)
    assert described
    assert not described.is_value_class and not described.is_generic_template
    return described
}

func ensure_reflect_function(spite_type: Analysis.SpiteType): String {
    var function_c_name = "spite_reflect_{reflected_label(spite_type)}"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var signature = "Spite_Attribute* {function_c_name}(SpiteString* name, {c_type_name(spite_type)} value)"
    builder.add_prototype("{signature};")
    var lines = List<String>()
    lines.append("{signature} \{")
    lines.append("Spite_Attribute* reflected = Spite_Attribute___make(name, {class_object_call(spite_type)});")
    lines.append("reflected->_value_ = {ensure_attribute_object(spite_type)}(value);")
    var walked = walkable_class(spite_type)
    if walked {
        lines.append("reflected->spite_held = {walked.c_name}___retain(value);")
        lines.append("reflected->spite_release_held = (void (*)(void*)){walked.c_name}___release;")
        lines.append("reflected->spite_held_attributes = (void* (*)(void*)){ensure_attributes_function(walked)};")
        lines.append("reflected->spite_held_functions = (void* (*)(void*)){ensure_functions_function(walked)};")
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        var list_name = ensure_list(list_type_element)
        lines.append("reflected->spite_held = {list_name}___retain(value);")
        lines.append("reflected->spite_release_held = (void (*)(void*)){list_name}___release;")
        lines.append(
            "reflected->spite_held_attributes = (void* (*)(void*)){ensure_list_attributes_function(list_type_element)};",
        )
        if read_evaluate_print_loop and type_shape.as_class_ref(list_type_element) {
            var list_class = list_class_of(list_type_element)
            lines.append("reflected->spite_held_functions = (void* (*)(void*)){ensure_functions_function(list_class)};")
        }
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_element = dictionary_type.get_element()
        var dictionary_name = ensure_dictionary(dictionary_element)
        lines.append("reflected->spite_held = {dictionary_name}___retain(value);")
        lines.append("reflected->spite_release_held = (void (*)(void*)){dictionary_name}___release;")
        lines.append(
            "reflected->spite_held_attributes = (void* (*)(void*)){ensure_dictionary_attributes_function(dictionary_element)};",
        )
    }
    lines.append("return reflected;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func ensure_list_attributes_function(element: Analysis.SpiteType): String {
    var list_name = ensure_list(element)
    var function_c_name = "{list_name}___attributes"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    crash attribute_class
    var class_type = class_type_of(attribute_class)
    var attributes_list = ensure_list(class_type)
    var signature = "{attributes_list}* {function_c_name}({list_name}* self)"
    builder.add_prototype("{signature};")
    var reflect = ensure_reflect_function(element)
    builder.add_support(
        "{signature} \{\n{attributes_list}* result = {attributes_list}___make();\nfor (int64_t spite_index = 0; spite_index < self->item_count_; spite_index = spite_index + 1) {attributes_list}_append(result, {reflect}({long_text("spite_index")}, {list_item_code(element, "self", "spite_index")}));\nreturn result;\n}",
    )
    return function_c_name
}

func ensure_dictionary_attributes_function(element: Analysis.SpiteType): String {
    var dictionary_name = ensure_dictionary(element)
    var function_c_name = "{dictionary_name}___attributes"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    reflect_function_names.append(function_c_name)
    var attribute_class = find_class_by_c_name("Spite_Attribute")
    crash attribute_class
    var class_type = class_type_of(attribute_class)
    var attributes_list = ensure_list(class_type)
    var signature = "{attributes_list}* {function_c_name}({dictionary_name}* self)"
    builder.add_prototype("{signature};")
    var reflect = ensure_reflect_function(element)
    var string_spite_type = string_type()
    var key = list_item_code(string_spite_type, "self->entry_keys_", "spite_index")
    var entry = list_item_code(element, "self->entry_values_", "spite_index")
    builder.add_support(
        "{signature} \{\n{attributes_list}* result = {attributes_list}___make();\nfor (int64_t spite_index = 0; spite_index < self->entry_keys_->item_count_; spite_index = spite_index + 1) {attributes_list}_append(result, {reflect}(SpiteString___retain({key}), {entry}));\nreturn result;\n}",
    )
    return function_c_name
}

func enum_from_text_lines(enum_type: Analysis.Types.EnumType, text: String, target: String, failure: String): String {
    var chain = List<String>()
    var index = 0
    while index < enum_type.values.count() {
        var value = enum_type.values[index]
        chain.append("if (SpiteString_equals({text}, {ensure_symbol(value)})) {target} = {enum_type.c_name}_{value};")
        index = index + 1
    }
    chain.append(failure)
    return chain.join(" else ")
}

func ensure_assign_function(information: Analysis.ClassInfo, field: Analysis.FieldInfo): String {
    var field_type = field.get_type()
    var function_c_name = "{information.c_name}___assign_{field.name}"
    var assigned_c = c_type_name(field_type)
    var lines = List<String>()
    lines.append("bool {function_c_name}(void* owner, SpiteString* text) \{")
    lines.append("{information.c_name}* self = ({information.c_name}*)owner;")
    switch field_type {
        Analysis.Types.StringType: lines.append("{assigned_c} assigned = SpiteString___retain(text);")
        Analysis.Types.ScalarType: {
            var string_spite_type = string_type()
            lines.append("{assigned_c} assigned = {cast("text", string_spite_type, field_type)};")
        }
        Analysis.Types.EnumType: {
            lines.append("{assigned_c} assigned;")
            var from_text_lines = enum_from_text_lines(field_type, "text", "assigned", "return false;")
            lines.append(from_text_lines)
        }
        _: return ""
    }
    var setter = information.find_function("set_{field.name}")
    var through_setter = false
    if setter {
        through_setter = setter.parameters.count() == 1
        if through_setter {
            lines.append("{setter.c_name}(self, assigned);")
        }
    }
    if not through_setter {
        if type_needs_drop(field_type) {
            lines.append("{release_call(field_type, "self->{c_value_name(field.name)}")};")
        }
        lines.append("self->{c_value_name(field.name)} = assigned;")
    }
    lines.append("return true;")
    lines.append("}")
    builder.add_prototype("bool {function_c_name}(void* owner, SpiteString* text);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func ensure_text_call(information: Analysis.ClassInfo, function: Analysis.FunctionInfo): String {
    var function_c_name = "{function.c_name}___text_call"
    if reflect_function_names.contains(function_c_name) {
        return function_c_name
    }
    var string_spite_type = string_type()
    var strings = ensure_list(string_spite_type)
    var lines = List<String>()
    lines.append("Spite_Attribute* {function_c_name}(void* owner, {strings}* arguments) \{")
    lines.append("if (arguments->item_count_ != {function.parameters.count()}) return 0;")
    var call_arguments = List<String>()
    call_arguments.append("({information.c_name}*)owner")
    var index = 0
    while index < function.parameters.count() {
        var parameter_type = function.parameters[index].get_type()
        string_spite_type = string_type()
        var item = list_item_code(string_spite_type, "arguments", "{index}")
        switch parameter_type {
            Analysis.Types.StringType: call_arguments.append("SpiteString___retain({item})")
            Analysis.Types.ScalarType: {
                string_spite_type = string_type()
                var cast_code = cast(item, string_spite_type, parameter_type)
                call_arguments.append(cast_code)
            }
            Analysis.Types.EnumType: {
                lines.append("{parameter_type.c_name} argument_{index};")
                var from_text_lines = enum_from_text_lines(parameter_type, item, "argument_{index}", "return 0;")
                lines.append(from_text_lines)
                call_arguments.append("argument_{index}")
            }
            _: return ""
        }
        index = index + 1
    }
    reflect_function_names.append(function_c_name)
    var call = "{function.c_name}({call_arguments.join(", ")})"
    var return_spite_type = function.get_return_type()
    var result_symbol = ensure_symbol("result")
    if type_shape.is_void(return_spite_type) {
        lines.append("{call};")
        lines.append("return Spite_Attribute___make({result_symbol}, {returned_class_object_call(function)});")
    } else {
        lines.append("{c_type_name(return_spite_type)} returned = {call};")
        lines.append(
            "Spite_Attribute* reflected = {ensure_reflect_function(return_spite_type)}({result_symbol}, returned);",
        )
        if type_needs_drop(return_spite_type) {
            lines.append("{release_call(return_spite_type, "returned")};")
        }
        lines.append("return reflected;")
    }
    lines.append("}")
    builder.add_prototype("Spite_Attribute* {function_c_name}(void* owner, {strings}* arguments);")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func string_storage_read(
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var string_class = find_class_by_c_name("SpiteString")
    crash string_class
    var field = string_class.find_field(name)
    assert field
    mark_attribute_read(string_class, name)
    if class_information.c_name != string_class.c_name {
        report_private_member(string_class, name, class_information)
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var field_type = field.get_type()
    if owns(object_result, object_ast) {
        var held = next_temporary()
        var value = next_temporary()
        return ExpressionResult(
            "(\{ SpiteString* {held} = {object_result.code}; {c_type_name(field_type)} {value} = {held}->{c_value_name(name)}; SpiteString___release({held}); {value}; })",
            field_type,
        )
    }
    return ExpressionResult("({object_result.code})->{c_value_name(name)}", field_type)
}

func generate_memory_read(
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
): ExpressionResult? {
    var object_type = object_result.get_type()
    var described_ref = type_shape.as_class_ref(object_type)
    if described_ref {
        var described = find_class_by_c_name(described_ref.c_name)
        if described {
            assert not described.find_field("memory")
            assert not described.find_function("get_memory")
        }
    }
    var memory_class = find_class_by_qualified("Spite.Memory")
    if not memory_class {
        report(
            "reflection needs the standard library: library/spite/memory.spite was not found from the working directory",
        )
        return null
    }
    crash memory_class
    var memory_type = class_type_of(memory_class)
    var object_c_type = c_type_name(object_type)
    var owned = owns(object_result, object_ast) and type_needs_drop(object_type)
    var held = "spite_described"
    var address = "(int64_t)(intptr_t)({held})"
    var bytes = "(int64_t)sizeof(*({held}))"
    var section = "Spite_Memory_Section_heap"
    if type_shape.as_string(object_type) {
        address = "({held})->_bytes_"
        bytes = "({held})->_length_"
        section = "({held})->_section_"
    } else if type_shape.as_scalar(object_type) or is_enum_type(object_type) {
        if owned or is_owning_shape(object_ast) {
            report("only a named value has memory of its own: give this value a name with 'var' first")
            return null
        }
        address = "(int64_t)(intptr_t)&({object_result.code})"
        bytes = "(int64_t)sizeof({object_c_type})"
        var scalar_described = type_shape.as_scalar(object_type)
        if scalar_described {
            var number_class = value_class_of(scalar_described.kind)
            if number_class {
                bytes = "(int64_t){number_class.memory_bytes}"
            }
        }
        if not object_result.code.contains("->") {
            section = "Spite_Memory_Section_stack"
        }
        var scalar_memory = ExpressionResult("Spite_Memory___make({address}, {bytes}, {section})", memory_type)
        scalar_memory.owning_override = true
        return scalar_memory
    } else if not type_needs_drop(object_type) or type_shape.as_nullable(object_type) or type_shape.as_union(object_type) {
        report("{type_with_article(object_type)} has no memory of its own to describe")
        return null
    }
    var release_object = ""
    if owned {
        release_object = "{release_call(object_type, held)};"
    }
    var described_memory = ExpressionResult(
        "(\{ {object_c_type} {held} = {object_result.code}; Spite_Memory* spite_memory = Spite_Memory___make({address}, {bytes}, {section}); {release_object} spite_memory; })",
        memory_type,
    )
    described_memory.owning_override = true
    return described_memory
}

func generate_reflection_read(
    member_name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
): ExpressionResult? {
    assert member_name == "class" or member_name == "attributes" or member_name == "functions"
    var object_type = object_result.get_type()
    var object_c_type = c_type_name(object_type)
    var owning_object = owns(object_result, object_ast) and type_needs_drop(object_type)
    var release_object = ""
    if owning_object {
        release_object = "{release_call(object_type, "spite_reflected")};"
    }
    var object_class_ref = type_shape.as_class_ref(object_type)
    if object_class_ref {
        if object_class_ref.c_name == "Spite_Class" and member_name == "functions" {
            class_level_functions_used = true
        }
        if object_class_ref.c_name == "Spite_Class" and member_name == "attributes" {
            class_level_attributes_used = true
        }
        var object_class = find_class_by_c_name(object_class_ref.c_name)
        if object_class {
            assert not object_class.find_function("get_{member_name}")
            var real_field = object_class.find_field(member_name)
            if real_field {
                mark_attribute_read(object_class, member_name)
                var real_field_type = real_field.get_type()
                var retained_field = retain_call(real_field_type, "spite_reflected->{c_value_name(member_name)}")
                return ExpressionResult(
                    "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(real_field_type)} spite_reflected_value = {retained_field}; {release_object} spite_reflected_value; })",
                    real_field_type,
                )
            }
            if member_name == "functions" {
                var functions_function = ensure_functions_function(object_class)
                var described_class = find_class_by_c_name("Spite_Function")
                if described_class {
                    var class_type = class_type_of(described_class)
                    var functions_type = list_type_of(class_type)
                    return ExpressionResult(
                        "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(functions_type)} spite_reflected_value = {functions_function}(spite_reflected); {release_object} spite_reflected_value; })",
                        functions_type,
                    )
                }
                return null
            }
            if member_name == "attributes" {
                mark_every_attribute_read(object_class)
                var attributes_function = ensure_attributes_function(object_class)
                var attribute_class = find_class_by_c_name("Spite_Attribute")
                if attribute_class {
                    var class_type = class_type_of(attribute_class)
                    var attributes_type = list_type_of(class_type)
                    return ExpressionResult(
                        "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(attributes_type)} spite_reflected_value = {attributes_function}(spite_reflected); {release_object} spite_reflected_value; })",
                        attributes_type,
                    )
                }
                return null
            }
        }
    }
    var attributes_union = type_shape.as_union(object_type)
    if member_name == "attributes" and attributes_union {
        var attributes_information = find_union_by_c_name(attributes_union.c_name)
        crash attributes_information
        var dispatch = ensure_union_attributes(attributes_information)
        var attribute_class = find_class_by_c_name("Spite_Attribute")
        crash attribute_class
        var listed_type = class_type_of(attribute_class)
        var attributes_type = list_type_of(listed_type)
        return ExpressionResult(
            "(\{ {object_c_type} spite_reflected = {object_result.code}; {c_type_name(attributes_type)} spite_reflected_value = {dispatch}(spite_reflected); {release_object} spite_reflected_value; })",
            attributes_type,
        )
    }
    if member_name == "class" {
        assert not type_shape.is_void(object_type)
        var object_union = type_shape.as_union(object_type)
        if object_union {
            var union_information = find_union_by_c_name(object_union.c_name)
            if union_information {
                var class_of = ensure_union_class_of(union_information)
                var class_object_type = spite_class_type()
                return ExpressionResult(
                    "(\{ {object_c_type} spite_reflected = {object_result.code}; Spite_Class* spite_reflected_class = {class_of}(spite_reflected); {release_object} spite_reflected_class; })",
                    class_object_type,
                )
            }
        }
        var class_object_type = spite_class_type()
        return ExpressionResult(
            "(\{ {object_c_type} spite_reflected = {object_result.code}; {release_object} (void)spite_reflected; {class_object_call(object_type)}; })",
            class_object_type,
        )
    }
    return null
}

func report_private_member(target_class: Analysis.ClassInfo, name: String, class_information: Analysis.ClassInfo) {
    assert name.starts_with("_") and target_class.c_name != class_information.c_name
    var name_length = name.length()
    var public_name = name.slice(1, name_length)
    if target_class.find_function("get_{public_name}") {
        report(
            "'{name}' is private to '{target_class.simple_name}': a name starting with '_' is used only inside its own class, and '{public_name}' reads it from outside",
        )
        return
    }
    report(
        "'{name}' is private to '{target_class.simple_name}': a name starting with '_' is used only inside its own class",
    )
}

func find_getter(
    target_class: Analysis.ClassInfo,
    attribute_name: String,
    calling_class: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    var getter_name = "get_{attribute_name}"
    assert target_class.c_name != calling_class.c_name or current_function != getter_name
    var getter = find_or_instantiate_function(target_class, getter_name)
    if getter {
        if getter.parameters.count() == 0 {
            return getter
        }
    }
    return null
}

func find_setter(
    target_class: Analysis.ClassInfo,
    attribute_name: String,
    calling_class: Analysis.ClassInfo,
): Analysis.FunctionInfo? {
    assert target_class.find_field(attribute_name)
    var setter_name = "set_{attribute_name}"
    assert target_class.c_name != calling_class.c_name or current_function != setter_name
    var setter = find_or_instantiate_function(target_class, setter_name)
    if setter {
        if setter.parameters.count() == 1 {
            return setter
        }
    }
    return null
}

func deep_copy_code(spite_type: Analysis.SpiteType, code: String): String {
    var class_ref = type_shape.as_class_ref(spite_type)
    if class_ref {
        var copied_class = find_class_by_c_name(class_ref.c_name)
        if copied_class {
            if not copied_class.is_singleton {
                return "{ensure_class_deep_copy(copied_class)}({code})"
            }
        }
    }
    var list_type = type_shape.as_list(spite_type)
    if list_type {
        var list_type_element = list_type.get_element()
        return "{ensure_list_deep_copy(list_type_element)}({code})"
    }
    var dictionary_type = type_shape.as_dictionary(spite_type)
    if dictionary_type {
        var dictionary_type_element = dictionary_type.get_element()
        return "{ensure_dictionary_deep_copy(dictionary_type_element)}({code})"
    }
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        var nullable_inner = nullable.get_inner()
        if type_is_reference(nullable_inner) {
            return deep_copy_code(nullable_inner, code)
        }
        return code
    }
    if type_needs_drop(spite_type) {
        return retain_call(spite_type, code)
    }
    return code
}

func ensure_class_deep_copy(information: Analysis.ClassInfo): String {
    var function_c_name = "{information.c_name}___deep_copy"
    if deep_copy_names.contains(function_c_name) {
        return function_c_name
    }
    deep_copy_names.append(function_c_name)
    builder.add_prototype("{information.c_name}* {function_c_name}({information.c_name}* self);")
    var lines = List<String>()
    lines.append("{information.c_name}* {function_c_name}({information.c_name}* self) \{")
    lines.append("if (self == 0) return 0;")
    if information.is_singleton {
        lines.append("return {information.c_name}___retain(self);")
        lines.append("}")
        var joined_singleton_lines = lines.join("\n")
        builder.add_support(joined_singleton_lines)
        return function_c_name
    }
    lines.append("{information.c_name}* copied = {information.c_name}___allocate();")
    var index = 0
    while index < information.fields.count() {
        var field = information.fields[index]
        var target = "copied->{c_value_name(field.name)}"
        var field_type = field.get_type()
        var release_line = release_statement(field_type, target)
        lines.append(release_line)
        lines.append("{target} = {deep_copy_code(field_type, "self->{c_value_name(field.name)}")};")
        index = index + 1
    }
    lines.append("return copied;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    return function_c_name
}

func ensure_list_deep_copy(element: Analysis.SpiteType): String {
    var list_name = ensure_list(element)
    var function_c_name = "{list_name}___deep_copy"
    if deep_copy_names.contains(function_c_name) {
        return function_c_name
    }
    deep_copy_names.append(function_c_name)
    builder.add_prototype("{list_name}* {function_c_name}({list_name}* self);")
    var item_code = list_item_code(element, "self", "spite_index")
    builder.add_support(
        "{list_name}* {function_c_name}({list_name}* self) \{\nif (self == 0) return 0;\n{list_name}* copied = {list_name}___make();\nfor (int64_t spite_index = 0; spite_index < self->item_count_; spite_index = spite_index + 1) \{ {list_name}_append(copied, {deep_copy_code(element, item_code)}); }\nreturn copied;\n}",
    )
    return function_c_name
}

func ensure_dictionary_deep_copy(element: Analysis.SpiteType): String {
    var dictionary_name = ensure_dictionary(element)
    var function_c_name = "{dictionary_name}___deep_copy"
    if deep_copy_names.contains(function_c_name) {
        return function_c_name
    }
    deep_copy_names.append(function_c_name)
    builder.add_prototype("{dictionary_name}* {function_c_name}({dictionary_name}* self);")
    var string_spite_type = string_type()
    var item_code = list_item_code(element, "self->entry_values_", "spite_index")
    builder.add_support(
        "{dictionary_name}* {function_c_name}({dictionary_name}* self) \{\nif (self == 0) return 0;\n{dictionary_name}* copied = {dictionary_name}___make();\nfor (int64_t spite_index = 0; spite_index < self->entry_keys_->item_count_; spite_index = spite_index + 1) \{ {dictionary_name}_set(copied, SpiteString___retain({list_item_code(string_spite_type, "self->entry_keys_", "spite_index")}), {deep_copy_code(element, item_code)}); }\nreturn copied;\n}",
    )
    return function_c_name
}

func generate_list_literal(
    literal: Syntax.Expressions.ListLiteralExpression,
    element: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var list_name = ensure_list(element)
    var temporary = next_temporary()
    var lines = List<String>()
    lines.append("{list_name}* {temporary} = {list_name}___make();")
    var index = 0
    while index < literal.elements.count() {
        var element_ast = literal.elements[index].value
        crash element_ast
        lines.append(
            "{list_name}_append({temporary}, {coerce_for_store(element_ast, element, scope, class_information)});",
        )
        index = index + 1
    }
    lines.append("{temporary};")
    var list_type = list_type_of(element)
    return ExpressionResult("(\{ {lines.join(" ")} })", list_type)
}

func generate_untyped_list_literal(
    literal: Syntax.Expressions.ListLiteralExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if literal.elements.is_empty() {
        report("an empty list literal needs a declared type")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash literal.elements[0].value
    var saved_counter = temporary_counter
    var probe = generate_expression(literal.elements[0].value, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    return generate_list_literal(literal, probe_type, scope, class_information)
}

func generate_generic_constructor(
    generic_call: Syntax.Expressions.GenericCallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash generic_call.callee
    if generic_call.names_class {
        report(
            "a generic class written without '(...)' names the class, which only the right side of '==' or '!=' reads: call it to make one",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var callee = shape.as_identifier(generic_call.callee)
    if callee {
        if callee.name == "Dictionary" and generic_call.type_arguments.count() == 1 {
            var dictionary_element = resolve_generic_argument(
                generic_call.type_arguments[0],
                class_information.qualified_dotted,
            )
            if dictionary_element {
                var dictionary_type = dictionary_type_of(dictionary_element)
                return ExpressionResult("{ensure_dictionary(dictionary_element)}___make()", dictionary_type)
            }
        }
        if callee.name == "List" and generic_call.type_arguments.count() == 1 {
            var element = resolve_generic_argument(generic_call.type_arguments[0], class_information.qualified_dotted)
            if element {
                var list_type = list_type_of(element)
                return ExpressionResult("{ensure_list(element)}___make()", list_type)
            }
        }
    }
    var generic_template = try_resolve_static_path(generic_call.callee, class_information.qualified_dotted)
    if generic_template {
        if generic_template.is_generic_template {
            var generic_class = instantiate_generic(
                generic_template,
                generic_call.type_arguments,
                class_information.qualified_dotted,
            )
            if generic_class {
                return generate_constructor_call(generic_class, generic_call.arguments, scope, class_information)
            }
            poison_statement()
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
        report(
            "'{generic_template.simple_name}' takes no codegen values: write '{generic_template.simple_name}(...)' without '<...>'",
        )
        poison_statement()
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var printer = Syntax.SourcePrinter()
    var callee_text = printer.source_expression(generic_call.callee)
    if reported_old_spelling(callee_text) {
        poison_statement()
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    report(
        "there is no generic class '{callee_text}' here: a name is looked up in this class's own namespace, its folder, each parent folder, then the whole program",
    )
    poison_statement()
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func poison_statement() {
    statement_poisoned = true
}

func poisoned_key(name: String): String {
    return "{current_path}:{current_owner}.{current_function}:{name}"
}

func mentions_poisoned(statement: Syntax.Statements.Statement, names: List<String>): Boolean {
    if not poisoned_names.is_empty() {
        collect_statement_head_names(statement, names)
    }
    var index = 0
    while index < names.count() {
        var key = poisoned_key(names[index])
        if poisoned_names.contains(key) {
            return true
        }
        index = index + 1
    }
    return false
}

func collect_statement_head_names(statement: Syntax.Statements.Statement, names: List<String>) {
    switch statement {
        Syntax.Statements.IfStatement: collect_optional_names(statement.condition, names)
        Syntax.Statements.WhileStatement: collect_optional_names(statement.condition, names)
        Syntax.Statements.SwitchStatement: collect_optional_names(statement.subject, names)
        _: collect_statement_names(statement, names)
    }
}

func generate_index_read(
    index_expression: Syntax.Expressions.IndexExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash index_expression.object
    crash index_expression.index
    if is_bound_member_index(index_expression) {
        return generate_bound_member_read(index_expression, scope, class_information)
    }
    if is_bound_attributes_index(index_expression) {
        crash bound_field_type
        mark_bound_attribute_read(class_information)
        return ExpressionResult("self->{c_value_name(bound_field_name)}", bound_field_type)
    }
    var read_path = operand_text(index_expression)
    var proven = not read_path.is_empty() and scope.is_path_narrowed(read_path)
    var object_result = generate_expression(index_expression.object, scope, class_information)
    var arguments_ast = List<Syntax.Expressions.Expression>()
    arguments_ast.append(index_expression.index)
    var object_result_type = object_result.get_type()
    var object_list = type_shape.as_list(object_result_type)
    if object_list {
        var element = object_list.get_element()
        if proven {
            var list_function_name = list_function(element, "get_at")
            var integer_spite_type = integer_type()
            var single_types = one_type(integer_spite_type)
            return generate_generic_call(
                list_function_name,
                object_result,
                index_expression.object,
                arguments_ast,
                single_types,
                element,
                scope,
                class_information,
            )
        }
        var list_function_name = list_function(element, "find_at")
        var integer_spite_type = integer_type()
        var single_types = one_type(integer_spite_type)
        var nullable_type = nullable_type_of(element)
        return generate_generic_call(
            list_function_name,
            object_result,
            index_expression.object,
            arguments_ast,
            single_types,
            nullable_type,
            scope,
            class_information,
        )
    }
    var indexed_class_ref = type_shape.as_class_ref(object_result_type)
    if indexed_class_ref {
        var indexed_class = find_class_by_c_name(indexed_class_ref.c_name)
        if indexed_class {
            var get_at = find_or_instantiate_function(indexed_class, "get_at")
            if get_at {
                var parameter_types = parameter_types_of(get_at.parameters)
                var get_at_return_type = get_at.get_return_type()
                var got = generate_generic_call(
                    get_at.c_name,
                    object_result,
                    index_expression.object,
                    arguments_ast,
                    parameter_types,
                    get_at_return_type,
                    scope,
                    class_information,
                )
                got.owning_override = true
                return got
            }
            report("indexing a '{indexed_class.simple_name}' needs it to define 'get_at(index)'")
            return ExpressionResult("0", Analysis.Types.VoidType())
        }
    }
    var object_dictionary = type_shape.as_dictionary(object_result_type)
    if object_dictionary {
        var value_type = object_dictionary.get_element()
        var string_spite_type = string_type()
        var single_types = one_type(string_spite_type)
        var nullable_type = nullable_type_of(value_type)
        var lookup = generate_generic_call(
            "{ensure_dictionary(value_type)}_get",
            object_result,
            index_expression.object,
            arguments_ast,
            single_types,
            nullable_type,
            scope,
            class_information,
        )
        if not proven {
            return lookup
        }
        var lookup_temporary = next_temporary()
        nullable_type = nullable_type_of(value_type)
        var lookup_declaration = "{c_type_name(nullable_type)} {lookup_temporary} = {lookup.code};"
        if type_is_reference(value_type) {
            return ExpressionResult(
                "(\{ {lookup_declaration} {lookup_temporary} != 0 ? {lookup_temporary} : {default_value_for_type(value_type)}; })",
                value_type,
            )
        }
        return ExpressionResult(
            "(\{ {lookup_declaration} {lookup_temporary}.has_value ? {lookup_temporary}.value : {default_value_for_type(value_type)}; })",
            value_type,
        )
    }
    if type_shape.as_string(object_result_type) {
        report(
            "text is not indexed with [ ]: 'text.character_at(index)' gives one character and 'text.slice(start, end)' gives a piece",
        )
    } else {
        report(
            "{type_with_article(object_result_type)} is not indexed with [ ]: only a List<T> and a Dictionary<T> are",
        )
    }
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func ensure_list(element: Analysis.SpiteType): String {
    var list_name = "List_{type_label(element)}"
    if list_names.contains(list_name) {
        return list_name
    }
    list_names.append(list_name)
    var list_template = find_class_by_qualified("List")
    if not list_template {
        report("List needs the standard library: library/list.spite was not found from the working directory")
        return list_name
    }
    crash list_template
    var list_class = instantiated_container(list_template, element, list_name)
    supply_list_functions(list_class, element)
    return list_name
}

func instantiated_container(
    template: Analysis.ClassInfo,
    element: Analysis.SpiteType,
    label: String,
): Analysis.ClassInfo {
    var types = List<Analysis.SpiteType>()
    types.append(element)
    var codes = List<String>()
    codes.append("")
    var texts = List<String>()
    texts.append("")
    var container = instantiated_with(template, types, codes, texts, label)
    container.is_container = true
    return container
}

func list_class_of(element: Analysis.SpiteType): Analysis.ClassInfo {
    var ensured_list = ensure_list(element)
    var list_class = find_class_by_c_name(ensured_list)
    crash list_class
    return list_class
}

func list_function(element: Analysis.SpiteType, name: String): String {
    var function = list_class_of(element).find_function(name)
    crash function
    return function.c_name
}

func list_item_code(element: Analysis.SpiteType, list_code: String, index_code: String): String {
    return "(({c_type_name(element)}*)(intptr_t)({list_code})->items_)[{index_code}]"
}

func supply_list_functions(list_class: Analysis.ClassInfo, element: Analysis.SpiteType) {
    var comparable = type_shape.as_string(element) or type_shape.is_symbol(element) or is_enum_type(element) or type_shape.as_scalar(element)
    var kept = List<Analysis.FunctionInfo>()
    var index = 0
    while index < list_class.functions.count() {
        var function = list_class.functions[index]
        var unsupported = function.name == "contains" and not comparable or function.name == "join" and not joins_as_text(element)
        if not unsupported {
            kept.append(function)
        }
        index = index + 1
    }
    list_class.functions = kept
}

func supply_concurrency_functions(instance: Analysis.ClassInfo) {
    builder.threads = true
    if instance.qualified_dotted == "Parallel" {
        parallel_used = true
    }
    if instance.qualified_dotted == "Concurrent" {
        if not scheduler_used {
            builder.add_typedef(
                "typedef struct SpiteFrame \{ bool (*step)(void*); int32_t state; int32_t flags; } SpiteFrame;",
            )
            builder.add_typedef(
                "#define SPITE_SUSPEND(point) do \{ spite_frame->spite_head.state = (point); return false; } while (0)",
            )
        }
        scheduler_used = true
    }
}

func ensure_dictionary(element: Analysis.SpiteType): String {
    var dictionary_name = "Dictionary_{type_label(element)}"
    if dictionary_names.contains(dictionary_name) {
        return dictionary_name
    }
    dictionary_names.append(dictionary_name)
    var dictionary_template = find_class_by_qualified("Dictionary")
    if not dictionary_template {
        report(
            "Dictionary needs the standard library: library/dictionary.spite was not found from the working directory",
        )
        return dictionary_name
    }
    crash dictionary_template
    instantiated_container(dictionary_template, element, dictionary_name)
    return dictionary_name
}

func dictionary_type_of(element: Analysis.SpiteType): Analysis.SpiteType {
    var resolved: Analysis.SpiteType = Analysis.Types.DictionaryType(element)
    return resolved
}

func nullable_type_of(inner: Analysis.SpiteType): Analysis.SpiteType {
    if type_shape.as_nullable(inner) {
        return inner
    }
    var resolved: Analysis.SpiteType = Analysis.Types.NullableType(inner)
    return resolved
}

func generate_dictionary_method(
    element: Analysis.SpiteType,
    name: String,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var dictionary_name = ensure_dictionary(element)
    if is_function_form(name, arguments_ast) {
        var empty_types = no_types()
        var list_type = list_type_of(element)
        var no_arguments = List<Syntax.Expressions.Expression>()
        var form_values = generate_generic_call(
            "{dictionary_name}_values",
            object_result,
            object_ast,
            no_arguments,
            empty_types,
            list_type,
            scope,
            class_information,
        )
        form_values.owning_override = true
        var form_list = list_class_of(element)
        var form_argument = arguments_ast.first()
        return generate_function_form(
            form_list,
            element,
            name,
            form_values,
            object_ast,
            form_argument,
            scope,
            class_information,
        )
    }
    if name == "set" {
        var string_spite_type = string_type()
        var pair_types = two_types(string_spite_type, element)
        var void_spite_type = void_type()
        return generate_generic_call(
            "{dictionary_name}_set",
            object_result,
            object_ast,
            arguments_ast,
            pair_types,
            void_spite_type,
            scope,
            class_information,
        )
    }
    if name == "get" {
        var string_spite_type = string_type()
        var single_types = one_type(string_spite_type)
        var nullable_type = nullable_type_of(element)
        return generate_generic_call(
            "{dictionary_name}_get",
            object_result,
            object_ast,
            arguments_ast,
            single_types,
            nullable_type,
            scope,
            class_information,
        )
    }
    if name == "deep_copy" {
        var ensured_dictionary_deep_copy = ensure_dictionary_deep_copy(element)
        var empty_types = no_types()
        var dictionary_type = dictionary_type_of(element)
        var copied_dictionary = generate_generic_call(
            ensured_dictionary_deep_copy,
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            dictionary_type,
            scope,
            class_information,
        )
        copied_dictionary.owning_override = true
        return copied_dictionary
    }
    if name == "copy" {
        var empty_types = no_types()
        var dictionary_type = dictionary_type_of(element)
        var shared_dictionary = generate_generic_call(
            "{dictionary_name}_copy",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            dictionary_type,
            scope,
            class_information,
        )
        shared_dictionary.owning_override = true
        return shared_dictionary
    }
    if name == "has" {
        var string_spite_type = string_type()
        var single_types = one_type(string_spite_type)
        var boolean_spite_type = boolean_type()
        return generate_generic_call(
            "{dictionary_name}_has",
            object_result,
            object_ast,
            arguments_ast,
            single_types,
            boolean_spite_type,
            scope,
            class_information,
        )
    }
    if name == "remove" {
        var string_spite_type = string_type()
        var single_types = one_type(string_spite_type)
        var void_spite_type = void_type()
        return generate_generic_call(
            "{dictionary_name}_remove",
            object_result,
            object_ast,
            arguments_ast,
            single_types,
            void_spite_type,
            scope,
            class_information,
        )
    }
    if name == "count" {
        var empty_types = no_types()
        var integer_spite_type = integer_type()
        var counted = generate_generic_call(
            "{dictionary_name}_count",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            integer_spite_type,
            scope,
            class_information,
        )
        integer_spite_type = integer_type()
        return ExpressionResult("((int32_t)({counted.code}))", integer_spite_type)
    }
    if name == "keys" {
        var empty_types = no_types()
        var string_spite_type = string_type()
        var list_type = list_type_of(string_spite_type)
        return generate_generic_call(
            "{dictionary_name}_keys",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            list_type,
            scope,
            class_information,
        )
    }
    if name == "values" {
        var empty_types = no_types()
        var list_type = list_type_of(element)
        return generate_generic_call(
            "{dictionary_name}_values",
            object_result,
            object_ast,
            arguments_ast,
            empty_types,
            list_type,
            scope,
            class_information,
        )
    }
    var list_class = list_class_of(element)
    var template = element_template_of(list_class, name)
    if not template {
        report("Dictionary has no method '{name}'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash template
    var function = instantiate_element_template(list_class, element, template, name, class_information)
    if not function {
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash function
    var empty_types = no_types()
    var list_type = list_type_of(element)
    var no_arguments = List<Syntax.Expressions.Expression>()
    var values_call = generate_generic_call(
        "{dictionary_name}_values",
        object_result,
        object_ast,
        no_arguments,
        empty_types,
        list_type,
        scope,
        class_information,
    )
    values_call.owning_override = true
    var parameter_types = parameter_types_of(function.parameters)
    var function_return_type = function.get_return_type()
    return generate_generic_call(
        function.c_name,
        values_call,
        object_ast,
        arguments_ast,
        parameter_types,
        function_return_type,
        scope,
        class_information,
    )
}

func release_statement(spite_type: Analysis.SpiteType, code: String): String {
    if type_needs_drop(spite_type) {
        return "{release_call(spite_type, code)};"
    }
    return ""
}

func joins_as_text(element: Analysis.SpiteType): Boolean {
    return type_shape.as_string(element) or type_shape.is_symbol(element) or type_shape.as_scalar(element) or is_enum_type(element)
}

func crash_operand_statement(
    expression_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var generated_expression = generate_expression(expression_ast, scope, class_information)
    var result = as_text(generated_expression)
    var result_type = result.get_type()
    var temporary = next_temporary()
    var written = "fwrite((const char*)(intptr_t){temporary}->_bytes_, 1, (size_t){temporary}->_length_, stderr);"
    if type_shape.as_string(result_type) {
        var release_line = ""
        if owns(result, expression_ast) {
            release_line = " SpiteString___release({temporary});"
        }
        return "\{ SpiteString* {temporary} = {result.code}; {written}{release_line} }"
    }
    var converted = string_conversion(result.code, result_type)
    return "\{ SpiteString* {temporary} = {converted}; {written} SpiteString___release({temporary}); }"
}

func collect_static_segments(expression: Syntax.Expressions.Expression, out: List<String>): Boolean {
    var identifier = shape.as_identifier(expression)
    if identifier {
        out.append(identifier.name)
        return true
    }
    var member = shape.as_member(expression)
    if member {
        crash member.object
        var ok = collect_static_segments(member.object, out)
        assert ok
        out.append(member.name)
        return true
    }
    return false
}

func try_resolve_static_path(
    expression: Syntax.Expressions.Expression,
    current_namespace: String,
): Analysis.ClassInfo? {
    var segments = List<String>()
    var ok = collect_static_segments(expression, segments)
    assert ok
    var joined = segments.join(".")
    return find_class(joined, current_namespace)
}

func generate_member_object(
    object_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var static_class = try_resolve_static_path(object_ast, class_information.qualified_dotted)
    if static_class {
        var class_type = class_type_of(static_class)
        var class_object_code = class_object_call(class_type)
        var class_object_type = spite_class_type()
        var class_object = ExpressionResult(class_object_code, class_object_type)
        class_object.owning_override = true
        return class_object
    }
    var codegen_class = codegen_class_object(object_ast, class_information)
    if codegen_class {
        return codegen_class
    }
    return generate_expression(object_ast, scope, class_information)
}

func codegen_class_object(
    object_ast: Syntax.Expressions.Expression,
    class_information: Analysis.ClassInfo,
): ExpressionResult? {
    var generic_identifier = shape.as_generic_identifier(object_ast)
    assert generic_identifier
    var bare_name = without_dollar(generic_identifier.name)
    var bound = codegen_index(class_information, bare_name)
    assert bound >= 0
    crash class_information.codegen_codes[bound]
    assert class_information.codegen_codes[bound].is_empty()
    crash class_information.codegen_types[bound]
    var class_object_code = class_object_call(class_information.codegen_types[bound])
    var class_object_type = spite_class_type()
    var class_object = ExpressionResult(class_object_code, class_object_type)
    class_object.owning_override = true
    return class_object
}

func as_text(result: ExpressionResult): ExpressionResult {
    var result_type = result.get_type()
    if not type_shape.is_symbol(result_type) {
        return result
    }
    var string_spite_type = string_type()
    var text = ExpressionResult(result.code, string_spite_type)
    text.owning_override = result.owning_override
    return text
}

func ensure_symbol(name: String): String {
    if symbol_positions.has(name) {
        crash symbol_positions[name]
        return "(&spite_symbol_{symbol_positions[name]})"
    }
    var position = symbol_names.count()
    symbol_names.append(name)
    symbol_positions[name] = position
    builder.add_typedef(
        "static SpiteString spite_symbol_{position} = SPITE_STATIC_STRING(\"{escape_c_string(name)}\", {name.length()});",
    )
    constant_texts["(&spite_symbol_{position})"] = name
    return "(&spite_symbol_{position})"
}

func generate_symbol_lookup(
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if arguments_ast.count() != 1 {
        report("Symbol(text) takes the text to look up, and nothing else")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    if not symbol_lookup_used {
        builder.add_prototype("SpiteString* spite_symbol_find(SpiteString* text);")
    }
    symbol_lookup_used = true
    var string_spite_type = string_type()
    var single_types = one_type(string_spite_type)
    var text_code = generate_argument_list(arguments_ast, single_types, scope, class_information)
    crash text_code.count() == 1
    var nullable_type = nullable_type_of(Analysis.Types.SymbolType())
    var found = ExpressionResult("spite_symbol_find({text_code[0]})", nullable_type)
    return found
}

func emit_symbol_table() {
    assert symbol_lookup_used
    var entries = List<String>()
    var index = 0
    while index < symbol_names.count() {
        entries.append("&spite_symbol_{index}")
        index = index + 1
    }
    entries.append("0")
    builder.add_support(
        "static SpiteString* spite_symbol_table[] = \{ {entries.join(", ")} };\nSpiteString* spite_symbol_find(SpiteString* text) \{\nSpiteString* found = 0;\nfor (int64_t index = 0; spite_symbol_table[index] != 0; index = index + 1) \{\nif (SpiteString_equals(text, spite_symbol_table[index])) \{ found = spite_symbol_table[index]; break; }\n}\nSpiteString___release(text);\nreturn found;\n}",
    )
}

func generate_library_constructor(arguments_ast: List<Syntax.Expressions.Expression>): ExpressionResult {
    var shape_of_call = "DynamicLibrary(...) takes three literals the compiler reads while it compiles: the file, the naming rule ('identity', 'windows' or 'camel_case') and the header"
    if arguments_ast.count() != 3 {
        report(shape_of_call)
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var file = shape.as_string_literal(arguments_ast[0])
    var naming = shape.as_enum_literal(arguments_ast[1])
    var header = shape.as_string_literal(arguments_ast[2])
    if not file or not naming or not header {
        report(shape_of_call)
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash file
    crash naming
    crash header
    var file_segments = file.value.replace("\\", "/").split("/")
    var file_leaf = file_segments.last()
    crash file_leaf
    if not file_leaf.contains(".") {
        report(
            "'{file.value}' has no extension: name the library file exactly as it is on disk, like \"user32.dll\" or \"libc.so.6\" -- a wrapper for another platform names that platform's file",
        )
    }
    if naming.value != "identity" and naming.value != "windows" and naming.value != "camel_case" {
        report(
            "'{naming.value}' is not a naming rule: a library's functions are named 'identity', 'windows' or 'camel_case'",
        )
    }
    var library = 0
    while library < foreign_library_files.count() {
        crash library < foreign_library_namings.count()
        crash library < foreign_library_headers.count()
        var same_file = foreign_library_files[library] == file.value
        if same_file and foreign_library_namings[library] == naming.value and foreign_library_headers[library] == header.value {
            return library_value(library)
        }
        library = library + 1
    }
    foreign_library_files.append(file.value)
    foreign_library_namings.append(naming.value)
    foreign_library_headers.append(header.value)
    var accessor = "spite_foreign_library_{library}"
    builder.add_typedef("static DynamicLibrary* {accessor}_cache = 0;")
    builder.add_typedef("static bool {accessor}_tracked = false;")
    builder.add_prototype("DynamicLibrary* {accessor}(void);")
    return library_value(library)
}

func library_value(library: Integer): ExpressionResult {
    var library_type = Analysis.Types.ClassRefType("DynamicLibrary")
    library_type.foreign_library = library
    var value = ExpressionResult("spite_foreign_library_{library}()", library_type)
    value.owning_override = true
    return value
}

func declared_by_dynamic_library(name: String): Boolean {
    var library_class = find_class_by_c_name("DynamicLibrary")
    assert library_class
    var declared = library_class.find_function(name)
    if declared {
        return true
    }
    return false
}

func generate_foreign_call(
    foreign: Analysis.Types.ClassRefType,
    object_result: ExpressionResult,
    object_ast: Syntax.Expressions.Expression,
    member_name: String,
    arguments_ast: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if foreign.foreign_library < 0 {
        report(
            "a foreign function is called through the attribute or variable that holds its DynamicLibrary(...), so the compiler knows which library to bind it in",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var library = foreign.foreign_library
    crash library < foreign_library_namings.count()
    var name = member_name
    var returned: Analysis.SpiteType = integer_type()
    var returned_c = "int32_t"
    if name.ends_with("_as_double") {
        var name_length = name.length()
        name = name.slice(0, name_length - 10)
        returned = Analysis.Types.ScalarType('double_kind')
        returned_c = "double"
    } else if name.ends_with("_as_long") {
        var name_length = name.length()
        name = name.slice(0, name_length - 8)
        returned = Analysis.Types.ScalarType('long_kind')
        returned_c = "int64_t"
    } else if name.ends_with("_as_text") {
        var name_length = name.length()
        name = name.slice(0, name_length - 8)
        returned = string_type()
        returned_c = "const char*"
    }
    var symbol_name = foreign_symbol_name(name, foreign_library_namings[library])
    var pointer = ensure_foreign_symbol(library, symbol_name)
    crash library < foreign_library_headers.count()
    var header = foreign_library_headers[library]
    if not header.is_empty() {
        ensure_foreign_header(header)
    }
    var lines = List<String>()
    var releases = List<String>()
    var afters = List<String>()
    var parameter_types = List<String>()
    parameter_types.append("void")
    var passed = List<String>()
    var index = 0
    while index < arguments_ast.count() {
        var generated_expression = generate_expression(arguments_ast[index], scope, class_information)
        var argument = as_text(generated_expression)
        var argument_type = argument.get_type()
        var scalar = type_shape.as_scalar(argument_type)
        if scalar {
            var crossing = foreign_argument_c_name(scalar.kind)
            parameter_types.append(crossing)
            passed.append("({crossing})({argument.code})")
        } else if is_enum_type(argument_type) {
            parameter_types.append("int64_t")
            passed.append("(int64_t)({argument.code})")
        } else if type_shape.as_string(argument_type) {
            var text = next_temporary()
            lines.append("SpiteString* {text} = {argument.code};")
            if owns(argument, arguments_ast[index]) {
                releases.append("SpiteString___release({text});")
            }
            parameter_types.append("const char*")
            passed.append("(const char*)(intptr_t){text}->_bytes_")
        } else if passes_as_array(argument_type) {
            var held_list = next_temporary()
            lines.append("{c_type_name(argument_type)} {held_list} = {argument.code};")
            if owns(argument, arguments_ast[index]) {
                releases.append("{release_call(argument_type, held_list)};")
            }
            parameter_types.append("void*")
            passed.append("(void*)(intptr_t){held_list}->items_")
        } else if passes_as_struct(argument_type) {
            var passed_union = type_shape.as_union(argument_type)
            crash passed_union
            var shaped = find_union_by_c_name(passed_union.c_name)
            crash shaped
            var held_shape = next_temporary()
            var struct_value = next_temporary()
            lines.append("{passed_union.c_name} {held_shape} = {argument.code};")
            var members = List<String>()
            var initial = List<String>()
            var field_index = 0
            while field_index < shaped.shape_fields.count() {
                var field = shaped.shape_fields[field_index]
                var field_type = shape_field_type(shaped, field.name)
                crash field_type
                members.append("{c_type_name(field_type)} {c_value_name(field.name)};")
                initial.append("{ensure_shape_reader(shaped, field.name, field_type)}({held_shape})")
                afters.append(
                    "{ensure_shape_writer(shaped, field.name, field_type)}({held_shape}, {struct_value}.{c_value_name(field.name)});",
                )
                field_index = field_index + 1
            }
            lines.append("struct \{ {members.join(" ")} } {struct_value} = \{ {initial.join(", ")} };")
            crash library < foreign_library_headers.count()
            if not foreign_library_headers[library].is_empty() and foreign_library_namings[library] == "windows" {
                lines.append(
                    "_Static_assert(sizeof({words_of(shaped.simple_name).join("_").upper_case()}) == sizeof({struct_value}), \"{shaped.simple_name} does not match {words_of(shaped.simple_name).join("_").upper_case()}\");",
                )
            }
            if owns(argument, arguments_ast[index]) {
                releases.append("{passed_union.c_name}___release({held_shape});")
            }
            parameter_types.append("void*")
            passed.append("(void*)&{struct_value}")
        } else {
            report(
                "{type_with_article(argument_type)} cannot cross into C: a foreign function takes numbers, Boolean, enum values, text and a type whose attributes are all numbers",
            )
        }
        index = index + 1
    }
    if parameter_types.count() > 1 {
        parameter_types.remove_at(0)
    }
    if owns(object_result, object_ast) {
        var held = next_temporary()
        lines.append("DynamicLibrary* {held} = {object_result.code};")
        releases.append("DynamicLibrary___release({held});")
    }
    var result = next_temporary()
    if header.is_empty() {
        lines.append(
            "{returned_c} {result} = (({returned_c} (*)({parameter_types.join(", ")})){pointer})({passed.join(", ")});",
        )
    } else {
        var declared_call = declared_foreign_call(symbol_name, pointer, passed, returned_c)
        lines.append("_Pragma(\"GCC diagnostic push\") _Pragma(\"GCC diagnostic ignored \\\"-Wint-conversion\\\"\")")
        lines.append("{returned_c} {result} = {declared_call};")
        lines.append("_Pragma(\"GCC diagnostic pop\")")
    }
    var joined_afters = afters.join(" ")
    lines.append(joined_afters)
    var value = result
    if type_shape.as_string(returned) {
        value = "spite_string_from_cstring_owned({result} != 0 ? {result} : \"\")"
    }
    var called = ExpressionResult(
        "(\{ {lines.join(" ")} {returned_c} spite_foreign_result = {result}; {releases.join(" ")} (void)spite_foreign_result; {value}; })",
        returned,
    )
    called.owning_override = true
    return called
}

func foreign_argument_c_name(kind: Analysis.Types.NumericKind): String {
    if kind == 'float_kind' or kind == 'double_kind' {
        return numeric_c_name(kind)
    }
    if kind == 'byte_kind' or kind == 'unsigned_short_kind' or kind == 'unsigned_integer_kind' or kind == 'unsigned_long_kind' {
        return "uint64_t"
    }
    return "int64_t"
}

func declared_foreign_call(symbol_name: String, pointer: String, passed: List<String>, returned_c: String): String {
    var call = "((__typeof__(&{symbol_name})){pointer})({passed.join(", ")})"
    return "({returned_c})__builtin_choose_expr(__builtin_types_compatible_p(__typeof__({call}), void), ({call}, ({returned_c})0), {call})"
}

func is_reflection_member(name: String): Boolean {
    return name == "class" or name == "attributes" or name == "functions" or name == "memory"
}

func is_own_library_member(name: String): Boolean {
    var library_class = find_class_by_c_name("DynamicLibrary")
    crash library_class
    if library_class.find_field(name) or library_class.find_function(name) {
        return true
    }
    return false
}

func generate_foreign_constant(foreign: Analysis.Types.ClassRefType, name: String): ExpressionResult {
    if foreign.foreign_library < 0 {
        report("a foreign constant is read through the attribute or variable that holds its DynamicLibrary(...)")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash foreign.foreign_library < foreign_library_headers.count()
    var header = foreign_library_headers[foreign.foreign_library]
    if header.is_empty() {
        report(
            "'{name}' is a constant, and a constant comes from the library's header: name it as DynamicLibrary's third argument",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    ensure_foreign_header(header)
    var integer_spite_type = integer_type()
    return ExpressionResult("((int32_t)({name.upper_case()}))", integer_spite_type)
}

func ensure_foreign_header(header: String) {
    assert not foreign_headers_included.contains(header)
    foreign_headers_included.append(header)
    if File(header).exists() {
        builder.add_typedef("#include \"{escape_c_string(header)}\"")
    } else {
        builder.add_typedef("#include <{header}>")
    }
}

func passes_as_array(spite_type: Analysis.SpiteType): Boolean {
    var listed = type_shape.as_list(spite_type)
    if listed {
        var listed_element = listed.get_element()
        if type_shape.as_scalar(listed_element) {
            return true
        }
    }
    return false
}

func passes_as_struct(spite_type: Analysis.SpiteType): Boolean {
    var passed_union = type_shape.as_union(spite_type)
    assert passed_union
    var shaped = find_union_by_c_name(passed_union.c_name)
    assert shaped
    assert shaped.is_shape
    var index = 0
    while index < shaped.shape_fields.count() {
        var field = shaped.shape_fields[index]
        assert not field.is_function
        var field_type = shape_field_type(shaped, field.name)
        assert field_type
        assert type_shape.as_scalar(field_type)
        index = index + 1
    }
    return true
}

func ensure_foreign_symbol(library: Integer, c_name: String): String {
    var index = 0
    while index < foreign_symbol_names.count() {
        crash index < foreign_symbol_libraries.count()
        if foreign_symbol_libraries[index] == library and foreign_symbol_names[index] == c_name {
            return "spite_foreign_{library}_{index}"
        }
        index = index + 1
    }
    var position = foreign_symbol_names.count()
    foreign_symbol_libraries.append(library)
    foreign_symbol_names.append(c_name)
    foreign_symbol_wanted.append("{current_owner}.{current_function}")
    builder.add_typedef("static void* spite_foreign_{library}_{position} = 0;")
    return "spite_foreign_{library}_{position}"
}

func foreign_symbol_name(name: String, naming: String): String {
    if naming == "identity" {
        return name
    }
    var words = name.split("_")
    var text = ""
    var index = 0
    while index < words.count() {
        var word = words[index]
        if naming == "windows" {
            word = abbreviated(word)
        }
        if index == 0 and naming == "camel_case" {
            text = word
        } else {
            var word_length = word.length()
            text = "{text}{word.slice(0, 1).upper_case()}{word.slice(1, word_length)}"
        }
        index = index + 1
    }
    return text
}

func abbreviated(word: String): String {
    var short_words = abbreviated_words()
    var full_words = unabbreviated_words()
    var position = 0
    while position < full_words.count() {
        if full_words[position] == word {
            crash position < short_words.count()
            return short_words[position]
        }
        position = position + 1
    }
    return word
}

func owned_c_text(text: String): String {
    return "spite_string_from_cstring_owned(\"{escape_c_string(text)}\")"
}

func emit_singleton_teardown() {
    builder.add_prototype("bool spite_singleton_tracked(void);")
    builder.add_prototype("void spite_singleton_created(void (*teardown)(void));")
    builder.add_prototype("void spite_singleton_used_after_exit(const char* name);")
    builder.add_prototype("void spite_singletons_destroy(void);")
    var lines = List<String>()
    lines.append("static void (**spite_singleton_teardowns)(void) = 0;")
    lines.append("static int32_t spite_singleton_total = 0;")
    lines.append("static int32_t spite_singleton_capacity = 0;")
    lines.append("static int32_t spite_singleton_list_lock = 0;")
    lines.append("bool spite_singleton_tracked(void) \{")
    if debug_memory {
        lines.append("#ifdef SPITE_DEBUG_MEMORY")
        lines.append("return !spite_allocation_table_busy;")
        lines.append("#else")
        lines.append("return true;")
        lines.append("#endif")
    } else {
        lines.append("return true;")
    }
    lines.append("}")
    lines.append("void spite_singleton_created(void (*teardown)(void)) \{")
    lines.append("if (!spite_singleton_tracked()) return;")
    lines.append("SPITE_LOCK(spite_singleton_list_lock);")
    lines.append("if (spite_singleton_total == spite_singleton_capacity) \{")
    lines.append("spite_singleton_capacity = spite_singleton_capacity == 0 ? 16 : spite_singleton_capacity * 2;")
    lines.append(
        "spite_singleton_teardowns = (void (**)(void))realloc(spite_singleton_teardowns, (size_t)spite_singleton_capacity * sizeof(void (*)(void)));",
    )
    lines.append("}")
    lines.append("spite_singleton_teardowns[spite_singleton_total] = teardown;")
    lines.append("spite_singleton_total = spite_singleton_total + 1;")
    lines.append("SPITE_UNLOCK(spite_singleton_list_lock);")
    lines.append("}")
    lines.append("void spite_singleton_used_after_exit(const char* name) \{")
    lines.append("fflush(stdout);")
    lines.append(
        "fprintf(stderr, \"spite: a drop() at exit used the singleton %s after it was destroyed: singletons are destroyed in reverse order of when they were made, so keep %s in an attribute of the singleton whose drop() uses it\\n\", name, name);",
    )
    lines.append("exit(1);")
    lines.append("}")
    lines.append("void spite_singletons_destroy(void) \{")
    lines.append("fflush(stdout);")
    lines.append("while (spite_singleton_total > 0) \{")
    lines.append("spite_singleton_total = spite_singleton_total - 1;")
    lines.append("spite_singleton_teardowns[spite_singleton_total]();")
    lines.append("}")
    lines.append("free(spite_singleton_teardowns);")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
    builder.add_main("spite_singletons_destroy();")
    var library = foreign_library_files.count()
    while library > 0 {
        library = library - 1
        var cache = "spite_foreign_library_{library}_cache"
        builder.add_main_if_kept(
            "spite_foreign_library_{library}",
            "if (spite_foreign_library_{library}_tracked) DynamicLibrary___destroy({cache});",
        )
    }
}

func emit_foreign_libraries() {
    var library = 0
    while library < foreign_library_files.count() {
        var accessor = "spite_foreign_library_{library}"
        crash library < foreign_library_namings.count()
        crash library < foreign_library_headers.count()
        var lines = List<String>()
        lines.append("static int32_t {accessor}_lock = 0;")
        lines.append("DynamicLibrary* {accessor}(void) \{")
        lines.append("DynamicLibrary* found = SPITE_SINGLETON_FOUND({accessor}_cache);")
        lines.append("if (found != 0) return found;")
        lines.append("SPITE_LOCK({accessor}_lock);")
        lines.append("if ({accessor}_cache == 0) \{")
        lines.append(
            "DynamicLibrary* made = DynamicLibrary___make({owned_c_text(foreign_library_files[library])}, {ensure_symbol(foreign_library_namings[library])}, {owned_c_text(foreign_library_headers[library])});",
        )
        lines.append("{accessor}_tracked = spite_singleton_tracked();")
        lines.append("(void)&DynamicLibrary_find_symbol;")
        var index = 0
        while index < foreign_symbol_names.count() {
            crash index < foreign_symbol_libraries.count()
            crash index < foreign_symbol_wanted.count()
            if foreign_symbol_libraries[index] == library {
                var binding = builder.add_binding(
                    "spite_foreign_{library}_{index}",
                    "spite_foreign_{library}_{index} = (void*)(intptr_t)DynamicLibrary_find_symbol(made, {owned_c_text(foreign_symbol_names[index])}, {owned_c_text(foreign_symbol_wanted[index])});",
                )
                lines.append(binding)
            }
            index = index + 1
        }
        lines.append("SPITE_SINGLETON_PUBLISH({accessor}_cache, made);")
        lines.append("}")
        lines.append("SPITE_UNLOCK({accessor}_lock);")
        lines.append("return {accessor}_cache;")
        lines.append("}")
        var joined_lines = lines.join("\n")
        builder.add_support(joined_lines)
        library = library + 1
    }
}

func generate_call(
    call: Syntax.Expressions.CallExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash call.callee
    var callee_identifier = shape.as_identifier(call.callee)
    if callee_identifier {
        if callee_identifier.name == "load" {
            var loaded_names = List<String>()
            collect_each_mentioned_name(call.arguments, loaded_names)
            mark_names_read(class_information, loaded_names)
            if call.runs_program {
                var program_run = program_run_code()
                return ExpressionResult(program_run, Analysis.Types.VoidType())
            }
            return ExpressionResult("(void)0", Analysis.Types.VoidType())
        }
    }
    var target_class = try_resolve_static_path(call.callee, class_information.qualified_dotted)
    if target_class {
        return generate_constructor_call(target_class, call.arguments, scope, class_information)
    }
    if callee_identifier {
        if callee_identifier.name == "Symbol" {
            return generate_symbol_lookup(call.arguments, scope, class_information)
        }
        if callee_identifier.name == "Arguments" and call.arguments.is_empty() {
            return ExpressionResult("spite_program_arguments", Analysis.Types.ArgumentsType())
        }
    }
    var member = shape.as_member(call.callee)
    if member {
        crash member.object
        if member.name == "has_function" {
            var answered = folded_function_question(call, class_information)
            if answered == true or answered == false {
                var answer_type: Analysis.SpiteType = Analysis.Types.ScalarType('boolean_kind')
                if answered == true {
                    return ExpressionResult("true", answer_type)
                }
                return ExpressionResult("false", answer_type)
            }
        }
        return generate_method_call(member, member.object, call.arguments, scope, class_information)
    }
    var identifier = shape.as_identifier(call.callee)
    if identifier {
        return generate_own_function_call(identifier.name, call.arguments, scope, class_information)
    }
    var held = generate_expression(call.callee, scope, class_information)
    var held_type = held.get_type()
    var held_function = type_shape.as_class_ref(held_type)
    if held_function {
        if held_function.has_signature {
            return call_function_value(held, call.callee, call.arguments, scope, class_information)
        }
    }
    report("unsupported call form")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func generate_member_read(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    var result = generate_member_read_raw(member, scope, class_information)
    var path = operand_text(member)
    if not path.is_empty() {
        var result_type = result.get_type()
        var nullable = type_shape.as_nullable(result_type)
        if nullable {
            if scope.is_path_narrowed(path) {
                var unwrapped_code = result.code
                var nullable_inner = nullable.get_inner()
                if not type_is_reference(nullable_inner) {
                    unwrapped_code = "({result.code}).value"
                }
                var unwrapped = ExpressionResult(unwrapped_code, nullable_inner)
                unwrapped.owning_override = result.owning_override
                return unwrapped
            }
        }
    }
    return result
}

func generate_member_read_raw(
    member: Syntax.Expressions.MemberExpression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    crash member.object
    if member.name == "instances" {
        var named_class = try_resolve_static_path(member.object, class_information.qualified_dotted)
        if named_class {
            if named_class.c_name == "Spite_Class" {
                all_classes_used = true
                var class_type = class_type_of(named_class)
                var every_class_type = list_type_of(class_type)
                builder.add_prototype("{c_type_name(every_class_type)} spite_all_classes(void);")
                var every_class = ExpressionResult("spite_all_classes()", every_class_type)
                every_class.owning_override = true
                return every_class
            }
            if named_class.is_generic_template {
                report("'{named_class.simple_name}.instances' is not available for this class")
                return ExpressionResult("0", Analysis.Types.VoidType())
            }
            var class_type = class_type_of(named_class)
            var list_type = list_type_of(class_type)
            var live = ExpressionResult("{ensure_live_instances(named_class)}()", list_type)
            live.owning_override = true
            return live
        }
    }
    var symbol_identifier = shape.as_identifier(member.object)
    if symbol_identifier {
        if symbol_identifier.name == bound_symbol_name and member.name == "name" and not bound_symbol_name.is_empty() {
            var shown_name = bound_field_name
            if not bound_display_name.is_empty() {
                shown_name = bound_display_name
            }
            var rendered_string_literal = render_string_literal(shown_name)
            var string_spite_type = string_type()
            return ExpressionResult(rendered_string_literal, string_spite_type)
        }
        if symbol_identifier.name == bound_symbol_name and member.name == "value" and not bound_enum_c_name.is_empty() {
            var bound_enum = enums.find_by_c_name(bound_enum_c_name)
            crash bound_enum
            var bound_enum_type = enum_type_of(bound_enum)
            return ExpressionResult("{bound_enum_c_name}_{bound_field_name}", bound_enum_type)
        }
        if symbol_identifier.name == bound_symbol_name and member.name == "class" and not bound_symbol_name.is_empty() {
            crash bound_field_type
            var class_object_code = class_object_call(bound_field_type)
            var class_object_type = spite_class_type()
            return ExpressionResult(class_object_code, class_object_type)
        }
    }
    var object_counter = temporary_counter
    var object_result = generate_member_object(member.object, scope, class_information)
    var object_result_type = object_result.get_type()
    var handle = joinable_handle(object_result_type)
    if handle {
        if forwards_to_result(handle, member.name) {
            rewind_temporaries(object_counter)
            var joined_ast = implicit_join_ast(member.object)
            var forwarded = Syntax.Expressions.MemberExpression(joined_ast, member.name)
            return generate_member_read(forwarded, scope, class_information)
        }
    }
    var foreign = type_shape.as_class_ref(object_result_type)
    if foreign {
        if foreign.c_name == "DynamicLibrary" and not is_reflection_member(member.name) and not is_own_library_member(member.name) {
            return generate_foreign_constant(foreign, member.name)
        }
    }
    if member.name == "namespace" {
        var namespace_receiver = type_shape.as_class_ref(object_result_type)
        if namespace_receiver {
            if namespace_receiver.c_name == "Spite_Class" {
                namespace_read_used = true
            }
        }
    }
    if member.name == "value" {
        var object_receiver = type_shape.as_class_ref(object_result_type)
        if object_receiver {
            var read_by_the_loop = class_information.qualified_dotted == "ReadEvaluatePrintLoop"
            if object_receiver.c_name == "Spite_Attribute" and (read_evaluate_print_loop or not read_by_the_loop) {
                attribute_object_used = true
            }
        }
    }
    if member.name == "classes" or member.name == "namespaces" {
        var tree_receiver = type_shape.as_class_ref(object_result_type)
        if tree_receiver {
            if tree_receiver.c_name == "Spite_Namespace" {
                namespace_tree_used = true
            }
        }
    }
    if member.name == "memory" {
        var memory_read = generate_memory_read(object_result, member.object)
        if memory_read {
            return memory_read
        }
    }
    var reflection = generate_reflection_read(member.name, object_result, member.object)
    if reflection {
        return reflection
    }
    if type_shape.is_arguments(object_result_type) {
        var string_spite_type = string_type()
        var nullable_type = nullable_type_of(string_spite_type)
        var lookup_result = ExpressionResult(
            "SpiteArguments_lookup(&({object_result.code}), \"{member.name}\")",
            nullable_type,
        )
        lookup_result.owning_override = true
        return lookup_result
    }
    var read_union = type_shape.as_union(object_result_type)
    if read_union {
        var read_union_information = find_union_by_c_name(read_union.c_name)
        crash read_union_information
        var no_arguments = List<Syntax.Expressions.Expression>()
        return generate_union_dispatch(
            read_union_information,
            member.name,
            false,
            object_result,
            member.object,
            no_arguments,
            scope,
            class_information,
        )
    }
    if type_shape.as_string(object_result_type) {
        var string_field = string_storage_read(member.name, object_result, member.object, class_information)
        if string_field {
            return string_field
        }
    }
    var object_class_ref = type_shape.as_class_ref(object_result_type)
    if not object_class_ref {
        switch object_result_type {
            Analysis.Types.NullableType: {
                report(
                    "this value may be null (it is {type_with_article(object_result_type)}), so '{member.name}' cannot be read from it yet: narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
                )
            }
            Analysis.Types.VoidType: report("'{member.name}' cannot be read from this value")
            _: {
                report(
                    "'{member.name}' cannot be read from {type_with_article(object_result_type)}: if it is a function, call it with '{member.name}()'",
                )
            }
        }
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash object_class_ref
    var target_class = find_class_by_c_name(object_class_ref.c_name)
    crash target_class
    report_private_member(target_class, member.name, class_information)
    mark_attribute_read(target_class, member.name)
    var getter = find_getter(target_class, member.name, class_information)
    if getter {
        var empty_types = no_types()
        var getter_return_type = getter.get_return_type()
        var getter_arguments = List<Syntax.Expressions.Expression>()
        var getter_call = generate_generic_call(
            getter.c_name,
            object_result,
            member.object,
            getter_arguments,
            empty_types,
            getter_return_type,
            scope,
            class_information,
        )
        getter_call.owning_override = true
        return getter_call
    }
    var field = target_class.find_field(member.name)
    if not field {
        var found_function = find_or_instantiate_function(target_class, member.name)
        if found_function {
            if not found_function.is_constructor {
                return function_value(target_class, found_function, object_result, member.object)
            }
        }
        report("'{type_display_name(object_result_type)}' has no attribute '{member.name}'")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    crash field
    var hardcoded = hardcoded_setting(target_class, member.name)
    if hardcoded {
        return hardcoded_setting_value(hardcoded, scope, class_information)
    }
    var peeked_field_type = field.get_type()
    var scalar_default = not type_needs_drop(peeked_field_type) and constant_scalar_code(field.default_value_code)
    if object_result.peek_union and scalar_default {
        var peeked = peeked_code(object_result)
        var peeked_temporary = next_temporary()
        var peeked_read = "(\{ {c_type_name(object_result_type)} {peeked_temporary} = {peeked}; {peeked_temporary} != 0 ? ({peeked_temporary})->{c_value_name(member.name)} : ({field.default_value_code}); })"
        return ExpressionResult(peeked_read, peeked_field_type)
    }
    if owns(object_result, member.object) {
        var object_temporary = next_temporary()
        var field_temporary = next_temporary()
        var lines = List<String>()
        lines.append("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
        var field_code = "({object_temporary})->{c_value_name(member.name)}"
        var field_type = field.get_type()
        if type_needs_drop(field_type) {
            field_code = retain_call(field_type, field_code)
        }
        lines.append("{c_type_name(field_type)} {field_temporary} = {field_code};")
        lines.append("{release_call(object_result_type, object_temporary)};")
        lines.append("{field_temporary};")
        var owned_read = ExpressionResult("(\{ {lines.join(" ")} })", field_type)
        owned_read.owning_override = true
        return owned_read
    }
    var field_type = field.get_type()
    var alias_read = ExpressionResult("({object_result.code})->{c_value_name(member.name)}", field_type)
    alias_read.owning_override = false
    return alias_read
}

func generate_expression(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): ExpressionResult {
    if shape.is_true_literal(expression) {
        return ExpressionResult("true", Analysis.Types.ScalarType('boolean_kind'))
    }
    if shape.is_false_literal(expression) {
        return ExpressionResult("false", Analysis.Types.ScalarType('boolean_kind'))
    }
    var integer_literal = shape.as_integer_literal(expression)
    if integer_literal {
        return generate_integer_literal(integer_literal)
    }
    var float_literal = shape.as_float_literal(expression)
    if float_literal {
        var literal_code = "{float_literal.value}"
        if not literal_code.contains(".") and not literal_code.contains("e") {
            literal_code = "{literal_code}.0"
        }
        return ExpressionResult(literal_code, Analysis.Types.ScalarType('float_kind'))
    }
    var string_literal = shape.as_string_literal(expression)
    if string_literal {
        var rendered_string_literal = render_string_literal(string_literal.value)
        return ExpressionResult(rendered_string_literal, Analysis.Types.StringType())
    }
    var identifier = shape.as_identifier(expression)
    if identifier {
        return generate_identifier(identifier, scope, class_information)
    }
    var generic_identifier = shape.as_generic_identifier(expression)
    if generic_identifier {
        var bare_name = without_dollar(generic_identifier.name)
        return generate_codegen_value(bare_name, class_information)
    }
    var enum_literal = shape.as_enum_literal(expression)
    if enum_literal {
        var only_enum = find_enum_with_value(enum_literal.value)
        if only_enum {
            var enum_type = enum_type_of(only_enum)
            return ExpressionResult("{only_enum.c_name}_{enum_literal.value}", enum_type)
        }
        report("cannot tell which enum '{enum_literal.value}' belongs to here")
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    var list_literal = shape.as_list_literal(expression)
    if list_literal {
        return generate_untyped_list_literal(list_literal, scope, class_information)
    }
    var object_literal = shape.as_object_literal(expression)
    if object_literal {
        return generate_object_literal(object_literal, scope, class_information)
    }
    var generic_call = shape.as_generic_call(expression)
    if generic_call {
        var constructed = generate_generic_constructor(generic_call, scope, class_information)
        pending_calls.append(expression)
        pending_call_lines.append(current_line)
        return constructed
    }
    var index_expression = shape.as_index(expression)
    if index_expression {
        return generate_index_read(index_expression, scope, class_information)
    }
    var unary = shape.as_unary(expression)
    if unary {
        return generate_unary(unary, scope, class_information)
    }
    var binary = shape.as_binary(expression)
    if binary {
        return generate_binary(binary, scope, class_information)
    }
    var call = shape.as_call(expression)
    if call {
        var called = generate_call(call, scope, class_information)
        pending_calls.append(expression)
        pending_call_lines.append(current_line)
        return called
    }
    var member = shape.as_member(expression)
    if member {
        return generate_member_read(member, scope, class_information)
    }
    if shape.is_null_literal(expression) {
        report(
            "'null' is not a value to compare against or pass around: narrow the value instead, with 'if value \{ } else \{ }', 'assert value', 'crash value' or 'switch value \{ <Type>: ... Null: ... }'",
        )
        return ExpressionResult("0", Analysis.Types.VoidType())
    }
    report("unsupported expression kind in this stage")
    return ExpressionResult("0", Analysis.Types.VoidType())
}

func undo_proofs_after_calls(scope: Scope, class_information: Analysis.ClassInfo) {
    assert not pending_calls.is_empty()
    var calls = pending_calls
    var lines = pending_call_lines
    pending_calls = List<Syntax.Expressions.Expression>()
    pending_call_lines = List<Integer>()
    var saved_line = current_line
    var index = 0
    while index < calls.count() {
        crash lines[index]
        current_line = lines[index]
        undo_after_call(calls[index], scope, class_information)
        index = index + 1
    }
    current_line = saved_line
}

func undo_after_call(called: Syntax.Expressions.Expression, scope: Scope, class_information: Analysis.ClassInfo) {
    var call = shape.as_call(called)
    if call {
        crash call.callee
        undo_proofs_after_call(call.callee, call.arguments, scope, class_information)
        return
    }
    var construction = shape.as_generic_call(called)
    crash construction
    crash construction.callee
    undo_proofs_after_call(construction.callee, construction.arguments, scope, class_information)
}

func undo_proofs_after_call(
    callee: Syntax.Expressions.Expression,
    arguments: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert scope.holds_proofs()
    var effects = called_effects(callee, scope, class_information)
    assert not effects.is_empty()
    var crossed = List<String>()
    var paths = scope.visible_narrowed_paths()
    var path_index = 0
    while path_index < paths.count() {
        var path = paths[path_index]
        var dependencies = proof_dependencies(path, scope, class_information)
        var effect = changing_effect(effects, dependencies, path, arguments)
        if not effect.is_empty() and scope.forget_path(path, true, List<String>()) {
            crossed.append(path)
        }
        path_index = path_index + 1
    }
    var attributes = scope.narrowed_attributes()
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        var attribute_dependency = ["{class_information.simple_name}#{attribute}"]
        var effect = changing_effect(effects, attribute_dependency, attribute, arguments)
        if not effect.is_empty() and scope.forget_override(attribute, false) {
            crossed.append(attribute)
        }
        attribute_index = attribute_index + 1
    }
    assert not crossed.is_empty()
    var printer = Syntax.SourcePrinter()
    var callee_text = printer.source_expression(callee)
    var crossed_text = crossed.join("', '")
    report(
        "'{callee_text}()' inside this loop may change '{crossed_text}', which undoes what was proven about it before the loop, and the next pass would read it unproven: prove it inside the loop instead",
    )
}

func called_effects(
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): List<String> {
    var unknown = ["field:*", "shrink:*"]
    var identifier = shape.as_identifier(callee)
    if identifier {
        var held = scope.written_type(identifier.name)
        var held_field = class_information.find_field(identifier.name)
        if held or held_field {
            return unknown
        }
        if call_effects.names_a_class(identifier.name) {
            return call_effects.effects_of(identifier.name, identifier.name)
        }
        return call_effects.effects_of(class_information.simple_name, identifier.name)
    }
    var member = shape.as_member(callee)
    if member {
        if member.name == "call_function" {
            return unknown
        }
        if call_effects.names_a_class(member.name) {
            return call_effects.effects_of(member.name, member.name)
        }
        crash member.object
        var receiver_type = receiver_type_of(member.object, scope, class_information)
        var owner = owner_name(receiver_type)
        return call_effects.effects_of(owner, member.name)
    }
    return unknown
}

func receiver_type_of(
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Analysis.SpiteType? {
    var identifier = shape.as_identifier(expression)
    if identifier {
        var local_type = scope.written_type(identifier.name)
        if local_type {
            return local_type
        }
        var field = class_information.find_field(identifier.name)
        assert field
        return field.get_type()
    }
    var member = shape.as_member(expression)
    assert member
    crash member.object
    var object_type = receiver_type_of(member.object, scope, class_information)
    return member_type_through(object_type, member.name)
}

func changing_effect(
    effects: List<String>,
    dependencies: List<String>,
    path: String,
    arguments: List<Syntax.Expressions.Expression>,
): String {
    var index = 0
    while index < effects.count() {
        var effect = effects[index]
        if effect_changes(effect, dependencies, path, arguments) {
            return effect
        }
        index = index + 1
    }
    return ""
}

func effect_changes(
    effect: String,
    dependencies: List<String>,
    path: String,
    arguments: List<Syntax.Expressions.Expression>,
): Boolean {
    if effect.starts_with("parameter:") {
        var passed = passed_list_path(effect, arguments)
        return not passed.is_empty() and path.starts_with("{passed}[")
    }
    var index = 0
    while index < dependencies.count() {
        var dependency = dependencies[index]
        if dependency_changes(effect, dependency) {
            return true
        }
        index = index + 1
    }
    return false
}

func dependency_changes(effect: String, dependency: String): Boolean {
    assert effect != "release"
    var is_list = dependency.starts_with("list:")
    if effect == "field:*" {
        return not is_list
    }
    if effect == "shrink:*" {
        return is_list
    }
    var effect_length = effect.length()
    if effect.starts_with("shrink:") {
        assert is_list
        var shrunk_link = effect.slice(7, effect_length)
        var dependency_length = dependency.length()
        var list_link = dependency.slice(5, dependency_length)
        return links_meet(shrunk_link, list_link)
    }
    assert not is_list
    var written_link = effect.slice(6, effect_length)
    return links_meet(written_link, dependency)
}

func links_meet(changed_link: String, link: String): Boolean {
    var changed_parts = changed_link.split("#")
    var parts = link.split("#")
    assert changed_parts.count() == 2 and parts.count() == 2
    var same_class = changed_parts[0] == "*" or parts[0] == "*" or changed_parts[0] == parts[0]
    return same_class and changed_parts[1] == parts[1]
}

func passed_list_path(effect: String, arguments: List<Syntax.Expressions.Expression>): String {
    var effect_length = effect.length()
    var position_text = effect.slice(10, effect_length)
    var position = position_text.to_integer()
    assert position < arguments.count()
    return operand_text(arguments[position])
}

func proof_dependencies(path: String, scope: Scope, class_information: Analysis.ClassInfo): List<String> {
    var dependencies = List<String>()
    var root = scope.path_root(path)
    var current = scope.written_type(root)
    var link = "local"
    var root_local = scope.unnarrowed_type(root)
    if not root_local {
        link = "{class_information.simple_name}#{root}"
        dependencies.append(link)
        var root_field = class_information.find_field(root)
        if root_field {
            current = root_field.get_type()
        }
    }
    var position = root.length()
    var path_length = path.length()
    while position < path_length {
        var code = path.code_at(position)
        if code == 46 {
            var name_end = scope.name_end(path, position + 1)
            var member_name = path.slice(position + 1, name_end)
            var owner = owner_name(current)
            link = "{owner}#{member_name}"
            dependencies.append(link)
            current = member_type_through(current, member_name)
            position = name_end
        } else {
            var key_end = scope.key_end(path, position)
            var key_text = path.slice(position + 1, key_end)
            collect_key_dependencies(key_text, scope, class_information, dependencies)
            dependencies.append("list:{link}")
            current = element_type_through(current)
            link = "element"
            position = key_end + 1
        }
    }
    return dependencies
}

func owner_name(spite_type: Analysis.SpiteType?): String {
    var owner_class = class_behind(spite_type)
    if owner_class {
        return owner_class.simple_name
    }
    return "*"
}

func class_behind(spite_type: Analysis.SpiteType?): Analysis.ClassInfo? {
    assert spite_type
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.get_inner()
    }
    var class_ref = type_shape.as_class_ref(plain)
    assert class_ref
    return find_class_by_c_name(class_ref.c_name)
}

func member_type_through(spite_type: Analysis.SpiteType?, member_name: String): Analysis.SpiteType? {
    var owner_class = class_behind(spite_type)
    assert owner_class
    return member_type_of(owner_class, member_name)
}

func element_type_through(spite_type: Analysis.SpiteType?): Analysis.SpiteType? {
    assert spite_type
    var plain = spite_type
    var nullable = type_shape.as_nullable(spite_type)
    if nullable {
        plain = nullable.get_inner()
    }
    var listed = type_shape.as_list(plain)
    assert listed
    return listed.get_element()
}

func collect_key_dependencies(
    key_text: String,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    dependencies: List<String>,
) {
    var position = 0
    var key_length = key_text.length()
    var previous = 0
    while position < key_length {
        var name_end = scope.name_end(key_text, position)
        var starts_word = name_end > position and not scope.is_name_code(previous)
        if starts_word {
            var word = key_text.slice(position, name_end)
            add_key_dependency(word, previous == 46, scope, class_information, dependencies)
            position = name_end
        } else {
            position = position + 1
        }
        previous = key_text.code_at(position - 1)
    }
}

func add_key_dependency(
    word: String,
    after_dot: Boolean,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    dependencies: List<String>,
) {
    if after_dot {
        dependencies.append("*#{word}")
        return
    }
    var local = scope.unnarrowed_type(word)
    assert not local
    var field = class_information.find_field(word)
    assert field
    dependencies.append("{class_information.simple_name}#{word}")
}

func narrow_by_guard(scope: Scope, guard: NullableGuard) {
    if guard.override_code.is_empty() {
        scope.narrow_path(guard.name)
    } else {
        scope.set_override(guard.name, guard.override_code)
        var guard_inner = guard.get_inner()
        scope.declare(guard.name, guard_inner)
    }
}

func try_nullable_guard(
    condition_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NullableGuard? {
    var identifier = shape.as_identifier(condition_ast)
    if not identifier {
        return try_path_guard(condition_ast, scope, class_information)
    }
    assert identifier
    var static_type = lookup_static_type(condition_ast, scope, class_information)
    assert static_type
    var handle = joinable_handle(static_type)
    if handle {
        return joined_guard(identifier.name, condition_ast, handle, scope, class_information)
    }
    var nullable = type_shape.as_nullable(static_type)
    assert nullable
    var base_result = generate_expression(condition_ast, scope, class_information)
    var inner = nullable.get_inner()
    report_maybe_boolean(base_result, "a condition")
    var guard_code = ""
    var override_code = ""
    if type_is_reference(inner) {
        guard_code = "({base_result.code}) != 0"
        override_code = base_result.code
    } else {
        guard_code = "({base_result.code}).has_value"
        override_code = "({base_result.code}).value"
    }
    return NullableGuard(identifier.name, inner, guard_code, override_code)
}

func joined_guard(
    name: String,
    condition_ast: Syntax.Expressions.Expression,
    handle: Analysis.ClassInfo,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NullableGuard? {
    crash handle.codegen_types[0]
    var result_type = handle.codegen_types[0]
    var nullable = type_shape.as_nullable(result_type)
    assert nullable
    var joined_ast = implicit_join_ast(condition_ast)
    var joined = generate_expression(joined_ast, scope, class_information)
    var held_name = next_temporary()
    var held = c_value_name(held_name)
    builder.add_user("{c_type_name(result_type)} {held} = {joined.code};")
    scope.declare_owned(held_name, result_type)
    var inner = nullable.get_inner()
    if type_is_reference(inner) {
        return NullableGuard(name, inner, "({held}) != 0", held)
    }
    return NullableGuard(name, inner, "({held}).has_value", "({held}).value")
}

func try_path_guard(
    condition_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): NullableGuard? {
    var path = operand_text(condition_ast)
    assert not path.is_empty() and not is_caller_call(condition_ast) and not is_shape_member_read(condition_ast)
    var links = path_links(condition_ast, class_information.qualified_dotted)
    var probe_scope = Scope(scope)
    var tests = List<String>()
    var inner: Analysis.SpiteType? = null
    var index = 0
    while index < links.count() {
        var link = links[index]
        if index > 0 {
            conditional_depth = conditional_depth + 1
        }
        var link_result = generate_expression(link, probe_scope, class_information)
        if index > 0 {
            conditional_depth = conditional_depth - 1
        }
        inner = null
        var link_result_type = link_result.get_type()
        var link_nullable = type_shape.as_nullable(link_result_type)
        report_maybe_boolean(link_result, "a condition")
        if link_nullable {
            var link_inner = link_nullable.get_inner()
            inner = link_inner
            var link_condition = link_test(link_result, link, link_inner)
            tests.append(link_condition)
        }
        var link_text = operand_text(link)
        probe_scope.narrow_path(link_text)
        index = index + 1
    }
    assert inner
    var joined_tests = tests.join(" && ")
    return NullableGuard(path, inner, joined_tests, "")
}

func path_links(
    expression: Syntax.Expressions.Expression,
    current_namespace: String,
): List<Syntax.Expressions.Expression> {
    var indexed = shape.as_index(expression)
    if indexed {
        if indexed.object {
            var indexed_links = path_links(indexed.object, current_namespace)
            indexed_links.append(expression)
            return indexed_links
        }
    }
    var member = shape.as_member(expression)
    if member {
        if member.object {
            if not try_resolve_static_path(expression, current_namespace) {
                var links = path_links(member.object, current_namespace)
                links.append(expression)
                return links
            }
        }
    }
    return List<Syntax.Expressions.Expression>()
}

func link_test(
    link_result: ExpressionResult,
    link_ast: Syntax.Expressions.Expression,
    inner: Analysis.SpiteType,
): String {
    if not type_is_reference(inner) {
        return "(({link_result.code}).has_value)"
    }
    if type_needs_drop(inner) and owns(link_result, link_ast) {
        var value_temporary = next_temporary()
        return "(\{ {c_type_name(inner)} {value_temporary} = {link_result.code}; int path_narrowed = {value_temporary} != 0; {release_call(inner, value_temporary)}; path_narrowed; })"
    }
    return "(({link_result.code}) != 0)"
}

func emit_scope_drops(scope: Scope, all_the_way_up: Boolean) {
    var index = scope.owned.count() - 1
    while index >= 0 {
        crash scope.owned[index]
        var owned_local = scope.owned[index]
        var owned_local_type = owned_local.get_type()
        var owned_code = c_value_name(owned_local.name)
        builder.add_user("{release_call(owned_local_type, owned_code)};")
        index = index - 1
    }
    assert all_the_way_up
    assert scope.parent
    emit_scope_drops(scope.parent, true)
}

func generate_variable_declaration(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert declaration.value
    if pending_allocator {
        generate_allocated_declaration(declaration, pending_allocator, scope, class_information)
        return
    }
    var frame_key = placement.frame_key(declaration)
    var frame_placed = frame_candidates.contains("{current_path}:{current_function}:{frame_key}") and not scope.entry_names.contains(declaration.name) and placed_in_frame(declaration, scope, class_information)
    assert not frame_placed
    var borrowed = borrowed_element(declaration, scope, class_information)
    if not borrowed.is_empty() {
        var element_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
        builder.add_user("{c_type_name(element_type)} {c_value_name(declaration.name)} = {borrowed};")
        scope.declare(declaration.name, element_type)
        scope.check_last(current_line)
        check_value_name(declaration.name, "variable")
        borrowed_names.append(declaration.name)
        return
    }
    var declared_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
    var value_code = coerce_for_store(declaration.value, declared_type, scope, class_information)
    report_copy_for_narrowing(declaration.name, declaration.value, declared_type, scope, class_information)
    if scope.entry_names.contains(declaration.name) {
        value_code = rebind(declaration.name, value_code, declared_type, scope)
    }
    builder.add_user("{c_type_name(declared_type)} {c_value_name(declaration.name)} = {value_code};")
    if type_needs_drop(declared_type) {
        scope.declare_owned(declaration.name, declared_type)
        scope.check_last(current_line)
        check_value_name(declaration.name, "variable")
    } else {
        scope.declare(declaration.name, declared_type)
        scope.check_last(current_line)
        check_value_name(declaration.name, "variable")
    }
}

func borrowed_element(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var statements = borrow_statements
    var start = borrow_index + 1
    assert class_information.qualified_dotted == "List" and not declaration.type_reference and not hot_reload
    assert not scope.entry_names.contains(declaration.name) and not class_information.codegen_types.is_empty()
    crash declaration.value
    var read = shape.as_member(declaration.value)
    if read {
        return borrowed_field(declaration, read, statements, start, scope, class_information)
    }
    var call = shape.as_call(declaration.value)
    assert call and call.arguments.count() == 2
    crash call.callee
    var member = shape.as_member(call.callee)
    assert member and member.name == "read_value"
    crash member.object
    assert is_identifier_named(member.object, "values") and is_identifier_named(call.arguments[0], "items")
    crash class_information.codegen_types[0]
    var element_type = class_information.codegen_types[0]
    assert type_needs_drop(element_type) and not type_shape.as_nullable(element_type)
    var watch = ReleaseWatch(declaration.name)
    assert watch_statements(watch, statements, start, scope, class_information)
    var integer_spite_type = integer_type()
    var index_code = coerce_for_store(call.arguments[1], integer_spite_type, scope, class_information)
    return "(({c_type_name(element_type)}*)(intptr_t)self->items_)[{index_code}]"
}

func borrowed_field(
    declaration: Syntax.Statements.VariableDeclaration,
    read: Syntax.Expressions.MemberExpression,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    crash read.object
    var holder = shape.as_identifier(read.object)
    assert holder and borrowed_names.contains(holder.name)
    var holder_type = scope.written_type(holder.name)
    var holder_class = class_behind(holder_type)
    assert holder_class and not holder_class.find_function("get_{read.name}")
    var field = holder_class.find_field(read.name)
    assert field
    var field_type = field.get_type()
    assert type_needs_drop(field_type) and not type_shape.as_nullable(field_type)
    var watch = ReleaseWatch(declaration.name)
    assert watch_statements(watch, statements, start, scope, class_information)
    var generated = generate_expression(declaration.value, scope, class_information)
    return generated.code
}

func watch_statements(
    watch: ReleaseWatch,
    statements: List<Syntax.Statements.Statement>,
    start: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = start
    while index < statements.count() {
        assert releases_nothing(watch, statements[index], scope, class_information)
        index = index + 1
    }
    return true
}

func releases_nothing(
    watch: ReleaseWatch,
    statement: Syntax.Statements.Statement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            assert statement.name != watch.name
            watch.locals.append(statement.name)
            crash statement.value
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            var target = shape.as_identifier(statement.target)
            assert target
            var local = watch.locals.contains(target.name) or scope.written_type(target.name)
            assert local and target.name != watch.name and not class_information.find_field(target.name)
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            assert watch_expression(watch, statement.condition, scope, class_information)
            assert watch_statements(watch, statement.then_branch, 0, scope, class_information)
            return watch_statements(watch, statement.else_branch, 0, scope, class_information)
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            assert watch_expression(watch, statement.condition, scope, class_information)
            return watch_statements(watch, statement.body, 0, scope, class_information)
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.AssertStatement: {
            crash statement.value
            return watch_expression(watch, statement.value, scope, class_information)
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                return watch_expression(watch, statement.value, scope, class_information)
            }
            return true
        }
        _: return false
    }
}

func watch_expressions(
    watch: ReleaseWatch,
    expressions: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var index = 0
    while index < expressions.count() {
        assert watch_expression(watch, expressions[index], scope, class_information)
        index = index + 1
    }
    return true
}

func watch_expression(
    watch: ReleaseWatch,
    expression: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    switch expression {
        Syntax.Expressions.CallExpression: {
            crash expression.callee
            assert watch_expressions(watch, expression.arguments, scope, class_information)
            return watch_call(watch, expression.callee, scope, class_information)
        }
        Syntax.Expressions.GenericCallExpression: {
            crash expression.callee
            assert watch_expressions(watch, expression.arguments, scope, class_information)
            var constructed = called_name_of(expression.callee)
            return not any_releases(constructed)
        }
        Syntax.Expressions.BinaryExpression: {
            crash expression.left
            crash expression.right
            assert not operators_release()
            assert watch_expression(watch, expression.left, scope, class_information)
            return watch_expression(watch, expression.right, scope, class_information)
        }
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return watch_expression(watch, expression.operand, scope, class_information)
        }
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            assert not any_releases("get_{expression.name}")
            return watch_expression(watch, expression.object, scope, class_information)
        }
        Syntax.Expressions.IndexExpression: {
            assert not bound_member_owner_c_name.is_empty() and is_bound_member_index(expression)
            var read = bound_member_expression(expression)
            return watch_expression(watch, read, scope, class_information)
        }
        Syntax.Expressions.IdentifierExpression: return true
        Syntax.Expressions.IntegerLiteral: return true
        Syntax.Expressions.FloatLiteral: return true
        Syntax.Expressions.StringLiteralExpression: return true
        Syntax.Expressions.TrueLiteral: return true
        Syntax.Expressions.FalseLiteral: return true
        Syntax.Expressions.EnumLiteralExpression: return true
        _: return false
    }
}

func watch_call(
    watch: ReleaseWatch,
    callee: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    var member = shape.as_member(callee)
    if member {
        crash member.object
        assert member.name != "release_value" and watch_expression(watch, member.object, scope, class_information)
        assert call_effects.by_function.has("*#{member.name}") or not any_releases("missing_function")
    } else {
        var identifier = shape.as_identifier(callee)
        assert identifier and class_information.find_function(identifier.name) and not watch.locals.contains(identifier.name)
    }
    var effects = called_effects(callee, scope, class_information)
    return not effects.contains("release") and not effects.contains("field:*")
}

func called_name_of(callee: Syntax.Expressions.Expression): String {
    var identifier = shape.as_identifier(callee)
    if identifier {
        return identifier.name
    }
    var member = shape.as_member(callee)
    assert member
    return member.name
}

func any_releases(name: String): Boolean {
    var effects = call_effects.effects_of("*", name)
    return effects.contains("release") or effects.contains("field:*")
}

func operators_release(): Boolean {
    var names = ["sum", "subtract", "multiply", "divide", "modulo", "equals", "less_than", "greater_than", "to_string"]
    return names.any(any_releases)
}

func choose_allocator_after(statements: List<Syntax.Statements.Statement>, index: Integer) {
    pending_allocator = null
    assert index + 1 < statements.count()
    var declaration = shape.as_variable_declaration(statements[index])
    assert declaration
    var setting = shape.as_assignment_statement(statements[index + 1])
    assert setting
    crash setting.target
    assert allocator_object_name(setting.target) == declaration.name
    pending_allocator = setting
    chosen_allocator_lines.append("{current_path}:{setting.line}")
}

func allocator_object_name(target: Syntax.Expressions.Expression): String {
    var chosen = shape.as_member(target)
    assert chosen
    assert chosen.name == "allocator"
    crash chosen.object
    var memory = shape.as_member(chosen.object)
    assert memory
    assert memory.name == "memory"
    crash memory.object
    var object_text = operand_text(memory.object)
    if object_text.is_empty() {
        return "this object"
    }
    return object_text
}

func is_name_path(expression: Syntax.Expressions.Expression): Boolean {
    if shape.as_identifier(expression) {
        return true
    }
    var member = shape.as_member(expression)
    assert member
    crash member.object
    return is_name_path(member.object)
}

func generate_allocated_declaration(
    declaration: Syntax.Statements.VariableDeclaration,
    setting: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    pending_allocator = null
    current_line = setting.line
    var allocated = allocated_declaration(declaration, setting, scope, class_information)
    current_line = declaration.line
    if not allocated {
        generate_variable_declaration(declaration, scope, class_information)
    }
}

func allocated_declaration(
    declaration: Syntax.Statements.VariableDeclaration,
    setting: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash declaration.value
    crash setting.value
    var saved_counter = temporary_counter
    var probe = generate_expression(setting.value, scope, class_information)
    rewind_temporaries(saved_counter)
    var allocator_type = probe.get_type()
    var allocator_class = allocator_class_of(allocator_type)
    assert allocator_class
    var allocating = allocator_class.find_function("allocate")
    var freeing = allocator_class.find_function("free")
    crash allocating
    crash freeing
    if not is_name_path(setting.value) {
        report(
            "an allocator is made on a line of its own and then named here: 'var arena = Memory.Arena(65536)', and then '{declaration.name}.memory.allocator = arena'",
        )
        return false
    }
    current_line = declaration.line
    var declared_type = infer_declared_type(declaration.type_reference, declaration.value, scope, class_information)
    var placed_class = allocatable_class(declared_type)
    if not placed_class {
        var display_name = type_display_name(declared_type)
        current_line = setting.line
        report(
            "only an object gets an allocator of its own, and '{declaration.name}' is a value of type {display_name}, which the compiler places itself",
        )
    }
    assert placed_class
    var value_code = coerce_for_store(declaration.value, declared_type, scope, class_information)
    var allocator_name = next_temporary()
    var given_back = ensure_given_back(allocator_class, freeing)
    var head = "{allocator_name}, {given_back}, {allocating.c_name}({allocator_name}, (int64_t)sizeof({placed_class.c_name}))"
    var placed_code = allocated_code(placed_class, value_code, head)
    if placed_code.is_empty() {
        current_line = setting.line
        report(
            "'{declaration.name}' gets an allocator only on the line right after the line that makes it: a constructor, 'List<T>()' or '.copy()'",
        )
        return false
    }
    var allocator_code = coerce_for_store(setting.value, allocator_type, scope, class_information)
    builder.add_user("{c_type_name(allocator_type)} {allocator_name} = {allocator_code};")
    var declared_code = c_value_name(declaration.name)
    builder.add_user("{c_type_name(declared_type)} {declared_code} = {placed_code};")
    scope.declare_owned(declaration.name, declared_type)
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    if not allocated_class_names.contains(placed_class.c_name) {
        allocated_class_names.append(placed_class.c_name)
        allocated_classes.append(placed_class)
    }
    return true
}

func allocator_class_of(allocator_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var reference = type_shape.as_class_ref(allocator_type)
    if reference {
        var found = find_class_by_c_name(reference.c_name)
        if found {
            assert found.qualified_dotted != "Memory.Heap"
            if found.find_function("allocate") and found.find_function("free") {
                return found
            }
        }
    }
    var display_name = type_display_name(allocator_type)
    report(
        "'{display_name}' is not an allocator: an allocator answers 'allocate(bytes: Long): Memory.Address' and 'free(address: Memory.Address)', like 'Memory.Arena'",
    )
    return null
}

func mark_names_used_in(expression: Syntax.Expressions.Expression, scope: Scope) {
    var mentioned = List<String>()
    collect_each_mentioned_name([expression], mentioned)
    mark_each_used(mentioned, scope)
}

func allocatable_class(declared_type: Analysis.SpiteType): Analysis.ClassInfo? {
    var placed_c_name = ""
    var reference = type_shape.as_class_ref(declared_type)
    if reference {
        placed_c_name = reference.c_name
    }
    var listed = type_shape.as_list(declared_type)
    if listed {
        var listed_element = listed.get_element()
        placed_c_name = ensure_list(listed_element)
    }
    var dictionary = type_shape.as_dictionary(declared_type)
    if dictionary {
        var dictionary_element = dictionary.get_element()
        placed_c_name = ensure_dictionary(dictionary_element)
    }
    var placed_class = find_class_by_c_name(placed_c_name)
    assert placed_class
    assert not placed_class.is_singleton and not placed_class.is_value_class
    assert placed_class.c_name != "Spite_Function" and placed_class.c_name != "Spite_Attribute"
    return placed_class
}

func allocated_code(placed_class: Analysis.ClassInfo, value_code: String, head: String): String {
    var code_length = value_code.length()
    var made = "{placed_class.c_name}___make("
    if value_code.starts_with(made) {
        var made_length = made.length()
        var made_rest = value_code.slice(made_length, code_length)
        ensure_made_in(placed_class)
        if made_rest == ")" {
            return "{placed_class.c_name}___make_in({head})"
        }
        return "{placed_class.c_name}___make_in({head}, {made_rest}"
    }
    var copied = "{placed_class.c_name}_copy("
    assert value_code.starts_with(copied) and not placed_class.find_function("copy")
    var copied_length = copied.length()
    var copied_rest = value_code.slice(copied_length, code_length)
    if not copied_in_names.contains(placed_class.c_name) {
        copied_in_names.append(placed_class.c_name)
        builder.add_prototype(
            "{placed_class.c_name}* {placed_class.c_name}_copy_in(void* spite_allocator, void (*spite_give_back)(void*, void*), int64_t spite_address, {placed_class.c_name}* self);",
        )
    }
    return "{placed_class.c_name}_copy_in({head}, {copied_rest}"
}

func ensure_given_back(allocator_class: Analysis.ClassInfo, freeing: Analysis.FunctionInfo): String {
    var name = "spite_give_back_{allocator_class.c_name}"
    if not given_back_names.contains(name) {
        given_back_names.append(name)
        builder.add_prototype("void {name}(void* allocator, void* object);")
        builder.add_support(
            "void {name}(void* allocator, void* object) \{\n{freeing.c_name}(({allocator_class.c_name}*)allocator, (int64_t)(intptr_t)object);\n{allocator_class.c_name}___release(({allocator_class.c_name}*)allocator);\n}",
        )
    }
    return name
}

func ensure_made_in(information: Analysis.ClassInfo) {
    assert not made_in_names.contains(information.c_name)
    made_in_names.append(information.c_name)
    var parameters = "void* spite_allocator, void (*spite_give_back)(void*, void*), int64_t spite_address"
    var constructor_parameters = constructor_parameter_list(information)
    if constructor_parameters != "void" {
        parameters = "{parameters}, {constructor_parameters}"
    }
    var signature = "{information.c_name}* {information.c_name}___make_in({parameters})"
    builder.add_prototype("{signature};")
    var lines = List<String>()
    lines.append("{signature} \{")
    lines.append("{information.c_name}* self = ({information.c_name}*)(intptr_t)spite_address;")
    lines.append("self->header.ref_count = 1;")
    lines.append("self->header.class_id = {information.class_id};")
    lines.append("{information.c_name}___init(self);")
    lines.append("self->spite_allocator = spite_allocator;")
    lines.append("self->spite_give_back = spite_give_back;")
    lines.append("#ifdef SPITE_TRACKS_{information.c_name}")
    lines.append("spite_track_{information.c_name}(self);")
    lines.append("#endif")
    if information.constructor {
        var arguments = c_parameter_names(information.constructor.parameters)
        arguments.prepend("self")
        lines.append("{information.constructor.c_name}({arguments.join(", ")});")
    }
    lines.append("return self;")
    lines.append("}")
    var joined_lines = lines.join("\n")
    builder.add_support(joined_lines)
}

func finish_allocated_classes() {
    allocated_classes.each(finish_allocated_class)
}

func finish_allocated_class(information: Analysis.ClassInfo) {
    crash information.struct_position >= 0 and information.allocate_position >= 0 and information.release_position >= 0
    var laid_out = builder.typedef_at(information.struct_position)
    var with_allocator = laid_out.replace(
        "SpiteHeader header;",
        "SpiteHeader header;\nvoid* spite_allocator;\nvoid (*spite_give_back)(void*, void*);",
    )
    builder.replace_typedef(information.struct_position, with_allocator)
    var allocated = builder.support_at(information.allocate_position)
    var allocated_on_heap = allocated.replace(
        "{information.c_name}___init(self);",
        "{information.c_name}___init(self);\nself->spite_allocator = 0;",
    )
    builder.replace_support(information.allocate_position, allocated_on_heap)
    if information.constructed_allocate_position >= 0 {
        var constructed = builder.support_at(information.constructed_allocate_position)
        var constructed_on_heap = constructed.replace(
            "{information.c_name}___init_constructed(self);",
            "{information.c_name}___init_constructed(self);\nself->spite_allocator = 0;",
        )
        builder.replace_support(information.constructed_allocate_position, constructed_on_heap)
    }
    var released = builder.support_at(information.release_position)
    var given_back = released.replace(
        "SPITE_FREE(self);",
        "if (self->spite_allocator != 0) \{\nself->spite_give_back(self->spite_allocator, self);\nreturn;\n}\nSPITE_FREE(self);",
    )
    builder.replace_support(information.release_position, given_back)
    assert information.copy_position >= 0
    var class_id_line = "spite_copy->header.class_id = {information.class_id};"
    var copied = builder.support_at(information.copy_position)
    var copied_on_heap = copied.replace(class_id_line, "{class_id_line}\nspite_copy->spite_allocator = 0;")
    builder.replace_support(information.copy_position, copied_on_heap)
    assert copied_in_names.contains(information.c_name)
    var c_name = information.c_name
    var copied_in = copied.replace(
        "{c_name}* {c_name}_copy({c_name}* self) \{",
        "{c_name}* {c_name}_copy_in(void* spite_allocator, void (*spite_give_back)(void*, void*), int64_t spite_address, {c_name}* self) \{",
    )
    copied_in = copied_in.replace("({c_name}*)SPITE_MALLOC(sizeof({c_name}))", "({c_name}*)(intptr_t)spite_address")
    copied_in = copied_in.replace(
        "#ifdef SPITE_DEBUG_MEMORY\nspite_debug_register_object(spite_copy, {information.class_id});\n#endif\n",
        "",
    )
    copied_in = copied_in.replace(
        class_id_line,
        "{class_id_line}\nspite_copy->spite_allocator = spite_allocator;\nspite_copy->spite_give_back = spite_give_back;",
    )
    builder.add_support(copied_in)
}

func placed_in_frame(
    declaration: Syntax.Statements.VariableDeclaration,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    crash declaration.value
    var allocation = shape.as_call(declaration.value)
    crash allocation
    crash allocation.callee
    var allocating = shape.as_member(allocation.callee)
    crash allocating
    crash allocating.object
    var receiver = shape.as_identifier(allocating.object)
    crash receiver
    var receiver_result = generate_expression(allocating.object, scope, class_information)
    var receiver_type = receiver_result.get_type()
    var heap_type = type_shape.as_class_ref(receiver_type)
    assert heap_type
    assert heap_type.c_name == "Memory_Heap"
    var placed_type = address_type()
    var bytes_type = long_type()
    var bytes_code = coerce_for_store(allocation.arguments[0], bytes_type, scope, class_information)
    var frame_bytes = 256
    var literal_bytes = shape.as_integer_literal(allocation.arguments[0])
    if literal_bytes {
        if literal_bytes.value >= 1 and literal_bytes.value <= frame_bytes {
            frame_bytes = (literal_bytes.value + 7) / 8 * 8
        }
    }
    var frame = next_temporary()
    var bytes = next_temporary()
    builder.add_user("int64_t {frame}[{frame_bytes / 8}];")
    builder.add_user("int64_t {bytes} = {bytes_code};")
    builder.add_user(
        "int64_t {c_value_name(declaration.name)} = {bytes} <= {frame_bytes} ? (int64_t)(intptr_t){frame} : Memory_Heap_allocate({receiver_result.code}, {bytes});",
    )
    scope.declare(declaration.name, placed_type)
    scope.check_last(current_line)
    check_value_name(declaration.name, "variable")
    placed_names.append(declaration.name)
    placed_frames.append(frame)
    placed_receiver_names.append(receiver.name)
    placed_receiver_codes.append(receiver_result.code)
    return true
}

func freed_from_frame(expression_statement: Syntax.Statements.ExpressionStatement, scope: Scope): Boolean {
    crash expression_statement.value
    var index = placed_names.count() - 1
    while index >= 0 {
        var receiver_name = placed_receiver_names.get_at(index)
        var freed = placement.memory_argument(expression_statement.value, receiver_name, "free")
        if freed == placed_names.get_at(index) {
            var frame = placed_frames.get_at(index)
            var receiver_code = placed_receiver_codes.get_at(index)
            scope.mark_used(freed)
            var freed_code = c_value_name(freed)
            builder.add_user(
                "if ({freed_code} != (int64_t)(intptr_t){frame}) Memory_Heap_free({receiver_code}, {freed_code});",
            )
            return true
        }
        index = index - 1
    }
    return false
}

func rebind(name: String, value_code: String, declared_type: Analysis.SpiteType, scope: Scope): String {
    var temporary = next_temporary()
    builder.add_user("{c_type_name(declared_type)} {temporary} = {value_code};")
    var index = 0
    while index < scope.owned.count() {
        if scope.owned[index].name == name {
            var old_type = scope.owned[index].get_type()
            var old_code = c_value_name(name)
            builder.add_user("{release_call(old_type, old_code)};")
        }
        index = index + 1
    }
    scope.forget_owned(name)
    builder.add_user("\{")
    scope.rebindings = scope.rebindings + 1
    return temporary
}

func close_rebindings(scope: Scope) {
    var index = 0
    while index < scope.rebindings {
        builder.add_user("}")
        index = index + 1
    }
}

func report_copy_for_narrowing(
    name: String,
    initializer: Syntax.Expressions.Expression,
    declared_type: Analysis.SpiteType,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var source = operand_text(initializer)
    assert not source.is_empty() and type_shape.as_nullable(declared_type)
    assert body_narrowed_names.contains(name) and not body_assigned_paths.contains(name)
    var index = 0
    while index < body_assigned_paths.count() {
        var assigned = body_assigned_paths[index]
        assert assigned != source and not source.starts_with("{assigned}.") and not source.starts_with("{assigned}[") and not source.contains("[{assigned}]")
        index = index + 1
    }
    var saved_counter = temporary_counter
    var copied = generate_expression(initializer, scope, class_information)
    rewind_temporaries(saved_counter)
    var copied_type = copied.get_type()
    assert not joinable_handle(copied_type)
    report(
        "'{name}' only copies '{source}' so it can be narrowed: narrow '{source}' itself ('assert {source}') and use it directly",
    )
}

func collect_body_facts(statements: List<Syntax.Statements.Statement>) {
    statements.each(collect_statement_facts)
}

func collect_statement_facts(statement: Syntax.Statements.Statement) {
    var checked = shape.as_assert_statement(statement)
    if checked {
        note_narrowed(checked.value)
    }
    var assignment = shape.as_assignment_statement(statement)
    if assignment {
        if assignment.target {
            var assigned = operand_text(assignment.target)
            if not assigned.is_empty() {
                body_assigned_paths.append(assigned)
            }
        }
    }
    var branch = shape.as_if_statement(statement)
    if branch {
        note_narrowed(branch.condition)
        collect_body_facts(branch.then_branch)
        collect_body_facts(branch.else_branch)
    }
    var loop = shape.as_while_statement(statement)
    if loop {
        collect_body_facts(loop.body)
    }
    var choice = shape.as_switch_statement(statement)
    assert choice
    note_narrowed(choice.subject)
    var case_index = 0
    while case_index < choice.cases.count() {
        collect_body_facts(choice.cases[case_index].body)
        case_index = case_index + 1
    }
}

func note_narrowed(condition: Syntax.Expressions.Expression?) {
    assert condition
    var identifier = shape.as_identifier(condition)
    assert identifier
    body_narrowed_names.append(identifier.name)
}

func emit_owning_assignment(
    target_code: String,
    target_type: Analysis.SpiteType,
    value_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var value_code = coerce_for_store(value_ast, target_type, scope, class_information)
    if type_needs_drop(target_type) {
        var temporary = next_temporary()
        builder.add_user("{c_type_name(target_type)} {temporary} = {value_code};")
        builder.add_user("{release_call(target_type, target_code)};")
        builder.add_user("{target_code} = {temporary};")
    } else {
        builder.add_user("{target_code} = {value_code};")
    }
}

func forget_narrowing_under(
    target_ast: Syntax.Expressions.Expression,
    value_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var path = operand_text(target_ast)
    assert not path.is_empty()
    var value_may_be_null = not value_is_never_null(value_ast, scope, class_information)
    if value_may_be_null and shape.as_identifier(target_ast) {
        if scope.lookup_override(path) {
            if scope.forget_override(path, false) {
                report(
                    "assigning a value that may be null to '{path}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
                )
            }
        }
    }
    if scope.forget_path(path, value_may_be_null, List<String>()) {
        report(
            "assigning to '{path}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
        )
    }
}

func value_is_never_null(
    value_ast: Syntax.Expressions.Expression,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    if shape.as_generic_call(value_ast) or shape.as_string_literal(value_ast) or shape.as_integer_literal(value_ast) {
        return true
    }
    if shape.as_binary(value_ast) or shape.as_unary(value_ast) {
        return true
    }
    var call = shape.as_call(value_ast)
    if call {
        if call.callee {
            if try_resolve_static_path(call.callee, class_information.qualified_dotted) {
                return true
            }
        }
        return false
    }
    var value_type = lookup_static_type(value_ast, scope, class_information)
    if value_type {
        if not type_shape.as_nullable(value_type) {
            return true
        }
    }
    return false
}

func generate_assignment(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert assignment.target
    assert assignment.value
    var chosen_object = allocator_object_name(assignment.target)
    if not chosen_object.is_empty() {
        if not chosen_allocator_lines.contains("{current_path}:{assignment.line}") {
            report(
                "'{chosen_object}' was already used, so its allocator can no longer change: an object's allocator is set on the line right after it is made. To move it, copy it and set the copy's: 'var moved = {chosen_object}.copy()' and then 'moved.memory.allocator = ...'",
            )
            mark_names_used_in(assignment.value, scope)
        }
        return
    }
    var index_target = shape.as_index(assignment.target)
    if index_target {
        if is_bound_member_index(index_target) {
            var bound_member = bound_member_expression(index_target)
            var member_assignment = Syntax.Statements.AssignmentStatement(bound_member, assignment.value)
            member_assignment.line = assignment.line
            generate_assignment(member_assignment, scope, class_information)
            return
        }
    }
    generate_store(assignment, scope, class_information)
    forget_narrowing_under(assignment.target, assignment.value, scope, class_information)
}

func appends_to_itself(
    value: Syntax.Expressions.Expression,
    target: String,
    pieces: List<Syntax.Expressions.Expression>,
): Boolean {
    assert text_base_is(value, target, pieces) and not pieces.is_empty()
    var mentioned = List<String>()
    collect_each_mentioned_name(pieces, mentioned)
    return not mentioned.contains(target)
}

func text_base_is(
    value: Syntax.Expressions.Expression,
    target: String,
    pieces: List<Syntax.Expressions.Expression>,
): Boolean {
    if is_identifier_named(value, target) {
        return true
    }
    var binary = shape.as_binary(value)
    if binary {
        if binary.operator == 'add' {
            crash binary.left
            crash binary.right
            var written = shape.as_string_literal(binary.left)
            if written {
                return written.value.is_empty() and is_identifier_named(binary.right, target)
            }
            if text_base_is(binary.left, target, pieces) {
                pieces.append(binary.right)
                return true
            }
        }
    }
    return false
}

func is_identifier_named(value: Syntax.Expressions.Expression, name: String): Boolean {
    var identifier = shape.as_identifier(value)
    if identifier {
        return identifier.name == name
    }
    return false
}

func emit_append_in_place(
    target: String,
    pieces: List<Syntax.Expressions.Expression>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var piece_result = generate_expression(piece, scope, class_information)
        var piece_type = piece_result.get_type()
        var string_spite_type = string_type()
        var piece_code = cast(piece_result.code, piece_type, string_spite_type)
        var temporary = next_temporary()
        var digits = digits_of(piece_code)
        if digits.is_empty() {
            builder.add_user("SpiteString* {temporary} = {piece_code};")
            builder.add_user("{target} = SpiteString_append({target}, {temporary});")
            if owns(piece_result, piece) or not type_shape.as_string(piece_type) {
                builder.add_user("SpiteString___release({temporary});")
            }
        } else {
            builder.add_user(
                "\{ {digits_view(temporary, digits)} {target} = SpiteString_append({target}, &{temporary}); }",
            )
        }
        index = index + 1
    }
}

func generate_store(
    assignment: Syntax.Statements.AssignmentStatement,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    assert assignment.target
    assert assignment.value
    var identifier = shape.as_identifier(assignment.target)
    if identifier {
        var scope_type = scope.written_type(identifier.name)
        if scope_type {
            var override = scope.lookup_override(identifier.name)
            var target_code = c_value_name(identifier.name)
            var storage_type = scope_type
            if override {
                target_code = override
                var declared = scope.unnarrowed_type(identifier.name)
                if declared {
                    storage_type = declared
                } else {
                    var narrowed_field = class_information.find_field(identifier.name)
                    if narrowed_field {
                        storage_type = narrowed_field.get_type()
                    }
                }
            }
            if not override and type_shape.as_string(scope_type) {
                var pieces = List<Syntax.Expressions.Expression>()
                if appends_to_itself(assignment.value, identifier.name, pieces) {
                    scope.mark_used(identifier.name)
                    emit_append_in_place(target_code, pieces, scope, class_information)
                    return
                }
            }
            emit_owning_assignment(target_code, storage_type, assignment.value, scope, class_information)
            return
        }
        var field = class_information.find_field(identifier.name)
        if not field {
            report(
                "'{identifier.name}' is not a variable or an attribute here: declare it with 'var {identifier.name} = ...' first",
            )
            return
        }
        assert field
        var field_type = field.get_type()
        if atomic_owner == class_information.c_name and atomic_fields.contains(identifier.name) {
            emit_atomic_store(identifier.name, field_type, assignment.value, scope, class_information)
            return
        }
        emit_owning_assignment(
            "self->{c_value_name(identifier.name)}",
            field_type,
            assignment.value,
            scope,
            class_information,
        )
        return
    }
    var index_target = shape.as_index(assignment.target)
    if index_target {
        if is_bound_attributes_index(index_target) {
            crash bound_field_type
            emit_owning_assignment(
                "self->{c_value_name(bound_field_name)}",
                bound_field_type,
                assignment.value,
                scope,
                class_information,
            )
            return
        }
        assert index_target.object
        assert index_target.index
        var indexed_result = generate_expression(index_target.object, scope, class_information)
        var indexed_result_type = indexed_result.get_type()
        var assigned_class_ref = type_shape.as_class_ref(indexed_result_type)
        if assigned_class_ref {
            var assigned_class = find_class_by_c_name(assigned_class_ref.c_name)
            if assigned_class {
                var set_at = find_or_instantiate_function(assigned_class, "set_at")
                if set_at {
                    var set_at_arguments = List<Syntax.Expressions.Expression>()
                    set_at_arguments.append(index_target.index)
                    set_at_arguments.append(assignment.value)
                    var parameter_types = parameter_types_of(set_at.parameters)
                    var set_at_return_type = set_at.get_return_type()
                    var set_at_call = generate_generic_call(
                        set_at.c_name,
                        indexed_result,
                        index_target.object,
                        set_at_arguments,
                        parameter_types,
                        set_at_return_type,
                        scope,
                        class_information,
                    )
                    builder.add_user("{set_at_call.code};")
                    return
                }
                report(
                    "assigning through an index on a '{assigned_class.simple_name}' needs it to define 'set_at(index, value)'",
                )
                return
            }
        }
        var indexed_dictionary = type_shape.as_dictionary(indexed_result_type)
        if indexed_dictionary {
            var dictionary_arguments = List<Syntax.Expressions.Expression>()
            dictionary_arguments.append(index_target.index)
            dictionary_arguments.append(assignment.value)
            var indexed_dictionary_element = indexed_dictionary.get_element()
            var string_spite_type = string_type()
            var element = indexed_dictionary.get_element()
            var pair_types = two_types(string_spite_type, element)
            var void_spite_type = void_type()
            var dictionary_set_call = generate_generic_call(
                "{ensure_dictionary(indexed_dictionary_element)}_set",
                indexed_result,
                index_target.object,
                dictionary_arguments,
                pair_types,
                void_spite_type,
                scope,
                class_information,
            )
            builder.add_user("{dictionary_set_call.code};")
            return
        }
        var indexed_list = type_shape.as_list(indexed_result_type)
        if indexed_list {
            var set_arguments = List<Syntax.Expressions.Expression>()
            set_arguments.append(index_target.index)
            set_arguments.append(assignment.value)
            var indexed_list_element = indexed_list.get_element()
            var list_function_name = list_function(indexed_list_element, "set_at")
            var integer_spite_type = integer_type()
            var element = indexed_list.get_element()
            var pair_types = two_types(integer_spite_type, element)
            var void_spite_type = void_type()
            var set_call = generate_generic_call(
                list_function_name,
                indexed_result,
                index_target.object,
                set_arguments,
                pair_types,
                void_spite_type,
                scope,
                class_information,
            )
            builder.add_user("{set_call.code};")
            return
        }
    }
    var member = shape.as_member(assignment.target)
    if member {
        assert member.object
        var object_result = generate_expression(member.object, scope, class_information)
        var object_result_type = object_result.get_type()
        var shaped_union = type_shape.as_union(object_result_type)
        if shaped_union {
            var shaped_information = find_union_by_c_name(shaped_union.c_name)
            if shaped_information {
                var written_type = shape_field_type(shaped_information, member.name)
                if shaped_information.is_shape {
                    if written_type {
                        var writer = ensure_shape_writer(shaped_information, member.name, written_type)
                        var shaped_temporary = next_temporary()
                        builder.add_user("{shaped_union.c_name} {shaped_temporary} = {object_result.code};")
                        builder.add_user(
                            "{writer}({shaped_temporary}, {coerce_for_store(assignment.value, written_type, scope, class_information)});",
                        )
                        if owns(object_result, member.object) {
                            builder.add_user("{shaped_union.c_name}___release({shaped_temporary});")
                        }
                        return
                    }
                }
            }
            report("cannot assign to '{member.name}' through this value")
            return
        }
        var object_class_ref = type_shape.as_class_ref(object_result_type)
        if not object_class_ref {
            if type_shape.as_nullable(object_result_type) {
                report(
                    "this value may be null (it is {type_with_article(object_result_type)}), so '{member.name}' cannot be assigned through it yet: narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
                )
            } else if not has_error {
                report("cannot assign to '{member.name}' through {type_with_article(object_result_type)}")
            }
            return
        }
        assert object_class_ref
        var target_class = find_class_by_c_name(object_class_ref.c_name)
        assert target_class
        report_private_member(target_class, member.name, class_information)
        var setter = find_setter(target_class, member.name, class_information)
        if setter {
            var setter_arguments = List<Syntax.Expressions.Expression>()
            setter_arguments.append(assignment.value)
            var parameter_types = parameter_types_of(setter.parameters)
            var setter_return_type = setter.get_return_type()
            var setter_call = generate_generic_call(
                setter.c_name,
                object_result,
                member.object,
                setter_arguments,
                parameter_types,
                setter_return_type,
                scope,
                class_information,
            )
            builder.add_user("{setter_call.code};")
            return
        }
        var field = target_class.find_field(member.name)
        if not field {
            if find_getter(target_class, member.name, class_information) {
                report(
                    "'{member.name}' is read-only: '{target_class.simple_name}' answers it through get_{member.name}() and has no set_{member.name}(value)",
                )
            } else {
                report("'{target_class.simple_name}' has no attribute '{member.name}' to assign to")
            }
            return
        }
        assert field
        var object_temporary = next_temporary()
        var field_type = field.get_type()
        var watch = ReleaseWatch("")
        var plain_write = not type_needs_drop(field_type) and not guards_outside_write(target_class)
        if object_result.peek_union and plain_write and watch_expression(watch, assignment.value, scope, class_information) {
            var peeked = peeked_code(object_result)
            builder.add_user("{target_class.c_name} {object_temporary}_scratch;")
            builder.add_user("{c_type_name(object_result_type)} {object_temporary} = {peeked};")
            builder.add_user("if ({object_temporary} == 0) {object_temporary} = &{object_temporary}_scratch;")
            var peeked_target = "({object_temporary})->{c_value_name(member.name)}"
            emit_owning_assignment(peeked_target, field_type, assignment.value, scope, class_information)
            return
        }
        builder.add_user("{c_type_name(object_result_type)} {object_temporary} = {object_result.code};")
        var target_code = "({object_temporary})->{c_value_name(member.name)}"
        if guards_outside_write(target_class) {
            emit_guarded_outside_write(
                target_class,
                target_code,
                field_type,
                assignment.value,
                scope,
                class_information,
            )
        } else {
            emit_owning_assignment(target_code, field_type, assignment.value, scope, class_information)
        }
        if owns(object_result, member.object) {
            builder.add_user("{release_call(object_result_type, object_temporary)};")
        }
        return
    }
    report("unsupported assignment target")
}

func generate_statement_list(
    statements: List<Syntax.Statements.Statement>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
    function_information: Analysis.FunctionInfo,
): Boolean {
    var candidates = placement.frame_candidates(statements)
    var candidate_index = 0
    while candidate_index < candidates.count() {
        frame_candidates.append("{current_path}:{current_function}:{candidates[candidate_index]}")
        candidate_index = candidate_index + 1
    }
    var index = 0
    var ended_in_return = false
    var overlapped_reads = List<String>()
    while index < statements.count() {
        if index > 0 {
            report_template_walk(statements, index, scope, class_information)
        }
        var statement = statements[index]
        var read_name = overlapped_read_name(statement, overlapped_reads, scope, class_information)
        if read_name.is_empty() {
            join_overlapped_reads(overlapped_reads, scope)
        }
        var overlaps = overlaps_next_read(statements, index, read_name, overlapped_reads, scope, class_information)
        if overlaps {
            statement = overlapped_declaration(statement)
        }
        choose_allocator_after(statements, index)
        borrow_statements = statements
        borrow_index = index
        ended_in_return = generate_statement(statement, scope, class_information, function_information)
        pending_allocator = null
        if overlaps {
            overlapped_reads.append(read_name)
        }
        var folded_return = ended_in_return and statements[index] == Syntax.Statements.IfStatement
        index = index + 1
        if folded_return and index < statements.count() {
            undo_proofs_after_calls(scope, class_information)
            mark_rest_used(statements, index, scope)
            return true
        }
    }
    join_overlapped_reads(overlapped_reads, scope)
    undo_proofs_after_calls(scope, class_information)
    return ended_in_return
}

func overlaps_next_read(
    statements: List<Syntax.Statements.Statement>,
    index: Integer,
    read_name: String,
    overlapped_reads: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): Boolean {
    assert not read_name.is_empty() and index + 1 < statements.count()
    var pending = overlapped_reads.copy()
    pending.append(read_name)
    var next_index = index + 1
    crash statements[next_index]
    var next_name = overlapped_read_name(statements[next_index], pending, scope, class_information)
    return not next_name.is_empty()
}

func overlapped_read_name(
    statement: Syntax.Statements.Statement,
    pending: List<String>,
    scope: Scope,
    class_information: Analysis.ClassInfo,
): String {
    var declaration = shape.as_variable_declaration(statement)
    assert declaration
    assert not declaration.type_reference and declaration.value
    assert not body_assigned_paths.contains(declaration.name)
    var call = shape.as_call(declaration.value)
    assert call
    assert call.arguments.is_empty() and call.callee
    var callee = shape.as_member(call.callee)
    assert callee
    assert callee.name == "read" or callee.name == "read_line"
    crash callee.object
    var receiver_text = operand_text(callee.object)
    assert not receiver_text.is_empty() and not receiver_text.contains("(")
    var mentioned = List<String>()
    collect_statement_names(statement, mentioned)
    var index = 0
    while index < pending.count() {
        assert not mentioned.contains(pending[index])
        index = index + 1
    }
    var saved_counter = temporary_counter
    var receiver = generate_expression(callee.object, scope, class_information)
    rewind_temporaries(saved_counter)
    var receiver_type = receiver.get_type()
    var receiver_class = type_shape.as_class_ref(receiver_type)
    assert receiver_class
    var reads_file = receiver_class.c_name == "File" and callee.name == "read"
    var reads_socket = receiver_class.c_name == "Socket" and callee.name == "read_line"
    assert reads_file or reads_socket
    return declaration.name
}

func overlapped_declaration(statement: Syntax.Statements.Statement): Syntax.Statements.Statement {
    var declaration = shape.as_variable_declaration(statement)
    crash declaration
    crash declaration.value
    var call = shape.as_call(declaration.value)
    crash call
    crash call.callee
    var started_function = call.callee
    var concurrent: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression("Concurrent")
    var started_arguments = List<Syntax.Expressions.Expression>()
    started_arguments.append(started_function)
    var started: Syntax.Expressions.Expression = Syntax.Expressions.CallExpression(concurrent, started_arguments)
    var overlapped = Syntax.Statements.VariableDeclaration(declaration.name, null, started)
    overlapped.line = declaration.line
    overlapped.source_path = declaration.source_path
    var overlapped_statement: Syntax.Statements.Statement = overlapped
    return overlapped_statement
}

func join_overlapped_reads(pending: List<String>, scope: Scope) {
    var index = 0
    while index < pending.count() {
        var name = pending[index]
        var handle_type = scope.lookup_type(name)
        crash handle_type
        var handle = joinable_handle(handle_type)
        crash handle
        var joining = find_or_instantiate_function(handle, "_join")
        crash joining
        var handle_code = c_value_name(name)
        builder.add_user("{joining.c_name}({handle_code});")
        index = index + 1
    }
    pending.clear()
}

func mark_rest_used(statements: List<Syntax.Statements.Statement>, start: Integer, scope: Scope) {
    var folded_away = List<Syntax.Statements.Statement>()
    var index = start
    while index < statements.count() {
        folded_away.append(statements[index])
        index = index + 1
    }
    mark_folded_names_used(folded_away, scope)
}

func report_template_walk(
    statements: List<Syntax.Statements.Statement>,
    position: Integer,
    scope: Scope,
    class_information: Analysis.ClassInfo,
) {
    var statement = statements.get_at(position)
    var loop = shape.as_while_statement(statement)
    assert loop
    var before = statements.get_at(position - 1)
    var counter_declaration = shape.as_variable_declaration(before)
    assert counter_declaration
    var counter = counter_declaration.name
    assert starts_at_zero(before, counter)
    var list_expression = walked_list(loop, counter)
    assert list_expression
    var list_text = operand_text(list_expression)
    assert loop.body.count() >= 2
    var step = loop.body.last()
    assert is_counter_step(step, counter)
    var core = loop.body.copy()
    core.remove_last()
    var element_text = walked_element(core, list_text, counter)
    if element_text != "{list_text}[{counter}]" {
        core.remove_first()
        var mentioned = List<String>()
        collect_block_names(core, mentioned)
        assert not mentioned.contains(counter)
    }
    var walk = template_walk_of(core, element_text, list_text)
    assert walk
    assert not walk.value_names.contains(counter) and not walk.value_names.contains(element_text)
    assert walk_fits_around(walk, statements, position, counter)
    var saved_counter = temporary_counter
    var probe = generate_expression(list_expression, scope, class_information)
    rewind_temporaries(saved_counter)
    var probe_type = probe.get_type()
    var listed = type_shape.as_list(probe_type)
    assert listed
    var element = listed.get_element()
    assert walked_members_exist(element, walk.members)
    assert passed_functions_fit(walk, scope, class_information)
    var saved_line = current_line
    current_line = loop.line
    report("this 'while' walks every element of '{list_text}' only {walk.purpose}: write '{walk.replacement}'")
    current_line = saved_line
}

func walked_list(loop: Syntax.Statements.WhileStatement, counter: String): Syntax.Expressions.Expression? {
    crash loop.condition
    var condition = shape.as_binary(loop.condition)
    assert condition
    assert condition.operator == 'less'
    crash condition.left
    crash condition.right
    var counter_text = operand_text(condition.left)
    assert counter_text == counter
    var counted = shape.as_call(condition.right)
    assert counted
    assert counted.arguments.is_empty()
    crash counted.callee
    var count_call = shape.as_member(counted.callee)
    assert count_call
    assert count_call.name == "count"
    crash count_call.object
    var list_text = operand_text(count_call.object)
    assert not list_text.is_empty()
    return count_call.object
}

func walked_element(core: List<Syntax.Statements.Statement>, list_text: String, counter: String): String {
    var indexed = "{list_text}[{counter}]"
    var first = core.first()
    var read = shape.as_variable_declaration(first)
    if read and core.count() > 1 {
        crash read.value
        var read_text = operand_text(read.value)
        if read_text == indexed {
            return read.name
        }
    }
    return indexed
}

func walk_fits_around(
    walk: TemplateWalk,
    statements: List<Syntax.Statements.Statement>,
    position: Integer,
    counter: String,
): Boolean {
    var after = List<Syntax.Statements.Statement>()
    var after_index = position + 1
    while after_index < statements.count() {
        after.append(statements[after_index])
        after_index = after_index + 1
    }
    var read_after = List<String>()
    collect_block_names(after, read_after)
    assert not read_after.contains(counter)
    if not walk.result_name.is_empty() {
        var result_start = start_before(statements, position, walk.result_name)
        assert result_start
        assert is_new_list(result_start)
    }
    if not walk.total_name.is_empty() {
        var total_start = start_before(statements, position, walk.total_name)
        assert total_start
        assert is_zero_literal(total_start)
    }
    if not walk.returned_after.is_empty() {
        assert not after.is_empty()
        var next = after.first()
        var returned = shape.as_return_statement(next)
        assert returned
        assert returned.value
        var printer = Syntax.SourcePrinter()
        var returned_text = printer.source_expression(returned.value)
        assert returned_text == walk.returned_after
    }
    return true
}

func start_before(
    statements: List<Syntax.Statements.Statement>,
    position: Integer,
    name: String,
): Syntax.Expressions.Expression? {
    var index = position - 2
    while index >= 0 {
        var statement = statements.get_at(index)
        var declared = shape.as_variable_declaration(statement)
        if declared and declared.name == name {
            return declared.value
        }
        var mentioned = List<String>()
        collect_statement_names(statement, mentioned)
        assert not mentioned.contains(name)
        index = index - 1
    }
    return null
}

func is_new_list(expression: Syntax.Expressions.Expression): Boolean {
    var construction = shape.as_generic_call(expression)
    assert construction
    assert construction.arguments.is_empty()
    crash construction.callee
    var callee_text = operand_text(construction.callee)
    return callee_text == "List"
}

func walked_members_exist(element: Analysis.SpiteType, members: List<String>): Boolean {
    if members.is_empty() {
        return true
    }
    var element_class = element_class_of(element)
    assert element_class
    return members_exist(element_class, members)
}

func passed_functions_fit(walk: TemplateWalk, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    var index = 0
    while index < walk.passed_functions.count() {
        assert passed_function_fits(walk.passed_functions[index], walk.tests, scope, class_information)
        index = index + 1
    }
    return true
}

func passed_function_fits(name: String, tests: Boolean, scope: Scope, class_information: Analysis.ClassInfo): Boolean {
    var parts = name.split(".")
    if parts.count() == 1 {
        var held = scope.lookup_type(name)
        if held {
            return not tests and is_function_value_type(held)
        }
        return takes_one_argument(class_information, name, tests)
    }
    assert parts.count() == 2
    var receiver_name = parts.first()
    crash receiver_name
    var owner_type = scope.lookup_type(receiver_name)
    if not owner_type {
        var owner_field = class_information.find_field(receiver_name)
        assert owner_field
        owner_type = owner_field.get_type()
    }
    crash owner_type
    var owner_class_ref = type_shape.as_class_ref(owner_type)
    assert owner_class_ref
    var owner_class = find_class_by_c_name(owner_class_ref.c_name)
    assert owner_class
    var function_name = parts.last()
    crash function_name
    return takes_one_argument(owner_class, function_name, tests)
}

func takes_one_argument(information: Analysis.ClassInfo, name: String, tests: Boolean): Boolean {
    var function = information.find_function(name)
    assert function
    assert function.parameters.count() == 1 and not function.is_constructor
    var returned = function.get_return_type()
    return not tests or is_boolean_type(returned)
}

func is_function_value_type(held: Analysis.SpiteType): Boolean {
    var class_ref = type_shape.as_class_ref(held)
    assert class_ref
    return class_ref.has_signature
}

func passed_call(expression: Syntax.Expressions.Expression, element_text: String): String {
    var called = shape.as_call(expression)
    assert called
    assert called.arguments.count() == 1
    crash called.callee
    var argument = called.arguments.first()
    var argument_text = operand_text(argument)
    assert argument_text == element_text
    var callee_text = operand_text(called.callee)
    assert not callee_text.is_empty() and not callee_text.contains("(") and not callee_text.contains("[")
    assert not callee_text.contains(element_text) and callee_text.split(".").count() <= 2
    return callee_text
}

func passed_walk(purpose: String, replacement: String, passed: String): TemplateWalk {
    var walk = TemplateWalk(purpose, replacement)
    walk.passed_functions.append(passed)
    return walk
}

func passed_test(purpose: String, replacement: String, passed: String): TemplateWalk {
    var walk = passed_walk(purpose, replacement, passed)
    walk.tests = true
    return walk
}

func members_exist(element_class: Analysis.ClassInfo, members: List<String>): Boolean {
    var index = 0
    while index < members.count() {
        var member_type = member_type_of(element_class, members[index])
        assert member_type
        index = index + 1
    }
    return true
}

func template_walk_of(core: List<Syntax.Statements.Statement>, element_text: String, list_text: String): TemplateWalk? {
    if core.count() == 2 {
        return walk_through_local(core, element_text, list_text)
    }
    assert core.count() == 1
    var only = core.first()
    crash only
    switch only {
        Syntax.Statements.ExpressionStatement: return walk_by_call(only, element_text, list_text)
        Syntax.Statements.AssignmentStatement: return walk_by_sum(only, element_text, list_text)
        Syntax.Statements.IfStatement: return walk_by_test(only, element_text, list_text)
        _: return null
    }
}

func element_member(expression: Syntax.Expressions.Expression, element_text: String): String {
    var read = expression
    var called = shape.as_call(expression)
    if called {
        assert called.arguments.is_empty()
        crash called.callee
        read = called.callee
    }
    var member = shape.as_member(read)
    assert member
    crash member.object
    var object_text = operand_text(member.object)
    assert object_text == element_text
    assert not member.name.starts_with("_")
    return member.name
}

func append_call(statement: Syntax.Statements.Statement): Syntax.Expressions.CallExpression? {
    var expression_statement = shape.as_expression_statement(statement)
    assert expression_statement
    crash expression_statement.value
    var called = shape.as_call(expression_statement.value)
    assert called
    assert called.arguments.count() == 1
    crash called.callee
    var callee = shape.as_member(called.callee)
    assert callee
    assert callee.name == "append"
    crash callee.object
    var receiver = shape.as_identifier(callee.object)
    assert receiver
    return called
}

func appended_to(appending: Syntax.Expressions.CallExpression): String {
    crash appending.callee
    var callee = shape.as_member(appending.callee)
    crash callee
    crash callee.object
    return operand_text(callee.object)
}

func walk_by_call(
    statement: Syntax.Statements.ExpressionStatement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    crash statement.value
    var called = shape.as_call(statement.value)
    assert called
    var member = element_member(statement.value, element_text)
    if not member.is_empty() {
        var each = TemplateWalk("to call '{member}' on each", "{list_text}.each_{member}()")
        each.members.append(member)
        return each
    }
    var appending = append_call(statement)
    if not appending {
        var passed = passed_call(statement.value, element_text)
        assert not passed.is_empty()
        return passed_walk("to call '{passed}' with each", "{list_text}.each({passed})", passed)
    }
    crash appending
    var result = appended_to(appending)
    assert result != list_text
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    if appended_text == element_text {
        var copied = TemplateWalk("to copy it", "var {result} = {list_text}.copy()")
        copied.result_name = result
        return copied
    }
    var mapped_member = element_member(appended, element_text)
    if mapped_member.is_empty() {
        var mapper = passed_call(appended, element_text)
        assert not mapper.is_empty()
        var mapped_by = passed_walk(
            "to collect what '{mapper}' answers for each",
            "var {result} = {list_text}.map({mapper})",
            mapper,
        )
        mapped_by.result_name = result
        return mapped_by
    }
    var mapped = TemplateWalk("to collect each '{mapped_member}'", "var {result} = {list_text}.map_{mapped_member}()")
    mapped.members.append(mapped_member)
    mapped.result_name = result
    return mapped
}

func walk_through_local(
    core: List<Syntax.Statements.Statement>,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    var first = core.first()
    var declared = shape.as_variable_declaration(first)
    assert declared
    crash declared.value
    var member = element_member(declared.value, element_text)
    var last = core.last()
    var appending = append_call(last)
    assert appending
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    assert appended_text == declared.name
    var result = appended_to(appending)
    assert result != list_text
    if member.is_empty() {
        var mapper = passed_call(declared.value, element_text)
        assert not mapper.is_empty()
        var mapped_by = passed_walk(
            "to collect what '{mapper}' answers for each",
            "var {result} = {list_text}.map({mapper})",
            mapper,
        )
        mapped_by.result_name = result
        return mapped_by
    }
    var mapped = TemplateWalk("to collect each '{member}'", "var {result} = {list_text}.map_{member}()")
    mapped.members.append(member)
    mapped.result_name = result
    return mapped
}

func walk_by_sum(
    statement: Syntax.Statements.AssignmentStatement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    crash statement.target
    crash statement.value
    var total = shape.as_identifier(statement.target)
    assert total
    var added = shape.as_binary(statement.value)
    assert added
    assert added.operator == 'add'
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    assert left_text == total.name
    var member = element_member(added.right, element_text)
    if member.is_empty() {
        var adder = passed_call(added.right, element_text)
        assert not adder.is_empty()
        var summed_by = passed_walk(
            "to add up what '{adder}' answers for each",
            "var {total.name} = {list_text}.sum({adder})",
            adder,
        )
        summed_by.total_name = total.name
        return summed_by
    }
    var summed = TemplateWalk("to add up '{member}'", "var {total.name} = {list_text}.sum_{member}()")
    summed.members.append(member)
    summed.total_name = total.name
    return summed
}

func walk_by_test(statement: Syntax.Statements.IfStatement, element_text: String, list_text: String): TemplateWalk? {
    assert not statement.has_else_branch and statement.then_branch.count() == 1
    crash statement.condition
    var action = statement.then_branch.first()
    var tested = element_member(statement.condition, element_text)
    if not tested.is_empty() {
        return walk_by_kept(action, tested, element_text, list_text)
    }
    var tester = passed_call(statement.condition, element_text)
    if not tester.is_empty() {
        return walk_by_passed_test(action, tester, element_text, list_text)
    }
    var negated = shape.as_unary(statement.condition)
    if negated {
        return walk_by_every(negated, action, element_text, list_text)
    }
    var compared = shape.as_binary(statement.condition)
    assert compared
    return walk_by_find(compared, action, element_text, list_text)
}

func walk_by_kept(
    action: Syntax.Statements.Statement,
    tested: String,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    var returned = shape.as_return_statement(action)
    if returned {
        assert returned.value
        assert shape.is_true_literal(returned.value)
        var any = TemplateWalk("to ask whether any element's '{tested}' is true", "return {list_text}.any_{tested}()")
        any.members.append(tested)
        any.returned_after = "false"
        return any
    }
    var counted = shape.as_assignment_statement(action)
    if counted {
        return walk_by_count(counted, tested, list_text)
    }
    var appending = append_call(action)
    assert appending
    var result = appended_to(appending)
    assert result != list_text
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    if appended_text == element_text {
        var kept = TemplateWalk(
            "to keep the elements whose '{tested}' is true",
            "var {result} = {list_text}.filter_{tested}()",
        )
        kept.members.append(tested)
        kept.result_name = result
        return kept
    }
    var mapped_member = element_member(appended, element_text)
    assert not mapped_member.is_empty()
    var kept_and_mapped = TemplateWalk(
        "to collect '{mapped_member}' of the elements whose '{tested}' is true",
        "var {result} = {list_text}.filter_{tested}().map_{mapped_member}()",
    )
    kept_and_mapped.members.append(tested)
    kept_and_mapped.members.append(mapped_member)
    kept_and_mapped.result_name = result
    return kept_and_mapped
}

func walk_by_passed_test(
    action: Syntax.Statements.Statement,
    tester: String,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    var returned = shape.as_return_statement(action)
    if returned {
        assert returned.value
        if shape.is_true_literal(returned.value) {
            var any = passed_test(
                "to ask whether '{tester}' is true for any element",
                "return {list_text}.any({tester})",
                tester,
            )
            any.returned_after = "false"
            return any
        }
        var returned_text = operand_text(returned.value)
        assert returned_text == element_text
        var found = passed_test(
            "to find the first element '{tester}' is true for",
            "return {list_text}.find({tester})",
            tester,
        )
        found.returned_after = "null"
        return found
    }
    var counted = shape.as_assignment_statement(action)
    if counted {
        return walk_by_passed_count(counted, tester, list_text)
    }
    var appending = append_call(action)
    assert appending
    var result = appended_to(appending)
    assert result != list_text
    var appended = appending.arguments.first()
    var appended_text = operand_text(appended)
    assert appended_text == element_text
    var kept = passed_test(
        "to keep the elements '{tester}' is true for",
        "var {result} = {list_text}.filter({tester})",
        tester,
    )
    kept.result_name = result
    return kept
}

func walk_by_passed_count(
    counted: Syntax.Statements.AssignmentStatement,
    tester: String,
    list_text: String,
): TemplateWalk? {
    crash counted.target
    crash counted.value
    var total = shape.as_identifier(counted.target)
    assert total
    var added = shape.as_binary(counted.value)
    assert added
    assert added.operator == 'add'
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    assert left_text == total.name
    var step = shape.as_integer_literal(added.right)
    assert step
    assert step.value == 1
    var counting = passed_test(
        "to count the elements '{tester}' is true for",
        "var {total.name} = {list_text}.count({tester})",
        tester,
    )
    counting.total_name = total.name
    return counting
}

func walk_by_count(counted: Syntax.Statements.AssignmentStatement, tested: String, list_text: String): TemplateWalk? {
    crash counted.target
    crash counted.value
    var total = shape.as_identifier(counted.target)
    assert total
    var added = shape.as_binary(counted.value)
    assert added
    assert added.operator == 'add'
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    assert left_text == total.name
    var step = shape.as_integer_literal(added.right)
    assert step
    assert step.value == 1
    var counting = TemplateWalk(
        "to count the elements whose '{tested}' is true",
        "var {total.name} = {list_text}.count_{tested}()",
    )
    counting.members.append(tested)
    counting.total_name = total.name
    return counting
}

func walk_by_every(
    negated: Syntax.Expressions.UnaryExpression,
    action: Syntax.Statements.Statement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    assert negated.operator == 'logical_not'
    crash negated.operand
    var tested = element_member(negated.operand, element_text)
    var returned = shape.as_return_statement(action)
    assert returned
    assert returned.value
    assert shape.is_false_literal(returned.value)
    if tested.is_empty() {
        var tester = passed_call(negated.operand, element_text)
        assert not tester.is_empty()
        var every_passed = passed_test(
            "to ask whether '{tester}' is true for every element",
            "return {list_text}.all({tester})",
            tester,
        )
        every_passed.returned_after = "true"
        return every_passed
    }
    var every = TemplateWalk("to ask whether every element's '{tested}' is true", "return {list_text}.all_{tested}()")
    every.members.append(tested)
    every.returned_after = "true"
    return every
}

func walk_by_find(
    compared: Syntax.Expressions.BinaryExpression,
    action: Syntax.Statements.Statement,
    element_text: String,
    list_text: String,
): TemplateWalk? {
    assert compared.operator == 'equal'
    crash compared.left
    crash compared.right
    var tested = element_member(compared.left, element_text)
    assert not tested.is_empty()
    var returned = shape.as_return_statement(action)
    assert returned
    assert returned.value
    var returned_text = operand_text(returned.value)
    assert returned_text == element_text
    var printer = Syntax.SourcePrinter()
    var value_text = printer.source_expression(compared.right)
    var found = TemplateWalk(
        "to find the first whose '{tested}' equals '{value_text}'",
        "return {list_text}.find_by_{tested}({value_text})",
    )
    found.members.append(tested)
    found.returned_after = "null"
    collect_mentioned_names(compared.right, found.value_names)
    return found
}

func starts_at_zero(before: Syntax.Statements.Statement, counter: String): Boolean {
    var declared = shape.as_variable_declaration(before)
    if declared {
        crash declared.value
        return declared.name == counter and is_zero_literal(declared.value)
    }
    var assigned = shape.as_assignment_statement(before)
    assert assigned
    crash assigned.target
    crash assigned.value
    var target_text = operand_text(assigned.target)
    return target_text == counter and is_zero_literal(assigned.value)
}

func is_zero_literal(expression: Syntax.Expressions.Expression): Boolean {
    var integer = shape.as_integer_literal(expression)
    assert integer
    return integer.value == 0
}

func is_counter_step(statement: Syntax.Statements.Statement, counter: String): Boolean {
    var assignment = shape.as_assignment_statement(statement)
    assert assignment
    crash assignment.target
    crash assignment.value
    var target_text = operand_text(assignment.target)
    assert target_text == counter
    var added = shape.as_binary(assignment.value)
    assert added
    assert added.operator == 'add'
    crash added.left
    crash added.right
    var left_text = operand_text(added.left)
    var right = shape.as_integer_literal(added.right)
    assert right
    return left_text == counter and right.value == 1
}

func signature_is_dictated(function: Analysis.FunctionInfo): Boolean {
    if not function.symbol_name.is_empty() {
        return true
    }
    if not function.source_path.is_empty() {
        return true
    }
    if function.name.starts_with("set_") or function.name.starts_with("get_") {
        return true
    }
    var dictated = [
        "sum"
        "subtract"
        "multiply"
        "divide"
        "remainder"
        "equals"
        "less_than"
        "greater_than"
        "negate"
        "get_at"
        "set_at"
    ]
    return dictated.contains(function.name)
}

func is_lowercase_name(name: String): Boolean {
    var index = 0
    while index < name.length() {
        var code = name.code_at(index)
        var is_lower = code >= 97 and code <= 122
        var is_digit = code >= 48 and code <= 57
        assert is_lower or is_digit or code == 95
        index = index + 1
    }
    return true
}

func is_pascal_name(name: String): Boolean {
    assert not name.is_empty()
    var first = name.code_at(0)
    assert first >= 65 and first <= 90
    return not name.contains("_")
}

func words_of(name: String): List<String> {
    var words = List<String>()
    var current = ""
    var index = 0
    while index < name.length() {
        var code = name.code_at(index)
        var is_upper = code >= 65 and code <= 90
        if code == 95 or is_upper {
            if not current.is_empty() {
                words.append(current)
            }
            current = ""
        }
        if code != 95 {
            current = current + name.character_at(index).lower_case()
        }
        index = index + 1
    }
    if not current.is_empty() {
        words.append(current)
    }
    return words
}

