var name = ""
var spite_type: Analysis.SpiteType? = null
var framed = false
var framed_cleanup = ""
var framed_object = false

func OwnedLocal(starting_name: String, starting_spite_type: Analysis.SpiteType) {
    name = starting_name
    spite_type = starting_spite_type
}

func get_type(): Analysis.SpiteType {
    crash spite_type
    return spite_type
}
