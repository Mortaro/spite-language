func header(): String {
    var lines = [
        "/* The floor: the only C the Spite compiler writes by hand. Everything above it"
        " * is Spite from library/, and the tree shaker drops what a program never calls. */"
        ""
        "#include <stdint.h>"
        "#include <stdbool.h>"
        "#include <stdio.h>"
        "#include <stdlib.h>"
        "#include <string.h>"
        "#include <ctype.h>"
        ""
        "#ifdef _WIN32"
        "#ifndef WIN32_LEAN_AND_MEAN"
        "#define WIN32_LEAN_AND_MEAN"
        "#endif"
        "#include <fcntl.h>"
        "#include <io.h>"
        "#include <direct.h>"
        "#include <windows.h>"
        "#include <malloc.h>"
        "#else"
        "#include <dirent.h>"
        "#include <sys/stat.h>"
        "#include <time.h>"
        "#include <unistd.h>"
        "#include <dlfcn.h>"
        "#endif"
        ""
        "/* A program that starts a thread (a Task, or a --repl-port build) counts references atomically, and the"
        " * compiler defines SPITE_THREADS for it; every other program counts them with plain arithmetic. */"
        "#ifdef SPITE_THREADS"
        "#define SPITE_COUNT_UP(count) __atomic_add_fetch(&(count), 1, __ATOMIC_RELAXED)"
        "#define SPITE_COUNT_DOWN(count) __atomic_sub_fetch(&(count), 1, __ATOMIC_ACQ_REL)"
        "#define SPITE_THREAD_LOCAL _Thread_local"
        "#define SPITE_SINGLETON_FOUND(cache) __atomic_load_n(&(cache), __ATOMIC_ACQUIRE)"
        "#define SPITE_SINGLETON_PUBLISH(cache, made) __atomic_store_n(&(cache), (made), __ATOMIC_RELEASE)"
        "#define SPITE_LOCK(lock) while (__atomic_exchange_n(&(lock), 1, __ATOMIC_ACQUIRE) != 0) \{}"
        "#define SPITE_UNLOCK(lock) __atomic_store_n(&(lock), 0, __ATOMIC_RELEASE)"
        "#else"
        "#define SPITE_COUNT_UP(count) ((count) = (count) + 1)"
        "#define SPITE_COUNT_DOWN(count) ((count) = (count) - 1)"
        "#define SPITE_THREAD_LOCAL"
        "#define SPITE_SINGLETON_FOUND(cache) (cache)"
        "#define SPITE_SINGLETON_PUBLISH(cache, made) ((cache) = (made))"
        "#define SPITE_LOCK(lock) (void)(lock)"
        "#define SPITE_UNLOCK(lock) (void)(lock)"
        "#endif"
        ""
        "/* ---- allocation ---- */"
        ""
        "/* Every Spite object is built on these. A library --hot-reload compiles for a running program"
        " * (SPITE_RELOADED) allocates through that program, which it is handed when it is loaded; otherwise the"
        " * compiler writes what this build needs in place of the comment below (docs/memory.md). */"
        "#ifdef SPITE_RELOADED"
        "static void* (*spite_host_realloc)(void* pointer, size_t size) = 0;"
        "static void (*spite_host_free)(void* pointer) = 0;"
        "#define SPITE_REALLOC(pointer, size) spite_host_realloc(pointer, size)"
        "#define SPITE_FREE(pointer) spite_host_free(pointer)"
        "#define SPITE_MALLOC(size) spite_host_realloc(0, size)"
        "#else"
        "/*spite_allocator*/"
        "#endif"
        ""
        "/* ---- object model: reference counting (milestone 9a) ----"
        " *"
        " * D1 (Mortaro, 2026-09-19): reference counting is the default memory model."
        " * Every non-scalar value (class instance, List<T>, Dictionary<T>, String,"
        " * an object literal) is a heap object whose first field is a `SpiteHeader`;"
        " * variables/attributes/elements/parameters hold pointers to these objects."
        " * Passing, assigning, storing and returning share the same object -- a copy"
        " * is only ever made by an explicit `copy()`/`deep_copy()` call"
        " * (docs/memory.md)."
        " *"
        " * Each concrete type gets its own small, readable, generated"
        " * `\{Type}___retain`/`\{Type}___release` pair; this"
        " * header only holds what is shared: the header layout itself. */"
        ""
        "typedef struct SpiteHeader \{"
        "    int32_t ref_count;"
        "    int32_t class_id;"
        "} SpiteHeader;"
        ""
        "/* String's layout is written after the enums, from the attributes library/string.spite declares. */"
        "typedef struct SpiteString SpiteString;"
    ]
    return lines.join("\n")
}

func table_allocator(): String {
    var lines = [
        "/* --debug-memory: every allocation goes through the live table, which is Spite"
        " * (library/allocation_table.spite) called by functions the compiler writes after the classes. */"
        "void* spite_debug_realloc(void* pointer, size_t size);"
        "void spite_debug_free(void* pointer);"
        "void spite_debug_register_object(void* pointer, int32_t class_id);"
        "void spite_debug_set_class_names(const char* const* names, int64_t count);"
        "void spite_debug_report(void);"
        "int64_t spite_live_allocation_count(void);"
        "#define SPITE_REALLOC(pointer, size) spite_debug_realloc(pointer, size)"
        "#define SPITE_FREE(pointer) spite_debug_free(pointer)"
        "#define SPITE_MALLOC(size) spite_debug_realloc(0, size)"
    ]
    return lines.join("\n")
}

func counted_allocator(): String {
    var lines = [
        "/* The program reads Memory.Heap.live_allocations(), so allocations are counted. */"
        "static int64_t spite_live_allocations = 0;"
        "static void* spite_counted_realloc(void* pointer, size_t size) \{"
        "    void* result = realloc(pointer, size);"
        "    if (pointer == 0 && result != 0) SPITE_COUNT_UP(spite_live_allocations);"
        "    return result;"
        "}"
        "static void spite_counted_free(void* pointer) \{"
        "    if (pointer == 0) return;"
        "    SPITE_COUNT_DOWN(spite_live_allocations);"
        "    free(pointer);"
        "}"
        "static int64_t spite_live_allocation_count(void) \{ return spite_live_allocations; }"
        "#define SPITE_REALLOC(pointer, size) spite_counted_realloc(pointer, size)"
        "#define SPITE_FREE(pointer) spite_counted_free(pointer)"
        "#define SPITE_MALLOC(size) spite_counted_realloc(0, size)"
    ]
    return lines.join("\n")
}

func plain_allocator(): String {
    var lines = [
        "#define SPITE_REALLOC(pointer, size) realloc(pointer, size)"
        "#define SPITE_FREE(pointer) free(pointer)"
        "#define SPITE_MALLOC(size) malloc(size)"
    ]
    return lines.join("\n")
}

func structs(): String {
    var lines = [
        "typedef struct \{"
        "    int64_t count;"
        "    const char** items;"
        "} SpiteArguments;"
        ""
        "static SpiteArguments spite_program_arguments;"
    ]
    return lines.join("\n")
}

func prototypes(): String {
    var lines = [
        "int64_t SpiteArguments_count(SpiteArguments* self);"
        "SpiteString* SpiteArguments_get(SpiteArguments* self, int64_t index);"
        "SpiteString* SpiteArguments_lookup(SpiteArguments* self, const char* key);"
    ]
    return lines.join("\n")
}

func bodies(): String {
    var lines = [
        "int64_t SpiteArguments_count(SpiteArguments* self) \{"
        "    return self->count;"
        "}"
        ""
        "SpiteString* SpiteArguments_get(SpiteArguments* self, int64_t index) \{"
        "    if (index < 0 || index >= self->count) return (&spite_static_string_empty);"
        "    return spite_string_from_cstring_owned(self->items[index]);"
        "}"
        ""
        "SpiteString* SpiteArguments_lookup(SpiteArguments* self, const char* key) \{"
        "    int64_t key_length = (int64_t)strlen(key);"
        "    for (int64_t index = 0; index < self->count; index = index + 1) \{"
        "        const char* item = self->items[index];"
        "        if (strcmp(item, \"--\") == 0) return 0;"
        "        if (strncmp(item, \"--\", 2) == 0 && strncmp(item + 2, key, (size_t)key_length) == 0 && item[2 + key_length] == '=') \{"
        "            return spite_string_from_cstring_owned(item + 2 + key_length + 1);"
        "        }"
        "    }"
        "    return 0;"
        "}"
    ]
    return lines.join("\n")
}

func path(): String {
    return "bootstrap/source/generation/prelude.spite"
}

func reopened_classes(): List<String> {
    var classes = [
        "console"
        "memory/heap"
        "memory/address"
        "typed_memory"
        "dynamic_library"
        "hot_reload"
        "concurrent"
        "thread_pool"
        "scheduler"
        "spite/attribute"
        "spite/function"
    ]
    var numbers = number_classes()
    var index = 0
    while index < numbers.count() {
        classes.append(numbers[index])
        index = index + 1
    }
    return classes
}

func number_classes(): List<String> {
    return [
        "integer"
        "long"
        "float"
        "double"
        "boolean"
        "tiny"
        "short"
        "byte"
        "unsigned_short"
        "unsigned_integer"
        "unsigned_long"
    ]
}

func number_members(stem: String): List<String> {
    var words = stem.split("_")
    var type_name = ""
    var index = 0
    while index < words.count() {
        var word = words[index]
        var word_length = word.length()
        type_name = "{type_name}{word.slice(0, 1).upper_case()}{word.slice(1, word_length)}"
        index = index + 1
    }
    var members = [
        "func from_type(type: Symbol, value: type.class): {type_name}"
        "written per type by the generator: a C cast"
    ]
    var whole_numbers = [
        "tiny"
        "short"
        "integer"
        "long"
        "byte"
        "unsigned_short"
        "unsigned_integer"
        "unsigned_long"
    ]
    var widths = [8, 16, 32, 64, 8, 16, 32, 64]
    var is_signed = not stem.starts_with("unsigned_") and stem != "byte"
    var index = 0
    while index < whole_numbers.count() {
        if whole_numbers[index] == stem {
            var width = widths.get_at(index)
            var bitwise = bitwise_members(type_name, width, is_signed)
            var member_index = 0
            while member_index < bitwise.count() {
                members.append(bitwise[member_index])
                member_index = member_index + 1
            }
        }
        index = index + 1
    }
    return members
}

func bitwise_members(type_name: String, width: Integer, is_signed: Boolean): List<String> {
    var value_type = "uint{width}_t"
    var right_shift = "if (count_ >= {width}) return 0;\nreturn ({value_type})(self >> count_);"
    if is_signed {
        value_type = "int{width}_t"
        var last_bit = width - 1
        right_shift = "if (count_ > {last_bit}) count_ = {last_bit};\nreturn ({value_type})(self < 0 ? ~(~self >> count_) : self >> count_);"
    }
    var bits_type = "uint{width}_t"
    var left_crash = negative_count_crash(type_name, "shifted_left")
    var right_crash = negative_count_crash(type_name, "shifted_right")
    var above_width = 64 - width
    return [
        "func shifted_left(count: Integer): {type_name}"
        "{left_crash}if (count_ >= {width}) return 0;\nreturn ({value_type})({bits_type})(({bits_type})self << count_);"
        "func shifted_right(count: Integer): {type_name}"
        "{right_crash}{right_shift}"
        "func bits_and(other: {type_name}): {type_name}"
        "return ({value_type})(self & other_);"
        "func bits_or(other: {type_name}): {type_name}"
        "return ({value_type})(self | other_);"
        "func bits_exclusive_or(other: {type_name}): {type_name}"
        "return ({value_type})(self ^ other_);"
        "func bits_inverted(): {type_name}"
        "return ({value_type})~self;"
        "func set_bit_count(): Integer"
        "return (int32_t)__builtin_popcountll((uint64_t)({bits_type})self);"
        "func leading_zero_count(): Integer"
        "if (({bits_type})self == 0) return {width};\nreturn (int32_t)__builtin_clzll((uint64_t)({bits_type})self) - {above_width};"
        "func trailing_zero_count(): Integer"
        "if (({bits_type})self == 0) return {width};\nreturn (int32_t)__builtin_ctzll((uint64_t)({bits_type})self);"
    ]
}

func negative_count_crash(type_name: String, name: String): String {
    return "if (count_ < 0) \{\nfflush(stdout);\nfprintf(stderr, \"spite: {type_name}.{name} was given the count %d, and a shift count is 0 or more\\n\", (int)count_);\nexit(1);\n}\n"
}

func reopening(stem: String): String {
    var members = supplied_members(stem)
    var lines = List<String>()
    var index = 0
    while index < members.count() {
        lines.append(members[index])
        index = index + 2
    }
    var joined_lines = lines.join("\n")
    return "{joined_lines}\n"
}

func supplied_body(stem: String, name: String): String? {
    var members = supplied_members(stem)
    var index = 0
    while index < members.count() - 1 {
        if members[index].starts_with("func {name}(") {
            var body_index = index + 1
            return members[body_index]
        }
        index = index + 2
    }
    return null
}

func supplied_members(stem: String): List<String> {
    if stem == "console" {
        return console_members()
    }
    if stem == "memory/heap" {
        return heap_members()
    }
    if stem == "memory/address" {
        return address_members()
    }
    if stem == "typed_memory" {
        return typed_memory_members()
    }
    if stem == "concurrent" {
        return concurrent_members()
    }
    if stem == "thread_pool" {
        return task_members()
    }
    if stem == "scheduler" {
        return scheduler_members()
    }
    var numbers = number_classes()
    if numbers.contains(stem) {
        return number_members(stem)
    }
    if stem == "dynamic_library" {
        return dynamic_library_members()
    }
    if stem == "hot_reload" {
        return hot_reload_members()
    }
    if stem == "spite/attribute" {
        return attribute_members()
    }
    if stem == "spite/function" {
        return function_members()
    }
    return List<String>()
}

func console_members(): List<String> {
    return [
        "func _write_output(text: String)"
        "fwrite((const char*)(intptr_t)text_->_bytes_, 1, (size_t)text_->_length_, stdout);\nSpiteString___release(text_);"
        "func _write_error(text: String)"
        "fwrite((const char*)(intptr_t)text_->_bytes_, 1, (size_t)text_->_length_, stderr);\nSpiteString___release(text_);"
        "func flush()"
        "fflush(stdout);\nfflush(stderr);"
    ]
}

func heap_members(): List<String> {
    return [
        "func allocate(bytes: Long): Memory.Address"
        "return (int64_t)(intptr_t)SPITE_MALLOC((size_t)bytes_);"
        "func resize(address: Memory.Address, bytes: Long): Memory.Address"
        "return (int64_t)(intptr_t)SPITE_REALLOC((void*)(intptr_t)address_, (size_t)bytes_);"
        "func free(address: Memory.Address)"
        "SPITE_FREE((void*)(intptr_t)address_);"
        "func live_allocations(): Integer"
        "return (int32_t)spite_live_allocation_count();"
    ]
}

func address_members(): List<String> {
    var members = [
        "func from_type(type: Symbol, value: type.class): Memory.Address"
        "written per type by the generator: a C cast"
        "func copy_to(target: Memory.Address, bytes: Long)"
        "written by the generator: one machine operation"
        "func compare_bytes(other: Memory.Address, bytes: Long): Integer"
        "written by the generator: one machine operation"
        "func exchange_long(offset: Long, value: Long): Long"
        "written by the generator: one machine operation"
        "func read_long_atomically(offset: Long): Long"
        "written by the generator: one machine operation"
        "func write_long_atomically(offset: Long, value: Long)"
        "written by the generator: one machine operation"
    ]
    var types = ["Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "Float", "Double"]
    var words = ["byte", "short", "unsigned_short", "integer", "unsigned_integer", "long", "float", "double"]
    var index = 0
    while index < types.count() {
        var type_name = types.get_at(index)
        var word = words.get_at(index)
        members.append("func read_{word}(offset: Long): {type_name}")
        members.append("written by the generator: one machine operation")
        members.append("func write_{word}(offset: Long, value: {type_name})")
        members.append("written by the generator: one machine operation")
        index = index + 1
    }
    return members
}

func task_members(): List<String> {
    return [
        "func entry_address(): Long"
        "written by the generator: the address of the thread entry that runs this class"
        "func address(): Long"
        "written by the generator: the address of the object itself"
    ]
}

func concurrent_members(): List<String> {
    return [
        "func _start_frame(): Long"
        "written by the generator: the state machine of the work, or 0 when the work never waits"
        "func _frame_result(): $result_type"
        "written per result type by the generator: takes the result out of a finished state machine"
    ]
}

func scheduler_members(): List<String> {
    return [
        "func step_frame(frame: Long): Boolean"
        "return (*(bool (**)(void*))(intptr_t)frame_)((void*)(intptr_t)frame_);"
    ]
}

func typed_memory_members(): List<String> {
    return [
        "func read_value(address: Memory.Address, index: Integer): $value_type"
        "written per value type by the generator"
        "func write_value(address: Memory.Address, index: Integer, value: $value_type)"
        "written per value type by the generator"
        "func release_value(address: Memory.Address, index: Integer)"
        "written per value type by the generator"
        "func value_bytes(): Long"
        "written per value type by the generator"
    ]
}

func dynamic_library_members(): List<String> {
    return [
        "func open_library(file: String): Long"
        "#ifdef _WIN32\nvoid* opened = (void*)LoadLibraryA((const char*)(intptr_t)file_->_bytes_);\n#else\nvoid* opened = dlopen((const char*)(intptr_t)file_->_bytes_, RTLD_NOW);\n#endif\nif (opened == 0) \{\nfflush(stdout);\nfprintf(stderr, \"spite: could not open the library '%s'\\n\", (const char*)(intptr_t)file_->_bytes_);\nexit(1);\n}\nSpiteString___release(file_);\nreturn (int64_t)(intptr_t)opened;"
        "func find_symbol(name: String, wanted_by: String): Long"
        "#ifdef _WIN32\nvoid* found = (void*)GetProcAddress((HMODULE)(intptr_t)self->handle_, (const char*)(intptr_t)name_->_bytes_);\n#else\nvoid* found = dlsym((void*)(intptr_t)self->handle_, (const char*)(intptr_t)name_->_bytes_);\n#endif\nif (found == 0) \{\nfflush(stdout);\nfprintf(stderr, \"spite: the library '%s' has no '%s', which %s calls\\n\", (const char*)(intptr_t)self->file_name_->_bytes_, (const char*)(intptr_t)name_->_bytes_, (const char*)(intptr_t)wanted_by_->_bytes_);\nexit(1);\n}\nSpiteString___release(name_);\nSpiteString___release(wanted_by_);\nreturn (int64_t)(intptr_t)found;"
        "func close_library(opened: Long)"
        "if (opened_ == 0) return;\n#ifdef _WIN32\nFreeLibrary((HMODULE)(intptr_t)opened_);\n#else\ndlclose((void*)(intptr_t)opened_);\n#endif"
    ]
}

func hot_reload_members(): List<String> {
    return [
        "func compiler(): String"
        "written per build by the generator: the compiler that built the program"
        "func build_arguments(): String"
        "written per build by the generator: what that compiler was given, one per line"
        "func program_file(): String"
        "written per build by the generator: the executable it wrote"
        "func watcher_entry(): Long"
        "written per build by the generator: the address of the watcher thread's entry"
        "func open(file: String): Long"
        "#ifdef _WIN32\nvoid* opened = (void*)LoadLibraryA((const char*)(intptr_t)file_->_bytes_);\n#else\nvoid* opened = dlopen((const char*)(intptr_t)file_->_bytes_, RTLD_NOW);\n#endif\nSpiteString___release(file_);\nreturn (int64_t)(intptr_t)opened;"
        "func install(library: Long): String"
        "written per build by the generator: binds the library to the program and swaps its functions in"
    ]
}

func attribute_members(): List<String> {
    return [
        "func value_attributes(): List<Spite.Attribute>"
        "if (self->spite_held != 0 && self->spite_held_attributes != 0) return self->spite_held_attributes(self->spite_held);\nreturn List_Spite_Attribute___make();"
        "func value_functions(): List<Spite.Function>"
        "if (self->spite_held != 0 && self->spite_held_functions != 0) return self->spite_held_functions(self->spite_held);\nreturn List_Spite_Function___make();"
        "func assign(text: String): Boolean"
        "bool assigned = false;\nif (self->spite_owner != 0 && self->spite_assign != 0) assigned = self->spite_assign(self->spite_owner, text_);\nSpiteString___release(text_);\nreturn assigned;"
    ]
}

func function_members(): List<String> {
    return [
        "func call_function()"
        "if (self->spite_call != 0) self->spite_call(self->spite_owner);"
        "func call_with_text(arguments: List<String>): Spite.Attribute?"
        "Spite_Attribute* result = 0;\nif (self->spite_text_call != 0) result = ((Spite_Attribute* (*)(void*, List_String*))self->spite_text_call)(self->spite_owner, arguments_);\nList_String___release(arguments_);\nreturn result;"
    ]
}
