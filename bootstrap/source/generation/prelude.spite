func header(): String {
    var lines = [
        "/* The floor: the only C the Spite compiler writes by hand. Everything above it"
        " * is Spite from library/, and the tree shaker drops what a program never calls. */"
        ""
        "#include <stdint.h>"
        "#include <stdbool.h>"
        "#include <stdio.h>"
        "#include <stdlib.h>"
        "#include <string.h>"
        "#include <ctype.h>"
        ""
        "#ifdef _WIN32"
        "#ifndef WIN32_LEAN_AND_MEAN"
        "#define WIN32_LEAN_AND_MEAN"
        "#endif"
        "#include <fcntl.h>"
        "#include <io.h>"
        "#include <direct.h>"
        "#include <windows.h>"
        "#include <malloc.h>"
        "#define SPITE_ALLOCA(size) _alloca(size)"
        "#else"
        "#include <alloca.h>"
        "#define SPITE_ALLOCA(size) alloca(size)"
        "#include <dirent.h>"
        "#include <sys/stat.h>"
        "#include <time.h>"
        "#include <unistd.h>"
        "#include <dlfcn.h>"
        "#endif"
        ""
        "/* A program that starts a thread (a Task, or a --repl-port build) counts references atomically, and the"
        " * compiler defines SPITE_THREADS for it; every other program counts them with plain arithmetic. */"
        "#ifdef SPITE_THREADS"
        "#define SPITE_COUNT_UP(count) __atomic_add_fetch(&(count), 1, __ATOMIC_RELAXED)"
        "#define SPITE_COUNT_DOWN(count) __atomic_sub_fetch(&(count), 1, __ATOMIC_ACQ_REL)"
        "#define SPITE_THREAD_LOCAL _Thread_local"
        "#else"
        "#define SPITE_COUNT_UP(count) ((count) = (count) + 1)"
        "#define SPITE_COUNT_DOWN(count) ((count) = (count) - 1)"
        "#define SPITE_THREAD_LOCAL"
        "#endif"
        ""
        "/* ---- allocation counters (--debug-memory) ---- */"
        ""
        "/* Under --debug-memory the live table is Spite (library/allocation_table.spite): these are the functions the"
        " * compiler emits to call it, defined after the classes. The table's own memory comes from the C allocator"
        " * directly, so tracking never tracks itself. Without --debug-memory an allocation stays one realloc and a"
        " * counter, which is the floor every Spite object is built on. */"
        "#ifdef SPITE_DEBUG_MEMORY"
        "void* spite_debug_realloc(void* pointer, size_t size);"
        "void spite_debug_free(void* pointer);"
        "void spite_debug_register_object(void* pointer, int32_t class_id);"
        "void spite_debug_set_class_names(const char* const* names, int64_t count);"
        "void spite_debug_report(void);"
        "int64_t spite_live_allocation_count(void);"
        "#define SPITE_REALLOC(pointer, size) spite_debug_realloc(pointer, size)"
        "#define SPITE_FREE(pointer) spite_debug_free(pointer)"
        "#define SPITE_MALLOC(size) spite_debug_realloc(0, size)"
        "#else"
        "static int64_t spite_live_allocations = 0;"
        "static void* spite_counted_realloc(void* pointer, size_t size) \{"
        "    void* result = realloc(pointer, size);"
        "    if (pointer == 0 && result != 0) SPITE_COUNT_UP(spite_live_allocations);"
        "    return result;"
        "}"
        "static void spite_counted_free(void* pointer) \{"
        "    if (pointer == 0) return;"
        "    SPITE_COUNT_DOWN(spite_live_allocations);"
        "    free(pointer);"
        "}"
        "static int64_t spite_live_allocation_count(void) \{ return spite_live_allocations; }"
        "#define SPITE_REALLOC(pointer, size) spite_counted_realloc(pointer, size)"
        "#define SPITE_FREE(pointer) spite_counted_free(pointer)"
        "#define SPITE_MALLOC(size) spite_counted_realloc(0, size)"
        "#endif"
        ""
        "/* ---- object model: reference counting (milestone 9a) ----"
        " *"
        " * D1 (Mortaro, 2026-09-19): reference counting is the default memory model."
        " * Every non-scalar value (class instance, List<T>, Dictionary<T>, String,"
        " * an object literal) is a heap object whose first field is a `SpiteHeader`;"
        " * variables/attributes/elements/parameters hold pointers to these objects."
        " * Passing, assigning, storing and returning share the same object -- a copy"
        " * is only ever made by an explicit `copy()`/`deep_copy()` call (manual.md"
        " * section 10)."
        " *"
        " * Each concrete type gets its own small, readable, generated"
        " * `\{Type}_retain`/`\{Type}_release` pair; this"
        " * header only holds what is shared: the header layout itself. */"
        ""
        "typedef struct SpiteHeader \{"
        "    int32_t ref_count;"
        "    int32_t class_id;"
        "} SpiteHeader;"
        ""
        ""
        "/* ---- SpiteString: an immutable, reference-counted byte buffer with a"
        " * length. A literal is compiled into a `static` C global (never allocated,"
        " * never freed -- see codegen's `renderStringValue`) with `is_static = true`;"
        " * every other SpiteString is a heap object, retained on every store and"
        " * released at scope exit/overwrite/container removal, freed the moment its"
        " * count reaches zero. Sharing a String's buffer between two references is"
        " * unobservable (Strings are immutable), which is exactly why reference"
        " * counting it is sound and `copy()` never needs to do anything special for"
        " * one. */"
        ""
        "typedef struct SpiteString \{"
        "    SpiteHeader header;"
        "    const char* data;"
        "    int64_t length;"
        "    bool is_static;"
        "} SpiteString;"
        ""
        "/* Wraps a compile-time-constant C string as a `static`-storage, never-freed"
        " * SpiteString: used only to build the `static SpiteString spite_lit_N = ...;`"
        " * globals codegen emits for every String literal (see `renderStringValue`),"
        " * and for a handful of runtime constants (`\"\"`, `\"true\"`, ...) declared with"
        " * `static` storage the same way. */"
        "#define SPITE_STATIC_STRING(text, len) \{ \{ 0, -1 }, (text), (len), true }"
        ""
        "SpiteString* spite_string_from_bytes(const char* bytes, int64_t length) \{"
        "    SpiteString* value = (SpiteString*)SPITE_MALLOC(sizeof(SpiteString));"
        "    char* buffer = (char*)SPITE_MALLOC((size_t)length + 1);"
        "    if (length > 0) memcpy(buffer, bytes, (size_t)length);"
        "    buffer[length] = '\\0';"
        "    value->header.ref_count = 1;"
        "    value->header.class_id = 0; /* String is always --debug-memory class id 0 */"
        "    value->data = buffer;"
        "    value->length = length;"
        "    value->is_static = false;"
        "#ifdef SPITE_DEBUG_MEMORY"
        "    spite_debug_register_object(value, 0);"
        "#endif"
        "    return value;"
        "}"
        ""
        "SpiteString* spite_string_from_cstring_owned(const char* text) \{"
        "    return spite_string_from_bytes(text, (int64_t)strlen(text));"
        "}"
        ""
        "/* Takes ownership of an already-allocated, NUL-terminated buffer. */"
        "SpiteString* spite_string_take(char* buffer, int64_t length) \{"
        "    SpiteString* value = (SpiteString*)SPITE_MALLOC(sizeof(SpiteString));"
        "    value->header.ref_count = 1;"
        "    value->header.class_id = 0; /* String is always --debug-memory class id 0 */"
        "    value->data = buffer;"
        "    value->length = length;"
        "    value->is_static = false;"
        "#ifdef SPITE_DEBUG_MEMORY"
        "    spite_debug_register_object(value, 0);"
        "#endif"
        "    return value;"
        "}"
        ""
        "SpiteString* spite_string_from_cstring_static(const char* text) \{"
        "    return spite_string_from_cstring_owned(text);"
        "}"
        ""
        "SpiteString* SpiteString_retain(SpiteString* self) \{"
        "    if (self != 0 && !self->is_static) SPITE_COUNT_UP(self->header.ref_count);"
        "    return self;"
        "}"
        ""
        "void SpiteString_release(SpiteString* self) \{"
        "    if (self == 0 || self->is_static) return;"
        "    if (SPITE_COUNT_DOWN(self->header.ref_count) <= 0) \{"
        "        if (self->data != 0) SPITE_FREE((void*)self->data);"
        "        SPITE_FREE(self);"
        "    }"
        "}"
        ""
        "SpiteString* SpiteString_concat(SpiteString* left, SpiteString* right);"
        "bool SpiteString_equals(SpiteString* left, SpiteString* right);"
        "bool SpiteString_less(SpiteString* left, SpiteString* right);"
        "bool SpiteString_greater(SpiteString* left, SpiteString* right);"
        "SpiteString* SpiteString_slice(SpiteString* text, int64_t start, int64_t end);"
        "int64_t SpiteString_length(SpiteString* self) \{"
        "    return self->length;"
        "}"
        ""
        "int64_t SpiteString_code_at(SpiteString* self, int64_t index) \{"
        "    if (index < 0 || index >= self->length) return 0;"
        "    return (int64_t)(unsigned char)self->data[index];"
        "}"
        ""
        "static SpiteString spite_static_string_empty = SPITE_STATIC_STRING(\"\", 0);"
    ]
    return lines.join("\n")
}

func structs(): String {
    var lines = [
        "typedef struct \{"
        "    int64_t count;"
        "    const char** items;"
        "} SpiteArguments;"
        ""
        "static SpiteArguments spite_program_arguments;"
    ]
    return lines.join("\n")
}

func prototypes(): String {
    var lines = [
        "int64_t SpiteArguments_count(SpiteArguments* self);"
        "SpiteString* SpiteArguments_get(SpiteArguments* self, int64_t index);"
        "SpiteString* SpiteArguments_lookup(SpiteArguments* self, const char* key);"
    ]
    return lines.join("\n")
}

func bodies(): String {
    var lines = [
        "int64_t SpiteArguments_count(SpiteArguments* self) \{"
        "    return self->count;"
        "}"
        ""
        "SpiteString* SpiteArguments_get(SpiteArguments* self, int64_t index) \{"
        "    if (index < 0 || index >= self->count) return (&spite_static_string_empty);"
        "    return spite_string_from_cstring_owned(self->items[index]);"
        "}"
        ""
        "SpiteString* SpiteArguments_lookup(SpiteArguments* self, const char* key) \{"
        "    int64_t key_length = (int64_t)strlen(key);"
        "    for (int64_t index = 0; index < self->count; index = index + 1) \{"
        "        const char* item = self->items[index];"
        "        if (strcmp(item, \"--\") == 0) return 0;"
        "        if (strncmp(item, \"--\", 2) == 0 && strncmp(item + 2, key, (size_t)key_length) == 0 && item[2 + key_length] == '=') \{"
        "            return spite_string_from_cstring_owned(item + 2 + key_length + 1);"
        "        }"
        "    }"
        "    return 0;"
        "}"
    ]
    return lines.join("\n")
}

func path(): String {
    return "bootstrap/source/generation/prelude.spite"
}

func reopened_classes(): List<String> {
    var classes = [
        "memory"
        "typed_memory"
        "dynamic_library"
        "concurrent"
        "parallel"
        "spite/attribute"
        "spite/function"
    ]
    var numbers = number_classes()
    var index = 0
    while index < numbers.count() {
        classes.append(numbers[index])
        index = index + 1
    }
    return classes
}

func number_classes(): List<String> {
    return [
        "int"
        "long"
        "float"
        "double"
        "bool"
        "tiny"
        "short"
        "byte"
        "unsigned_short"
        "unsigned_int"
        "unsigned_long"
    ]
}

func number_members(stem: String): List<String> {
    var words = stem.split("_")
    var type_name = ""
    var index = 0
    while index < words.count() {
        var word = words[index]
        var word_length = word.length()
        type_name = "{type_name}{word.slice(0, 1).upper_case()}{word.slice(1, word_length)}"
        index = index + 1
    }
    return [
        "func from_type(type: Symbol, value: type.class): {type_name}"
        "written per type by the generator: a C cast"
    ]
}

func reopening(stem: String): String {
    var members = supplied_members(stem)
    var lines = List<String>()
    var index = 0
    while index < members.count() {
        lines.append(members[index])
        index = index + 2
    }
    var joined_lines = lines.join("\n")
    return "{joined_lines}\n"
}

func supplied_body(stem: String, name: String): String? {
    var members = supplied_members(stem)
    var index = 0
    while index < members.count() - 1 {
        if members[index].starts_with("func {name}(") {
            var body_index = index + 1
            return members[body_index]
        }
        index = index + 2
    }
    return null
}

func supplied_members(stem: String): List<String> {
    if stem == "memory" {
        return memory_members()
    }
    if stem == "typed_memory" {
        return typed_memory_members()
    }
    if stem == "concurrent" or stem == "parallel" {
        return task_members()
    }
    var numbers = number_classes()
    if numbers.contains(stem) {
        return number_members(stem)
    }
    if stem == "dynamic_library" {
        return dynamic_library_members()
    }
    if stem == "spite/attribute" {
        return attribute_members()
    }
    if stem == "spite/function" {
        return function_members()
    }
    return List<String>()
}

func memory_members(): List<String> {
    return [
        "func allocate_bytes(bytes: Long): Long"
        "return (int64_t)(intptr_t)SPITE_MALLOC((size_t)bytes);"
        "func resize(address: Long, bytes: Long): Long"
        "return (int64_t)(intptr_t)SPITE_REALLOC((void*)(intptr_t)address, (size_t)bytes);"
        "func free(address: Long)"
        "SPITE_FREE((void*)(intptr_t)address);"
        "func allocate_stack_bytes(bytes: Long): Long"
        "#define Memory_allocate_stack_bytes(self, bytes) ((int64_t)(intptr_t)SPITE_ALLOCA((size_t)(bytes)))"
        "func read_byte(address: Long, offset: Long): Byte"
        "return ((uint8_t*)(intptr_t)address)[offset];"
        "func read_int(address: Long, offset: Long): Int"
        "int32_t value; memcpy(&value, (char*)(intptr_t)address + offset, sizeof(value)); return value;"
        "func read_long(address: Long, offset: Long): Long"
        "int64_t value; memcpy(&value, (char*)(intptr_t)address + offset, sizeof(value)); return value;"
        "func read_double(address: Long, offset: Long): Double"
        "double value; memcpy(&value, (char*)(intptr_t)address + offset, sizeof(value)); return value;"
        "func write_byte(address: Long, offset: Long, value: Byte)"
        "((uint8_t*)(intptr_t)address)[offset] = value;"
        "func write_int(address: Long, offset: Long, value: Int)"
        "memcpy((char*)(intptr_t)address + offset, &value, sizeof(value));"
        "func write_long(address: Long, offset: Long, value: Long)"
        "memcpy((char*)(intptr_t)address + offset, &value, sizeof(value));"
        "func write_double(address: Long, offset: Long, value: Double)"
        "memcpy((char*)(intptr_t)address + offset, &value, sizeof(value));"
        "func copy_bytes(from: Long, to: Long, bytes: Long)"
        "memmove((void*)(intptr_t)to, (void*)(intptr_t)from, (size_t)bytes);"
        "func compare_bytes(first: Long, second: Long, bytes: Long): Int"
        "return bytes > 0 ? (int32_t)memcmp((const void*)(intptr_t)first, (const void*)(intptr_t)second, (size_t)bytes) : 0;"
        "func text(address: Long, length: Long): String"
        "return spite_string_from_bytes((const char*)(intptr_t)address, length);"
        "func take_text(address: Long, length: Long): String"
        "((char*)(intptr_t)address)[length] = 0; return spite_string_take((char*)(intptr_t)address, length);"
        "func address_of(text: String): Long"
        "int64_t address = (int64_t)(intptr_t)text->data; SpiteString_release(text); return address;"
        "func live_allocations(): Int"
        "return (int32_t)spite_live_allocation_count();"
        "func exchange_long(address: Long, offset: Long, value: Long): Long"
        "return __atomic_exchange_n((int64_t*)(intptr_t)(address + offset), value, __ATOMIC_SEQ_CST);"
        "func read_long_atomically(address: Long, offset: Long): Long"
        "return __atomic_load_n((int64_t*)(intptr_t)(address + offset), __ATOMIC_SEQ_CST);"
        "func write_long_atomically(address: Long, offset: Long, value: Long)"
        "__atomic_store_n((int64_t*)(intptr_t)(address + offset), value, __ATOMIC_SEQ_CST);"
    ]
}

func task_members(): List<String> {
    return [
        "func entry_address(): Long"
        "written per instantiation by the generator: the address of its fiber or thread entry"
        "func address(): Long"
        "written per instantiation by the generator: the address of the task itself"
    ]
}

func typed_memory_members(): List<String> {
    return [
        "func read_value(address: Long, index: Int): $value_type"
        "written per value type by the generator"
        "func write_value(address: Long, index: Int, value: $value_type)"
        "written per value type by the generator"
        "func release_value(address: Long, index: Int)"
        "written per value type by the generator"
        "func value_bytes(): Long"
        "written per value type by the generator"
    ]
}

func dynamic_library_members(): List<String> {
    return [
        "func open_library(file: String): Long"
        "#ifdef _WIN32\nvoid* opened = (void*)LoadLibraryA(file->data);\n#else\nvoid* opened = dlopen(file->data, RTLD_NOW);\n#endif\nif (opened == 0) \{\nfflush(stdout);\nfprintf(stderr, \"spite: could not open the library '%s'\\n\", file->data);\nexit(1);\n}\nSpiteString_release(file);\nreturn (int64_t)(intptr_t)opened;"
        "func find_symbol(name: String, wanted_by: String): Long"
        "#ifdef _WIN32\nvoid* found = (void*)GetProcAddress((HMODULE)(intptr_t)self->handle, name->data);\n#else\nvoid* found = dlsym((void*)(intptr_t)self->handle, name->data);\n#endif\nif (found == 0) \{\nfflush(stdout);\nfprintf(stderr, \"spite: the library '%s' has no '%s', which %s calls\\n\", self->file_name->data, name->data, wanted_by->data);\nexit(1);\n}\nSpiteString_release(name);\nSpiteString_release(wanted_by);\nreturn (int64_t)(intptr_t)found;"
        "func close_library(opened: Long)"
        "if (opened == 0) return;\n#ifdef _WIN32\nFreeLibrary((HMODULE)(intptr_t)opened);\n#else\ndlclose((void*)(intptr_t)opened);\n#endif"
    ]
}

func attribute_members(): List<String> {
    return [
        "func value_attributes(): List<Spite.Attribute>"
        "if (self->spite_held != 0 && self->spite_held_attributes != 0) return self->spite_held_attributes(self->spite_held);\nreturn List_Spite_Attribute_make();"
        "func value_functions(): List<Spite.Function>"
        "if (self->spite_held != 0 && self->spite_held_functions != 0) return self->spite_held_functions(self->spite_held);\nreturn List_Spite_Function_make();"
        "func assign(text: String): Bool"
        "bool assigned = false;\nif (self->spite_owner != 0 && self->spite_assign != 0) assigned = self->spite_assign(self->spite_owner, text);\nSpiteString_release(text);\nreturn assigned;"
    ]
}

func function_members(): List<String> {
    return [
        "func call_function()"
        "if (self->spite_call != 0) self->spite_call(self->spite_owner);"
        "func call_with_text(arguments: List<String>): Spite.Attribute?"
        "Spite_Attribute* result = 0;\nif (self->spite_text_call != 0) result = ((Spite_Attribute* (*)(void*, List_String*))self->spite_text_call)(self->spite_owner, arguments);\nList_String_release(arguments);\nreturn result;"
    ]
}
