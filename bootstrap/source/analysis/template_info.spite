var declaration: Syntax.Statements.FunctionDeclaration? = null
var symbol_parameter = ""
var prefix = ""
var suffix = ""
var range: Syntax.Types.Type? = null
var passed = false
var plural = false

func TemplateInfo(
    starting_declaration: Syntax.Statements.FunctionDeclaration,
    starting_symbol_parameter: String,
    starting_prefix: String,
    starting_suffix: String,
) {
    declaration = starting_declaration
    symbol_parameter = starting_symbol_parameter
    prefix = starting_prefix
    suffix = starting_suffix
}

func get_declaration(): Syntax.Statements.FunctionDeclaration {
    crash declaration
    return declaration
}

func member_name_for(call_name: String): String {
    if passed {
        return ""
    }
    if call_name.length() <= prefix.length() + suffix.length() {
        return ""
    }
    if not call_name.starts_with(prefix) {
        return ""
    }
    if not call_name.ends_with(suffix) {
        return ""
    }
    var prefix_length = prefix.length()
    var call_name_length = call_name.length()
    var suffix_length = suffix.length()
    return call_name.slice(prefix_length, call_name_length - suffix_length)
}
