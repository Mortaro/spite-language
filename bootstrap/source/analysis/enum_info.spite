var c_name = ""
var simple_name = ""
var owner_qualified = ""
var values = List<String>()

func EnumInfo(starting_c_name: String, starting_simple_name: String, starting_owner_qualified: String, starting_values: List<String>) {
    c_name = starting_c_name
    simple_name = starting_simple_name
    owner_qualified = starting_owner_qualified
    values = starting_values
}

func has_value(name: String): Bool {
    return values.contains(name)
}
