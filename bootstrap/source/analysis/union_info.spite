var c_name = ""
var simple_name = ""
var owner_qualified = ""
var owner_namespace = ""
var member_types = List<Syntax.Types.Type>()
var members = List<ClassInfo>()
var is_shape = false
var shape_fields = List<Syntax.Statements.FieldDeclaration>()
var accessor_names = List<String>()
var writer_names = List<String>()

func UnionInfo(starting_c_name: String, starting_simple_name: String, starting_owner_qualified: String, starting_owner_namespace: String, starting_member_types: List<Syntax.Types.Type>) {
    c_name = starting_c_name
    simple_name = starting_simple_name
    owner_qualified = starting_owner_qualified
    owner_namespace = starting_owner_namespace
    member_types = starting_member_types
}

func has_member(class_c_name: String): Bool {
    var index = 0
    while index < members.count() {
        if members[index].c_name == class_c_name {
            return true
        }
        index = index + 1
    }
    return false
}
