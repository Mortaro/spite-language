var name = ""
var c_name = ""
var parameters = List<ParamInfo>()
var return_type: SpiteType? = null
var body = List<Syntax.Statements.Statement>()
var is_constructor = false
var is_emitted = false
var has_body = true
var supplied_body = ""
var line = 0
var source_path = ""
var symbol_name = ""
var symbol_field_name = ""
var symbol_field_type: SpiteType? = null
var symbol_owner_c_name = ""

func FunctionInfo(
    starting_name: String,
    starting_c_name: String,
    starting_parameters: List<ParamInfo>,
    starting_return_type: SpiteType,
    starting_body: List<Syntax.Statements.Statement>,
    starting_is_constructor: Bool,
) {
    name = starting_name
    c_name = starting_c_name
    parameters = starting_parameters
    return_type = starting_return_type
    body = starting_body
    is_constructor = starting_is_constructor
}

func get_return_type(): SpiteType {
    crash return_type
    return return_type
}
