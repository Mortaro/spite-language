var name = ""
var c_name = ""
var parameters = List<ParamInfo>()
var return_type: SpiteType? = null
var body = List<Syntax.Statements.Statement>()
var is_constructor = false
var is_emitted = false
var has_body = true
var supplied_body = ""
var line = 0
var end_line = 0
var source_path = ""
var symbol_name = ""
var symbol_field_name = ""
var symbol_field_index = -1
var symbol_field_type: SpiteType? = null
var symbol_owner_c_name = ""
var symbol_through_caller = false
var kept_for_prompt = false
var symbol_pattern = ""
var symbol_function_name = ""
var symbol_display_name = ""
var symbol_range = ""
var symbol_enum_c_name = ""
var lent_parameters = List<String>()
var lent_sources = ""
var held_parameters = List<String>()
var lent_element = ""
var result_slot = false
var specialised_from = ""
var specialisation_position = -1
var symbol_chain_method = ""
var symbol_chain_arguments = List<String>()

func FunctionInfo(
    starting_name: String,
    starting_c_name: String,
    starting_parameters: List<ParamInfo>,
    starting_return_type: SpiteType,
    starting_body: List<Syntax.Statements.Statement>,
    starting_is_constructor: Boolean,
) {
    name = starting_name
    c_name = starting_c_name
    parameters = starting_parameters
    return_type = starting_return_type
    body = starting_body
    is_constructor = starting_is_constructor
}

func get_return_type(): SpiteType {
    crash return_type
    return return_type
}
