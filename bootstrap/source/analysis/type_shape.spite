func as_scalar(spite_type: SpiteType): Analysis.Types.ScalarType? {
    if spite_type == Analysis.Types.ScalarType {
        return spite_type
    }
    return null
}

func as_class_ref(spite_type: SpiteType): Analysis.Types.ClassRefType? {
    if spite_type == Analysis.Types.ClassRefType {
        return spite_type
    }
    return null
}

func as_nullable(spite_type: SpiteType): Analysis.Types.NullableType? {
    if spite_type == Analysis.Types.NullableType {
        return spite_type
    }
    return null
}

func as_enum(spite_type: SpiteType): Analysis.Types.EnumType? {
    if spite_type == Analysis.Types.EnumType {
        return spite_type
    }
    return null
}

func as_list(spite_type: SpiteType): Analysis.Types.ListType? {
    if spite_type == Analysis.Types.ListType {
        return spite_type
    }
    return null
}

func as_dictionary(spite_type: SpiteType): Analysis.Types.DictionaryType? {
    if spite_type == Analysis.Types.DictionaryType {
        return spite_type
    }
    return null
}

func as_union(spite_type: SpiteType): Analysis.Types.UnionType? {
    if spite_type == Analysis.Types.UnionType {
        return spite_type
    }
    return null
