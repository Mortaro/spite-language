func as_string(spite_type: SpiteType): Bool {
    return spite_type == Analysis.Types.StringType
}

func is_void(spite_type: SpiteType): Bool {
    return spite_type == Analysis.Types.VoidType
}

func is_arguments(spite_type: SpiteType): Bool {
    return spite_type == Analysis.Types.ArgumentsType
}

func is_symbol(spite_type: SpiteType): Bool {
    return spite_type == Analysis.Types.SymbolType
}
