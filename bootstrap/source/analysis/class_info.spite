var c_name = ""
var simple_name = ""
var namespace_dotted = ""
var qualified_dotted = ""
var class_id = 0
var is_emitted = false
var is_singleton = false
var is_value_class = false
var is_generic_template = false
var is_container = false
var entry_index = 0
var codegen_names = List<String>()
var codegen_types = List<SpiteType>()
var codegen_codes = List<String>()
var codegen_texts = List<String>()
var source_path = ""
var fields = List<FieldInfo>()
var functions = List<FunctionInfo>()
var templates = List<TemplateInfo>()
var constructor: FunctionInfo? = null
var drop_function: FunctionInfo? = null

func ClassInfo(
    starting_c_name: String,
    starting_simple_name: String,
    starting_namespace_dotted: String,
    starting_qualified_dotted: String,
    starting_class_id: Int,
) {
    c_name = starting_c_name
    simple_name = starting_simple_name
    namespace_dotted = starting_namespace_dotted
    qualified_dotted = starting_qualified_dotted
    class_id = starting_class_id
}

func find_field(name: String): FieldInfo? {
    var index = 0
    while index < fields.count() {
        var field = fields[index]
        if field.name == name {
            return field
        }
        index = index + 1
    }
    return null
}

func find_function(name: String): FunctionInfo? {
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if function.name == name {
            return function
        }
        index = index + 1
    }
    return null
}
