var shape = Analysis.AstShape()

var explicit_grouping = false
var width = 120
var comment_lines = List<Int>()
var comment_texts = List<String>()
var statement_lines = List<Int>()

func source_file(file: Syntax.SourceFile): String {
    return source_statement_list(file.statements, 0)
}

func formatted_file(file: Syntax.SourceFile, lines: List<Int>, comments_at: List<Int>, comments: List<String>): String {
    statement_lines = lines
    comment_lines = comments_at
    comment_texts = comments
    var text = ""
    var comment_index = 0
    var index = 0
    while index < file.statements.count() {
        crash index < statement_lines.count()
        var starts_at = statement_lines[index]
        var comment_block = ""
        while comment_index < comment_lines.count() and comment_lines[comment_index] < starts_at {
            crash comment_index < comment_texts.count()
            comment_block = "{comment_block}{comment_texts[comment_index]}\n"
            comment_index = comment_index + 1
        }
        if index > 0 {
            text = "{text}\n"
            if not comment_block.is_empty() or declarations_stand_apart(file.statements, index) {
                text = "{text}\n"
            }
        }
        text = "{text}{comment_block}{source_statement(file.statements[index], 0)}"
        index = index + 1
    }
    while comment_index < comment_texts.count() {
        if not text.is_empty() {
            text = "{text}\n"
        }
        text = "{text}\n{comment_texts[comment_index]}"
        comment_index = comment_index + 1
    }
    assert not text.is_empty()
    return "{text}\n"
}

func declarations_stand_apart(statements: List<Syntax.Statements.Statement>, index: Int): Bool {
    crash index > 0
    var previous = index - 1
    crash statements[previous]
    crash statements[index]
    if not stands_apart(statements[previous], statements[index]) {
        crash index < statement_lines.count()
        crash previous < statement_lines.count()
        var printed_lines = source_statement(statements[previous], 0).split("\n").count()
        return statement_lines[index] > statement_lines[previous] + printed_lines
    }
    return true
}

func source_statement_list(statements: List<Syntax.Statements.Statement>, depth: Int): String {
    var text = ""
    var index = 0
    while index < statements.count() {
        if index > 0 {
            text = "{text}\n"
            if depth == 0 and stands_apart(statements[index - 1], statements[index]) {
                text = "{text}\n"
            }
        }
        text = "{text}{source_statement(statements[index], depth)}"
        index = index + 1
    }
    return text
}

func stands_apart(previous: Syntax.Statements.Statement, next: Syntax.Statements.Statement): Bool {
    var previous_attribute = shape.as_variable_declaration(previous)
    var next_attribute = shape.as_variable_declaration(next)
    assert not previous_attribute or not next_attribute
    var previous_function = shape.as_function_declaration(previous)
    var next_function = shape.as_function_declaration(next)
    if previous_function {
        if next_function {
            return previous_function.has_body or next_function.has_body
        }
    }
    return not (shape.as_generic_declaration(previous) and shape.as_generic_declaration(next))
}

func source_indent(depth: Int): String {
    var text = ""
    var index = 0
    while index < depth {
        text = "{text}    "
        index = index + 1
    }
    return text
}

func source_block(statements: List<Syntax.Statements.Statement>, depth: Int): String {
    if statements.is_empty() {
        return "\{}"
    }
    return "\{\n{source_statement_list(statements, depth + 1)}\n{source_indent(depth)}}"
}

func source_statement(statement: Syntax.Statements.Statement, depth: Int): String {
    var printed = source_statement_line(statement, depth)
    if printed.contains("\n") or printed.length() <= width {
        return printed
    }
    var indent = source_indent(depth)
    switch statement {
        Syntax.Statements.VariableDeclaration: {
            crash statement.value
            var type_text = ""
            if statement.type_reference {
                type_text = ": {source_type(statement.type_reference)}"
            }
            return broken_or(printed, "{indent}var {statement.name}{type_text} = ", statement.value, depth)
        }
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            return broken_or(printed, "{indent}{source_expression(statement.target)} = ", statement.value, depth)
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                return broken_or(printed, "{indent}return ", statement.value, depth)
            }
            return printed
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            if loaded_folder(statement.value) {
                return printed
            }
            return broken_or(printed, indent, statement.value, depth)
        }
        _: return printed
    }
}

func broken_or(printed: String, lead: String, expression: Syntax.Expressions.Expression, depth: Int): String {
    var broken = broken_expression(expression, depth)
    if broken.is_empty() {
        return printed
    }
    return "{lead}{broken}"
}

func broken_expression(expression: Syntax.Expressions.Expression, depth: Int): String {
    var call = shape.as_call(expression)
    if call {
        return broken_call(call.callee, call.arguments, "", depth)
    }
    var generic_call = shape.as_generic_call(expression)
    if generic_call {
        assert not generic_call.names_class
        return broken_call(
            generic_call.callee,
            generic_call.arguments,
            "<{generic_arguments_text(generic_call)}>",
            depth,
        )
    }
    var listed = shape.as_list_literal(expression)
    if listed {
        var text = "["
        var index = 0
        while index < listed.elements.count() {
            crash listed.elements[index].value
            text = "{text}\n{source_indent(depth + 1)}{source_expression(listed.elements[index].value)}"
            index = index + 1
        }
        return "{text}\n{source_indent(depth)}]"
    }
    var described = shape.as_object_literal(expression)
    if described {
        var text = "\{"
        var index = 0
        while index < described.fields.count() {
            crash described.fields[index].value
            text = "{text}\n{source_indent(depth + 1)}{described.fields[index].name}: {source_expression(described.fields[index].value)}"
            index = index + 1
        }
        return "{text}\n{source_indent(depth)}}"
    }
    return ""
}

func broken_call(
    callee: Syntax.Expressions.Expression?,
    arguments: List<Syntax.Expressions.Expression>,
    type_arguments: String,
    depth: Int,
): String {
    crash callee
    assert not arguments.is_empty()
    var text = "{source_receiver(callee)}{type_arguments}("
    var index = 0
    while index < arguments.count() {
        text = "{text}\n{source_indent(depth + 1)}{source_expression(arguments[index])},"
        index = index + 1
    }
    return "{text}\n{source_indent(depth)})"
}

func source_statement_line(statement: Syntax.Statements.Statement, depth: Int): String {
    var indent = source_indent(depth)
    switch statement {
        Syntax.Statements.SingletonDeclaration: return "{indent}singleton"
        Syntax.Statements.GenericDeclaration: {
            if statement.constraint {
                return "{indent}generic ${statement.name}: {source_type(statement.constraint)}"
            }
            return "{indent}generic ${statement.name}"
        }
        Syntax.Statements.VariableDeclaration: {
            var type_text = ""
            if statement.type_reference {
                type_text = ": {source_type(statement.type_reference)}"
            }
            crash statement.value
            return "{indent}var {statement.name}{type_text} = {source_expression(statement.value)}"
        }
        Syntax.Statements.FunctionDeclaration: return source_function(statement, depth)
        Syntax.Statements.TypeDeclaration: return source_type_declaration(statement, depth)
        Syntax.Statements.EnumDeclaration: return "{indent}enum {statement.name} {source_names(statement.values, depth)}"
        Syntax.Statements.UnionDeclaration: return "{indent}union {statement.name} {source_types(statement.members, depth)}"
        Syntax.Statements.AssignmentStatement: {
            crash statement.target
            crash statement.value
            return "{indent}{source_expression(statement.target)} = {source_expression(statement.value)}"
        }
        Syntax.Statements.IfStatement: {
            crash statement.condition
            var text = "{indent}if {source_expression(statement.condition)} {source_block(statement.then_branch, depth)}"
            if statement.has_else_branch {
                if statement.else_branch.count() == 1 {
                    if shape.as_if_statement(statement.else_branch[0]) {
                        return "{text} else {source_statement(statement.else_branch[0], depth).trim()}"
                    }
                }
                text = "{text} else {source_block(statement.else_branch, depth)}"
            }
            return text
        }
        Syntax.Statements.WhileStatement: {
            crash statement.condition
            return "{indent}while {source_expression(statement.condition)} {source_block(statement.body, depth)}"
        }
        Syntax.Statements.SwitchStatement: return source_switch(statement, depth)
        Syntax.Statements.AssertStatement: {
            crash statement.value
            if statement.is_crash {
                if statement.value == Syntax.Expressions.FalseLiteral {
                    return "{indent}crash"
                }
                return "{indent}crash {source_expression(statement.value)}"
            }
            return "{indent}assert {source_expression(statement.value)}"
        }
        Syntax.Statements.ReturnStatement: {
            if statement.value {
                return "{indent}return {source_expression(statement.value)}"
            }
            return "{indent}return"
        }
        Syntax.Statements.ExpressionStatement: {
            crash statement.value
            var folder = loaded_folder(statement.value)
            if folder {
                return "{indent}load {source_expression(folder)}"
            }
            return "{indent}{source_expression(statement.value)}"
        }
    }
}

func loaded_folder(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression? {
    var call = shape.as_call(expression)
    assert call
    crash call.callee
    var identifier = shape.as_identifier(call.callee)
    assert identifier
    assert identifier.name == "load" and call.arguments.count() == 1
    return call.arguments[0]
}

func spread_mark(parameter: Syntax.Statements.Parameter): String {
    if parameter.is_variadic {
        return "..."
    }
    return ""
}

func source_function(function: Syntax.Statements.FunctionDeclaration, depth: Int): String {
    var parameters = ""
    var index = 0
    while index < function.parameters.count() {
        if index > 0 {
            parameters = "{parameters}, "
        }
        var parameter = function.parameters[index]
        crash parameter.type_reference
        parameters = "{parameters}{spread_mark(parameter)}{parameter.name}: {source_type(parameter.type_reference)}"
        index = index + 1
    }
    var returns = ""
    if function.return_type {
        returns = ": {source_type(function.return_type)}"
    }
    var header = "{source_indent(depth)}func {function.name}({parameters}){returns} \{"
    if not function.has_body {
        return "{source_indent(depth)}func {function.name}({parameters}){returns}"
    }
    if header.length() > width {
        var listed = ""
        index = 0
        while index < function.parameters.count() {
            var listed_parameter = function.parameters[index]
            crash listed_parameter.type_reference
            listed = "{listed}\n{source_indent(depth + 1)}{spread_mark(listed_parameter)}{listed_parameter.name}: {source_type(listed_parameter.type_reference)},"
            index = index + 1
        }
        parameters = "{listed}\n{source_indent(depth)}"
    }
    return "{source_indent(depth)}func {function.name}({parameters}){returns} {source_block(function.body, depth)}"
}

func source_type_declaration(declaration: Syntax.Statements.TypeDeclaration, depth: Int): String {
    var text = "{source_indent(depth)}type {declaration.name} \{"
    var index = 0
    while index < declaration.fields.count() {
        var field = declaration.fields[index]
        crash field.type_reference
        if field.is_function {
            var parameters = ""
            var parameter_index = 0
            while parameter_index < field.parameter_types.count() {
                if parameter_index > 0 {
                    parameters = "{parameters}, "
                }
                parameters = "{parameters}{source_type(field.parameter_types[parameter_index])}"
                parameter_index = parameter_index + 1
            }
            var returned = ": {source_type(field.type_reference)}"
            if returned == ": Nothing" {
                returned = ""
            }
            text = "{text}\n{source_indent(depth + 1)}{field.name}({parameters}){returned}"
        } else {
            text = "{text}\n{source_indent(depth + 1)}{field.name}: {source_type(field.type_reference)}"
        }
        index = index + 1
    }
    return "{text}\n{source_indent(depth)}}"
}

func source_names(names: List<String>, depth: Int): String {
    var text = "\{"
    var index = 0
    while index < names.count() {
        text = "{text}\n{source_indent(depth + 1)}'{names[index]}'"
        index = index + 1
    }
    return "{text}\n{source_indent(depth)}}"
}

func source_types(types: List<Syntax.Types.Type>, depth: Int): String {
    var text = "\{"
    var index = 0
    while index < types.count() {
        text = "{text}\n{source_indent(depth + 1)}{source_type(types[index])}"
        index = index + 1
    }
    return "{text}\n{source_indent(depth)}}"
}

func source_switch(statement: Syntax.Statements.SwitchStatement, depth: Int): String {
    crash statement.subject
    var text = "{source_indent(depth)}switch {source_expression(statement.subject)} \{"
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        crash switch_case.type_reference
        var label = "{source_indent(depth + 1)}{source_type(switch_case.type_reference)}:"
        var one_line_case = one_line_case(switch_case.body, depth)
        if one_line_case.is_empty() {
            text = "{text}\n{label} {source_block(switch_case.body, depth + 1)}"
        } else {
            text = "{text}\n{label} {one_line_case}"
        }
        index = index + 1
    }
    return "{text}\n{source_indent(depth)}}"
}

func one_line_case(body: List<Syntax.Statements.Statement>, depth: Int): String {
    if body.count() == 1 {
        var single = source_statement(body[0], depth + 1).trim()
        if not single.contains("\n") and not shape.as_if_statement(body[0]) and not shape.as_while_statement(body[0]) and not shape.as_switch_statement(body[0]) {
            return single
        }
    }
    return ""
}

func source_type(type_reference: Syntax.Types.Type): String {
    switch type_reference {
        Syntax.Types.ReferenceType: {
            crash type_reference.inner
            return "&{source_type(type_reference.inner)}"
        }
        Syntax.Types.GenericType: return "${type_reference.name}"
        Syntax.Types.NamedType: {
            if type_reference.path.count() == 1 and type_reference.path[0] == "Nullable" and type_reference.arguments.count() == 1 {
                var nullable_argument = type_reference.arguments[0]
                switch nullable_argument {
                    Syntax.Types.TypeArgument: {
                        crash nullable_argument.value
                        return "{source_type(nullable_argument.value)}?"
                    }
                    _: crash
                }
            }
            var text = type_reference.path.join(".")
            if not type_reference.arguments.is_empty() {
                var arguments = ""
                var index = 0
                while index < type_reference.arguments.count() {
                    if index > 0 {
                        arguments = "{arguments}, "
                    }
                    arguments = "{arguments}{source_generic_argument(type_reference.arguments[index])}"
                    index = index + 1
                }
                text = "{text}<{arguments}>"
            }
            return text
        }
    }
}

func source_generic_argument(argument: Syntax.Types.GenericArgument): String {
    switch argument {
        Syntax.Types.TypeArgument: {
            crash argument.value
            return source_type(argument.value)
        }
        Syntax.Types.BoolArgument: {
            if argument.value {
                return "true"
            }
            return "false"
        }
        Syntax.Types.StringArgument: return source_string(argument.value)
        Syntax.Types.EnumArgument: return "'{argument.value}'"
        _: return "{argument.value}"
    }
}

func source_expression(expression: Syntax.Expressions.Expression): String {
    switch expression {
        Syntax.Expressions.NullLiteral: return "null"
        Syntax.Expressions.TrueLiteral: return "true"
        Syntax.Expressions.FalseLiteral: return "false"
        Syntax.Expressions.StringLiteralExpression: return source_string(expression.value)
        Syntax.Expressions.EnumLiteralExpression: return "'{expression.value}'"
        Syntax.Expressions.GenericIdentifierExpression: return "${expression.name}"
        Syntax.Expressions.IdentifierExpression: return expression.name
        Syntax.Expressions.ListLiteralExpression: return source_list(expression)
        Syntax.Expressions.ObjectLiteralExpression: return source_object(expression)
        Syntax.Expressions.UnaryExpression: {
            crash expression.operand
            return "{source_unary_operator(expression.operator)}{source_operand(expression.operand, 7, false)}"
        }
        Syntax.Expressions.BinaryExpression: {
            if expression.is_text_join {
                return source_text_join(expression)
            }
            crash expression.left
            crash expression.right
            var precedence = operator_precedence(expression.operator)
            return "{source_operand(expression.left, precedence, false)} {source_binary_operator(expression.operator)} {source_operand(expression.right, precedence, true)}"
        }
        Syntax.Expressions.CallExpression: return source_call(expression.callee, expression.arguments, "")
        Syntax.Expressions.GenericCallExpression: return source_generic_call(expression)
        Syntax.Expressions.MemberExpression: {
            crash expression.object
            return "{source_receiver(expression.object)}.{expression.name}"
        }
        Syntax.Expressions.IndexExpression: {
            crash expression.object
            crash expression.index
            return "{source_receiver(expression.object)}[{source_expression(expression.index)}]"
        }
        Syntax.Expressions.FloatLiteral: {
            if not expression.written.is_empty() {
                return expression.written
            }
            var number = "{expression.value}"
            if not number.contains(".") and not number.contains("e") {
                return "{number}.0"
            }
            return number
        }
        _: return "{expression.value}"
    }
}

func source_receiver(expression: Syntax.Expressions.Expression): String {
    if shape.as_binary(expression) or shape.as_unary(expression) {
        return "({source_expression(expression)})"
    }
    return source_expression(expression)
}

func source_operand(expression: Syntax.Expressions.Expression, parent_precedence: Int, on_the_right: Bool): String {
    var binary = shape.as_binary(expression)
    if binary {
        if not binary.is_text_join {
            var own = operator_precedence(binary.operator)
            if explicit_grouping or own < parent_precedence or on_the_right and own == parent_precedence {
                return "({source_expression(expression)})"
            }
        }
    }
    return source_expression(expression)
}

func operator_precedence(operator: Syntax.Expressions.BinaryOperator): Int {
    if operator == 'logical_or' {
        return 1
    }
    if operator == 'logical_and' {
        return 2
    }
    if operator == 'equal' or operator == 'not_equal' {
        return 3
    }
    if operator == 'add' or operator == 'subtract' {
        return 5
    }
    if operator == 'multiply' or operator == 'divide' or operator == 'modulo' {
        return 6
    }
    return 4
}

func source_text_join(expression: Syntax.Expressions.BinaryExpression): String {
    var pieces = List<String>()
    collect_text_join_pieces(expression, pieces)
    return "\"{pieces.join("")}\""
}

func collect_text_join_pieces(expression: Syntax.Expressions.Expression, pieces: List<String>) {
    var binary = shape.as_binary(expression)
    if binary {
        if binary.is_text_join {
            crash binary.left
            crash binary.right
            collect_text_join_pieces(binary.left, pieces)
            collect_text_join_pieces(binary.right, pieces)
            return
        }
    }
    var string = shape.as_string_literal(expression)
    if string {
        var source_string_piece = source_string_piece(string.value)
        pieces.append(source_string_piece)
        return
    }
    pieces.append("\{{source_expression(expression)}}")
}

func source_call(
    callee: Syntax.Expressions.Expression?,
    arguments: List<Syntax.Expressions.Expression>,
    type_arguments: String,
): String {
    crash callee
    var text = "{source_receiver(callee)}{type_arguments}("
    var index = 0
    while index < arguments.count() {
        if index > 0 {
            text = "{text}, "
        }
        text = "{text}{source_expression(arguments[index])}"
        index = index + 1
    }
    return "{text})"
}

func source_generic_call(expression: Syntax.Expressions.GenericCallExpression): String {
    if expression.names_class {
        crash expression.callee
        return "{source_receiver(expression.callee)}<{generic_arguments_text(expression)}>"
    }
    return source_call(expression.callee, expression.arguments, "<{generic_arguments_text(expression)}>")
}

func generic_arguments_text(expression: Syntax.Expressions.GenericCallExpression): String {
    var arguments = ""
    var index = 0
    while index < expression.type_arguments.count() {
        if index > 0 {
            arguments = "{arguments}, "
        }
        arguments = "{arguments}{source_generic_argument(expression.type_arguments[index])}"
        index = index + 1
    }
    return arguments
}

func source_list(expression: Syntax.Expressions.ListLiteralExpression): String {
    if expression.elements.is_empty() {
        return "[]"
    }
    var text = "["
    var index = 0
    while index < expression.elements.count() {
        if index > 0 {
            text = "{text}, "
        }
        var value = expression.elements[index].value
        crash value
        text = "{text}{source_expression(value)}"
        index = index + 1
    }
    return "{text}]"
}

func source_object(expression: Syntax.Expressions.ObjectLiteralExpression): String {
    if expression.fields.is_empty() {
        return "\{}"
    }
    var text = "\{"
    var index = 0
    while index < expression.fields.count() {
        if index > 0 {
            text = "{text}, "
        }
        var field = expression.fields[index]
        crash field.value
        text = "{text}{field.name}: {source_expression(field.value)}"
        index = index + 1
    }
    return "{text}}"
}

func source_unary_operator(operator: Syntax.Expressions.UnaryOperator): String {
    if operator == 'negate' {
        return "-"
    }
    return "not "
}

func source_binary_operator(operator: Syntax.Expressions.BinaryOperator): String {
    if operator == 'add' {
        return "+"
    }
    if operator == 'subtract' {
        return "-"
    }
    if operator == 'multiply' {
        return "*"
    }
    if operator == 'divide' {
        return "/"
    }
    if operator == 'modulo' {
        return "%"
    }
    if operator == 'equal' {
        return "=="
    }
    if operator == 'not_equal' {
        return "!="
    }
    if operator == 'less' {
        return "<"
    }
    if operator == 'less_equal' {
        return "<="
    }
    if operator == 'greater' {
        return ">"
    }
    if operator == 'greater_equal' {
        return ">="
    }
    if operator == 'logical_and' {
        return "and"
    }
    return "or"
}

func source_string(value: String): String {
    return "\"{source_string_piece(value)}\""
}

func source_string_piece(value: String): String {
    return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t").replace(
        "\{",
        "\\\{",
    )
}
