var callee: Expression? = null
var type_arguments = List<Syntax.Types.GenericArgument>()
var arguments = List<Expression>()
var names_class = false

func GenericCallExpression(
    callee_expression: Expression,
    call_type_arguments: List<Syntax.Types.GenericArgument>,
    call_arguments: List<Expression>,
) {
    callee = callee_expression
    type_arguments = call_type_arguments
    arguments = call_arguments
}
