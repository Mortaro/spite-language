var console = Console()
var current_file: Nullable<Syntax.SourceFile> = null

func Printer() { }

func indent_text(depth: Int): String {
    var text = ""
    var index = 0
    while index < depth {
        text = text + "  "
        index = index + 1
    }
    return text
}

func print_line(depth: Int, text: String) {
    console.print(indent_text(depth) + text)
}

func print_file(file: Syntax.SourceFile) {
    current_file = file
    var stored_file = current_file
    assert stored_file
    console.print("File")
    print_statement_list(stored_file.statements, 1)
}

func print_statement_list(statements: List<Syntax.Statements.Statement>, depth: Int) {
    var index = 0
    while index < statements.count() {
        print_statement(statements[index], depth)
        index = index + 1
    }
}

func print_statement(statement: Syntax.Statements.Statement, depth: Int) {
    switch statement {
        Syntax.Statements.GenericsDeclaration: {
            var text = "Generics"
            var index = 0
            while index < statement.names.count() {
                text = text + " $" + statement.names[index]
                index = index + 1
            }
            print_line(depth, text)
        }
        Syntax.Statements.VariableDeclaration: {
            print_line(depth, "VarDecl " + statement.name)
            var type_reference = statement.type_reference
            if type_reference {
                print_line(depth + 1, "Type " + inline_type(type_reference))
            }
            var value = statement.value
            assert value
            print_expression(value, depth + 1)
        }
        Syntax.Statements.FunctionDeclaration: print_function(statement, depth)
        Syntax.Statements.TypeDeclaration: {
            print_line(depth, "TypeDecl " + statement.name)
            var index = 0
            while index < statement.fields.count() {
                var field = statement.fields[index]
                var field_type = field.type_reference
                assert field_type
                print_line(depth + 1, "Field " + field.name + ": " + inline_type(field_type))
                index = index + 1
            }
        }
        Syntax.Statements.EnumDeclaration: {
            print_line(depth, "EnumDecl " + statement.name)
            var index = 0
            while index < statement.values.count() {
                print_line(depth + 1, "'" + statement.values[index] + "'")
                index = index + 1
            }
        }
        Syntax.Statements.UnionDeclaration: {
            print_line(depth, "UnionDecl " + statement.name)
            var index = 0
            while index < statement.members.count() {
                print_line(depth + 1, inline_type(statement.members[index]))
                index = index + 1
            }
        }
        Syntax.Statements.AssignmentStatement: {
            print_line(depth, "Assignment")
            var target = statement.target
            assert target
            print_expression(target, depth + 1)
            var value = statement.value
            assert value
            print_expression(value, depth + 1)
        }
        Syntax.Statements.IfStatement: {
            print_line(depth, "If")
            var condition = statement.condition
            assert condition
            print_expression(condition, depth + 1)
            print_line(depth + 1, "Then")
            print_statement_list(statement.then_branch, depth + 2)
            if statement.has_else_branch {
                print_line(depth + 1, "Else")
                print_statement_list(statement.else_branch, depth + 2)
            }
        }
        Syntax.Statements.WhileStatement: {
            print_line(depth, "While")
            var condition = statement.condition
            assert condition
            print_expression(condition, depth + 1)
            print_statement_list(statement.body, depth + 1)
        }
        Syntax.Statements.SwitchStatement: {
            print_line(depth, "Switch")
            var subject = statement.subject
            assert subject
            print_expression(subject, depth + 1)
            var index = 0
            while index < statement.cases.count() {
                var switch_case = statement.cases[index]
                var case_type = switch_case.type_reference
                assert case_type
                print_line(depth + 1, "Case " + inline_type(case_type))
                print_statement_list(switch_case.body, depth + 2)
                index = index + 1
            }
        }
        Syntax.Statements.AssertStatement: {
            print_line(depth, "Assert")
            var value = statement.value
            assert value
            print_expression(value, depth + 1)
        }
        Syntax.Statements.ReturnStatement: {
            print_line(depth, "Return")
            var value = statement.value
            if value {
                print_expression(value, depth + 1)
            }
        }
        Syntax.Statements.ExpressionStatement: {
            print_line(depth, "ExpressionStatement")
            var value = statement.value
            assert value
            print_expression(value, depth + 1)
        }
    }
}

func print_function(function: Syntax.Statements.FunctionDeclaration, depth: Int) {
    var text = "FuncDecl " + function.name + "("
    var index = 0
    while index < function.parameters.count() {
        if index != 0 {
            text = text + ", "
        }
        var parameter = function.parameters[index]
        var parameter_type = parameter.type_reference
        assert parameter_type
        text = text + parameter.name + ": " + inline_type(parameter_type)
        index = index + 1
    }
    text = text + ")"
    var return_type = function.return_type
    if return_type {
        text = text + ": " + inline_type(return_type)
    }
    print_line(depth, text)
    print_statement_list(function.body, depth + 1)
}

func inline_type(type_reference: Syntax.Types.Type): String {
    switch type_reference {
        Syntax.Types.ReferenceType: {
            var inner = type_reference.inner
            assert inner
            return "&" + inline_type(inner)
        }
        Syntax.Types.GenericType: return "$" + type_reference.name
        Syntax.Types.NamedType: {
            var text = ""
            var index = 0
            while index < type_reference.path.count() {
                if index != 0 {
                    text = text + "."
                }
                text = text + type_reference.path[index]
                index = index + 1
            }
            if type_reference.arguments.count() != 0 {
                text = text + "<"
                var argument_index = 0
                while argument_index < type_reference.arguments.count() {
                    if argument_index != 0 {
                        text = text + ", "
                    }
                    text = text + inline_generic_argument(type_reference.arguments[argument_index])
                    argument_index = argument_index + 1
                }
                text = text + ">"
            }
            return text
        }
    }
}

func inline_generic_argument(argument: Syntax.Types.GenericArgument): String {
    switch argument {
        Syntax.Types.TypeArgument: {
            var value = argument.value
            assert value
            return inline_type(value)
        }
        Syntax.Types.IntegerArgument: return "" + argument.value
        Syntax.Types.FloatArgument: return "" + argument.value
        Syntax.Types.BoolArgument: {
            if argument.value {
                return "true"
            }
            return "false"
        }
        Syntax.Types.StringArgument: return "\"" + argument.value + "\""
        Syntax.Types.EnumArgument: return "'" + argument.value + "'"
    }
}

func print_expression(expression: Syntax.Expressions.Expression, depth: Int) {
    switch expression {
        Syntax.Expressions.NullLiteral: print_line(depth, "Null")
        Syntax.Expressions.TrueLiteral: print_line(depth, "True")
        Syntax.Expressions.FalseLiteral: print_line(depth, "False")
        Syntax.Expressions.IntegerLiteral: print_line(depth, "Integer " + expression.value)
        Syntax.Expressions.FloatLiteral: print_line(depth, "Float " + expression.value)
        Syntax.Expressions.StringLiteralExpression: print_line(depth, "String \"" + expression.value + "\"")
        Syntax.Expressions.EnumLiteralExpression: print_line(depth, "Enum '" + expression.value + "'")
        Syntax.Expressions.GenericIdentifierExpression: print_line(depth, "Generic $" + expression.name)
        Syntax.Expressions.IdentifierExpression: print_line(depth, "Identifier " + expression.name)
        Syntax.Expressions.ListLiteralExpression: {
            print_line(depth, "List")
            var index = 0
            while index < expression.elements.count() {
                var element = expression.elements[index]
                var value = element.value
                assert value
                print_expression(value, depth + 1)
                index = index + 1
            }
        }
        Syntax.Expressions.ObjectLiteralExpression: {
            print_line(depth, "Object")
            var index = 0
            while index < expression.fields.count() {
                var field = expression.fields[index]
                print_line(depth + 1, field.name + ":")
                var value = field.value
                assert value
                print_expression(value, depth + 2)
                index = index + 1
            }
        }
        Syntax.Expressions.UnaryExpression: {
            print_line(depth, "Unary " + expression.operator)
            var operand = expression.operand
            assert operand
            print_expression(operand, depth + 1)
        }
        Syntax.Expressions.BinaryExpression: {
            print_line(depth, "Binary " + expression.operator)
            var left = expression.left
            assert left
            print_expression(left, depth + 1)
            var right = expression.right
            assert right
            print_expression(right, depth + 1)
        }
        Syntax.Expressions.CallExpression: {
            print_line(depth, "Call")
            var callee = expression.callee
            assert callee
            print_expression(callee, depth + 1)
            var index = 0
            while index < expression.arguments.count() {
                print_expression(expression.arguments[index], depth + 1)
                index = index + 1
            }
        }
        Syntax.Expressions.GenericCallExpression: {
            print_line(depth, "GenericCall")
            var callee = expression.callee
            assert callee
            print_expression(callee, depth + 1)
            var type_index = 0
            while type_index < expression.type_arguments.count() {
                print_line(depth + 1, "TypeArgument " + inline_generic_argument(expression.type_arguments[type_index]))
                type_index = type_index + 1
            }
            var index = 0
            while index < expression.arguments.count() {
                print_expression(expression.arguments[index], depth + 1)
                index = index + 1
            }
        }
        Syntax.Expressions.MemberExpression: {
            print_line(depth, "Member " + expression.name)
            var object = expression.object
            assert object
            print_expression(object, depth + 1)
        }
        Syntax.Expressions.IndexExpression: {
            print_line(depth, "Index")
            var object = expression.object
            assert object
            print_expression(object, depth + 1)
            var index_expression = expression.index
            assert index_expression
            print_expression(index_expression, depth + 1)
        }
    }
}
