var name = ""
var type_reference: Syntax.Types.Type? = null
var value: Syntax.Expressions.Expression? = null
var line = 0
var source_path = ""

func VariableDeclaration(declaration_name: String, declaration_type: Syntax.Types.Type?, declaration_value: Syntax.Expressions.Expression) {
    name = declaration_name
    type_reference = declaration_type
    value = declaration_value
}
