var shape = Analysis.AstShape()
var tokens = List<Token>()
var position = 0
var has_error = false
var error_line = 0
var error_column = 0
var error_message = ""
var quiet_generic_arguments_matched = false
var quiet_generic_instantiation_matched = false
var names_generic_class = false

func Parser(starting_tokens: List<Token>) {
    tokens = starting_tokens
}

func current(): Token {
    crash tokens[position]
    var token = tokens[position]
    return Token(token.kind, token.lexeme, token.text, token.line, token.column)
}

func current_kind(): TokenKind {
    crash tokens[position]
    return tokens[position].kind
}

func check(kind: TokenKind): Boolean {
    return current_kind() == kind
}

func advance(): Token {
    var token = current()
    if token.kind != 'end_of_file' {
        position = position + 1
    }
    return token
}

func next_kind(): TokenKind {
    var following = position + 1
    if following < tokens.count() {
        return tokens[following].kind
    }
    return 'end_of_file'
}

func found_text(): String {
    if check('newline') {
        return "the end of the line"
    }
    if check('end_of_file') {
        return "the end of the file"
    }
    return "'{current().lexeme}'"
}

func fail(message: String) {
    assert not has_error
    has_error = true
    error_line = current().line
    error_column = current().column
    error_message = message
}

func expect(kind: TokenKind, description: String): Token {
    if check(kind) {
        return advance()
    }
    fail("expected {description} but found {found_text()}")
    return current()
}

func skip_trivia() {
    var continue_skipping = true
    while continue_skipping and not check('end_of_file') {
        if check('newline') or check('comment') {
            advance()
        } else {
            continue_skipping = false
        }
    }
}

func at_statement_end(): Boolean {
    return check('newline') or check('right_brace') or check('end_of_file') or check('comment')
}

func consume_statement_terminator() {
    if check('comment') {
        advance()
    }
    if check('newline') {
        advance()
        return
    }
    assert not (check('right_brace') or check('end_of_file'))
    fail("expected end of statement but found {found_text()}")
}

func consume_field_separator(closing: TokenKind) {
    if check('comment') {
        advance()
    }
    if check('comma') {
        advance()
        skip_trivia()
        return
    }
    if check('newline') {
        skip_trivia()
        return
    }
    assert not (check(closing) or check('end_of_file'))
    fail("expected ',' or a newline but found '{current().lexeme}'")
}

func dummy_expression(): Syntax.Expressions.Expression {
    return Syntax.Expressions.NullLiteral()
}

func dummy_statement(): Syntax.Statements.Statement {
    var placeholder_expression = dummy_expression()
    return Syntax.Statements.ExpressionStatement(placeholder_expression)
}

func dummy_type(): Syntax.Types.Type {
    return Syntax.Types.GenericType("")
}

func parse_file(): Syntax.SourceFile {
    var parsed_top_level_statements = parse_top_level_statements()
    return Syntax.SourceFile(parsed_top_level_statements)
}

func is_declaration(statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.SingletonDeclaration: return true
        Syntax.Statements.GenericDeclaration: return true
        Syntax.Statements.VariableDeclaration: return true
        Syntax.Statements.FunctionDeclaration: return true
        Syntax.Statements.TypeDeclaration: return true
        Syntax.Statements.EnumDeclaration: return true
        Syntax.Statements.UnionDeclaration: return true
        _: return false
    }
}

func parse_top_level_statements(): List<Syntax.Statements.Statement> {
    var statements = List<Syntax.Statements.Statement>()
    var finished = false
    while not finished {
        skip_trivia()
        if check('end_of_file') or has_error {
            finished = true
        } else {
            var line = current().line
            var column = current().column
            var statement = parse_top_level_statement()
            if not is_declaration(statement) and not has_error {
                fail(
                    "a file holds declarations and nothing else: move this statement into a function, or into the class's constructor",
                )
                error_line = line
                error_column = column
            }
            statements.append(statement)
        }
    }
    return statements
}

func parse_top_level_statement(): Syntax.Statements.Statement {
    if not at_singleton_line() {
        return parse_statement()
    }
    var line = current().line
    advance()
    consume_statement_terminator()
    var declaration = Syntax.Statements.SingletonDeclaration()
    declaration.line = line
    return declaration
}

func at_singleton_line(): Boolean {
    assert check('identifier') and current().lexeme == "singleton"
    var following = next_kind()
    return following == 'newline' or following == 'end_of_file' or following == 'comment'
}

func parse_statement_list_until(stop_kind: TokenKind): List<Syntax.Statements.Statement> {
    var statements = List<Syntax.Statements.Statement>()
    var finished = false
    while not finished {
        skip_trivia()
        if check('end_of_file') or check(stop_kind) or has_error {
            finished = true
        } else if check('keyword_generic') {
            fail("a 'generic' line declares a codegen value of the whole class: move it to the top of the file")
            finished = true
        } else {
            var parsed_statement = parse_statement()
            statements.append(parsed_statement)
        }
    }
    return statements
}

func parse_block(): List<Syntax.Statements.Statement> {
    if check('identifier') and current().lexeme == "do" {
        fail(
            "Spite has no 'do': an 'if' on a value that may be null narrows it in place, 'if value \{ ... } else \{ ... }', and inside the block 'value' is the value itself",
        )
        return List<Syntax.Statements.Statement>()
    }
    expect('left_brace', "'\{'")
    var statements = parse_statement_list_until('right_brace')
    expect('right_brace', "'}'")
    return statements
}

func parse_statement(): Syntax.Statements.Statement {
    var line = current().line
    var statement = parse_statement_without_line()
    switch statement {
        _: statement.line = line
    }
    return statement
}

func parse_interpolation(hole: Token): Syntax.Expressions.Expression {
    if hole.text.trim().is_empty() {
        fail("there is nothing between '\{' and '}': write the value to place there, like \"hello \{name}\"")
        return dummy_expression()
    }
    var hole_lexer = Syntax.Lexer(hole.text)
    if hole_lexer.has_error {
        fail(hole_lexer.error_message)
        return dummy_expression()
    }
    var hole_parser = Syntax.Parser(hole_lexer.tokens)
    var value = hole_parser.parse_expression()
    if hole_parser.has_error {
        fail(hole_parser.error_message)
        return dummy_expression()
    }
    if not hole_parser.at_end_of_tokens() {
        fail("'{hole.text}' is more than one value: what goes between '\{' and '}' is a single value")
        return dummy_expression()
    }
    return value
}

func at_end_of_tokens(): Boolean {
    skip_trivia()
    return check('end_of_file')
}

func borrowed_word_lesson(word: String): String {
    if word == "new" {
        return "there is no 'new' in Spite: a class is made by calling its own name, like 'Creature(\"rat\")'"
    }
    if word == "self" {
        return "there is no 'self': a class reads its own attributes by name ('name', not 'self.name'), and 'this' is the value itself"
    }
    if word == "import" or word == "require" {
        return "there are no imports: 'load \"folder\"' inside a function brings a folder into the program, and everything shares one namespace"
    }
    if word == "elif" {
        return "Spite writes 'else if'"
    }
    if word == "null" or word == "nil" or word == "none" or word == "undefined" {
        return "the empty value is written 'null'"
    }
    return ""
}

func parse_statement_without_line(): Syntax.Statements.Statement {
    if check('identifier') and next_kind() == 'identifier' and (current().lexeme == "class" or current().lexeme == "struct" or current().lexeme == "interface" or current().lexeme == "trait") {
        fail(
            "there is no '{current().lexeme}' keyword: a file is a class, named after the file, and its attributes and functions are written at the top level of that file",
        )
        return dummy_statement()
    }
    if check('identifier') and current().lexeme == "for" {
        fail(
            "Spite only has 'while' loops; there is no 'for'. Use List<T>'s metaprogramming helpers or 'while index < list.count() \{ ... }' instead.",
        )
        return dummy_statement()
    }
    if check('identifier') and next_kind() == 'identifier' and (current().lexeme == "let" or current().lexeme == "const") {
        fail(
            "Spite has no '{current().lexeme}': a variable is declared 'var name = value', always with a default, and there is no 'const'",
        )
        return dummy_statement()
    }
    if check('identifier') and (current().lexeme == "break" or current().lexeme == "continue") and (next_kind() == 'newline' or next_kind() == 'right_brace' or next_kind() == 'end_of_file') {
        fail(
            "Spite has no '{current().lexeme}': a loop stops in its own condition, like 'while index < count and not found', and a step it skips sits under an 'if'",
        )
        return dummy_statement()
    }
    if check('keyword_generics') {
        return parse_generics_declaration()
    }
    if check('keyword_generic') {
        return parse_generic_declaration()
    }
    if check('variable_keyword') {
        return parse_variable_declaration()
    }
    if check('function_keyword') {
        return parse_function_declaration()
    }
    if check('keyword_type') {
        return parse_type_declaration()
    }
    if check('keyword_enum') {
        return parse_enum_declaration()
    }
    if check('keyword_union') {
        return parse_union_declaration()
    }
    if check('keyword_if') {
        return parse_if_statement()
    }
    if check('keyword_while') {
        return parse_while_statement()
    }
    if check('keyword_switch') {
        return parse_switch_statement()
    }
    if check('keyword_assert') {
        return parse_assert_statement()
    }
    if check('keyword_crash') {
        return parse_crash_statement()
    }
    if check('keyword_return') {
        return parse_return_statement()
    }
    if check('identifier') and current().lexeme == "load" {
        return parse_load_statement()
    }
    return parse_expression_or_assignment_statement()
}

func parse_load_statement(): Syntax.Statements.Statement {
    advance()
    var opening = current()
    var folder = parse_expression()
    if opening.kind == 'left_paren' and not has_error {
        var printer = Syntax.SourcePrinter()
        var written = printer.source_expression(folder)
        fail("'load' is a keyword, not a function: write it without parentheses, 'load {written}'")
        error_line = opening.line
        error_column = opening.column
        return dummy_statement()
    }
    consume_statement_terminator()
    var callee = Syntax.Expressions.IdentifierExpression("load")
    var arguments = List<Syntax.Expressions.Expression>()
    arguments.append(folder)
    var call = Syntax.Expressions.CallExpression(callee, arguments)
    return Syntax.Statements.ExpressionStatement(call)
}

func reject_load_name(kind: String) {
    assert check('identifier') and current().lexeme == "load"
    fail("'load' is a keyword and cannot name a {kind}: give it a name that says what it loads, like 'load_texture'")
}

func parse_generics_declaration(): Syntax.Statements.Statement {
    fail(
        "there is no 'generics' list: a class declares each codegen value on its own line at the top of the file, like 'generic $damage_type'",
    )
    return dummy_statement()
}

func parse_generic_declaration(): Syntax.Statements.Statement {
    advance()
    var name = expect('generic_identifier', "a codegen value name after 'generic', like 'generic $element_type'")
    if check('comma') {
        fail(
            "a 'generic' line declares one codegen value: write 'generic ${name.text}' and put the next one on its own line",
        )
        return dummy_statement()
    }
    var constraint: Syntax.Types.Type? = null
    if check('colon') {
        advance()
        constraint = parse_type()
    }
    consume_statement_terminator()
    return Syntax.Statements.GenericDeclaration(name.text, constraint)
}

func parse_variable_declaration(): Syntax.Statements.Statement {
    advance()
    reject_borrowed_name("variable")
    reject_load_name("variable")
    var name = expect('identifier', "a variable name")
    var type_reference: Syntax.Types.Type? = null
    if check('colon') {
        advance()
        type_reference = parse_type()
    }
    expect('equal', "'=' (every variable needs a default value)")
    var value = parse_expression()
    consume_statement_terminator()
    return Syntax.Statements.VariableDeclaration(name.text, type_reference, value)
}

func parse_function_declaration(): Syntax.Statements.Statement {
    advance()
    reject_load_name("function")
    var name = expect('identifier', "a function name")
    if check('less') {
        reject_constructor_codegen_list(name.text)
        return dummy_statement()
    }
    expect('left_paren', "'(' to start the parameter list")
    var parameters = List<Syntax.Statements.Parameter>()
    var expect_more = not check('right_paren')
    while expect_more and not check('end_of_file') {
        var is_variadic = check('ellipsis')
        if is_variadic {
            advance()
        }
        var parameter_text = parameter_name()
        expect('colon', "':' followed by the parameter's type")
        var parameter_type = parse_type()
        if check('equal') {
            fail(
                "a parameter has no default value in Spite: every argument is written at the call site, or the class holds the value as an attribute",
            )
        }
        if is_variadic and not is_list_type(parameter_type) {
            fail(
                "'...{parameter_text}' receives the arguments as a list: write '...{parameter_text}: List<Type>', where Type is a class or a type every argument fits",
            )
        }
        var parameter = Syntax.Statements.Parameter(parameter_text, parameter_type)
        parameter.is_variadic = is_variadic
        parameters.append(parameter)
        if check('comma') {
            advance()
            expect_more = not check('right_paren')
        } else {
            expect_more = false
        }
        if is_variadic and expect_more {
            fail(
                "'...{parameter_text}' takes every argument from here on, so it is the last parameter: move it to the end",
            )
        }
    }
    expect('right_paren', "')' to close the parameter list")
    var return_type: Syntax.Types.Type? = null
    if check('colon') {
        advance()
        return_type = parse_type()
    } else if not check('left_brace') and not at_statement_end() {
        fail("a return type is written '(): {current().lexeme}': add the ':' after the parameter list")
    }
    if at_statement_end() {
        var no_body = List<Syntax.Statements.Statement>()
        var supplied = Syntax.Statements.FunctionDeclaration(name.text, parameters, return_type, no_body)
        supplied.has_body = false
        return supplied
    }
    var body = parse_block()
    return Syntax.Statements.FunctionDeclaration(name.text, parameters, return_type, body)
}

func is_list_type(type_reference: Syntax.Types.Type): Boolean {
    var named = shape.as_named_type(type_reference)
    if named {
        return named.path.count() == 1 and named.path.join("") == "List" and named.arguments.count() == 1
    }
    return false
}

func reject_constructor_codegen_list(function_name: String) {
    var opening = advance()
    var lines = List<String>()
    while check('generic_identifier') {
        var codegen_token = advance()
        lines.append("generic ${codegen_token.text}")
        if check('comma') {
            advance()
        }
    }
    fail(
        "a function no longer lists codegen values between '<' and '>': declare each at the top of the file on its own line ('{lines.join("', '")}'), and write 'func {function_name}(' here",
    )
    error_line = opening.line
    error_column = opening.column
}

func parameter_name(): String {
    if check('keyword_type') and next_kind() == 'colon' {
        advance()
        return "type"
    }
    reject_borrowed_name("parameter")
    reject_load_name("parameter")
    var name = expect('identifier', "a parameter name")
    return name.text
}

func reject_borrowed_name(kind: String) {
    assert check('identifier')
    var lexeme = current().lexeme
    var lesson = borrowed_word_lesson(lexeme)
    assert not lesson.is_empty()
    fail("'{lexeme}' cannot name a {kind}, because Spite reads the word as a mistake anywhere it is used: {lesson}")
}

func parse_type_name_hint(): String {
    if check('identifier') {
        return current().lexeme
    }
    return "Type"
}

func parse_required_function(name: String): Syntax.Statements.FieldDeclaration {
    advance()
    var parameter_types = List<Syntax.Types.Type>()
    var expect_more = not check('right_paren')
    while expect_more and not check('end_of_file') {
        if check('identifier') and next_kind() == 'colon' {
            var named = advance()
            advance()
            fail(
                "a shape names the types it needs, not the names they are given: write '{parse_type_name_hint()}' where '{named.text}: ...' is, since a class satisfies it whatever it calls its parameters",
            )
            var placeholder_type = dummy_type()
            return Syntax.Statements.FieldDeclaration(name, placeholder_type)
        }
        var parsed_type = parse_type()
        parameter_types.append(parsed_type)
        if check('comma') {
            advance()
        } else {
            expect_more = false
        }
    }
    expect('right_paren', "')' to close the parameter list")
    var nothing_path = List<String>()
    nothing_path.append("Nothing")
    var no_generic_arguments = List<Syntax.Types.GenericArgument>()
    var return_type: Syntax.Types.Type = Syntax.Types.NamedType(nothing_path, no_generic_arguments)
    var returns_nothing = true
    if check('colon') {
        advance()
        return_type = parse_type()
        returns_nothing = false
    }
    var required = Syntax.Statements.FieldDeclaration(name, return_type)
    required.is_function = true
    required.returns_nothing = returns_nothing
    required.parameter_types = parameter_types
    return required
}

func reject_declaration_equal(keyword: String, name: String) {
    if check('equal') {
        fail("a declaration takes no '=': write '{keyword} {name} \{' with one entry on each line")
    }
}

func open_declaration_body(keyword: String) {
    if check('comment') {
        advance()
    }
    assert not (check('right_brace') or check('end_of_file'))
    if not check('newline') {
        fail("{keyword} declarations put each entry on its own line: start a new line after '\{'")
        advance()
        return
    }
    skip_trivia()
}

func consume_declaration_entry(keyword: String) {
    if check('comment') {
        advance()
    }
    if check('comma') {
        fail("{keyword} declarations separate their entries by lines, not commas: delete the ','")
        advance()
        return
    }
    if check('newline') {
        skip_trivia()
        return
    }
    assert not check('end_of_file')
    fail("{keyword} declarations put each entry on its own line: move '{current().lexeme}' to the next line")
    advance()
}

func parse_type_declaration(): Syntax.Statements.Statement {
    advance()
    var name = expect('identifier', "a type name")
    reject_declaration_equal("type", name.text)
    expect('left_brace', "'\{' to start the type body")
    open_declaration_body("type")
    var fields = List<Syntax.Statements.FieldDeclaration>()
    var finished = check('right_brace') or check('end_of_file')
    while not finished {
        var field_name = expect('identifier', "a field name")
        if check('left_paren') {
            var parsed_required_function = parse_required_function(field_name.text)
            fields.append(parsed_required_function)
        } else {
            expect('colon', "':' followed by the field's type")
            var field_type = parse_type()
            var field = Syntax.Statements.FieldDeclaration(field_name.text, field_type)
            field.line = field_name.line
            fields.append(field)
        }
        consume_declaration_entry("type")
        if check('right_brace') or check('end_of_file') or has_error {
            finished = true
        }
    }
    expect('right_brace', "'}' to close the type body")
    return Syntax.Statements.TypeDeclaration(name.text, fields)
}

func parse_enum_declaration(): Syntax.Statements.Statement {
    advance()
    var name = expect('identifier', "an enum name")
    reject_declaration_equal("enum", name.text)
    expect('left_brace', "'\{' to start the enum body")
    open_declaration_body("enum")
    var values = List<String>()
    var finished = check('right_brace') or check('end_of_file')
    while not finished {
        var value = expect('enum_literal', "an enum value (e.g. 'value')")
        values.append(value.text)
        consume_declaration_entry("enum")
        if check('right_brace') or check('end_of_file') or has_error {
            finished = true
        }
    }
    expect('right_brace', "'}' to close the enum body")
    return Syntax.Statements.EnumDeclaration(name.text, values)
}

func parse_union_declaration(): Syntax.Statements.Statement {
    advance()
    var name = expect('identifier', "a union name")
    reject_declaration_equal("union", name.text)
    expect('left_brace', "'\{' to start the union body")
    open_declaration_body("union")
    var members = List<Syntax.Types.Type>()
    var finished = check('right_brace') or check('end_of_file')
    while not finished {
        var member = parse_type()
        members.append(member)
        consume_declaration_entry("union")
        if check('right_brace') or check('end_of_file') or has_error {
            finished = true
        }
    }
    expect('right_brace', "'}' to close the union body")
    return Syntax.Statements.UnionDeclaration(name.text, members)
}

func parse_if_statement(): Syntax.Statements.Statement {
    advance()
    var condition = parse_expression()
    return parse_if_statement_with_condition(condition)
}

func parse_if_statement_with_condition(condition: Syntax.Expressions.Expression): Syntax.Statements.Statement {
    return parse_if_rest(condition)
}

func parse_if_rest(condition: Syntax.Expressions.Expression): Syntax.Statements.Statement {
    var then_branch = parse_block()
    var has_else_branch = false
    var else_branch = List<Syntax.Statements.Statement>()
    if check('keyword_else') {
        advance()
        has_else_branch = true
        if check('keyword_if') {
            var else_if_line = current().line
            var nested = parse_if_statement()
            var chained = shape.as_if_statement(nested)
            crash chained
            chained.follows_else = true
            chained.line = else_if_line
            var wrapped = List<Syntax.Statements.Statement>()
            wrapped.append(nested)
            else_branch = wrapped
        } else {
            else_branch = parse_block()
        }
    }
    return Syntax.Statements.IfStatement(condition, then_branch, has_else_branch, else_branch)
}

func parse_while_statement(): Syntax.Statements.Statement {
    advance()
    var condition = parse_expression()
    var body = parse_block()
    return Syntax.Statements.WhileStatement(condition, body)
}

func parse_switch_statement(): Syntax.Statements.Statement {
    advance()
    var subject = parse_expression()
    expect('left_brace', "'\{' to start the switch body")
    skip_trivia()
    var cases = List<Syntax.Statements.SwitchCase>()
    var finished = check('right_brace') or check('end_of_file')
    while not finished {
        var case_type = parse_type()
        expect('colon', "':' followed by the case body")
        var body = parse_switch_case_body()
        var switch_case = Syntax.Statements.SwitchCase(case_type, body)
        cases.append(switch_case)
        skip_trivia()
        if check('right_brace') or check('end_of_file') or has_error {
            finished = true
        }
    }
    expect('right_brace', "'}' to close the switch body")
    return Syntax.Statements.SwitchStatement(subject, cases)
}

func parse_switch_case_body(): List<Syntax.Statements.Statement> {
    if check('left_brace') {
        return parse_block()
    }
    var single = List<Syntax.Statements.Statement>()
    var parsed_statement = parse_statement()
    single.append(parsed_statement)
    return single
}

func parse_assert_statement(): Syntax.Statements.Statement {
    advance()
    var first_token = position
    var value = parse_expression()
    var condition_text = source_text_between(first_token, position)
    consume_statement_terminator()
    var statement = Syntax.Statements.AssertStatement(value)
    statement.condition_text = condition_text
    return statement
}

func parse_crash_statement(): Syntax.Statements.Statement {
    advance()
    var value: Syntax.Expressions.Expression = Syntax.Expressions.FalseLiteral()
    var first_token = position
    if not at_statement_end() {
        value = parse_expression()
    }
    var condition_text = source_text_between(first_token, position)
    consume_statement_terminator()
    var statement = Syntax.Statements.AssertStatement(value)
    statement.is_crash = true
    statement.condition_text = condition_text
    return statement
}

func source_text_between(first_token: Integer, after_last_token: Integer): String {
    var text = ""
    var index = first_token
    while index < after_last_token {
        crash tokens[index]
        if index == first_token {
            text = glue_lexeme(text, tokens[index].lexeme)
        } else {
            var previous = index - 1
            crash tokens[previous]
            if not same_place(tokens[index], tokens[previous]) {
                text = glue_lexeme(text, tokens[index].lexeme)
            }
        }
        index = index + 1
    }
    return text
}

func same_place(token: Token, other: Token): Boolean {
    return token.line == other.line and token.column == other.column
}

func glue_lexeme(text: String, lexeme: String): String {
    var glued = text.is_empty() or lexeme == ")" or lexeme == "]" or lexeme == "," or lexeme == "." or lexeme == "("
    if text.ends_with("(") or text.ends_with("[") or text.ends_with(".") {
        glued = true
    }
    if lexeme == "(" and (text.ends_with(" and") or text.ends_with(" or") or text.ends_with(" not") or text.ends_with("=") or text.ends_with("<") or text.ends_with(">")) {
        glued = false
    }
    if glued {
        return text + lexeme
    }
    return "{text} {lexeme}"
}

func parse_return_statement(): Syntax.Statements.Statement {
    advance()
    var value: Syntax.Expressions.Expression? = null
    if not at_statement_end() {
        value = parse_expression()
    }
    consume_statement_terminator()
    return Syntax.Statements.ReturnStatement(value)
}

func parse_expression_or_assignment_statement(): Syntax.Statements.Statement {
    var parsed_expression = parse_expression()
    return parse_expression_or_assignment_statement_with(parsed_expression)
}

func parse_expression_or_assignment_statement_with(
    expression: Syntax.Expressions.Expression,
): Syntax.Statements.Statement {
    if check('equal') {
        advance()
        var value = parse_expression()
        consume_statement_terminator()
        return Syntax.Statements.AssignmentStatement(expression, value)
    }
    consume_statement_terminator()
    return Syntax.Statements.ExpressionStatement(expression)
}

func parse_type(): Syntax.Types.Type {
    var parsed_type_without_suffix = parse_type_without_suffix()
    return with_nullable_suffix(parsed_type_without_suffix)
}

func with_nullable_suffix(type_reference: Syntax.Types.Type): Syntax.Types.Type {
    var result = type_reference
    while check('question') {
        advance()
        var wrapped_arguments = List<Syntax.Types.GenericArgument>()
        var type_argument = Syntax.Types.TypeArgument(result)
        wrapped_arguments.append(type_argument)
        var wrapper_path = List<String>()
        wrapper_path.append("Nullable")
        result = Syntax.Types.NamedType(wrapper_path, wrapped_arguments)
    }
    return result
}

func parse_type_without_suffix(): Syntax.Types.Type {
    if check('ampersand') {
        advance()
        var parsed_type = parse_type()
        return Syntax.Types.ReferenceType(parsed_type)
    }
    if check('generic_identifier') {
        var token = advance()
        if check('dot') {
            return generic_member_type(token.text)
        }
        return Syntax.Types.GenericType(token.text)
    }
    if check('keyword_type') and next_kind() == 'dot' {
        advance()
        var symbol_path = ["type"]
        return parse_type_path(symbol_path)
    }
    if not check('identifier') {
        fail("expected a type name but found {found_text()}")
        return dummy_type()
    }
    var path = List<String>()
    var segment_token = advance()
    path.append(segment_token.text)
    return parse_type_path(path)
}

func parse_dotted_segment(path: List<String>): Boolean {
    assert check('dot')
    advance()
    if check('identifier') {
        var segment_token = advance()
        path.append(segment_token.text)
        return true
    }
    fail("expected a name after '.' but found {found_text()}")
    return false
}

func parse_type_path(path: List<String>): Syntax.Types.Type {
    var continue_dots = true
    while continue_dots and not check('end_of_file') {
        continue_dots = parse_dotted_segment(path)
    }
    var arguments = List<Syntax.Types.GenericArgument>()
    if check('less') {
        advance()
        var expect_more = true
        while expect_more and not check('end_of_file') {
            var parsed_generic_argument = parse_generic_argument()
            arguments.append(parsed_generic_argument)
            if check('comma') {
                advance()
            } else {
                expect_more = false
            }
        }
        expect('greater', "'>' to close the generic argument list")
    }
    if path.count() == 1 and path[0] == "Nullable" {
        fail("'Nullable<T>' was replaced by a '?' suffix: write 'Monster?' for a value that may be null")
    }
    var named = Syntax.Types.NamedType(path, arguments)
    placed_type(named)
    return named
}

func placed_type(named: Syntax.Types.NamedType) {
    var following = current()
    named.line = following.line
    named.column = following.column
}

func generic_member_type(generic_name: String): Syntax.Types.Type {
    var path = List<String>()
    path.append("${generic_name}")
    while check('dot') {
        advance()
        if check('identifier') {
            var segment_token = advance()
            path.append(segment_token.text)
        } else {
            fail("expected the name of a codegen value after '.' but found {found_text()}")
        }
    }
    var no_generic_arguments = List<Syntax.Types.GenericArgument>()
    return Syntax.Types.NamedType(path, no_generic_arguments)
}

func parse_generic_argument(): Syntax.Types.GenericArgument {
    var result = try_parse_generic_argument_quiet()
    if result {
        return result
    }
    fail("expected a generic argument but found {found_text()}")
    return Syntax.Types.IntegerArgument(0)
}

func try_parse_generic_argument_list_quiet(): List<Syntax.Types.GenericArgument> {
    var saved_position = position
    quiet_generic_arguments_matched = false
    if not check('less') {
        return List<Syntax.Types.GenericArgument>()
    }
    advance()
    var arguments = List<Syntax.Types.GenericArgument>()
    var ok = true
    var expect_more = true
    while expect_more and ok and not check('end_of_file') {
        var argument_result = try_parse_generic_argument_quiet()
        var parsed_argument = false
        if argument_result {
            arguments.append(argument_result)
            parsed_argument = true
        }
        if not parsed_argument {
            ok = false
        }
        if ok {
            if check('comma') {
                advance()
            } else {
                expect_more = false
            }
        }
    }
    if ok and check('greater') {
        advance()
        quiet_generic_arguments_matched = true
    } else {
        position = saved_position
        arguments = List<Syntax.Types.GenericArgument>()
    }
    return arguments
}

func try_parse_generic_argument_quiet(): Syntax.Types.GenericArgument? {
    if check('integer_literal') {
        var token = advance()
        var text_number = token.text.to_long()
        var argument: Syntax.Types.GenericArgument = Syntax.Types.IntegerArgument(text_number)
        return argument
    }
    if check('float_literal') {
        var token = advance()
        var text_number = token.text.to_double()
        var argument: Syntax.Types.GenericArgument = Syntax.Types.FloatArgument(text_number)
        return argument
    }
    if check('string_literal') {
        var token = advance()
        var argument: Syntax.Types.GenericArgument = Syntax.Types.StringArgument(token.text)
        return argument
    }
    if check('enum_literal') {
        var token = advance()
        var argument: Syntax.Types.GenericArgument = Syntax.Types.EnumArgument(token.text)
        return argument
    }
    if check('keyword_true') {
        advance()
        var argument: Syntax.Types.GenericArgument = Syntax.Types.BooleanArgument(true)
        return argument
    }
    if check('keyword_false') {
        advance()
        var argument: Syntax.Types.GenericArgument = Syntax.Types.BooleanArgument(false)
        return argument
    }
    var type_result = try_parse_type_quiet()
    if type_result {
        var argument: Syntax.Types.GenericArgument = Syntax.Types.TypeArgument(type_result)
        return argument
    }
    return null
}

func try_parse_type_quiet(): Syntax.Types.Type? {
    if check('ampersand') {
        advance()
        var inner_result = try_parse_type_quiet()
        if inner_result {
            var type_reference: Syntax.Types.Type = Syntax.Types.ReferenceType(inner_result)
            return type_reference
        }
        return null
    }
    if check('generic_identifier') {
        var token = advance()
        if check('dot') {
            return generic_member_type(token.text)
        }
        var type_reference: Syntax.Types.Type = Syntax.Types.GenericType(token.text)
        return type_reference
    }
    assert check('identifier')
    var path = List<String>()
    var segment_token = advance()
    path.append(segment_token.text)
    var continue_dots = true
    var ok = true
    while continue_dots and ok and not check('end_of_file') {
        if check('dot') {
            advance()
            ok = check('identifier')
            if ok {
                var segment_token = advance()
                path.append(segment_token.text)
            }
        } else {
            continue_dots = false
        }
    }
    assert ok
    var arguments = try_parse_generic_argument_list_quiet()
    var named = Syntax.Types.NamedType(path, arguments)
    placed_type(named)
    var type_reference: Syntax.Types.Type = named
    return with_nullable_suffix(type_reference)
}

func try_parse_generic_instantiation_arguments(): List<Syntax.Types.GenericArgument> {
    var saved_position = position
    var argument_list = try_parse_generic_argument_list_quiet()
    quiet_generic_instantiation_matched = false
    if quiet_generic_arguments_matched and check('left_paren') {
        quiet_generic_instantiation_matched = true
    } else {
        position = saved_position
        argument_list = List<Syntax.Types.GenericArgument>()
    }
    return argument_list
}

func parse_expression(): Syntax.Expressions.Expression {
    var value = parse_binary_expression(0)
    if check('question') {
        fail(
            "Spite has no 'condition ? a : b': write an 'if' with an 'else', or a function that returns one or the other",
        )
    }
    return value
}

func binary_operator_precedence(kind: TokenKind): Integer {
    if kind == 'keyword_or' {
        return 1
    }
    if kind == 'keyword_and' {
        return 2
    }
    if kind == 'equal_equal' or kind == 'bang_equal' {
        return 3
    }
    if kind == 'less' or kind == 'less_equal' or kind == 'greater' or kind == 'greater_equal' {
        return 4
    }
    if kind == 'plus' or kind == 'minus' {
        return 5
    }
    if kind == 'star' or kind == 'slash' or kind == 'percent' {
        return 6
    }
    return -1
}

func binary_operator_for(kind: TokenKind): Syntax.Expressions.BinaryOperator {
    if kind == 'keyword_or' {
        return 'logical_or'
    }
    if kind == 'keyword_and' {
        return 'logical_and'
    }
    if kind == 'equal_equal' {
        return 'equal'
    }
    if kind == 'bang_equal' {
        return 'not_equal'
    }
    if kind == 'less' {
        return 'less'
    }
    if kind == 'less_equal' {
        return 'less_equal'
    }
    if kind == 'greater' {
        return 'greater'
    }
    if kind == 'greater_equal' {
        return 'greater_equal'
    }
    if kind == 'plus' {
        return 'add'
    }
    if kind == 'minus' {
        return 'subtract'
    }
    if kind == 'star' {
        return 'multiply'
    }
    if kind == 'slash' {
        return 'divide'
    }
    return 'modulo'
}

func parse_binary_expression(minimum_precedence: Integer): Syntax.Expressions.Expression {
    var parsed_unary = parse_unary()
    return parse_binary_expression_rest(parsed_unary, minimum_precedence)
}

func parse_binary_expression_rest(
    left: Syntax.Expressions.Expression,
    minimum_precedence: Integer,
): Syntax.Expressions.Expression {
    var kind = current_kind()
    var precedence = binary_operator_precedence(kind)
    if precedence < 0 or precedence < minimum_precedence {
        return left
    }
    kind = current_kind()
    var operator = binary_operator_for(kind)
    var joining = check('plus')
    var tests_class = check('equal_equal') or check('bang_equal')
    var operator_token = advance()
    reject_shift(operator_token)
    var saved_names_generic_class = names_generic_class
    names_generic_class = tests_class
    var right = parse_binary_expression(precedence + 1)
    names_generic_class = saved_names_generic_class
    if joining {
        reject_written_text_join(left, right)
    }
    var binary = Syntax.Expressions.BinaryExpression(operator, left, right)
    return parse_binary_expression_rest(binary, minimum_precedence)
}

func reject_shift(operator_token: Token) {
    assert operator_token.kind == 'less' or operator_token.kind == 'greater'
    assert check(operator_token.kind)
    var following = current()
    assert following.line == operator_token.line and following.column == operator_token.column + 1
    if operator_token.kind == 'less' {
        fail("Spite has no '<<': bits are functions on the whole numbers, write 'value.shifted_left(count)'")
        return
    }
    fail("Spite has no '>>': bits are functions on the whole numbers, write 'value.shifted_right(count)'")
}

func reject_written_text_join(left: Syntax.Expressions.Expression, right: Syntax.Expressions.Expression) {
    var written_left = shape.as_string_literal(left)
    var written_right = shape.as_string_literal(right)
    if written_left and written_right {
        fail("these are two pieces of written text: write them as one")
        return
    }
    if written_left {
        fail(
            "text written down is not joined with '+': put the value inside it, like \"hello \{name}\". Two values are still joined with '+'",
        )
        return
    }
    assert written_right
    fail(
        "text written down is not joined with '+': put the value inside it, like \"\{name} arrived\". Two values are still joined with '+'",
    )
}

func parse_unary(): Syntax.Expressions.Expression {
    if check('minus') or check('keyword_not') {
        var operator: Syntax.Expressions.UnaryOperator = 'negate'
        if current_kind() == 'keyword_not' {
            operator = 'logical_not'
        }
        advance()
        var operand = parse_unary()
        return Syntax.Expressions.UnaryExpression(operator, operand)
    }
    return parse_postfix()
}

func parse_postfix(): Syntax.Expressions.Expression {
    var parsed_primary = parse_primary()
    return parse_postfix_rest(parsed_primary)
}

func parse_postfix_rest(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    if check('dot') {
        advance()
        var name = expect('identifier', "a member name after '.'")
        var member = Syntax.Expressions.MemberExpression(expression, name.text)
        return parse_postfix_rest(member)
    }
    if check('left_paren') {
        var arguments = parse_argument_list()
        var call = Syntax.Expressions.CallExpression(expression, arguments)
        return parse_postfix_rest(call)
    }
    if check('left_bracket') {
        advance()
        var index_expression = parse_expression()
        expect('right_bracket', "']' to close the index expression")
        var indexed = Syntax.Expressions.IndexExpression(expression, index_expression)
        return parse_postfix_rest(indexed)
    }
    if check('less') {
        var type_arguments = try_parse_generic_instantiation_arguments()
        if not quiet_generic_instantiation_matched {
            return named_generic_class(expression)
        }
        var arguments = parse_argument_list()
        var generic_call = Syntax.Expressions.GenericCallExpression(expression, type_arguments, arguments)
        var following = current()
        generic_call.line = following.line
        generic_call.column = following.column
        return parse_postfix_rest(generic_call)
    }
    return expression
}

func named_generic_class(expression: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    if not names_generic_class {
        return expression
    }
    var type_arguments = try_parse_generic_argument_list_quiet()
    if not quiet_generic_arguments_matched {
        return expression
    }
    var no_arguments = List<Syntax.Expressions.Expression>()
    var named = Syntax.Expressions.GenericCallExpression(expression, type_arguments, no_arguments)
    named.names_class = true
    return named
}

func parse_argument_list(): List<Syntax.Expressions.Expression> {
    var saved_names_generic_class = names_generic_class
    names_generic_class = false
    var arguments = parse_arguments_between_parentheses()
    names_generic_class = saved_names_generic_class
    return arguments
}

func parse_arguments_between_parentheses(): List<Syntax.Expressions.Expression> {
    expect('left_paren', "'(' to start the argument list")
    var arguments = List<Syntax.Expressions.Expression>()
    var expect_more = not check('right_paren')
    while expect_more and not check('end_of_file') {
        var parsed_expression = parse_expression()
        arguments.append(parsed_expression)
        if check('comma') {
            advance()
            expect_more = not check('right_paren')
        } else {
            expect_more = false
        }
    }
    expect('right_paren', "')' to close the argument list")
    return arguments
}

func parse_primary(): Syntax.Expressions.Expression {
    if check('integer_literal') {
        var token = advance()
        var text_number = token.text.to_long()
        return Syntax.Expressions.IntegerLiteral(text_number)
    }
    if check('float_literal') {
        var token = advance()
        var text_number = token.text.to_double()
        var float_literal = Syntax.Expressions.FloatLiteral(text_number)
        float_literal.written = token.lexeme
        return float_literal
    }
    if check('string_literal') {
        var token = advance()
        var text: Syntax.Expressions.Expression = Syntax.Expressions.StringLiteralExpression(token.text)
        while check('interpolation') {
            var hole = advance()
            var parsed_interpolation = parse_interpolation(hole)
            var joined = Syntax.Expressions.BinaryExpression('add', text, parsed_interpolation)
            joined.is_text_join = true
            text = joined
            var following = expect('string_literal', "the rest of the text after '}'")
            if not following.text.is_empty() {
                var piece: Syntax.Expressions.Expression = Syntax.Expressions.StringLiteralExpression(following.text)
                var joined = Syntax.Expressions.BinaryExpression('add', text, piece)
                joined.is_text_join = true
                text = joined
            }
        }
        return text
    }
    if check('enum_literal') {
        var token = advance()
        return Syntax.Expressions.EnumLiteralExpression(token.text)
    }
    if check('generic_identifier') {
        var token = advance()
        return Syntax.Expressions.GenericIdentifierExpression(token.text)
    }
    if check('keyword_null') {
        advance()
        return Syntax.Expressions.NullLiteral()
    }
    if check('keyword_true') {
        advance()
        return Syntax.Expressions.TrueLiteral()
    }
    if check('keyword_false') {
        advance()
        return Syntax.Expressions.FalseLiteral()
    }
    if check('keyword_this') {
        return parse_this()
    }
    if check('identifier') {
        var lexeme = current().lexeme
        var borrowed = borrowed_word_lesson(lexeme)
        if not borrowed.is_empty() {
            fail(borrowed)
            advance()
            return dummy_expression()
        }
        if lexeme == "load" {
            fail(
                "'load' is a keyword that starts a line of its own, like 'load \"folder\"': it is not a function, and it has no value",
            )
            advance()
            return dummy_expression()
        }
        var token = advance()
        return Syntax.Expressions.IdentifierExpression(token.text)
    }
    if check('left_paren') {
        advance()
        var inner = parse_expression()
        expect('right_paren', "')' to close the parenthesized expression")
        return inner
    }
    if check('left_bracket') {
        return parse_list_literal()
    }
    if check('left_brace') {
        return parse_object_literal()
    }
    fail("expected an expression but found '{current().lexeme}'")
    return dummy_expression()
}

func parse_this(): Syntax.Expressions.Expression {
    if next_kind() != 'dot' {
        advance()
        return Syntax.Expressions.IdentifierExpression("this")
    }
    var following = position + 2
    var after = position + 3
    var member = "name"
    var called = false
    if following < tokens.count() {
        member = tokens[following].lexeme
    }
    if after < tokens.count() {
        called = tokens[after].kind == 'left_paren'
    }
    if called {
        fail("a class calls its own functions by name: write '{member}()', not 'this.{member}()'")
    } else {
        fail("a class reads its own attributes by name: write '{member}', not 'this.{member}'")
    }
    advance()
    return dummy_expression()
}

func parse_list_literal(): Syntax.Expressions.Expression {
    advance()
    skip_trivia()
    var elements = List<Syntax.Expressions.ListElement>()
    var finished = check('right_bracket') or check('end_of_file')
    while not finished {
        var value = parse_expression()
        var element = Syntax.Expressions.ListElement(value)
        elements.append(element)
        consume_field_separator('right_bracket')
        skip_trivia()
        if check('right_bracket') or check('end_of_file') or has_error {
            finished = true
        }
    }
    expect('right_bracket', "']' to close the list literal")
    return Syntax.Expressions.ListLiteralExpression(elements)
}

func parse_object_literal(): Syntax.Expressions.Expression {
    advance()
    skip_trivia()
    var fields = List<Syntax.Expressions.ObjectField>()
    var finished = check('right_brace') or check('end_of_file')
    while not finished {
        var name = expect('identifier', "a field name")
        expect('colon', "':' followed by the field's value")
        var value = parse_expression()
        var field = Syntax.Expressions.ObjectField(name.text, value)
        fields.append(field)
        consume_field_separator('right_brace')
        skip_trivia()
        if check('right_brace') or check('end_of_file') or has_error {
            finished = true
        }
    }
    expect('right_brace', "'}' to close the object literal")
    return Syntax.Expressions.ObjectLiteralExpression(fields)
}
