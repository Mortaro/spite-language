var mangled_name = ""
var simple_name = ""
var namespace_dotted = ""
var qualified_dotted = ""
var source_file: Nullable<Syntax.SourceFile> = null

func DiscoveredClass(starting_mangled_name: String, starting_simple_name: String, starting_namespace_dotted: String, starting_qualified_dotted: String, starting_source_file: Syntax.SourceFile) {
    mangled_name = starting_mangled_name
    simple_name = starting_simple_name
    namespace_dotted = starting_namespace_dotted
    qualified_dotted = starting_qualified_dotted
    source_file = starting_source_file
}

func get_file(): Syntax.SourceFile {
    var value = source_file
    crash value
    return value
}
