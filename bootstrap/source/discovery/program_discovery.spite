var shape = Analysis.AstShape()
var class_files = List<DiscoveredClass>()
var has_error = false
var comment_root = ""
var error_message = ""
var walking_library = false
var language_folder = "."
var formats = false
var console = Console()
var build = Build()
var host_operating_system = build.target_operating_system
var supplied_settings = Dictionary<String>()
var bare_settings = List<String>()
var build_values = Dictionary<String>()
var entry_qualified = ""
var entry_file_path = ""

func discover(entry_path: String, entry_source: String): DiscoveryResult {
    choose_target_operating_system()
    choose_program(entry_path)
    if has_error {
        return failure(error_message)
    }
    var launcher = read_launcher()
    if has_error {
        return failure(error_message)
    }
    crash launcher
    var loads = launcher_loads(launcher)
    var index = 0
    while index < loads.count() and not has_error {
        load_folder(loads[index], entry_path, entry_source)
        index = index + 1
    }
    if has_error {
        return failure(error_message)
    }
    read_settings()
    if has_error {
        return failure(error_message)
    }
    mark_program_load()
    var entry_stem = file_stem(entry_path)
    var entry_pascal_name = pascal_case(entry_stem)
    var entry_mangled_name = mangle_dotted(entry_pascal_name)
    var discovered = DiscoveryResult(class_files, entry_mangled_name, false, "")
    discovered.build_values = build_values
    discovered.launcher_mangled_name = "Launcher"
    return discovered
}

func choose_program(entry_path: String) {
    if supplied_settings.has("program") {
        has_error = true
        error_message = "error: '--program' cannot be given: the program is the folder named on the command line, 'spite folder', and Build.program is set from it"
    }
    supplied_settings["program"] = directory_of(entry_path)
}

func launcher_path(): String {
    return "launcher/launcher.spite"
}

func read_launcher(): Syntax.SourceFile? {
    var path = launcher_path()
    var launcher_file = File("{language_folder}/{path}")
    if not launcher_file.read() {
        has_error = true
        error_message = "error: could not read '{language_folder}/{path}', the Spite program that loads the standard library and then this program: the compiler looks for it in the folders above its own executable"
        return null
    }
    var no_segments = List<String>()
    walking_library = true
    read_and_add_file(path, no_segments)
    walking_library = false
    return class_file_named("Launcher")
}

func launcher_loads(launcher: Syntax.SourceFile): List<Syntax.Expressions.CallExpression> {
    var loads = List<Syntax.Expressions.CallExpression>()
    var index = 0
    while index < launcher.statements.count() {
        var function = shape.as_function_declaration(launcher.statements[index])
        if function {
            if function.name == "Launcher" {
                collect_loads(function.body, loads)
            }
        }
        index = index + 1
    }
    return loads
}

func collect_loads(statements: List<Syntax.Statements.Statement>, loads: List<Syntax.Expressions.CallExpression>) {
    var index = 0
    while index < statements.count() {
        var expression_statement = shape.as_expression_statement(statements[index])
        if expression_statement {
            crash expression_statement.value
            var call = shape.as_call(expression_statement.value)
            if call {
                if is_load_call(call) {
                    loads.append(call)
                }
            }
        }
        index = index + 1
    }
}

func is_load_call(call: Syntax.Expressions.CallExpression): Bool {
    crash call.callee
    var identifier = shape.as_identifier(call.callee)
    if identifier {
        return identifier.name == "load" and call.arguments.count() == 1
    }
    return false
}

func load_folder(call: Syntax.Expressions.CallExpression, entry_path: String, entry_source: String) {
    crash call.arguments[0]
    var path = load_path(call.arguments[0])
    if not path {
        has_error = true
        error_message = "{launcher_path()}: error: the launcher loads folders known when compiling: text, and Build fields given to the compiler, like load(\"library/\{build.target_operating_system}\") beside 'var build = Build()'"
        return
    }
    crash path
    if path == supplied_settings["program"] {
        discover_program(entry_path, entry_source)
        return
    }
    var folder = Directory("{language_folder}/{path}")
    if not folder.exists() {
        has_error = true
        error_message = "{launcher_path()}: error: could not find the folder '{path}' it loads"
        return
    }
    var no_segments = List<String>()
    var no_skip: String? = null
    var no_exclusions = List<String>()
    walking_library = true
    walk_directory(path, no_segments, no_skip, no_exclusions)
    walking_library = false
}

func load_path(expression: Syntax.Expressions.Expression): String? {
    var literal = shape.as_string_literal(expression)
    if literal {
        return literal.value
    }
    var joined = shape.as_binary(expression)
    if joined {
        crash joined.left
        crash joined.right
        var left = load_path(joined.left)
        var right = load_path(joined.right)
        if left {
            if right {
                return "{left}{right}"
            }
        }
        return null
    }
    var member = shape.as_member(expression)
    if member {
        crash member.object
        var receiver = shape.as_identifier(member.object)
        if receiver {
            if launcher_binds_build(receiver.name) {
                return supplied_settings[member.name]
            }
        }
    }
    return null
}

func launcher_binds_build(name: String): Bool {
    var launcher = class_file_named("Launcher")
    crash launcher
    if declares_build(launcher.statements, name) {
        return true
    }
    var index = 0
    while index < launcher.statements.count() {
        var function = shape.as_function_declaration(launcher.statements[index])
        if function {
            if function.name == "Launcher" {
                return declares_build(function.body, name)
            }
        }
        index = index + 1
    }
    return false
}

func declares_build(statements: List<Syntax.Statements.Statement>, name: String): Bool {
    var index = 0
    while index < statements.count() {
        var declaration = shape.as_variable_declaration(statements[index])
        if declaration {
            crash declaration.value
            if declaration.name == name and is_build_call(declaration.value) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func is_build_call(expression: Syntax.Expressions.Expression): Bool {
    var call = shape.as_call(expression)
    if call {
        crash call.callee
        var identifier = shape.as_identifier(call.callee)
        if identifier {
            return identifier.name == "Build" and call.arguments.is_empty()
        }
    }
    return false
}

func mark_program_load() {
    var launcher = class_file_named("Launcher")
    crash launcher
    var loads = launcher_loads(launcher)
    var index = 0
    while index < loads.count() {
        crash loads[index].arguments[0]
        var path = load_path(loads[index].arguments[0])
        if path == supplied_settings["program"] {
            loads[index].runs_program = true
        }
        index = index + 1
    }
}

func discover_program(entry_path: String, entry_source: String) {
    var formatted_source = formatted_source(entry_path, entry_source)
    var lexer = Syntax.Lexer(formatted_source)
    if lexer.has_error {
        has_error = true
        error_message = lex_failure(entry_path, lexer)
        return
    }
    comment_root = directory_of(entry_path)
    check_comments(entry_path, lexer.tokens)
    check_blank_lines(entry_path, lexer.tokens)
    assert not has_error
    var parser = Syntax.Parser(lexer.tokens)
    var entry_file = parser.parse_file()
    if parser.has_error {
        has_error = true
        error_message = "{entry_path}:{parser.error_line}:{parser.error_column}: {parser.error_message}"
        return
    }
    var file_stem = file_stem(entry_path)
    var pascal_case = pascal_case(file_stem)
    check_order(entry_path, entry_file, pascal_case)
    check_entry_constructor(entry_path, entry_file, pascal_case)
    assert not has_error
    var entry_directory = directory_of(entry_path)
    var entry_stem = file_stem(entry_path)
    var entry_basename = basename(entry_path)
    var load_names = List<String>()
    scan_top_level_loads(entry_file, load_names)
    var empty_segments = List<String>()
    reopen_with_supplied_members()
    entry_file.path = entry_path
    add_parsed_file(entry_file, empty_segments, entry_stem)
    entry_qualified = compute_qualified(empty_segments, entry_stem)
    entry_file_path = entry_path
    walk_directory(entry_directory, empty_segments, entry_basename, load_names)
    var root_index = 0
    while root_index < load_names.count() and not has_error {
        load_root(entry_path, entry_directory, load_names[root_index])
        root_index = root_index + 1
    }
}

func load_root(entry_path: String, entry_directory: String, root_name: String) {
    if root_name == "spite" {
        has_error = true
        error_message = "{entry_path}: error: 'spite' is reserved for the built-in Spite namespace: name the folder something else"
        return
    }
    var root_folder = "{entry_directory}/{root_name}"
    var root_directory = Directory(root_folder)
    if not root_directory.exists() {
        has_error = true
        error_message = "could not find the folder '{root_name}' loaded by {entry_path}"
        return
    }
    var empty_segments = List<String>()
    var no_skip: String? = null
    var no_exclusions = List<String>()
    walk_directory(root_folder, empty_segments, no_skip, no_exclusions)
}

func lex_failure(path: String, lexer: Syntax.Lexer): String {
    if lexer.error_message.is_empty() {
        return "could not lex '{path}'"
    }
    return "{path}:{lexer.error_line}: error: {lexer.error_message}"
}

func comment_lesson(): String {
    return "a comment is one line holding only a link to a markdown section, like '# docs/memory.md#cycles', and only outside functions. Ask whether the note is needed: if a reader could work it out from the code, delete it; if it is lasting knowledge, write the section first and link to it; if it warns against a change, a test or a compile error pushes harder than prose"
}

func check_order(path: String, file: Syntax.SourceFile, class_name: String) {
    var kinds = [
        "the singleton line"
        "a generic line"
        "an enum"
        "a union"
        "a type"
        "a variable"
        "the constructor"
        "a function"
    ]
    var reached = 0
    var index = 0
    while index < file.statements.count() {
        var statement = file.statements[index]
        var rank = order_rank(statement, class_name)
        if rank >= 0 and rank < reached and not has_error {
            has_error = true
            crash kinds[rank]
            crash kinds[reached]
            error_message = "{path}:{statement_line(statement)}: error: {kinds[rank]} comes after {kinds[reached]} here, but a file is ordered: the singleton line, generic lines, enums, unions, types, variables, the constructor, then functions"
        }
        if rank > reached {
            reached = rank
        }
        index = index + 1
    }
}

func check_entry_constructor(path: String, file: Syntax.SourceFile, class_name: String) {
    var index = 0
    while index < file.statements.count() and not has_error {
        var function = shape.as_function_declaration(file.statements[index])
        if function {
            if function.name == class_name and not function.parameters.is_empty() {
                has_error = true
                error_message = "{path}:{function.line}: error: '{class_name}' is the entry constructor, and it takes no arguments: a program reads its run-time settings through Environment() (declared in its environment.spite, given after '--'), what its build decided through Build(), and the raw command line through Arguments(), anywhere"
            }
        }
        index = index + 1
    }
}

func order_rank(statement: Syntax.Statements.Statement, class_name: String): Int {
    assert not shape.as_singleton_declaration(statement)
    if shape.as_generic_declaration(statement) {
        return 1
    }
    if shape.as_enum_declaration(statement) {
        return 2
    }
    if shape.as_union_declaration(statement) {
        return 3
    }
    if shape.as_type_declaration(statement) {
        return 4
    }
    if shape.as_variable_declaration(statement) {
        return 5
    }
    var function = shape.as_function_declaration(statement)
    if function {
        if function.name == class_name {
            return 6
        }
        return 7
    }
    return -1
}

func statement_line(statement: Syntax.Statements.Statement): Int {
    var enumeration = shape.as_enum_declaration(statement)
    if enumeration {
        return enumeration.line
    }
    var joined = shape.as_union_declaration(statement)
    if joined {
        return joined.line
    }
    var described = shape.as_type_declaration(statement)
    if described {
        return described.line
    }
    var variable = shape.as_variable_declaration(statement)
    if variable {
        return variable.line
    }
    var function = shape.as_function_declaration(statement)
    if function {
        return function.line
    }
    var generic_line = shape.as_generic_declaration(statement)
    if generic_line {
        return generic_line.line
    }
    var singleton_line = shape.as_singleton_declaration(statement)
    if singleton_line {
        return singleton_line.line
    }
    return 0
}

func check_comments(path: String, tokens: List<Syntax.Token>) {
    var depth = 0
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        if token.kind == 'left_brace' {
            depth = depth + 1
        }
        if token.kind == 'right_brace' {
            depth = depth - 1
        }
        if token.kind == 'comment' and not has_error {
            var trimmed_text = token.text.trim()
            var problem = comment_problem(trimmed_text, depth)
            if not problem.is_empty() {
                has_error = true
                error_message = "{path}:{token.line}: error: {problem}"
            }
        }
        index = index + 1
    }
}

func check_blank_lines(path: String, tokens: List<Syntax.Token>) {
    var depth = 0
    var in_function = false
    var previous_line = 0
    var previous_kind: Syntax.TokenKind = 'end_of_file'
    var last_declaration: Syntax.TokenKind = 'end_of_file'
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        if depth == 0 and (token.kind == 'function_keyword' or token.kind == 'keyword_type' or token.kind == 'keyword_enum' or token.kind == 'keyword_union') {
            last_declaration = token.kind
        }
        if token.kind == 'left_brace' {
            if depth == 0 {
                in_function = last_declaration == 'function_keyword'
            }
            depth = depth + 1
        }
        if token.kind == 'right_brace' {
            depth = depth - 1
            if depth == 0 {
                in_function = false
            }
        }
        if in_function and depth > 0 and previous_kind == 'newline' and token.line - previous_line > 1 and not has_error {
            has_error = true
            error_message = "{path}:{previous_line + 1}: error: a function body holds no empty lines: the blank line is where a second function wants to be, so give the part below it a name and call it"
        }
        if token.kind != 'end_of_file' {
            previous_line = token.line
            previous_kind = token.kind
        }
        index = index + 1
    }
}

func comment_problem(text: String, depth: Int): String {
    if depth > 0 {
        return "a comment may not appear inside a function or a declaration body: a line that needs explaining becomes a named function instead. {comment_lesson()}"
    }
    var hash_position = text.index_of("#")
    if text.contains(" ") or hash_position < 1 or not text.slice(0, hash_position).ends_with(".md") {
        return "this comment is not a link: {comment_lesson()}"
    }
    var markdown_path = text.slice(0, hash_position)
    var text_length = text.length()
    var anchor = text.slice(hash_position + 1, text_length)
    var content = File("{comment_root}/{markdown_path}").read()
    if not content {
        return "this comment links to '{markdown_path}', which does not exist (the path is relative to the entry file's folder, like load)"
    }
    if content {
        if not markdown_anchors(content).contains(anchor) {
            return "this comment links to '{markdown_path}#{anchor}', but that file has no heading with that anchor"
        }
    }
    return ""
}

func markdown_anchors(content: String): List<String> {
    var anchors = List<String>()
    var lines = content.lines()
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        if line.starts_with("#") {
            var heading = line
            while heading.starts_with("#") {
                var heading_length = heading.length()
                heading = heading.slice(1, heading_length)
            }
            var trimmed_heading = heading.trim()
            var anchor = heading_anchor(trimmed_heading)
            var candidate = anchor
            var suffix = 1
            while anchors.contains(candidate) {
                candidate = "{anchor}-{suffix}"
                suffix = suffix + 1
            }
            anchors.append(candidate)
        }
        index = index + 1
    }
    return anchors
}

func heading_anchor(heading: String): String {
    var lowered = heading.lower_case()
    var anchor = ""
    var index = 0
    while index < lowered.length() {
        var code = lowered.code_at(index)
        var is_letter = code >= 97 and code <= 122
        var is_digit = code >= 48 and code <= 57
        if is_letter or is_digit or code == 45 or code == 95 {
            anchor = anchor + lowered.character_at(index)
        }
        if code == 32 {
            anchor = "{anchor}-"
        }
        index = index + 1
    }
    return anchor
}

func failure(message: String): DiscoveryResult {
    var empty = List<DiscoveredClass>()
    return DiscoveryResult(empty, "", true, message)
}

func is_platform_folder(name: String): Bool {
    return name == "windows" or name == "linux" or name == "mac"
}

func choose_target_operating_system() {
    if supplied_settings.has("operating_system") {
        has_error = true
        error_message = "error: '--operating_system' cannot be given: Build.operating_system is the system doing the compiling ({host_operating_system}). To write the program for another system, give --target_operating_system=linux (or windows, or mac)"
    }
    supplied_settings["operating_system"] = host_operating_system
    if supplied_settings["target_operating_system"] {
        if not is_platform_folder(supplied_settings["target_operating_system"]) and not has_error {
            has_error = true
            error_message = "error: '--target_operating_system={supplied_settings["target_operating_system"]}' names no operating system the library has a folder for: windows, linux or mac"
        }
    } else {
        supplied_settings["target_operating_system"] = host_operating_system
    }
}

func walk_directory(
    root_folder: String,
    segments: List<String>,
    skip_basename: String?,
    excluded_top_level: List<String>,
) {
    var path = root_folder
    var index = 0
    while index < segments.count() {
        path = "{path}/{segments[index]}"
        index = index + 1
    }
    var folder_on_disk = on_disk(path)
    var directory = Directory(folder_on_disk)
    assert directory.exists()
    var files = directory.files()
    var file_index = 0
    while file_index < files.count() {
        var name = files[file_index]
        if name.ends_with(".spite") {
            var skip = false
            if segments.is_empty() {
                if skip_basename {
                    if name == skip_basename {
                        skip = true
                    }
                }
            }
            if not skip {
                read_and_add_file("{path}/{name}", segments)
            }
        }
        file_index = file_index + 1
    }
    var folders = directory.folders()
    var folder_index = 0
    while folder_index < folders.count() {
        var folder_name = folders[folder_index]
        var excluded = false
        if segments.is_empty() {
            excluded = excluded_top_level.contains(folder_name)
            if walking_library and is_platform_folder(folder_name) {
                excluded = true
            }
        }
        if not excluded {
            var child_segments = copy_segments(segments)
            child_segments.append(folder_name)
            walk_directory(root_folder, child_segments, skip_basename, excluded_top_level)
        }
        folder_index = folder_index + 1
    }
}

func on_disk(path: String): String {
    if walking_library {
        return "{language_folder}/{path}"
    }
    return path
}

func copy_segments(segments: List<String>): List<String> {
    return segments.copy()
}

func formatted_source(path: String, source: String): String {
    if not formats or walking_library {
        return source
    }
    var probe = Syntax.Lexer(source)
    if not probe.has_error {
        check_blank_lines(path, probe.tokens)
    }
    if has_error {
        return source
    }
    var formatter = Syntax.Formatter()
    var formatted = formatter.format(source)
    if not formatted {
        if not formatter.refusal.contains("parse") and not formatter.refusal.contains("lex") {
            console.error("{path}: not formatted: {formatter.refusal}")
        }
        return source
    }
    crash formatted
    if formatted == source {
        return source
    }
    if not File(path).write(formatted) {
        return source
    }
    console.error("formatted {path}")
    return formatted
}

func read_and_add_file(path: String, segments: List<String>) {
    assert not has_error
    var file_on_disk = on_disk(path)
    var program_file = File(file_on_disk)
    var content = program_file.read()
    if content {
        var formatted_source = formatted_source(path, content)
        var lexer = Syntax.Lexer(formatted_source)
        if lexer.has_error {
            has_error = true
            error_message = lex_failure(path, lexer)
            return
        }
        check_comments(path, lexer.tokens)
        check_blank_lines(path, lexer.tokens)
        assert not has_error
        var parser = Syntax.Parser(lexer.tokens)
        var parsed_file = parser.parse_file()
        if parser.has_error {
            has_error = true
            error_message = "{path}:{parser.error_line}:{parser.error_column}: {parser.error_message}"
            return
        }
        parsed_file.path = path
        var file_stem = file_stem(path)
        var pascal_case = pascal_case(file_stem)
        check_order(path, parsed_file, pascal_case)
        assert not has_error
        file_stem = file_stem(path)
        add_parsed_file(parsed_file, segments, file_stem)
    } else {
        has_error = true
        error_message = "could not read '{path}'"
    }
}

func add_parsed_file(parsed_file: Syntax.SourceFile, segments: List<String>, stem: String) {
    var qualified = compute_qualified(segments, stem)
    var mangled_name = mangle_dotted(qualified)
    var simple_name = compute_simple_name(segments, stem)
    var namespace_dotted = compute_namespace(segments, stem)
    var qualified_dotted = compute_qualified(segments, stem)
    var existing = class_files.find_by_qualified_dotted(qualified_dotted)
    if existing {
        if qualified_dotted == entry_qualified {
            has_error = true
            error_message = "{parsed_file.path}: error: '{qualified_dotted}' is the program's entry class ({entry_file_path}), so no other file may be a class of that name: rename this file, or the program's folder and its entry file"
            return
        }
        var class_file_file = existing.get_file()
        reopen_class(class_file_file, parsed_file)
        return
    }
    if not walking_library and qualified_dotted.starts_with("Spite.") {
        has_error = true
        error_message = "{parsed_file.path}: error: 'Spite' holds the standard library's own classes, so a file in a 'spite' folder may only reopen one of them: '{qualified_dotted}' is not one, and a new class of your own belongs in a namespace of your own"
        return
    }
    class_files.append(DiscoveredClass(mangled_name, simple_name, namespace_dotted, qualified_dotted, parsed_file))
}

func reopen_with_supplied_members() {
    var prelude = Generation.Prelude()
    var stems = prelude.reopened_classes()
    var index = 0
    while index < stems.count() {
        var class_path = stems[index]
        var source = prelude.reopening(class_path)
        var lexer = Syntax.Lexer(source)
        var parser = Syntax.Parser(lexer.tokens)
        var parsed_file = parser.parse_file()
        crash not parser.has_error
        parsed_file.path = prelude.path()
        var segments = class_path.split("/")
        var stem = segments.remove_last()
        add_parsed_file(parsed_file, segments, stem)
        index = index + 1
    }
}

func declared_name(statement: Syntax.Statements.Statement): String {
    var function = shape.as_function_declaration(statement)
    if function {
        return "func {function.name}"
    }
    var variable = shape.as_variable_declaration(statement)
    if variable {
        return "var {variable.name}"
    }
    var enumeration = shape.as_enum_declaration(statement)
    if enumeration {
        return "enum {enumeration.name}"
    }
    var generic_line = shape.as_generic_declaration(statement)
    if generic_line {
        return "generic {generic_line.name}"
    }
    if shape.as_singleton_declaration(statement) {
        return "singleton"
    }
    return ""
}

func stamp_source_path(statement: Syntax.Statements.Statement, path: String) {
    var function = shape.as_function_declaration(statement)
    if function {
        function.source_path = path
    }
    var variable = shape.as_variable_declaration(statement)
    assert variable
    variable.source_path = path
}

func reopen_class(original: Syntax.SourceFile, reopening: Syntax.SourceFile) {
    var index = 0
    while index < reopening.statements.count() {
        var statement = reopening.statements[index]
        stamp_source_path(statement, reopening.path)
        var name = declared_name(statement)
        var replaced = false
        if not name.is_empty() {
            var original_index = 0
            while original_index < original.statements.count() {
                if declared_name(original.statements[original_index]) == name {
                    original.statements[original_index] = statement
                    mark_reopened(statement)
                    replaced = true
                }
                original_index = original_index + 1
            }
        }
        if not replaced {
            original.statements.append(statement)
        }
        index = index + 1
    }
}

func mark_reopened(statement: Syntax.Statements.Statement) {
    var function = shape.as_function_declaration(statement)
    if function {
        function.overrides_declaration = true
        return
    }
    var variable = shape.as_variable_declaration(statement)
    assert variable
    variable.overrides_declaration = true
}

func read_settings() {
    var build = class_file_named("Build")
    crash build
    var build_names = hardcode_build(build)
    var environment = class_file_named("Environment")
    crash environment
    var environment_names = read_environment(environment)
    check_supplied_settings(build_names, environment_names)
}

func hardcode_build(build: Syntax.SourceFile): List<String> {
    var declared = List<String>()
    var index = 0
    while index < build.statements.count() and not has_error {
        var variable = shape.as_variable_declaration(build.statements[index])
        if variable {
            declared.append(variable.name)
            var reader = setting_reader(variable, "Build")
            variable.hardcoded_value = variable.value
            if supplied_settings.has(variable.name) and not has_error {
                hardcode_setting(variable, reader)
            }
            if not has_error {
                crash variable.hardcoded_value
                build_values[variable.name] = literal_text(variable.hardcoded_value)
            }
        }
        index = index + 1
    }
    return declared
}

func read_environment(environment: Syntax.SourceFile): List<String> {
    var readings = List<Syntax.Statements.Statement>()
    var declared = List<String>()
    var index = 0
    while index < environment.statements.count() and not has_error {
        var variable = shape.as_variable_declaration(environment.statements[index])
        if variable {
            declared.append(variable.name)
            var reader = setting_reader(variable, "Environment")
            var reading = setting_reading(variable, reader)
            readings.append(reading)
        }
        index = index + 1
    }
    if has_error or readings.is_empty() {
        return declared
    }
    var constructor = environment_constructor(environment)
    var body_index = 0
    while body_index < constructor.body.count() {
        readings.append(constructor.body[body_index])
        body_index = body_index + 1
    }
    constructor.body = readings
    return declared
}

func class_file_named(qualified_name: String): Syntax.SourceFile? {
    var found = class_files.find_by_qualified_dotted(qualified_name)
    assert found
    return found.get_file()
}

func environment_constructor(environment: Syntax.SourceFile): Syntax.Statements.FunctionDeclaration {
    var index = 0
    while index < environment.statements.count() {
        var function = shape.as_function_declaration(environment.statements[index])
        if function {
            if function.name == "Environment" {
                return function
            }
        }
        index = index + 1
    }
    var no_parameters = List<Syntax.Statements.Parameter>()
    var no_statements = List<Syntax.Statements.Statement>()
    var made = Syntax.Statements.FunctionDeclaration("Environment", no_parameters, null, no_statements)
    environment.statements.append(made)
    return made
}

func setting_reader(variable: Syntax.Statements.VariableDeclaration, class_name: String): String {
    crash variable.value
    var reader = literal_reader(variable.value)
    if variable.type_reference or reader.is_empty() {
        has_error = true
        error_message = "{variable.source_path}:{variable.line}: error: '{class_name}.{variable.name}' is {setting_source(variable.name, class_name)}, so it is declared with only a literal default, and the literal is its type: 'var {variable.name} = false' (Bool), 'var {variable.name} = 0' (Int) or 'var {variable.name} = \"\"' (String)"
    }
    return reader
}

func setting_source(name: String, class_name: String): String {
    if class_name == "Build" {
        return "decided when compiling, by the compiler's --{name}=value"
    }
    return "a setting, read from the program's command line (--{name}=value) or its environment ({name.upper_case()})"
}

func hardcode_setting(variable: Syntax.Statements.VariableDeclaration, reader: String) {
    crash supplied_settings[variable.name]
    var literal = setting_literal(reader, supplied_settings[variable.name])
    var given = "--{variable.name}={supplied_settings[variable.name]}"
    if bare_settings.contains(variable.name) {
        given = "--{variable.name}"
        if reader != "boolean_setting" {
            literal = null
        }
    }
    if literal {
        variable.hardcoded_value = literal
    } else {
        has_error = true
        error_message = "{variable.source_path}:{variable.line}: error: '{given}' was given to the compiler, but 'Build.{variable.name}' is {setting_expectation(reader, variable.name)}"
    }
}

func setting_expectation(reader: String, name: String): String {
    if reader == "boolean_setting" {
        return "a Bool: --{name}, --{name}=true or --{name}=false"
    }
    if reader == "text_setting" {
        return "a String: --{name}=text"
    }
    return "an Int: a whole number, like --{name}=3"
}

func setting_literal(reader: String, text: String): Syntax.Expressions.Expression? {
    if reader == "text_setting" {
        return Syntax.Expressions.StringLiteralExpression(text)
    }
    if reader == "boolean_setting" {
        return boolean_literal(text)
    }
    return integer_literal(text)
}

func boolean_literal(text: String): Syntax.Expressions.Expression? {
    if text == "true" {
        return Syntax.Expressions.TrueLiteral()
    }
    if text == "false" {
        return Syntax.Expressions.FalseLiteral()
    }
    return null
}

func integer_literal(text: String): Syntax.Expressions.Expression? {
    var environment = Environment()
    assert environment.is_whole_number(text)
    if text.starts_with("-") {
        var text_length = text.length()
        var magnitude_text = text.slice(1, text_length)
        var magnitude = magnitude_text.to_long()
        var operand = Syntax.Expressions.IntegerLiteral(magnitude)
        return Syntax.Expressions.UnaryExpression('negate', operand)
    }
    var value = text.to_long()
    return Syntax.Expressions.IntegerLiteral(value)
}

func literal_text(literal: Syntax.Expressions.Expression): String {
    if shape.is_true_literal(literal) {
        return "true"
    }
    if shape.is_false_literal(literal) {
        return "false"
    }
    var text = shape.as_string_literal(literal)
    if text {
        return text.value
    }
    var whole_number = shape.as_integer_literal(literal)
    if whole_number {
        return "{whole_number.value}"
    }
    var negated = shape.as_unary(literal)
    crash negated
    crash negated.operand
    var magnitude = shape.as_integer_literal(negated.operand)
    crash magnitude
    return "-{magnitude.value}"
}

func check_supplied_settings(build_names: List<String>, environment_names: List<String>) {
    var supplied_names = supplied_settings.keys()
    var index = 0
    while index < supplied_names.count() and not has_error {
        var name = supplied_names[index]
        if environment_names.contains(name) and not build_names.contains(name) {
            has_error = true
            error_message = "error: '--{name}' was given to the compiler, but 'Environment.{name}' is read when the program runs: give it to the program after '--' (spite program -- --{name}=value), or, to decide it when compiling, declare it in the program's build.spite instead"
        } else if not build_names.contains(name) {
            has_error = true
            error_message = "error: '--{name}' is not a compiler option, and this program's Build declares no setting '{name}' (it declares {build_names.join(", ")}). To decide it when compiling, reopen Build in the program's build.spite with 'var {name} = ...'; to read it when the program runs, declare it in environment.spite and give it after '--': spite program -- --{name}=value"
        }
        index = index + 1
    }
}

func setting_reading(variable: Syntax.Statements.VariableDeclaration, reader: String): Syntax.Statements.Statement {
    var arguments = List<Syntax.Expressions.Expression>()
    arguments.append(Syntax.Expressions.StringLiteralExpression(variable.name))
    arguments.append(Syntax.Expressions.IdentifierExpression(variable.name))
    var call = Syntax.Expressions.CallExpression(Syntax.Expressions.IdentifierExpression(reader), arguments)
    var assignment = Syntax.Statements.AssignmentStatement(Syntax.Expressions.IdentifierExpression(variable.name), call)
    assignment.line = variable.line
    return assignment
}

func literal_reader(declared: Syntax.Expressions.Expression): String {
    if shape.is_true_literal(declared) or shape.is_false_literal(declared) {
        return "boolean_setting"
    }
    if shape.as_string_literal(declared) {
        return "text_setting"
    }
    if shape.as_integer_literal(declared) {
        return "integer_setting"
    }
    var negated = shape.as_unary(declared)
    if negated {
        crash negated.operand
        if negated.operator == 'negate' and shape.as_integer_literal(negated.operand) {
            return "integer_setting"
        }
    }
    return ""
}

func scan_top_level_loads(file: Syntax.SourceFile, found: List<String>) {
    assert not declares_load(file)
    var index = 0
    while index < file.statements.count() {
        var function_declaration = shape.as_function_declaration(file.statements[index])
        if function_declaration {
            scan_function_body_loads(function_declaration.body, found)
        }
        index = index + 1
    }
}

func declares_load(file: Syntax.SourceFile): Bool {
    var index = 0
    while index < file.statements.count() {
        var function_declaration = shape.as_function_declaration(file.statements[index])
        if function_declaration {
            if function_declaration.name == "load" {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func scan_function_body_loads(statements: List<Syntax.Statements.Statement>, found: List<String>) {
    var index = 0
    while index < statements.count() {
        var expression_statement = shape.as_expression_statement(statements[index])
        if expression_statement {
            assert expression_statement.value
            add_load_name_if_present(expression_statement.value, found)
        }
        index = index + 1
    }
}

func add_load_name_if_present(expression: Syntax.Expressions.Expression, found: List<String>) {
    var call = shape.as_call(expression)
    assert call
    assert call.callee
    var identifier = shape.as_identifier(call.callee)
    assert identifier
    assert not (identifier.name != "load")
    assert not (call.arguments.count() != 1)
    var literal = shape.as_string_literal(call.arguments[0])
    assert literal
    found.append(literal.value)
}

func pascal_case(snake: String): String {
    var result = ""
    var capitalize_next = true
    var index = 0
    while index < snake.length() {
        var character = snake.character_at(index)
        if character == "_" {
            capitalize_next = true
        } else if capitalize_next {
            result = result + character.upper_case()
            capitalize_next = false
        } else {
            result = result + character
        }
        index = index + 1
    }
    return result
}

func mangle_dotted(dotted: String): String {
    return dotted.replace(".", "_")
}

func pascal_join(segments: List<String>): String {
    var result = ""
    var index = 0
    while index < segments.count() {
        if index > 0 {
            result = "{result}."
        }
        result = result + pascal_case(segments[index])
        index = index + 1
    }
    return result
}

func compute_namespace(segments: List<String>, stem: String): String {
    assert not segments.is_empty()
    var last_segment = segments[segments.count() - 1]
    if last_segment == stem {
        var all_but_last = all_but_last(segments)
        return pascal_join(all_but_last)
    }
    return pascal_join(segments)
}

func compute_simple_name(segments: List<String>, stem: String): String {
    if segments.is_empty() {
        return pascal_case(stem)
    }
    if segments.last() == stem {
        return pascal_case(stem)
    }
    return pascal_case(stem)
}

func compute_qualified(segments: List<String>, stem: String): String {
    if segments.is_empty() {
        return pascal_case(stem)
    }
    var last_segment = segments[segments.count() - 1]
    if last_segment == stem {
        return pascal_join(segments)
    }
    return "{pascal_join(segments)}.{pascal_case(stem)}"
}

func all_but_last(segments: List<String>): List<String> {
    var result = segments.copy()
    result.remove_last()
    return result
}

func directory_of(path: String): String {
    var segments = path.split("/")
    if segments.count() <= 1 {
        return "."
    }
    var all_but_last = all_but_last(segments)
    return join_with_slash(all_but_last)
}

func join_with_slash(segments: List<String>): String {
    var result = ""
    var index = 0
    while index < segments.count() {
        if index > 0 {
            result = "{result}/"
        }
        result = result + segments[index]
        index = index + 1
    }
    return result
}

func basename(path: String): String {
    var segments = path.split("/")
    return segments.last()
}

func file_stem(path: String): String {
    var base = basename(path)
    if base.ends_with(".spite") {
        var base_length = base.length()
        return base.slice(0, base_length - 6)
    }
    return base
}
