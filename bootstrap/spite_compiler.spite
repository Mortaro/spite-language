var console = Console()
var program = Program()
var last_crash_map = ""
var supplied_settings = Dictionary<String>()
var bare_settings = List<String>()
var build_values = Dictionary<String>()
var building_output = ""
var last_hot_manifest = ""
var last_hot_state = ""

func SpiteCompiler() {
    load("source")
    var arguments = Arguments()
    if arguments.count() > 0 and arguments.get(0) == "connect" {
        run_connect(arguments)
        return
    }
    read_supplied_settings(arguments)
    var file_argument = file_to_compile(arguments)
    if file_argument.is_empty() {
        console.error("usage: spite program_folder [--optimized] [--debug_memory] [-- program arguments ...]")
        console.error("       spite program_folder --mode=c                  print the C instead of running")
        console.error("       spite program_folder --mode=build --output=path  build without running")
        program.exit(1)
        return
    }
    var content = File(file_argument).read()
    if content {
        run_mode(file_argument, content)
    } else {
        console.error("error: could not read '{file_argument}'")
        program.exit(1)
    }
}

func run_mode(file_argument: String, content: String) {
    var requested_mode = supplied_or("mode", "run")
    if requested_mode == "canonical" {
        run_canonical_mode(content)
        return
    }
    if requested_mode == "format" or requested_mode == "check_format" {
        run_format_mode(file_argument, content, requested_mode == "check_format")
        return
    }
    if requested_mode == "tokens" {
        run_tokens_mode(content)
        return
    }
    if requested_mode == "tree" {
        run_tree_mode(file_argument, content)
        return
    }
    var discovery = discovered_program(file_argument, content)
    if discovery {
        run_discovered(file_argument, discovery)
    } else {
        program.exit(1)
    }
}

func run_discovered(file_argument: String, discovery: Discovery.DiscoveryResult) {
    if remote_loop_port() < 0 {
        console.error("error: --repl_port takes a port number from 1 to 65535: spite program --repl_port=4000")
        program.exit(1)
        return
    }
    var final_classes_directory = option("final_classes")
    if not final_classes_directory.is_empty() {
        run_final_classes_mode(discovery, final_classes_directory)
        return
    }
    var mode = option("mode")
    if mode == "c" {
        run_c_mode(discovery)
        return
    }
    if mode == "build" {
        run_build_mode(file_argument, discovery)
        return
    }
    if mode == "run" {
        var program_arguments = program_arguments()
        run_run_mode(file_argument, discovery, program_arguments)
        return
    }
    if mode == "reload" {
        run_reload_mode(discovery)
        return
    }
    console.error(
        "unknown --mode '{mode}' (expected 'tokens', 'tree', 'c', 'build', 'run', 'reload', 'format' or 'check_format')",
    )
    program.exit(1)
}

func run_canonical_mode(content: String) {
    var lexer = Syntax.Lexer(content)
    var parser = Syntax.Parser(lexer.tokens)
    var file = parser.parse_file()
    var printer = Syntax.SourcePrinter()
    printer.explicit_grouping = true
    var source_file = printer.source_file(file)
    console.print(source_file)
}

func run_format_mode(file_argument: String, content: String, only_check: Bool) {
    var formatter = Syntax.Formatter()
    var formatted = formatter.format(content)
    if not formatted {
        console.error("{file_argument}: not formatted: {formatter.refusal}")
        program.exit(1)
        return
    }
    crash formatted
    assert formatted != content
    if only_check {
        console.print(file_argument)
        program.exit(1)
        return
    }
    if not File(file_argument).write(formatted) {
        console.error("error: could not write '{file_argument}'")
        program.exit(1)
        return
    }
    console.error("formatted {file_argument}")
}

func option(name: String): String {
    crash build_values[name]
    return build_values[name]
}

func is_on(name: String): Bool {
    return option(name) == "true"
}

func supplied_or(name: String, fallback: String): String {
    if supplied_settings[name] {
        return supplied_settings[name]
    }
    return fallback
}

func discovered_program(file_argument: String, content: String): Discovery.DiscoveryResult? {
    var discoverer = Discovery.ProgramDiscovery()
    discoverer.formats = supplied_or("format", "true") == "true"
    discoverer.supplied_settings = supplied_settings
    discoverer.bare_settings = bare_settings
    var discovery = discoverer.discover(file_argument, content)
    if discovery.has_error {
        report_error(discovery.error_message)
        return null
    }
    build_values = discovery.build_values
    return discovery
}

func generate_c_or_report(discovery: Discovery.DiscoveryResult): String? {
    var prelude = Generation.Prelude()
    var generator = Generation.Generator()
    configure(generator)
    var header = prelude.header()
    var structs = prelude.structs()
    var prototypes = prelude.prototypes()
    var bodies = prelude.bodies()
    var code = generator.generate(discovery, header, structs, prototypes, bodies)
    if generator.has_error {
        report_error(generator.error_message)
        return null
    }
    last_crash_map = generator.crash_map()
    if generator.hot_reload {
        last_hot_manifest = generator.hot_manifest()
        var reload = Generation.HotReloadLibrary()
        last_hot_state = hot_state(generator, reload, 0)
    }
    return code
}

func report_error(message: String) {
    if supplied_or("mode", "run") == "reload" {
        console.print(message)
        return
    }
    console.error(message)
}

func hot_state(generator: Generation.Generator, reload: Generation.HotReloadLibrary, next_generation: Int): String {
    var paths = generator.program_source_paths()
    var hashes = List<String>()
    var index = 0
    while index < paths.count() {
        var content = File(paths[index]).read()
        var hash = ""
        if content {
            hash = reload.hash_of(content)
        }
        hashes.append(hash)
        index = index + 1
    }
    return reload.state_text(next_generation, paths, hashes)
}

func configure(generator: Generation.Generator) {
    var port = remote_loop_port()
    generator.read_evaluate_print_loop = is_on("repl") or port > 0
    generator.console_loop = is_on("repl")
    generator.remote_loop_port = port
    generator.development = is_on("development") or is_on("hot_reload")
    generator.hot_reload = is_on("hot_reload")
    if generator.hot_reload {
        var program = Program()
        generator.hot_reload_compiler = program.executable_path()
        generator.hot_reload_arguments = reload_arguments()
        generator.hot_reload_program_file = building_output
    }
}

func reload_arguments(): String {
    var arguments = Arguments()
    var kept = List<String>()
    var index = 0
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        if not argument.starts_with("--mode=") and not argument.starts_with("--output=") {
            kept.append(argument)
        }
        index = index + 1
    }
    return kept.join("\n")
}

func remote_loop_port(): Int {
    var port_text = option("repl_port")
    assert port_text != "0"
    return port_number(port_text)
}

func file_to_compile(arguments: Arguments): String {
    var index = 0
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        if not argument.starts_with("-") {
            return entry_file_of(argument)
        }
        index = index + 1
    }
    return ""
}

func entry_file_of(path: String): String {
    if not Directory(path).exists() {
        return path
    }
    var folder = path
    while folder.ends_with("/") or folder.ends_with("\\") {
        var folder_length = folder.length()
        folder = folder.slice(0, folder_length - 1)
    }
    var name = folder.replace("\\", "/").split("/").last()
    return "{folder}/{name}.spite"
}

func compiler_arguments_end(arguments: Arguments): Int {
    var index = 0
    while index < arguments.count() {
        if arguments.get(index) == "--" {
            return index
        }
        index = index + 1
    }
    return arguments.count()
}

func program_arguments(): List<String> {
    var arguments = Arguments()
    var passed = List<String>()
    var index = compiler_arguments_end(arguments) + 1
    while index < arguments.count() {
        var argument = arguments.get(index)
        passed.append(argument)
        index = index + 1
    }
    return passed
}

func read_supplied_settings(arguments: Arguments) {
    var index = 0
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        var equals_position = argument.index_of("=")
        var argument_length = argument.length()
        if argument.starts_with("--") and equals_position > 2 {
            var name = argument.slice(2, equals_position)
            supplied_settings[name] = argument.slice(equals_position + 1, argument_length)
        } else if argument.starts_with("--") and argument_length > 2 {
            var name = argument.slice(2, argument_length)
            supplied_settings[name] = "true"
            bare_settings.append(name)
        }
        index = index + 1
    }
}

func run_final_classes_mode(discovery: Discovery.DiscoveryResult, output_directory: String) {
    var generator = final_classes_generator(discovery)
    assert generator
    var kept = generator.emitted_qualified_names()
    var index = 0
    while index < discovery.class_files.count() {
        var class_file = discovery.class_files[index]
        if kept.contains(class_file.qualified_dotted) {
            var path = final_class_path(output_directory, class_file.qualified_dotted)
            var final_class_directory = final_class_directory(path)
            create_final_class_directory(final_class_directory)
            var class_file_file = class_file.get_file()
            var ordered = in_file_order(class_file_file, class_file.simple_name)
            var source = "{Syntax.SourcePrinter().source_file(ordered)}{generator.generated_functions_source(class_file.qualified_dotted)}"
            var output = File(path)
            var formatted_or_as_printed = formatted_or_as_printed(source)
            if not output.write(formatted_or_as_printed) {
                console.error("error: could not write '{path}'")
                program.exit(1)
                return
            }
        }
        index = index + 1
    }
    var instantiated_class_names = generator.instantiated_class_names()
    var instantiated_class_sources = generator.instantiated_class_sources()
    write_class_views(output_directory, "instantiated", instantiated_class_names, instantiated_class_sources)
}

func final_classes_generator(discovery: Discovery.DiscoveryResult): Generation.Generator? {
    var prelude = Generation.Prelude()
    var generator = Generation.Generator()
    configure(generator)
    var header = prelude.header()
    var structs = prelude.structs()
    var prototypes = prelude.prototypes()
    var bodies = prelude.bodies()
    generator.generate(discovery, header, structs, prototypes, bodies)
    if generator.has_error {
        console.error(generator.error_message)
        program.exit(1)
        return null
    }
    return generator
}

func in_file_order(file: Syntax.SourceFile, class_name: String): Syntax.SourceFile {
    var ranking = Discovery.ProgramDiscovery()
    var ordered = List<Syntax.Statements.Statement>()
    var rank = -1
    while rank < 8 {
        var index = 0
        while index < file.statements.count() {
            if ranking.order_rank(file.statements[index], class_name) == rank {
                ordered.append(file.statements[index])
            }
            index = index + 1
        }
        rank = rank + 1
    }
    return Syntax.SourceFile(ordered)
}

func formatted_or_as_printed(source: String): String {
    var formatted = Syntax.Formatter().format("{source}\n")
    if formatted {
        return formatted
    }
    return "{source}\n"
}

func write_class_views(output_directory: String, folder: String, names: List<String>, sources: List<String>) {
    assert not names.is_empty()
    var directory = "{output_directory}/{folder}"
    create_final_class_directory(directory)
    var index = 0
    while index < names.count() {
        var path = "{directory}/{final_class_file_name(names[index])}.spite"
        var output = File(path)
        crash sources[index]
        var formatted_or_as_printed = formatted_or_as_printed(sources[index])
        if not output.write(formatted_or_as_printed) {
            console.error("error: could not write '{path}'")
            program.exit(1)
            return
        }
        index = index + 1
    }
}

func final_class_path(output_directory: String, qualified_name: String): String {
    var segments = qualified_name.split(".")
    var path = output_directory
    var index = 0
    while index < segments.count() {
        path = "{path}/{final_class_file_name(segments[index])}"
        index = index + 1
    }
    return "{path}.spite"
}

func final_class_file_name(class_name: String): String {
    var result = ""
    var index = 0
    while index < class_name.length() {
        var character = class_name.character_at(index)
        var code = class_name.code_at(index)
        if code >= 65 and code <= 90 {
            if index > 0 {
                result = "{result}_"
            }
            result = "{result}{character.lower_case()}"
        } else {
            result = "{result}{character}"
        }
        index = index + 1
    }
    return result
}

func final_class_directory(path: String): String {
    var segments = path.split("/")
    segments.remove_last()
    return segments.join("/")
}

func create_final_class_directory(path: String) {
    var segments = path.split("/")
    var current = ""
    var index = 0
    while index < segments.count() {
        if index > 0 {
            current = "{current}/"
        }
        current = "{current}{segments[index]}"
        Directory(current).create()
        index = index + 1
    }
}

func run_c_mode(discovery: Discovery.DiscoveryResult) {
    var code = generate_c_or_report(discovery)
    if code {
        console.write(code)
        return
    }
    program.exit(1)
}

func computed_class_name(file_argument: String): String {
    var segments = file_argument.split("/")
    var basename = segments.last()
    var stem = basename
    if basename.ends_with(".spite") {
        var basename_length = basename.length()
        stem = basename.slice(0, basename_length - 6)
    }
    return pascal_case_class_name(stem)
}

func pascal_case_class_name(snake: String): String {
    var result = ""
    var capitalize_next = true
    var index = 0
    while index < snake.length() {
        var character = snake.character_at(index)
        if character == "_" {
            capitalize_next = true
        } else if capitalize_next {
            result = result + character.upper_case()
            capitalize_next = false
        } else {
            result = result + character
        }
        index = index + 1
    }
    return result
}

func build_to_path(file_argument: String, discovery: Discovery.DiscoveryResult, output_path: String): Bool {
    building_output = output_path
    var code = generate_c_or_report(discovery)
    assert code
    var directory = Directory(".spite-cache")
    directory.create()
    var class_name = computed_class_name(file_argument)
    var c_path = ".spite-cache/{class_name}_gen1.c"
    var c_file = File(c_path)
    var wrote = c_file.write(code)
    crash wrote
    var c_compiler = find_c_compiler()
    if c_compiler.is_empty() {
        console.error(
            "error: no C compiler found. Set the CC environment variable to the command that compiles C (for example CC=clang), or install cc, clang or gcc",
        )
        return false
    }
    var process_arguments = List<String>()
    if is_on("optimized") {
        process_arguments.append("-O2")
    } else {
        process_arguments.append("-O0")
    }
    process_arguments.append("-Wno-parentheses-equality")
    process_arguments.append("-I.")
    if is_on("debug_memory") {
        process_arguments.append("-DSPITE_DEBUG_MEMORY")
    }
    if is_on("hot_reload") {
        append_shared_runtime(process_arguments, c_compiler)
    }
    process_arguments.append(c_path)
    process_arguments.append("-o")
    process_arguments.append(output_path)
    var process = Process(c_compiler, process_arguments)
    var exit_code = process.run()
    if exit_code != 0 {
        var output = process.output()
        console.error(output)
        return false
    }
    var map_path = output_path
    if map_path.ends_with(".exe") {
        var map_path_length = map_path.length()
        map_path = map_path.slice(0, map_path_length - 4)
    }
    File("{map_path}.crashes").write(last_crash_map)
    if is_on("hot_reload") {
        File("{map_path}.reload_host").write(last_hot_manifest)
        File("{map_path}.reload_files").write(last_hot_state)
    }
    return true
}

func append_shared_runtime(process_arguments: List<String>, c_compiler: String) {
    assert option("target_operating_system") == "windows"
    var probe = Process("{c_compiler} -dumpmachine", List<String>())
    probe.run()
    var machine = probe.output()
    if machine.contains("msvc") {
        process_arguments.append("-fms-runtime-lib=dll")
        process_arguments.append("-Wl,-nodefaultlib:libcmt")
    }
}

func find_c_compiler(): String {
    var chosen = program.environment("CC")
    if chosen {
        if not chosen.trim().is_empty() {
            return chosen.trim()
        }
    }
    var candidates = ["cc", "clang", "gcc"]
    var index = 0
    while index < candidates.count() {
        var probe = Process("{candidates[index]} --version 2>&1", List<String>())
        if probe.run() == 0 {
            return candidates[index]
        }
        index = index + 1
    }
    return ""
}

func run_build_mode(file_argument: String, discovery: Discovery.DiscoveryResult) {
    var output_path = option("output")
    if output_path.is_empty() {
        console.error("error: --mode=build writes the program to --output=path, and no path was given")
        program.exit(1)
        return
    }
    var built = build_to_path(file_argument, discovery, output_path)
    if not built {
        program.exit(1)
    }
}

func run_reload_mode(discovery: Discovery.DiscoveryResult) {
    var program = Program()
    var program_file = option("output")
    var base = without_executable_extension(program_file)
    var host_text = File("{base}.reload_host").read()
    var state_text = File("{base}.reload_files").read()
    if not host_text or not state_text or not is_on("hot_reload") {
        console.print(
            "error: --mode=reload rebuilds what changed in a program built with --hot_reload, and '{program_file}' was not: build it with --hot_reload --output={program_file}",
        )
        program.exit(1)
        return
    }
    crash host_text
    crash state_text
    var reload = Generation.HotReloadLibrary()
    reload.read_host(host_text)
    reload.read_state(state_text)
    var generator = Generation.Generator()
    configure(generator)
    generator.seed_class_names(reload.host_classes)
    var prelude = Generation.Prelude()
    var header = prelude.header()
    var structs = prelude.structs()
    var prototypes = prelude.prototypes()
    var bodies = prelude.bodies()
    generator.generate(discovery, header, structs, prototypes, bodies)
    if generator.has_error {
        console.print(generator.error_message)
        program.exit(1)
        return
    }
    var next_generation = reload.generation + 1
    var state = hot_state(generator, reload, next_generation)
    var changed_paths = changed_paths(generator, reload)
    if changed_paths.is_empty() {
        console.print("unchanged")
        return
    }
    var layout_problem = reload.layout_problem(generator.builder.typedefs)
    if not layout_problem.is_empty() {
        console.print("error: {layout_problem}")
        program.exit(1)
        return
    }
    var rebuilt = List<String>()
    var library_code = generator.reload_library(reload, changed_paths, rebuilt)
    var library_base = "{base}_reload_{next_generation}"
    var library_path = "{library_base}.{library_extension()}"
    if not build_library(library_code, "{library_base}.c", library_path) {
        program.exit(1)
        return
    }
    File("{library_base}.files").write(state)
    console.print("rebuilt {rebuilt.join(", ")}")
    if not reload.removed.is_empty() {
        console.print("removed {reload.removed.join(", ")}")
    }
    console.print("library {library_path}")
    console.print("state {library_base}.files")
}

func changed_paths(generator: Generation.Generator, reload: Generation.HotReloadLibrary): List<String> {
    var paths = generator.program_source_paths()
    var changed = List<String>()
    var index = 0
    while index < paths.count() {
        var content = File(paths[index]).read()
        if content {
            var hash = reload.hash_of(content)
            if reload.is_changed(paths[index], hash) {
                changed.append(paths[index])
            }
        }
        index = index + 1
    }
    return changed
}

func without_executable_extension(path: String): String {
    if path.ends_with(".exe") {
        var path_length = path.length()
        return path.slice(0, path_length - 4)
    }
    return path
}

func library_extension(): String {
    var target = option("target_operating_system")
    if target == "windows" {
        return "dll"
    }
    if target == "mac" {
        return "dylib"
    }
    return "so"
}

func build_library(code: String, c_path: String, library_path: String): Bool {
    File(c_path).write(code)
    var c_compiler = find_c_compiler()
    var process_arguments = List<String>()
    process_arguments.append("-shared")
    if is_on("optimized") {
        process_arguments.append("-O2")
    } else {
        process_arguments.append("-O0")
    }
    process_arguments.append("-w")
    if option("target_operating_system") == "windows" {
        append_shared_runtime(process_arguments, c_compiler)
    } else {
        process_arguments.append("-fPIC")
    }
    process_arguments.append(c_path)
    process_arguments.append("-o")
    process_arguments.append(library_path)
    var process = Process(c_compiler, process_arguments)
    if process.run() != 0 {
        var output = process.output()
        console.print("error: the C compiler could not build {library_path}:\n{output}")
        return false
    }
    return true
}

func run_run_mode(file_argument: String, discovery: Discovery.DiscoveryResult, passed: List<String>) {
    var output_path = ".spite-cache/{computed_class_name(file_argument)}_gen1.exe"
    var built = build_to_path(file_argument, discovery, output_path)
    if not built {
        program.exit(1)
        return
    }
    var replaced_output_path = output_path.replace("/", "\\")
    var runner = Process(replaced_output_path, passed)
    var port = remote_loop_port()
    if is_on("repl") or port > 0 or is_on("hot_reload") {
        console.flush()
        var run_attached = runner.run_attached()
        program.exit(run_attached)
        return
    }
    var exit_code = runner.run()
    var output = runner.output()
    console.write(output)
    program.exit(exit_code)
}

func run_tokens_mode(content: String) {
    var lexer = Syntax.Lexer(content)
    print_tokens(lexer.tokens)
    if lexer.has_error {
        program.exit(1)
    }
}

func run_tree_mode(file_argument: String, content: String) {
    var tokens = Syntax.Lexer(content).tokens
    var parser = Syntax.Parser(tokens)
    var file = parser.parse_file()
    if parser.has_error {
        console.error("{file_argument}:{parser.error_line}:{parser.error_column}: error: {parser.error_message}")
        program.exit(1)
        return
    }
    var printer = Syntax.Printer()
    printer.print_file(file)
}

func print_tokens(tokens: List<Syntax.Token>) {
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        console.print("{token.line}:{token.column} {token.kind_text()} '{token.lexeme}'")
        index = index + 1
    }
}

func port_number(text: String): Int {
    if text.is_empty() or text.length() > 5 {
        return -1
    }
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        if code < 48 or code > 57 {
            return -1
        }
        index = index + 1
    }
    var number = text.to_int()
    if number < 1 or number > 65535 {
        return -1
    }
    return number
}

func run_connect(arguments: Arguments) {
    var port_text = ""
    if arguments.count() > 1 {
        port_text = arguments.get(1)
    }
    var port = port_number(port_text)
    if port < 0 {
        console.error(
            "usage: spite connect <port>                    talk to a program started with --repl_port=<port>",
        )
        console.error("       spite connect <port> --command=\"...\"    send one command and print its JSON answer")
        program.exit(1)
        return
    }
    var connection = Socket()
    if not connection.connect_locally(port) {
        console.error("error: nothing is listening on 127.0.0.1:{port}: run a program with --repl_port={port} first")
        program.exit(1)
        return
    }
    if arguments.command {
        send_one_command(connection, arguments.command)
        return
    }
    var talking = true
    while talking {
        console.write("spite> ")
        var line = console.read_line()
        if line {
            talking = connection.write_line(line)
            var response = connection.read_line()
            if response {
                var pretty_response = pretty_response(response)
                if not pretty_response.is_empty() {
                    console.print(pretty_response)
                }
            } else {
                talking = false
            }
            if line.trim() == "exit" {
                talking = false
            }
        } else {
            console.print("")
            talking = false
        }
    }
    connection.close()
}

func send_one_command(connection: Socket, command: String) {
    connection.write_line(command)
    var response = connection.read_line()
    connection.close()
    if response {
        console.print(response)
        return
    }
    console.error("error: the program closed the connection without answering")
    program.exit(1)
}

func pretty_response(response: String): String {
    var failed_prefix = "\{\"ok\":false,\"error\":\""
    var succeeded_prefix = "\{\"ok\":true,\"value\":\""
    if response.starts_with(failed_prefix) {
        var failed_prefix_length = failed_prefix.length()
        var message = json_string_at(response, failed_prefix_length)
        return "error: {message}"
    }
    if not response.starts_with(succeeded_prefix) {
        return response
    }
    var succeeded_prefix_length = succeeded_prefix.length()
    var value = json_string_at(response, succeeded_prefix_length)
    var class_name = response.split("\",\"type\":\"").last()
    var class_name_length = class_name.length()
    if class_name_length <= 2 or class_name.starts_with("Nothing\"") {
        return value
    }
    return "{value} ({class_name.slice(0, class_name_length - 2)})"
}

func json_string_at(text: String, start: Int): String {
    var pieces = List<String>()
    var text_length = text.length()
    var index = start
    while index < text_length and text.code_at(index) != 34 {
        var character = text.character_at(index)
        if character == "\\" and index + 1 < text_length {
            index = index + 1
            var escaped = text.character_at(index)
            var unescaped = unescaped(escaped)
            pieces.append(unescaped)
        } else {
            pieces.append(character)
        }
        index = index + 1
    }
    return pieces.join("")
}

func unescaped(escaped: String): String {
    if escaped == "n" {
        return "\n"
    }
    if escaped == "r" {
        return "\r"
    }
    if escaped == "t" {
        return "\t"
    }
    return escaped
}
