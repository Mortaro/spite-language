var console = Console()
var optimized = false
var last_crash_map = ""
var formats = true
var read_evaluate_print_loop = false
var remote_loop_port = 0
var development = false

func SpiteCompiler(arguments: Arguments) {
    load("source")
    if arguments.count() > 0 and arguments.get(0) == "connect" {
        run_connect(arguments)
        return
    }
    var file_argument = file_to_compile(arguments)
    if file_argument.is_empty() {
        console.error("usage: spite program.spite [--optimized] [--debug_memory=true] [-- program arguments ...]")
        console.error("       spite program.spite --mode=c                  print the C instead of running")
        console.error("       spite program.spite --mode=build --output=path  build without running")
        Program().exit(1)
        return
    }
    var mode_argument = "run"
    if arguments.mode {
        mode_argument = arguments.mode
    }
    optimized = has_flag(arguments, "--optimized")
    formats = not has_flag(arguments, "--no-format")
    read_evaluate_print_loop = has_flag(arguments, "--repl")
    remote_loop_port = remote_loop_port_of(arguments)
    if remote_loop_port < 0 {
        console.error("error: --repl-port takes a port number from 1 to 65535: spite program.spite --repl-port=4000")
        Program().exit(1)
        return
    }
    development = has_flag(arguments, "--development")
    var unknown_flag = unknown_compiler_flag(arguments)
    if unknown_flag {
        console.error(
            "error: '--{unknown_flag}' is not a compiler flag. A program's settings are fields of its Environment, passed to the program after '--': spite program.spite -- --{unknown_flag}=value",
        )
        Program().exit(1)
        return
    }
    var content = File(file_argument).read()
    if content {
        run_mode(arguments, file_argument, mode_argument, content)
    } else {
        console.error("error: could not read '{file_argument}'")
        Program().exit(1)
    }
}

func run_mode(arguments: Arguments, file_argument: String, mode_argument: String, content: String) {
    if mode_argument == "canonical" {
        run_canonical_mode(content)
        return
    }
    if mode_argument == "format" or mode_argument == "check_format" {
        run_format_mode(file_argument, content, mode_argument == "check_format")
        return
    }
    if mode_argument == "tokens" {
        run_tokens_mode(content)
        return
    }
    if mode_argument == "tree" {
        run_tree_mode(file_argument, content)
        return
    }
    var final_classes_directory = final_classes_directory(arguments)
    if final_classes_directory {
        run_final_classes_mode(file_argument, content, final_classes_directory)
        return
    }
    if mode_argument == "c" {
        run_c_mode(file_argument, content)
        return
    }
    if mode_argument == "build" {
        crash arguments.output
        var has_debug_memory_flag = has_debug_memory_flag(arguments)
        run_build_mode(file_argument, content, arguments.output, has_debug_memory_flag)
        return
    }
    if mode_argument == "run" {
        var has_debug_memory_flag = has_debug_memory_flag(arguments)
        var program_arguments = program_arguments(arguments)
        run_run_mode(file_argument, content, has_debug_memory_flag, program_arguments)
        return
    }
    console.error(
        "unknown --mode '{mode_argument}' (expected 'tokens', 'tree', 'c', 'build', 'run', 'format' or 'check_format')",
    )
    var program = Program()
    program.exit(1)
}

func run_canonical_mode(content: String) {
    var lexer = Syntax.Lexer(content)
    var parser = Syntax.Parser(lexer.tokens)
    var file = parser.parse_file()
    var printer = Syntax.SourcePrinter()
    printer.explicit_grouping = true
    var source_file = printer.source_file(file)
    console.print(source_file)
}

func run_format_mode(file_argument: String, content: String, only_check: Bool) {
    var formatter = Syntax.Formatter()
    var formatted = formatter.format(content)
    if not formatted {
        console.error("{file_argument}: not formatted: {formatter.refusal}")
        Program().exit(1)
        return
    }
    crash formatted
    assert formatted != content
    if only_check {
        console.print(file_argument)
        Program().exit(1)
        return
    }
    if not File(file_argument).write(formatted) {
        console.error("error: could not write '{file_argument}'")
        Program().exit(1)
        return
    }
    console.error("formatted {file_argument}")
}

func has_debug_memory_flag(arguments: Arguments): Bool {
    if arguments.debug_memory {
        return arguments.debug_memory == "true"
    }
    return false
}

func generate_c_or_report(file_argument: String, content: String): String? {
    var discoverer = Discovery.ProgramDiscovery()
    discoverer.formats = formats
    var discovery = discoverer.discover(file_argument, content)
    if discovery.has_error {
        console.error(discovery.error_message)
        return null
    }
    var prelude = Generation.Prelude()
    var generator = Generation.Generator()
    configure(generator)
    var header = prelude.header()
    var structs = prelude.structs()
    var prototypes = prelude.prototypes()
    var bodies = prelude.bodies()
    var code = generator.generate(discovery, header, structs, prototypes, bodies)
    if generator.has_error {
        console.error(generator.error_message)
        return null
    }
    last_crash_map = generator.crash_map()
    return code
}

func configure(generator: Generation.Generator) {
    generator.read_evaluate_print_loop = read_evaluate_print_loop or remote_loop_port > 0
    generator.console_loop = read_evaluate_print_loop
    generator.remote_loop_port = remote_loop_port
    generator.development = development
}

func file_to_compile(arguments: Arguments): String {
    if arguments.file {
        return entry_file_of(arguments.file)
    }
    var index = 0
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        if not argument.starts_with("--") and (argument.ends_with(".spite") or Directory(argument).exists()) {
            return entry_file_of(argument)
        }
        index = index + 1
    }
    return ""
}

func entry_file_of(path: String): String {
    if not Directory(path).exists() {
        return path
    }
    var folder = path
    while folder.ends_with("/") or folder.ends_with("\\") {
        var folder_length = folder.length()
        folder = folder.slice(0, folder_length - 1)
    }
    var name = folder.replace("\\", "/").split("/").last()
    return "{folder}/{name}.spite"
}

func compiler_arguments_end(arguments: Arguments): Int {
    var index = 0
    while index < arguments.count() {
        if arguments.get(index) == "--" {
            return index
        }
        index = index + 1
    }
    return arguments.count()
}

func program_arguments(arguments: Arguments): List<String> {
    var passed = List<String>()
    var index = compiler_arguments_end(arguments) + 1
    while index < arguments.count() {
        var argument = arguments.get(index)
        passed.append(argument)
        index = index + 1
    }
    return passed
}

func has_flag(arguments: Arguments, flag: String): Bool {
    var index = 0
    while index < compiler_arguments_end(arguments) {
        if arguments.get(index) == flag {
            return true
        }
        index = index + 1
    }
    return false
}

func unknown_compiler_flag(arguments: Arguments): String? {
    var reserved = [
        "file"
        "mode"
        "output"
        "debug_memory"
        "runtime"
        "final-classes"
        "operational_system"
        "repl-port"
    ]
    var index = 0
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        var equals_position = argument.index_of("=")
        if argument.starts_with("--") and equals_position > 2 {
            var name = argument.slice(2, equals_position)
            if not reserved.contains(name) {
                return name
            }
        }
        index = index + 1
    }
    return null
}

func final_classes_directory(arguments: Arguments): String? {
    var index = 0
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        if argument == "--final-classes" {
            return ".spite-cache/final"
        }
        if argument.starts_with("--final-classes=") {
            var argument_length = argument.length()
            var directory = argument.slice(16, argument_length)
            if directory.is_empty() {
                return ".spite-cache/final"
            }
            return directory
        }
        index = index + 1
    }
    return null
}

func run_final_classes_mode(file_argument: String, content: String, output_directory: String) {
    var discovery = Discovery.ProgramDiscovery().discover(file_argument, content)
    if discovery.has_error {
        console.error(discovery.error_message)
        Program().exit(1)
        return
    }
    var generator = final_classes_generator(discovery)
    assert generator
    var kept = generator.emitted_qualified_names()
    var index = 0
    while index < discovery.class_files.count() {
        var class_file = discovery.class_files[index]
        if kept.contains(class_file.qualified_dotted) {
            var path = final_class_path(output_directory, class_file.qualified_dotted)
            var final_class_directory = final_class_directory(path)
            create_final_class_directory(final_class_directory)
            var class_file_file = class_file.get_file()
            var ordered = in_file_order(class_file_file, class_file.simple_name)
            var source = "{Syntax.SourcePrinter().source_file(ordered)}{generator.generated_functions_source(class_file.qualified_dotted)}"
            var output = File(path)
            var formatted_or_as_printed = formatted_or_as_printed(source)
            if not output.write(formatted_or_as_printed) {
                console.error("error: could not write '{path}'")
                Program().exit(1)
                return
            }
        }
        index = index + 1
    }
    var built_in_class_names = generator.built_in_class_names()
    var built_in_class_sources = generator.built_in_class_sources()
    write_class_views(output_directory, "built_in", built_in_class_names, built_in_class_sources)
    var instantiated_class_names = generator.instantiated_class_names()
    var instantiated_class_sources = generator.instantiated_class_sources()
    write_class_views(output_directory, "instantiated", instantiated_class_names, instantiated_class_sources)
}

func final_classes_generator(discovery: Discovery.DiscoveryResult): Generation.Generator? {
    var prelude = Generation.Prelude()
    var generator = Generation.Generator()
    configure(generator)
    var header = prelude.header()
    var structs = prelude.structs()
    var prototypes = prelude.prototypes()
    var bodies = prelude.bodies()
    generator.generate(discovery, header, structs, prototypes, bodies)
    if generator.has_error {
        console.error(generator.error_message)
        Program().exit(1)
        return null
    }
    return generator
}

func in_file_order(file: Syntax.SourceFile, class_name: String): Syntax.SourceFile {
    var ranking = Discovery.ProgramDiscovery()
    var ordered = List<Syntax.Statements.Statement>()
    var rank = -1
    while rank < 7 {
        var index = 0
        while index < file.statements.count() {
            if ranking.order_rank(file.statements[index], class_name) == rank {
                ordered.append(file.statements[index])
            }
            index = index + 1
        }
        rank = rank + 1
    }
    return Syntax.SourceFile(ordered)
}

func formatted_or_as_printed(source: String): String {
    var formatted = Syntax.Formatter().format("{source}\n")
    if formatted {
        return formatted
    }
    return "{source}\n"
}

func write_class_views(output_directory: String, folder: String, names: List<String>, sources: List<String>) {
    assert not names.is_empty()
    var directory = "{output_directory}/{folder}"
    create_final_class_directory(directory)
    var index = 0
    while index < names.count() {
        var path = "{directory}/{final_class_file_name(names[index])}.spite"
        var output = File(path)
        crash sources[index]
        var formatted_or_as_printed = formatted_or_as_printed(sources[index])
        if not output.write(formatted_or_as_printed) {
            console.error("error: could not write '{path}'")
            Program().exit(1)
            return
        }
        index = index + 1
    }
}

func final_class_path(output_directory: String, qualified_name: String): String {
    var segments = qualified_name.split(".")
    var path = output_directory
    var index = 0
    while index < segments.count() {
        path = "{path}/{final_class_file_name(segments[index])}"
        index = index + 1
    }
    return "{path}.spite"
}

func final_class_file_name(class_name: String): String {
    var result = ""
    var index = 0
    while index < class_name.length() {
        var character = class_name.character_at(index)
        var code = class_name.code_at(index)
        if code >= 65 and code <= 90 {
            if index > 0 {
                result = "{result}_"
            }
            result = "{result}{character.lower_case()}"
        } else {
            result = "{result}{character}"
        }
        index = index + 1
    }
    return result
}

func final_class_directory(path: String): String {
    var segments = path.split("/")
    var result = ""
    var index = 0
    while index < segments.count() - 1 {
        if index > 0 {
            result = "{result}/"
        }
        result = "{result}{segments[index]}"
        index = index + 1
    }
    return result
}

func create_final_class_directory(path: String) {
    var segments = path.split("/")
    var current = ""
    var index = 0
    while index < segments.count() {
        if index > 0 {
            current = "{current}/"
        }
        current = "{current}{segments[index]}"
        Directory(current).create()
        index = index + 1
    }
}

func run_c_mode(file_argument: String, content: String) {
    var code = generate_c_or_report(file_argument, content)
    if code {
        console.write(code)
        return
    }
    var program = Program()
    program.exit(1)
}

func computed_class_name(file_argument: String): String {
    var segments = file_argument.split("/")
    var basename = segments.last()
    var stem = basename
    if basename.ends_with(".spite") {
        var basename_length = basename.length()
        stem = basename.slice(0, basename_length - 6)
    }
    return pascal_case_class_name(stem)
}

func pascal_case_class_name(snake: String): String {
    var result = ""
    var capitalize_next = true
    var index = 0
    while index < snake.length() {
        var character = snake.character_at(index)
        if character == "_" {
            capitalize_next = true
        } else if capitalize_next {
            result = result + character.upper_case()
            capitalize_next = false
        } else {
            result = result + character
        }
        index = index + 1
    }
    return result
}

func build_to_path(file_argument: String, content: String, output_path: String, debug_memory: Bool): Bool {
    var code = generate_c_or_report(file_argument, content)
    if not code {
        return false
    }
    crash code
    var directory = Directory(".spite-cache")
    directory.create()
    var class_name = computed_class_name(file_argument)
    var c_path = ".spite-cache/{class_name}_gen1.c"
    var c_file = File(c_path)
    var wrote = c_file.write(code)
    crash wrote
    var c_compiler = find_c_compiler()
    if c_compiler.is_empty() {
        console.error(
            "error: no C compiler found. Set the CC environment variable to the command that compiles C (for example CC=clang), or install cc, clang or gcc",
        )
        return false
    }
    var process_arguments = List<String>()
    if optimized {
        process_arguments.append("-O2")
    } else {
        process_arguments.append("-O0")
    }
    process_arguments.append("-Wno-parentheses-equality")
    process_arguments.append("-I.")
    if debug_memory {
        process_arguments.append("-DSPITE_DEBUG_MEMORY")
    }
    process_arguments.append(c_path)
    process_arguments.append("-o")
    process_arguments.append(output_path)
    var process = Process(c_compiler, process_arguments)
    var exit_code = process.run()
    if exit_code != 0 {
        var output = process.output()
        console.error(output)
        return false
    }
    var map_path = output_path
    if map_path.ends_with(".exe") {
        var map_path_length = map_path.length()
        map_path = map_path.slice(0, map_path_length - 4)
    }
    File("{map_path}.crashes").write(last_crash_map)
    return true
}

func find_c_compiler(): String {
    var chosen = Program().environment("CC")
    if chosen {
        if not chosen.trim().is_empty() {
            return chosen.trim()
        }
    }
    var candidates = ["cc", "clang", "gcc"]
    var index = 0
    while index < candidates.count() {
        var probe = Process("{candidates[index]} --version 2>&1", List<String>())
        if probe.run() == 0 {
            return candidates[index]
        }
        index = index + 1
    }
    return ""
}

func run_build_mode(file_argument: String, content: String, output_path: String, debug_memory: Bool) {
    var built = build_to_path(file_argument, content, output_path, debug_memory)
    if not built {
        var program = Program()
        program.exit(1)
    }
}

func run_run_mode(file_argument: String, content: String, debug_memory: Bool, passed: List<String>) {
    var output_path = ".spite-cache/{computed_class_name(file_argument)}_gen1.exe"
    var built = build_to_path(file_argument, content, output_path, debug_memory)
    if not built {
        var program = Program()
        program.exit(1)
        return
    }
    var replaced_output_path = output_path.replace("/", "\\")
    var runner = Process(replaced_output_path, passed)
    if read_evaluate_print_loop or remote_loop_port > 0 {
        console.flush()
        var run_attached = runner.run_attached()
        Program().exit(run_attached)
        return
    }
    var exit_code = runner.run()
    var output = runner.output()
    console.write(output)
    var program = Program()
    program.exit(exit_code)
}

func run_tokens_mode(content: String) {
    var lexer = Syntax.Lexer(content)
    print_tokens(lexer.tokens)
    if lexer.has_error {
        var program = Program()
        program.exit(1)
    }
}

func run_tree_mode(file_argument: String, content: String) {
    var tokens = Syntax.Lexer(content).tokens
    var parser = Syntax.Parser(tokens)
    var file = parser.parse_file()
    if parser.has_error {
        console.error("{file_argument}:{parser.error_line}:{parser.error_column}: error: {parser.error_message}")
        var program = Program()
        program.exit(1)
        return
    }
    var printer = Syntax.Printer()
    printer.print_file(file)
}

func print_tokens(tokens: List<Syntax.Token>) {
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        console.print("{token.line}:{token.column} {token.kind_text()} '{token.lexeme}'")
        index = index + 1
    }
}

func remote_loop_port_of(arguments: Arguments): Int {
    var end = compiler_arguments_end(arguments)
    var index = 0
    while index < end {
        var argument = arguments.get(index)
        if argument.starts_with("--repl-port=") {
            var argument_length = argument.length()
            var number = argument.slice(12, argument_length)
            return port_number(number)
        }
        if argument == "--repl-port" {
            if index + 1 < end {
                var number = arguments.get(index + 1)
                return port_number(number)
            }
            return -1
        }
        index = index + 1
    }
    return 0
}

func port_number(text: String): Int {
    if text.is_empty() or text.length() > 5 {
        return -1
    }
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        if code < 48 or code > 57 {
            return -1
        }
        index = index + 1
    }
    var number = text.to_int()
    if number < 1 or number > 65535 {
        return -1
    }
    return number
}

func run_connect(arguments: Arguments) {
    var port_text = ""
    if arguments.count() > 1 {
        port_text = arguments.get(1)
    }
    var port = port_number(port_text)
    if port < 0 {
        console.error(
            "usage: spite connect <port>                    talk to a program started with --repl-port=<port>",
        )
        console.error("       spite connect <port> --command=\"...\"    send one command and print its JSON answer")
        Program().exit(1)
        return
    }
    var connection = Socket()
    if not connection.connect_locally(port) {
        console.error("error: nothing is listening on 127.0.0.1:{port}: run a program with --repl-port={port} first")
        Program().exit(1)
        return
    }
    if arguments.command {
        send_one_command(connection, arguments.command)
        return
    }
    var talking = true
    while talking {
        console.write("spite> ")
        var line = console.read_line()
        if line {
            talking = connection.write_line(line)
            var response = connection.read_line()
            if response {
                var pretty_response = pretty_response(response)
                if not pretty_response.is_empty() {
                    console.print(pretty_response)
                }
            } else {
                talking = false
            }
            if line.trim() == "exit" {
                talking = false
            }
        } else {
            console.print("")
            talking = false
        }
    }
    connection.close()
}

func send_one_command(connection: Socket, command: String) {
    connection.write_line(command)
    var response = connection.read_line()
    connection.close()
    if response {
        console.print(response)
        return
    }
    console.error("error: the program closed the connection without answering")
    Program().exit(1)
}

func pretty_response(response: String): String {
    var failed_prefix = "\{\"ok\":false,\"error\":\""
    var succeeded_prefix = "\{\"ok\":true,\"value\":\""
    if response.starts_with(failed_prefix) {
        var failed_prefix_length = failed_prefix.length()
        var message = json_string_at(response, failed_prefix_length)
        return "error: {message}"
    }
    if not response.starts_with(succeeded_prefix) {
        return response
    }
    var succeeded_prefix_length = succeeded_prefix.length()
    var value = json_string_at(response, succeeded_prefix_length)
    var class_name = response.split("\",\"type\":\"").last()
    var class_name_length = class_name.length()
    if class_name_length <= 2 or class_name.starts_with("Nothing\"") {
        return value
    }
    return "{value} ({class_name.slice(0, class_name_length - 2)})"
}

func json_string_at(text: String, start: Int): String {
    var pieces = List<String>()
    var text_length = text.length()
    var index = start
    while index < text_length and text.code_at(index) != 34 {
        var character = text.character_at(index)
        if character == "\\" and index + 1 < text_length {
            index = index + 1
            var escaped = text.character_at(index)
            var unescaped = unescaped(escaped)
            pieces.append(unescaped)
        } else {
            pieces.append(character)
        }
        index = index + 1
    }
    return pieces.join("")
}

func unescaped(escaped: String): String {
    if escaped == "n" {
        return "\n"
    }
    if escaped == "r" {
        return "\r"
    }
    if escaped == "t" {
        return "\t"
    }
    return escaped
}
