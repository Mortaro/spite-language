enum Formatting {
    'unchanged'
    'rewrote'
    'refused'
}

var console = Console()
var program = Program()
var last_crash_map = ""
var supplied_settings = Dictionary<String>()
var bare_settings = List<String>()
var build_values = Dictionary<String>()
var generated_code = ""
var last_hot_manifest = ""
var last_hot_state = ""
var language_folder = "."
var reloading = false
var flag_error = ""
var maximum_passes = 8

func Bootstrap() {
    load "source"
    var arguments = Arguments()
    var command = first_argument(arguments)
    if command == "connect" {
        run_connect(arguments)
        return
    }
    if command == "format" {
        run_format_command(arguments)
        return
    }
    language_folder = folder_holding_launcher()
    reloading = command == "reload"
    read_supplied_settings(arguments)
    if not flag_error.is_empty() {
        report_error(flag_error)
        program.exit(1)
        return
    }
    var named = named_program(arguments)
    if named.is_empty() {
        print_usage()
        program.exit(1)
        return
    }
    var entry_path = entry_file_of(named)
    if entry_path.is_empty() {
        program.exit(1)
        return
    }
    compile_program(entry_path, true)
}

func first_argument(arguments: Arguments): String {
    if arguments.count() <= 0 {
        return ""
    }
    return arguments.get(0)
}

func print_usage() {
    console.error("usage: spite program_folder [--optimized] [--debug-memory] [-- program arguments ...]")
    console.error(
        "       spite program_folder --c-source                also write the C, beside the program or at --c-path=path",
    )
    console.error(
        "       spite program_folder --executable --run=false  build without running, beside the program or at --executable-path=path",
    )
    console.error("       spite format [--check] file_or_folder ...       format files without compiling them")
    console.error(
        "       spite connect port [--command=\"...\"]            talk to a program running with --repl-port=port",
    )
}

func folder_holding_launcher(): String {
    var compiler_path = program.executable_path()
    var folders = compiler_path.replace("\\", "/").split("/")
    folders.remove_last()
    while not folders.is_empty() {
        var folder = folders.join("/")
        if File("{folder}/launcher/launcher.spite").exists() {
            return folder
        }
        folders.remove_last()
    }
    return "."
}

func named_program(arguments: Arguments): String {
    var index = 0
    if reloading {
        index = 1
    }
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        if not argument.starts_with("-") {
            return argument
        }
        index = index + 1
    }
    return ""
}

func entry_file_of(named: String): String {
    if named.ends_with(".spite") {
        var holding_folder = directory_of(named)
        console.error("error: '{named}' is a file, and a program is named by its folder: spite {holding_folder}")
        return ""
    }
    var folder = without_trailing_slashes(named)
    var name = last_segment(folder)
    var entry_path = "{folder}/{name}.spite"
    if File(entry_path).exists() {
        return entry_path
    }
    console.error(
        "error: '{folder}' holds no program: a program is a folder holding an entry file named after it, '{entry_path}'",
    )
    return ""
}

func without_trailing_slashes(path: String): String {
    var trimmed = path
    while trimmed.ends_with("/") or trimmed.ends_with("\\") {
        var trimmed_length = trimmed.length()
        trimmed = trimmed.slice(0, trimmed_length - 1)
    }
    return trimmed
}

func last_segment(path: String): String {
    var segments = path.replace("\\", "/").split("/")
    var last = segments.last()
    crash last
    return last
}

func directory_of(path: String): String {
    var segments = path.replace("\\", "/").split("/")
    segments.remove_last()
    if segments.is_empty() {
        return "."
    }
    return segments.join("/")
}

func compile_program(entry_path: String, may_format: Boolean) {
    var discovery = discovered_program(entry_path)
    if not discovery {
        program.exit(1)
        return
    }
    if may_format {
        var formatting = formatted_program_files(discovery)
        if formatting == 'refused' {
            program.exit(1)
            return
        }
        if formatting == 'rewrote' {
            compile_program(entry_path, false)
            return
        }
    }
    produce(discovery)
}

func discovered_program(entry_path: String): Discovery.DiscoveryResult? {
    var content = File(entry_path).read()
    if not content {
        console.error("error: could not read '{entry_path}'")
        return null
    }
    var discoverer = Discovery.ProgramDiscovery()
    discoverer.language_folder = language_folder
    discoverer.supplied_settings = supplied_settings.copy()
    discoverer.bare_settings = bare_settings
    var discovery = discoverer.discover(entry_path, content)
    if discovery.has_error {
        report_error(discovery.error_message)
        return null
    }
    build_values = discovery.build_values
    return discovery
}

func formatted_program_files(discovery: Discovery.DiscoveryResult): Formatting {
    var outcome = 'unchanged'
    var index = 0
    while index < discovery.program_paths.count() {
        var file_outcome = formatted_program_file(discovery, discovery.program_paths[index])
        if file_outcome == 'refused' or outcome == 'unchanged' {
            outcome = file_outcome
        }
        index = index + 1
    }
    return outcome
}

func formatted_program_file(discovery: Discovery.DiscoveryResult, path: String): Formatting {
    var content = discovery.program_texts[path]
    if not content {
        content = File(path).read()
    }
    if not content {
        console.error("error: could not read '{path}'")
        return 'refused'
    }
    var formatter = Syntax.Formatter()
    var formatted = formatter.format(content)
    if not formatted {
        console.error(
            "{path}: error: the formatter refuses it, and a program compiles only once formatted: {formatter.refusal}",
        )
        return 'refused'
    }
    if formatted == content {
        return 'unchanged'
    }
    if not File(path).write(formatted) {
        console.error("error: could not write the formatted '{path}'")
        return 'refused'
    }
    console.error("formatted {path}")
    return 'rewrote'
}

func produce(discovery: Discovery.DiscoveryResult) {
    if remote_loop_port() < 0 {
        console.error("error: --repl-port takes a port number from 1 to 65535: spite program --repl-port=4000")
        program.exit(1)
        return
    }
    if reloading {
        run_reload(discovery)
        return
    }
    var misplaced = path_without_its_output()
    if not misplaced.is_empty() {
        console.error(misplaced)
        program.exit(1)
        return
    }
    var generator = generated(discovery)
    if generator {
        write_outputs(discovery, generator)
    } else {
        program.exit(1)
    }
}

func path_without_its_output(): String {
    if supplied_settings.has("c_path") and not is_on("c_source") {
        return "error: '--c-path' says where the C goes, and this build writes no C: give --c-source too"
    }
    if supplied_settings.has("executable_path") and not is_on("executable") and not is_on("run") {
        return "error: '--executable-path' says where the executable goes, and this build makes none: give --executable too"
    }
    return ""
}

func write_outputs(discovery: Discovery.DiscoveryResult, generator: Generation.Generator) {
    if is_on("c_source") and not wrote_c_source() {
        program.exit(1)
        return
    }
    var final_classes_folder = option("final_classes")
    if not final_classes_folder.is_empty() and not wrote_final_classes(discovery, generator, final_classes_folder) {
        program.exit(1)
        return
    }
    var runs = is_on("run")
    if (runs or is_on("executable")) and not built_executable() {
        program.exit(1)
        return
    }
    if runs {
        run_executable()
    }
}

func option(name: String): String {
    crash build_values[name]
    return build_values[name]
}

func is_on(name: String): Boolean {
    return option(name) == "true"
}

func generated(discovery: Discovery.DiscoveryResult): Generation.Generator? {
    var no_host_classes = List<String>()
    var no_keys = Dictionary<Analysis.SpiteType>()
    var generator = keyed_generator(discovery, no_host_classes, no_keys)
    if generator.has_error {
        report_error(generator.error_message)
        return null
    }
    last_crash_map = generator.crash_map()
    if generator.hot_reload {
        last_hot_manifest = generator.hot_manifest()
        var reload = Generation.HotReloadLibrary()
        last_hot_state = hot_state(discovery, reload, 0)
    }
    return generator
}

func keyed_generator(
    discovery: Discovery.DiscoveryResult,
    host_classes: List<String>,
    starting_keys: Dictionary<Analysis.SpiteType>,
): Generation.Generator {
    var number_keys = starting_keys
    var notes = Dictionary<String>()
    var generator = generator_pass(discovery, host_classes, number_keys, notes, 1)
    var passes = 1
    while generator.key_sites_changed and passes < maximum_passes {
        number_keys = generator.learned_key_sites
        notes = generator.learned_key_use_notes
        passes = passes + 1
        generator = generator_pass(discovery, host_classes, number_keys, notes, passes)
    }
    return generator
}

func generator_pass(
    discovery: Discovery.DiscoveryResult,
    host_classes: List<String>,
    number_keys: Dictionary<Analysis.SpiteType>,
    notes: Dictionary<String>,
    pass: Integer,
): Generation.Generator {
    var generator = Generation.Generator()
    configure(generator)
    generator.another_pass_follows_a_change = pass < maximum_passes
    generator.renders_program = not reloading
    generator.seed_class_names(host_classes)
    generator.number_key_sites = number_keys
    generator.key_use_notes = notes
    var prelude = Generation.Prelude()
    var header = prelude.header()
    var structs = prelude.structs()
    var prototypes = prelude.prototypes()
    var bodies = prelude.bodies()
    generated_code = generator.generate(discovery, header, structs, prototypes, bodies)
    return generator
}

func report_error(message: String) {
    if reloading {
        console.print(message)
        return
    }
    console.error(message)
}

func hot_state(
    discovery: Discovery.DiscoveryResult,
    reload: Generation.HotReloadLibrary,
    next_generation: Integer,
): String {
    var paths = discovery.program_paths
    var hashes = List<String>()
    var index = 0
    while index < paths.count() {
        var content = discovery.program_texts[paths[index]]
        var hash = ""
        if content {
            hash = reload.hash_of(content)
        }
        hashes.append(hash)
        index = index + 1
    }
    return reload.state_text(next_generation, paths, hashes)
}

func configure(generator: Generation.Generator) {
    var port = remote_loop_port()
    generator.read_evaluate_print_loop = is_on("repl") or port > 0
    generator.console_loop = is_on("repl")
    generator.remote_loop_port = port
    generator.development = is_on("development") or is_on("hot_reload")
    generator.hot_reload = is_on("hot_reload")
    generator.debug_memory = is_on("debug_memory")
    generator.trace_asserts = is_on("trace_asserts")
    generator.keeps_internals = generator.development or generator.read_evaluate_print_loop
    generator.working_folder = program.working_directory()
    generator.language_folder = language_folder
    if generator.hot_reload {
        generator.hot_reload_compiler = program.executable_path()
        generator.hot_reload_arguments = reload_arguments()
        generator.hot_reload_program_file = executable_path()
    }
}

func reload_arguments(): String {
    var arguments = Arguments()
    var kept = List<String>()
    var index = 0
    if reloading {
        index = 1
    }
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        if not is_output_flag(argument) {
            kept.append(argument)
        }
        index = index + 1
    }
    return kept.join("\n")
}

func is_output_flag(argument: String): Boolean {
    if not argument.starts_with("--") {
        return false
    }
    var outputs = ["run", "executable", "executable_path", "c_source", "c_path", "final_classes"]
    var name = setting_name(argument)
    return outputs.contains(name)
}

func flag_name(argument: String): String {
    var equals_position = argument.index_of("=")
    var argument_length = argument.length()
    if equals_position > 2 {
        return argument.slice(2, equals_position)
    }
    return argument.slice(2, argument_length)
}

func remote_loop_port(): Integer {
    var port_text = option("repl_port")
    if port_text == "0" {
        return 0
    }
    return port_number(port_text)
}

func compiler_arguments_end(arguments: Arguments): Integer {
    var index = 0
    while index < arguments.count() {
        if arguments.get(index) == "--" {
            return index
        }
        index = index + 1
    }
    return arguments.count()
}

func program_arguments(): List<String> {
    var arguments = Arguments()
    var passed = List<String>()
    var index = compiler_arguments_end(arguments) + 1
    while index < arguments.count() {
        var argument = arguments.get(index)
        passed.append(argument)
        index = index + 1
    }
    return passed
}

func read_supplied_settings(arguments: Arguments) {
    var index = 0
    while index < compiler_arguments_end(arguments) {
        var argument = arguments.get(index)
        var argument_length = argument.length()
        if argument.starts_with("--") and argument_length > 2 {
            read_flag(argument)
        }
        index = index + 1
    }
}

func read_flag(argument: String) {
    var name = setting_name(argument)
    var equals_position = argument.index_of("=")
    if equals_position > 2 {
        var argument_length = argument.length()
        supplied_settings[name] = argument.slice(equals_position + 1, argument_length)
        return
    }
    supplied_settings[name] = "true"
    bare_settings.append(name)
}

func setting_name(argument: String): String {
    var written = flag_name(argument)
    if written.contains("_") and flag_error.is_empty() {
        var hyphenated = written.replace("_", "-")
        flag_error = "error: '--{written}' is written '--{hyphenated}': a flag is kebab-case, and it sets the Build field '{written}'"
    }
    return written.replace("-", "_")
}

func executable_path(): String {
    var chosen = option("executable_path")
    if not chosen.is_empty() {
        return chosen
    }
    var base = beside_program()
    if option("target_operating_system") == "windows" {
        return "{base}.exe"
    }
    return base
}

func c_path(): String {
    var chosen = option("c_path")
    if not chosen.is_empty() {
        return chosen
    }
    var base = beside_program()
    return "{base}.c"
}

func beside_program(): String {
    var folder = option("program")
    var name = last_segment(folder)
    return "{folder}/{name}"
}

func wrote_c_source(): Boolean {
    var path = c_path()
    var folder = directory_of(path)
    create_folder(folder)
    if File(path).write(generated_code) {
        return true
    }
    console.error("error: could not write '{path}'")
    return false
}

func wrote_final_classes(
    discovery: Discovery.DiscoveryResult,
    generator: Generation.Generator,
    output_directory: String,
): Boolean {
    var kept = generator.emitted_qualified_names()
    var written = true
    var index = 0
    while index < discovery.class_files.count() and written {
        var class_file = discovery.class_files[index]
        if kept.contains(class_file.qualified_dotted) {
            written = wrote_final_class(generator, class_file, output_directory)
        }
        index = index + 1
    }
    if not written {
        return false
    }
    var instantiated_class_names = generator.instantiated_class_names()
    var instantiated_class_sources = generator.instantiated_class_sources()
    return wrote_class_views(output_directory, "instantiated", instantiated_class_names, instantiated_class_sources)
}

func wrote_final_class(
    generator: Generation.Generator,
    class_file: Discovery.DiscoveredClass,
    output_directory: String,
): Boolean {
    var path = final_class_path(output_directory, class_file.qualified_dotted)
    var final_class_directory = directory_of(path)
    create_folder(final_class_directory)
    var class_file_file = class_file.get_file()
    var ordered = in_file_order(class_file_file, class_file.simple_name)
    var source = "{Syntax.SourcePrinter().source_file(ordered)}{generator.generated_functions_source(class_file.qualified_dotted)}"
    var formatted = formatted_or_as_printed(source)
    if File(path).write(formatted) {
        return true
    }
    console.error("error: could not write '{path}'")
    return false
}

func in_file_order(file: Syntax.SourceFile, class_name: String): Syntax.SourceFile {
    var ranking = Discovery.ProgramDiscovery()
    var ordered = List<Syntax.Statements.Statement>()
    var rank = -1
    while rank < 8 {
        var index = 0
        while index < file.statements.count() {
            if ranking.order_rank(file.statements[index], class_name) == rank {
                ordered.append(file.statements[index])
            }
            index = index + 1
        }
        rank = rank + 1
    }
    return Syntax.SourceFile(ordered)
}

func formatted_or_as_printed(source: String): String {
    var formatted = Syntax.Formatter().format("{source}\n")
    if formatted {
        return formatted
    }
    return "{source}\n"
}

func wrote_class_views(output_directory: String, folder: String, names: List<String>, sources: List<String>): Boolean {
    if names.is_empty() {
        return true
    }
    var directory = "{output_directory}/{folder}"
    create_folder(directory)
    var index = 0
    while index < names.count() {
        var path = "{directory}/{final_class_file_name(names[index])}.spite"
        crash sources[index]
        var formatted = formatted_or_as_printed(sources[index])
        if not File(path).write(formatted) {
            console.error("error: could not write '{path}'")
            return false
        }
        index = index + 1
    }
    return true
}

func final_class_path(output_directory: String, qualified_name: String): String {
    var segments = qualified_name.split(".")
    var path = output_directory
    var index = 0
    while index < segments.count() {
        path = "{path}/{final_class_file_name(segments[index])}"
        index = index + 1
    }
    return "{path}.spite"
}

func final_class_file_name(class_name: String): String {
    var result = ""
    var index = 0
    while index < class_name.length() {
        var character = class_name.character_at(index)
        var code = class_name.code_at(index)
        if code >= 65 and code <= 90 {
            if index > 0 {
                result = "{result}_"
            }
            result = "{result}{character.lower_case()}"
        } else {
            result = "{result}{character}"
        }
        index = index + 1
    }
    return result
}

func create_folder(path: String) {
    var segments = path.split("/")
    var current = ""
    var index = 0
    while index < segments.count() {
        if index > 0 {
            current = "{current}/"
        }
        current = "{current}{segments[index]}"
        Directory(current).create()
        index = index + 1
    }
}

func built_executable(): Boolean {
    var output_path = executable_path()
    var output_folder = directory_of(output_path)
    create_folder(output_folder)
    var c_compiler = find_c_compiler()
    if c_compiler.is_empty() {
        console.error(
            "error: no C compiler found. Set the CC environment variable to the command that compiles C (for example CC=clang), or install cc, clang or gcc",
        )
        return false
    }
    var splitter = Translation.UnitSplitter()
    if splits_into_units(splitter) {
        var built = built_from_units(splitter, c_compiler, output_path)
        if not built or reported_missing_output(output_path) {
            return false
        }
        write_companions(output_path)
        return true
    }
    var c_file_path = c_to_compile(output_path)
    var process_arguments = List<String>()
    append_code_settings(process_arguments, c_compiler, false)
    if is_on("hot_reload") {
        append_shared_runtime(process_arguments, c_compiler)
    }
    append_frame_pointers(process_arguments)
    process_arguments.append(c_file_path)
    process_arguments.append("-o")
    process_arguments.append(output_path)
    append_maths_library(process_arguments, generated_code)
    var process = Process(c_compiler, process_arguments)
    var exit_code = process.run()
    if exit_code != 0 {
        var output = process.output()
        console.error(output)
        return false
    }
    if reported_missing_output(output_path) {
        return false
    }
    write_companions(output_path)
    return true
}

func splits_into_units(splitter: Translation.UnitSplitter): Boolean {
    if is_on("hot_reload") or generated_code.contains("#include \"") {
        return false
    }
    var wanted = wanted_translation_units(generated_code)
    return wanted > 1 and splitter.split(generated_code, wanted)
}

func wanted_translation_units(code: String): Integer {
    var chosen = option("translation_units").to_integer()
    crash chosen
    if chosen > 0 or not is_on("optimized") {
        return chosen.maximum(1)
    }
    var by_size = code.length() / 786432
    var by_processors = processor_count()
    var units = 1
    while units * 2 <= by_size and units * 2 <= by_processors and units < 64 {
        units = units * 2
    }
    return units
}

func processor_count(): Integer {
    var named = program.environment("NUMBER_OF_PROCESSORS")
    if named {
        var count = named.trim().to_integer()
        if count and count > 0 {
            return count
        }
    }
    var no_arguments = List<String>()
    var probe = Process("getconf _NPROCESSORS_ONLN", no_arguments)
    if probe.run() == 0 {
        var probed = probe.output()
        var probed_count = probed.trim().to_integer()
        if probed_count and probed_count > 0 {
            return probed_count
        }
    }
    return 4
}

func built_from_units(splitter: Translation.UnitSplitter, c_compiler: String, output_path: String): Boolean {
    var cache_folder = "{language_folder}/.spite-cache/objects"
    create_folder(cache_folder)
    var build = Translation.UnitBuild(c_compiler, cache_folder)
    build.running_limit = processor_count()
    append_code_settings(build.compile_arguments, c_compiler, true)
    append_frame_pointers(build.compile_arguments)
    append_link_settings(build.link_arguments, c_compiler)
    append_maths_library(build.link_arguments, generated_code)
    return build.built(splitter.header_text, splitter.unit_texts, output_path)
}

func append_code_settings(process_arguments: List<String>, c_compiler: String, split: Boolean) {
    if is_on("optimized") {
        process_arguments.append("-O3")
        if split {
            append_link_time_optimization(process_arguments, c_compiler)
        }
    } else {
        process_arguments.append("-O0")
    }
    if is_on("tune_for_this_machine") {
        append_machine_tuning(process_arguments, c_compiler)
    }
    process_arguments.append("-Wno-parentheses-equality")
    process_arguments.append("-I.")
}

func append_link_settings(process_arguments: List<String>, c_compiler: String) {
    if is_on("optimized") {
        process_arguments.append("-O3")
        append_link_time_optimization(process_arguments, c_compiler)
    }
    if is_on("tune_for_this_machine") {
        append_machine_tuning(process_arguments, c_compiler)
    }
}

func append_link_time_optimization(process_arguments: List<String>, c_compiler: String) {
    var family = compiler_family(c_compiler)
    if family == "clang" {
        process_arguments.append("-flto=thin")
        if option("operating_system") != "mac" {
            process_arguments.append("-fuse-ld=lld")
        }
    }
    if family == "gcc" {
        process_arguments.append("-flto=auto")
    }
}

func append_machine_tuning(process_arguments: List<String>, c_compiler: String) {
    var no_arguments = List<String>()
    var probe = Process("{c_compiler} -dumpmachine", no_arguments)
    probe.run()
    var machine = probe.output()
    if machine.starts_with("aarch64") or machine.starts_with("arm") {
        process_arguments.append("-mcpu=native")
    } else {
        process_arguments.append("-march=native")
    }
}

func compiler_family(c_compiler: String): String {
    var no_arguments = List<String>()
    var probe = Process("{c_compiler} --version", no_arguments)
    probe.run()
    var version = probe.output()
    if version.contains("clang") {
        return "clang"
    }
    if version.contains("Free Software Foundation") or version.contains("gcc") {
        return "gcc"
    }
    return ""
}

func c_to_compile(output_path: String): String {
    if is_on("c_source") {
        return c_path()
    }
    var cache_folder = "{language_folder}/.spite-cache"
    Directory(cache_folder).create()
    var base = without_executable_extension(output_path)
    var name = last_segment(base)
    var path = "{cache_folder}/{name}_{path_fingerprint(output_path)}.c"
    var wrote = File(path).write(generated_code)
    crash wrote
    return path
}

func path_fingerprint(path: String): Long {
    var fingerprint: Long = 7
    var index = 0
    while index < path.length() {
        var code: Long = path.code_at(index)
        fingerprint = (fingerprint * 31 + code) % 1000000007
        index = index + 1
    }
    return fingerprint
}

func reported_missing_output(output_path: String): Boolean {
    if File(output_path).exists() {
        return false
    }
    console.error(
        "error: the C compiler reported success but '{output_path}' is not there: nothing was built, so nothing runs (another build writing the same executable, or a virus scanner, may have removed it)",
    )
    return true
}

func write_companions(output_path: String) {
    var base = without_executable_extension(output_path)
    File("{base}.crashes").write(last_crash_map)
    if is_on("hot_reload") {
        File("{base}.reload_host").write(last_hot_manifest)
        File("{base}.reload_files").write(last_hot_state)
    }
}

func append_maths_library(process_arguments: List<String>, written: String) {
    if written.contains("#include <math.h>") and option("operating_system") != "windows" {
        process_arguments.append("-lm")
    }
}

func append_frame_pointers(process_arguments: List<String>) {
    var inspectable = is_on("development") or is_on("hot_reload") or is_on("repl") or remote_loop_port() > 0
    assert inspectable and option("target_operating_system") != "windows"
    process_arguments.append("-fno-omit-frame-pointer")
    process_arguments.append("-DSPITE_FRAME_POINTERS")
}

func append_shared_runtime(process_arguments: List<String>, c_compiler: String) {
    assert option("target_operating_system") == "windows"
    var no_arguments = List<String>()
    var probe = Process("{c_compiler} -dumpmachine", no_arguments)
    probe.run()
    var machine = probe.output()
    if machine.contains("msvc") {
        process_arguments.append("-fms-runtime-lib=dll")
        process_arguments.append("-Wl,-nodefaultlib:libcmt")
    }
}

func find_c_compiler(): String {
    var chosen = program.environment("CC")
    if chosen {
        if not chosen.trim().is_empty() {
            return chosen.trim()
        }
    }
    var candidates = ["cc", "clang", "gcc"]
    var index = 0
    while index < candidates.count() {
        var no_arguments = List<String>()
        var probe = Process("{candidates[index]} --version 2>&1", no_arguments)
        if probe.run() == 0 {
            return candidates[index]
        }
        index = index + 1
    }
    return ""
}

func run_reload(discovery: Discovery.DiscoveryResult) {
    var program_file = executable_path()
    var base = without_executable_extension(program_file)
    var host_text = File("{base}.reload_host").read()
    var state_text = File("{base}.reload_files").read()
    if not host_text or not state_text or not is_on("hot_reload") {
        console.print(
            "error: 'spite reload' rebuilds what changed in a program built with --hot-reload, and '{program_file}' was not: build it with --hot-reload --executable --executable-path={program_file}",
        )
        program.exit(1)
        return
    }
    var reload = Generation.HotReloadLibrary()
    reload.read_host(host_text)
    reload.read_state(state_text)
    var changed_files = changed_paths(discovery, reload)
    if changed_files.is_empty() {
        console.print("unchanged")
        return
    }
    var generator = keyed_generator(discovery, reload.host_classes, reload.host_key_sites)
    if generator.has_error {
        console.print(generator.error_message)
        program.exit(1)
        return
    }
    var swappable = generator.program_source_paths()
    var fixed = List<String>()
    var changed_index = 0
    while changed_index < changed_files.count() {
        if not swappable.contains(changed_files[changed_index]) {
            fixed.append(changed_files[changed_index])
        }
        changed_index = changed_index + 1
    }
    if not fixed.is_empty() {
        console.print(
            "error: '{fixed.join("', '")}' changed, and a reload swaps only the functions of the program's own classes, which it holds none of (it reopens a class of the standard library, or sets how the program is built): restart the program to change it, or undo that change to reload the rest",
        )
        program.exit(1)
        return
    }
    var next_generation = reload.generation + 1
    var state = hot_state(discovery, reload, next_generation)
    var layout_problem = reload.layout_problem(generator.builder.typedefs)
    if not layout_problem.is_empty() {
        console.print("error: {layout_problem}")
        program.exit(1)
        return
    }
    var rebuilt = List<String>()
    var library_code = generator.reload_library(reload, changed_files, rebuilt)
    var library_base = "{base}_reload_{next_generation}"
    var library_path = "{library_base}.{library_extension()}"
    if not build_library(library_code, "{library_base}.c", library_path) {
        program.exit(1)
        return
    }
    File("{library_base}.files").write(state)
    console.print("rebuilt {rebuilt.join(", ")}")
    if not reload.removed.is_empty() {
        console.print("removed {reload.removed.join(", ")}")
    }
    console.print("library {library_path}")
    console.print("state {library_base}.files")
}

func changed_paths(discovery: Discovery.DiscoveryResult, reload: Generation.HotReloadLibrary): List<String> {
    var paths = discovery.program_paths
    var changed = List<String>()
    var index = 0
    while index < paths.count() {
        var content = discovery.program_texts[paths[index]]
        if content {
            var hash = reload.hash_of(content)
            if reload.is_changed(paths[index], hash) {
                changed.append(paths[index])
            }
        }
        index = index + 1
    }
    return changed
}

func without_executable_extension(path: String): String {
    if path.ends_with(".exe") {
        var path_length = path.length()
        return path.slice(0, path_length - 4)
    }
    return path
}

func library_extension(): String {
    var target = option("target_operating_system")
    if target == "windows" {
        return "dll"
    }
    if target == "mac" {
        return "dylib"
    }
    return "so"
}

func build_library(code: String, library_c_path: String, library_path: String): Boolean {
    File(library_c_path).write(code)
    var c_compiler = find_c_compiler()
    var process_arguments = List<String>()
    process_arguments.append("-shared")
    if is_on("optimized") {
        process_arguments.append("-O3")
    } else {
        process_arguments.append("-O0")
    }
    process_arguments.append("-w")
    if option("target_operating_system") == "windows" {
        append_shared_runtime(process_arguments, c_compiler)
    } else {
        process_arguments.append("-fPIC")
    }
    process_arguments.append(library_c_path)
    process_arguments.append("-o")
    process_arguments.append(library_path)
    append_maths_library(process_arguments, code)
    var process = Process(c_compiler, process_arguments)
    if process.run() != 0 {
        var output = process.output()
        console.print("error: the C compiler could not build {library_path}:\n{output}")
        return false
    }
    return true
}

func run_executable() {
    var output_path = executable_path()
    var passed = program_arguments()
    var runner_path = output_path
    if option("operating_system") == "windows" {
        runner_path = output_path.replace("/", "\\")
    }
    var runner = Process(runner_path, passed)
    var port = remote_loop_port()
    if is_on("repl") or port > 0 or is_on("hot_reload") {
        console.flush()
        var run_attached = runner.run_attached()
        program.exit(run_attached)
        return
    }
    var exit_code = runner.run()
    var output = runner.output()
    console.write(output)
    program.exit(exit_code)
}

func run_format_command(arguments: Arguments) {
    var only_check = false
    var named = false
    var files = List<String>()
    var index = 1
    while index < arguments.count() {
        var argument = arguments.get(index)
        if argument == "--check" {
            only_check = true
        } else {
            named = true
            collect_spite_files(argument, files)
        }
        index = index + 1
    }
    if not named {
        console.error(
            "usage: spite format [--check] file_or_folder ...   a folder is formatted with every folder inside it",
        )
        program.exit(1)
        return
    }
    var failed = false
    var file_index = 0
    while file_index < files.count() {
        if not formatted_file(files[file_index], only_check) {
            failed = true
        }
        file_index = file_index + 1
    }
    if failed {
        program.exit(1)
    }
}

func collect_spite_files(named: String, files: List<String>) {
    var path = without_trailing_slashes(named)
    var folder = Directory(path)
    if not folder.exists() {
        files.append(path)
        return
    }
    var names = folder.files()
    var index = 0
    while index < names.count() {
        if names[index].ends_with(".spite") {
            files.append("{path}/{names[index]}")
        }
        index = index + 1
    }
    var folders = folder.folders()
    var folder_index = 0
    while folder_index < folders.count() {
        if folders[folder_index] != ".spite-cache" {
            collect_spite_files("{path}/{folders[folder_index]}", files)
        }
        folder_index = folder_index + 1
    }
}

func formatted_file(path: String, only_check: Boolean): Boolean {
    var content = File(path).read()
    if not content {
        console.error("error: could not read '{path}'")
        return false
    }
    var formatter = Syntax.Formatter()
    var formatted = formatter.format(content)
    if not formatted {
        console.error("{path}: not formatted: {formatter.refusal}")
        return false
    }
    if formatted == content {
        return true
    }
    if only_check {
        console.print(path)
        return false
    }
    if not File(path).write(formatted) {
        console.error("error: could not write '{path}'")
        return false
    }
    console.error("formatted {path}")
    return true
}

func port_number(text: String): Integer {
    if text.is_empty() or text.length() > 5 {
        return -1
    }
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        if code < 48 or code > 57 {
            return -1
        }
        index = index + 1
    }
    var number = text.to_integer()
    if not number or number < 1 or number > 65535 {
        return -1
    }
    return number
}

func run_connect(arguments: Arguments) {
    var port_text = ""
    if arguments.count() > 1 {
        port_text = arguments.get(1)
    }
    var port = port_number(port_text)
    if port < 0 {
        console.error(
            "usage: spite connect <port>                    talk to a program started with --repl-port=<port>",
        )
        console.error("       spite connect <port> --command=\"...\"    send one command and print its JSON answer")
        program.exit(1)
        return
    }
    var connection = Socket()
    if not connection.connect_locally(port) {
        console.error("error: nothing is listening on 127.0.0.1:{port}: run a program with --repl-port={port} first")
        program.exit(1)
        return
    }
    if arguments.command {
        send_one_command(connection, arguments.command)
        return
    }
    var talking = true
    while talking {
        console.write("spite> ")
        var line = console.read_line()
        if line {
            talking = talk(connection, line)
        } else {
            console.print("")
            talking = false
        }
    }
    connection.close()
}

func talk(connection: Socket, line: String): Boolean {
    var sent = connection.write_line(line)
    var response = connection.read_line()
    if not response {
        return false
    }
    var pretty = pretty_response(response)
    if not pretty.is_empty() {
        console.print(pretty)
    }
    var command = line.trim()
    return sent and command != "exit"
}

func send_one_command(connection: Socket, command: String) {
    connection.write_line(command)
    var response = connection.read_line()
    connection.close()
    if response {
        console.print(response)
        return
    }
    console.error("error: the program closed the connection without answering")
    program.exit(1)
}

func pretty_response(response: String): String {
    var failed_prefix = "\{\"ok\":false,\"error\":\""
    var succeeded_prefix = "\{\"ok\":true,\"value\":\""
    if response.starts_with(failed_prefix) {
        var failed_prefix_length = failed_prefix.length()
        var message = json_string_at(response, failed_prefix_length)
        return "error: {message}"
    }
    if not response.starts_with(succeeded_prefix) {
        return response
    }
    var succeeded_prefix_length = succeeded_prefix.length()
    var value = json_string_at(response, succeeded_prefix_length)
    var class_name = response.split("\",\"type\":\"").last()
    crash class_name
    var class_name_length = class_name.length()
    if class_name_length <= 2 or class_name.starts_with("Nothing\"") {
        return value
    }
    return "{value} ({class_name.slice(0, class_name_length - 2)})"
}

func json_string_at(text: String, start: Integer): String {
    var pieces = List<String>()
    var text_length = text.length()
    var index = start
    while index < text_length and text.code_at(index) != 34 {
        var character = text.character_at(index)
        if character == "\\" and index + 1 < text_length {
            index = index + 1
            var escaped = text.character_at(index)
            var plain_text = unescaped(escaped)
            pieces.append(plain_text)
        } else {
            pieces.append(character)
        }
        index = index + 1
    }
    return pieces.join("")
}

func unescaped(escaped: String): String {
    switch escaped {
        "n": return "\n"
        "r": return "\r"
        "t": return "\t"
        _: return escaped
    }
}
