var name = ""
var inner: Analysis.SpiteType? = null
var guard_code = ""
var override_code = ""
var links = List<Syntax.Expressions.Expression>()
var link_tests = List<String>()
var kept_code = ""

func NullableGuard(
    starting_name: String,
    starting_inner: Analysis.SpiteType,
    starting_guard_code: String,
    starting_override_code: String,
) {
    name = starting_name
    inner = starting_inner
    guard_code = starting_guard_code
    override_code = starting_override_code
}

func get_inner(): Analysis.SpiteType {
    crash inner
    return inner
}
