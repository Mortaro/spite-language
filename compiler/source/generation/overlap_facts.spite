var outline = ReportOutline()
var struct_fields = Dictionary<String, String>()
var returns = Dictionary<String, String>()
var first_parameters = Dictionary<String, String>()
var bodies = Dictionary<String, List<String>>()
var body_names = List<String>()
var direct = Dictionary<String, OverlapFact>()
var studying = Dictionary<String, Boolean>()
var mutation_answers = Dictionary<String, Boolean>()
var shared_holders = Dictionary<String, Boolean>()
var made_classes = Dictionary<String, Boolean>()
var mentioned = Dictionary<String, Boolean>()
var item_direct = Dictionary<String, OverlapFact>()
var item_mode = false
var band_counts = false
var weights = Dictionary<String, Long>()
var weighing = Dictionary<String, Boolean>()
var parameter_names = Dictionary<String, List<String>>()
var unfresh_slots = Dictionary<String, Boolean>()
var unfresh_holders = Dictionary<String, Boolean>()
var escaped_slots = Dictionary<String, Boolean>()
var unknown_fields = Dictionary<String, Boolean>()
var lend_answers = Dictionary<String, Boolean>()
var followed = Dictionary<String, OverlapFact>()
var following = Dictionary<String, Boolean>()
var follow_prefixes = Dictionary<String, String>()
var checking = false
var needed_checks = List<String>()
var singletons = Dictionary<String, Boolean>()
var slot_fields = Dictionary<String, Boolean>()
var container_prefixes = ["List_", "Vector_", "Items_", "Dictionary_", "TypedMemory_", "InlineMemory_"]
var keywords = [
    "if"
    "while"
    "for"
    "switch"
    "return"
    "sizeof"
    "do"
    "else"
    "case"
    "defined"
    "_Alignas"
    "__typeof__"
]
var pure_externals = [
    "malloc"
    "free"
    "realloc"
    "calloc"
    "memcpy"
    "memmove"
    "memset"
    "memcmp"
    "strlen"
    "sqrt"
    "sqrtf"
    "floor"
    "floorf"
    "ceil"
    "ceilf"
    "round"
    "roundf"
    "fabs"
    "fabsf"
    "sin"
    "sinf"
    "cos"
    "cosf"
    "tan"
    "tanf"
    "asin"
    "asinf"
    "acos"
    "acosf"
    "atan"
    "atanf"
    "atan2"
    "atan2f"
    "pow"
    "powf"
    "exp"
    "expf"
    "log"
    "logf"
    "fmod"
    "fmodf"
    "trunc"
    "truncf"
    "abs"
    "labs"
    "llabs"
    "clock_gettime"
    "QueryPerformanceCounter"
    "QueryPerformanceFrequency"
    "pthread_mutex_lock"
    "pthread_mutex_unlock"
    "AcquireSRWLockExclusive"
    "ReleaseSRWLockExclusive"
    "AcquireSRWLockShared"
    "ReleaseSRWLockShared"
]

func read_program(
    typedefs: List<String>,
    prototypes: List<String>,
    support: List<String>,
    user: List<String>,
    mains: List<String>,
) {
    typedefs.each(read_structs)
    typedefs.each(note_singletons)
    prototypes.each(read_prototype)
    read_bodies(support)
    read_bodies(user)
    typedefs.each(note_mentions)
    mains.each(note_mentions)
    body_names.each(note_body_mentions)
    body_names.each(note_made_classes)
    body_names.each(note_slot_uses)
    body_names.each(note_holders_of)
}

func read_structs(entry: String) {
    var lines = entry.split("\n")
    var current = ""
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        if line.starts_with("struct ") and line.ends_with(" \{") {
            var name_end = line.length() - 2
            current = line.slice(7, name_end).trim()
        } else if line == "};" {
            current = ""
        } else if not current.is_empty() and line.ends_with(";") {
            note_struct_field(current, line)
        }
        index = index + 1
    }
}

func note_struct_field(owner: String, line: String) {
    var text_end = line.length() - 1
    var text = line.slice(0, text_end).trim()
    var text_length = text.length()
    var name_start = identifier_start(text, text_length)
    assert name_start > 0
    var field_type = text.slice(0, name_start).trim()
    var field_name = text.slice(name_start, text_length)
    assert not field_type.is_empty()
    struct_fields["{owner}#{field_name}"] = field_type
    if field_type.ends_with("*") {
        slot_fields[field_name] = true
    }
}

func identifier_start(text: String, end: Integer): Integer {
    var position = end
    while position > 0 {
        var code = text.code_at(position - 1)
        if not outline.is_name_code(code) {
            return position
        }
        position = position - 1
    }
    return position
}

func read_prototype(entry: String) {
    var open = entry.index_of("(")
    assert open > 0
    var name_start = identifier_start(entry, open)
    assert name_start > 0 and name_start < open
    var name = entry.slice(name_start, open)
    var written = entry.slice(0, name_start)
    returns[name] = without_decorations(written)
    var close = matching_close(entry, open)
    assert close > open
    var parameters = entry.slice(open + 1, close)
    var comma = parameters.index_of(",")
    var first = parameters
    if comma >= 0 {
        first = parameters.slice(0, comma)
    }
    var first_trimmed = first.trim()
    var first_length = first_trimmed.length()
    var first_name = identifier_start(first_trimmed, first_length)
    first_parameters[name] = first_trimmed.slice(0, first_name).trim()
    parameter_names[name] = names_of_parameters(parameters)
}

func names_of_parameters(parameters: String): List<String> {
    var names = List<String>()
    var pieces = top_level_pieces(parameters)
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index].trim()
        var piece_length = piece.length()
        var start = identifier_start(piece, piece_length)
        var name = piece.slice(start, piece_length)
        names.append(name)
        index = index + 1
    }
    return names
}

func top_level_pieces(text: String): List<String> {
    var pieces = List<String>()
    var depth = 0
    var start = 0
    var position = 0
    var quote = 0
    var length = text.length()
    while position < length {
        var code = text.code_at(position)
        if quote != 0 {
            position = position + quoted_width(code) - 1
            quote = still_quoted(code, quote)
        } else if code == 34 or code == 39 {
            quote = code
        } else if code == 40 or code == 123 or code == 91 {
            depth = depth + 1
        } else if code == 41 or code == 125 or code == 93 {
            depth = depth - 1
        } else if code == 44 and depth == 0 {
            var piece = text.slice(start, position)
            pieces.append(piece)
            start = position + 1
        }
        position = position + 1
    }
    var last = text.slice(start, length)
    if not last.trim().is_empty() {
        pieces.append(last)
    }
    return pieces
}

func without_decorations(written: String): String {
    var words = written.trim().split(" ")
    var kept = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        var decoration = word == "static" or word == "inline" or word.starts_with("SPITE_") or word.starts_with("__attribute__")
        if not decoration and not word.is_empty() {
            kept.append(word)
        }
        index = index + 1
    }
    return kept.join(" ")
}

func read_bodies(entries: List<String>) {
    var current = ""
    var lines = List<String>()
    var depth = 0
    var entry_index = 0
    while entry_index < entries.count() {
        var split = entries[entry_index].split("\n")
        var line_index = 0
        while line_index < split.count() {
            var line = split[line_index]
            if current.is_empty() and starts_function(line) {
                current = function_name_of(line)
                lines = List<String>()
                depth = 0
            }
            if not current.is_empty() {
                lines.append(line)
                depth = depth + brace_change(line)
                if depth <= 0 {
                    keep_body(current, lines)
                    current = ""
                }
            }
            line_index = line_index + 1
        }
        entry_index = entry_index + 1
    }
}

func keep_body(name: String, lines: List<String>) {
    assert not bodies.has(name)
    bodies[name] = lines
    body_names.append(name)
}

func starts_function(line: String): Boolean {
    if line.is_empty() or not line.ends_with("\{") {
        return false
    }
    var first = line.code_at(0)
    var letter = first == 95 or first >= 65 and first <= 90 or first >= 97 and first <= 122
    if not letter or line.starts_with("struct ") or line.starts_with("typedef ") or line.starts_with("union ") {
        return false
    }
    var open = line.index_of("(")
    if open < 0 {
        return false
    }
    var before = line.slice(0, open)
    if before.contains("=") {
        return false
    }
    var name_start = identifier_start(line, open)
    var name = line.slice(name_start, open)
    return not keywords.contains(name) and name_start > 0
}

func function_name_of(line: String): String {
    var open = line.index_of("(")
    var name_start = identifier_start(line, open)
    return line.slice(name_start, open)
}

func brace_change(line: String): Integer {
    var change = 0
    var quote = 0
    var position = 0
    var length = line.length()
    while position < length {
        var code = line.code_at(position)
        if quote != 0 {
            position = position + quoted_width(code) - 1
            quote = still_quoted(code, quote)
        } else if code == 34 or code == 39 {
            quote = code
        } else if code == 123 {
            change = change + 1
        } else if code == 125 {
            change = change - 1
        }
        position = position + 1
    }
    return change
}

func matching_close(text: String, open: Integer): Integer {
    var depth = 0
    var quote = 0
    var position = open
    var length = text.length()
    while position < length {
        var code = text.code_at(position)
        if quote != 0 {
            position = position + quoted_width(code) - 1
            quote = still_quoted(code, quote)
        } else if code == 34 or code == 39 {
            quote = code
        } else if code == 40 {
            depth = depth + 1
        } else if code == 41 {
            depth = depth - 1
            if depth == 0 {
                return position
            }
        }
        position = position + 1
    }
    return -1
}

func matching_open(text: String, close: Integer): Integer {
    var depth = 0
    var position = close
    while position >= 0 {
        var code = text.code_at(position)
        if code == 41 {
            depth = depth + 1
        } else if code == 40 {
            depth = depth - 1
            if depth == 0 {
                return position
            }
        }
        position = position - 1
    }
    return -1
}

func is_container_type(written: String): Boolean {
    var class_name = class_of(written)
    var index = 0
    while index < container_prefixes.count() {
        if class_name.starts_with(container_prefixes[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_container_function(name: String): Boolean {
    var first = first_parameters[name]
    if not first {
        return false
    }
    return is_container_type(first)
}

func class_of(written: String): String {
    var text = written.replace("const ", "").replace("*", "").trim()
    var space = text.index_of(" ")
    if space >= 0 {
        return ""
    }
    return text
}

func facts_of(name: String): OverlapFact {
    var known = direct[name]
    if known {
        return known
    }
    var fact = OverlapFact()
    direct[name] = fact
    var lines = bodies[name]
    if not lines {
        return fact
    }
    fact.container = is_container_function(name)
    var saved_mode = item_mode
    var saved_prefixes = follow_prefixes
    item_mode = false
    follow_prefixes = Dictionary<String, String>()
    var index = 1
    while index < lines.count() {
        study_line(fact, lines[index], lines, name)
        index = index + 1
    }
    item_mode = saved_mode
    follow_prefixes = saved_prefixes
    return fact
}

func note_made_classes(name: String) {
    var lines = bodies[name]
    crash lines
    var index = 0
    while index < lines.count() {
        note_made_on_line(lines[index], name)
        index = index + 1
    }
}

func note_made_on_line(line: String, function_name: String) {
    var suffixes = ["___allocate(", "___make(", "___default("]
    var index = 0
    while index < suffixes.count() {
        var suffix = suffixes[index]
        var rest = line
        var found = rest.index_of(suffix)
        while found > 0 {
            var name_start = identifier_start(rest, found)
            var made = rest.slice(name_start, found)
            if not function_name.starts_with("{made}___") {
                made_classes[made] = true
            }
            var rest_length = rest.length()
            rest = rest.slice(found + 1, rest_length)
            found = rest.index_of(suffix)
        }
        index = index + 1
    }
}

func never_made(holder: String): Boolean {
    if holder == "*" or made_classes.has(holder) {
        return false
    }
    return struct_fields.has("{holder}#header")
}

func note_holders_of(name: String) {
    if mentioned.has(name) {
        facts_of(name)
    }
}

func note_body_mentions(name: String) {
    var lines = bodies[name]
    crash lines
    var index = 1
    while index < lines.count() {
        note_mentions(lines[index])
        index = index + 1
    }
}

func note_mentions(text: String) {
    var length = text.length()
    var position = 0
    while position < length {
        var code = text.code_at(position)
        if outline.is_name_code(code) {
            var end = outline.name_end(text, position)
            var name = text.slice(position, end)
            mentioned[name] = true
            position = end
        } else {
            position = position + 1
        }
    }
}

func study_line(fact: OverlapFact, line: String, lines: List<String>, function_name: String) {
    var trimmed = line.trim()
    if trimmed.starts_with("while (") or trimmed.starts_with("for (") {
        if not fact.container or function_name.contains("_each") {
            fact.loops = true
        }
    }
    if trimmed.starts_with("*(") and line.contains(" = ") {
        note_raw_write(fact)
    }
    if line.contains("]++") or line.contains("]--") or line.contains("] = ") and not item_stores(fact, line, lines) {
        note_raw_write(fact)
    }
    if not fact.container and (line.contains(")[") or line.contains("*(")) {
        fact.read("raw")
    }
    if line.contains("))spite_foreign_") {
        note_foreign_calls(fact, line)
    }
    var atomic = line.contains("SPITE_SINGLETON_STORE") or line.contains("__atomic_store") or line.contains("__atomic_fetch") or line.contains("__atomic_exchange") or line.contains("__atomic_compare") or line.contains("__atomic_add") or line.contains("__atomic_sub")
    var length = line.length()
    var position = 0
    var quote = 0
    while position < length {
        var code = line.code_at(position)
        if quote != 0 {
            position = position + quoted_width(code)
            if code == quote {
                quote = 0
            }
        } else if code == 34 or code == 39 {
            quote = code
            position = position + 1
        } else if code == 45 and position + 1 < length and line.code_at(position + 1) == 62 {
            position = study_field(fact, line, position, lines, atomic)
        } else if outline.is_name_code(code) {
            position = study_name(fact, line, position, lines)
        } else {
            position = position + 1
        }
    }
}

func still_quoted(code: Integer, quote: Integer): Integer {
    if code == quote {
        return 0
    }
    return quote
}

func quoted_width(code: Integer): Integer {
    if code == 92 {
        return 2
    }
    return 1
}

# ../../../docs/proofs.md#an-object-made-for-its-owner-is-told-apart
func item_stores(fact: OverlapFact, line: String, lines: List<String>): Boolean {
    if fact.container {
        return false
    }
    var stores = 0
    var marker = "**)(intptr_t)("
    var rest = line
    var found = rest.index_of(marker)
    while found >= 0 {
        var name_start = found + marker.length()
        var rest_length = rest.length()
        var after = rest.slice(name_start, rest_length)
        var name_end = after.index_of(")->items_)[")
        if name_end > 0 {
            var list_name = after.slice(0, name_end)
            var index_start = name_end + 11
            var after_length = after.length()
            var tail = after.slice(index_start, after_length)
            var close = tail.index_of("]")
            if close >= 0 and is_identifier(list_name) {
                var close_length = tail.length()
                var assigned = tail.slice(close, close_length)
                if assigned.starts_with("] = ") {
                    note_item_store(fact, list_name, lines)
                    stores = stores + 1
                }
            }
        }
        rest = after
        found = rest.index_of(marker)
    }
    return stores > 0 and stores == line.split("] = ").count() - 1
}

func note_item_store(fact: OverlapFact, list_name: String, lines: List<String>) {
    var list_type = type_of(list_name, lines)
    var list_class = class_of(list_type)
    if list_class.is_empty() or not is_container_type(list_type) {
        fact.write("raw")
        return
    }
    var key = content_key_of(list_name, list_class, lines)
    assert not key.is_empty()
    fact.write(key)
}

func note_raw_write(fact: OverlapFact) {
    if fact.container {
        fact.mutates = true
    } else {
        fact.write("raw")
    }
}

func study_name(fact: OverlapFact, line: String, start: Integer, lines: List<String>): Integer {
    var end = outline.name_end(line, start)
    var name = line.slice(start, end)
    var first = line.code_at(start)
    var after = end
    while after < line.length() and line.code_at(after) == 32 {
        after = after + 1
    }
    var calls = after < line.length() and line.code_at(after) == 40
    var digit = first >= 48 and first <= 57
    var pointer_type = calls and after + 2 < line.length() and line.code_at(after + 1) == 42 and line.code_at(after + 2) == 41
    if not calls or digit or keywords.contains(name) or pointer_type or quiet_guard(name) {
        if name == "spite_call" or name == "spite_typed_call" {
            fact.write("unknown")
        }
        return end
    }
    study_call(fact, line, name, after, lines)
    return end
}

func quiet_guard(name: String): Boolean {
    var suffixes = ["___outside_enter", "___outside_leave", "___outside_read_enter", "___outside_read_leave"]
    var index = 0
    while index < suffixes.count() {
        if name.ends_with(suffixes[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func note_foreign_calls(fact: OverlapFact, line: String) {
    var marker = "spite_last_foreign_call = \""
    var rest = line
    var found = rest.index_of(marker)
    if found < 0 {
        fact.write("io:foreign")
        return
    }
    while found >= 0 {
        var name_start = found + marker.length()
        var rest_length = rest.length()
        rest = rest.slice(name_start, rest_length)
        var tab = rest.index_of("\\t")
        var quote_end = rest.index_of("\"")
        var name_end = tab
        if name_end < 0 or quote_end >= 0 and quote_end < name_end {
            name_end = quote_end
        }
        var name = ""
        if name_end > 0 {
            name = rest.slice(0, name_end)
        }
        if not pure_externals.contains(name) {
            fact.write("io:{name}")
        }
        found = rest.index_of(marker)
    }
}

func study_call(fact: OverlapFact, line: String, name: String, open: Integer, lines: List<String>) {
    assert not is_runtime(name) and not is_macro(name)
    if not bodies.has(name) {
        var reports_crash = name == "abort" or name == "fputs" and line.contains(", stderr)")
        if not reports_crash and not pure_externals.contains(name) and not name.starts_with("__builtin_") and not name.starts_with("__atomic_") {
            fact.write("io:{name}")
        }
        return
    }
    if item_mode and not fact.container and not is_container_function(name) {
        var passed = first_argument(line, open)
        if passed == "self" {
            var item_fact = item_facts_of(name)
            fact.merge_item(name, item_fact)
            return
        }
    }
    assert fact.container or is_container_function(name) or not follow_call(fact, line, name, open, lines)
    fact.call(name)
    assert is_container_function(name)
    var argument = first_argument(line, open)
    if fact.container {
        if argument.starts_with("self") and mutates(name) {
            fact.mutates = true
        }
        return
    }
    var key = content_key(argument, name, lines)
    assert not key.is_empty()
    if item_mode and not key.starts_with("s:") and own_content(argument, key) {
        key = "s:{key}"
    }
    if mutates(name) {
        fact.write(key)
    } else {
        fact.read(key)
    }
}

func is_runtime(name: String): Boolean {
    if name.starts_with("spite_") or name.starts_with("Spite") {
        return true
    }
    return name.ends_with("___retain") or name.ends_with("___release") or name.ends_with("___default") or name.ends_with("___allocate") or name.ends_with("___init")
}

func is_macro(name: String): Boolean {
    if name.starts_with("SPITE_") {
        return true
    }
    var index = 0
    while index < name.length() {
        var code = name.code_at(index)
        if code >= 97 and code <= 122 {
            return false
        }
        index = index + 1
    }
    return true
}

func mutates(name: String): Boolean {
    var known = mutation_answers[name]
    if known == true or known == false {
        return known == true
    }
    mutation_answers[name] = false
    var fact = facts_of(name)
    var answer = fact.mutates
    mutation_answers[name] = answer
    return answer
}

func first_argument(line: String, open: Integer): String {
    var close = matching_close(line, open)
    if close < 0 {
        return ""
    }
    var depth = 0
    var position = open + 1
    while position < close {
        var code = line.code_at(position)
        if code == 40 {
            depth = depth + 1
        } else if code == 41 {
            depth = depth - 1
        } else if code == 44 and depth == 0 {
            return line.slice(open + 1, position).trim()
        }
        position = position + 1
    }
    return line.slice(open + 1, close).trim()
}

func content_key(argument: String, function_name: String, lines: List<String>): String {
    var container_class = ""
    var first = first_parameters[function_name]
    if first {
        container_class = class_of(first)
    }
    return content_key_of(argument, container_class, lines)
}

func content_key_of(argument: String, container_class: String, lines: List<String>): String {
    var text = stripped(argument)
    var identity = identity_of(text, lines)
    if not identity.is_empty() {
        var prefix = identity_prefix(identity)
        var tags = identity_tags(identity)
        var tags_length = tags.length()
        if tags.is_empty() {
            return "{prefix}c:{container_class}|"
        }
        return "{prefix}c:{container_class}|{tags.slice(1, tags_length)}"
    }
    if text.starts_with("\{") {
        return "c:{container_class}|*"
    }
    var arrow = last_arrow(text)
    if arrow >= 0 {
        var prefix = text.slice(0, arrow)
        var text_length = text.length()
        var field = text.slice(arrow + 2, text_length).trim()
        var prefix_type = type_of(prefix, lines)
        var holder = class_of(prefix_type)
        if holder.is_empty() {
            holder = "*"
        }
        return "c:{container_class}|{holder}#{field}"
    }
    if is_identifier(text) and made_here(text, lines) {
        return ""
    }
    return "c:{container_class}|*"
}

func made_here(name: String, lines: List<String>): Boolean {
    var made = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if assigns_name(line, name) {
            var fresh = line.contains("___make(") or line.contains("___default()") or line.contains("___allocate()")
            if not fresh {
                return false
            }
            made = true
        }
        index = index + 1
    }
    return made
}

func assigns_name(line: String, name: String): Boolean {
    var trimmed = line.trim()
    return line.contains(" {name} = ") or trimmed.starts_with("{name} = ")
}

func is_identifier(text: String): Boolean {
    if text.is_empty() {
        return false
    }
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        if not outline.is_name_code(code) {
            return false
        }
        index = index + 1
    }
    return true
}

func stripped(text: String): String {
    var current = text.trim()
    while current.starts_with("(") and matching_close(current, 0) == current.length() - 1 {
        var inner_end = current.length() - 1
        current = current.slice(1, inner_end).trim()
    }
    return current
}

func last_arrow(text: String): Integer {
    var depth = 0
    var found = -1
    var position = 0
    var length = text.length()
    while position + 1 < length {
        var code = text.code_at(position)
        if code == 40 {
            depth = depth + 1
        } else if code == 41 {
            depth = depth - 1
        } else if code == 45 and depth == 0 and text.code_at(position + 1) == 62 {
            found = position
        }
        position = position + 1
    }
    return found
}

func type_of(expression: String, lines: List<String>): String {
    var text = stripped(expression)
    if text.is_empty() {
        return ""
    }
    var arrow = last_arrow(text)
    if arrow >= 0 {
        return arrow_type(text, arrow, lines)
    }
    if text.starts_with("(") {
        var close = matching_close(text, 0)
        if close <= 0 {
            return ""
        }
        var cast = text.slice(1, close).trim()
        if not looks_like_type(cast) {
            return ""
        }
        return cast
    }
    if text.ends_with(")") {
        var open = text.index_of("(")
        if open <= 0 {
            return ""
        }
        var called = text.slice(0, open)
        var answered = returns[called]
        if answered {
            return answered
        }
        return ""
    }
    if is_identifier(text) {
        return outline.declared_type(lines, text, true)
    }
    return ""
}

func arrow_type(text: String, arrow: Integer, lines: List<String>): String {
    var prefix = text.slice(0, arrow)
    var text_length = text.length()
    var field = text.slice(arrow + 2, text_length).trim()
    var prefix_type = type_of(prefix, lines)
    var holder = class_of(prefix_type)
    var field_type = struct_fields["{holder}#{field}"]
    if field_type {
        return field_type
    }
    return ""
}

func looks_like_type(text: String): Boolean {
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        if not outline.type_code(code) {
            return false
        }
        index = index + 1
    }
    return outline.has_letter(text)
}

func study_field(fact: OverlapFact, line: String, arrow: Integer, lines: List<String>, atomic: Boolean): Integer {
    var field_start = arrow + 2
    while field_start < line.length() and line.code_at(field_start) == 32 {
        field_start = field_start + 1
    }
    var field_end = outline.name_end(line, field_start)
    var field = line.slice(field_start, field_end)
    var base_start = base_begin(line, arrow)
    var base = line.slice(base_start, arrow).trim()
    if outline.before_call(line, field_end) {
        fact.write("unknown")
        return field_end
    }
    if fact.container and base == "self" {
        if writes_after(line, field_end) or atomic {
            fact.mutates = true
        }
        return field_end
    }
    var base_type = type_of(base, lines)
    var holder = class_of(base_type)
    if holder.is_empty() {
        holder = "*"
    }
    if is_container_type(base_type) and not fact.container {
        var content = content_key_of(base, holder, lines)
        var content_written = atomic or writes_after(line, field_end)
        note_content(fact, content, content_written)
        return field_end
    }
    if never_made(holder) {
        return field_end
    }
    var written = atomic or writes_after(line, field_end) or address_before(line, base_start)
    var identity = identity_of(base, lines)
    var key = "{identity_prefix(identity)}f:{holder}#{field}{identity_tags(identity)}"
    if written {
        fact.write(key)
    } else {
        fact.read(key)
    }
    note_holder_use(line, base_start, field_end, holder, field)
    return field_end
}

func note_content(fact: OverlapFact, content: String, written: Boolean) {
    assert not content.is_empty()
    if written {
        fact.write(content)
    } else {
        fact.read(content)
    }
}

func base_begin(line: String, arrow: Integer): Integer {
    var position = arrow - 1
    while position >= 0 and line.code_at(position) == 32 {
        position = position - 1
    }
    var going = true
    while going and position >= 0 {
        position = operand_begin(line, position)
        going = position >= 2 and line.code_at(position - 1) == 62 and line.code_at(position - 2) == 45
        if going {
            position = position - 3
        }
    }
    return position + 1
}

func operand_begin(line: String, end: Integer): Integer {
    var position = end
    if line.code_at(position) == 41 {
        var open = matching_open(line, position)
        if open < 0 {
            return position
        }
        position = open - 1
        var name_start = identifier_start(line, position + 1)
        return name_start - 1
    }
    var name_start = identifier_start(line, position + 1)
    return name_start - 1
}

func writes_after(line: String, end: Integer): Boolean {
    var length = line.length()
    var position = end
    while position < length and line.code_at(position) == 32 {
        position = position + 1
    }
    if position >= length {
        return false
    }
    var code = line.code_at(position)
    var next = 0
    if position + 1 < length {
        next = line.code_at(position + 1)
    }
    if code == 61 {
        return next != 61
    }
    if next == 61 {
        return code == 43 or code == 45 or code == 42 or code == 47 or code == 37 or code == 124 or code == 38 or code == 94
    }
    return code == 43 and next == 43 or code == 45 and next == 45
}

func address_before(line: String, start: Integer): Boolean {
    var position = start - 1
    while position >= 0 and line.code_at(position) == 32 {
        position = position - 1
    }
    if position < 0 {
        return false
    }
    var code = line.code_at(position)
    if code == 38 {
        return position == 0 or line.code_at(position - 1) != 38
    }
    var stepped = code == 43 or code == 45
    return stepped and position > 0 and line.code_at(position - 1) == code
}

func note_holder_use(line: String, base_start: Integer, field_end: Integer, holder: String, field: String) {
    var field_type = struct_fields["{holder}#{field}"]
    assert field_type and is_container_type(field_type)
    assert not passed_to_container(line, base_start, field_end) and not made_fresh(line, field_end)
    assert not followed_by_arrow(line, field_end)
    assert not temporary_alias(line, base_start, field_end) and not lent_argument(line, base_start, field_end)
    shared_holders["{holder}#{field}"] = true
}

func followed_by_arrow(line: String, field_end: Integer): Boolean {
    var length = line.length()
    var position = field_end
    while position < length and (line.code_at(position) == 32 or line.code_at(position) == 41) {
        position = position + 1
    }
    return position + 1 < length and line.code_at(position) == 45 and line.code_at(position + 1) == 62
}

func passed_to_container(line: String, base_start: Integer, field_end: Integer): Boolean {
    var position = base_start - 1
    while position >= 0 and line.code_at(position) == 32 {
        position = position - 1
    }
    if position < 0 or line.code_at(position) != 40 {
        return false
    }
    var name_start = identifier_start(line, position)
    var called = line.slice(name_start, position)
    if not is_container_function(called) and not called.ends_with("___release") {
        return false
    }
    var after = field_end
    while after < line.length() and line.code_at(after) == 32 {
        after = after + 1
    }
    if after >= line.length() {
        return false
    }
    var next = line.code_at(after)
    return next == 44 or next == 41
}

func made_fresh(line: String, field_end: Integer): Boolean {
    var line_length = line.length()
    var rest = line.slice(field_end, line_length).trim()
    if not rest.starts_with("= ") {
        return false
    }
    return rest.contains("___make(") or rest.contains("___default()") or rest.contains("___allocate()")
}

func note_singletons(entry: String) {
    var lines = entry.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        var marker = "* spite_singleton_"
        var at = line.index_of(marker)
        if line.starts_with("static ") and at > 0 and line.ends_with("_cache = 0;") {
            var name_start = at + marker.length()
            var line_length = line.length()
            var name = line.slice(name_start, line_length - 11)
            singletons[name] = true
        }
        index = index + 1
    }
}

# ../../../docs/proofs.md#an-object-made-for-its-owner-is-told-apart
func note_slot_uses(name: String) {
    var lines = bodies[name]
    crash lines
    assert mentioned.has(name)
    var index = 1
    while index < lines.count() {
        note_slot_line(lines[index], lines, name)
        index = index + 1
    }
}

func note_slot_line(line: String, lines: List<String>, function_name: String) {
    note_struct_copy(line, lines, function_name)
    var length = line.length()
    var position = 0
    var quote = 0
    while position < length {
        var code = line.code_at(position)
        if quote != 0 {
            position = position + quoted_width(code)
            if code == quote {
                quote = 0
            }
        } else if code == 34 or code == 39 {
            quote = code
            position = position + 1
        } else if code == 45 and position + 1 < length and line.code_at(position + 1) == 62 {
            position = note_slot_use(line, position, lines)
        } else {
            position = position + 1
        }
    }
}

func note_struct_copy(line: String, lines: List<String>, function_name: String) {
    var trimmed = line.trim()
    var copies = trimmed.starts_with("*") and trimmed.contains(" = *")
    if copies and not function_name.ends_with("___moved") {
        var equals = trimmed.index_of(" = ")
        var target = trimmed.slice(1, equals).trim()
        var target_type = type_of(target, lines)
        var holder = class_of(target_type)
        if holder.is_empty() {
            holder = "*"
        }
        unfresh_holders[holder] = true
    }
    if trimmed.contains("memcpy(") and trimmed.contains("sizeof(") {
        var parts = trimmed.split("sizeof(")
        var index = 1
        while index < parts.count() {
            var part = parts[index]
            var end = part.index_of(")")
            if end > 0 {
                var copied = part.slice(0, end).trim()
                if struct_fields.has("{copied}#header") {
                    unfresh_holders[copied] = true
                }
            }
            index = index + 1
        }
    }
}

func note_slot_use(line: String, arrow: Integer, lines: List<String>): Integer {
    var field_start = arrow + 2
    while field_start < line.length() and line.code_at(field_start) == 32 {
        field_start = field_start + 1
    }
    var field_end = outline.name_end(line, field_start)
    var field = line.slice(field_start, field_end)
    if field.is_empty() or outline.before_call(line, field_end) {
        return field_end
    }
    if not slot_fields.has(field) {
        return field_end
    }
    var base_start = base_begin(line, arrow)
    var base = line.slice(base_start, arrow).trim()
    var base_type = type_of(base, lines)
    var holder = class_of(base_type)
    if holder.is_empty() {
        var unknown_use = slot_use(line, base_start, field_end)
        if unknown_use == "write" or unknown_use == "escape" {
            unknown_fields[field] = true
        }
        return field_end
    }
    var field_type = struct_fields["{holder}#{field}"]
    if not field_type or not is_class_pointer(field_type) {
        return field_end
    }
    var use = slot_use(line, base_start, field_end)
    var slot = "{holder}#{field}"
    if use == "write" {
        unfresh_slots[slot] = true
    } else if use == "escape" {
        escaped_slots[slot] = true
    }
    return field_end
}

func is_class_pointer(written: String): Boolean {
    if not written.trim().ends_with("*") {
        return false
    }
    var class_name = class_of(written)
    return not class_name.is_empty() and struct_fields.has("{class_name}#header")
}

func slot_use(line: String, base_start: Integer, field_end: Integer): String {
    if writes_after(line, field_end) {
        if fresh_assignment(line, field_end) {
            return "fresh"
        }
        return "write"
    }
    if address_before(line, base_start) or singleton_store_target(line, field_end) {
        return "write"
    }
    if followed_by_arrow(line, field_end) or passed_to_container(line, base_start, field_end) {
        return "fine"
    }
    if compared(line, base_start, field_end) or temporary_alias(line, base_start, field_end) {
        return "fine"
    }
    if lent_argument(line, base_start, field_end) {
        return "fine"
    }
    return "escape"
}

func fresh_assignment(line: String, field_end: Integer): Boolean {
    var line_length = line.length()
    var rest = line.slice(field_end, line_length).trim()
    if not rest.starts_with("= ") or not rest.ends_with(";") {
        return false
    }
    var rest_length = rest.length()
    var value = rest.slice(2, rest_length - 1).trim()
    if value == "0" or value == "NULL" {
        return true
    }
    var open = value.index_of("(")
    if open <= 0 {
        return false
    }
    var called = value.slice(0, open)
    var made = called.ends_with("___make") or called.ends_with("___default") or called.ends_with("___allocate")
    return made and is_identifier(called) and matching_close(value, open) == value.length() - 1
}

func singleton_store_target(line: String, field_end: Integer): Boolean {
    var stores = line.contains("SPITE_SINGLETON_STORE(") or line.contains("__atomic_store") or line.contains("__atomic_exchange")
    if not stores {
        return false
    }
    var line_length = line.length()
    var rest = line.slice(field_end, line_length).trim()
    return rest.starts_with(",")
}

func compared(line: String, base_start: Integer, field_end: Integer): Boolean {
    var length = line.length()
    var after = field_end
    while after < length and (line.code_at(after) == 32 or line.code_at(after) == 41) {
        after = after + 1
    }
    if after + 1 < length and line.code_at(after + 1) == 61 {
        var code = line.code_at(after)
        if code == 61 or code == 33 {
            return true
        }
    }
    var before = base_start - 1
    while before >= 0 and (line.code_at(before) == 32 or line.code_at(before) == 40) {
        before = before - 1
    }
    return before >= 1 and line.code_at(before) == 61 and (line.code_at(before - 1) == 61 or line.code_at(before - 1) == 33)
}

func temporary_alias(line: String, base_start: Integer, field_end: Integer): Boolean {
    var line_length = line.length()
    var rest = line.slice(field_end, line_length).trim()
    if not rest.starts_with(";") {
        return false
    }
    var before = line.slice(0, base_start).trim()
    if not before.ends_with(" =") {
        return false
    }
    var before_length = before.length()
    var left = before.slice(0, before_length - 2).trim()
    var left_length = left.length()
    var name_start = identifier_start(left, left_length)
    var name = left.slice(name_start, left_length)
    var declared = left.slice(0, name_start).trim()
    if not name.starts_with("spite_temp_") or not declared.ends_with("*") {
        return false
    }
    return temporary_only_read(line, name)
}

func temporary_only_read(line: String, name: String): Boolean {
    var length = line.length()
    var position = 0
    while position < length {
        var code = line.code_at(position)
        if outline.is_name_code(code) {
            var end = outline.name_end(line, position)
            var word = line.slice(position, end)
            if word == name and not name_use_reads(line, position, end) {
                return false
            }
            position = end
        } else {
            position = position + 1
        }
    }
    return true
}

func name_use_reads(line: String, start: Integer, end: Integer): Boolean {
    var length = line.length()
    var after = end
    if after < length and line.code_at(after) == 41 {
        after = after + 1
    }
    if after + 1 < length and line.code_at(after) == 45 and line.code_at(after + 1) == 62 {
        return true
    }
    var rest = line.slice(end, length).trim()
    if rest.starts_with("= ") {
        var before = line.slice(0, start).trim()
        return before.ends_with("*")
    }
    var open = start - 1
    if open >= 0 and line.code_at(open) == 40 {
        var called_start = identifier_start(line, open)
        var called = line.slice(called_start, open)
        var next = line.code_at(end)
        if not called.is_empty() and is_container_function(called) and (next == 44 or next == 41) {
            return true
        }
    }
    return false
}

func lent_argument(line: String, base_start: Integer, field_end: Integer): Boolean {
    var open = unmatched_open(line, base_start)
    if open < 0 {
        return false
    }
    var called_start = identifier_start(line, open)
    var called = line.slice(called_start, open)
    if called.is_empty() or not bodies.has(called) {
        return false
    }
    var close = matching_close(line, open)
    if close < field_end {
        return false
    }
    var expression_text = line.slice(base_start, field_end)
    var expression = stripped(expression_text)
    var inside = line.slice(open + 1, close)
    var arguments = top_level_pieces(inside)
    var found = false
    var index = 0
    while index < arguments.count() {
        var argument = stripped(arguments[index])
        if argument == expression {
            if not lends(called, index) {
                return false
            }
            found = true
        }
        index = index + 1
    }
    return found
}

func unmatched_open(line: String, before: Integer): Integer {
    var position = before - 1
    var depth = 0
    while position >= 0 {
        var code = line.code_at(position)
        if code == 40 and depth == 0 {
            return position
        }
        if code == 41 {
            depth = depth + 1
        } else if code == 40 {
            depth = depth - 1
        }
        position = position - 1
    }
    return -1
}

func lends(name: String, position: Integer): Boolean {
    var key = "{name}#{position}"
    var known = lend_answers[key]
    if known == true or known == false {
        return known == true
    }
    lend_answers[key] = false
    var answer = parameter_lent(name, position)
    lend_answers[key] = answer
    return answer
}

func parameter_lent(name: String, position: Integer): Boolean {
    var lines = bodies[name]
    var names = parameter_names[name]
    if not lines or not names or position >= names.count() {
        return false
    }
    if is_container_function(name) {
        return position == 0
    }
    var parameter = names[position]
    if parameter.is_empty() {
        return false
    }
    var index = 1
    while index < lines.count() {
        if not parameter_line_lends(lines[index], parameter) {
            return false
        }
        index = index + 1
    }
    return true
}

func parameter_line_lends(line: String, parameter: String): Boolean {
    var length = line.length()
    var position = 0
    var quote = 0
    while position < length {
        var code = line.code_at(position)
        if quote != 0 {
            position = position + quoted_width(code)
            if code == quote {
                quote = 0
            }
        } else if code == 34 or code == 39 {
            quote = code
            position = position + 1
        } else if outline.is_name_code(code) {
            var end = outline.name_end(line, position)
            var word = line.slice(position, end)
            var field_name = position >= 2 and line.code_at(position - 1) == 62 and line.code_at(position - 2) == 45
            var member = position >= 1 and line.code_at(position - 1) == 46
            if word == parameter and not field_name and not member and not parameter_use_lends(line, position, end) {
                return false
            }
            position = end
        } else {
            position = position + 1
        }
    }
    return true
}

func parameter_use_lends(line: String, start: Integer, end: Integer): Boolean {
    var length = line.length()
    if end + 1 < length and line.code_at(end) == 45 and line.code_at(end + 1) == 62 {
        return true
    }
    if start >= 1 and line.code_at(start - 1) == 40 and end + 2 < length and line.code_at(end) == 41 {
        var before_open = 0
        if start >= 2 {
            before_open = line.code_at(start - 2)
        }
        var grouped = start < 2 or not outline.is_name_code(before_open)
        var arrow = line.code_at(end + 1) == 45 and line.code_at(end + 2) == 62
        if grouped and arrow {
            return true
        }
    }
    if compared(line, start, end) or temporary_alias(line, start, end) {
        return true
    }
    if start >= 1 and line.code_at(start - 1) == 40 {
        var called_start = identifier_start(line, start - 1)
        var called = line.slice(called_start, start - 1)
        var next = 0
        if end < length {
            next = line.code_at(end)
        }
        if not called.is_empty() and is_container_function(called) and (next == 44 or next == 41) {
            return true
        }
    }
    return lent_argument(line, start, end)
}

func fresh_slot(slot: String): Boolean {
    var field = slot_field(slot)
    if slot.ends_with("[]") or unfresh_slots.has(slot) or unknown_fields.has(field) {
        return false
    }
    var holder = slot_holder(slot)
    if unfresh_holders.has(holder) or unfresh_holders.has("*") {
        return false
    }
    var field_type = struct_fields[slot]
    if not field_type {
        return false
    }
    return is_class_pointer(field_type)
}

func slot_sealed(slot: String): Boolean {
    return fresh_slot(slot) and not escaped_slots.has(slot) and not shared_holders.has(slot)
}

func identity_prefix(identity: String): String {
    var at = identity.index_of("@")
    if at < 0 {
        return identity
    }
    return identity.slice(0, at)
}

func identity_tags(identity: String): String {
    var at = identity.index_of("@")
    if at < 0 {
        return ""
    }
    var identity_length = identity.length()
    return identity.slice(at, identity_length)
}

func identity_of(expression: String, lines: List<String>): String {
    var text = stripped(expression)
    if text.is_empty() {
        return ""
    }
    var prefix = follow_prefixes[text]
    if prefix {
        return prefix
    }
    if item_mode and text == "self" {
        return "s:"
    }
    if text.starts_with("\{") {
        return item_identity(text, lines)
    }
    if text.ends_with(")") and not text.starts_with("(") {
        return call_identity(text, lines)
    }
    if is_identifier(text) {
        if not text.starts_with("spite_temp_") and not assigned_once(text, lines) {
            return ""
        }
        var source = declared_value(text, lines)
        if source.is_empty() or source == text {
            return ""
        }
        return identity_of(source, lines)
    }
    var arrow = last_arrow(text)
    if arrow < 0 {
        return ""
    }
    var base = text.slice(0, arrow)
    var text_length = text.length()
    var field = text.slice(arrow + 2, text_length).trim()
    if not is_identifier(field) {
        return ""
    }
    var base_type = type_of(base, lines)
    var holder = class_of(base_type)
    var slot = "{holder}#{field}"
    if holder.is_empty() or not fresh_slot(slot) {
        return ""
    }
    var inner = identity_of(base, lines)
    return "{identity_prefix(inner)}@{slot}{identity_tags(inner)}"
}

func item_identity(text: String, lines: List<String>): String {
    if not text.ends_with("}") {
        return ""
    }
    var text_length = text.length()
    var body = text.slice(1, text_length - 1).trim()
    var body_length = body.length()
    var first_end = statement_end(body, 0)
    if first_end >= body_length {
        return ""
    }
    var declaration = body.slice(0, first_end)
    var equals = declaration.index_of(" = ")
    if equals < 0 {
        return ""
    }
    var left = declaration.slice(0, equals).trim()
    var declaration_length = declaration.length()
    var source_text = declaration.slice(equals + 3, declaration_length)
    var source = stripped(source_text)
    var left_length = left.length()
    var temporary_start = identifier_start(left, left_length)
    var temporary = left.slice(temporary_start, left_length)
    var declared = left.slice(0, temporary_start).trim()
    if not temporary.starts_with("spite_temp_") or not declared.ends_with("*") {
        return ""
    }
    var rest = body.slice(first_end, body_length)
    if body.ends_with("; {temporary};") and not rest.contains(" {temporary} = ") {
        return identity_of(source, lines)
    }
    if not body.ends_with("];") or not body.contains("**)(intptr_t)({temporary})->items_)[") {
        return ""
    }
    var last_statement = body.index_of("; ((")
    var item_read = body.index_of("({temporary})->items_)[")
    if last_statement < 0 or item_read < last_statement {
        return ""
    }
    return items_identity(source, lines)
}

func items_identity(source: String, lines: List<String>): String {
    var arrow = last_arrow(source)
    if arrow < 0 {
        return ""
    }
    var base = source.slice(0, arrow)
    var source_length = source.length()
    var field = source.slice(arrow + 2, source_length).trim()
    var base_type = type_of(base, lines)
    var holder = class_of(base_type)
    if holder.is_empty() or not is_identifier(field) {
        return ""
    }
    var inner = identity_of(base, lines)
    return "{identity_prefix(inner)}@{holder}#{field}[]{identity_tags(inner)}"
}

func call_identity(text: String, lines: List<String>): String {
    var open = text.index_of("(")
    var text_length = text.length()
    if open <= 0 or matching_close(text, open) != text_length - 1 {
        return ""
    }
    var called = text.slice(0, open)
    if called.starts_with("spite_folded_") {
        var called_length = called.length()
        called = called.slice(13, called_length)
    }
    if not called.ends_with("_get_at") or not is_container_function(called) {
        return ""
    }
    var list = first_argument(text, open)
    var stripped_list = stripped(list)
    return items_identity(stripped_list, lines)
}

func assigned_once(name: String, lines: List<String>): Boolean {
    var assignments = 0
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if assigns_name(line, name) {
            assignments = assignments + 1
        }
        if line.contains("&{name}") {
            return false
        }
        index = index + 1
    }
    return assignments == 1
}

func declared_value(name: String, lines: List<String>): String {
    var marker = "* {name} = "
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var at = line.index_of(marker)
        if at >= 0 {
            var start = at + marker.length()
            var end = statement_end(line, start)
            return line.slice(start, end).trim()
        }
        index = index + 1
    }
    return ""
}

func statement_end(text: String, start: Integer): Integer {
    var depth = 0
    var quote = 0
    var position = start
    var length = text.length()
    while position < length {
        var code = text.code_at(position)
        if quote != 0 {
            position = position + quoted_width(code) - 1
            quote = still_quoted(code, quote)
        } else if code == 34 or code == 39 {
            quote = code
        } else if code == 40 or code == 123 or code == 91 {
            depth = depth + 1
        } else if code == 41 or code == 125 or code == 93 {
            depth = depth - 1
        } else if code == 59 and depth == 0 {
            return position
        }
        position = position + 1
    }
    return length
}

func follow_call(fact: OverlapFact, line: String, name: String, open: Integer, lines: List<String>): Boolean {
    var close = matching_close(line, open)
    if close < 0 {
        return false
    }
    var inside = line.slice(open + 1, close)
    var arguments = top_level_pieces(inside)
    var positions = List<Integer>()
    var identities = List<String>()
    var index = 0
    while index < arguments.count() {
        var identity = identity_of(arguments[index], lines)
        identities.append(identity)
        if not identity.is_empty() and lends(name, index) {
            positions.append(index)
        }
        index = index + 1
    }
    if positions.is_empty() {
        return false
    }
    var callee = follow_facts(name, positions)
    if not callee {
        return false
    }
    var written = callee.writes.keys()
    index = 0
    while index < written.count() {
        var written_key = rebased(written[index], identities)
        fact.write(written_key)
        index = index + 1
    }
    var read_keys = callee.reads.keys()
    index = 0
    while index < read_keys.count() {
        var read_key = rebased(read_keys[index], identities)
        fact.read(read_key)
        index = index + 1
    }
    if callee.loops {
        fact.loops = true
    }
    callee.calls.each(fact.call)
    fact.note_item_call(name)
    callee.item_calls.each(fact.note_item_call)
    return true
}

func follow_facts(name: String, positions: List<Integer>): OverlapFact? {
    var written_positions = List<String>()
    var index = 0
    while index < positions.count() {
        var position = positions[index]
        var position_text = position.to_string()
        written_positions.append(position_text)
        index = index + 1
    }
    var key = "{name}|{written_positions.join(",")}"
    assert not following.has(key)
    var known = followed[key]
    if known {
        return known
    }
    var fact = OverlapFact()
    followed[key] = fact
    following[key] = true
    var lines = bodies[name]
    var names = parameter_names[name]
    crash lines
    crash names
    var saved_mode = item_mode
    var saved_prefixes = follow_prefixes
    item_mode = false
    follow_prefixes = Dictionary<String, String>()
    index = 0
    while index < positions.count() {
        var position = positions[index]
        crash names[position]
        var parameter = names[position]
        follow_prefixes[parameter] = "p{position}:"
        index = index + 1
    }
    var line_index = 1
    while line_index < lines.count() {
        study_line(fact, lines[line_index], lines, name)
        line_index = line_index + 1
    }
    item_mode = saved_mode
    follow_prefixes = saved_prefixes
    following.remove(key)
    return fact
}

func rebased(key: String, identities: List<String>): String {
    if not key.starts_with("p") {
        return key
    }
    var colon = key.index_of(":")
    if colon < 2 {
        return key
    }
    var digits = key.slice(1, colon)
    var position = digits.to_integer()
    crash position
    crash identities[position]
    var identity = identities[position]
    var key_length = key.length()
    var rest = key.slice(colon + 1, key_length)
    var prefix = identity_prefix(identity)
    var tags = identity_tags(identity)
    var tags_length = tags.length()
    if rest.starts_with("c:") and rest.ends_with("|") and not tags.is_empty() {
        return "{prefix}{rest}{tags.slice(1, tags_length)}"
    }
    return "{prefix}{rest}{tags}"
}

func statement_fact(statement_lines: List<String>, function_lines: List<String>): OverlapFact {
    var fact = OverlapFact()
    var index = 0
    while index < statement_lines.count() {
        study_line(fact, statement_lines[index], function_lines, "")
        index = index + 1
    }
    var reached = Dictionary<String, Boolean>()
    var waiting = fact.calls.copy()
    while not waiting.is_empty() {
        var name = waiting.remove_last()
        crash name
        if not reached.has(name) {
            reached[name] = true
            var callee = facts_of(name)
            fact.merge(callee)
            callee.calls.each(waiting.append)
        }
    }
    return fact
}

func independent(first: OverlapFact, second: OverlapFact): Boolean {
    return not writes_touch(first, second) and not writes_touch(second, first)
}

func writes_touch(writer: OverlapFact, other: OverlapFact): Boolean {
    var written = writer.writes.keys()
    var index = 0
    while index < written.count() {
        var key = written[index]
        if key.starts_with("io") or key == "unknown" {
            return true
        }
        if touches_any(key, other.writes) or touches_any(key, other.reads) {
            return true
        }
        index = index + 1
    }
    var other_written = other.writes.keys()
    var other_index = 0
    while other_index < other_written.count() {
        var other_key = other_written[other_index]
        if other_key.starts_with("io") or other_key == "unknown" {
            return true
        }
        other_index = other_index + 1
    }
    return false
}

func touches_any(key: String, keys: Dictionary<String, Boolean>): Boolean {
    var listed = keys.keys()
    var index = 0
    while index < listed.count() {
        if keys_touch(key, listed[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func keys_touch(first: String, second: String): Boolean {
    var reason = touch_reason(first, second)
    if reason.starts_with("check:") {
        if checking {
            if not needed_checks.contains(reason) {
                needed_checks.append(reason)
            }
            return false
        }
        return true
    }
    return reason == "touch"
}

# ../../../docs/proofs.md#an-object-made-for-its-owner-is-told-apart
func touch_reason(first: String, second: String): String {
    if first == second {
        return "touch"
    }
    if first.starts_with("f:") and second.starts_with("f:") {
        var first_base = key_base(first)
        var second_base = key_base(second)
        if not fields_touch(first_base, second_base) {
            return ""
        }
        var first_chain = key_chain(first)
        var second_chain = key_chain(second)
        return chains_reason(first_chain, second_chain, false)
    }
    if first.starts_with("c:") and second.starts_with("c:") {
        return contents_reason(first, second)
    }
    return ""
}

func key_base(key: String): String {
    var at = key.index_of("@")
    if at < 0 {
        return key
    }
    return key.slice(0, at)
}

func key_chain(key: String): List<String> {
    var chain = List<String>()
    var at = key.index_of("@")
    if at < 0 {
        return chain
    }
    var key_length = key.length()
    var rest = key.slice(at + 1, key_length)
    var parts = rest.split("@")
    parts.each(chain.append)
    return chain
}

func contents_reason(first: String, second: String): String {
    var first_bar = first.index_of("|")
    var second_bar = second.index_of("|")
    var first_class = first.slice(2, first_bar)
    var second_class = second.slice(2, second_bar)
    if first_class != second_class {
        return ""
    }
    var first_length = first.length()
    var second_length = second.length()
    var first_holder = first.slice(first_bar + 1, first_length)
    var second_holder = second.slice(second_bar + 1, second_length)
    var first_chain = holder_chain(first_holder)
    var second_chain = holder_chain(second_holder)
    return chains_reason(first_chain, second_chain, true)
}

func holder_chain(holder_text: String): List<String> {
    var chain = List<String>()
    var parts = holder_text.split("@")
    crash parts[0]
    var holder = parts[0]
    if holder.is_empty() or holder == "*" or holder.starts_with("*#") {
        return chain
    }
    parts.each(chain.append)
    return chain
}

func chains_reason(first: List<String>, second: List<String>, contents: Boolean): String {
    if first.is_empty() and second.is_empty() {
        return "touch"
    }
    if first.is_empty() {
        return unknown_against(second)
    }
    if second.is_empty() {
        return unknown_against(first)
    }
    var level = 0
    while level < first.count() and level < second.count() {
        var first_part = first[level]
        var second_part = second[level]
        if first_part != second_part {
            return parts_reason(first, second, level, contents)
        }
        level = level + 1
    }
    return "touch"
}

func unknown_against(chain: List<String>): String {
    crash chain[0]
    var inner_part = chain[0]
    if not inner_part.ends_with("[]") and slot_sealed(inner_part) {
        return ""
    }
    return "touch"
}

func parts_reason(first: List<String>, second: List<String>, level: Integer, contents: Boolean): String {
    crash first[level]
    crash second[level]
    var first_part = first[level]
    var second_part = second[level]
    var first_items = first_part.ends_with("[]")
    var second_items = second_part.ends_with("[]")
    if not first_items and not second_items {
        if fresh_slot(first_part) and fresh_slot(second_part) {
            return ""
        }
        if level > 0 or not contents or holder_shared(first_part) or holder_shared(second_part) {
            return "touch"
        }
        return ""
    }
    if first_items and second_items {
        var last = level == first.count() - 1 and level == second.count() - 1
        if last {
            return items_check(first_part, second_part)
        }
        return "touch"
    }
    var slot = first_part
    if first_items {
        slot = second_part
    }
    if slot_sealed(slot) {
        return ""
    }
    return "touch"
}

func holder_shared(slot: String): Boolean {
    var field = slot_field(slot)
    return shared_holders.has(slot) or unknown_fields.has(field)
}

func slot_field(slot: String): String {
    var hash = slot.index_of("#")
    var slot_length = slot.length()
    return slot.slice(hash + 1, slot_length)
}

func slot_holder(slot: String): String {
    var hash = slot.index_of("#")
    return slot.slice(0, hash)
}

func items_check(first_items: String, second_items: String): String {
    var first_length = first_items.length()
    var second_length = second_items.length()
    var first_slot = first_items.slice(0, first_length - 2)
    var second_slot = second_items.slice(0, second_length - 2)
    var first_holder = slot_holder(first_slot)
    var second_holder = slot_holder(second_slot)
    if not singletons.has(first_holder) or not singletons.has(second_holder) {
        return "touch"
    }
    return "check:{first_slot}|{second_slot}"
}

func apart_expression(checks: List<String>, first: OverlapFact, second: OverlapFact): String {
    var parts = List<String>()
    var index = 0
    while index < checks.count() {
        var check = checks[index]
        var check_length = check.length()
        var body = check.slice(6, check_length)
        var bar = body.index_of("|")
        var body_length = body.length()
        var first_slot = body.slice(0, bar)
        var second_slot = body.slice(bar + 1, body_length)
        var written = list_written(first_slot, first) or list_written(first_slot, second)
        if written or list_written(second_slot, first) or list_written(second_slot, second) {
            return ""
        }
        var apart = lists_apart(first_slot, second_slot)
        parts.append(apart)
        index = index + 1
    }
    return parts.join(" && ")
}

func list_written(slot: String, fact: OverlapFact): Boolean {
    var list_type = struct_fields[slot]
    if not list_type {
        return true
    }
    var list_class = class_of(list_type)
    var holder = slot_holder(slot)
    var field = slot_field(slot)
    var field_key = "f:{holder}#{field}"
    var written = fact.writes.keys()
    var index = 0
    while index < written.count() {
        var key = written[index]
        var touches_field = touch_reason(key, field_key) != ""
        if touches_field or touch_reason(key, "c:{list_class}|{slot}") != "" or not key.contains(":") {
            return true
        }
        index = index + 1
    }
    return false
}

func lists_apart(first_slot: String, second_slot: String): String {
    var first_holder = slot_holder(first_slot)
    var second_holder = slot_holder(second_slot)
    var first_list = "spite_row_a->{slot_field(first_slot)}"
    var second_list = "spite_row_b->{slot_field(second_slot)}"
    var parts = List<String>()
    parts.append("(\{ {first_holder}* spite_row_a = SPITE_SINGLETON_FOUND(spite_singleton_{first_holder}_cache);")
    parts.append("{second_holder}* spite_row_b = SPITE_SINGLETON_FOUND(spite_singleton_{second_holder}_cache);")
    parts.append(
        "bool spite_row_none = spite_row_a != 0 && spite_row_b != 0 && {first_list} != 0 && {second_list} != 0;",
    )
    parts.append(
        "for (int32_t spite_row_x = 0; spite_row_none && spite_row_x < ({first_list})->item_count_; spite_row_x++)",
    )
    parts.append(
        "for (int32_t spite_row_y = 0; spite_row_none && spite_row_y < ({second_list})->item_count_; spite_row_y++)",
    )
    parts.append(
        "spite_row_none = ((void**)(intptr_t)({first_list})->items_)[spite_row_x] != ((void**)(intptr_t)({second_list})->items_)[spite_row_y];",
    )
    parts.append("spite_row_none; })")
    return parts.join(" ")
}

func fields_touch(first: String, second: String): Boolean {
    var first_hash = first.index_of("#")
    var second_hash = second.index_of("#")
    var first_length = first.length()
    var second_length = second.length()
    var first_field = first.slice(first_hash + 1, first_length)
    var second_field = second.slice(second_hash + 1, second_length)
    if first_field != second_field {
        return false
    }
    var first_class = first.slice(2, first_hash)
    var second_class = second.slice(2, second_hash)
    return first_class == second_class or first_class == "*" or second_class == "*"
}

# ../../../docs/proofs.md#passes-that-write-only-their-own-item
func item_facts_of(name: String): OverlapFact {
    var known = item_direct[name]
    if known {
        return known
    }
    var fact = OverlapFact()
    item_direct[name] = fact
    var lines = bodies[name]
    if not lines {
        fact.write("unknown")
        return fact
    }
    var saved = item_mode
    var saved_prefixes = follow_prefixes
    item_mode = true
    follow_prefixes = Dictionary<String, String>()
    var index = 1
    while index < lines.count() {
        study_line(fact, lines[index], lines, name)
        index = index + 1
    }
    item_mode = saved
    follow_prefixes = saved_prefixes
    return fact
}

func own_content(argument: String, key: String): Boolean {
    var text = stripped(argument)
    if not text.starts_with("self->") or last_arrow(text) != 4 {
        return false
    }
    var bar = key.index_of("|")
    var key_length = key.length()
    var holder = key.slice(bar + 1, key_length)
    return not holder.starts_with("*") and not shared_holders.has(holder)
}

func band_fact(target: String): OverlapFact {
    var fact = OverlapFact()
    var root = item_facts_of(target)
    fact.merge(root)
    var reached = Dictionary<String, Boolean>()
    reached[target] = true
    var item_index = 0
    while item_index < root.item_calls.count() {
        var item_name = root.item_calls[item_index]
        reached[item_name] = true
        item_index = item_index + 1
    }
    var waiting = root.calls.copy()
    while not waiting.is_empty() {
        var name = waiting.remove_last()
        crash name
        if not reached.has(name) {
            reached[name] = true
            var callee = facts_of(name)
            fact.merge(callee)
            callee.calls.each(waiting.append)
        }
    }
    band_counts = false
    var names = reached.keys()
    var index = 0
    while index < names.count() {
        if counts_references(names[index]) {
            band_counts = true
        }
        index = index + 1
    }
    return fact
}

func counts_references(name: String): Boolean {
    var lines = bodies[name]
    if not lines {
        return false
    }
    var markers = ["___retain(", "___release(", "_box_retain(", "_box_release(", "SPITE_COUNT_UP(", "SPITE_COUNT_DOWN("]
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var marker = 0
        while marker < markers.count() {
            if line.contains(markers[marker]) {
                return true
            }
            marker = marker + 1
        }
        index = index + 1
    }
    return false
}

func item_only(fact: OverlapFact): Boolean {
    var written = fact.writes.keys()
    var index = 0
    while index < written.count() {
        var key = written[index]
        if not key.starts_with("s:") {
            return false
        }
        var key_length = key.length()
        var plain = key.slice(2, key_length)
        if touches_any(plain, fact.reads) or touches_any(plain, fact.writes) {
            return false
        }
        index = index + 1
    }
    return true
}

func weight_of(name: String): Long {
    if weights.has(name) {
        var known = weights[name]
        crash known
        return known
    }
    var lines = bodies[name]
    if not lines or weighing.has(name) {
        return 1
    }
    weighing[name] = true
    var total: Long = 0
    var factors = List<Long>()
    var openings = List<Integer>()
    var multiplier: Long = 1
    var depth = 0
    var index = 1
    while index < lines.count() {
        var line = lines[index]
        var trimmed = line.trim()
        var called = calls_weight(line)
        var step = capped_product(multiplier, called + 1)
        total = capped_sum(total, step)
        var opens_loop = trimmed.starts_with("while (") or trimmed.starts_with("for (")
        if opens_loop and trimmed.ends_with("\{") {
            factors.append(multiplier)
            openings.append(depth)
            var factor = loop_factor(trimmed)
            multiplier = capped_product(multiplier, factor)
        }
        depth = depth + brace_change(line)
        multiplier = closed_loops(factors, openings, depth, multiplier)
        index = index + 1
    }
    weighing.remove(name)
    if total < 1 {
        total = 1
    }
    weights[name] = total
    return total
}

func closed_loops(factors: List<Long>, openings: List<Integer>, depth: Integer, multiplier: Long): Long {
    var current = multiplier
    while not openings.is_empty() and depth <= innermost(openings) {
        var restored = factors.remove_last()
        crash restored
        current = restored
        openings.remove_last()
    }
    return current
}

func innermost(openings: List<Integer>): Integer {
    var opened = openings.last()
    crash opened
    return opened
}

func calls_weight(line: String): Long {
    var total: Long = 0
    var length = line.length()
    var position = 0
    while position < length {
        var code = line.code_at(position)
        if outline.is_name_code(code) {
            var end = outline.name_end(line, position)
            if end < length and line.code_at(end) == 40 {
                var name = line.slice(position, end)
                if bodies.has(name) {
                    var called = weight_of(name)
                    total = capped_sum(total, called)
                }
            }
            position = end
        } else {
            position = position + 1
        }
    }
    return total
}

func loop_factor(header: String): Long {
    var less = header.index_of(" < ")
    if less < 0 {
        return 8
    }
    var bound: Long = 0
    var position = less + 3
    var length = header.length()
    var reading = true
    while reading and position < length and bound < 1000000000000 {
        var code = header.code_at(position)
        reading = code >= 48 and code <= 57
        if reading {
            bound = bound * 10 + code - 48
            position = position + 1
        }
    }
    if bound > 0 {
        return bound
    }
    return 8
}

func capped_sum(first: Long, second: Long): Long {
    var limit: Long = 1000000000000000
    if first >= limit - second {
        return limit
    }
    return first + second
}

func capped_product(first: Long, second: Long): Long {
    var limit: Long = 1000000000000000
    if second > 0 and first > limit / second {
        return limit
    }
    return first * second
}
