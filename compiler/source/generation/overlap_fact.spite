var reads = Dictionary<String, Boolean>()
var writes = Dictionary<String, Boolean>()
var calls = List<String>()
var item_calls = List<String>()
var loops = false
var container = false
var mutates = false

func read(key: String) {
    reads[key] = true
}

func write(key: String) {
    writes[key] = true
}

func call(name: String) {
    if not calls.contains(name) {
        calls.append(name)
    }
}

func merge(other: OverlapFact) {
    other.reads.keys().each(read)
    other.writes.keys().each(write)
    if other.loops {
        loops = true
    }
}

func merge_item(name: String, other: OverlapFact) {
    merge(other)
    other.calls.each(call)
    note_item_call(name)
    other.item_calls.each(note_item_call)
}

func note_item_call(name: String) {
    if not item_calls.contains(name) {
        item_calls.append(name)
    }
}
