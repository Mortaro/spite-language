var element: SpiteType? = null
var key: SpiteType? = null

func DictionaryType(starting_element: SpiteType, starting_key: SpiteType) {
    element = starting_element
    key = starting_key
}

func get_key(): SpiteType {
    crash key
    return key
}

func get_element(): SpiteType {
    crash element
    return element
}
