# ../intermediate/README.md#the-whole-program
var generator: Generation.Generator? = null
var objects = List<HighObject>()
var walked_functions = List<HighFunction>()
var walked_by_c_name = Dictionary<String, HighFunction>()
var classes_made = Dictionary<String, Boolean>()
var classes_by_qualified = Dictionary<String, Analysis.ClassInfo>()
var classes_by_c_name = Dictionary<String, Analysis.ClassInfo>()
var declared_function_names = Dictionary<String, Boolean>()
var item_objects = Dictionary<String, Integer>()
var prepared = false
var types = Analysis.TypeShape()

func HighProgram(starting_generator: Generation.Generator) {
    generator = starting_generator
}

func build() {
    note_classes()
    var known = program_classes()
    var class_index = 0
    while class_index < known.count() {
        var information = known[class_index]
        if not is_library(information) {
            build_class(information)
        }
        class_index = class_index + 1
    }
    var index = 0
    while index < walked_functions.count() {
        var function = walked_functions[index]
        function.fold_facts()
        decide_coverage(function)
        walked_by_c_name[function.c_name] = function
        index = index + 1
    }
}

func program_classes(): List<Analysis.ClassInfo> {
    crash generator
    return generator.classes
}

func is_library(information: Analysis.ClassInfo): Boolean {
    crash generator
    return generator.is_library_class(information)
}

func note_classes() {
    var known = program_classes()
    var index = 0
    while index < known.count() {
        var information = known[index]
        classes_by_qualified[information.qualified_dotted] = information
        classes_by_c_name[information.c_name] = information
        if not is_library(information) {
            note_declared_functions(information)
        }
        index = index + 1
    }
}

func note_declared_functions(information: Analysis.ClassInfo) {
    var index = 0
    while index < information.declared_functions.count() {
        var declared = information.declared_functions[index]
        if walked_from_source(declared) and not declared.c_name.is_empty() {
            declared_function_names[declared.c_name] = true
        }
        index = index + 1
    }
}

func build_class(information: Analysis.ClassInfo) {
    var index = 0
    while index < information.declared_functions.count() {
        var declared = information.declared_functions[index]
        if walked_from_source(declared) {
            var walk = HighWalk(this, information, declared)
            assert walk.recorded
            walked_functions.append(walk.recorded)
        }
        index = index + 1
    }
}

func walked_from_source(declared: Analysis.FunctionInfo): Boolean {
    if not declared.has_body or not declared.supplied_body.is_empty() or not declared.symbol_name.is_empty() {
        return false
    }
    if not declared.specialised_from.is_empty() or declared.c_name.is_empty() {
        return false
    }
    return true
}

func class_named(qualified: String): Analysis.ClassInfo? {
    var found: Analysis.ClassInfo? = null
    if classes_by_qualified.has(qualified) {
        found = classes_by_qualified[qualified]
    }
    return found
}

# ../intermediate/README.md#c-written-from-the-high-level
func prepare() {
    if not prepared {
        note_classes()
        prepared = true
    }
}

func class_with_c_name(c_name: String): Analysis.ClassInfo? {
    return classes_by_c_name[c_name]
}

# ../intermediate/README.md#abstract-objects
func class_of_type(given: Analysis.SpiteType?): Analysis.ClassInfo? {
    var found: Analysis.ClassInfo? = null
    crash generator
    var plain = plain_type_of(given)
    if plain {
        found = generator.class_of_type(plain)
    }
    return found
}

func plain_type_of(given: Analysis.SpiteType?): Analysis.SpiteType? {
    var plain = given
    if plain {
        var nullable = types.as_nullable(plain)
        if nullable {
            plain = nullable.inner
        }
    }
    return plain
}

func is_reference_type(given: Analysis.SpiteType?): Boolean {
    var answered = false
    crash generator
    var plain = plain_type_of(given)
    if plain {
        answered = generator.type_is_reference(plain)
    }
    return answered
}

func class_found(name: String, namespace: String): Analysis.ClassInfo? {
    var segments = namespace.split(".")
    while not segments.is_empty() {
        var inside_namespace = segments.join(".")
        var inside = classes_by_qualified["{inside_namespace}.{name}"]
        if inside {
            return inside
        }
        segments.remove_last()
    }
    var found = classes_by_qualified[name]
    assert found
    return found
}

func new_object(class_name: String, kind: String, made_at: String, through_field: Boolean): HighObject {
    var made = HighObject()
    made.number = objects.count()
    made.class_name = class_name
    made.kind = kind
    made.place = made_at
    made.through_field = through_field
    objects.append(made)
    if kind == "made" {
        classes_made[class_name] = true
    }
    return made
}

# ../intermediate/README.md#abstract-objects
func items_object_of(list_number: Integer, element_class: String): Integer {
    var key = "items of {list_number}"
    var known: Integer? = null
    if item_objects.has(key) {
        known = item_objects[key]
    }
    if known {
        return known
    }
    var made = new_object(element_class, "items", "the items of object {list_number}", false)
    made.container_of = list_number
    item_objects[key] = made.number
    return made.number
}

func object_at(number: Integer): HighObject? {
    assert number >= 0 and number < objects.count()
    return objects[number]
}

func object_at_or_none(number: Integer): HighObject? {
    var found: HighObject? = null
    if number >= 0 and number < objects.count() {
        found = objects[number]
    }
    return found
}

# ../intermediate/README.md#what-the-comparison-checks
func declares_function(c_name: String): Boolean {
    return declared_function_names.has(c_name)
}

func walked_function_with_c_name(c_name: String): HighFunction? {
    var found: HighFunction? = null
    if walked_by_c_name.has(c_name) {
        found = walked_by_c_name[c_name]
    }
    return found
}

# ../intermediate/README.md#what-a-band-site-needs
func ensure_walked(c_name: String): HighFunction? {
    var built: HighFunction? = null
    var found = walked_function_with_c_name(c_name)
    if found {
        built = found
    } else {
        var declared = declared_with_c_name(c_name)
        var with_body = with_a_body(declared)
        var information: Analysis.ClassInfo? = null
        if with_body {
            information = class_of_function(with_body)
        }
        if with_body {
            crash information
            var walk = HighWalk(this, information, with_body)
            crash walk.recorded
            walk.recorded.fold_facts()
            decide_coverage(walk.recorded)
            walked_by_c_name[c_name] = walk.recorded
            built = walk.recorded
        }
    }
    return built
}

func with_a_body(declared: Analysis.FunctionInfo?): Analysis.FunctionInfo? {
    var with_body: Analysis.FunctionInfo? = null
    var current = declared
    while current {
        if not current.body.is_empty() {
            with_body = current
        }
        current = original_of(current)
    }
    return with_body
}

func declared_with_c_name(c_name: String): Analysis.FunctionInfo? {
    var found: Analysis.FunctionInfo? = null
    var known_classes = program_classes()
    var index = 0
    while index < known_classes.count() {
        var known = known_classes[index]
        var position = 0
        while position < known.declared_functions.count() {
            var declared = known.declared_functions[position]
            if declared.c_name == c_name {
                found = declared
            }
            position = position + 1
        }
        index = index + 1
    }
    return found
}

func original_of(declared: Analysis.FunctionInfo): Analysis.FunctionInfo? {
    var from: Analysis.FunctionInfo? = null
    if not declared.specialised_from.is_empty() {
        from = declared_with_c_name(declared.specialised_from)
    }
    return from
}

func class_of_function(declared: Analysis.FunctionInfo): Analysis.ClassInfo? {
    var found: Analysis.ClassInfo? = null
    var known_classes = program_classes()
    var index = 0
    while index < known_classes.count() {
        var known = known_classes[index]
        var position = 0
        while position < known.declared_functions.count() {
            if known.declared_functions[position] == declared {
                found = known
            }
            position = position + 1
        }
        index = index + 1
    }
    return found
}

func class_c_name(qualified: String): String {
    var found = classes_by_qualified[qualified]
    if not found {
        return qualified
    }
    return found.c_name
}

# ../intermediate/README.md#what-the-comparison-checks
func decide_coverage(function: HighFunction) {
    function.covered = true
    if function.fact.unknown_operations > 0 {
        function.covered = false
        function.note_reason("an operation of unknown effect: {function.fact.first_unknown_reason}")
        return
    }
    if function.makes_object {
        function.covered = false
        function.note_reason(
            "it makes an object, and the call the C writes for a construction is the generator's decision",
        )
        return
    }
    if function.walks_a_list {
        function.covered = false
        function.note_reason("a list walk is a call to a template this walk does not name")
        return
    }
    if function.touches_a_container {
        function.covered = false
        function.note_reason("the key of a container's items is not built yet")
        return
    }
    if function.touches_a_field_owner {
        function.covered = false
        function.note_reason("an object reached through a field may carry an owner tag this walk does not compute yet")
        return
    }
    if function.names_an_unmade_class {
        function.covered = false
        function.note_reason("a class the program never makes, whose fields the C reader leaves out")
        return
    }
}
