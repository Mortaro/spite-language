# ../../../design/backend_high_level_ir.md#functions-blocks-and-operations
var kind = ""
var reads = List<Integer>()
var writes = List<Integer>()
var call_name = ""
var reads_only = false
var per_item = false
var passed = List<Integer>()
var loop_kind = ""
var loop_condition = -1
var loop_body = -1
var can_end = false
var answers = ""
var returned_value = -1
var unknown_reason = ""
var line = 0
var result = -1
var operands = List<Integer>()
var operator = ""
var literal = ""
var condition_text = ""
var syntax: Syntax.Expressions.BinaryExpression? = null

func HighOperation(starting_kind: String, starting_line: Integer) {
    kind = starting_kind
    line = starting_line
}

func reads_value(value_number: Integer) {
    note_once(reads, value_number)
}

func writes_value(value_number: Integer) {
    note_once(writes, value_number)
}

func note_once(given: List<Integer>, value_number: Integer) {
    if value_number >= 0 and not given.contains(value_number) {
        given.append(value_number)
    }
}

func takes(value_number: Integer) {
    operands.append(value_number)
}

func passes_object(object_number: Integer) {
    if not passed.contains(object_number) {
        passed.append(object_number)
    }
}
