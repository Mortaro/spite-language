# ../../../../design/backend_x86_64_encoding.md#the-instructions
var bytes = Buffer(0)
var start = 0

func Encoder(starting_address: Integer) {
    start = starting_address
}

func clear() {
    bytes = Buffer(0)
}

func next_address(): Integer {
    return start + bytes.count()
}

func append_one_byte_number(given: Long) {
    var narrowed: Tiny = given
    var unsigned = narrowed.bits_as_unsigned()
    bytes.append(unsigned)
}

func append_four_byte_number(given: Long) {
    var narrowed: Integer = given
    var unsigned = narrowed.bits_as_unsigned()
    bytes.append_unsigned_integer_little_endian(unsigned)
}

func append_eight_byte_number(given: Long) {
    bytes.append_long_little_endian(given)
}

# ../../../../design/backend_x86_64_encoding.md#the-place-form
func append_the_modrm(how_far: Integer, register_field: Integer, addressed_field: Integer) {
    bytes.append(how_far * 64 + register_field * 8 + addressed_field)
}

func append_the_displacement(how_far: Integer, given: Long) {
    if how_far == 1 {
        append_one_byte_number(given)
        return
    }
    if how_far == 2 {
        append_four_byte_number(given)
    }
}

func append_the_modrm_and_place(register_field: Integer, place: Place) {
    crash place.scale == 1 or place.scale == 2 or place.scale == 4 or place.scale == 8
    var scale_of_the_index = 0
    if place.scale == 2 {
        scale_of_the_index = 1
    } else if place.scale == 4 {
        scale_of_the_index = 2
    } else if place.scale == 8 {
        scale_of_the_index = 3
    }
    if place.from_instruction_pointer {
        crash not place.index
        append_the_modrm(0, register_field, 5)
        append_four_byte_number(place.displacement)
        return
    }
    var given_index = place.index_number()
    if given_index == 4 {
        crash not place.index
    }
    var given_base = place.base_number()
    if not place.index and not place.base {
        append_the_modrm(0, register_field, 4)
        bytes.append(scale_of_the_index * 64 + given_index % 8 * 8 + given_base % 8)
        append_four_byte_number(place.displacement)
        return
    }
    var how_far = 0
    if place.displacement != 0 or given_base == 5 {
        how_far = 1
    }
    if how_far == 1 and (place.displacement < -128 or place.displacement > 127) {
        how_far = 2
    }
    var holds_an_index = false
    if place.index {
        holds_an_index = true
    }
    if given_base == 4 or given_base == 12 {
        holds_an_index = true
    }
    if not place.base {
        holds_an_index = true
    }
    if holds_an_index {
        append_the_modrm(how_far, register_field, 4)
        bytes.append(scale_of_the_index * 64 + given_index % 8 * 8 + given_base % 8)
    } else {
        append_the_modrm(how_far, register_field, given_base)
    }
    append_the_displacement(how_far, place.displacement)
}

# ../../../../design/backend_x86_64_encoding.md#the-extension-prefix
func extension_of_wide(wide: Boolean): Integer {
    if wide {
        return 8
    }
    return 0
}

func extension_of_the_reg_field(register: Integer): Integer {
    if register >= 8 {
        return 4
    }
    return 0
}

func extension_of_the_addressed_field(register: Integer): Integer {
    if register >= 8 {
        return 1
    }
    return 0
}

func extension_of_the_index_field(register: Integer): Integer {
    if register >= 8 {
        return 2
    }
    return 0
}

func extension_of_the_place(place: Place): Integer {
    var given_base = place.base_number()
    var given_index = place.index_number()
    var extension = extension_of_the_addressed_field(given_base)
    return extension + extension_of_the_index_field(given_index)
}

func append_the_extension_prefix(extension: Integer) {
    if extension > 0 {
        bytes.append(64 + extension)
    }
}

func extension_for_two_whole_registers(wide: Boolean, register: Register, addressed: Register): Integer {
    crash register.number <= 7
    crash addressed.number <= 7
    return extension_of_wide(wide)
}

func extension_for_a_whole_register_and_place(wide: Boolean, register: Register, place: Place): Integer {
    crash register.kind == 'general_register'
    crash register.number <= 7
    return extension_of_wide(wide) + extension_of_the_place(place)
}

func extension_for_two_floating_registers(register: Register, addressed: Register): Integer {
    crash register.kind == 'floating_register'
    crash addressed.kind == 'floating_register'
    var extension = extension_of_the_reg_field(register.number)
    return extension + extension_of_the_addressed_field(addressed.number)
}

func extension_for_a_floating_register_and_place(register: Register, place: Place): Integer {
    crash register.kind == 'floating_register'
    var extension = extension_of_the_reg_field(register.number)
    return extension + extension_of_the_place(place)
}

# ../../../../design/backend_x86_64_encoding.md#the-instruction-forms
func write_the_register_form(wide: Boolean, opcode: Integer, register: Register, addressed: Register) {
    var extension = extension_for_two_whole_registers(wide, register, addressed)
    append_the_extension_prefix(extension)
    bytes.append(opcode)
    append_the_modrm(3, register.number, addressed.number)
}

func write_the_place_form(wide: Boolean, opcode: Integer, register: Register, place: Place) {
    var extension = extension_for_a_whole_register_and_place(wide, register, place)
    append_the_extension_prefix(extension)
    bytes.append(opcode)
    append_the_modrm_and_place(register.number, place)
}

func write_the_floating_register_form(prefix: Integer, opcode: Integer, register: Register, addressed: Register) {
    var extension = extension_for_two_floating_registers(register, addressed)
    append_the_extension_prefix(extension)
    if prefix != 0 {
        bytes.append(prefix)
    }
    bytes.append(15)
    bytes.append(opcode)
    append_the_modrm(3, register.number, addressed.number)
}

func write_the_floating_place_form(prefix: Integer, opcode: Integer, register: Register, place: Place) {
    var extension = extension_for_a_floating_register_and_place(register, place)
    append_the_extension_prefix(extension)
    if prefix != 0 {
        bytes.append(prefix)
    }
    bytes.append(15)
    bytes.append(opcode)
    append_the_modrm_and_place(register.number, place)
}

func write_an_immediate_into_a_register(wide: Boolean, digit: Integer, addressed: Register, given: Long) {
    crash addressed.kind == 'general_register'
    crash given >= -2147483648 and given <= 2147483647
    var extension = extension_of_wide(wide) + extension_of_the_addressed_field(addressed.number)
    if given >= -128 and given <= 127 {
        append_the_extension_prefix(extension)
        bytes.append(131)
        append_the_modrm(3, digit, addressed.number)
        append_one_byte_number(given)
        return
    }
    append_the_extension_prefix(extension)
    bytes.append(129)
    append_the_modrm(3, digit, addressed.number)
    append_four_byte_number(given)
}

func write_an_immediate_into_a_place(wide: Boolean, digit: Integer, place: Place, given: Long) {
    crash given >= -2147483648 and given <= 2147483647
    var extension = extension_of_wide(wide) + extension_of_the_place(place)
    if given >= -128 and given <= 127 {
        append_the_extension_prefix(extension)
        bytes.append(131)
        append_the_modrm_and_place(digit, place)
        append_one_byte_number(given)
        return
    }
    append_the_extension_prefix(extension)
    bytes.append(129)
    append_the_modrm_and_place(digit, place)
    append_four_byte_number(given)
}

func place_width_agrees(place: Place, bits: Integer): Boolean {
    return place.bits == 0 or place.bits == bits
}

# ../../../../design/backend_x86_64_encoding.md#moving
func move(destination: Destination, source: Source) {
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash destination.bits == source.bits
                    write_the_register_form(destination.bits == 64, 137, source, destination)
                }
                Immediate: move_a_register_from_an_immediate(destination, source)
                Place: {
                    crash place_width_agrees(source, destination.bits)
                    write_the_place_form(destination.bits == 64, 139, destination, source)
                }
            }
        }
        Place: move_into_a_place(destination, source)
    }
}

func move_a_register_from_an_immediate(destination: Register, source: Immediate) {
    var low = extension_of_the_addressed_field(destination.number)
    if destination.bits == 32 {
        crash source.value >= -2147483648 and source.value <= 2147483647
        append_the_extension_prefix(low)
        bytes.append(184 + destination.number)
        append_four_byte_number(source.value)
        return
    }
    if source.value >= -2147483648 and source.value <= 2147483647 {
        append_the_extension_prefix(8 + low)
        bytes.append(199)
        append_the_modrm(3, 0, destination.number)
        append_four_byte_number(source.value)
        return
    }
    append_the_extension_prefix(8 + low)
    bytes.append(184 + destination.number)
    append_eight_byte_number(source.value)
}

func move_into_a_place(destination: Place, source: Source) {
    switch source {
        Register: {
            crash source.kind == 'general_register'
            crash place_width_agrees(destination, source.bits)
            write_the_place_form(source.bits == 64, 137, source, destination)
        }
        Immediate: {
            crash destination.bits == 32 or destination.bits == 64
            crash source.value >= -2147483648 and source.value <= 2147483647
            var wide = destination.bits == 64
            var extension = extension_of_wide(wide) + extension_of_the_place(destination)
            append_the_extension_prefix(extension)
            bytes.append(199)
            append_the_modrm_and_place(0, destination)
            append_four_byte_number(source.value)
        }
        Place: crash source.kind != 'memory'
    }
}

# ../../../../design/backend_x86_64_encoding.md#adding
func add(destination: Destination, source: Source) {
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash destination.bits == source.bits
                    write_the_register_form(destination.bits == 64, 1, source, destination)
                }
                Immediate: write_an_immediate_into_a_register(destination.bits == 64, 0, destination, source.value)
                Place: {
                    crash place_width_agrees(source, destination.bits)
                    write_the_place_form(destination.bits == 64, 3, destination, source)
                }
            }
        }
        Place: {
            crash source.kind != 'memory'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash place_width_agrees(destination, source.bits)
                    write_the_place_form(source.bits == 64, 1, source, destination)
                }
                Immediate: {
                    crash destination.bits == 32 or destination.bits == 64
                    write_an_immediate_into_a_place(destination.bits == 64, 0, destination, source.value)
                }
                Place: crash source.kind == 'memory'
            }
        }
    }
}

