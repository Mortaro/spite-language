# ../../../../design/backend_x86_64_encoding.md#multiplying
func multiply_signed(destination: Destination, source: Source) {
    crash source.kind != 'immediate'
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash destination.bits == source.bits
                    write_the_multiply_into_a_register(destination.bits == 64, destination, source)
                }
                Place: {
                    crash place_width_agrees(source, destination.bits)
                    write_the_multiply_into_a_place(destination.bits == 64, destination, source)
                }
                Immediate: crash source.kind == 'immediate'
            }
        }
        Place: crash destination.kind != 'memory'
    }
}

func write_the_multiply_into_a_register(wide: Boolean, destination: Register, source: Register) {
    var extension = extension_for_two_whole_registers(wide, destination, source)
    append_the_extension_prefix(extension)
    bytes.append(15)
    bytes.append(175)
    append_the_modrm(3, destination.number, source.number)
}

func write_the_multiply_into_a_place(wide: Boolean, destination: Register, source: Place) {
    var extension = extension_for_a_whole_register_and_place(wide, destination, source)
    append_the_extension_prefix(extension)
    bytes.append(15)
    bytes.append(175)
    append_the_modrm_and_place(destination.number, source)
}

func multiply_signed_by(destination: Destination, left: Source, factor: Immediate) {
    crash factor.value >= -2147483648 and factor.value <= 2147483647
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            switch left {
                Register: {
                    crash left.kind == 'general_register'
                    crash destination.bits == left.bits
                    write_the_multiply_by(destination.bits == 64, 107, destination, left, factor.value)
                }
                Place: {
                    crash place_width_agrees(left, destination.bits)
                    write_the_multiply_by(destination.bits == 64, 107, destination, left, factor.value)
                }
                Immediate: crash left.kind == 'immediate'
            }
        }
        Place: crash destination.kind != 'memory'
    }
}

func write_the_multiply_by(wide: Boolean, small_opcode: Integer, destination: Register, left: Source, given: Long) {
    if given >= -128 and given <= 127 {
        write_the_multiply_by_form(wide, small_opcode, destination, left)
        append_one_byte_number(given)
        return
    }
    write_the_multiply_by_form(wide, 105, destination, left)
    append_four_byte_number(given)
}

func write_the_multiply_by_form(wide: Boolean, opcode: Integer, destination: Register, left: Source) {
    var extension = extension_of_wide(wide) + extension_of_the_reg_field(destination.number)
    switch left {
        Register: {
            append_the_extension_prefix(extension)
            bytes.append(opcode)
            append_the_modrm(3, destination.number, left.number)
        }
        Place: {
            var more = extension_of_the_place(left)
            append_the_extension_prefix(extension + more)
            bytes.append(opcode)
            append_the_modrm_and_place(destination.number, left)
        }
        Immediate: crash left.kind != 'immediate'
    }
}

# ../../../../design/backend_x86_64_encoding.md#dividing
func divide_signed(divisor: Source) {
    crash divisor.kind != 'immediate'
    switch divisor {
        Register: {
            crash divisor.kind == 'general_register'
            var wide = extension_of_wide(divisor.bits == 64)
            var low = extension_of_the_addressed_field(divisor.number)
            append_the_extension_prefix(wide + low)
            bytes.append(247)
            append_the_modrm(3, 7, divisor.number)
        }
        Place: {
            crash divisor.bits == 32 or divisor.bits == 64
            var wide = extension_of_wide(divisor.bits == 64)
            var more = extension_of_the_place(divisor)
            append_the_extension_prefix(wide + more)
            bytes.append(247)
            append_the_modrm_and_place(7, divisor)
        }
        Immediate: crash divisor.kind == 'immediate'
    }
}

# ../../../../design/backend_x86_64_encoding.md#jumping
func condition_code(condition: Condition): Integer {
    switch condition {
        'overflow': return 0
        'no_overflow': return 1
        'below': return 2
        'above_or_equal': return 3
        'equal': return 4
        'not_equal': return 5
        'below_or_equal': return 6
        'above': return 7
        'signed': return 8
        'not_signed': return 9
        'even_parity': return 10
        'odd_parity': return 11
        'less': return 12
        'greater_or_equal': return 13
        'less_or_equal': return 14
        'greater': return 15
    }
}

func fits_in_one_byte(given: Integer): Boolean {
    return given >= -128 and given <= 127
}

func jump_to(given: Integer) {
    var after_the_short = next_address() + 2
    if fits_in_one_byte(given - after_the_short) {
        var near_by = given - after_the_short
        bytes.append(235)
        append_one_byte_number(near_by)
        return
    }
    var after_the_long = next_address() + 5
    var far_on = given - after_the_long
    bytes.append(233)
    append_four_byte_number(far_on)
}

func jump_through(source: Source) {
    switch source {
        Register: {
            crash source.kind == 'general_register'
            crash source.number <= 7
            bytes.append(255)
            append_the_modrm(3, 4, source.number)
        }
        Place: {
            var extension = extension_of_the_place(source)
            append_the_extension_prefix(extension)
            bytes.append(255)
            append_the_modrm_and_place(4, source)
        }
        Immediate: crash source.kind != 'immediate'
    }
}

func jump_if(condition: Condition, given: Integer) {
    var code = condition_code(condition)
    var after_the_short = next_address() + 2
    if fits_in_one_byte(given - after_the_short) {
        var near_by = given - after_the_short
        bytes.append(112 + code)
        append_one_byte_number(near_by)
        return
    }
    var after_the_long = next_address() + 6
    var far_on = given - after_the_long
    bytes.append(15)
    bytes.append(128 + code)
    append_four_byte_number(far_on)
}

# ../../../../design/backend_x86_64_encoding.md#calling
func call_to(given: Integer) {
    var far_on = given - (next_address() + 5)
    bytes.append(232)
    append_four_byte_number(far_on)
}

func call_through(source: Source) {
    switch source {
        Register: {
            crash source.kind == 'general_register'
            crash source.number <= 7
            bytes.append(255)
            append_the_modrm(3, 2, source.number)
        }
        Place: {
            var extension = extension_of_the_place(source)
            append_the_extension_prefix(extension)
            bytes.append(255)
            append_the_modrm_and_place(2, source)
        }
        Immediate: crash source.kind != 'immediate'
    }
}

func return_to_caller() {
    bytes.append(195)
}

func illegal_instruction() {
    bytes.append(15)
    bytes.append(11)
}

# ../../../../design/backend_x86_64_encoding.md#pushing-and-popping
func push(source: Source) {
    switch source {
        Register: {
            crash source.kind == 'general_register'
            crash source.bits == 64
            var extension = extension_of_the_addressed_field(source.number)
            append_the_extension_prefix(extension)
            bytes.append(80 + source.number)
        }
        Place: {
            var extension = extension_of_the_place(source)
            append_the_extension_prefix(extension)
            bytes.append(255)
            append_the_modrm_and_place(6, source)
        }
        Immediate: {
            crash source.value >= -2147483648 and source.value <= 2147483647
            if source.value >= -128 and source.value <= 127 {
                bytes.append(106)
                append_one_byte_number(source.value)
                return
            }
            bytes.append(104)
            append_four_byte_number(source.value)
        }
    }
}

func pop(destination: Destination) {
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            crash destination.bits == 64
            var extension = extension_of_the_addressed_field(destination.number)
            append_the_extension_prefix(extension)
            bytes.append(88 + destination.number)
        }
        Place: {
            var extension = extension_of_the_place(destination)
            append_the_extension_prefix(extension)
            bytes.append(143)
            append_the_modrm_and_place(0, destination)
        }
    }
}

# ../../../../design/backend_x86_64_encoding.md#taking-an-address
func take_address_of(destination: Destination, source: Source) {
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            crash source.kind == 'memory'
            switch source {
                Place: write_the_place_form(destination.bits == 64, 141, destination, source)
                Register: crash source.kind != 'general_register'
                Immediate: crash source.kind != 'immediate'
            }
        }
        Place: crash destination.kind != 'memory'
    }
}

# ../../../../design/backend_x86_64_encoding.md#the-floating-point-moves
func move_float(destination: Destination, source: Source) {
    move_a_floating_value(destination, source, 243, 32)
}

func move_double(destination: Destination, source: Source) {
    move_a_floating_value(destination, source, 242, 64)
}

func move_a_floating_value(destination: Destination, source: Source, prefix: Integer, bits: Integer) {
    crash source.kind != 'immediate'
    switch destination {
        Register: {
            crash destination.kind == 'floating_register'
            switch source {
                Register: {
                    crash source.kind == 'floating_register'
                    write_the_floating_register_form(prefix, 16, destination, source)
                }
                Place: {
                    crash place_width_agrees(source, bits)
                    write_the_floating_place_form(prefix, 16, destination, source)
                }
                Immediate: crash source.kind == 'immediate'
            }
        }
        Place: {
            crash source.kind == 'floating_register'
            crash place_width_agrees(destination, bits)
            switch source {
                Register: write_the_floating_place_form(prefix, 17, source, destination)
                Immediate: crash source.kind == 'immediate'
                Place: crash source.kind != 'memory'
            }
        }
    }
}

# ../../../../design/backend_x86_64_encoding.md#the-floating-point-arithmetic
func add_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 88, 32)
}

func add_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 88, 64)
}

func subtract_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 92, 32)
}

func subtract_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 92, 64)
}

func multiply_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 89, 32)
}

func multiply_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 89, 64)
}

func divide_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 94, 32)
}

func divide_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 94, 64)
}

func minimum_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 93, 32)
}

func minimum_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 93, 64)
}

func maximum_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 95, 32)
}

func maximum_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 95, 64)
}

func compare_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 0, 47, 32)
}

func compare_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 102, 47, 64)
}

func square_root_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 81, 32)
}

func square_root_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 81, 64)
}

func convert_float_to_double(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 243, 90, 32)
}

func convert_double_to_float(destination: Destination, source: Source) {
    write_the_floating_arithmetic(destination, source, 242, 90, 64)
}

func write_the_floating_arithmetic(
    destination: Destination,
    source: Source,
    prefix: Integer,
    opcode: Integer,
    bits: Integer,
) {
    crash destination.kind == 'floating_register'
    crash source.kind != 'immediate'
    switch destination {
        Register: {
            crash destination.kind == 'floating_register'
            switch source {
                Register: {
                    crash source.kind == 'floating_register'
                    write_the_floating_register_form(prefix, opcode, destination, source)
                }
                Place: {
                    crash place_width_agrees(source, bits)
                    write_the_floating_place_form(prefix, opcode, destination, source)
                }
                Immediate: crash source.kind != 'immediate'
            }
        }
        Place: crash destination.kind != 'memory'
    }
}
