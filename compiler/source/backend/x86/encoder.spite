func subtract(destination: Destination, source: Source) {
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash destination.bits == source.bits
                    write_the_register_form(destination.bits == 64, 41, source, destination)
                }
                Immediate: write_an_immediate_into_a_register(destination.bits == 64, 5, destination, source.value)
                Place: {
                    crash place_width_agrees(source, destination.bits)
                    write_the_place_form(destination.bits == 64, 43, destination, source)
                }
            }
        }
        Place: {
            crash source.kind != 'memory'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash place_width_agrees(destination, source.bits)
                    write_the_place_form(source.bits == 64, 41, source, destination)
                }
                Immediate: {
                    crash destination.bits == 32 or destination.bits == 64
                    write_an_immediate_into_a_place(destination.bits == 64, 5, destination, source.value)
                }
                Place: crash source.kind == 'memory'
            }
        }
    }
}

# ../../../../design/backend_x86_64_encoding.md#comparing
func compare(destination: Destination, source: Source) {
    switch destination {
        Register: {
            crash destination.kind == 'general_register'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash destination.bits == source.bits
                    write_the_register_form(destination.bits == 64, 57, source, destination)
                }
                Immediate: write_an_immediate_into_a_register(destination.bits == 64, 7, destination, source.value)
                Place: {
                    crash place_width_agrees(source, destination.bits)
                    write_the_place_form(destination.bits == 64, 59, destination, source)
                }
            }
        }
        Place: {
            crash source.kind != 'memory'
            switch source {
                Register: {
                    crash source.kind == 'general_register'
                    crash place_width_agrees(destination, source.bits)
                    write_the_place_form(source.bits == 64, 57, source, destination)
                }
                Immediate: {
                    crash destination.bits == 32 or destination.bits == 64
                    write_an_immediate_into_a_place(destination.bits == 64, 7, destination, source.value)
                }
                Place: crash source.kind == 'memory'
            }
