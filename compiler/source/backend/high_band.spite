# ../intermediate/README.md#what-a-band-site-needs
var program: HighProgram? = null
var visited = Dictionary<String, Boolean>()
var item_writes = List<String>()
var other_writes = List<String>()
var other_touches = List<String>()
var cannot_say = ""
var reached = 0

func HighBand(starting_program: HighProgram) {
    program = starting_program
}

func answer_for(member_c_name: String): Boolean {
    crash program
    var function = function_named(member_c_name)
    if not function {
        cannot_say = "it calls '{member_c_name}', which the walk cannot build"
        return false
    }
    var items = List<Integer>()
    items.append(function.receiver_object)
    visit(function, items)
    return knows() and other_writes.is_empty() and not touched_elsewhere()
}

func knows(): Boolean {
    return cannot_say.is_empty()
}

func function_named(c_name: String): HighFunction? {
    crash program
    var found = program.walked_function_with_c_name(c_name)
    if not found {
        found = program.ensure_walked(c_name)
    }
    return found
}

func visit(function: HighFunction, items: List<Integer>) {
    var mask = items_mask(function, items)
    var key = "{function.c_name}|{mask}"
    assert not visited.has(key)
    visited[key] = true
    reached = reached + 1
    if function.fact.unknown_operations > 0 {
        note_cannot_say(
            "it reaches '{function.c_name}', where the walk did not build {function.fact.first_unknown_reason}",
        )
        return
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.operations.count() {
            var operation = block.operations[index]
            visit_operation(function, items, operation)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func items_mask(function: HighFunction, items: List<Integer>): String {
    var mask = ""
    if items.contains(function.receiver_object) {
        mask = "r"
    }
    var index = 0
    while index < function.parameter_objects.count() {
        var parameter = function.parameter_objects[index]
        if items.contains(parameter) {
            mask = "{mask}{index},"
        }
        index = index + 1
    }
    return mask
}

func visit_operation(function: HighFunction, items: List<Integer>, operation: HighOperation) {
    if operation.kind == "call" and not operation.call_name.is_empty() {
        visit_call(function, items, operation)
        return
    }
    if operation.kind == "make" {
        note_cannot_say("it makes an object in '{function.c_name}', whose writes this question does not follow yet")
        return
    }
    var index = 0
    while index < operation.writes.count() {
        note_value(function, items, operation.writes[index], true)
        index = index + 1
    }
    index = 0
    while index < operation.reads.count() {
        note_value(function, items, operation.reads[index], false)
        index = index + 1
    }
}

func note_value(function: HighFunction, items: List<Integer>, value_number: Integer, written: Boolean) {
    var value = function.value_at(value_number)
    assert value.is_of_an_object()
    var held_by = class_of_object(value.owner)
    var where = "{held_by}#{value.name}"
    if items.contains(value.owner) {
        if written and not item_writes.contains(where) {
            item_writes.append(where)
        }
        return
    }
    if written and not other_writes.contains(where) {
        other_writes.append(where)
    }
    if not other_touches.contains(where) {
        other_touches.append(where)
    }
}

func class_of_object(object_number: Integer): String {
    crash program
    var object = program.object_at_or_none(object_number)
    var named = "?"
    if object {
        named = object.class_name
    }
    return named
}

func visit_call(function: HighFunction, items: List<Integer>, operation: HighOperation) {
    var callee = function_named(operation.call_name)
    if not callee {
        note_cannot_say("it calls '{operation.call_name}', which the walk cannot build")
        return
    }
    var passed = List<Integer>()
    var position = 0
    while position < operation.operands.count() {
        var object_number = object_of_operand(function, operation, position)
        if object_number >= 0 and items.contains(object_number) {
            if position == 0 {
                passed.append(callee.receiver_object)
            } else if position - 1 < callee.parameter_objects.count() {
                var parameter = callee.parameter_objects[position - 1]
                passed.append(parameter)
            }
        }
        position = position + 1
    }
    visit(callee, passed)
}

# ../intermediate/README.md#what-a-band-site-needs
func object_of_operand(function: HighFunction, operation: HighOperation, position: Integer): Integer {
    var operand = operation.operands[position]
    crash operand
    if position == 0 and operand < 0 and not operation.per_item {
        return function.receiver_object
    }
    if operand < 0 {
        return -1
    }
    return function.value_at(operand).points_at
}

func note_cannot_say(why: String) {
    if cannot_say.is_empty() {
        cannot_say = why
    }
}

func touched_elsewhere(): Boolean {
    var index = 0
    while index < item_writes.count() {
        if other_touches.contains(item_writes[index]) {
            return true
        }
        index = index + 1
    }
    return false
}

func answer_text(): String {
    var others = other_writes.join(" ")
    var mine = item_writes.join(" ")
    return "writes its item's {mine}; writes elsewhere {others}; over {reached} functions"
}
