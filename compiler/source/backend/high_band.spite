# ../../../design/backend_high_level_ir.md#what-a-band-site-needs
var program: HighProgram? = null
var writes_an_item = 0
var writes_anything_else = 0
var reaches_unknown = false
var reached_names = List<String>()
var writes_nothing = Dictionary<String, Boolean>()
var keys = List<String>()

func HighBand(starting_program: HighProgram) {
    program = starting_program
}

func answer_for(c_name: String): Boolean {
    crash program
    reset()
    note_read_only_calls()
    var reached = Dictionary<String, Boolean>()
    reached[c_name] = true
    var waiting = List<String>()
    waiting.append(c_name)
    while not waiting.is_empty() {
        var name = waiting.remove_last()
        crash name
        var function = program.walked_function_with_c_name(name)
        if function {
            note_writes_of(function)
            var index = 0
            while index < function.fact.calls.count() {
                var called = function.fact.calls[index]
                if not reached.has(called) {
                    reached[called] = true
                    waiting.append(called)
                }
                index = index + 1
            }
        } else {
            reaches_unknown = true
            reached_names.append(name)
        }
    }
    return writes_anything_else == 0
}

func reset() {
    writes_an_item = 0
    writes_anything_else = 0
    reaches_unknown = false
    reached_names = List<String>()
    writes_nothing = Dictionary<String, Boolean>()
    keys = List<String>()
}

func note_read_only_calls() {
    crash program
    var index = 0
    while index < program.walked_functions.count() {
        var read_only = program.walked_functions[index].fact.read_only_calls
        var position = 0
        while position < read_only.count() {
            var name = read_only[position]
            writes_nothing[name] = true
            position = position + 1
        }
        index = index + 1
    }
}

func cannot_say_because(): String {
    crash reached_names.count() > 0
    var name = reached_names[0]
    var why = "it reaches '{name}', which the walk did not build, so what that call writes is not known"
    if writes_nothing.has(name) {
        why = "it reaches '{name}', a container's own function that only reads, whose own writes the walk does not see"
    }
    return why
}

func note_writes_of(function: HighFunction) {
    function.fact.writes.keys().each(note_write)
}

func note_write(key: String) {
    var object = object_of_key(key)
    var kind = ""
    if object {
        kind = object.kind
    }
    if not object {
        reaches_unknown = true
    } else if kind == "items" {
        writes_an_item = writes_an_item + 1
        keys.append("s:{key}")
    } else {
        writes_anything_else = writes_anything_else + 1
        keys.append("f:{key}")
    }
}

func object_of_key(key: String): HighObject? {
    assert program
    var found: HighObject? = null
    var mark = key.index_of("#")
    if mark >= 0 {
        var asked = key.slice(0, mark).to_integer()
        crash asked
        found = program.object_at_or_none(asked)
    }
    return found
}

func only_items_text(): String {
    return "writes {writes_an_item} item fields and {writes_anything_else} other fields, {reaches_unknown} it cannot reach"
}
