# ../../../design/backend_high_level_ir.md#abstract-objects
var number = 0
var class_name = ""
var kind = ""
var place = ""
var through_field = false
var container_of = -1
var fields_read = List<String>()
var fields_written = List<String>()

func reads(field_name: String) {
    if not fields_read.contains(field_name) {
        fields_read.append(field_name)
    }
}

func writes(field_name: String) {
    if not fields_written.contains(field_name) {
        fields_written.append(field_name)
    }
}

func is_read(field_name: String): Boolean {
    return fields_read.contains(field_name)
}

func is_written(field_name: String): Boolean {
    return fields_written.contains(field_name)
}

func tells_where(): String {
    return "{class_name} ({kind}) made at {place}"
}
