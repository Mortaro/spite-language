# ../../../design/backend_high_level_ir.md#what-a-function-surely-wrote
var before_blocks = List<List<String>>()
var after_blocks = List<List<String>>()
var predecessors = List<List<Integer>>()
var field_names = Dictionary<String, String>()
var must_write_true = List<String>()
var must_write_false = List<String>()
var must_write_any = List<String>()
var may_write = List<String>()
var answered_true = 0
var answered_false = 0
var answered_other = 0

func summarise(function: HighFunction) {
    may_write = every_key(function)
    note_predecessors(function)
    start_full(function)
    settle(function)
    collect_answers(function)
}

func note_predecessors(function: HighFunction) {
    var index = 0
    while index < function.blocks.count() {
        var coming_from = List<Integer>()
        predecessors.append(coming_from)
        index = index + 1
    }
    index = 0
    while index < function.blocks.count() {
        var block = function.blocks[index]
        var position = 0
        while position < block.edges.count() {
            var target = block.edges[position].target
            var coming = predecessors[target]
            crash coming
            coming.append(block.number)
            position = position + 1
        }
        index = index + 1
    }
}

# ../../../design/backend_high_level_ir.md#what-a-function-surely-wrote
func start_full(function: HighFunction) {
    var index = 0
    while index < function.blocks.count() {
        var nothing_yet = List<String>()
        before_blocks.append(nothing_yet)
        var everything = may_write.copy()
        after_blocks.append(everything)
        index = index + 1
    }
}

func settle(function: HighFunction) {
    var changed = true
    while changed {
        changed = false
        var index = 0
        while index < function.blocks.count() {
            var block = function.blocks[index]
            var before = state_before(block)
            var written = keys_written(function, block)
            var after = add_fields(before, written)
            if not same_fields(after, after_blocks[index]) {
                changed = true
            }
            before_blocks[index] = before
            after_blocks[index] = after
            index = index + 1
        }
    }
}

# ../../../design/backend_high_level_ir.md#what-a-function-surely-wrote
func state_before(block: HighBlock): List<String> {
    var coming = predecessors[block.number]
    crash coming
    var before = List<String>()
    var index = 0
    while index < coming.count() {
        var from = coming[index]
        var incoming = after_blocks[from]
        crash incoming
        if index == 0 {
            before = incoming.copy()
        } else {
            before = shared_fields(before, incoming)
        }
        index = index + 1
    }
    return before
}

func collect_answers(function: HighFunction) {
    var index = 0
    while index < function.blocks.count() {
        var block = function.blocks[index]
        if ends_in_return(block) {
            var reaching = after_blocks[index]
            crash reaching
            var answer = answer_given(block)
            if answer == "true" {
                answered_true = answered_true + 1
                must_write_true = meet(must_write_true, reaching, answered_true == 1)
            } else if answer == "false" {
                answered_false = answered_false + 1
                must_write_false = meet(must_write_false, reaching, answered_false == 1)
            }
            answered_other = answered_other + 1
            must_write_any = meet(must_write_any, reaching, answered_other == 1)
        }
        index = index + 1
    }
}

func ends_in_return(block: HighBlock): Boolean {
    var ends = false
    var index = 0
    while index < block.operations.count() {
        if block.operations[index].kind == "return" {
            ends = true
        }
        index = index + 1
    }
    return ends
}

func meet(already: List<String>, incoming: List<String>, first: Boolean): List<String> {
    if first {
        return incoming.copy()
    }
    return shared_fields(already, incoming)
}

func answer_given(block: HighBlock): String {
    var answer = ""
    var index = 0
    while index < block.operations.count() {
        var one = block.operations[index].answers
        if not one.is_empty() {
            answer = one
        }
        index = index + 1
    }
    return answer
}

func keys_written(function: HighFunction, block: HighBlock): List<String> {
    var keys = List<String>()
    var index = 0
    while index < block.operations.count() {
        var operation = block.operations[index]
        if operation.kind.ends_with(" write") and operation.writes.count() > 0 {
            var key = key_of(function, operation.writes[0])
            if not key.is_empty() and not keys.contains(key) {
                keys.append(key)
            }
        }
        index = index + 1
    }
    return keys
}

func every_key(function: HighFunction): List<String> {
    var keys = List<String>()
    var index = 0
    while index < function.blocks.count() {
        var block = function.blocks[index]
        var written = keys_written(function, block)
        keys = add_fields(keys, written)
        index = index + 1
    }
    return keys
}

func key_of(function: HighFunction, value_number: Integer): String {
    var key = ""
    if value_number >= 0 {
        var value = function.value_at(value_number)
        if value.is_of_an_object() {
            key = "{value.owner}#{value.name}"
            field_names[key] = value.name
        }
    }
    return key
}

func add_fields(given: List<String>, extra: List<String>): List<String> {
    var together = given.copy()
    var index = 0
    while index < extra.count() {
        if not together.contains(extra[index]) {
            together.append(extra[index])
        }
        index = index + 1
    }
    return together
}

func shared_fields(left: List<String>, right: List<String>): List<String> {
    var both = List<String>()
    var index = 0
    while index < left.count() {
        if right.contains(left[index]) {
            both.append(left[index])
        }
        index = index + 1
    }
    return both
}

func same_fields(left: List<String>, right: List<String>): Boolean {
    if left.count() != right.count() {
        return false
    }
    return shared_fields(left, right).count() == left.count()
}

func named(keys: List<String>): String {
    var names = List<String>()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var name = field_names[key]
        crash name
        names.append(name)
        index = index + 1
    }
    return "({names.join(" ")})"
}

func summary_text(): String {
    var parts = List<String>()
    if answered_true > 0 {
        parts.append("when true {must_write_true.count()} {named(must_write_true)}")
    }
    if answered_false > 0 {
        parts.append("when false {must_write_false.count()} {named(must_write_false)}")
    }
    if answered_other > 0 {
        parts.append("before returning {must_write_any.count()} {named(must_write_any)}")
    }
    return "it surely wrote {parts.join(", ")} of {may_write.count()} fields it writes at all"
}
