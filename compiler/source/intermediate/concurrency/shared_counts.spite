# ../../../../docs/optimizations.md#plain-reference-counts-where-no-thread-reaches-a-class
var types = Analysis.TypeShape()
var lowered: Lowered? = null
var kinds: Facts.ValueKinds? = null
var atomic = Dictionary<String, Boolean>()
var everything = false

func SharedCounts(starting_lowered: Lowered) {
    lowered = starting_lowered
    var made_kinds = Facts.ValueKinds(starting_lowered)
    kinds = made_kinds
}

func decide(reach: Facts.ThreadReach) {
    crash lowered
    var threaded = lowered.makes_threads or lowered.remote_loop or lowered.hot_reload or lowered.makes_concurrents
    assert threaded
    everything = lowered.is_inspectable()
    var functions = lowered.concrete_functions
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if not everything and reach.runs_on_threads(function.c_name) {
            note_function(function)
        }
        index = index + 1
    }
    crash kinds
    var function_value: Analysis.SpiteType = Analysis.Types.ClassRefType("Spite_Function")
    if not everything and kinds.layout_of(function_value) {
        note_type(function_value, 0)
    }
    var layouts = lowered.layouts
    index = 0
    while index < layouts.count() {
        var layout = layouts[index]
        layout.atomic_counts = everything or atomic.has(layout.c_name) or layout.c_name == "ThreadPoolJob"
        index = index + 1
    }
}

func note_function(function: Function) {
    crash kinds
    if function.receiver >= 0 {
        var receiver_type = function.value_at(function.receiver).spite_type
        if kinds.is_counted(receiver_type) {
            note_type(receiver_type, 0)
        }
    }
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        var parameter_type = function.parameters[parameter_index].spite_type
        if kinds.is_counted(parameter_type) {
            note_type(parameter_type, 0)
        }
        parameter_index = parameter_index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.operations.count() {
            var operation = block.operations[index]
            note_operation(function, operation)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func note_operation(function: Function, operation: Operation) {
    crash lowered
    var counts = operation.kind == "retain" or operation.kind == "release" or operation.kind == "store"
    if counts {
        var counted_value = operation.operands.last()
        crash counted_value
        var counted_type = function.value_at(counted_value).spite_type
        note_type(counted_type, 0)
        return
    }
    assert operation.kind == "call"
    var callee = lowered.function_named(operation.callee)
    assert callee and callee.is_intrinsic()
    var index = 0
    while index < callee.parameters.count() {
        var parameter = callee.parameters[index]
        if parameter.ownership == "owned" {
            note_type(parameter.spite_type, 0)
        }
        index = index + 1
    }
    assert callee.answer
    note_type(callee.answer, 0)
}

func note_type(spite_type: Analysis.SpiteType?, depth: Integer) {
    crash kinds
    if not spite_type or depth > 12 {
        everything = true
        return
    }
    assert kinds.is_counted(spite_type)
    assert not types.as_string(spite_type) and not types.is_symbol(spite_type)
    var nullable = types.as_nullable(spite_type)
    if nullable {
        note_type(nullable.inner, depth + 1)
        return
    }
    var listed = types.as_list(spite_type)
    if listed {
        note_type(listed.element, depth + 1)
        return
    }
    var layout = kinds.layout_of(spite_type)
    if not layout {
        everything = true
        return
    }
    assert not atomic.has(layout.c_name)
    atomic[layout.c_name] = true
    var index = 0
    while index < layout.stored_fields.count() {
        note_type(layout.stored_fields[index].spite_type, depth + 1)
        index = index + 1
    }
    assert layout.information
    var held = layout.information.codegen_types
    index = 0
    while index < held.count() {
        note_type(held[index], depth + 1)
        index = index + 1
    }
}
