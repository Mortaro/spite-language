# ../../../design/proposals/desugared_high_ir.md#reflection-as-code
var expressions: ExpressionLowering? = null
var types = Analysis.TypeShape()

func ReflectionLowering(starting_expressions: ExpressionLowering) {
    expressions = starting_expressions
}

func lowering(): ExpressionLowering {
    crash expressions
    return expressions
}

func symbol(text: String): Integer {
    var symbol_type = lowering().known().typed_symbol()
    return lowering().emitter.constant(symbol_type, text)
}

func flag(object: Integer, field: String) {
    var truth = lowering().boolean_constant("true")
    lowering().emitter.store_field(object, field, truth)
}

func class_object(name: String): Integer {
    var made = lowering().front()
    var position = position_of(made.class_object_names, name)
    if position < 0 {
        return lowering().not_lowered(null, "a class object the generator never described")
    }
    crash made.class_object_displays[position]
    var display = made.class_object_displays[position]
    var class_class = made.find_class_by_c_name("Spite_Class")
    if not class_class {
        return lowering().not_lowered(null, "a class object with no Spite.Class")
    }
    var name_value = symbol(display)
    var values = [name_value]
    var object = lowering().construct_values(class_class, values)
    var kind = made.class_object_kinds[name]
    if made.run_time_kinds_used and kind {
        flag(object, "_{kind}")
    }
    return object
}

func described_by_class_object(name: String): Analysis.ClassInfo? {
    var made = lowering().front()
    var position = position_of(made.class_object_names, name)
    assert position >= 0
    var label = made.class_object_labels[position]
    assert label
    return made.find_class_by_c_name(label)
}

func position_of(names: List<String>, name: String): Integer {
    var index = 0
    while index < names.count() {
        if names[index] == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func describe_class(object: Integer, described: Analysis.ClassInfo) {
    var made = lowering().front()
    var visited = List<String>()
    if made.run_time_kinds_used and made.class_has_state(described, visited) {
        flag(object, "_stateful")
    }
    if described.is_singleton {
        flag(object, "_singleton")
    }
    if made.class_fits_vector(described) {
        flag(object, "_fits_vector")
    }
    if made.source_folder_used {
        var folder = made.absolute_source_folder(described)
        var folder_value = lowering().text_constant(folder)
        lowering().emitter.store_field(object, "_source_folder", folder_value)
    }
    if made.source_paths_used {
        var absolute = List<String>()
        var path_index = 0
        while path_index < described.source_paths.count() {
            var written = made.absolute_source_path(described.source_paths[path_index])
            absolute.append(written)
            path_index = path_index + 1
        }
        store_paths(object, absolute)
    }
    if made.namespace_read_used and not described.namespace_dotted.is_empty() {
        store_namespace(object, "_namespace", described.namespace_dotted)
    }
    if made.class_level_attributes_used and made.describes_members(described) {
        var declarations = attribute_declarations(described)
        lowering().emitter.store_field(object, "_attributes", declarations)
    }
    assert made.class_level_functions_used and made.describes_members(described)
    if described.c_name == made.entry_class_c_name {
        var unbound = functions_of(described, -1)
        var unbound_type = lowering().type_of(unbound)
        var maybe_unbound = lowering().known().nullable_of(unbound_type)
        var held_unbound = lowering().convert(unbound, maybe_unbound)
        lowering().emitter.store_field(object, "_unbound_functions", held_unbound)
        return
    }
    var fresh_type = lowering().known().class_type(described)
    var fresh = lowering().default_object(described, fresh_type)
    var listed = functions_of(described, fresh)
    lowering().emitter.store_field(object, "_functions", listed)
}

func attribute_declarations(described: Analysis.ClassInfo): Integer {
    var made = lowering().front()
    var declaration_class = made.find_class_by_c_name("Spite_AttributeDeclaration")
    if not declaration_class {
        return lowering().not_lowered(null, "attribute declarations with no Spite.AttributeDeclaration class")
    }
    var element = lowering().known().class_type(declaration_class)
    var listed = lowering().new_list(element)
    var appender = lowering().list_function(element, "append")
    var collection = described.qualified_dotted == "List" or described.qualified_dotted == "Dictionary"
    var index = 0
    while index < described.fields.count() and not described.is_value_class and not collection {
        var field = described.fields[index]
        var name_value = symbol(field.name)
        var field_class = lowering().class_object_of(field.type)
        var values = [name_value, field_class]
        var declared = lowering().construct_values(declaration_class, values)
        store_index(declared, index)
        lowering().call_two_function(appender, listed, declared)
        index = index + 1
    }
    return listed
}

func store_index(object: Integer, index: Integer) {
    var whole = lowering().known().typed_integer()
    var written = index.to_string()
    var position = lowering().emitter.constant(whole, written)
    lowering().emitter.store_field(object, "_index", position)
}

func attributes_of(described: Analysis.ClassInfo, owner: Integer): Integer {
    var made = lowering().front()
    var attribute_class = made.find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        return lowering().not_lowered(null, "attributes with no Spite.Attribute class")
    }
    var element = lowering().known().class_type(attribute_class)
    var listed = lowering().new_list(element)
    var appender = lowering().list_function(element, "append")
    var index = 0
    while index < described.fields.count() {
        var field = described.fields[index]
        var attribute = field_attribute(described, owner, field, attribute_class)
        store_index(attribute, index)
        lowering().call_two_function(appender, listed, attribute)
        index = index + 1
    }
    return listed
}

func attribute_value(owner: Integer, name: String, field_type: Analysis.SpiteType): Integer {
    var made = lowering().front()
    var shape = made.attribute_object_shape()
    var shape_type = made.union_type_of(shape)
    var held_type = lowering().known().nullable_of(shape_type)
    var plain = lowering().without_nullable(field_type)
    var carried = false
    if made.has_attribute_object(plain) or made.boxed_class_of(plain) or types.is_symbol(plain) {
        carried = true
    }
    if not made.attribute_object_used or not carried {
        return lowering().emitter.constant(held_type, "null")
    }
    var stored = lowering().emitter.load_field(owner, name, field_type)
    var nullable = types.as_nullable(field_type)
    if not nullable {
        return lowering().convert(stored, held_type)
    }
    var building = lowering().emitter
    var boolean = lowering().known().typed_boolean()
    var present = building.emit_call_one("Nullable.has", stored, boolean)
    var present_block = building.new_block()
    var absent_block = building.new_block()
    var joined = building.new_block()
    var answered = building.new_value(held_type, "parameter")
    building.built_function().block_at(joined).parameters.append(answered)
    building.branch(present, present_block, absent_block)
    building.enter_block(present_block)
    var inner = building.emit_call_one("Nullable.value", stored, nullable.inner)
    var converted = lowering().convert(inner, held_type)
    var converted_arguments = [converted]
    building.jump(joined, converted_arguments)
    building.enter_block(absent_block)
    var absent = building.constant(held_type, "null")
    var absent_arguments = [absent]
    building.jump(joined, absent_arguments)
    building.enter_block(joined)
    return answered
}

func functions_of(described: Analysis.ClassInfo, owner: Integer): Integer {
    var made = lowering().front()
    var function_class = made.find_class_by_c_name("Spite_Function")
    var argument_class = made.find_class_by_c_name("Spite_Argument")
    if not function_class or not argument_class {
        return lowering().not_lowered(null, "functions with no Spite.Function or Spite.Argument class")
    }
    var element = lowering().known().class_type(function_class)
    var listed = lowering().new_list(element)
    var appender = lowering().list_function(element, "append")
    var index = 0
    while index < described.declared_functions.count() {
        var function = described.declared_functions[index]
        var shown = not described.is_container or not function.symbol_owner_c_name.is_empty()
        var plain = not function.is_constructor and not function.symbol_through_caller
        if shown and plain and function.specialisation_position < 0 {
            var made_function = function_of(described, function, owner, function_class, argument_class)
            lowering().call_two_function(appender, listed, made_function)
        }
        index = index + 1
    }
    return listed
}

func function_of(
    described: Analysis.ClassInfo,
    function: Analysis.FunctionInfo,
    owner: Integer,
    function_class: Analysis.ClassInfo,
    argument_class: Analysis.ClassInfo,
): Integer {
    var made = lowering().front()
    var name_value = symbol(function.name)
    var returned = returned_class(function)
    var values = [name_value, returned]
    var made_function = lowering().construct_values(function_class, values)
    var argument_element = lowering().known().class_type(argument_class)
    var argument_list_type = made.list_type_of(argument_element)
    var arguments = lowering().emitter.load_field(made_function, "_arguments", argument_list_type)
    var appender = lowering().list_function(argument_element, "append")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_name = symbol(parameter.name)
        var parameter_class = lowering().class_object_of(parameter.type)
        var argument_values = [parameter_name, parameter_class]
        var argument = lowering().construct_values(argument_class, argument_values)
        store_index(argument, index)
        var slot = index.to_string()
        if made.run_time_kinds_used and function.has_body and made.parameter_writes.answer(made, described, function, slot) {
            flag(argument, "_mutated")
        }
        lowering().call_two_function(appender, arguments, argument)
        index = index + 1
    }
    if made.run_time_kinds_used and made.literal_body(function) {
        store_literal(made_function, function)
    }
    if made.wait_facts.may_wait(function.c_name) {
        flag(made_function, "_waits")
    }
    if owner < 0 {
        return made_function
    }
    var bound_name = function.c_name
    if made.is_inline_supplied(function) {
        bound_name = lowering().known().reflection_maker(
            "{function.c_name}___forward",
            "forwarder",
            described,
            function.name,
        )
    } else {
        lowering().known().reach(described, function)
    }
    var operands = [made_function, owner]
    var binding = lowering().emitter.call_operation("Function.bind", operands, null)
    binding.literal = bound_name
    binding.target = bound_name
    if not made.is_inline_supplied(function) and not made.is_library_class(described) and not made.hot_reload {
        var filler = lowering().known().accessed_maker("{function.c_name}___accessed", described, function.name)
        var filled = [made_function]
        lowering().emitter.emit_call(filler, filled, null)
    }
    return made_function
}

# ../../../docs/reflection.md#spiteaccess
func fill_accesses(described: Analysis.ClassInfo, function: Analysis.FunctionInfo, made_function: Integer) {
    var made = lowering().front()
    var plain_name = function.c_name == "{described.c_name}_{function.name}"
    var in_source = plain_name and function.line > 0 and function.symbol_name.is_empty() and function.specialisation_position < 0
    var listed = made.reflected_accesses(described, function, in_source)
    var symbol_type = lowering().known().typed_symbol()
    var class_type = made.spite_class_type()
    var names = lowering().new_list(symbol_type)
    var classes = lowering().new_list(class_type)
    var name_appender = lowering().list_function(symbol_type, "append")
    var class_appender = lowering().list_function(class_type, "append")
    var entries = List<String>()
    var index = 0
    while index < listed.elements.count() {
        var access = listed.elements[index]
        var target = access.elements.first()
        crash target
        crash target.described_type
        var kind = "g"
        if target.kind == "attribute" {
            kind = "a"
        }
        var read = "-"
        if access.is_read {
            read = "r"
        }
        var written = "-"
        if access.is_written {
            written = "w"
        }
        entries.append("{kind}{read}{written}")
        var name_value = symbol(target.name)
        lowering().call_two_function(name_appender, names, name_value)
        var class_value = lowering().class_object_of(target.described_type)
        lowering().call_two_function(class_appender, classes, class_value)
        index = index + 1
    }
    var joined = entries.join(";")
    var encoded = lowering().text_constant(joined)
    lowering().emitter.store_field(made_function, "_accessed", encoded)
    lowering().emitter.store_field(made_function, "_accessed_names", names)
    lowering().emitter.store_field(made_function, "_accessed_classes", classes)
}

func bound_caller(
    caller: String,
    name: String,
    parameter_types: List<Analysis.SpiteType>,
    answer: Analysis.SpiteType,
    owner: Integer,
    function_class: Analysis.ClassInfo,
    argument_class: Analysis.ClassInfo,
): Integer {
    var made = lowering().front()
    var name_value = symbol(name)
    var returned = returned_class_of(answer)
    var values = [name_value, returned]
    var made_function = lowering().construct_values(function_class, values)
    var argument_element = lowering().known().class_type(argument_class)
    var argument_list_type = made.list_type_of(argument_element)
    var arguments = lowering().emitter.load_field(made_function, "_arguments", argument_list_type)
    var appender = lowering().list_function(argument_element, "append")
    var index = 0
    while index < parameter_types.count() {
        var parameter_name = symbol("argument_{index}")
        var parameter_class = lowering().class_object_of(parameter_types[index])
        var argument_values = [parameter_name, parameter_class]
        var argument = lowering().construct_values(argument_class, argument_values)
        store_index(argument, index)
        lowering().call_two_function(appender, arguments, argument)
        index = index + 1
    }
    if made.wait_facts.may_wait(caller) {
        flag(made_function, "_waits")
    }
    var operands = [made_function, owner]
    var binding = lowering().emitter.call_operation("Function.bind", operands, null)
    binding.literal = caller
    binding.target = caller
    return made_function
}

func returned_class(function: Analysis.FunctionInfo): Integer {
    return returned_class_of(function.return_type)
}

func returned_class_of(answer: Analysis.SpiteType): Integer {
    var made = lowering().front()
    if not types.is_void(answer) {
        return lowering().class_object_of(answer)
    }
    var nothing = made.find_class_by_c_name("Nothing")
    if not nothing {
        return lowering().not_lowered(null, "a function answering nothing with no Nothing class")
    }
    var nothing_type = lowering().known().class_type(nothing)
    return lowering().class_object_of(nothing_type)
}

func store_paths(object: Integer, paths: List<String>) {
    assert not paths.is_empty()
    var text_type = lowering().known().typed_string()
    var listed = lowering().new_list(text_type)
    var appender = lowering().list_function(text_type, "append")
    var index = 0
    while index < paths.count() {
        var path = lowering().text_constant(paths[index])
        lowering().call_two_function(appender, listed, path)
        index = index + 1
    }
    var listed_type = lowering().type_of(listed)
    var maybe_list = lowering().known().nullable_of(listed_type)
    var wrapped = lowering().convert(listed, maybe_list)
    lowering().emitter.store_field(object, "_source_paths", wrapped)
}

func store_namespace(object: Integer, field: String, dotted: String) {
    var made = lowering().front()
    var namespace_class = made.find_class_by_c_name("Spite_Namespace")
    if not namespace_class {
        lowering().emitter.fail_lowering("a namespace with no Spite.Namespace class")
        return
    }
    var code = made.ensure_namespace_object(dotted)
    lowering().known().reach_layout(namespace_class)
    lowering().known().reflection_maker(code, "namespace_object", namespace_class, dotted)
    var namespace_type = lowering().known().class_type(namespace_class)
    var no_operands = List<Integer>()
    var found = lowering().emitter.emit_call(code, no_operands, namespace_type)
    var maybe_namespace = lowering().known().nullable_of(namespace_type)
    var wrapped = lowering().convert(found, maybe_namespace)
    lowering().emitter.store_field(object, field, wrapped)
}

func namespace_object(dotted: String): Integer {
    var made = lowering().front()
    var namespace_class = made.find_class_by_c_name("Spite_Namespace")
    if not namespace_class {
        return lowering().not_lowered(null, "a namespace with no Spite.Namespace class")
    }
    var segments = dotted.split(".")
    var last = segments.last()
    crash last
    var short_name = symbol(last)
    var long_name = symbol(dotted)
    var values = [short_name, long_name]
    var object = lowering().construct_values(namespace_class, values)
    if made.source_paths_used {
        var paths = made.namespace_source_paths(dotted)
        if not paths.is_empty() {
            store_paths(object, paths)
        }
    }
    if segments.count() > 1 {
        segments.remove_last()
        var parent = segments.join(".")
        store_namespace(object, "_parent", parent)
    }
    if made.namespace_tree_used {
        store_namespace_tree(object, dotted, namespace_class)
    }
    return object
}

func store_namespace_tree(object: Integer, dotted: String, namespace_class: Analysis.ClassInfo) {
    var made = lowering().front()
    var class_class = made.find_class_by_c_name("Spite_Class")
    if not class_class {
        lowering().emitter.fail_lowering("a namespace tree with no Spite.Class class")
        return
    }
    var class_type = lowering().known().class_type(class_class)
    var class_list_type = made.list_type_of(class_type)
    var class_appender = lowering().list_function(class_type, "append")
    var namespace_type = lowering().known().class_type(namespace_class)
    var namespace_list_type = made.list_type_of(namespace_type)
    var namespace_appender = lowering().list_function(namespace_type, "append")
    var classes = lowering().emitter.load_field(object, "_classes", class_list_type)
    var namespaces = lowering().emitter.load_field(object, "_namespaces", namespace_list_type)
    var enums = lowering().emitter.load_field(object, "_enums", class_list_type)
    var depth = dotted.split(".").count()
    var children = List<String>()
    var index = 0
    while index < made.classes.count() {
        var listed = made.classes[index]
        if made.is_listed_class(listed) and listed.namespace_dotted == dotted {
            var listed_type = made.class_type_of(listed)
            var listed_object = lowering().class_object_of(listed_type)
            lowering().call_two_function(class_appender, classes, listed_object)
        }
        var child = listed.namespace_dotted
        var nested = child.starts_with("{dotted}.") and child.split(".").count() == depth + 1
        if made.is_listed_class(listed) and nested and not children.contains(child) {
            children.append(child)
        }
        index = index + 1
    }
    index = 0
    while index < children.count() {
        var code = made.ensure_namespace_object(children[index])
        lowering().known().reflection_maker(code, "namespace_object", namespace_class, children[index])
        var no_operands = List<Integer>()
        var child_object = lowering().emitter.emit_call(code, no_operands, namespace_type)
        lowering().call_two_function(namespace_appender, namespaces, child_object)
        index = index + 1
    }
    var declared_enums = made.enums_in_namespace(dotted)
    index = 0
    while index < declared_enums.count() {
        var enum_type = made.enum_type_of(declared_enums[index])
        var enum_object = lowering().class_object_of(enum_type)
        lowering().call_two_function(class_appender, enums, enum_object)
        index = index + 1
    }
}

func store_literal(made_function: Integer, function: Analysis.FunctionInfo) {
    var made = lowering().front()
    var literal = made.returned_literal(function)
    assert literal
    var text = lowering().text_constant(literal)
    lowering().emitter.store_field(made_function, "_returned_literal", text)
    flag(made_function, "_has_returned_literal")
}

func reflect_attribute(name_value: Integer, value: Integer, value_type: Analysis.SpiteType): Integer {
    var made = lowering().front()
    var attribute_class = made.find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        return lowering().not_lowered(null, "a reflected value with no Spite.Attribute class")
    }
    var value_class = lowering().class_object_of(value_type)
    var values = [name_value, value_class]
    var attribute = lowering().construct_values(attribute_class, values)
    var held = held_value(value, value_type)
    lowering().emitter.store_field(attribute, "_value", held)
    var links = held_links(value_type)
    var operands = [attribute, value]
    var holding = lowering().emitter.call_operation("Attribute.hold", operands, null)
    holding.target = links
    return attribute
}

func held_value(value: Integer, value_type: Analysis.SpiteType): Integer {
    var made = lowering().front()
    var shape = made.attribute_object_shape()
    var shape_type = made.union_type_of(shape)
    var held_type = lowering().known().nullable_of(shape_type)
    var plain = lowering().without_nullable(value_type)
    var carried = false
    if made.has_attribute_object(plain) or made.boxed_class_of(plain) or types.is_symbol(plain) {
        carried = true
    }
    if not made.attribute_object_used or not carried or types.as_nullable(value_type) {
        return lowering().emitter.constant(held_type, "null")
    }
    return lowering().convert(value, held_type)
}

func held_links(value_type: Analysis.SpiteType): String {
    var made = lowering().front()
    var plain = lowering().without_nullable(value_type)
    var class_ref = types.as_class_ref(plain)
    if not class_ref or class_ref.has_signature {
        return ",,"
    }
    var described = made.find_class_by_c_name(class_ref.c_name)
    if not described or described.is_value_class or described.is_generic_template or described.is_container {
        return ",,"
    }
    var attributes = "{described.c_name}___attributes"
    var functions = "{described.c_name}___functions"
    lowering().known().reflection_maker(attributes, "attributes", described, "")
    lowering().known().reflection_maker(functions, "functions", described, "")
    var class_code = made.class_object_call(plain)
    var class_length = class_code.length()
    var class_maker = class_code.slice(0, class_length - 2)
    lowering().known().reflection_maker(class_maker, "class_object", described, "")
    return "{attributes},{functions},{class_maker}"
}

func placed_attribute(attribute: Integer, owner: Integer, described: Analysis.ClassInfo, field: Analysis.FieldInfo) {
    var made = lowering().front()
    var operands = [attribute, owner]
    var placing = lowering().emitter.call_operation("Attribute.place", operands, null)
    placing.layout = described.c_name
    placing.field = field.name
    var setter = described.find_function("set_{field.name}")
    if setter and setter.parameters.count() == 1 {
        lowering().known().reach(described, setter)
        placing.literal = setter.c_name
    }
    var scalar_type = types.as_scalar(field.type)
    assert scalar_type
    var word = lowering().known().scalar_word(scalar_type.kind)
    var parser = made.written_string_function("to_{word}")
    var string_class = made.find_class_by_c_name("SpiteString")
    assert parser and string_class
    lowering().known().reach(string_class, parser)
    placing.target = parser.c_name
}

func loop_singletons(): Integer {
    var made = lowering().front()
    var attribute_class = made.find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        return lowering().not_lowered(null, "the REPL's singletons with no Spite.Attribute class")
    }
    var element = lowering().known().class_type(attribute_class)
    var listed = lowering().new_list(element)
    var appender = lowering().list_function(element, "append")
    var known = lowering().known()
    var index = 0
    while index < known.singleton_classes.count() {
        var information = known.singleton_classes[index]
        crash known.singleton_names[index]
        var maker = known.singleton_names[index]
        var listed_class = information.qualified_dotted == "Environment" or information.qualified_dotted == "Build"
        if not made.is_library_class(information) or listed_class {
            var attribute = peeked_singleton(information, maker)
            lowering().call_two_function(appender, listed, attribute)
        }
        index = index + 1
    }
    return listed
}

func peeked_singleton(information: Analysis.ClassInfo, maker: String): Integer {
    var made = lowering().front()
    var class_type = lowering().known().class_type(information)
    var maybe_type = lowering().known().nullable_of(class_type)
    var no_operands = List<Integer>()
    var peeking = lowering().emitter.call_operation("Singleton.peek", no_operands, maybe_type)
    peeking.target = maker
    var display = made.singleton_display_name(information)
    var name_value = symbol(display)
    var attribute_type = lowering().known().class_type(information)
    var reflect = made.find_class_by_c_name("Spite_Attribute")
    crash reflect
    var answer_type = lowering().known().class_type(reflect)
    var operands = [name_value, peeking.result]
    var reflect_name = reflect_function_name(maybe_type)
    lowering().known().reflection_maker(reflect_name, "reflect", information, "nullable")
    var attribute = lowering().emitter.emit_call(reflect_name, operands, answer_type)
    lowering().known().reach_type(attribute_type)
    return attribute
}

func reflect_function_name(spite_type: Analysis.SpiteType): String {
    var made = lowering().front()
    return "spite_reflect_{made.reflected_label(spite_type)}"
}

func field_attribute(
    described: Analysis.ClassInfo,
    owner: Integer,
    field: Analysis.FieldInfo,
    attribute_class: Analysis.ClassInfo,
): Integer {
    var made = lowering().front()
    var name_value = symbol(field.name)
    if made.read_evaluate_print_loop {
        var stored = lowering().emitter.load_field(owner, field.name, field.type)
        var reflected = reflect_attribute(name_value, stored, field.type)
        placed_attribute(reflected, owner, described, field)
        return reflected
    }
    var field_class = lowering().class_object_of(field.type)
    var values = [name_value, field_class]
    var attribute = lowering().construct_values(attribute_class, values)
    var held = attribute_value(owner, field.name, field.type)
    lowering().emitter.store_field(attribute, "_value", held)
    return attribute
}

func reflect_body(name_value: Integer, value: Integer): Integer {
    var value_type = lowering().type_of(value)
    var nullable = types.as_nullable(value_type)
    if not nullable {
        return reflect_attribute(name_value, value, value_type)
    }
    var made = lowering().front()
    var attribute_class = made.find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        return lowering().not_lowered(null, "a reflected value with no Spite.Attribute class")
    }
    var emitter = lowering().emitter
    var boolean = lowering().known().typed_boolean()
    var present = emitter.emit_call_one("Nullable.has", value, boolean)
    var answer_type = lowering().known().class_type(attribute_class)
    var joined = emitter.new_block()
    var answered = emitter.new_value(answer_type, "parameter")
    emitter.built_function().block_at(joined).parameters.append(answered)
    var present_block = emitter.new_block()
    var absent_block = emitter.new_block()
    emitter.branch(present, present_block, absent_block)
    emitter.enter_block(present_block)
    var inner = emitter.emit_call_one("Nullable.value", value, nullable.inner)
    var reflected = reflect_attribute(name_value, inner, nullable.inner)
    var reflected_passed = [reflected]
    emitter.jump(joined, reflected_passed)
    emitter.enter_block(absent_block)
    var inner_class = lowering().class_object_of(nullable.inner)
    var values = [name_value, inner_class]
    var unmade = lowering().construct_values(attribute_class, values)
    var unmade_passed = [unmade]
    emitter.jump(joined, unmade_passed)
    emitter.enter_block(joined)
    return answered
}
