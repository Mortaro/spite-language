# ../../../../docs/optimizations.md#appending-to-text-in-place
var types = Analysis.TypeShape()
var appended_count = 0
var flow: Facts.Flow? = null
var lowered: Lowered? = null
var kinds: Facts.ValueKinds? = null
var digits_count = 0

func TextAppends(starting_lowered: Lowered) {
    lowered = starting_lowered
    var made_kinds = Facts.ValueKinds(starting_lowered)
    kinds = made_kinds
}

func mark(function: Function) {
    assert not function.blocks.is_empty()
    var uses = Facts.Uses(function)
    var made_flow = Facts.Flow(function)
    flow = made_flow
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.operations.count() {
            var operation = block.operations[index]
            if appends_in_place(function, uses, operation, block_index, index) {
                operation.form = "in_place"
                appended_count = appended_count + 1
            }
            mark_digits(function, uses, operation)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func appends_in_place(
    function: Function,
    uses: Facts.Uses,
    operation: Operation,
    block_index: Integer,
    position: Integer,
): Boolean {
    if operation.kind != "call" or operation.callee != "String.join" or operation.result < 0 or not operation.form.is_empty() {
        return false
    }
    drop_empty_pieces(function, uses, operation)
    var first = operation.operands.first()
    if not first {
        return false
    }
    var joined = function.value_at(operation.result)
    var previous = function.value_at(first)
    if joined.name.is_empty() or joined.name != previous.name or not is_text(previous.spite_type) {
        return false
    }
    var index = 1
    while index < operation.operands.count() {
        if operation.operands[index] == first {
            return false
        }
        index = index + 1
    }
    return used_only_before(uses, first, block_index, position)
}

# ../../../../docs/optimizations.md#appending-to-text-in-place
func drop_empty_pieces(function: Function, uses: Facts.Uses, operation: Operation) {
    var index = operation.operands.count() - 1
    while index >= 0 and operation.operands.count() > 1 {
        var piece = operation.operands[index]
        crash piece
        var defining = uses.definition_of(piece)
        var described = function.value_at(piece)
        if defining and defining.kind == "constant" and defining.literal.is_empty() and is_text(described.spite_type) {
            operation.operands.remove_at(index)
        }
        index = index - 1
    }
}

func is_text(spite_type: Analysis.SpiteType?): Boolean {
    if not spite_type {
        return false
    }
    return types.as_string(spite_type)
}

func used_only_before(uses: Facts.Uses, value: Integer, block_index: Integer, position: Integer): Boolean {
    crash flow
    var defined = uses.place_of(value)
    var reached = uses.uses_of(value)
    var later = blocks_after(block_index, defined.block)
    var index = 0
    while index < reached.count() {
        var place = reached[index]
        var after_here = place.block == block_index and (place.position < 0 or place.position > position)
        if after_here or place.block != block_index and later.contains(place.block) {
            return false
        }
        index = index + 1
    }
    return true
}

func blocks_after(start: Integer, stop: Integer): List<Integer> {
    crash flow
    var seen = List<Integer>()
    var waiting = List<Integer>()
    var first = flow.successors_of(start)
    first.each(waiting.append)
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        if taken != stop and not seen.contains(taken) {
            seen.append(taken)
            var next = flow.successors_of(taken)
            next.each(waiting.append)
        }
    }
    return seen
}

# ../../../../docs/optimizations.md#a-number-joined-into-text-is-written-in-place
func mark_digits(function: Function, uses: Facts.Uses, joined: Operation) {
    assert joined.kind == "call" and joined.callee == "String.join"
    var index = 0
    while index < joined.operands.count() {
        note_digits(function, uses, joined, joined.operands[index])
        index = index + 1
    }
}

func note_digits(function: Function, uses: Facts.Uses, joined: Operation, part: Integer) {
    crash lowered
    crash kinds
    var defining = uses.definition_of(part)
    assert defining and defining.kind == "call" and defining.form.is_empty() and defining.operands.count() == 1
    var callee = lowered.function_named(defining.callee)
    assert callee and callee.name == "to_string"
    var number = defining.operands.first()
    crash number
    var number_value = function.value_at(number)
    crash number_value.spite_type
    var scalar = types.as_scalar(number_value.spite_type)
    assert scalar and kinds.is_whole_kind(scalar.kind)
    var reached = uses.uses_of(part)
    assert reached.count() == 1
    defining.form = "digits_in_place"
    digits_count = digits_count + 1
}
