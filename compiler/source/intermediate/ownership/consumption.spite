# ../../../../docs/optimizations.md#an-argument-its-caller-holds-is-passed-without-counting
var lowered: Lowered? = null
var intrinsics: Facts.Intrinsics? = null
var returns_lent = Dictionary<String, Boolean>()
var current: Function? = null
var instance_classes = Dictionary<String, Boolean>()

func Consumption(starting_lowered: Lowered) {
    lowered = starting_lowered
    var made_intrinsics = Facts.Intrinsics(starting_lowered)
    intrinsics = made_intrinsics
    starting_lowered.concrete_functions.each(note_instances)
}

func note_instances(function: Function) {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.operations.count() {
            var operation = block.operations[index]
            if operation.kind == "call" and operation.callee == "Instances.fill" {
                instance_classes[operation.literal] = true
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func is_instance_class(c_name: String): Boolean {
    return instance_classes.has(c_name)
}

# ../../../../docs/proofs.md#an-item-lent-to-the-caller
func settle_lent_returns() {
    crash lowered
    var changed = true
    var rounds = 0
    while changed and rounds < 16 {
        changed = false
        var functions = lowered.concrete_functions
        var index = 0
        while index < functions.count() {
            var function = functions[index]
            if not returns_lent.has(function.c_name) and lends_every_return(function) {
                returns_lent[function.c_name] = true
                changed = true
            }
            index = index + 1
        }
        rounds = rounds + 1
    }
}

func lends_every_return(function: Function): Boolean {
    if function.blocks.is_empty() or function.is_intrinsic() {
        return false
    }
    var uses = Facts.Uses(function)
    var lent = 0
    var index = 0
    while index < function.blocks.count() {
        var block = function.blocks[index]
        if block.terminator.kind == "return" {
            var returned = block.terminator.operands.first()
            if not returned {
                return false
            }
            var answer = traced(uses, returned, 0)
            if answer == "other" {
                return false
            }
            if answer == "lent" {
                lent = lent + 1
            }
        }
        index = index + 1
    }
    return lent > 0
}

func traced(uses: Facts.Uses, value: Integer, depth: Integer): String {
    var defining = uses.definition_of(value)
    if not defining or depth > 8 {
        return "other"
    }
    if defining.kind == "constant" {
        return "none"
    }
    if is_projection(defining) or is_wrap(defining) {
        var inner = defining.operands.first()
        if not inner {
            return "other"
        }
        return traced(uses, inner, depth + 1)
    }
    if is_lent_call(defining) {
        return "lent"
    }
    return "other"
}

func is_lent_call(operation: Operation): Boolean {
    crash intrinsics
    if operation.kind != "call" {
        return false
    }
    if returns_lent.has(operation.callee) {
        return true
    }
    var callee = intrinsics.callee_named(operation.callee)
    if not callee {
        return false
    }
    return callee.is_intrinsic() and callee.name == "item_at"
}

func traces_lent(uses: Facts.Uses, value: Integer): Boolean {
    var answer = traced(uses, value, 0)
    return answer == "lent"
}

# ../../../../docs/optimizations.md#a-row-of-borrowed-items-lives-in-the-frame
func into_row(operation: Operation): Boolean {
    var object = operation.operands.first()
    if not current or not object {
        return false
    }
    return is_row_value(current, object)
}

func is_row_value(function: Function, value: Integer): Boolean {
    crash lowered
    var value_type = function.value_at(value).spite_type
    var kinds = Facts.ValueKinds(lowered)
    var layout = kinds.layout_of(value_type)
    if not layout {
        return false
    }
    return layout.kind == "row"
}

func is_projection(operation: Operation): Boolean {
    var projections = ["Nullable.value", "Union.value", "Symbol.text"]
    return operation.kind == "call" and projections.contains(operation.callee)
}

func is_wrap(operation: Operation): Boolean {
    return operation.kind == "call" and (operation.callee == "Nullable.wrap" or operation.callee == "Union.wrap")
}

func consumes(operation: Operation, value: Integer): Boolean {
    var index = 0
    while index < operation.operands.count() {
        if operation.operands[index] == value and consumes_position(operation, index) {
            return true
        }
        index = index + 1
    }
    return false
}

func consumes_position(operation: Operation, position: Integer): Boolean {
    if operation.kind == "store" {
        return position == 1 and not into_row(operation)
    }
    if operation.kind == "call value" {
        return position > 0
    }
    if operation.kind == "call" and operation.callee == "String.join" and operation.form == "in_place" {
        return position == 0
    }
    if is_wrap(operation) {
        return position == 0
    }
    if operation.kind != "call" or position == 0 or operation.form == "in_place" {
        return false
    }
    crash intrinsics
    if intrinsics.is_dotted(operation.callee) {
        return false
    }
    var callee = intrinsics.callee_named(operation.callee)
    if not callee {
        return true
    }
    var ownership = parameter_ownership(callee, position - 1)
    return ownership != "held" and ownership != "lent"
}

func parameter_ownership(callee: Function, index: Integer): String {
    if index < 0 or index >= callee.parameters.count() {
        return "owned"
    }
    return callee.parameters[index].ownership
}

func lends_answer(operation: Operation): Boolean {
    return operation.kind == "call" and operation.form == "borrowed"
}

func is_lending_call(operation: Operation): Boolean {
    crash intrinsics
    crash lowered
    if operation.kind != "call" or operation.form == "in_place" {
        return false
    }
    var callee = intrinsics.callee_named(operation.callee)
    if not callee or callee.is_intrinsic() {
        return false
    }
    if callee.lends_answer {
        return true
    }
    var kinds = Facts.ValueKinds(lowered)
    var lending = ["get_at", "first", "last"]
    return lending.contains(callee.name) and kinds.is_library_layout(callee.owner) and returns_reads(callee)
}

func returns_reads(callee: Function): Boolean {
    var uses = Facts.Uses(callee)
    var index = 0
    while index < callee.blocks.count() {
        var block = callee.blocks[index]
        if block.terminator.kind == "return" and not returns_read(uses, block.terminator) {
            return false
        }
        index = index + 1
    }
    return true
}

func returns_read(uses: Facts.Uses, terminator: Terminator): Boolean {
    var returned = terminator.operands.first()
    if not returned {
        return false
    }
    return returns_read_value(uses, returned, 0)
}

func returns_read_value(uses: Facts.Uses, value: Integer, depth: Integer): Boolean {
    var defining = uses.definition_of(value)
    if not defining or depth > 4 {
        return false
    }
    if defining.kind == "constant" {
        return true
    }
    if is_wrap(defining) {
        var wrapped = defining.operands.first()
        if not wrapped {
            return false
        }
        return returns_read_value(uses, wrapped, depth + 1)
    }
    return is_lending_read(defining)
}

func is_lending_read(operation: Operation): Boolean {
    crash intrinsics
    if operation.kind != "call" {
        return false
    }
    var callee = intrinsics.callee_named(operation.callee)
    if not callee {
        return false
    }
    return callee.intrinsic == "supplied" and callee.name == "read_value"
}
