# ../../../../design/proposals/desugared_high_ir.md#the-intrinsics
var output = Output()
var lowered = Lowered()
var naming = Naming()
var hot = Hot()
var sites = Sites()
var shape = Analysis.TypeShape()
var copies = Copies()

func print(body: Body, operation: Operation) {
    var parts = operation.callee.split(".")
    var word = parts.last()
    var owner = parts.first()
    if not word or not owner or parts.count() < 2 {
        body.refuse("it calls '{operation.callee}', which names no intrinsic")
        return
    }
    switch owner {
        "String": print_string(body, operation, word)
        "Symbol": print_symbol(body, operation, word)
        "Nullable": print_nullable(body, operation, word)
        "Union": print_union(body, operation, word)
        "Reference": print_reference(body, operation, word)
        "Object": print_object(body, operation, word)
        "Arguments": print_arguments(body, operation, word)
        "Enum": print_enum(body, operation, word)
        "Boolean": print_boolean(body, operation, word)
        "Function": print_function_value(body, operation, word)
        "List": print_list(body, operation, word)
        "Foreign": print_foreign(body, operation, word)
        "Reflection": print_reflection(body, operation, word)
        "Instances": print_instances(body, operation, word)
        "Attribute": print_attribute(body, operation, word)
        "Bands": print_bands(body, operation)
        "Rows": print_rows(body, operation)
        "Singleton": print_singleton_lock(body, operation, word)
        _: print_number(body, operation, word)
    }
}

func print_singleton_peek(body: Body, operation: Operation) {
    var maker = lowered.function_named(operation.target)
    if not maker or maker.singleton_of.is_empty() {
        body.refuse("it peeks at the singleton made by '{operation.target}', which the program does not make")
        return
    }
    var layout = lowered.layout_named(maker.singleton_of)
    if not layout {
        body.refuse("it peeks at the singleton '{maker.singleton_of}', which has no layout")
        return
    }
    if layout.arrangement == "static" {
        body.assign(operation.result, "{operation.target}()")
        return
    }
    body.assign(operation.result, "{operation.target}_peek()")
}

func print_singleton_lock(body: Body, operation: Operation, word: String) {
    var owner = operation.literal
    switch word {
        "enter_coarse": body.enter_coarse(owner)
        "leave_coarse": body.leave_coarse(owner)
        "enter_skipping": body.enter_skipping(owner)
        "leave_skipping": body.leave_skipping(owner)
        "peek": print_singleton_peek(body, operation)
        _: body.refuse("it calls 'Singleton.{word}', which is no intrinsic")
    }
}

func print_attribute(body: Body, operation: Operation, word: String) {
    switch word {
        "hold": attribute_hold(body, operation)
        "place": attribute_place(body, operation)
        _: body.refuse("it calls 'Attribute.{word}', which is no intrinsic")
    }
}

func link_piece(pieces: List<String>, index: Integer): String {
    if index >= pieces.count() {
        return ""
    }
    var named = pieces[index].trim()
    if named.is_empty() or not lowered.function_named(named) {
        return ""
    }
    return named
}

func attribute_hold(body: Body, operation: Operation) {
    var attribute = body.operand(operation, 0)
    var held = body.operand(operation, 1)
    var held_type = body.operand_type(operation, 1)
    assert held_type
    var counted = naming.counted_name(held_type)
    var layout = naming.layout_of(held_type)
    assert not counted.is_empty() and layout and not layout.is_value and not naming.is_tagged(held_type) and not shape.as_union(held_type)
    var pieces = operation.target.split(",")
    var attributes = link_piece(pieces, 0)
    var functions = link_piece(pieces, 1)
    var described_class = link_piece(pieces, 2)
    body.emit("({attribute})->spite_held = (void*){counted}___retain({held});")
    body.emit("({attribute})->spite_release_held = (void (*)(void*)){counted}___release;")
    body.emit("({attribute})->spite_held_bytes = (int64_t)sizeof({layout.c_name});")
    if not attributes.is_empty() {
        body.emit("({attribute})->spite_held_attributes = (void* (*)(void*)){attributes};")
    }
    if not functions.is_empty() {
        body.emit("({attribute})->spite_held_functions = (void* (*)(void*)){functions};")
    }
    if not described_class.is_empty() {
        body.emit("({attribute})->spite_held_class = (void* (*)(void)){described_class};")
    }
    var listed = shape.as_list(held_type)
    assert listed
    var element = naming.c_type(listed.element)
    body.emit(
        "if ({held} != 0) \{ ({attribute})->spite_buffer_address = (int64_t)(intptr_t)({held})->items_; ({attribute})->spite_buffer_bytes = (int64_t)({held})->item_count_ * (int64_t)sizeof({element}); }",
    )
}

func attribute_place(body: Body, operation: Operation) {
    var attribute = body.operand(operation, 0)
    var owner = body.operand(operation, 1)
    var layout = lowered.layout_named(operation.layout)
    if not layout {
        body.refuse("it places an attribute in '{operation.layout}', which has no layout")
        return
    }
    var field = layout.field_named(operation.field)
    if not field or not field.spite_type {
        body.refuse("it places an attribute at '{operation.field}', which '{layout.c_name}' does not hold")
        return
    }
    var name = layout.c_name
    var reached = naming.fields_of(layout, "({owner})")
    body.emit(
        "({attribute})->spite_stored_address = (int64_t)(intptr_t)&{reached}->{field.name}_; ({attribute})->spite_stored_bytes = (int64_t)sizeof({reached}->{field.name}_);",
    )
    var assign = assign_thunk(layout, field, operation)
    var store = store_thunk(layout, field, operation)
    assert not assign.is_empty() or not store.is_empty()
    body.emit("({attribute})->spite_owner = (void*){name}___retain({owner});")
    body.emit("({attribute})->spite_release_owner = (void (*)(void*)){name}___release;")
    if not assign.is_empty() {
        body.emit("({attribute})->spite_assign = {assign};")
    }
    if not store.is_empty() {
        body.emit("({attribute})->spite_store = {store};")
    }
}

func written_field(field: Field, operation: Operation, value: String): String {
    var setter = lowered.function_named(operation.literal)
    if setter {
        return "{setter.c_name}(self, {value});"
    }
    crash field.spite_type
    var counted = naming.counted_name(field.spite_type)
    if counted.is_empty() {
        return "self->{field.name}_ = {value};"
    }
    return "{counted}___release(self->{field.name}_);\nself->{field.name}_ = {value};"
}

func print_thunk(layout: Layout, thunk: String, last: String, body_text: String, display: String) {
    var parameters = ["void* owner", "void* slot", last]
    if layout.hot {
        hot.slot_support(thunk, "bool", parameters, body_text, display, layout.c_name)
        return
    }
    var heading = "static bool {thunk}({parameters.join(", ")})"
    output.prototypes.append("{heading};")
    output.support("{heading} \{\n{body_text}\n}")
    output.runtime_place(thunk)
}

func owner_line(layout: Layout): String {
    var cast = "({layout.c_name}*)owner"
    var reached = naming.fields_of(layout, cast)
    return "{layout.c_name}* self = {reached};"
}

func assign_thunk(layout: Layout, field: Field, operation: Operation): String {
    crash field.spite_type
    var field_type = field.spite_type
    var parsed = parsed_lines(field_type, "text", "assigned", operation.target)
    if parsed.is_empty() {
        return ""
    }
    var thunk = "{layout.c_name}___assign_{field.name}"
    if output.forwarders.contains(thunk) {
        return thunk
    }
    output.forwarders.append(thunk)
    output.need("string same")
    var written = naming.c_type(field_type)
    var guard = "if (SPITE_STRING_IS_NULL(text)) return false;"
    if shape.as_nullable(field_type) {
        guard = ""
    }
    var stored = written_field(field, operation, "assigned")
    var owned = owner_line(layout)
    print_thunk(
        layout,
        thunk,
        "SpiteString text",
        "{owned}\n(void)slot;\n{guard}\n{written} assigned;\n{parsed}\n{stored}\nreturn true;",
        "{layout.qualified}'s assignment of {field.name}",
    )
    return thunk
}

func parsed_lines(spite_type: Analysis.SpiteType, text: String, target: String, parser: String): String {
    if shape.as_string(spite_type) {
        return "{target} = SpiteString___retain({text});"
    }
    var enumerated = shape.as_enum(spite_type)
    if enumerated {
        var chain = List<String>()
        var index = 0
        while index < enumerated.values.count() {
            var value = enumerated.values[index]
            var spelled = sites.literal(value)
            chain.append("if (spite_string_same({text}, {spelled})) {target} = {enumerated.c_name}_{value};")
            index = index + 1
        }
        chain.append("return false;")
        return chain.join(" else ")
    }
    var scalar = shape.as_scalar(spite_type)
    if scalar and scalar.kind == 'boolean_kind' {
        var yes = sites.literal("true")
        var no = sites.literal("false")
        return "if (spite_string_same({text}, {yes})) {target} = true; else if (spite_string_same({text}, {no})) {target} = false; else return false;"
    }
    var parsing = lowered.function_named(parser)
    if scalar and parsing {
        var written = naming.c_type(spite_type)
        var parsed_type = naming.c_type(parsing.answer)
        return "\{ {parsed_type} spite_parsed = {parsing.c_name}(SpiteString___retain({text})); if (!spite_parsed.has_value) return false; {target} = ({written})spite_parsed.value; }"
    }
    var nullable = shape.as_nullable(spite_type)
    if nullable and shape.as_string(nullable.inner) {
        return "if (SPITE_STRING_IS_NULL({text})) {target} = SPITE_STRING_NULL; else {target} = SpiteString___retain({text});"
    }
    return ""
}

func store_thunk(layout: Layout, field: Field, operation: Operation): String {
    crash field.spite_type
    var field_type = field.spite_type
    var stored_layout = naming.layout_of(field_type)
    if not stored_layout or stored_layout.is_value or stored_layout.kind != "class" {
        return ""
    }
    var thunk = "{layout.c_name}___store_{field.name}"
    if output.forwarders.contains(thunk) {
        return thunk
    }
    output.forwarders.append(thunk)
    var identity = naming.class_id_of(stored_layout)
    var stored = written_field(field, operation, "assigned")
    var owned = owner_line(layout)
    print_thunk(
        layout,
        thunk,
        "void* object",
        "{owned}\n(void)slot;\nif (object == 0 || ((SpiteHeader*)object)->class_id != {identity}) return false;\n{stored_layout.c_name}* assigned = {stored_layout.c_name}___retain(({stored_layout.c_name}*)object);\n{stored}\nreturn true;",
        "{layout.qualified}'s store of {field.name}",
    )
    return thunk
}

func print_instances(body: Body, operation: Operation, word: String) {
    var tracked = lowered.layout_named(operation.literal)
    var appending = lowered.function_named(operation.target)
    if word != "fill" or not tracked or not appending {
        body.refuse(
            "it lists the live instances of '{operation.literal}', and the class or the list's append '{operation.target}' is not held",
        )
        return
    }
    var name = tracked.c_name
    if not output.tracked_layouts.contains(name) {
        output.tracked_layouts.append(name)
    }
    var filled = body.operand(operation, 0)
    var registry = "spite_instances_{name}"
    body.emit(
        "for (int64_t spite_index = 0; spite_index < {registry}_count; spite_index = spite_index + 1) {appending.c_name}({filled}, {name}___retain({registry}[spite_index]));",
    )
}

func print_reflection(body: Body, operation: Operation, word: String) {
    var described = lowered.layout_named("Spite_Class")
    if not described {
        body.refuse("it reads a class object, and the program holds no Spite.Class layout")
        return
    }
    if word == "class" {
        class_read(body, operation)
        return
    }
    if word != "class_object" {
        body.refuse("it reads '{word}' by reflection, which the printer does not write yet")
        return
    }
    var getter = class_getter(operation.target)
    body.assign(operation.result, "{getter}()")
}

func class_getter(target: String): String {
    var label = target.replace(".", "_").replace("<", "_").replace(">", "_").replace(", ", "_").replace(
        "?",
        "_nullable",
    )
    var getter = "spite_class_object_{label}"
    if output.class_objects.contains(getter) {
        return getter
    }
    output.class_objects.append(getter)
    if not lowered.function_named(getter) {
        class_object(getter, target)
    }
    return getter
}

func class_read(body: Body, operation: Operation) {
    var read = body.operand(operation, 0)
    var read_type = body.operand_type(operation, 0)
    assert read_type
    if shape.as_union(read_type) {
        var chooser = union_class_of(read_type)
        body.assign(operation.result, "{chooser}({read})")
        return
    }
    var target = naming.label(read_type)
    var scalar = shape.as_scalar(read_type)
    if scalar or shape.as_string(read_type) {
        target = naming.display(read_type)
    }
    var getter = class_getter(target)
    body.assign(operation.result, "{getter}()")
}

func union_class_of(read_type: Analysis.SpiteType): String {
    var layout = naming.layout_of(read_type)
    var written = naming.c_type(read_type)
    if not layout {
        output.refuse("the class of a value of the union '{written}', which has no layout")
        return "spite_missing"
    }
    var chooser = "spite_class_of_{layout.c_name}"
    if output.class_objects.contains(chooser) {
        return chooser
    }
    output.class_objects.append(chooser)
    var tagged = layout.kind == "tagged union"
    var lines = ["static Spite_Class* {chooser}({written} self) \{"]
    var index = 0
    while index < layout.members.count() {
        var member = layout.members[index]
        var member_layout = lowered.layout_named(member)
        if member_layout {
            var identity = naming.class_id_of(member_layout)
            var shown = member
            if member_layout.is_value and member_layout.information {
                shown = member_layout.information.qualified_dotted
            }
            var getter = class_getter(shown)
            if tagged {
                lines.append("if ((self).tag == {identity}) return {getter}();")
            } else {
                lines.append("if (self != 0 && ((SpiteHeader*)self)->class_id == {identity}) return {getter}();")
            }
        }
        index = index + 1
    }
    var fallback = class_getter("Nothing")
    lines.append("return {fallback}();")
    lines.append("}")
    output.prototypes.append("static Spite_Class* {chooser}({written} self);")
    var chooser_text = lines.join("\n")
    output.support(chooser_text)
    output.name_piece(chooser)
    return chooser
}

func class_object(getter: String, target: String): String {
    var shown = target
    var singleton = false
    var layout = lowered.layout_named(target)
    if layout and layout.information {
        shown = layout.information.simple_name
        singleton = layout.is_singleton
    }
    var name = sites.literal(shown)
    output.need("singletons")
    var lines = [
        "static Spite_Class* {getter}_cache = 0;"
        "static int32_t {getter}_lock = 0;"
        "static void {getter}_teardown(void) \{ Spite_Class* spite_cached = {getter}_cache; {getter}_cache = 0; Spite_Class___release(spite_cached); }"
        "Spite_Class* {getter}(void) \{"
        "Spite_Class* found = SPITE_SINGLETON_FOUND({getter}_cache);"
        "if (found != 0) return Spite_Class___retain(found);"
        "SPITE_LOCK({getter}_lock);"
        "if ({getter}_cache == 0) \{"
        "Spite_Class* made = Spite_Class___allocate();"
        "made->_name_ = {name};"
    ]
    if singleton {
        lines.append("made->_singleton_ = true;")
    }
    lines.append("spite_singleton_created({getter}_teardown);")
    lines.append("SPITE_SINGLETON_PUBLISH({getter}_cache, made);")
    lines.append("}")
    lines.append("SPITE_UNLOCK({getter}_lock);")
    lines.append("return Spite_Class___retain({getter}_cache);")
    lines.append("}")
    output.prototypes.append("Spite_Class* {getter}(void);")
    var object_text = lines.join("\n")
    output.support(object_text)
    output.runtime_place(getter)
    return getter
}

func print_foreign(body: Body, operation: Operation, word: String) {
    switch word {
        "library": foreign_library(body, operation)
        "constant": foreign_constant(body, operation)
        "call": foreign_call(body, operation)
        "callback": foreign_callback(body, operation)
        _: body.refuse("it calls 'Foreign.{word}', which the printer does not write yet")
    }
}

func callback_type(spite_type: Analysis.SpiteType?): String {
    if not spite_type {
        return ""
    }
    var scalar = shape.as_scalar(spite_type)
    if not scalar {
        return ""
    }
    if scalar.kind == 'boolean_kind' {
        return "int32_t"
    }
    return naming.scalar_c_type(scalar.kind)
}

func foreign_callback(body: Body, operation: Operation) {
    var handle = body.operand(operation, 0)
    var target = lowered.function_named(operation.target)
    if not target {
        body.refuse("it hands C '{operation.target}', which the program does not hold")
        return
    }
    var position = operation.literal.replace("'", "")
    var owner = lowered.layout_named(target.owner)
    var shown = target.owner
    if owner {
        shown = owner.qualified
    }
    var place = body.source_place(operation)
    var called = naming.escape_c("'{shown}.{target.name}' ({place})")
    var parameters = List<String>()
    var passed = List<String>()
    var pointer_types = ["void*"]
    if position == "context_first" {
        parameters.append("void* spite_context")
    }
    var index = 0
    while index < target.parameters.count() {
        var parameter = target.parameters[index]
        var crossing = callback_type(parameter.spite_type)
        if crossing.is_empty() {
            body.refuse("it hands C '{target.c_name}', which takes a value that cannot come from C")
            return
        }
        parameters.append("{crossing} spite_argument_{index}")
        var argument_written = naming.c_type(parameter.spite_type)
        pointer_types.append(argument_written)
        if crossing == "int32_t" and argument_written == "bool" {
            passed.append("spite_argument_{index} != 0")
        } else {
            passed.append("spite_argument_{index}")
        }
        index = index + 1
    }
    if position == "context_last" {
        parameters.append("void* spite_context")
    }
    if parameters.is_empty() {
        parameters.append("void")
    }
    var returned = "void"
    if target.answer and not shape.is_void(target.answer) and naming.c_type(target.answer) != "Nothing*" {
        returned = callback_type(target.answer)
        if returned.is_empty() {
            body.refuse("it hands C '{target.c_name}', which answers a value that cannot go back to C")
            return
        }
    }
    output.need("callbacks")
    if position == "no_context" {
        no_context_callback(body, handle, target, called, parameters, passed, returned)
        return
    }
    output.need("callback contexts")
    var trampoline = "spite_callback_with_context_{output.forwarders.count()}"
    output.forwarders.append(trampoline)
    var answered_c = "void"
    if returned != "void" {
        answered_c = naming.c_type(target.answer)
    }
    var call = "(({answered_c} (*)({pointer_types.join(", ")}))spite_function->spite_typed_call)({joined_arguments("spite_function->spite_owner", passed)})"
    var fetch = "Spite_Function* spite_function = (Spite_Function*)spite_callback_context_function(spite_context);\nif (spite_function == 0) spite_callback_late(\"{called}\", \"after its ForeignCallback was dropped: keep the ForeignCallback for as long as C may call it\");"
    trampoline_text(trampoline, parameters, returned, fetch, call)
    body.emit(
        "\{ int64_t* spite_ticket = spite_callback_context_register(({handle})->_function_); ({handle})->_context_ = *spite_ticket; ({handle})->_registration_ = (int64_t)(intptr_t)spite_ticket; ({handle})->_address_ = (int64_t)(intptr_t)&{trampoline}; }",
    )
}

func joined_arguments(first: String, rest: List<String>): String {
    if rest.is_empty() {
        return first
    }
    return "{first}, {rest.join(", ")}"
}

func no_context_callback(
    body: Body,
    handle: String,
    target: Function,
    called: String,
    parameters: List<String>,
    passed: List<String>,
    returned: String,
) {
    var trampoline = "{target.c_name}___from_c"
    var slot = "{trampoline}_owner"
    if not output.forwarders.contains(trampoline) {
        output.forwarders.append(trampoline)
        output.literal_lines.append("static void* {slot} = 0;")
        var owner_type = "void*"
        if target.receiver >= 0 {
            var receiver = target.value_at(target.receiver)
            owner_type = naming.c_type(receiver.spite_type)
        }
        var fetch = "void* spite_owner = __atomic_load_n(&{slot}, __ATOMIC_ACQUIRE);\nif (spite_owner == 0) spite_callback_late(\"{called}\", \"after its ForeignCallback was dropped: keep the ForeignCallback for as long as C may call it\");"
        var call = "{target.c_name}({joined_arguments("({owner_type})spite_owner", passed)})"
        trampoline_text(trampoline, parameters, returned, fetch, call)
    }
    body.emit("spite_callback_register(&{slot}, ((Spite_Function*)({handle})->_function_)->spite_owner, \"{called}\");")
    body.emit("({handle})->_registration_ = (int64_t)(intptr_t)&{slot};")
    body.emit("({handle})->_address_ = (int64_t)(intptr_t)&{trampoline};")
}

func trampoline_text(trampoline: String, parameters: List<String>, returned: String, fetch: String, call: String) {
    var answer = "{call};"
    if returned != "void" {
        answer = "return ({returned})({call});"
    }
    var header = "static {returned} {trampoline}({parameters.join(", ")})"
    output.prototypes.append("{header};")
    output.support("{header} \{\n{fetch}\n{answer}\n}")
    output.runtime_place(trampoline)
}

func library_number(body: Body, written: String): Integer {
    var number = written.to_integer()
    if not number or number < 0 or number >= lowered.foreign_files.count() {
        body.refuse("it reaches the foreign library '{written}', which the program does not name")
        return 0
    }
    return number
}

func note_library(number: Integer) {
    var key = number.to_string()
    if not output.foreign_libraries.contains(key) {
        output.foreign_libraries.append(key)
    }
    output.need("singletons")
}

func note_header(body: Body, number: Integer) {
    var included = lowered.foreign_includes[number]
    if not included {
        body.refuse("the foreign library {number} has no header entry")
        return
    }
    if not included.is_empty() and not output.foreign_headers.contains(included) {
        output.foreign_headers.append(included)
    }
}

func foreign_library(body: Body, operation: Operation) {
    var number = library_number(body, operation.target)
    note_library(number)
    body.assign(operation.result, "spite_foreign_library_{number}()")
}

func foreign_constant(body: Body, operation: Operation) {
    var number = library_number(body, operation.literal)
    note_header(body, number)
    body.assign(operation.result, "((int32_t)({operation.target}))")
}

func foreign_symbol(number: Integer, symbol: String, wanted: String): String {
    var prefix = "{number}|{symbol}|"
    var index = 0
    while index < output.foreign_symbols.count() {
        if output.foreign_symbols[index].starts_with(prefix) {
            return "spite_foreign_{number}_{index}"
        }
        index = index + 1
    }
    var position = output.foreign_symbols.count()
    output.foreign_symbols.append("{prefix}{wanted}")
    output.literal_lines.append("static void* spite_foreign_{number}_{position} = 0;")
    return "spite_foreign_{number}_{position}"
}

func foreign_call(body: Body, operation: Operation) {
    var number = library_number(body, operation.literal)
    note_library(number)
    note_header(body, number)
    var wanted = "{body.function.owner}.{body.function.name}"
    var pointer = foreign_symbol(number, operation.target, wanted)
    var parameter_types = List<String>()
    var passed = List<String>()
    var index = 1
    while index < operation.operands.count() {
        var argument = body.operand(operation, index)
        var argument_type = body.operand_type(operation, index)
        assert argument_type
        var crossing = crossing_type(argument_type)
        if crossing.is_empty() {
            body.refuse("it hands C a value of a kind that cannot cross into C")
            return
        }
        parameter_types.append(crossing)
        var crossing_text = crossed(argument, argument_type, crossing)
        passed.append(crossing_text)
        index = index + 1
    }
    if parameter_types.is_empty() {
        parameter_types.append("void")
    }
    var answered = body.type_of(operation.result)
    var returned = "void"
    var text_answer = false
    if answered and not shape.is_void(answered) {
        returned = naming.c_type(answered)
        text_answer = shape.as_string(answered)
    }
    if text_answer {
        returned = "const char*"
    }
    crash lowered.foreign_files[number]
    var file = naming.escape_c(lowered.foreign_files[number])
    var symbol = naming.escape_c(operation.target)
    var place = body.source_place(operation)
    var from = naming.escape_c(place)
    body.emit("spite_last_foreign_call = \"{symbol}\\tlibrary={file}\\tfrom={from}\";")
    var call = "(({returned} (*)({parameter_types.join(", ")})){pointer})({passed.join(", ")})"
    if returned == "void" {
        body.emit("{call};")
        return
    }
    if text_answer {
        body.assign(
            operation.result,
            "(\{ const char* spite_foreign_text = {call}; spite_string_from_cstring_owned(spite_foreign_text != 0 ? spite_foreign_text : \"\"); })",
        )
        return
    }
    body.assign(operation.result, call)
}

func crossing_type(argument_type: Analysis.SpiteType): String {
    var scalar = shape.as_scalar(argument_type)
    if scalar {
        return scalar_crossing(scalar.kind)
    }
    if shape.as_enum(argument_type) {
        return "int64_t"
    }
    if shape.as_string(argument_type) {
        return "const char*"
    }
    var listed = shape.as_list(argument_type)
    if listed and shape.as_scalar(listed.element) {
        return "void*"
    }
    return ""
}

func scalar_crossing(kind: Analysis.Types.NumericKind): String {
    if naming.is_decimal(kind) {
        return naming.scalar_c_type(kind)
    }
    if naming.is_unsigned(kind) {
        return "uint64_t"
    }
    return "int64_t"
}

func crossed(argument: String, argument_type: Analysis.SpiteType, crossing: String): String {
    if shape.as_string(argument_type) {
        return "spite_string_bytes(&{argument})"
    }
    if crossing == "void*" {
        return "(void*)(intptr_t)({argument})->items_"
    }
    return "({crossing})({argument})"
}

func pool_function(name: String): String {
    var index = 0
    while index < lowered.concrete_functions.count() {
        var candidate = lowered.concrete_functions[index]
        var owner = lowered.layout_named(candidate.owner)
        if owner and owner.qualified == "ThreadPool" and (candidate.name == name or name == "maker" and not candidate.singleton_of.is_empty()) {
            return candidate.c_name
        }
        index = index + 1
    }
    return ""
}

func piece_value(name: String, owner: String, piece: String): String {
    return "Spite_Function {name}; memset(&{name}, 0, sizeof({name})); {name}.header.ref_count = SPITE_FRAMED_COUNT; {name}.spite_owner = (void*)({owner}); {name}.spite_typed_call = (void*)&{piece};"
}

func print_rows(body: Body, operation: Operation) {
    var names = operation.literal.split(",")
    if names.count() != operation.operands.count() {
        body.refuse("it runs a row of {names.count()} calls on {operation.operands.count()} receivers")
        return
    }
    var pool = pool_function("maker")
    var submit = pool_function("submit")
    var joining = pool_function("join")
    var parallel = not pool.is_empty() and not submit.is_empty() and not joining.is_empty() and lowered.layout_named("Spite_Function")
    if parallel {
        output.need("framed")
        output.need("threads")
        body.emit("\{ int64_t spite_row_states[{names.count()}];")
    }
    var calls = List<String>()
    var index = 0
    while index < names.count() {
        var receiver = body.operand(operation, index)
        var called = lowered.function_named(names[index])
        if not called {
            body.refuse("it runs '{names[index]}' in a row, which the program does not hold")
            return
        }
        if parallel and index > 0 {
            var piece = row_piece(called)
            var value = piece_value("spite_row_piece_{index}", receiver, piece)
            body.emit(
                "{value} {submit}({pool}(), &spite_row_piece_{index}, 0, 1, (int64_t)(intptr_t)&spite_row_states[{index}]);",
            )
            calls.append("{joining}({pool}(), (int64_t)(intptr_t)&spite_row_states[{index}]);")
        } else {
            body.emit("{called.c_name}({receiver});")
        }
        index = index + 1
    }
    if parallel {
        var joins = calls.join(" ")
        body.emit(joins)
        body.emit("}")
    }
}

func row_piece(called: Function): String {
    var piece = "spite_row_piece_{called.c_name}"
    if output.forwarders.contains(piece) {
        return piece
    }
    output.forwarders.append(piece)
    var owner_type = "void*"
    if called.receiver >= 0 {
        var receiver = called.value_at(called.receiver)
        owner_type = naming.c_type(receiver.spite_type)
    }
    output.prototypes.append("static void {piece}(void* owner, int32_t first, int32_t end);")
    output.support(
        "static void {piece}(void* owner, int32_t first, int32_t end) \{\n(void)first; (void)end;\n{called.c_name}(({owner_type})owner);\n}",
    )
    output.runtime_place(piece)
    return piece
}

func print_bands(body: Body, operation: Operation) {
    var listed = body.operand(operation, 0)
    var threshold = body.operand(operation, 1)
    var listed_type = body.operand_type(operation, 0)
    var layout = naming.layout_of(listed_type)
    var member = lowered.function_named(operation.literal)
    var pool = pool_function("maker")
    var running = pool_function("run_bands")
    if not layout or not member or not layout.information or layout.qualified != "List" or pool.is_empty() or running.is_empty() or not lowered.layout_named("Spite_Function") {
        body.assign(operation.result, "false")
        return
    }
    var piece = band_piece(layout, member)
    output.need("framed")
    output.need("threads")
    var value = piece_value("spite_band_piece", listed, piece)
    body.assign(
        operation.result,
        "(\{ {layout.c_name}* spite_band_list = {listed}; int32_t spite_band_n = spite_band_list->item_count_; bool spite_band_ok = spite_band_n >= {threshold}; for (int32_t spite_band_i = 0; spite_band_ok && spite_band_i < spite_band_n; spite_band_i++) spite_band_ok = ((SpiteHeader*)(((void**)(intptr_t)spite_band_list->items_)[spite_band_i]))->ref_count == 1; if (spite_band_ok) \{ {value} {running}({pool}(), &spite_band_piece, spite_band_n); } spite_band_ok; })",
    )
}

func band_piece(layout: Layout, member: Function): String {
    var piece = "spite_band_piece_{layout.c_name}_{member.c_name}"
    if output.forwarders.contains(piece) {
        return piece
    }
    output.forwarders.append(piece)
    var item_type = "void*"
    if member.receiver >= 0 {
        var receiver = member.value_at(member.receiver)
        item_type = naming.c_type(receiver.spite_type)
    }
    output.prototypes.append("static void {piece}(void* owner, int32_t first, int32_t end);")
    output.support(
        "static void {piece}(void* owner, int32_t first, int32_t end) \{\n{layout.c_name}* self = ({layout.c_name}*)owner;\nfor (int32_t spite_index = first; spite_index < end; spite_index++) {member.c_name}((({item_type}*)(intptr_t)self->items_)[spite_index]);\n}",
    )
    output.runtime_place(piece)
    return piece
}

func print_list(body: Body, operation: Operation, word: String) {
    if word != "holds_table" {
        body.refuse("it calls 'List.{word}', which is no intrinsic")
        return
    }
    var held = body.operand(operation, 0)
    var table = body.operand(operation, 1)
    var table_type = body.operand_type(operation, 1)
    var layout = naming.layout_of(table_type)
    if not layout or not layout.information {
        body.refuse("it compares a list with a table that is not a list")
        return
    }
    var element = layout.information.codegen_types.first()
    if not element {
        body.refuse("it compares a list with a table of no element type")
        return
    }
    var written = naming.c_type(element)
    body.assign(
        operation.result,
        "({held} != 0 && ({held})->item_count_ == ({table})->item_count_ && memcmp((const void*)(intptr_t)({held})->items_, (const void*)(intptr_t)({table})->items_, sizeof({written}) * (size_t)({table})->item_count_) == 0)",
    )
}

func print_function_value(body: Body, operation: Operation, word: String) {
    if word != "bind" {
        body.refuse("it calls 'Function.{word}', which is no intrinsic")
        return
    }
    var bound = body.operand(operation, 0)
    var owner = body.operand(operation, 1)
    var owner_type = body.operand_type(operation, 1)
    assert owner_type
    var called = lowered.function_named(operation.literal)
    if not called {
        body.refuse("it binds '{operation.literal}', which the program does not hold")
        return
    }
    if not output.bound_functions.contains(called.c_name) {
        output.bound_functions.append(called.c_name)
    }
    if shape.as_string(owner_type) or shape.as_scalar(owner_type) {
        bind_value_owner(body, bound, owner, owner_type, called)
        return
    }
    var counted = naming.counted_name(owner_type)
    if counted.is_empty() {
        body.refuse("it binds '{called.c_name}' to an owner that is neither an object nor a value it can box")
        return
    }
    body.emit("({bound})->spite_owner = (void*){counted}___retain({owner});")
    body.emit("({bound})->spite_release_owner = (void (*)(void*)){counted}___release;")
    body.emit("({bound})->spite_typed_call = (void*){called.c_name};")
    var dropping = dropping_call(called, "")
    body.emit("({bound})->spite_call = {dropping};")
}

func bind_value_owner(body: Body, bound: String, owner: String, owner_type: Analysis.SpiteType, called: Function) {
    var box = "SpiteBox_SpiteString"
    var boxed = "spite_box_SpiteString(SpiteString___retain({owner}))"
    var release = "spite_string_box_release"
    if shape.as_string(owner_type) {
        output.need("string box")
    } else {
        var label = naming.label(owner_type)
        var written = naming.c_type(owner_type)
        box = "SpiteBox_{label}"
        boxed = "spite_box_{label}({owner})"
        release = "spite_value_box_release"
        note_value_box(label, written)
    }
    var forwarder = value_forwarder(called, box)
    body.emit("({bound})->spite_owner = {boxed};")
    body.emit("({bound})->spite_release_owner = {release};")
    body.emit("({bound})->spite_typed_call = (void*){forwarder};")
    var dropping = dropping_call(called, forwarder)
    body.emit("({bound})->spite_call = {dropping};")
}

func note_value_box(label: String, written: String) {
    assert not output.value_boxes.contains(label)
    output.value_boxes.append(label)
    output.need("value box")
    output.nullable_types.append(
        "typedef struct SpiteBox_{label} \{ SpiteHeader header; {written} value; } SpiteBox_{label};",
    )
    output.support(
        "static void* spite_box_{label}({written} value) \{\nSpiteBox_{label}* self = (SpiteBox_{label}*)SPITE_MALLOC(sizeof(SpiteBox_{label}));\nif (self == 0) \{ fflush(stdout); fputs(\"spite: out of memory making an object\\n\", stderr); exit(1); }\nself->header.ref_count = 1;\nself->header.class_id = 0;\nself->value = value;\nreturn self;\n}",
    )
    output.name_piece("spite_box_{label}")
}

func value_forwarder(called: Function, box: String): String {
    var forwarder = "spite_forward_{called.c_name}"
    if output.forwarders.contains(forwarder) {
        return forwarder
    }
    output.forwarders.append(forwarder)
    var parameters = ["void* owner"]
    var forwarded = ["(({box}*)owner)->value"]
    var index = 0
    while index < called.parameters.count() {
        var parameter = called.parameters[index]
        var written = naming.c_type(parameter.spite_type)
        parameters.append("{written} spite_argument_{index}")
        forwarded.append("spite_argument_{index}")
        index = index + 1
    }
    var returned = answered_c_type(called)
    var body_text = "return {called.c_name}({forwarded.join(", ")});"
    if returned == "void" {
        body_text = "{called.c_name}({forwarded.join(", ")});"
    }
    output.support("static {returned} {forwarder}({parameters.join(", ")}) \{\n{body_text}\n}")
    output.runtime_place(forwarder)
    return forwarder
}

func answered_c_type(called: Function): String {
    if not called.answer or shape.is_void(called.answer) {
        return "void"
    }
    return naming.c_type(called.answer)
}

func dropping_call(called: Function, forwarder: String): String {
    if not called.parameters.is_empty() {
        return "0"
    }
    var target = forwarder
    if target.is_empty() {
        target = called.c_name
    }
    var dropping = "spite_dropping_{target}"
    if output.forwarders.contains(dropping) {
        return dropping
    }
    output.forwarders.append(dropping)
    var returned = answered_c_type(called)
    var receiving = "owner"
    if forwarder.is_empty() and called.receiver >= 0 {
        var receiver = called.value_at(called.receiver)
        var receiver_type = naming.c_type(receiver.spite_type)
        receiving = "({receiver_type})owner"
    }
    var call = "{target}({receiving})"
    var released = "(void){call};"
    if returned != "void" and called.answer {
        var counted = naming.counted_name(called.answer)
        if not counted.is_empty() {
            released = "{counted}___release({call});"
        }
    }
    output.support("static void {dropping}(void* owner) \{\n{released}\n}")
    output.runtime_place(dropping)
    return dropping
}

func print_symbol(body: Body, operation: Operation, word: String) {
    switch word {
        "text": symbol_text(body, operation)
        "equals": symbol_equals(body, operation)
        "from_text": symbol_from_text(body, operation)
        _: body.refuse("it calls 'Symbol.{word}', which is no intrinsic")
    }
}

func symbol_from_text(body: Body, operation: Operation) {
    var text = body.operand(operation, 0)
    output.need("string same")
    output.need("symbol find")
    body.assign(operation.result, "spite_symbol_find({text})")
}

func symbol_text(body: Body, operation: Operation) {
    var text = body.operand(operation, 0)
    body.assign(operation.result, text)
}

func symbol_equals(body: Body, operation: Operation) {
    var first_number = body.operand_number(operation, 0)
    var second_number = body.operand_number(operation, 1)
    var first_tag = body.tag_expression(first_number)
    var second_tag = body.tag_expression(second_number)
    if not first_tag.is_empty() and not second_tag.is_empty() {
        body.assign(operation.result, "({first_tag} == {second_tag})")
        return
    }
    string_equals(body, operation)
}

func print_reference(body: Body, operation: Operation, word: String) {
    if word != "equals" {
        body.refuse("it calls 'Reference.{word}', which is no intrinsic")
        return
    }
    var first = body.operand(operation, 0)
    var second = body.operand(operation, 1)
    var compared = body.operand_type(operation, 0)
    assert compared
    if naming.is_tagged(compared) {
        body.assign(
            operation.result,
            "(({first}).tag == ({second}).tag && ({first}).plain == ({second}).plain && ({first}).value.bits == ({second}).value.bits)",
        )
        return
    }
    if shape.as_string(compared) or shape.is_symbol(compared) {
        body.assign(
            operation.result,
            "(({first})._bytes_ == ({second})._bytes_ && ({first})._length_ == ({second})._length_)",
        )
        return
    }
    body.assign(operation.result, "((void*)({first}) == (void*)({second}))")
}

func print_object(body: Body, operation: Operation, word: String) {
    if word == "allocator" {
        object_allocator(body, operation)
        return
    }
    if word == "place" {
        var placed_number = body.operand_number(operation, 0)
        if not body.made_here(placed_number) {
            body.refuse("it places an object in an allocator that was not made or copied on the line before")
        }
        return
    }
    if word == "deep_copy" {
        var copied_value = body.operand(operation, 0)
        var copied_type = body.operand_type(operation, 0)
        var deep = copies.copied(copied_type, copied_value)
        body.assign(operation.result, deep)
        return
    }
    if word != "copy" {
        body.refuse("it calls 'Object.{word}', which the printer does not write yet")
        return
    }
    var copied = body.operand(operation, 0)
    var copied_type = body.operand_type(operation, 0)
    var layout = naming.layout_of(copied_type)
    if not layout or layout.kind != "class" or layout.is_value {
        body.refuse("it copies something that is not an object of a class")
        return
    }
    if body.placements.has(operation.result) {
        var head = body.placement_head(operation.result, layout)
        assert not head.is_empty()
        if not output.copied_in.contains(layout.c_name) {
            output.copied_in.append(layout.c_name)
        }
        body.assign(operation.result, "{layout.c_name}_copy_in({head}, {copied})")
        return
    }
    if not output.copied_layouts.contains(layout.c_name) {
        output.copied_layouts.append(layout.c_name)
    }
    body.assign(operation.result, "{layout.c_name}_copy({copied})")
}

func print_arguments(body: Body, operation: Operation, word: String) {
    if word == "program" {
        body.assign(operation.result, "spite_program_arguments")
        return
    }
    var arguments = body.operand(operation, 0)
    switch word {
        "count": body.assign(operation.result, "((int32_t)SpiteArguments_count(&{arguments}))")
        "get": arguments_get(body, operation, arguments)
        "flag": arguments_flag(body, operation, arguments)
        _: body.refuse("it calls 'Arguments.{word}', which is no intrinsic")
    }
}

func object_allocator(body: Body, operation: Operation) {
    var heap = body.operand(operation, 1)
    var made = body.type_of(operation.result)
    var written = naming.c_type(made)
    body.assign(operation.result, "(({written})({heap}))")
}

func arguments_get(body: Body, operation: Operation, arguments: String) {
    var position = body.operand(operation, 1)
    body.assign(operation.result, "SpiteArguments_get(&{arguments}, (int64_t)({position}))")
}

func arguments_flag(body: Body, operation: Operation, arguments: String) {
    var flag = body.operand(operation, 1)
    body.assign(operation.result, "SpiteArguments_lookup(&{arguments}, spite_string_bytes(&{flag}))")
}

func print_enum(body: Body, operation: Operation, word: String) {
    if word == "from_text" {
        enum_from_text(body, operation)
        return
    }
    if word != "to_integer" {
        print_number(body, operation, word)
        return
    }
    var converted = body.operand(operation, 0)
    body.assign(operation.result, "((int32_t)({converted}))")
}

func enum_from_text(body: Body, operation: Operation) {
    var text = body.operand(operation, 0)
    var made = body.type_of(operation.result)
    assert made
    var nullable = shape.as_nullable(made)
    var enumerated = shape.as_enum(made)
    if nullable {
        enumerated = shape.as_enum(nullable.inner)
    }
    if not enumerated {
        body.refuse("it reads text as an enum, and the answer is not an enum")
        return
    }
    var written = naming.c_type(made)
    var reader = "{enumerated.c_name}___from_text"
    if not output.enum_readers.contains(reader) {
        output.enum_readers.append(reader)
        output.need("string same")
        var lines = ["static {written} {reader}(SpiteString text) \{"]
        var index = 0
        while index < enumerated.values.count() {
            var value = enumerated.values[index]
            var spelled = sites.literal(value)
            lines.append(
                "if (spite_string_same(text, {spelled})) return ({written})\{ .has_value = true, .value = {enumerated.c_name}_{value} };",
            )
            index = index + 1
        }
        lines.append("return ({written})\{ .has_value = false };")
        lines.append("}")
        var reader_text = lines.join("\n")
        output.support(reader_text)
        output.runtime_place(reader)
    }
    body.assign(operation.result, "{reader}({text})")
}

func print_boolean(body: Body, operation: Operation, word: String) {
    if word != "and" {
        print_number(body, operation, word)
        return
    }
    var first = body.operand(operation, 0)
    var second = body.operand(operation, 1)
    body.assign(operation.result, "({first} && {second})")
}

func print_number(body: Body, operation: Operation, word: String) {
    switch word {
        "sum": arithmetic(body, operation, "+", "__builtin_add_overflow")
        "subtract": arithmetic(body, operation, "-", "__builtin_sub_overflow")
        "multiply": arithmetic(body, operation, "*", "__builtin_mul_overflow")
        "divide": division(body, operation)
        "remainder": remainder(body, operation)
        "equals": comparison(body, operation, "==")
        "less_than": comparison(body, operation, "<")
        "greater_than": comparison(body, operation, ">")
        "less_than_or_equal": comparison(body, operation, "<=")
        "greater_than_or_equal": comparison(body, operation, ">=")
        "negate": negation(body, operation)
        "not": logical_not(body, operation)
        _: conversion(body, operation, word)
    }
}

func number_kind(body: Body, operation: Operation): Analysis.Types.NumericKind? {
    var computed = body.operand_type(operation, 0)
    var kind = naming.kind_of(computed)
    if not kind {
        body.refuse("it calls '{operation.callee}' on something that is not a number")
    }
    return kind
}

func is_checked(operation: Operation): Boolean {
    return operation.site >= 0 and operation.form != "unchecked"
}

func located(body: Body, operation: Operation): String {
    if operation.site < 0 {
        body.refuse("the checked '{operation.callee}' has no site to report from")
        return "\"\""
    }
    return sites.located(operation.site)
}

func overflow_failure(kind: Analysis.Types.NumericKind): String {
    if naming.is_unsigned(kind) {
        output.need("overflowed unsigned")
        return "spite_overflowed_unsigned"
    }
    output.need("overflowed")
    return "spite_overflowed"
}

func shown_type(body: Body, operation: Operation): String {
    var computed = body.operand_type(operation, 0)
    if not computed {
        return "a number"
    }
    var shown = naming.display(computed)
    return naming.with_article(shown)
}

func operand_c_type(body: Body, operation: Operation): String {
    var computed = body.operand_type(operation, 0)
    return naming.c_type(computed)
}

func arithmetic(body: Body, operation: Operation, symbol: String, builtin: String) {
    var first = body.operand(operation, 0)
    var second = body.operand(operation, 1)
    var kind = number_kind(body, operation)
    assert kind
    var written = operand_c_type(body, operation)
    if operation.form == "wrapping" and naming.is_whole(kind) {
        var bits = naming.bits(kind)
        body.assign(operation.result, "({written})((uint{bits}_t){first} {symbol} (uint{bits}_t){second})")
        return
    }
    if not naming.is_whole(kind) or not is_checked(operation) {
        body.assign(operation.result, "({written})({first} {symbol} {second})")
        return
    }
    var target = body.result_name(operation)
    var failure = overflow_failure(kind)
    var place = located(body, operation)
    var text = sites.source_text(operation.site)
    var shown = shown_type(body, operation)
    var cast = naming.operand_cast(kind)
    body.emit(
        "if (__builtin_expect({builtin}({first}, {second}, &{target}), 0)) {failure}(\"{text}\", \"{shown}\", \"{symbol}\", {cast}{first}, {cast}{second}, {place});",
    )
}

func zero_check(body: Body, operation: Operation, divisor: String) {
    assert operation.form != "nonzero"
    output.need("divided by zero")
    var place = located(body, operation)
    var text = sites.source_text(operation.site)
    body.emit("if (__builtin_expect({divisor} == 0, 0)) spite_divided_by_zero(\"{text}\", {place});")
}

func division(body: Body, operation: Operation) {
    var dividend = body.operand(operation, 0)
    var divisor = body.operand(operation, 1)
    var kind = number_kind(body, operation)
    assert kind
    var written = operand_c_type(body, operation)
    if naming.is_decimal(kind) or not is_checked(operation) {
        body.assign(operation.result, "({written})({dividend} / {divisor})")
        return
    }
    zero_check(body, operation, divisor)
    if not naming.is_signed(kind) or operation.form == "no_overflow" {
        body.assign(operation.result, "({written})({dividend} / {divisor})")
        return
    }
    output.need("overflowed")
    var target = body.result_name(operation)
    var place = located(body, operation)
    var text = sites.source_text(operation.site)
    var shown = shown_type(body, operation)
    body.emit(
        "if ({divisor} == -1) \{ if (__builtin_expect(__builtin_sub_overflow(({written})0, {dividend}, &{target}), 0)) spite_overflowed(\"{text}\", \"{shown}\", \"/\", (int64_t){dividend}, (int64_t){divisor}, {place}); } else {target} = ({written})({dividend} / {divisor});",
    )
}

func remainder(body: Body, operation: Operation) {
    var dividend = body.operand(operation, 0)
    var divisor = body.operand(operation, 1)
    var kind = number_kind(body, operation)
    assert kind
    var written = operand_c_type(body, operation)
    if naming.is_decimal(kind) {
        decimal_remainder(body, operation, kind)
        return
    }
    if not is_checked(operation) {
        body.assign(operation.result, "({written})({dividend} % {divisor})")
        return
    }
    zero_check(body, operation, divisor)
    if not naming.is_signed(kind) or operation.form == "no_overflow" {
        body.assign(operation.result, "({written})({dividend} % {divisor})")
        return
    }
    body.assign(operation.result, "({divisor} == -1 ? ({written})0 : ({written})({dividend} % {divisor}))")
}

func decimal_remainder(body: Body, operation: Operation, kind: Analysis.Types.NumericKind) {
    var dividend = body.operand(operation, 0)
    var divisor = body.operand(operation, 1)
    output.need("maths")
    var library_function = "fmod"
    if kind == 'float_kind' {
        library_function = "fmodf"
    }
    body.assign(operation.result, "{library_function}({dividend}, {divisor})")
}

func comparison(body: Body, operation: Operation, symbol: String) {
    var first = body.operand(operation, 0)
    var second = body.operand(operation, 1)
    body.assign(operation.result, "({first} {symbol} {second})")
}

func logical_not(body: Body, operation: Operation) {
    var first = body.operand(operation, 0)
    var tested = body.operand_type(operation, 0)
    assert tested
    var nullable = shape.as_nullable(tested)
    if nullable {
        var present = presence(first, nullable.inner)
        body.assign(operation.result, "(!{present})")
        return
    }
    body.assign(operation.result, "(!{first})")
}

func negation(body: Body, operation: Operation) {
    var negated = body.operand(operation, 0)
    var kind = number_kind(body, operation)
    assert kind
    var written = operand_c_type(body, operation)
    if operation.form == "wrapping" and naming.is_whole(kind) {
        var bits = naming.bits(kind)
        body.assign(operation.result, "({written})(0 - (uint{bits}_t){negated})")
        return
    }
    if not naming.is_whole(kind) or not is_checked(operation) {
        body.assign(operation.result, "({written})(-{negated})")
        return
    }
    var target = body.result_name(operation)
    var failure = overflow_failure(kind)
    var place = located(body, operation)
    var text = sites.source_text(operation.site)
    var shown = shown_type(body, operation)
    var cast = naming.operand_cast(kind)
    body.emit(
        "if (__builtin_expect(__builtin_sub_overflow(({written})0, {negated}, &{target}), 0)) {failure}(\"{text}\", \"{shown}\", \"-\", {cast}0, {cast}{negated}, {place});",
    )
}

func conversion(body: Body, operation: Operation, word: String) {
    if not word.starts_with("to_") {
        body.refuse("it calls '{operation.callee}', which is no intrinsic the printer knows")
        return
    }
    var converted = body.operand(operation, 0)
    var from = body.operand_type(operation, 0)
    var to = body.type_of(operation.result)
    var from_kind = naming.kind_of(from)
    var to_kind = naming.kind_of(to)
    if not from_kind or not to_kind or not from or not to {
        body.refuse("it calls '{operation.callee}' between values that are not both numbers")
        return
    }
    var written = naming.c_type(to)
    if not needs_check(from_kind, to_kind) or not is_checked(operation) {
        body.assign(operation.result, "(({written})({converted}))")
        return
    }
    var outside = outside_condition(converted, from_kind, to_kind)
    var failure = narrowing_failure(from_kind)
    var place = located(body, operation)
    var widened = naming.operand_cast(from_kind)
    if naming.is_decimal(from_kind) {
        widened = "(double)"
    }
    var from_shown = naming.display(from)
    var to_shown = naming.display(to)
    var from_name = naming.with_article(from_shown)
    var to_name = naming.with_article(to_shown)
    body.emit(
        "if (__builtin_expect({outside}, 0)) {failure}({widened}{converted}, \"{from_name}\", \"{to_name}\", {place});",
    )
    body.assign(operation.result, "(({written}){converted})")
}

func needs_check(from: Analysis.Types.NumericKind, to: Analysis.Types.NumericKind): Boolean {
    if not naming.is_whole(to) {
        return false
    }
    if naming.is_decimal(from) {
        return true
    }
    return naming.is_whole(from) and not naming.widens(from, to)
}

func narrowing_failure(kind: Analysis.Types.NumericKind): String {
    if naming.is_decimal(kind) {
        output.need("narrowed decimal")
        return "spite_narrowed_decimal"
    }
    if naming.is_unsigned(kind) {
        output.need("narrowed unsigned")
        return "spite_narrowed_unsigned"
    }
    output.need("narrowed")
    return "spite_narrowed"
}

func outside_condition(value: String, from: Analysis.Types.NumericKind, to: Analysis.Types.NumericKind): String {
    var limit = naming.limit_name(to)
    var to_bits = naming.bits(to)
    if naming.is_decimal(from) {
        return decimal_outside(value, to, to_bits, limit)
    }
    var from_signed = naming.is_signed(from)
    var to_signed = naming.is_signed(to)
    if from_signed and to_signed {
        return "{value} < {limit}_MIN || {value} > {limit}_MAX"
    }
    if from_signed {
        return "{value} < 0 || {value} > {limit}_MAX"
    }
    return "{value} > {limit}_MAX"
}

func decimal_outside(value: String, to: Analysis.Types.NumericKind, to_bits: Integer, limit: String): String {
    if naming.is_unsigned(to) {
        return "!((double){value} > -1.0 && (double){value} < {power_of_two(to_bits)})"
    }
    if to_bits == 64 {
        return "!((double){value} >= -9223372036854775808.0 && (double){value} < 9223372036854775808.0)"
    }
    return "!((double){value} > (double){limit}_MIN - 1.0 && (double){value} < (double){limit}_MAX + 1.0)"
}

func power_of_two(bits: Integer): String {
    switch bits {
        8: return "256.0"
        16: return "65536.0"
        32: return "4294967296.0"
        _: return "18446744073709551616.0"
    }
}

func print_string(body: Body, operation: Operation, word: String) {
    switch word {
        "join": join(body, operation)
        "equals": string_equals(body, operation)
        "bytes": string_storage(body, operation, "((int64_t)(intptr_t)spite_string_bytes(&")
        "stored_length": string_storage(body, operation, "spite_string_length((")
        "less_than": string_order(body, operation, "<")
        "greater_than": string_order(body, operation, ">")
        _: body.refuse("it calls 'String.{word}', which is no intrinsic")
    }
}

func string_storage(body: Body, operation: Operation, opening: String) {
    var text = body.operand(operation, 0)
    body.assign(operation.result, "{opening}({text})))")
}

func string_order(body: Body, operation: Operation, symbol: String) {
    var first = body.operand(operation, 0)
    var second = body.operand(operation, 1)
    output.need("string order")
    body.assign(operation.result, "(spite_string_order({first}, {second}) {symbol} 0)")
}

func join(body: Body, operation: Operation) {
    var parts = List<String>()
    var index = 0
    while index < operation.operands.count() {
        var part = body.operand(operation, index)
        parts.append(part)
        index = index + 1
    }
    if parts.is_empty() {
        body.assign(operation.result, "SPITE_STRING_EMPTY")
        return
    }
    if operation.form == "in_place" {
        appended_join(body, operation, parts)
        return
    }
    body.assign(operation.result, "spite_string_join({parts.count()}, (SpiteString[]) \{ {parts.join(", ")} })")
}

func appended_join(body: Body, operation: Operation, parts: List<String>) {
    var joined = parts.first()
    crash joined
    var index = 1
    while index < parts.count() {
        joined = "SpiteString_append({joined}, {parts[index]})"
        index = index + 1
    }
    body.assign(operation.result, joined)
}

func string_equals(body: Body, operation: Operation) {
    var first = body.operand(operation, 0)
    var second = body.operand(operation, 1)
    output.need("string same")
    body.assign(operation.result, "spite_string_same({first}, {second})")
}

func print_nullable(body: Body, operation: Operation, word: String) {
    switch word {
        "has": nullable_has(body, operation)
        "value": nullable_value(body, operation)
        "wrap": nullable_wrap(body, operation)
        _: body.refuse("it calls 'Nullable.{word}', which is no intrinsic")
    }
}

func nullable_inner(body: Body, operation: Operation): Analysis.SpiteType? {
    var tested = body.operand_type(operation, 0)
    assert tested
    var nullable = shape.as_nullable(tested)
    if not nullable {
        body.refuse("it calls '{operation.callee}' on a value that cannot be null")
        return null
    }
    return nullable.inner
}

func nullable_has(body: Body, operation: Operation) {
    var tested = body.operand(operation, 0)
    var inner = nullable_inner(body, operation)
    assert inner
    if shape.as_string(inner) or shape.is_symbol(inner) {
        body.assign(operation.result, "(!SPITE_STRING_IS_NULL({tested}))")
        return
    }
    if naming.is_tagged(inner) {
        body.assign(operation.result, "SPITE_TAGGED_PRESENT({tested})")
        return
    }
    if naming.is_reference(inner) {
        body.assign(operation.result, "({tested} != 0)")
        return
    }
    body.assign(operation.result, "({tested}).has_value")
}

func presence(tested: String, inner: Analysis.SpiteType): String {
    var nested = shape.as_nullable(inner)
    if nested {
        return presence(tested, nested.inner)
    }
    if shape.as_string(inner) or shape.is_symbol(inner) {
        return "(!SPITE_STRING_IS_NULL({tested}))"
    }
    if naming.is_tagged(inner) {
        return "SPITE_TAGGED_PRESENT({tested})"
    }
    if naming.is_reference(inner) {
        return "({tested} != 0)"
    }
    return "({tested}).has_value"
}

func checked_value(body: Body, operation: Operation, test: String) {
    assert operation.site >= 0 and operation.form != "unchecked"
    output.need("check failed")
    var place = located(body, operation)
    var text = sites.source_text(operation.site)
    body.emit("if (__builtin_expect(!({test}), 0)) spite_check_failed(\"{text}\", {place});")
}

func nullable_value(body: Body, operation: Operation) {
    var tested = body.operand(operation, 0)
    var inner = nullable_inner(body, operation)
    assert inner
    var present = presence(tested, inner)
    checked_value(body, operation, present)
    if naming.is_reference(inner) or shape.as_nullable(inner) {
        body.assign(operation.result, tested)
        return
    }
    body.assign(operation.result, "({tested}).value")
}

func nullable_wrap(body: Body, operation: Operation) {
    var wrapped = body.operand(operation, 0)
    var made = body.type_of(operation.result)
    assert made
    var nullable = shape.as_nullable(made)
    if not nullable {
        body.refuse("it calls 'Nullable.wrap' into a value that is not nullable")
        return
    }
    var inner = nullable.inner
    if naming.is_reference(inner) or shape.as_nullable(inner) {
        body.assign(operation.result, wrapped)
        return
    }
    var written = naming.c_type(made)
    body.assign(operation.result, "(({written})\{ .has_value = true, .value = {wrapped} })")
}

func print_union(body: Body, operation: Operation, word: String) {
    switch word {
        "tag": union_tag(body, operation)
        "value": union_value(body, operation)
        "wrap": union_wrap(body, operation)
        _: body.refuse("it calls 'Union.{word}', which is no intrinsic")
    }
}

func union_tag(body: Body, operation: Operation) {
    var tested = body.operand(operation, 0)
    var tested_type = body.operand_type(operation, 0)
    var answered = body.type_of(operation.result)
    assert tested_type and answered
    var tag = "(((SpiteHeader*)({tested}))->class_id)"
    if naming.is_tagged(tested_type) {
        tag = "({tested}).tag"
    }
    if shape.as_scalar(answered) {
        body.assign(operation.result, tag)
        return
    }
    body.tag_sources[operation.result] = tag
}

func union_value(body: Body, operation: Operation) {
    var held = body.operand(operation, 0)
    var held_type = body.operand_type(operation, 0)
    var made = body.type_of(operation.result)
    assert held_type and made
    var written = naming.c_type(made)
    var tag_test = member_test(held, held_type, made)
    if not tag_test.is_empty() {
        checked_value(body, operation, tag_test)
    }
    if naming.is_tagged(held_type) {
        tagged_value(body, operation, held, made)
        return
    }
    if shape.as_string(made) or shape.is_symbol(made) {
        body.assign(operation.result, "(((SpiteBox_SpiteString*)({held}))->value)")
        return
    }
    if not naming.is_reference(made) {
        body.refuse("it reads a '{written}' out of a union that holds only objects")
        return
    }
    body.assign(operation.result, "(({written})({held}))")
}

func member_test(held: String, held_type: Analysis.SpiteType, made: Analysis.SpiteType): String {
    var tagged = naming.is_tagged(held_type)
    var layout = naming.layout_of(made)
    var scalar = shape.as_scalar(made)
    if shape.as_string(made) or shape.is_symbol(made) {
        layout = lowered.layout_named("SpiteString")
    } else if scalar {
        layout = lowered.layout_named("Spite{naming.scalar_label(scalar.kind)}")
    }
    if not layout or naming.is_tagged(made) or shape.as_union(made) {
        return ""
    }
    var identity = naming.class_id_of(layout)
    if tagged {
        return "({held}).tag == {identity}"
    }
    return "({held}) != 0 && ((SpiteHeader*)({held}))->class_id == {identity}"
}

func tagged_value(body: Body, operation: Operation, held: String, made: Analysis.SpiteType) {
    var written = naming.c_type(made)
    if shape.as_string(made) or shape.is_symbol(made) {
        body.assign(operation.result, "(((SpiteBox_SpiteString*)({held}).value.object)->value)")
        return
    }
    if naming.is_tagged(made) {
        body.assign(operation.result, held)
        return
    }
    if naming.is_reference(made) {
        body.assign(operation.result, "(({written})({held}).value.object)")
        return
    }
    body.assign(operation.result, "SPITE_TAGGED_VALUE({held}, {written})")
}

func union_wrap(body: Body, operation: Operation) {
    var made = body.type_of(operation.result)
    var given = body.operand_type(operation, 0)
    assert made and given
    if naming.is_tagged(made) {
        tagged_wrap(body, operation, given)
        return
    }
    plain_wrap(body, operation, made, given)
}

func plain_wrap(body: Body, operation: Operation, made: Analysis.SpiteType, given: Analysis.SpiteType) {
    var wrapped = body.operand(operation, 0)
    if naming.is_tagged(given) {
        body.refuse("it puts a value of a tagged union into a union of objects")
        return
    }
    if shape.as_string(given) or shape.is_symbol(given) {
        var boxed = string_box(body, operation, wrapped)
        body.assign(operation.result, boxed)
        return
    }
    if not naming.is_reference(given) {
        body.refuse("it puts a value that is not an object into a union of objects")
        return
    }
    var written = naming.c_type(made)
    body.assign(operation.result, "(({written})({wrapped}))")
}

func tagged_wrap(body: Body, operation: Operation, given: Analysis.SpiteType) {
    var wrapped = body.operand(operation, 0)
    if naming.is_tagged(given) {
        body.assign(operation.result, wrapped)
        return
    }
    if shape.as_union(given) {
        body.assign(operation.result, "spite_tagged_from_pointer((void*)({wrapped}))")
        return
    }
    if shape.as_string(given) or shape.is_symbol(given) {
        var string_layout = string_identity(body)
        var boxed = string_box(body, operation, wrapped)
        body.assign(operation.result, "spite_tagged_object({string_layout}, {boxed})")
        return
    }
    var scalar = shape.as_scalar(given)
    if scalar {
        var maker = tagged_maker(body, scalar.kind)
        body.assign(operation.result, "{maker}({wrapped})")
        return
    }
    var enumerated = shape.as_enum(given)
    if enumerated {
        var enum_maker = tagged_maker_named(body, enumerated.c_name)
        body.assign(operation.result, "{enum_maker}({wrapped})")
        return
    }
    var layout = naming.layout_of(given)
    if not layout {
        body.refuse("it puts a value into a tagged union whose class has no layout")
        return
    }
    var identity = naming.class_id_of(layout)
    body.assign(operation.result, "spite_tagged_object({identity}, (void*)({wrapped}))")
}

func string_identity(body: Body): Integer {
    var string_layout = lowered.layout_named("SpiteString")
    if not string_layout {
        body.refuse("text is put in a tagged union, and the program has no String layout")
        return 0
    }
    return naming.class_id_of(string_layout)
}

func string_box(body: Body, operation: Operation, wrapped: String): String {
    var number = body.operand_number(operation, 0)
    var literal = body.string_constants[number]
    if literal {
        var boxed = sites.boxed_literal(literal)
        return "((void*)&{boxed})"
    }
    output.need("string box")
    return "spite_box_SpiteString({wrapped})"
}

func tagged_maker(body: Body, kind: Analysis.Types.NumericKind): String {
    var value_class = "Spite{naming.scalar_label(kind)}"
    return tagged_maker_named(body, value_class)
}

func tagged_maker_named(body: Body, value_class: String): String {
    var layout = lowered.layout_named(value_class)
    if not layout {
        body.refuse("a number is put in a tagged union, and the program has no layout '{value_class}' to tag it with")
        return "spite_missing"
    }
    if not output.tagged_makers.contains(value_class) {
        output.tagged_makers.append(value_class)
    }
    return "spite_tagged_{value_class}"
}
