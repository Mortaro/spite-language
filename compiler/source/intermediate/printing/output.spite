var types = List<String>()
var nullable_types = List<String>()
var structs = List<String>()
var macros = List<String>()
var prototypes = List<String>()
var supports = List<String>()
var bodies = List<String>()
var places = List<String>()
var refusals = List<String>()
var needed = List<String>()
var literal_names = Dictionary<String, String>()
var literal_lines = List<String>()
var boxed_literals = List<String>()
var site_names = Dictionary<Integer, String>()
var site_lines = List<String>()
var nullable_labels = List<String>()
var tagged_makers = List<String>()
var framed_layouts = List<String>()
var copied_layouts = List<String>()
var printed_text = ""
var table_keys = List<String>()
var symbol_literals = List<String>()
var enum_readers = List<String>()
var value_boxes = List<String>()
var forwarders = List<String>()
var class_objects = List<String>()
var guards = List<String>()
var frames = List<String>()
var bound_functions = List<String>()
var read_guards = List<String>()
var foreign_libraries = List<String>()
var foreign_symbols = List<String>()
var foreign_headers = List<String>()
var table_names = List<String>()

func refuse(why: String) {
    if not refusals.contains(why) {
        refusals.append(why)
    }
}

func need(piece: String) {
    if not needed.contains(piece) {
        needed.append(piece)
    }
}

func needs(piece: String): Boolean {
    return needed.contains(piece)
}

func place(c_name: String, owner: String, name: String, line: Integer) {
    var where = escaped_place(owner)
    var named = escaped_place(name)
    places.append("\{(const void*)&{c_name}, \"{where}\", \"{named}\", {line}},")
}

func runtime_place(c_name: String) {
    places.append("\{(const void*)&{c_name}, \"-\\t-\", \"{c_name}\", 0},")
}

func escaped_place(text: String): String {
    var backslashes = text.replace("\\", "\\\\")
    var quotes = backslashes.replace("\"", "\\\"")
    return quotes.replace("\t", "\\t")
}

func table_name(layout: String, literal: String): String {
    var key = "{layout}|{literal}"
    var index = table_keys.index_of(key)
    if not index {
        return ""
    }
    crash table_names[index]
    return table_names[index]
}

func add_table(layout: String, literal: String, element: String): String {
    var name = "spite_table_{table_names.count()}"
    table_keys.append("{layout}|{literal}")
    table_names.append(name)
    var length = literal.length()
    var inner = literal.slice(1, length - 1)
    var pieces = inner.split(",")
    var count = pieces.count()
    if inner.trim().is_empty() {
        count = 0
    }
    literal_lines.append("static {element} {name}_items[{count} + 1] = \{ {inner} };")
    literal_lines.append(
        "static {layout} {name} = \{ .header = \{ 0, -1 }, .items_ = (int64_t)(intptr_t){name}_items, .item_count_ = {count}, .capacity_ = {count} };",
    )
    return name
}

func is_refused(): Boolean {
    return not refusals.is_empty()
}
