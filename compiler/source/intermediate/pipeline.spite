# ../../../design/proposals/desugared_high_ir.md#the-contracts-between-the-pieces
var generator: Generation.Generator? = null
var error_message = ""
var lowered = Lowered()
var reached_unions = List<String>()
var types = Analysis.TypeShape()
var optimized = false
var placed_allocators = List<String>()

func Pipeline(starting_generator: Generation.Generator) {
    generator = starting_generator
}

func run(): String {
    crash generator
    var lowering = Lowering(generator)
    lowered = lowering.lower()
    settle_settings()
    settle_layouts()
    lowered.runtime_roots = roots_of_runtime()
    var passes = Passes()
    passes.run(lowered)
    settle_held_layouts()
    var printer = Printer()
    var written = printer.print(lowered)
    var refused = printer.refusals()
    if not refused.is_empty() {
        error_message = "error: the C cannot be written from the high IR:\n{refused.join("\n")}"
        return ""
    }
    return written
}

func has_error(): Boolean {
    return not error_message.is_empty()
}

func settle_settings() {
    crash generator
    lowered.debug_memory = generator.debug_memory
    lowered.trace_asserts = generator.trace_asserts
    lowered.bare_crash_sites = generator.bare_crash_sites
    lowered.hot_reload = generator.hot_reload
    lowered.read_evaluate_print_loop = generator.read_evaluate_print_loop
    lowered.remote_loop = generator.remote_loop_port > 0
    lowered.development = generator.development
    lowered.optimized = optimized
    lowered.makes_threads = generator.builder.threads or generator.parallel_used
    lowered.makes_concurrents = generator.scheduler_used
    lowered.class_names = generator.class_names_by_id
    lowered.foreign_files = generator.foreign_library_files
    lowered.foreign_namings = generator.foreign_library_namings
    lowered.foreign_includes = List<String>()
    generator.foreign_library_headers.each(note_foreign_header)
    lowered.enums = generator.enums
}

func note_foreign_header(header: String) {
    if header.is_empty() {
        lowered.foreign_includes.append("")
        return
    }
    if File(header).exists() {
        var escaped = header.replace("\\", "\\\\")
        lowered.foreign_includes.append("#include \"{escaped}\"")
        return
    }
    lowered.foreign_includes.append("#include <{header}>")
}

func settle_layouts() {
    crash generator
    generator.classes.each(settle_value_class)
    lowered.layouts.each(settle_synthetic_value)
    reached_unions = List<String>()
    lowered.concrete_functions.each(note_function_types)
    lowered.layouts.each(note_layout_types)
    generator.unions.each(settle_union)
    lowered.concrete_functions.each(settle_schema)
}

func settle_value_class(information: Analysis.ClassInfo) {
    crash generator
    assert information.is_value_class
    var value_type = generator.value_class_type(information)
    var known = lowered.layout_named(information.c_name)
    if known {
        if not known.value_type {
            known.value_type = value_type
        }
        return
    }
    var made = Layout(information.c_name, information.qualified_dotted)
    made.information = information
    made.is_value = true
    made.value_type = value_type
    var index = 0
    while index < information.fields.count() {
        var declared = information.fields[index]
        var declared_type = declared.type
        var field = Field(declared.name, declared_type)
        made.stored_fields.append(field)
        index = index + 1
    }
    lowered.add_layout(made)
}

func settle_schema(function: Function) {
    crash generator
    assert function.intrinsic == "supplied" and function.source
    var source = function.source
    assert source.supplied_body.ends_with("the schema hash, written when the function is emitted */")
    var owner = lowered.layout_named(function.owner)
    assert owner and owner.information
    source.supplied_body = generator.schema_body(owner.information, source)
}

func settle_held_layouts() {
    var index = 0
    while index < lowered.layouts.count() {
        var layout = lowered.layouts[index]
        if layout.information {
            layout.information.codegen_types.each(settle_held)
        }
        index = index + 1
    }
}

func settle_held(held: Analysis.SpiteType) {
    crash generator
    var reference = types.as_class_ref(held)
    assert reference and not lowered.layout_named(reference.c_name)
    var information = generator.find_class_by_c_name(reference.c_name)
    assert information and not information.is_value_class and not information.is_generic_template and not information.is_singleton
    var made = Layout(information.c_name, information.qualified_dotted)
    made.information = information
    var index = 0
    while index < information.fields.count() {
        var declared = information.fields[index]
        var declared_type = declared.type
        var field = Field(declared.name, declared_type)
        made.stored_fields.append(field)
        index = index + 1
    }
    lowered.add_layout(made)
}

func settle_synthetic_value(layout: Layout) {
    crash generator
    assert layout.is_value and not layout.value_type
    if layout.c_name == "SpiteSymbol" {
        var symbol_type: Analysis.SpiteType = Analysis.Types.SymbolType()
        layout.value_type = symbol_type
        return
    }
    var index = 0
    while index < generator.enums.count() {
        var described = generator.enums[index]
        if described.c_name == layout.c_name {
            var enum_type: Analysis.SpiteType = Analysis.Types.EnumType(described.c_name, described.values)
            layout.value_type = enum_type
        }
        index = index + 1
    }
}

func roots_of_runtime(): List<String> {
    crash generator
    var roots = List<String>()
    if generator.debug_memory {
        note_roots(
            "AllocationTable",
            ["resize", "free", "register_object", "name_classes", "report", "live_allocations", "live_bytes"],
            roots,
        )
    }
    if not generator.foreign_library_files.is_empty() {
        note_roots("DynamicLibrary", ["DynamicLibrary", "find_symbol", "open_library", "close_library", "drop"], roots)
    }
    lowered.concrete_functions.each(note_placed_roots)
    lowered.concrete_functions.each(note_serving_roots)
    placed_allocators.each(roots.append)
    lowered.concrete_functions.each(note_pool_roots)
    if generator.scheduler_used {
        note_roots(
            "Scheduler",
            ["waits_here", "yield_now", "sleep", "offload", "offload_done", "timer_start", "timer_over", "joins", "offload_start", "offload_over"],
            roots,
        )
    }
    return roots
}

func note_serving_roots(function: Function) {
    crash generator
    assert function.name == "entry_address"
    var owner = generator.find_class_by_c_name(function.owner)
    assert owner
    var serving = owner.find_function("_serve")
    if serving and not placed_allocators.contains(serving.c_name) {
        placed_allocators.append(serving.c_name)
    }
}

func note_pool_roots(function: Function) {
    crash generator
    var index = 0
    while index < function.blocks.count() {
        var block = function.blocks[index]
        var position = 0
        while position < block.operations.count() {
            var operation = block.operations[position]
            if operation.callee == "Bands.run" or operation.callee == "Rows.run" {
                var pool = generator.find_class_by_qualified("ThreadPool")
                assert pool
                note_pool(pool, "run_bands")
                note_pool(pool, "submit")
                note_pool(pool, "join")
            }
            position = position + 1
        }
        index = index + 1
    }
}

func note_pool(pool: Analysis.ClassInfo, name: String) {
    var found = pool.find_function(name)
    if found and not placed_allocators.contains(found.c_name) {
        placed_allocators.append(found.c_name)
    }
}

func note_placed_roots(function: Function) {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.operations.count() {
            var operation = block.operations[index]
            if operation.callee == "Object.place" and operation.operands.count() == 2 {
                var allocator = function.value_at(operation.operands[1])
                note_allocator(allocator.spite_type)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func note_allocator(allocator_type: Analysis.SpiteType?) {
    crash generator
    assert allocator_type
    var reference = types.as_class_ref(allocator_type)
    assert reference
    var owner = generator.find_class_by_c_name(reference.c_name)
    assert owner
    var allocating = owner.find_function("allocate")
    var freeing = owner.find_function("free")
    if allocating and not placed_allocators.contains(allocating.c_name) {
        placed_allocators.append(allocating.c_name)
    }
    if freeing and not placed_allocators.contains(freeing.c_name) {
        placed_allocators.append(freeing.c_name)
    }
}

func note_roots(qualified: String, names: List<String>, roots: List<String>) {
    crash generator
    var owner = generator.find_class_by_qualified(qualified)
    assert owner
    var index = 0
    while index < names.count() {
        var found = owner.find_function(names[index])
        if found and not found.c_name.is_empty() {
            roots.append(found.c_name)
        }
        index = index + 1
    }
    index = 0
    while index < lowered.concrete_functions.count() {
        var made = lowered.concrete_functions[index]
        if made.singleton_of == owner.c_name {
            roots.append(made.c_name)
        }
        index = index + 1
    }
}

func note_function_types(function: Function) {
    var index = 0
    while index < function.values.count() {
        var value = function.values[index]
        note_type(value.spite_type)
        index = index + 1
    }
    note_type(function.answer)
}

func note_layout_types(layout: Layout) {
    var index = 0
    while index < layout.stored_fields.count() {
        var field = layout.stored_fields[index]
        note_type(field.spite_type)
        index = index + 1
    }
}

func note_type(spite_type: Analysis.SpiteType?) {
    assert spite_type
    var united = types.as_union(spite_type)
    if united {
        if not reached_unions.contains(united.c_name) {
            reached_unions.append(united.c_name)
        }
        return
    }
    var nullable = types.as_nullable(spite_type)
    if nullable {
        note_type(nullable.inner)
        return
    }
    var listed = types.as_list(spite_type)
    if listed {
        note_type(listed.element)
        return
    }
    var dictionary = types.as_dictionary(spite_type)
    assert dictionary
    note_type(dictionary.element)
    note_type(dictionary.key)
}

func settle_union(described: Analysis.UnionInfo) {
    assert reached_unions.contains(described.c_name) and not lowered.layout_named(described.c_name)
    var qualified = described.simple_name
    if not described.owner_qualified.is_empty() {
        qualified = "{described.owner_qualified}.{described.simple_name}"
    }
    var made = Layout(described.c_name, qualified)
    made.kind = "union"
    if described.is_tagged {
        made.kind = "tagged union"
    }
    made.members = described.members.map_c_names()
    lowered.add_layout(made)
}
