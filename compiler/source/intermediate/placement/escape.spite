# ../../../../docs/proofs.md#objects-that-never-leave-their-function-live-in-the-frame
var lowered: Lowered? = null
var intrinsics: Facts.Intrinsics? = null
var consumption: Ownership.Consumption? = null
var keeps_receiver = Dictionary<String, Boolean>()
var keeps_parameter = Dictionary<String, Boolean>()
var studying = Dictionary<String, Boolean>()
var closed_parameter = Dictionary<String, Boolean>()
var closing = Dictionary<String, Boolean>()

func Escape(starting_lowered: Lowered) {
    lowered = starting_lowered
    var made_intrinsics = Facts.Intrinsics(starting_lowered)
    intrinsics = made_intrinsics
    var made_consumption = Ownership.Consumption(starting_lowered)
    consumption = made_consumption
}

func function_keeps(c_name: String, position: Integer): Boolean {
    crash lowered
    var key = "{c_name}#{position}"
    if keeps_parameter.has(key) {
        return keeps_parameter[key] == true
    }
    if studying.has(key) {
        return true
    }
    var callee = lowered.function_named(c_name)
    if not callee {
        return true
    }
    if callee.is_intrinsic() {
        return supplied_keeps(callee, position)
    }
    if callee.blocks.is_empty() {
        return true
    }
    studying[key] = true
    var value = callee.receiver
    if position >= 0 {
        value = parameter_value(callee, position)
    }
    var answer = value < 0 or escapes(callee, value)
    studying.remove(key)
    keeps_parameter[key] = answer
    return answer
}

func parameter_value(callee: Function, position: Integer): Integer {
    if position >= callee.parameters.count() {
        return -1
    }
    return callee.parameters[position].value
}

func escapes(function: Function, value: Integer): Boolean {
    crash consumption
    consumption.current = function
    var uses = Facts.Uses(function)
    return escapes_through(function, uses, value, 0)
}

# ../../../../docs/optimizations.md#objects-that-never-leave-their-function-live-in-the-frame
func container_of(function: Function, value: Integer, framed: Dictionary<Integer, Boolean>): Integer {
    crash consumption
    consumption.current = function
    var uses = Facts.Uses(function)
    var reached = uses.uses_of(value)
    var found = -1
    var index = 0
    while index < reached.count() {
        var place = reached[index]
        if place.at_terminator() {
            return -1
        }
        var block = function.block_at(place.block)
        crash block.operations[place.position]
        var operation = block.operations[place.position]
        var stored = operation.kind == "store" and operation.operands.last() == value and operation.operands.first() != value
        if stored {
            var target = operation.operands.first()
            crash target
            var defining = uses.definition_of(target)
            var inside = false
            if defining and defining.kind == "make" {
                inside = framed.has(target)
            }
            if not inside or found >= 0 and found != target {
                return -1
            }
            found = target
        } else if escapes_at(function, uses, place, value, 0) {
            return -1
        }
        index = index + 1
    }
    if found >= 0 and not container_closed(function, uses, found, 0) {
        return -1
    }
    return found
}

# ../../../../docs/optimizations.md#objects-that-never-leave-their-function-live-in-the-frame
func container_closed(function: Function, uses: Facts.Uses, container: Integer, depth: Integer): Boolean {
    crash consumption
    crash intrinsics
    if depth > 8 {
        return false
    }
    var safe = ["Function.bind", "Function.add_arguments", "Union.tag", "Nullable.has"]
    var reached = uses.uses_of(container)
    var index = 0
    while index < reached.count() {
        var place = reached[index]
        if place.at_terminator() {
            return false
        }
        var block = function.block_at(place.block)
        crash block.operations[place.position]
        var operation = block.operations[place.position]
        if not use_keeps_container_closed(function, uses, operation, container, safe, depth) {
            return false
        }
        index = index + 1
    }
    return true
}

func use_keeps_container_closed(
    function: Function,
    uses: Facts.Uses,
    operation: Operation,
    container: Integer,
    safe: List<String>,
    depth: Integer,
): Boolean {
    crash consumption
    if operation.kind == "retain" or operation.kind == "release" {
        return true
    }
    if operation.kind == "store" {
        return operation.operands.last() != container
    }
    if operation.kind == "load" {
        return not escapes_through(function, uses, operation.result, depth + 1)
    }
    if operation.kind == "call value" {
        return operation.operands.first() == container and occurrences(operation.operands, container) == 1
    }
    if operation.kind != "call" {
        return false
    }
    if consumption.is_projection(operation) or consumption.is_wrap(operation) {
        return operation.result >= 0 and container_closed(function, uses, operation.result, depth + 1)
    }
    if safe.contains(operation.callee) and operation.operands.first() == container {
        return true
    }
    crash intrinsics
    if intrinsics.is_dotted(operation.callee) {
        return false
    }
    var index = 0
    while index < operation.operands.count() {
        if operation.operands[index] == container and not callee_closed(operation, index) {
            return false
        }
        index = index + 1
    }
    return true
}

func occurrences(values: List<Integer>, wanted: Integer): Integer {
    var found = 0
    var index = 0
    while index < values.count() {
        if values[index] == wanted {
            found = found + 1
        }
        index = index + 1
    }
    return found
}

func callee_closed(operation: Operation, position: Integer): Boolean {
    crash lowered
    crash consumption
    var callee = lowered.function_named(operation.callee)
    if not callee or callee.is_intrinsic() or callee.blocks.is_empty() {
        return false
    }
    var slot = position - 1
    if callee.receiver < 0 {
        slot = position
    }
    var key = "{operation.callee}#{slot}"
    if closed_parameter.has(key) {
        return closed_parameter[key] == true
    }
    if closing.has(key) {
        return false
    }
    var value = callee.receiver
    if slot >= 0 {
        value = parameter_value(callee, slot)
    }
    if value < 0 {
        return false
    }
    closing[key] = true
    var previous = consumption.current
    consumption.current = callee
    var inside = Facts.Uses(callee)
    var answer = container_closed(callee, inside, value, 1)
    consumption.current = previous
    closing.remove(key)
    closed_parameter[key] = answer
    return answer
}

func escapes_but_jumps(function: Function, value: Integer): Boolean {
    crash consumption
    consumption.current = function
    var uses = Facts.Uses(function)
    var reached = uses.uses_of(value)
    var index = 0
    while index < reached.count() {
        var place = reached[index]
        if not place.at_terminator() and escapes_at(function, uses, place, value, 0) {
            return true
        }
        index = index + 1
    }
    return false
}

func escapes_through(function: Function, uses: Facts.Uses, value: Integer, depth: Integer): Boolean {
    if depth > 8 {
        return true
    }
    var reached = uses.uses_of(value)
    var index = 0
    while index < reached.count() {
        if escapes_at(function, uses, reached[index], value, depth) {
            return true
        }
        index = index + 1
    }
    return false
}

func escapes_at(function: Function, uses: Facts.Uses, place: Facts.Place, value: Integer, depth: Integer): Boolean {
    crash consumption
    var block = function.block_at(place.block)
    if place.at_terminator() {
        var terminator = block.terminator
        return terminator.kind == "return" or terminator.kind == "halt" or not terminator.targets.is_empty()
    }
    crash block.operations[place.position]
    var operation = block.operations[place.position]
    if operation.kind == "retain" or operation.kind == "release" or operation.kind == "load" {
        return false
    }
    if consumption.is_projection(operation) and operation.result >= 0 {
        return escapes_through(function, uses, operation.result, depth + 1)
    }
    if operation.kind == "store" {
        return operation.operands.last() == value and not stored_into_borrowing_row(function, uses, operation, depth)
    }
    if operation.kind == "call value" {
        return value_kept_by_call_value(operation, value)
    }
    if operation.kind != "call" {
        return true
    }
    return call_keeps(function, uses, operation, value, depth)
}

func stored_into_borrowing_row(function: Function, uses: Facts.Uses, operation: Operation, depth: Integer): Boolean {
    crash consumption
    var target = operation.operands.first()
    if not target or depth > 4 {
        return false
    }
    var defining = uses.definition_of(target)
    if not defining or defining.kind != "make" or not consumption.is_row_value(function, target) {
        return false
    }
    return not escapes_through(function, uses, target, depth + 1) and container_closed(function, uses, target, depth + 1)
}

func value_kept_by_call_value(operation: Operation, value: Integer): Boolean {
    var index = 1
    while index < operation.operands.count() {
        if operation.operands[index] == value {
            return true
        }
        index = index + 1
    }
    return false
}

func call_keeps(function: Function, uses: Facts.Uses, operation: Operation, value: Integer, depth: Integer): Boolean {
    crash intrinsics
    crash consumption
    if operation.callee == "Function.bind" {
        return operation.operands.first() != value
    }
    if intrinsics.is_dotted(operation.callee) {
        return derived_escapes(function, uses, operation, depth)
    }
    var index = 0
    while index < operation.operands.count() {
        if operation.operands[index] == value and position_keeps(operation, index) {
            return true
        }
        index = index + 1
    }
    return false
}

func derived_escapes(function: Function, uses: Facts.Uses, operation: Operation, depth: Integer): Boolean {
    crash intrinsics
    crash consumption
    var meaning = intrinsics.operation_part(operation.callee)
    var owner = intrinsics.type_part(operation.callee)
    if owner == "Address" and (meaning == "sum" or meaning == "subtract") and operation.result >= 0 {
        return escapes_through(function, uses, operation.result, depth + 1)
    }
    var wrapping = ["Nullable.wrap", "Union.wrap"]
    if wrapping.contains(operation.callee) {
        var wrapped = operation.operands.first()
        if operation.result < 0 or not wrapped or not consumption.is_row_value(function, wrapped) {
            return true
        }
        return escapes_through(function, uses, operation.result, depth + 1)
    }
    var aliasing = ["Symbol.text"]
    if aliasing.contains(operation.callee) and operation.result >= 0 {
        return escapes_through(function, uses, operation.result, depth + 1)
    }
    var keeping = ["Function.bind", "Object.place"]
    return keeping.contains(operation.callee) or owner == "Foreign"
}

func position_keeps(operation: Operation, position: Integer): Boolean {
    crash consumption
    if copies_item(operation, position) {
        return false
    }
    crash lowered
    var callee = lowered.function_named(operation.callee)
    if callee and callee.receiver < 0 {
        return function_keeps(operation.callee, position)
    }
    return function_keeps(operation.callee, position - 1)
}

func supplied_keeps(callee: Function, position: Integer): Boolean {
    crash intrinsics
    if position < 0 {
        return false
    }
    if intrinsics.is_reading_name(callee.name) {
        return false
    }
    if not intrinsics.is_memory_write_name(callee.name) or position >= callee.parameters.count() {
        return true
    }
    return callee.parameters[position].name == "value"
}

# ../../../../docs/optimizations.md#other-optimisations
func copies_item(operation: Operation, position: Integer): Boolean {
    crash lowered
    var callee = lowered.function_named(operation.callee)
    if not callee or callee.intrinsic != "supplied" or callee.name != "write_item" or position != 3 {
        return false
    }
    var owner = lowered.layout_named(callee.owner)
    if not owner {
        return false
    }
    return owner.qualified == "InlineMemory"
}
