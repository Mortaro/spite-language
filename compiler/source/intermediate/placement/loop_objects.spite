# ../../../../docs/optimizations.md#objects-that-never-leave-their-function-live-in-the-frame
var lowered: Lowered? = null
var results: ResultSlots? = null
var escape: Escape? = null
var kinds: Facts.ValueKinds? = null
var carried = Dictionary<Integer, Boolean>()
var rewritten_count = 0

func LoopObjects(starting_lowered: Lowered, starting_results: ResultSlots, starting_escape: Escape) {
    lowered = starting_lowered
    results = starting_results
    escape = starting_escape
    var made_kinds = Facts.ValueKinds(starting_lowered)
    kinds = made_kinds
}

func rewrite(function: Function) {
    crash lowered
    carried = Dictionary<Integer, Boolean>()
    assert not lowered.is_inspectable() and not function.blocks.is_empty() and not function.resumable and not function.waits
    var rounds = 0
    while rounds < 8 and rewrite_one(function) {
        rounds = rounds + 1
    }
}

func rewrite_one(function: Function): Boolean {
    var flow = Facts.Flow(function)
    var uses = Facts.Uses(function)
    var header_number = 0
    while header_number < function.blocks.count() {
        var header = function.blocks[header_number]
        var at = 0
        while at < header.parameters.count() {
            if rewrite_carried(function, flow, uses, header_number, at) {
                return true
            }
            at = at + 1
        }
        header_number = header_number + 1
    }
    return false
}

func rewrite_carried(
    function: Function,
    flow: Facts.Flow,
    uses: Facts.Uses,
    header_number: Integer,
    at: Integer,
): Boolean {
    crash results
    crash kinds
    crash lowered
    var header = function.block_at(header_number)
    var parameter = header.parameters[at]
    crash parameter
    var described = function.value_at(parameter)
    var layout = kinds.layout_of(described.spite_type)
    if not layout or layout.kind != "class" or not results.holds_only_plain(layout.c_name) or not kinds.class_is_counted(layout.c_name) {
        return false
    }
    var entry = -1
    var latch = -1
    var latch_block = -1
    var entries = 0
    var latches = 0
    var coming = flow.predecessors_of(header_number)
    var index = 0
    while index < coming.count() {
        var from = coming[index]
        var targets = function.block_at(from).terminator.targets
        var target_index = 0
        while target_index < targets.count() {
            var target = targets[target_index]
            if target.block == header_number {
                var passed = target.arguments[at]
                crash passed
                if flow.is_back_edge(from, header_number) {
                    latches = latches + 1
                    latch = passed
                    latch_block = from
                } else {
                    entries = entries + 1
                    entry = passed
                }
            }
            target_index = target_index + 1
        }
        index = index + 1
    }
    if entries != 1 or latches != 1 or entry < 0 or latch < 0 {
        return false
    }
    var made = uses.definition_of(entry)
    if not made or made.kind != "make" or made.layout != layout.c_name or not made.form.is_empty() {
        return false
    }
    if not only_kept_by_jump(function, uses, entry) {
        return false
    }
    var call = uses.definition_of(latch)
    if not call or call.kind != "call" or call.result != latch {
        return false
    }
    var callee = lowered.function_named(call.callee)
    if not callee or results.fresh_layout(callee) != layout.c_name {
        return false
    }
    if not only_kept_by_latch(function, uses, latch, latch_block) {
        return false
    }
    if not only_read_in_loop(function, uses, parameter) {
        return false
    }
    made.form = "frame"
    carried[entry] = true
    carried[parameter] = true
    redirect_call(function, call, callee, layout, parameter, described.spite_type)
    copy_at_returns(function, parameter, layout, described.spite_type)
    rewritten_count = rewritten_count + 1
    return true
}

func only_kept_by_jump(function: Function, uses: Facts.Uses, value: Integer): Boolean {
    crash escape
    var reached = uses.uses_of(value)
    var index = 0
    while index < reached.count() {
        var place = reached[index]
        if place.at_terminator() {
            if function.block_at(place.block).terminator.kind != "jump" {
                return false
            }
        } else if escape.escapes_at(function, uses, place, value, 0) {
            return false
        }
        index = index + 1
    }
    return true
}

func only_kept_by_latch(function: Function, uses: Facts.Uses, value: Integer, latch_block: Integer): Boolean {
    crash escape
    var reached = uses.uses_of(value)
    var jumps = 0
    var index = 0
    while index < reached.count() {
        var place = reached[index]
        if place.at_terminator() {
            if place.block != latch_block or function.block_at(place.block).terminator.kind != "jump" {
                return false
            }
            jumps = jumps + 1
        } else if escape.escapes_at(function, uses, place, value, 0) {
            return false
        }
        index = index + 1
    }
    return jumps == 1
}

func only_read_in_loop(function: Function, uses: Facts.Uses, value: Integer): Boolean {
    crash escape
    var reached = uses.uses_of(value)
    var index = 0
    while index < reached.count() {
        var place = reached[index]
        if place.at_terminator() {
            var ending = function.block_at(place.block).terminator
            if ending.kind != "return" and ending.kind != "jump" {
                return false
            }
            if ending.kind == "jump" and ending.targets.count() != 1 {
                return false
            }
        } else if escape.escapes_at(function, uses, place, value, 0) {
            return false
        }
        index = index + 1
    }
    return true
}

func redirect_call(
    function: Function,
    call: Operation,
    callee: Function,
    layout: Layout,
    parameter: Integer,
    result_type: Analysis.SpiteType?,
) {
    crash results
    var block_number = block_of_call(function, call)
    var block = function.block_at(block_number)
    var copy_name = results.into_copy(callee)
    var slot = Operation("make", call.line)
    slot.layout = layout.c_name
    slot.form = "frame"
    slot.spite_type = result_type
    slot.result = function.new_value(result_type, "operation")
    function.value_at(slot.result).block = block_number
    carried[slot.result] = true
    Facts.Rewrites().replace_value(function, call.result, parameter)
    call.takes(slot.result)
    call.callee = copy_name
    call.result = -1
    call.spite_type = Analysis.Types.VoidType()
    var rebuilt = List<Operation>()
    var index = 0
    while index < block.operations.count() {
        var operation = block.operations[index]
        if operation == call {
            rebuilt.append(slot)
            rebuilt.append(operation)
            append_field_copies(function, block_number, slot.result, parameter, layout, call.line, rebuilt)
        } else {
            rebuilt.append(operation)
        }
        index = index + 1
    }
    block.operations = rebuilt
}

func block_of_call(function: Function, call: Operation): Integer {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.operations.count() {
            if block.operations[index] == call {
                return block_index
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return 0
}

func append_field_copies(
    function: Function,
    block_number: Integer,
    source: Integer,
    target: Integer,
    layout: Layout,
    line: Integer,
    rebuilt: List<Operation>,
) {
    var index = 0
    while index < layout.stored_fields.count() {
        var field = layout.stored_fields[index]
        var read = Operation("load", line)
        read.takes(source)
        read.field = field.name
        read.spite_type = field.spite_type
        read.result = function.new_value(field.spite_type, "operation")
        function.value_at(read.result).block = block_number
        rebuilt.append(read)
        var write = Operation("store", line)
        write.takes(target)
        write.takes(read.result)
        write.field = field.name
        write.spite_type = field.spite_type
        rebuilt.append(write)
        index = index + 1
    }
}

func copy_at_returns(function: Function, parameter: Integer, layout: Layout, result_type: Analysis.SpiteType?) {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var returned = block.terminator.operands.first()
        if block.terminator.kind == "return" and returned == parameter {
            var heap = Operation("make", 0)
            heap.layout = layout.c_name
            heap.spite_type = result_type
            heap.result = function.new_value(result_type, "operation")
            function.value_at(heap.result).block = block_index
            block.operations.append(heap)
            var copies = List<Operation>()
            append_field_copies(function, block_index, parameter, heap.result, layout, 0, copies)
            copies.each(block.operations.append)
            var answer = List<Integer>()
            answer.append(heap.result)
            block.terminator.operands = answer
        }
        block_index = block_index + 1
    }
}
