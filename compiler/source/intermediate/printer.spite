# ../../../design/proposals/desugared_high_ir.md#the-contracts-between-the-pieces
var output = Intermediate.Printing.Output()
var naming = Intermediate.Printing.Naming()
var sites = Intermediate.Printing.Sites()
var intrinsics = Intermediate.Printing.Intrinsics()
var body = Intermediate.Printing.Body()
var layouts = Intermediate.Printing.Layouts()
var runtime = Intermediate.Printing.Runtime()
var copies = Intermediate.Printing.Copies()
var machines = Intermediate.Printing.Machines()
var hot = Intermediate.Printing.Hot()
var hot_manifest = ""

func print(lowered: Lowered): String {
    print_pieces(lowered)
    var written = assembled(lowered)
    note_reached(lowered)
    if lowered.hot_reload {
        hot_manifest = hot.manifest()
    }
    return written
}

# ../../../docs/repl.md#how-it-works
func print_library(
    lowered: Lowered,
    reload: Generation.HotReloadLibrary,
    owners: List<String>,
    rebuilt: List<String>,
): String {
    crash lowered.hot_reload
    print_pieces(lowered)
    note_hot_exports()
    var types = types_text()
    var hot_prototypes = hot.prototypes()
    var prototypes = prototypes_text()
    var declared = "{hot_prototypes}\n{prototypes}"
    var runtime_text = supports_text(lowered, "", false)
    var faults = runtime.faults()
    var written = hot.library(reload, owners, rebuilt, types, declared, "{runtime_text}\n{faults}")
    hot_manifest = hot.manifest()
    return written
}

func note_hot_exports() {
    var lines = [
        "void spite_live_add(SpiteLiveSet* set, void* object, int64_t* place);"
        "void spite_live_remove(SpiteLiveSet* set, void* object, int64_t* place);"
        "void spite_world_enter(void);"
        "void spite_world_leave(void);"
        "void spite_world_park(void);"
        "int32_t spite_world_stop(void);"
        "void spite_world_start(void);"
        "void* spite_hot_realloc(void* pointer, size_t size);"
        "void spite_hot_free(void* pointer);"
        "int64_t* spite_machine_frames(const char* name, const char* shown);"
        "void spite_settings_reread(void);"
    ]
    if output.needs("singletons") {
        var singletons = runtime.singleton_prototypes()
        var singleton_lines = singletons.split("\n")
        var index = 0
        while index < singleton_lines.count() {
            lines.append(singleton_lines[index])
            index = index + 1
        }
    }
    hot.extra_exports = lines
}

func hot_refusals(): List<String> {
    return hot.problems
}

func print_pieces(lowered: Lowered) {
    wire(lowered)
    refuse_unbuilt(lowered)
    lowered.enums.each(layouts.print_enum)
    lowered.layouts.each(note_slots)
    lowered.layouts.each(note_weak)
    lowered.concrete_functions.each(body.print)
    var macros = output.macros.join(" ")
    var bodies = output.bodies.join(" ")
    output.printed_text = "{macros} {bodies}"
    lowered.enums.each(layouts.print_enum_names)
    lowered.layouts.each(layouts.print)
    note_nothing_default()
    note_loop_tables(lowered)
    note_maths()
}

func note_slots(layout: Layout) {
    assert layout.arrangement == "slots" and layout.information
    var element = layout.information.codegen_types.first()
    assert element
    var inner = naming.label(element)
    if not output.slot_inners.contains(inner) {
        output.slot_inners.append(inner)
    }
}

func note_weak(layout: Layout) {
    assert layout.qualified == "Weak" and layout.information
    var element = layout.information.codegen_types.first()
    assert element
    var held = naming.label(element)
    if not output.weak_classes.contains(held) {
        output.weak_classes.append(held)
    }
}

func weak_defines(): String {
    var lines = List<String>()
    var index = 0
    while index < output.weak_classes.count() {
        lines.append("#define SPITE_WEAK_{output.weak_classes[index]} 1")
        index = index + 1
    }
    return lines.join("\n")
}

func refusals(): List<String> {
    return output.refusals
}

func wire(lowered: Lowered) {
    var made = Intermediate.Printing.Output()
    output = made
    naming.output = made
    naming.lowered = lowered
    sites.output = made
    sites.lowered = lowered
    sites.naming = naming
    intrinsics.output = made
    intrinsics.lowered = lowered
    intrinsics.naming = naming
    intrinsics.sites = sites
    copies.output = made
    copies.lowered = lowered
    copies.naming = naming
    hot = Intermediate.Printing.Hot()
    hot.output = made
    hot.lowered = lowered
    hot.naming = naming
    body.hot = hot
    layouts.hot = hot
    copies.made = List<String>()
    copies.table_written = false
    intrinsics.copies = copies
    machines.output = made
    machines.lowered = lowered
    machines.naming = naming
    machines.primitives = List<String>()
    body.machines = machines
    body.output = made
    body.lowered = lowered
    body.naming = naming
    body.sites = sites
    body.intrinsics = intrinsics
    layouts.output = made
    layouts.lowered = lowered
    layouts.naming = naming
    runtime.output = made
    runtime.lowered = lowered
    runtime.naming = naming
}

func refuse_unbuilt(lowered: Lowered) {
    if lowered.remote_loop {
        output.refuse("the program serves a REPL port, which the printer does not write yet")
    }
    if lowered.entry == "main" {
        output.refuse("the program starts at a function named 'main', which is the name of C's own entry")
    }
}

func assembled(lowered: Lowered): String {
    var types = types_text()
    var declared = prototypes_text()
    var supports = output.supports.join("\n")
    var supported = supports_text(lowered, supports, true)
    var bodies = output.bodies.join("\n")
    if lowered.hot_reload {
        note_hot_exports()
        var hot_prototypes = hot.prototypes()
        var hot_supports = hot.supports()
        var closing = hot.closing()
        declared = "{hot_prototypes}\n{declared}"
        supported = "{hot_supports}\n{supported}"
        bodies = "{bodies}\n{closing}"
    }
    return "{types}\n{declared}\n{supported}\n{bodies}\n{runtime.faults()}\n{runtime.main_function()}\n"
}

func types_text(): String {
    var types = output.types.join("\n")
    var nullable_types = output.nullable_types.join("\n")
    var structs = output.structs.join("\n")
    var frames = output.frames.join("\n")
    if output.needs("machines") {
        frames = "{machines.runtime_types()}\n{frames}"
    }
    var site_lines = output.site_lines.join("\n")
    var literal_lines = output.literal_lines.join("\n")
    var macros = output.macros.join("\n")
    var headers = output.foreign_headers.join("\n")
    var weak = weak_defines()
    headers = "{headers}\n{weak}"
    return "{runtime.defines()}\n{runtime.header()}\n{headers}\n{runtime.early_types()}\n{runtime.assert_ring()}\n{runtime.string_layout()}\n{types}\n{runtime.prelude.structs()}\n{nullable_types}\n{structs}\n{frames}\n{site_lines}\n{literal_lines}\n{macros}"
}

func prototypes_text(): String {
    var singletons = ""
    if output.needs("singletons") {
        singletons = runtime.singleton_prototypes()
    }
    var prototypes = output.prototypes.join("\n")
    return "{runtime.string_prototypes()}\n{runtime.prelude.prototypes()}\n{singletons}\n{prototypes}"
}

func supports_text(lowered: Lowered, printed_supports: String, with_singletons: Boolean): String {
    var reporters = runtime.reporters()
    var helpers = runtime.helpers()
    var reported = reporters.join("\n")
    var helped = helpers.join("\n")
    var singletons = ""
    if with_singletons and output.needs("singletons") {
        singletons = runtime.singleton_supports()
    }
    var table = ""
    if lowered.debug_memory {
        table = runtime.allocation_table()
    }
    var supports = printed_supports
    if not output.weak_classes.is_empty() {
        var weak_runtime = runtime.weak_runtime()
        supports = "static void spite_weak_object_freed(void* object);\n{weak_runtime}\n{supports}"
    }
    var libraries = runtime.foreign_libraries()
    if output.needs("machines") {
        var machine_runtime = machines.runtime_bodies()
        libraries = "{libraries}\n{machine_runtime}"
    }
    var guards = ""
    if output.needs("guards") {
        guards = runtime.guard_runtime()
    }
    var library_prototypes = foreign_prototypes()
    return "{reported}\n{helped}\n{runtime.string_supports()}\n{runtime.prelude.bodies()}\n{table}\n{singletons}\n{guards}\n{library_prototypes}\n{supports}\n{libraries}"
}

func foreign_prototypes(): String {
    var lines = List<String>()
    var index = 0
    while index < output.foreign_libraries.count() {
        lines.append("DynamicLibrary* spite_foreign_library_{output.foreign_libraries[index]}(void);")
        index = index + 1
    }
    return lines.join("\n")
}

func note_loop_tables(lowered: Lowered) {
    assert output.printed_text.contains("spite_loop_class_names") or output.printed_text.contains("spite_loop_enum_names") or output.printed_text.contains("spite_loop_class_descriptions")
    var class_names = naming.escape_c(lowered.loop_class_names)
    var enum_names = naming.escape_c(lowered.loop_enum_names)
    var descriptions = naming.escape_c(lowered.loop_class_descriptions)
    output.prototypes.append("SpiteString spite_loop_class_names(void);")
    output.prototypes.append("SpiteString spite_loop_enum_names(void);")
    output.prototypes.append("SpiteString spite_loop_class_descriptions(void);")
    output.support(
        "SpiteString spite_loop_class_names(void) \{ return spite_string_from_cstring_owned(\"{class_names}\"); }",
    )
    output.support(
        "SpiteString spite_loop_enum_names(void) \{ return spite_string_from_cstring_owned(\"{enum_names}\"); }",
    )
    output.support(
        "SpiteString spite_loop_class_descriptions(void) \{ return spite_string_from_cstring_owned(\"{descriptions}\"); }",
    )
}

func note_nothing_default() {
    assert output.printed_text.contains("Nothing___default(")
    var nothing = naming.lowered.layout_named("Nothing")
    if not nothing {
        output.refuse("a concurrent call answers Nothing, and the program holds no Nothing layout")
        return
    }
    var made = "Nothing___allocate()"
    if nothing.is_singleton {
        made = "{runtime.maker_of("Nothing")}()"
    }
    output.prototypes.append("static Nothing* Nothing___default(void);")
    output.support("static Nothing* Nothing___default(void) \{ return {made}; }")
}

func note_maths() {
    var names = [
        "sqrt"
        "sin("
        "sinf("
        "cos("
        "cosf("
        "tan("
        "tanf("
        "asin"
        "acos"
        "atan"
        "pow("
        "powf("
        "exp("
        "expf("
        "exp2"
        "log("
        "logf("
        "log2"
        "log10"
        "floor("
        "floorf("
        "ceil("
        "ceilf("
        "round("
        "roundf("
        "trunc("
        "truncf("
        "fmod"
        "fabs"
        "isnan"
        "isinf"
        "isfinite"
        "fmin"
        "fmax"
        "cbrt"
        "hypot"
    ]
    if names.any(output.printed_text.contains) {
        output.need("maths")
    }
}

func note_reached(lowered: Lowered) {
    var index = 0
    while index < lowered.concrete_functions.count() {
        var reached = lowered.concrete_functions[index]
        if reached.intrinsic == "supplied" and reached.source {
            note_supplied_needs(reached.c_name, reached.source.supplied_body)
        }
        index = index + 1
    }
}

func note_supplied_needs(c_name: String, supplied: String) {
    if output.weak_classes.is_empty() and supplied.contains("spite_weak_box_of") {
        output.refuse("the supplied body of '{c_name}' reaches a Weak reference whose layout the program does not hold")
    }
    var rest = supplied
    while rest.contains("___make(") {
        var at = rest.index_of("___make(")
        var start = at
        while start > 0 and is_name_at(rest, start - 1) {
            start = start - 1
        }
        var made = rest.slice(start, at)
        if not made.is_empty() and not output.defined.has("{made}___make") {
            output.refuse(
                "the supplied body of '{c_name}' makes '{made}' through '{made}___make', which the lowering does not write",
            )
        }
        var rest_length = rest.length()
        rest = rest.slice(at + 8, rest_length)
    }
}

func is_name_at(text: String, index: Integer): Boolean {
    var code = text.code_at(index)
    return code == 95 or code >= 48 and code <= 57 or code >= 65 and code <= 90 or code >= 97 and code <= 122
}
