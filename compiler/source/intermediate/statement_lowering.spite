# ../../../design/proposals/desugared_high_ir.md#lowering-a-body
var emitter = Emitter()
var expressions: ExpressionLowering? = null
var lowered_class = Analysis.ClassInfo("", "", "", "", 0)
var shapes = Analysis.AstShape()
var types = Analysis.TypeShape()
var site_ordinal = 0

func StatementLowering(starting_expressions: ExpressionLowering) {
    expressions = starting_expressions
    emitter = starting_expressions.emitter
    lowered_class = starting_expressions.lowered_class
}

func lowering(): ExpressionLowering {
    crash expressions
    return expressions
}

func front(): Generation.Generator {
    return lowering().front()
}

func known(): Instances {
    return lowering().known()
}

func lower_block(statements: List<Syntax.Statements.Statement>) {
    emitter.push_frame()
    lower_statements(statements)
    emitter.pop_frame()
}

func lower_statements(statements: List<Syntax.Statements.Statement>) {
    var made = front()
    var index = 0
    while index < statements.count() and emitter.reachable() and not emitter.lowering_failed() {
        made.borrow_statements = statements
        made.borrow_index = index
        var current = statements[index]
        check_statement_lints(statements, index)
        lower_statement(current)
        index = index + 1
    }
}

func statement_at(statements: List<Syntax.Statements.Statement>, index: Integer): Syntax.Statements.Statement? {
    return statements[index]
}

func check_statement_lints(statements: List<Syntax.Statements.Statement>, index: Integer) {
    check_returned_local(statements, index)
    check_value_chain(statements, index)
    check_template_walk(statements, index)
}

func check_template_walk(statements: List<Syntax.Statements.Statement>, index: Integer) {
    assert index > 0
    var lowered_expressions = lowering()
    var flow = lowered_expressions.flow_checks()
    flow.template_walk_at(statements, index, lowered_expressions)
}

func check_returned_local(statements: List<Syntax.Statements.Statement>, index: Integer) {
    assert index + 1 < statements.count()
    var statement = statement_at(statements, index)
    assert statement
    var declared = shapes.as_variable_declaration(statement)
    assert declared
    var described = lowering().lowered_function()
    var result_type = described.return_type
    var result_name = known().type_text(result_type)
    var matches = true
    if declared.type_reference {
        matches = false
        var resolved = front().resolve_type(declared.type_reference, lowered_class.qualified_dotted)
        if resolved {
            matches = known().same(resolved, result_type)
        }
    }
    lowering().flow_checks().returned_local(statements, index, result_name, matches)
}

func check_value_chain(statements: List<Syntax.Statements.Statement>, index: Integer) {
    var flow = lowering().flow_checks()
    var subject = flow.statement_subject(statements, index)
    assert not subject.is_empty()
    var statement = statement_at(statements, index)
    assert statement
    var arm = shapes.as_if_statement(statement)
    assert arm
    crash arm.condition
    var binary = shapes.as_binary(arm.condition)
    assert binary
    crash binary.left
    var enum_values = lowering().enum_values_of(binary.left)
    flow.value_chain(statements, index, enum_values)
}

func lower_statement(statement: Syntax.Statements.Statement) {
    if statement.line > 0 {
        emitter.line = statement.line
    }
    var made = front()
    var lowered_expressions = lowering()
    var checks = lowered_expressions.value_checks()
    checks.lone_holes(statement, lowered_expressions)
    if not made.breakpoint_sites.is_empty() {
        breakpoint(statement)
    }
    switch statement {
        Syntax.Statements.VariableDeclaration: declaration(statement)
        Syntax.Statements.AssignmentStatement: assignment(statement)
        Syntax.Statements.IfStatement: if_statement(statement)
        Syntax.Statements.WhileStatement: while_statement(statement)
        Syntax.Statements.SwitchStatement: switch_statement(statement)
        Syntax.Statements.AssertStatement: assert_statement(statement)
        Syntax.Statements.ReturnStatement: return_statement(statement)
        Syntax.Statements.ExpressionStatement: expression_statement(statement)
        _: emitter.fail_lowering("a declaration inside a function")
    }
}

func declaration(declared: Syntax.Statements.VariableDeclaration) {
    crash declared.value
    if declared.type_reference {
        typed_declaration(declared, declared.type_reference, declared.value)
        return
    }
    var made = front()
    if made.constant_local(declared, emitter.scope, lowered_class) {
        lowering().hold_binding()
        return
    }
    assert not made.folds_dictionary_local(declared, emitter.scope, lowered_class)
    made.folded_dictionaries.remove(declared.name)
    crash declared.value
    var value = lowering().lower(declared.value)
    var value_type = lowering().type_of(value)
    emitter.declare_local(declared.name, value, value_type)
}

func typed_declaration(
    declared: Syntax.Statements.VariableDeclaration,
    type_reference: Syntax.Types.Type,
    initial: Syntax.Expressions.Expression,
) {
    var made = front()
    var resolved = made.resolve_type(type_reference, lowered_class.qualified_dotted)
    if not resolved {
        emitter.fail_lowering("the type of '{declared.name}', which this lowering cannot read")
        return
    }
    var filled = false
    if shapes.is_null_literal(initial) {
        filled = made.filled_by_walk(declared, lowered_class)
    }
    lowering().value_checks().null_default(declared, resolved, "variable", filled)
    var value = lowering().lower_toward(initial, resolved)
    emitter.declare_local(declared.name, value, resolved)
}

func expression_statement(statement: Syntax.Statements.ExpressionStatement) {
    crash statement.value
    lowering().lower(statement.value)
}

func check_return_value(statement: Syntax.Statements.ReturnStatement) {
    var described = lowering().lowered_function()
    var answer = described.return_type
    var checks = lowering().function_checks()
    if types.is_void(answer) {
        assert statement.value
        checks.return_without_result(described.name)
        return
    }
    assert not statement.value
    var answered_name = known().type_text(answer)
    checks.return_needs_value(described.name, answered_name)
}

func return_statement(statement: Syntax.Statements.ReturnStatement) {
    check_return_value(statement)
    if not statement.value {
        emitter.returns(-1)
        return
    }
    var described = lowering().lowered_function()
    var answer = described.return_type
    var value = lowering().lower_toward(statement.value, answer)
    emitter.returns(value)
}

func assignment(statement: Syntax.Statements.AssignmentStatement) {
    crash statement.target
    crash statement.value
    var made = front()
    var reflected = made.reflected_assignment_target(statement.target, emitter.scope, lowered_class)
    if reflected {
        crash statement.value
        var rewritten = Syntax.Statements.AssignmentStatement(reflected, statement.value)
        rewritten.line = statement.line
        assignment(rewritten)
        return
    }
    crash statement.target
    var identifier = shapes.as_identifier(statement.target)
    if identifier {
        crash statement.value
        assign_name(identifier.name, statement.value)
        return
    }
    crash statement.target
    var indexed = shapes.as_index(statement.target)
    if indexed {
        crash statement.value
        assign_index(indexed, statement.value)
        return
    }
    crash statement.target
    var member = shapes.as_member(statement.target)
    if member {
        crash statement.value
        assign_member(member, statement.value)
        return
    }
    emitter.fail_lowering("an assignment to this kind of target")
}

func assign_name(name: String, assigned: Syntax.Expressions.Expression) {
    var held = emitter.local_named(name)
    if held {
        crash held.declared
        var value = lowering().lower_toward(assigned, held.declared)
        held.value = value
        emitter.name_value(value, name)
        crash held.declared
        forget_unless_wrapped(name, value, held.declared)
        return
    }
    var field = lowered_class.find_field(name)
    if not field {
        emitter.fail_lowering("an assignment to '{name}', which is neither a local nor an attribute")
        return
    }
    var field_type = field.type
    var stored = lowering().lower_toward(assigned, field_type)
    var own_object = lowering().receiver
    emitter.store_field(own_object, name, stored)
    forget_unless_wrapped(name, stored, field_type)
}

func forget_unless_wrapped(path: String, value: Integer, declared: Analysis.SpiteType) {
    assert types.as_nullable(declared) and not emitter.wrapped_values.has(value)
    var narrowed = emitter.scope.written_type(path)
    if narrowed {
        emitter.scope.declare(path, declared)
    }
    var crossed = List<String>()
    emitter.scope.forget_path(path, true, crossed)
}

func assign_index(indexed: Syntax.Expressions.IndexExpression, assigned: Syntax.Expressions.Expression) {
    crash indexed.object
    crash indexed.index
    var made = front()
    if made.is_bound_member_index(indexed) {
        var rewritten = made.bound_member_expression(indexed)
        var rewritten_member = shapes.as_member(rewritten)
        if not rewritten_member {
            emitter.fail_lowering("an assignment through a walked member that is not an attribute")
            return
        }
        assign_member(rewritten_member, assigned)
        return
    }
    if made.is_bound_attributes_index(indexed) {
        assign_name(made.bound_field_name, assigned)
        return
    }
    crash indexed.object
    var object = lowering().lower(indexed.object)
    var object_type = lowering().type_of(object)
    var owner = made.class_of_type(object_type)
    if not owner {
        emitter.fail_lowering("an assignment through an index on a value with no class")
        return
    }
    var writer = made.find_or_instantiate_function(owner, "set_at")
    if not writer {
        lowering().function_checks().index_write_missing(owner.simple_name)
        emitter.fail_lowering("an assignment through an index on '{owner.qualified_dotted}', which has no set_at")
        return
    }
    var arguments = List<Syntax.Expressions.Expression>()
    crash indexed.index
    arguments.append(indexed.index)
    arguments.append(assigned)
    lowering().call_with_arguments(owner, writer, object, arguments)
}

func assign_member(member: Syntax.Expressions.MemberExpression, assigned: Syntax.Expressions.Expression) {
    crash member.object
    var made = front()
    var static_class = made.try_resolve_static_path(member.object, lowered_class.qualified_dotted)
    if static_class {
        check_constant_assignment(static_class, member)
        emitter.fail_lowering("an assignment to a member of a class object")
        return
    }
    if member.name == "allocator" {
        place_with_allocator(member, assigned)
        return
    }
    crash member.object
    var object = lowering().lower(member.object)
    var object_type = lowering().type_of(object)
    var listed_field = made.library_list_field(object_type, member.name, lowered_class)
    if listed_field {
        var listed_type = listed_field.type
        var listed_value = lowering().lower_toward(assigned, listed_type)
        emitter.store_field(object, member.name, listed_value)
        return
    }
    var object_nullable = types.as_nullable(object_type)
    if object_nullable {
        check_nullable_store(member, object_type)
        var present_object = lowering().checked_present(object, object_nullable.inner)
        store_through(member, present_object, assigned)
        return
    }
    store_through(member, object, assigned)
}

func check_constant_assignment(static_class: Analysis.ClassInfo, member: Syntax.Expressions.MemberExpression) {
    var made = front()
    assert made.maths.is_constant(member.name)
    var read = made.number_constant_read(static_class, member.name)
    assert read
    lowering().value_checks().constant_assigned("{static_class.qualified_dotted}.{member.name}")
}

func check_nullable_store(member: Syntax.Expressions.MemberExpression, object_type: Analysis.SpiteType) {
    crash member.object
    var object_expression = member.object
    var found_name = known().type_text(object_type)
    var lowered_expressions = lowering()
    var failure = lowered_expressions.failure_checks()
    failure.nullable_use(object_expression, found_name, "store", member.name, lowered_expressions)
}

func store_through(
    member: Syntax.Expressions.MemberExpression,
    object: Integer,
    assigned: Syntax.Expressions.Expression,
) {
    var made = front()
    var object_type = lowering().type_of(object)
    var united = types.as_union(object_type)
    if united {
        union_store(united.c_name, member.name, object, assigned)
        return
    }
    var class_ref = types.as_class_ref(object_type)
    if not class_ref or class_ref.has_signature {
        emitter.fail_lowering("an assignment to '{member.name}' through a value that is not an object")
        return
    }
    var target = made.find_class_by_c_name(class_ref.c_name)
    if not target {
        emitter.fail_lowering("an assignment to a member of a class with no description")
        return
    }
    store_member(target, member, object, assigned)
}

func check_unwritable(target: Analysis.ClassInfo, member: Syntax.Expressions.MemberExpression) {
    var made = front()
    var checks = lowering().function_checks()
    var getter = made.find_getter(target, member.name, lowered_class)
    if getter {
        checks.read_only_attribute(member.name, target.simple_name)
        return
    }
    checks.no_attribute_to_assign(member.name, target.simple_name)
}

func store_member(
    target: Analysis.ClassInfo,
    member: Syntax.Expressions.MemberExpression,
    object: Integer,
    assigned: Syntax.Expressions.Expression,
) {
    var made = front()
    var setter = made.find_setter(target, member.name, lowered_class)
    if setter {
        var arguments = [assigned]
        lowering().call_with_arguments(target, setter, object, arguments)
        return
    }
    var field = target.find_field(member.name)
    if not field {
        check_unwritable(target, member)
        emitter.fail_lowering("an assignment to '{member.name}', which '{target.qualified_dotted}' does not hold")
        return
    }
    var field_type = field.type
    var stored = lowering().lower_toward(assigned, field_type)
    emitter.store_field(object, member.name, stored)
    var target_expression: Syntax.Expressions.Expression = member
    var path = made.operand_text(target_expression)
    if not path.is_empty() {
        forget_unless_wrapped(path, stored, field_type)
    }
}

func check_guard_if(statement: Syntax.Statements.IfStatement) {
    var described = lowering().lowered_function()
    var return_type = described.return_type
    var answers = lowering().answers_nothing(return_type)
    lowering().failure_checks().default_guard(statement, return_type, answers, described.is_constructor)
}

func check_else_chain(statement: Syntax.Statements.IfStatement) {
    assert statement.has_else_branch and not statement.follows_else
    var flow = lowering().flow_checks()
    var subject = flow.compared_subject(statement)
    assert not subject.is_empty()
    crash statement.condition
    var binary = shapes.as_binary(statement.condition)
    assert binary
    crash binary.left
    var enum_values = lowering().enum_values_of(binary.left)
    flow.else_chain(statement, enum_values)
}

func check_terminal_if(statement: Syntax.Statements.IfStatement, condition: Condition) {
    assert not statement.has_else_branch
    assert not condition.when_true.is_empty()
    crash statement.condition
    var written = statement.condition
    assert not shapes.as_binary(written)
    assert not shapes.as_unary(written)
    var described = lowering().lowered_function()
    var return_type = described.return_type
    var answers = lowering().answers_nothing(return_type)
    var type_name = known().type_text(return_type)
    var name = lowering().source_text(written)
    lowering().failure_checks().terminal_if(statement, described.body, name, type_name, answers)
}

func check_if_lints(statement: Syntax.Statements.IfStatement) {
    lowering().flow_checks().nested_if_else(statement)
    check_else_chain(statement)
}

func if_statement(statement: Syntax.Statements.IfStatement) {
    check_if_lints(statement)
    crash statement.condition
    lowering().restore_bindings()
    var made = front()
    var constant = made.constant_condition(statement.condition, emitter.scope, lowered_class)
    if constant == true {
        lower_block(statement.then_branch)
        return
    }
    if constant == false {
        lower_block(statement.else_branch)
        return
    }
    check_guard_if(statement)
    var count = emitter.locals.count()
    var before = emitter.snapshot(count)
    crash statement.condition
    var condition = lowering().lower_condition(statement.condition)
    assert not emitter.lowering_failed()
    check_terminal_if(statement, condition)
    var then_block = emitter.new_block()
    var else_block = emitter.new_block()
    emitter.branch(condition.value, then_block, else_block)
    var incomings = List<Incoming>()
    emitter.enter_block(then_block)
    emitter.push_frame()
    lowering().apply(condition.when_true, condition.true_types)
    crash statement.condition
    made.narrow_proven_indices(statement.condition, emitter.scope, lowered_class)
    lower_statements(statement.then_branch)
    var then_arrives = emitter.incoming(count)
    emitter.pop_frame()
    if then_arrives {
        incomings.append(then_arrives)
    }
    emitter.restore(before)
    emitter.enter_block(else_block)
    emitter.push_frame()
    lowering().apply(condition.when_false, condition.false_types)
    lower_statements(statement.else_branch)
    var else_arrives = emitter.incoming(count)
    emitter.pop_frame()
    if else_arrives {
        incomings.append(else_arrives)
    }
    emitter.arrive(incomings, count)
    var leaves = not statement.has_else_branch and not then_arrives
    if leaves and emitter.reachable() {
        lowering().apply(condition.when_false, condition.false_types)
        crash statement.condition
        var kept = made.negated_condition(statement.condition)
        made.narrow_proven_indices(kept, emitter.scope, lowered_class)
    }
}

func while_statement(statement: Syntax.Statements.WhileStatement) {
    crash statement.condition
    lowering().restore_bindings()
    var made = front()
    var constant = made.constant_condition(statement.condition, emitter.scope, lowered_class)
    assert constant != false
    var count = emitter.locals.count()
    var assigned = List<String>()
    collect_assigned(statement.body, assigned)
    var carried = List<Integer>()
    var position = 0
    while position < count {
        var held = emitter.local_at(position)
        if assigned.contains(held.name) {
            carried.append(position)
        }
        position = position + 1
    }
    var header = emitter.loop_header(carried)
    crash statement.condition
    if shapes.is_true_literal(statement.condition) {
        endless_loop(statement, header, carried)
        return
    }
    crash statement.condition
    var condition = lowering().lower_condition(statement.condition)
    assert not emitter.lowering_failed()
    var body_block = emitter.new_block()
    var exit_block = emitter.new_block()
    emitter.branch(condition.value, body_block, exit_block)
    emitter.enter_block(body_block)
    emitter.push_frame()
    emitter.scope.is_loop = true
    lowering().apply(condition.when_true, condition.true_types)
    crash statement.condition
    made.narrow_proven_indices(statement.condition, emitter.scope, lowered_class)
    lower_statements(statement.body)
    if emitter.reachable() {
        check_point()
        emitter.back_edge(header, carried)
    }
    emitter.pop_frame()
    emitter.enter_block(exit_block)
    emitter.reset_carried(header, carried)
}

func endless_loop(statement: Syntax.Statements.WhileStatement, header: Integer, carried: List<Integer>) {
    lowering().flow_checks().spinning_loop(statement)
    emitter.push_frame()
    emitter.scope.is_loop = true
    lower_statements(statement.body)
    if emitter.reachable() {
        check_point()
        emitter.back_edge(header, carried)
    }
    emitter.pop_frame()
    emitter.current = -1
}

func collect_assigned(statements: List<Syntax.Statements.Statement>, assigned: List<String>) {
    var index = 0
    while index < statements.count() {
        collect_assigned_in(statements[index], assigned)
        index = index + 1
    }
}

func collect_assigned_in(statement: Syntax.Statements.Statement, assigned: List<String>) {
    switch statement {
        Syntax.Statements.AssignmentStatement: note_assigned(statement.target, assigned)
        Syntax.Statements.IfStatement: collect_branches(statement.then_branch, statement.else_branch, assigned)
        Syntax.Statements.WhileStatement: collect_assigned(statement.body, assigned)
        Syntax.Statements.SwitchStatement: collect_cases(statement.cases, assigned)
        _: return
    }
}

func collect_branches(
    then_branch: List<Syntax.Statements.Statement>,
    else_branch: List<Syntax.Statements.Statement>,
    assigned: List<String>,
) {
    collect_assigned(then_branch, assigned)
    collect_assigned(else_branch, assigned)
}

func collect_cases(cases: List<Syntax.Statements.SwitchCase>, assigned: List<String>) {
    var index = 0
    while index < cases.count() {
        var switch_case = cases[index]
        collect_assigned(switch_case.body, assigned)
        index = index + 1
    }
}

func note_assigned(target: Syntax.Expressions.Expression?, assigned: List<String>) {
    assert target
    var identifier = shapes.as_identifier(target)
    if identifier and not assigned.contains(identifier.name) {
        assigned.append(identifier.name)
    }
}

func check_assert(statement: Syntax.Statements.AssertStatement) {
    assert not statement.is_crash
    var described = lowering().lowered_function()
    var checks = lowering().failure_checks()
    if described.is_constructor {
        checks.assert_in_constructor()
        return
    }
    var return_type = described.return_type
    var answers = lowering().answers_nothing(return_type)
    var type_name = known().type_text(return_type)
    var made_answer = lowering().made_answer(return_type)
    var lowered_expressions = lowering()
    checks.default_answer(statement, return_type, type_name, made_answer, answers, lowered_expressions)
}

func assert_statement(statement: Syntax.Statements.AssertStatement) {
    check_assert(statement)
    if not statement.value {
        fail_check(statement, statement.condition_text)
        return
    }
    var sides = List<Syntax.Expressions.Expression>()
    var made = front()
    made.collect_and_sides(statement.value, sides)
    var index = 0
    while index < sides.count() and emitter.reachable() and not emitter.lowering_failed() {
        var side = sides[index]
        var side_text = statement.condition_text
        if sides.count() > 1 {
            side_text = lowering().source_text(side)
        }
        assert_side(statement, side, side_text)
        index = index + 1
    }
}

func assert_side(statement: Syntax.Statements.AssertStatement, side: Syntax.Expressions.Expression, side_text: String) {
    var made = front()
    var decided = made.folded_check(side, emitter.scope, lowered_class)
    assert decided != true
    if decided == false {
        fail_check(statement, side_text)
        return
    }
    lowering().asserting = true
    var condition = lowering().lower_condition(side)
    lowering().asserting = false
    assert not emitter.lowering_failed()
    var pass_block = emitter.new_block()
    var fail_block = emitter.new_block()
    emitter.branch(condition.value, pass_block, fail_block)
    emitter.enter_block(fail_block)
    fail_check(statement, side_text)
    emitter.enter_block(pass_block)
    lowering().apply(condition.when_true, condition.true_types)
    made.narrow_proven_indices(side, emitter.scope, lowered_class)
}

func fail_check(statement: Syntax.Statements.AssertStatement, text: String) {
    var made = front()
    site_ordinal = site_ordinal + 1
    var described = lowering().lowered_function()
    var owner_name = made.version_free_owner(made.current_owner)
    var identity = made.content_hash("{owner_name}/{described.name}/{site_ordinal}/{text}")
    if statement.is_crash {
        halt_here(text, identity)
        return
    }
    var site_number = emitter.site("assert", text)
    var site = emitter.lowered.sites[site_number]
    crash site
    site.identity = identity
    var answer = described.return_type
    var defaulted = lowering().default_of(answer)
    emitter.returns_at(defaulted, site_number)
}

func halt_here(text: String, identity: String) {
    var made = front()
    var shown = List<Integer>()
    var labels = List<String>()
    show_condition_names(text, shown, labels)
    var position = emitter.floor
    while position < emitter.locals.count() and shown.count() < 12 {
        var held = emitter.local_at(position)
        var held_type = emitter.scope.written_type(held.name)
        var hidden = labels.contains(held.name) or made.mentions_word(text, held.name)
        if held_type and not hidden and made.is_scope_value_type(held_type) {
            show_name(held.name, shown, labels)
        }
        position = position + 1
    }
    show_fields(text, shown, labels)
    var site_number = emitter.site("crash", text)
    var site = emitter.lowered.sites[site_number]
    crash site
    site.shown = labels
    site.identity = identity
    emitter.halt(site_number, shown)
}

func show_condition_names(text: String, shown: List<Integer>, labels: List<String>) {
    var made = front()
    var candidates = List<String>()
    var places = List<Integer>()
    var position = emitter.floor
    while position < emitter.locals.count() {
        var held = emitter.local_at(position)
        var held_type = emitter.scope.written_type(held.name)
        var at = text.index_of(held.name)
        if held_type and at >= 0 and made.mentions_word(text, held.name) and made.is_scope_value_type(held_type) {
            candidates.append(held.name)
            places.append(at)
        }
        position = position + 1
    }
    while not candidates.is_empty() and shown.count() < 12 {
        var best = 0
        var best_place = places.first()
        crash best_place
        var look = 1
        while look < places.count() {
            var here = places[look]
            if here < best_place {
                best = look
                best_place = here
            }
            look = look + 1
        }
        var chosen = candidates[best]
        crash chosen
        show_name(chosen, shown, labels)
        candidates.remove_at(best)
        places.remove_at(best)
    }
}

func show_fields(text: String, shown: List<Integer>, labels: List<String>) {
    var made = front()
    assert lowering().receiver >= 0 and not lowered_class.is_value_class
    var index = 0
    while index < lowered_class.fields.count() and shown.count() < 12 {
        var field = lowered_class.fields[index]
        var hidden = labels.contains(field.name) or made.mentions_word(text, field.name)
        var held = emitter.local_named(field.name)
        if not hidden and not held and field.name != "_namespace" and made.is_scope_value_type(field.type) {
            show_name(field.name, shown, labels)
        }
        index = index + 1
    }
}

func show_name(name: String, shown: List<Integer>, labels: List<String>) {
    var named: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(name)
    var value = lowering().lower(named)
    shown.append(value)
    labels.append(name)
}

func check_switch(statement: Syntax.Statements.SwitchStatement, subject_type: Analysis.SpiteType) {
    var nullable = types.as_nullable(subject_type)
    if nullable {
        check_nullable_switch(statement, nullable.inner)
        return
    }
    var united = types.as_union(subject_type)
    if united {
        check_union_switch(statement, united.c_name)
        return
    }
    check_value_switch(statement, subject_type)
}

func check_nullable_switch(statement: Syntax.Statements.SwitchStatement, inner: Analysis.SpiteType) {
    var flow = lowering().flow_checks()
    var inner_name = known().type_text(inner)
    var covered_null = false
    var covered_value = false
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        if switch_case.value {
            flow.nullable_case_value()
        }
        if switch_case.type_reference and case_names(switch_case) == "Null" {
            covered_null = true
        } else if switch_case.type_reference {
            covered_value = true
            var resolved = front().resolve_type(switch_case.type_reference, lowered_class.qualified_dotted)
            if resolved and not known().same(resolved, inner) {
                flow.nullable_case_type(inner_name)
            }
        }
        index = index + 1
    }
    if not covered_null {
        flow.nullable_not_covered("Null")
    }
    if not covered_value {
        flow.nullable_not_covered(inner_name)
    }
}

func check_union_switch(statement: Syntax.Statements.SwitchStatement, union_name: String) {
    var made = front()
    var described_union = made.find_union_by_c_name(union_name)
    assert described_union and not described_union.is_shape
    var values = lowering().value_checks()
    values.repeated_cases(statement)
    values.single_case(statement)
    var covered = List<String>()
    var answers_the_rest = false
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        if case_names(switch_case) == "_" {
            var members = described_union.members.count()
            var case_count = statement.cases.count()
            var covered_count = covered.count()
            values.rest_case_misplaced(index, case_count, covered_count, members, described_union.simple_name)
            answers_the_rest = true
        } else {
            check_union_case(switch_case, described_union, covered)
        }
        index = index + 1
    }
    var missing = List<String>()
    var member_index = 0
    while member_index < described_union.members.count() {
        var member_name = described_union.members[member_index].simple_name
        if not covered.contains(member_name) {
            missing.append(member_name)
        }
        member_index = member_index + 1
    }
    assert not answers_the_rest
    lowering().flow_checks().union_missing(described_union.simple_name, missing)
}

func check_union_case(
    switch_case: Syntax.Statements.SwitchCase,
    described_union: Analysis.UnionInfo,
    covered: List<String>,
) {
    var values = lowering().value_checks()
    if switch_case.value {
        values.case_is_value(described_union.simple_name)
        return
    }
    var case_class = union_case_class(switch_case, described_union)
    if not case_class {
        values.case_names_no_class()
        return
    }
    if not described_union.has_member(case_class.c_name) {
        values.case_not_in_union(case_class.simple_name, described_union.simple_name)
    }
    covered.append(case_class.simple_name)
}

func check_value_switch(statement: Syntax.Statements.SwitchStatement, subject_type: Analysis.SpiteType) {
    var enum_type = types.as_enum(subject_type)
    var scalar = types.as_scalar(subject_type)
    var whole = false
    if scalar {
        whole = known().is_checked(scalar.kind)
    }
    var is_text = types.as_string(subject_type)
    assert enum_type or whole or is_text
    var values = lowering().value_checks()
    values.repeated_cases(statement)
    values.single_case(statement)
    var enum_values = List<String>()
    if enum_type {
        enum_values = enum_type.values
    }
    var type_name = known().type_text(subject_type)
    lowering().flow_checks().value_switch(statement, type_name, enum_values, is_text)
}

func switch_statement(statement: Syntax.Statements.SwitchStatement) {
    crash statement.subject
    var subject = lowering().lower(statement.subject)
    var subject_type = lowering().type_of(subject)
    check_switch(statement, subject_type)
    if types.as_nullable(subject_type) {
        nullable_switch(statement, subject)
        return
    }
    var united = types.as_union(subject_type)
    if united {
        union_switch(statement, subject, united.c_name)
        return
    }
    if types.as_string(subject_type) {
        equality_switch(statement, subject, "String.equals")
        return
    }
    if types.is_symbol(subject_type) {
        equality_switch(statement, subject, "Symbol.equals")
        return
    }
    var boolean = known().typed_boolean()
    if known().same(subject_type, boolean) {
        equality_switch(statement, subject, "Boolean.equals")
        return
    }
    value_switch(statement, subject)
}

func case_names(switch_case: Syntax.Statements.SwitchCase): String {
    if not switch_case.type_reference {
        return ""
    }
    var named = shapes.as_named_type(switch_case.type_reference)
    if not named {
        return ""
    }
    return named.path.join(".")
}

func lower_switch_case(
    body: List<Syntax.Statements.Statement>,
    count: Integer,
    before: List<Integer>,
    incomings: List<Incoming>,
) {
    emitter.restore(before)
    lower_statements(body)
    var arrives = emitter.incoming(count)
    emitter.pop_frame()
    if arrives {
        incomings.append(arrives)
    }
    emitter.current = -1
}

func nullable_switch(statement: Syntax.Statements.SwitchStatement, subject: Integer) {
    crash statement.subject
    var subject_expression = statement.subject
    var null_cases = 0
    var value_cases = 0
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        if case_names(switch_case) == "Null" {
            null_cases = null_cases + 1
        } else {
            value_cases = value_cases + 1
        }
        index = index + 1
    }
    if null_cases > 1 or value_cases > 1 {
        emitter.fail_lowering("a switch over a value that may be null with two cases for one side")
        return
    }
    var count = emitter.locals.count()
    var before = emitter.snapshot(count)
    var boolean = known().typed_boolean()
    var present = emitter.emit_call_one("Nullable.has", subject, boolean)
    var value_block = emitter.new_block()
    var null_block = emitter.new_block()
    emitter.branch(present, value_block, null_block)
    var subject_type = lowering().type_of(subject)
    var inner = lowering().without_nullable(subject_type)
    var incomings = List<Incoming>()
    index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var named = case_names(switch_case)
        var case_block = value_block
        if named == "Null" {
            case_block = null_block
        }
        emitter.enter_block(case_block)
        emitter.push_frame()
        if named != "Null" {
            lowering().narrow_one(subject_expression, inner)
        }
        lower_switch_case(switch_case.body, count, before, incomings)
        index = index + 1
    }
    if null_cases == 0 {
        pass_through(null_block, count, before, incomings)
    }
    if value_cases == 0 {
        pass_through(value_block, count, before, incomings)
    }
    emitter.arrive(incomings, count)
}

func pass_through(block: Integer, count: Integer, before: List<Integer>, incomings: List<Incoming>) {
    emitter.restore(before)
    emitter.enter_block(block)
    var arrives = emitter.incoming(count)
    if arrives {
        incomings.append(arrives)
    }
    emitter.current = -1
}

func equal_values(equality: String, subject: Integer, written: Integer): Integer {
    var boolean = known().typed_boolean()
    if equality == "String.equals" {
        return lowering().same_text(subject, written)
    }
    return emitter.emit_call_two(equality, subject, written, boolean)
}

func equality_switch(statement: Syntax.Statements.SwitchStatement, subject: Integer, equality: String) {
    var count = emitter.locals.count()
    var before = emitter.snapshot(count)
    var incomings = List<Incoming>()
    var boolean = known().typed_boolean()
    var subject_type = lowering().type_of(subject)
    var index = 0
    while index < statement.cases.count() and emitter.reachable() {
        var switch_case = statement.cases[index]
        if not switch_case.value {
            emitter.push_frame()
            lower_switch_case(switch_case.body, count, before, incomings)
        } else {
            crash switch_case.value
            var written = lowering().lower_toward(switch_case.value, subject_type)
            var same = equal_values(equality, subject, written)
            text_case(same, switch_case.body, count, before, incomings)
        }
        index = index + 1
    }
    var falls = emitter.incoming(count)
    if falls {
        incomings.append(falls)
    }
    emitter.arrive(incomings, count)
}

func union_switch(statement: Syntax.Statements.SwitchStatement, subject: Integer, union_name: String) {
    crash statement.subject
    var subject_expression = statement.subject
    var made = front()
    var described_union = made.find_union_by_c_name(union_name)
    if not described_union or described_union.is_shape {
        emitter.fail_lowering("a switch over a union with no description")
        return
    }
    var count = emitter.locals.count()
    var before = emitter.snapshot(count)
    var tag_type = known().typed_symbol()
    var tag = emitter.emit_call_one("Union.tag", subject, tag_type)
    var tags = List<String>()
    var targets = List<Integer>()
    var bodies = List<List<Syntax.Statements.Statement>>()
    var classes = List<Analysis.ClassInfo>()
    var covered = List<String>()
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var case_class = union_case_class(switch_case, described_union)
        if case_class {
            covered.append(case_class.c_name)
            add_union_case(case_class, switch_case.body, tags, targets, bodies, classes)
        }
        if case_names(switch_case) == "_" {
            add_rest_cases(described_union, covered, switch_case.body, tags, targets, bodies, classes)
        }
        index = index + 1
    }
    emitter.switch_on(tag, tags, targets)
    var incomings = List<Incoming>()
    index = 0
    while index < targets.count() {
        crash bodies[index]
        crash classes[index]
        var body = bodies[index]
        var case_class = classes[index]
        emitter.enter_block(targets[index])
        emitter.push_frame()
        var narrowed = known().class_type(case_class)
        lowering().narrow_one(subject_expression, narrowed)
        lower_switch_case(body, count, before, incomings)
        index = index + 1
    }
    emitter.arrive(incomings, count)
}

func union_case_class(
    switch_case: Syntax.Statements.SwitchCase,
    described_union: Analysis.UnionInfo,
): Analysis.ClassInfo? {
    assert switch_case.type_reference
    assert case_names(switch_case) != "_"
    var made = front()
    var case_class = made.class_of_type_reference(switch_case.type_reference, described_union.owner_namespace)
    if case_class {
        return case_class
    }
    return made.class_of_type_reference(switch_case.type_reference, lowered_class.qualified_dotted)
}

func add_union_case(
    case_class: Analysis.ClassInfo,
    body: List<Syntax.Statements.Statement>,
    tags: List<String>,
    targets: List<Integer>,
    bodies: List<List<Syntax.Statements.Statement>>,
    classes: List<Analysis.ClassInfo>,
) {
    tags.append(case_class.c_name)
    var target = emitter.new_block()
    targets.append(target)
    bodies.append(body)
    classes.append(case_class)
}

func add_rest_cases(
    described_union: Analysis.UnionInfo,
    covered: List<String>,
    body: List<Syntax.Statements.Statement>,
    tags: List<String>,
    targets: List<Integer>,
    bodies: List<List<Syntax.Statements.Statement>>,
    classes: List<Analysis.ClassInfo>,
) {
    var index = 0
    while index < described_union.members.count() {
        var member = described_union.members[index]
        if not covered.contains(member.c_name) {
            add_union_case(member, body, tags, targets, bodies, classes)
        }
        index = index + 1
    }
}

func value_switch(statement: Syntax.Statements.SwitchStatement, subject: Integer) {
    var count = emitter.locals.count()
    var before = emitter.snapshot(count)
    var tags = List<String>()
    var targets = List<Integer>()
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var tag = case_tag(switch_case)
        tags.append(tag)
        var target = emitter.new_block()
        targets.append(target)
        index = index + 1
    }
    emitter.switch_on(subject, tags, targets)
    var incomings = List<Incoming>()
    index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        crash targets[index]
        emitter.enter_block(targets[index])
        emitter.push_frame()
        lower_switch_case(switch_case.body, count, before, incomings)
        index = index + 1
    }
    emitter.arrive(incomings, count)
}

func case_tag(switch_case: Syntax.Statements.SwitchCase): String {
    if not switch_case.value {
        return "_"
    }
    var printer = Syntax.SourcePrinter()
    var written = printer.source_expression(switch_case.value)
    crash switch_case.value
    var literal = shapes.as_enum_literal(switch_case.value)
    if literal {
        return literal.value
    }
    return written
}

func text_switch(statement: Syntax.Statements.SwitchStatement, subject: Integer) {
    var count = emitter.locals.count()
    var before = emitter.snapshot(count)
    var incomings = List<Incoming>()
    var boolean = known().typed_boolean()
    var index = 0
    while index < statement.cases.count() and emitter.reachable() {
        var switch_case = statement.cases[index]
        if not switch_case.value {
            emitter.push_frame()
            lower_switch_case(switch_case.body, count, before, incomings)
        } else {
            crash switch_case.value
            var written = lowering().lower(switch_case.value)
            var same = lowering().same_text(subject, written)
            text_case(same, switch_case.body, count, before, incomings)
        }
        index = index + 1
    }
    var falls = emitter.incoming(count)
    if falls {
        incomings.append(falls)
    }
    emitter.arrive(incomings, count)
}

func text_case(
    same: Integer,
    body: List<Syntax.Statements.Statement>,
    count: Integer,
    before: List<Integer>,
    incomings: List<Incoming>,
) {
    var case_block = emitter.new_block()
    var next_block = emitter.new_block()
    emitter.branch(same, case_block, next_block)
    emitter.enter_block(case_block)
    emitter.push_frame()
    lower_switch_case(body, count, before, incomings)
    emitter.restore(before)
    emitter.enter_block(next_block)
}

func union_store(union_name: String, name: String, object: Integer, assigned: Syntax.Expressions.Expression) {
    var made = front()
    var described_union = made.find_union_by_c_name(union_name)
    if not described_union or described_union.members.is_empty() {
        emitter.fail_lowering("an assignment to '{name}' through a union with no members")
        return
    }
    var field_type = union_field_type(described_union, name)
    if not field_type {
        emitter.fail_lowering(
            "an assignment to '{name}', which the union '{described_union.simple_name}' does not hold",
        )
        return
    }
    var value = lowering().lower_toward(assigned, field_type)
    lowering().union_store_value(described_union, name, object, value)
}

func union_field_type(described_union: Analysis.UnionInfo, name: String): Analysis.SpiteType? {
    var made = front()
    if described_union.is_shape {
        return made.shape_field_type(described_union, name)
    }
    var first_member = described_union.members.first()
    assert first_member
    var field = first_member.find_field(name)
    assert field
    return field.type
}

func place_with_allocator(member: Syntax.Expressions.MemberExpression, assigned: Syntax.Expressions.Expression) {
    crash member.object
    var memory = shapes.as_member(member.object)
    if not memory or memory.name != "memory" {
        emitter.fail_lowering("an assignment to an allocator that is not an object's")
        return
    }
    crash memory.object
    var object = lowering().lower(memory.object)
    var allocator = lowering().lower(assigned)
    var operands = [object, allocator]
    emitter.emit_call("Object.place", operands, null)
}

func breakpoint(statement: Syntax.Statements.Statement) {
    var made = front()
    var described = lowering().lowered_function()
    var source_path = described.source_path
    if source_path.is_empty() {
        source_path = lowered_class.source_path
    }
    var site = "{statement.line} {source_path}"
    assert made.hot_reload and made.remote_loop_port > 0 and made.breakpoint_sites.contains(site)
    var attribute_class = made.find_class_by_c_name("Spite_Attribute")
    if not attribute_class {
        emitter.fail_lowering("a breakpoint with no Spite.Attribute class")
        return
    }
    var element = lowering().known().class_type(attribute_class)
    var listed = lowering().new_list(element)
    var appender = lowering().list_function(element, "append")
    var expressions = lowering()
    var reflection = ReflectionLowering(expressions)
    if not lowered_class.is_value_class {
        var own_object = lowering().own_receiver()
        var own_name = reflection.symbol("self")
        var own_attribute = reflection.reflect_body(own_name, own_object)
        lowering().call_two_function(appender, listed, own_attribute)
    }
    var names = List<String>()
    emitter.scope.visible_names(names)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var named: Syntax.Expressions.Expression = Syntax.Expressions.IdentifierExpression(name)
        var value = lowering().lower(named)
        var local_name = reflection.symbol(name)
        var local_attribute = reflection.reflect_body(local_name, value)
        lowering().call_two_function(appender, listed, local_attribute)
        index = index + 1
    }
    var shown = lowering().text_constant("{source_path}:{statement.line}")
    emitter.emit_call_two("Loop.breakpoint", shown, listed, null)
}

func check_point() {
    var made = front()
    assert made.hot_reload or made.remote_loop_port > 0
    var no_operands = List<Integer>()
    emitter.emit_call("Loop.check_point", no_operands, null)
}
