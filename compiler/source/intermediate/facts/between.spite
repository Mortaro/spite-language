# ../../../../docs/proofs.md#a-call-keeps-a-proof-it-cannot-change
func operations_between(function: Function, flow: Flow, from: Place, to: Place): List<Operation> {
    var found = List<Operation>()
    var start = from.first_operation_after()
    var end = to.last_operation_before()
    var forward = reached_all(flow, from.block, true)
    var backward = reached_all(flow, to.block, false)
    var from_again = forward.contains(from.block) and backward.contains(from.block)
    var to_again = forward.contains(to.block) and backward.contains(to.block)
    if from.block == to.block {
        if from.before(to) {
            add_same_block(function, from, to, false, found)
            return found
        }
        add_same_block(function, from, to, from_again, found)
        return found_with_middle(function, from, to, forward, backward, found)
    }
    var from_start = start
    if from_again {
        from_start = 0
    }
    add_range(function, from.block, from_start, 1000000000, found)
    var to_end = end
    if to_again {
        to_end = 1000000000
    }
    add_range(function, to.block, 0, to_end, found)
    return found_with_middle(function, from, to, forward, backward, found)
}

func add_same_block(function: Function, from: Place, to: Place, again: Boolean, found: List<Operation>) {
    if again {
        add_range(function, from.block, 0, 1000000000, found)
        return
    }
    assert from.before(to)
    var start = from.first_operation_after()
    var end = to.last_operation_before()
    add_range(function, from.block, start, end, found)
}

func found_with_middle(
    function: Function,
    from: Place,
    to: Place,
    forward: List<Integer>,
    backward: List<Integer>,
    found: List<Operation>,
): List<Operation> {
    var index = 0
    while index < forward.count() {
        var block = forward[index]
        if backward.contains(block) and block != from.block and block != to.block {
            add_range(function, block, 0, 1000000000, found)
        }
        index = index + 1
    }
    return found
}

func reached_all(flow: Flow, start: Integer, going_forward: Boolean): List<Integer> {
    var seen = List<Integer>()
    var waiting = List<Integer>()
    var first = neighbours(flow, start, going_forward)
    first.each(waiting.append)
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        if not seen.contains(taken) {
            seen.append(taken)
            var next = neighbours(flow, taken, going_forward)
            next.each(waiting.append)
        }
    }
    return seen
}

func add_range(function: Function, block_number: Integer, start: Integer, end: Integer, found: List<Operation>) {
    var block = function.block_at(block_number)
    var operation_count = block.operations.count()
    var last = end.minimum(operation_count)
    var index = start
    while index < last {
        crash block.operations[index]
        found.append(block.operations[index])
        index = index + 1
    }
}

func neighbours(flow: Flow, block: Integer, going_forward: Boolean): List<Integer> {
    if going_forward {
        return flow.successors_of(block)
    }
    return flow.predecessors_of(block)
}
