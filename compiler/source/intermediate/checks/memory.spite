func unkept_lender(emitter: Emitter, name: String, unkept: String) {
    emitter.refuse(
        "'{name}' would be borrowed from '{unkept}', which nothing keeps, so it is let go at the end of this line and the item with it: keep it in a 'var' first and borrow from that",
    )
}

