func place_read_outside_a_walk(emitter: Emitter, symbol: String) {
    emitter.refuse(
        "'{symbol}.index' is the attribute's place among the attributes walked, so it is read in a function a walk of attributes calls, such as 'fill_attribute(attribute: Symbol<Row>, ...)'",
    )
}

