# ../../../../specs/memory.md#assigning-a-name-read-from-a-list-changes-only-the-name
func replaced_item(emitter: Emitter, line: Integer, name: String, slot: String, container: String, value_text: String) {
    emitter.refuse_at(
        line,
        "'{name}' was read from '{slot}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{container}' still holds the old item. Write '{slot} = {value_text}' to replace the item, or give the new value a 'var' of its own",
    )
}

# ../../../../specs/memory.md#assigning-a-name-read-from-a-list-changes-only-the-name
func replaced_item_answered(
    emitter: Emitter,
    line: Integer,
    name: String,
    slot: String,
    owner: String,
    call: String,
    writer: String,
    container: String,
) {
    if writer.is_empty() {
        emitter.refuse_at(
            line,
            "'{name}' holds '{slot}' of '{owner}', answered by '{call}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{owner}' still holds the old item. Replace it through a function of '{owner}' that writes '{slot}', or give the new value a 'var' of its own",
        )
        return
    }
    emitter.refuse_at(
        line,
        "'{name}' holds '{slot}' of '{owner}', answered by '{call}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{owner}' still holds the old item. Replace it through '{owner}.{writer}', which writes '{container}', or give the new value a 'var' of its own",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func note_items_source(source: String, label: String) {
    items_sources[source] = label
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func note_lent_result_singleton(source: String) {
    lent_result_singletons[source] = true
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func note_lent_caller(caller: String) {
    lent_caller = caller
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func items_choice(sources: String): String {
    var named = sources.split("' and '")
    var index = 0
    while index < named.count() {
        var source_name = named[index]
        if items_sources[source_name] {
            if not items_sources[source_name].is_empty() {
                return "'{items_sources[source_name]}' fits a Vector, so the items of '{named[index]}' are borrowed: "
            }
        }
        index = index + 1
    }
    return ""
}

func reread_hint(source: String): String {
    if lent_result_singletons.has(source) {
        return "ask for the item again"
    }
    return "read '{source}[index]' again"
}

func handed_on_hint(source: String): String {
    if not lent_result_singletons.has(source) {
        return ""
    }
    return "; a function lends its caller an item only by reading it from a singleton's Items or Vector itself, never one that was lent to it"
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func borrow_past_resize(emitter: Emitter, line: Integer, name: String, source: String, resize: String) {
    emitter.refuse_at(
        line,
        "{items_choice(source)}'{name}' is borrowed from '{source}', and {resize} may move the items of '{source}', so '{name}' is not read after it: {reread_hint(source)} after that line, or keep '{name}.copy()', an independent object",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func row_call_resize(emitter: Emitter, line: Integer, name: String, source: String, resize: String) {
    emitter.refuse_at(
        line,
        "{items_choice(source)}'{name}' borrows items from '{source}' for the call it is passed to, and {resize} may move the items of '{source}': a function that is handed a row may not append to or remove from the vectors it borrows from, directly or through what it calls",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func lent_argument_resize(
    emitter: Emitter,
    line: Integer,
    name: String,
    source: String,
    plural: String,
    resize: String,
) {
    emitter.refuse_at(
        line,
        "{items_choice(source)}'{name}' is borrowed from '{source}' for the one call '{plural}' stands for, and {resize} may move the items of '{source}': a function handed borrowed arguments may not append to or remove from the collections they borrow from, directly or through what it calls",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func lent_call_resize(emitter: Emitter, path: String, text: String, callee: String, resize: String) {
    emitter.refuse(
        "{items_choice(path)}'{text}' is borrowed from '{path}' and lent to '{callee}' for its call, and {resize} may move the items of '{path}': a function lent a borrowed item may not append to or remove from the collection it is borrowed from, directly or through what it calls; change the size of '{path}' before or after the call",
    )
}

