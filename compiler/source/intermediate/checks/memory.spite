func borrowed_name_reused(emitter: Emitter, name: String, source: String) {
    emitter.refuse(
        "{items_choice(source)}'{name}' already names a value earlier in this block, and an item borrowed from '{source}' is given a name of its own: call it something new, such as 'var {name}_item = ...'",
    )
}

