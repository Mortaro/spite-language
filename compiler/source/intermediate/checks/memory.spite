func lent_captured(emitter: Emitter, text: String, member: String) {
    emitter.refuse(
        "'{text}.{member}' would keep '{text}' in a function value, and '{text}' is lent to '{emitter.function_name}' for one call, so '{emitter.function_name}' does not keep it: call '{text}.{member}()' directly, or keep the values it needs",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func unlent_argument_reason(
    text: String,
    name: String,
    in_library: Boolean,
    takes_union: Boolean,
    named_or_indexed: Boolean,
): String {
    var shown = "'{name}'"
    if name.is_empty() {
        shown = "the function"
    }
    if in_library {
        return "{shown} is a library function, which is never lent an item: pass the attributes it needs, or '{text}.copy()' where a snapshot is what it wants"
    }
    if takes_union {
        return "{shown} takes it as a union, which holds its own values and is never lent an item: pass the attributes it needs, or give {shown} a parameter of the item's own class"
    }
    if not named_or_indexed {
        return "only a named item, an item read with '[ ]' or a row's attribute is lent to a call: name it first, 'var item = {text}', and pass 'item'"
    }
    return "{shown} is not lent it for the call: pass the attributes it needs"
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func kept_item(
    emitter: Emitter,
    text: String,
    source: String,
    site: String,
    detail: String,
    argument_reason: String,
    result_hint: String,
) {
    var copied = "'{text}.copy()', an independent object"
    var reason = items_choice(source)
    if site == "return" {
        emitter.refuse(
            "{reason}'{text}' is borrowed from '{source}' and cannot be returned: return {copied}{result_hint}{handed_on_hint(source)}",
        )
        return
    }
    if site == "attribute" {
        emitter.refuse(
            "{reason}'{text}' is borrowed from '{source}' and cannot be kept in the attribute '{detail}': keep {copied}",
        )
        return
    }
    if site == "local" {
        emitter.refuse(
            "{reason}'{text}' is borrowed from '{source}', and a borrowed item has one name: use '{text}' itself instead of '{detail}', or keep {copied}",
        )
        return
    }
    if site == "list" {
        emitter.refuse(
            "{reason}'{text}' is borrowed from '{source}' and cannot be put in a list: a list keeps {copied}",
        )
        return
    }
    if site == "argument" {
        emitter.refuse("{reason}'{text}' is borrowed from '{source}', and {argument_reason}")
        return
    }
    emitter.refuse(
        "{reason}'{text}' is borrowed from '{source}' and cannot be kept past the line that reads it: keep {copied}",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func kept_row(emitter: Emitter, text: String, source: String, site: String, detail: String, result_hint: String) {
    var held = "{items_choice(source)}'{text}' holds items borrowed from '{source}' for this call"
    if site == "return" {
        emitter.refuse(
            "{held} and cannot be returned: return the values the caller needs, or a 'copy()' of one of its items{result_hint}",
        )
        return
    }
    if site == "attribute" {
        emitter.refuse(
            "{held} and cannot be kept in the attribute '{detail}': keep the values it needs, or a 'copy()' of one of its items",
        )
        return
    }
    if site == "local" {
        emitter.refuse("{held}, and a row has one name: use '{text}' itself instead of '{detail}'")
        return
    }
    if site == "list" {
        emitter.refuse("{held} and cannot be put in a list: a list keeps a 'copy()' of one of its items")
        return
    }
    if site == "argument" {
        emitter.refuse(
            "{held} and is passed only to a function called by name whose parameter is a 'type', which borrows it for that call: pass the attributes the function needs",
        )
        return
    }
    emitter.refuse("{held} and cannot be kept past it: keep the values it needs, or a 'copy()' of one of its items")
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func kept_lent(emitter: Emitter, text: String, site: String, detail: String, argument_reason: String) {
    var function = emitter.function_name
    var lent = "'{text}' is lent to '{function}' for one call, by {lent_caller}: it is the caller's item, read and written in place,"
    if lent_caller.is_empty() {
        lent = "'{text}' is lent to '{function}' for one call: it is the caller's item, read and written in place,"
    }
    if site == "return" {
        emitter.refuse("{lent} so '{function}' does not return it: return the values the caller needs")
        return
    }
    if site == "attribute" {
        emitter.refuse(
            "{lent} so '{function}' does not keep it in the attribute '{detail}': keep the values it needs, or have the caller pass something '{function}' may keep",
        )
        return
    }
    if site == "local" {
        emitter.refuse("{lent} and a lent item has one name: use '{text}' itself instead of '{detail}'")
        return
    }
    if site == "list" {
        emitter.refuse(
            "{lent} so '{function}' does not put it in a list, which would keep it: keep the values it needs",
        )
        return
    }
    if site == "argument" {
        emitter.refuse("{lent} and {argument_reason}")
        return
    }
    emitter.refuse("{lent} so '{function}' keeps it no longer than the call: keep the values it needs")
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func unlent_return(emitter: Emitter, function: String, lent: String, written: String) {
    emitter.refuse(
        "'{function}' lends its caller an item of '{lent}', which the caller writes in place and never lets go, so each of its returns is an item of '{lent}' or null: '{written}' is neither, so return null for 'none', with a '?' result, or make it a function of its own",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func lending_value(emitter: Emitter, function: String, lent: String) {
    emitter.refuse(
        "'{function}' lends its caller an item of '{lent}', which only a call written by name can borrow: a function value's caller would let go of an item it does not own, so '{function}' is not made a function value; call '{function}(...)' by name where the item is wanted",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func lending_through_a_type(lent: String, required: String): String {
    return "its '{required}' lends its caller an item of '{lent}', which only a call written by name can borrow: a call through the type would let go of an item it does not own"
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func item_class_this(emitter: Emitter, label: String, function: String) {
    emitter.refuse(
        "'{label}.{function}' uses 'this' as a value, and an item of a Vector is borrowed from the Vector, never an object to keep or to pass on: read and write its attributes instead",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func plain_items(emitter: Emitter, instance: String, label: String) {
    emitter.refuse(
        "'{instance}<{label}>' holds plain values, and a List keeps numbers, Boolean, enums and Memory.Address flat just as it did, so a list of them has one spelling: write 'List<{label}>'",
    )
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func vector_item(emitter: Emitter, model: Generation.Generator, item_type: Analysis.SpiteType) {
    var problem = vector_item_problem(model, item_type)
    assert not problem.is_empty()
    emitter.refuse(problem)
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func vector_item_problem(model: Generation.Generator, item_type: Analysis.SpiteType): String {
    if model.inline_value_type(item_type) {
        return ""
    }
    var label = model.type_display_name(item_type)
    var item_class = model.inline_item_class(item_type)
    if not item_class {
        return "a Vector holds each item inline, so an item is a number, a Boolean, an enum, a String or a class made only of those, and {model.type_with_article(item_type)} is not: keep it in a 'List<{label}>'"
    }
    var index = 0
    while index < item_class.fields.count() {
        var field = item_class.fields[index]
        var field_type = field.type
        if not model.inline_value_type(field_type) and not model.singleton_type(field_type) {
            return "'{label}' cannot be an item of a Vector: its attribute '{field.name}' is {model.type_with_article(field_type)}, and a Vector holds each item inline, so every attribute is a number, a Boolean, an enum or a String (keep '{label}' in a 'List<{label}>', or keep '{field.name}' somewhere else)"
        }
        index = index + 1
    }
    if item_class.drop_function {
        return "'{label}' cannot be an item of a Vector: it has a 'drop()', and an item inline in a Vector is never an object of its own to drop (keep '{label}' in a 'List<{label}>')"
    }
    index = 0
    while index < item_class.declared_functions.count() {
        var function = item_class.declared_functions[index]
        if not function.is_constructor and model.block_uses_this(function.body, item_class) {
            return "'{label}.{function.name}' uses 'this' as a value, and an item of a Vector is borrowed from the Vector, never an object to keep or to pass on: read and write its attributes instead"
        }
        index = index + 1
    }
    return ""
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func vector_form(name: String): String {
    return "'{name}' passes each item to a function, and an item of a Vector is borrowed from it, never passed on: give the item's class a function and call it with a member template, such as '{name}_<function>()'"
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func items_form(name: String, label: String, fits_vector: Boolean): String {
    var advice = "give the item's class a function and call it with a member template, such as '{name}_<function>()'"
    if fits_vector {
        return "'{name}' passes each item to a function, and '{label}' fits a Vector, so an item of these Items is borrowed from them, never passed on: {advice}"
    }
    return "'{name}' passes each item to a function, which Items does not do whichever storage it chose, since an item that fits a Vector is borrowed and never passed on: {advice}"
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func unpassed_value_form(name: String, kind: String, label: String): String {
    return "'{name}' passes each item to a function, which {kind} never does: keep the values in a 'List<{label}>' to pass them on"
}

# ../../../../specs/memory.md#allocators-memoryallocator
func is_name_path(expression: Syntax.Expressions.Expression): Boolean {
    if shapes.as_identifier(expression) {
        return true
    }
    var member = shapes.as_member(expression)
    if not member {
        return false
    }
    crash member.object
    return is_name_path(member.object)
}

# ../../../../specs/memory.md#allocators-memoryallocator
func allocator_class(emitter: Emitter, model: Generation.Generator, allocator_type: Analysis.SpiteType): Boolean {
    var reference = types.as_class_ref(allocator_type)
    if reference {
        var found = model.find_class_by_c_name(reference.c_name)
        if found {
            if found.qualified_dotted == "Memory.Heap" {
                return true
            }
            if model.is_allocator_member(found) {
                return true
            }
            if found.is_instantiated and model.is_allocator_class(found) {
                var shown = model.type_display_name(allocator_type)
                generic_allocator(emitter, shown)
                return false
            }
        }
    }
    var display = model.type_display_name(allocator_type)
    not_an_allocator(emitter, display)
    return false
}

# ../../../../specs/memory.md#allocators-memoryallocator
func allocator_set(
    emitter: Emitter,
    model: Generation.Generator,
    previous: Syntax.Statements.Statement?,
    object: Syntax.Expressions.Expression,
    assigned: Syntax.Expressions.Expression,
    allocator_type: Analysis.SpiteType,
    held_type: Analysis.SpiteType?,
): Boolean {
    var written = printer.source_expression(object)
    if written.is_empty() {
        written = "this object"
    }
    var declaration: Syntax.Statements.VariableDeclaration? = null
    if previous {
        declaration = shapes.as_variable_declaration(previous)
    }
    var named = shapes.as_identifier(object)
    if not declaration or not named or declaration.name != named.name {
        allocator_used(emitter, written)
        return false
    }
    if not allocator_class(emitter, model, allocator_type) {
        return false
    }
    if not is_name_path(assigned) {
        allocator_unnamed(emitter, declaration.name)
        return false
    }
    if not held_type or not model.owning_class_of(held_type) {
        var display = "a value"
        if held_type {
            display = model.type_display_name(held_type)
        }
        allocator_not_a_value(emitter, declaration.name, display)
        return false
    }
    crash declaration.value
    if not makes_an_object(declaration.value) {
        allocator_not_made_here(emitter, declaration.name)
        return false
    }
    return true
}

func makes_an_object(value: Syntax.Expressions.Expression): Boolean {
    if shapes.as_generic_call(value) {
        return true
    }
    var call = shapes.as_call(value)
    if not call {
        return false
    }
    crash call.callee
    if shapes.as_identifier(call.callee) {
        return true
    }
    var member = shapes.as_member(call.callee)
    if not member {
        return false
    }
    return member.name == "copy"
}

# ../../../../specs/memory.md#the-floor-memoryaddress-memoryheap-and-typedmemoryt
func number_memory(
    lowered: Lowered,
    model: Generation.Generator,
    instances: Instances,
    information: Analysis.ClassInfo,
) {
    var path = information.source_path
    var line = 1
    var declaration = instances.field_declaration(information, "_memory")
    if declaration {
        line = declaration.line
    }
    if not information.memory_path.is_empty() {
        path = information.memory_path
        line = information.memory_line
    }
    var number_type = model.value_class_type(information)
    var c_type = model.c_type_name(number_type)
    var laid_out = model.scalar_c_bytes(c_type)
    var owner = information.qualified_dotted
    if not declaration {
        number_memory_missing(lowered, path, line, owner, information.simple_name, laid_out)
        return
    }
    var declared = declared_bytes(declaration)
    if declared < 0 {
        lowered.refuse(
            path,
            line,
            owner,
            "",
            "a value states its size as 'var _memory = Memory.Bytes(bytes)', with the bytes written out: the compiler places that memory, and a number's is a register",
        )
        return
    }
    if declared != laid_out {
        number_memory_size(lowered, path, line, owner, declared, c_type, laid_out)
    }
}

func declared_bytes(declaration: Syntax.Statements.VariableDeclaration): Integer {
    crash declaration.value
    var allocation = shapes.as_call(declaration.value)
    if not allocation {
        return -1
    }
    crash allocation.callee
    var sizing = shapes.as_member(allocation.callee)
    if not sizing {
        return -1
    }
    crash sizing.object
    var namespace = shapes.as_identifier(sizing.object)
    if not namespace or namespace.name != "Memory" or sizing.name != "Bytes" or allocation.arguments.count() != 1 {
        return -1
    }
    var bytes = shapes.as_integer_literal(allocation.arguments[0])
    if not bytes {
        return -1
    }
    return bytes.value
}

# ../../../../specs/memory.md#borrowed-items-of-a-vectort
func vector_instance(emitter: Emitter, model: Generation.Generator, instance: Analysis.ClassInfo) {
    crash instance.codegen_types[0]
    var item_type = instance.codegen_types[0]
    if instance.qualified_dotted == "Vector" {
        var problem = vector_item_problem(model, item_type)
        if not problem.is_empty() {
            emitter.refuse(problem)
        }
    }
    var plain_type = item_type
    var nullable = types.as_nullable(item_type)
    if nullable {
        plain_type = nullable.inner
    }
    assert model.plain_item_type(plain_type) or model.is_address_type(plain_type)
    var label = model.type_display_name(item_type)
    plain_items(emitter, instance.qualified_dotted, label)
}

# ../../../../specs/memory.md#the-memory-model
func weak_not_an_object(emitter: Emitter, phrase: String) {
    emitter.refuse(
        "Weak holds an object without counting it, and {phrase} is not an object: a number, a Boolean, an enum or a T? is kept by value, so hold it as it is",
    )
}

# ../../../../specs/memory.md#the-memory-model
func weak_across_threads(
    lowered: Lowered,
    path: String,
    line: Integer,
    owner: String,
    function: String,
    work_text: String,
    weak_name: String,
) {
    lowered.refuse(
        path,
        line,
        owner,
        function,
        "'Parallel({work_text})' runs on another thread, and what it runs reaches '{weak_name}', which is a Weak or is held by one: a Weak is kept in one table that is not shared between threads, so a Weak and the objects it holds stay on the program's own thread. Hold the object itself in the work, or keep the Weak out of what the Parallel reaches",
    )
}

# ../../../../specs/memory.md#the-memory-model
func weak_threads(lowered: Lowered) {
    var held = List<String>()
    var index = 0
    while index < lowered.layouts.count() {
        var layout = lowered.layouts[index]
        index = index + 1
        if layout.qualified == "Weak" and layout.information {
            var information = layout.information
            var inner = information.codegen_types.first()
            if inner {
                var class_ref = types.as_class_ref(inner)
                if class_ref {
                    held.append(class_ref.c_name)
                }
            }
        }
    }
    var walker = Concurrency()
    index = 0
    while index < lowered.parallel_sites.count() {
        var site = lowered.parallel_sites[index]
        index = index + 1
        var reached_owners = Dictionary<String, Boolean>()
        var reached = walker.reached_functions(lowered, site.work)
        var position = 0
        while position < reached.count() {
            var function = lowered.function_named(reached[position])
            position = position + 1
            if function {
                reached_owners[function.owner] = true
            }
        }
        var weak_name = weak_class_reached(lowered, reached_owners, held)
        if not weak_name.is_empty() {
            weak_across_threads(lowered, site.path, site.line, site.owner, site.function, site.text, weak_name)
        }
    }
}

func weak_class_reached(lowered: Lowered, reached: Dictionary<String, Boolean>, held: List<String>): String {
    var index = 0
    while index < held.count() {
        var layout = lowered.layout_named(held[index])
        if layout and layout.information and reached.has(layout.c_name) {
            return layout.information.simple_name
        }
        index = index + 1
    }
    index = 0
    while index < lowered.layouts.count() {
        var layout = lowered.layouts[index]
        index = index + 1
        if reached.has(layout.c_name) and layout.information and not layout.information.source_path.starts_with("library/") {
            var weak_field = weak_field_of(lowered, layout.information)
            if not weak_field.is_empty() {
                return weak_field
            }
        }
    }
    return ""
}

func weak_field_of(lowered: Lowered, information: Analysis.ClassInfo): String {
    var index = 0
    while index < information.fields.count() {
        var field_type = information.fields[index].type
        var nullable = types.as_nullable(field_type)
        if nullable {
            field_type = nullable.inner
        }
        var class_ref = types.as_class_ref(field_type)
        if class_ref {
            var layout = lowered.layout_named(class_ref.c_name)
            if layout and layout.qualified == "Weak" {
                return "{information.simple_name}.{information.fields[index].name}"
            }
        }
        index = index + 1
    }
    return ""
}
