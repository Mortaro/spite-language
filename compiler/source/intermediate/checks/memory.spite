func walked_row_refused(emitter: Emitter, name: String, attribute: String, written: String) {
    emitter.refuse(
        "'{name}' is a row filled by the walk on the next line, and its line for '{attribute}' reads '{written}', which a walked row cannot write out: the line is built from '<value>.attributes[attribute]', attribute reads, '[ ]', calls, the walk's other parameters, 'attribute.index' and whole numbers, so work out '{written}' before the walk and pass it in",
    )
}

