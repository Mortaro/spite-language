func item_captured(emitter: Emitter, text: String, member: String, source: String) {
    emitter.refuse(
        "{items_choice(source)}'{text}.{member}' would keep '{text}', which is borrowed from '{source}', in a function value: make it from a copy, 'var kept = {text}.copy()' and then 'kept.{member}'",
    )
}

