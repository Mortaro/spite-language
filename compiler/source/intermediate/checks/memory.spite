# ../../../../specs/memory.md#allocators-memoryallocator
func allocator_used(emitter: Emitter, object: String) {
    emitter.refuse(
        "'{object}' was already used, so its allocator can no longer change: an object's allocator is set on the line right after it is made. To move it, copy it and set the copy's: 'var moved = {object}.copy()' and then 'moved.memory.allocator = ...'",
    )
}

