func row_keeps_a_value(emitter: Emitter, name: String, attribute: String, phrase: String) {
    emitter.refuse(
        "'{name}' borrows items from a Vector, so each of its attributes is a borrowed item or a plain value: '{attribute}' holds {phrase}, which the row would have to keep",
    )
}

