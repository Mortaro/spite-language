func number_memory_read(emitter: Emitter, name: String, owner: String) {
    emitter.refuse(
        "'{name}' is the memory {owner} is kept in, and the compiler keeps the value itself there: write 'this'",
    )
}

# ../../../../specs/memory.md#the-floor-memoryaddress-memoryheap-and-typedmemoryt
func number_memory_spelling(emitter: Emitter) {
    emitter.refuse(
        "a value states its size as 'var _memory = Memory.Bytes(bytes)', with the bytes written out: the compiler places that memory, and a number's is a register",
    )
}

