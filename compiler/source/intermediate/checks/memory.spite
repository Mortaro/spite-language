func row_attribute_assigned(emitter: Emitter, row: String, sources: String, attribute: String) {
    emitter.refuse(
        "'{row}' holds items borrowed from '{sources}' for this call, so '{row}.{attribute}' is not assigned: write the item's attributes, such as '{row}.{attribute}.<attribute> = ...'",
    )
