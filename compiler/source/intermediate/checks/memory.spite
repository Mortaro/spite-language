    )
}

# ../../../../specs/memory.md#allocators-memoryallocator
func allocator_read_of_a_value(emitter: Emitter, display: String) {
    emitter.refuse(
        "only an object has an allocator of its own, and this is a value of type {display}, which the compiler places itself",
    )
}

# ../../../../specs/memory.md#allocators-memoryallocator
func allocator_read_unnamed(emitter: Emitter) {
    emitter.refuse("only a named object answers its allocator: give this object a name with 'var' first")
}

# ../../../../specs/memory.md#allocators-memoryallocator
func allocator_read_in_a_singleton(emitter: Emitter, simple: String) {
    emitter.refuse(
        "'memory.allocator' is the allocator of the object a function runs on, and '{simple}' is not made as an object of its own: only an object has an allocator",
    )
