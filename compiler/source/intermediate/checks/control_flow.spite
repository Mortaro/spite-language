# ../../../../specs/control_flow.md#control-flow-in-full
var generator: Generation.Generator? = null
var shapes = Analysis.AstShape()
var types = Analysis.TypeShape()
var printer = Syntax.SourcePrinter()

func ControlFlow(starting_generator: Generation.Generator) {
    generator = starting_generator
}

# ../../../../specs/control_flow.md#control-flow-in-full
func refuse(message: String) {
    crash generator
    var quiet = generator.nested_quiet
    generator.nested_quiet = false
    generator.report(message)
    generator.nested_quiet = quiet
}

# ../../../../specs/control_flow.md#control-flow-in-full
func refuse_at(line: Integer, message: String) {
    crash generator
    var saved = generator.current_line
    generator.current_line = line
    refuse(message)
    generator.current_line = saved
}

# ../../../../specs/control_flow.md#control-flow-in-full
func with_article(name: String): String {
    var first_letter = name.slice(0, 1)
    if "AEIOU".contains(first_letter) {
        return "an {name}"
    }
    return "a {name}"
}

# ../../../../specs/control_flow.md#nested-ifelse
func chained_if(if_statement: Syntax.Statements.IfStatement): Syntax.Statements.IfStatement? {
    assert if_statement.else_branch.count() == 1
    var chained = shapes.as_if_statement(if_statement.else_branch[0])
    assert chained
    assert chained.follows_else
    return chained
}

# ../../../../specs/control_flow.md#nested-ifelse
func nested_if_else(if_statement: Syntax.Statements.IfStatement) {
    assert if_statement.has_else_branch or if_statement.follows_else
    if_else_in_branch(if_statement.then_branch)
    var chained = chained_if(if_statement)
    if not chained {
        if_else_in_branch(if_statement.else_branch)
    }
}

# ../../../../specs/control_flow.md#nested-ifelse
func if_else_in_branch(branch: List<Syntax.Statements.Statement>) {
    var index = 0
    while index < branch.count() {
        var nested = shapes.as_if_statement(branch[index])
        if nested and nested.has_else_branch {
            refuse_at(
                nested.line,
                "this 'if'/'else' is inside a branch of another 'if'/'else': move it into a function named for what it decides, or, when both test which member of a union or which value of an enum a value is, use one 'switch'",
            )
        }
        index = index + 1
    }
}

# ../../../../specs/control_flow.md#one-statement-per-case
func case_runs(count: Integer) {
    assert count > 1
    refuse(
        "this case runs {count} statements: a case is one statement, so move them into a function named for what they do and call it here",
    )
}

# ../../../../specs/control_flow.md#control-flow-in-full
func returned_local(
    statements: List<Syntax.Statements.Statement>,
    index: Integer,
    return_type_name: String,
    declared_matches: Boolean,
) {
    assert index + 1 < statements.count()
    var declaration = shapes.as_variable_declaration(statements[index])
    assert declaration
    assert declaration.value
    var declared_value = declaration.value
    var returned = shapes.as_return_statement(statements[index + 1])
    assert returned
    assert returned.value
    var returned_value = returned.value
    var returned_name = shapes.as_identifier(returned_value)
    assert returned_name
    assert returned_name.name == declaration.name
    assert declared_matches
    var source = printer.source_expression(declared_value)
    refuse_at(
        declaration.line,
        "'{declaration.name}' is declared only to be returned on the next line: write 'return {source}', since 'return' already makes the value the function's {return_type_name}",
    )
}

# ../../../../specs/control_flow.md#control-flow-in-full
func can_leave(statements: List<Syntax.Statements.Statement>): Boolean {
    return statements.any(statement_can_leave)
}

# ../../../../specs/control_flow.md#control-flow-in-full
func statement_can_leave(statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.ReturnStatement: return true
        Syntax.Statements.AssertStatement: return true
        Syntax.Statements.IfStatement: return can_leave(statement.then_branch) or can_leave(statement.else_branch)
        Syntax.Statements.WhileStatement: return can_leave(statement.body)
        Syntax.Statements.SwitchStatement: return switch_can_leave(statement)
        _: return false
    }
}

# ../../../../specs/control_flow.md#control-flow-in-full
func switch_can_leave(statement: Syntax.Statements.SwitchStatement): Boolean {
    var index = 0
    while index < statement.cases.count() {
        var each_case = statement.cases[index]
        if can_leave(each_case.body) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../../specs/control_flow.md#control-flow-in-full
func expression_calls(expression: Syntax.Expressions.Expression?): Boolean {
    if not expression {
        return false
    }
    switch expression {
        Syntax.Expressions.CallExpression: return true
        Syntax.Expressions.GenericCallExpression: return true
        Syntax.Expressions.BinaryExpression: return expression_calls(expression.left) or expression_calls(expression.right)
        Syntax.Expressions.UnaryExpression: return expression_calls(expression.operand)
        Syntax.Expressions.MemberExpression: return expression_calls(expression.object)
        Syntax.Expressions.IndexExpression: return expression_calls(expression.object) or expression_calls(expression.index)
        _: return false
    }
}

# ../../../../specs/control_flow.md#control-flow-in-full
func block_calls(statements: List<Syntax.Statements.Statement>): Boolean {
    return statements.any(statement_calls)
}

# ../../../../specs/control_flow.md#control-flow-in-full
func statement_calls(statement: Syntax.Statements.Statement): Boolean {
    switch statement {
        Syntax.Statements.VariableDeclaration: return expression_calls(statement.value)
        Syntax.Statements.AssignmentStatement: return expression_calls(statement.target) or expression_calls(statement.value)
        Syntax.Statements.IfStatement: return expression_calls(statement.condition) or block_calls(statement.then_branch) or block_calls(statement.else_branch)
        Syntax.Statements.WhileStatement: return expression_calls(statement.condition) or block_calls(statement.body)
        Syntax.Statements.SwitchStatement: return expression_calls(statement.subject) or switch_calls(statement)
        Syntax.Statements.AssertStatement: return expression_calls(statement.value)
        Syntax.Statements.ReturnStatement: return expression_calls(statement.value)
        Syntax.Statements.ExpressionStatement: return expression_calls(statement.value)
        _: return false
    }
}

# ../../../../specs/control_flow.md#control-flow-in-full
func switch_calls(statement: Syntax.Statements.SwitchStatement): Boolean {
    var index = 0
    while index < statement.cases.count() {
        var each_case = statement.cases[index]
        if block_calls(each_case.body) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../../specs/control_flow.md#control-flow-in-full
func spinning_loop(while_statement: Syntax.Statements.WhileStatement) {
    crash while_statement.condition
    assert shapes.is_true_literal(while_statement.condition)
    assert not can_leave(while_statement.body)
    assert not block_calls(while_statement.body)
    refuse(
        "this 'while true' never ends: nothing inside it returns, asserts or crashes, and it calls nothing, so the program would spin here for good: leave it with a 'return' ('if done \{ return }'), or loop 'while' a condition",
    )
}

