func null_opening(read_path: String, found_name: String): String {
    var shown = with_article(found_name)
    if read_path.is_empty() {
        return "this value may be null (it is {shown})"
    }
    return "'{read_path}' may be missing, since every '[ ]' answers a 'T?' (this one is {shown})"
}

# ../../../../specs/failure.md#nothing-fails-silently-the-rule
func null_advice(read_path: String, bound: String): String {
    if read_path.is_empty() {
        return "narrow it first with 'if value \{ }', 'assert value' or 'crash value'"
    }
    return "narrow it first with 'crash {read_path}', 'assert {read_path}' or 'if {read_path} \{ }'{bound}"
}

