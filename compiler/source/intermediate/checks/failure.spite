    )
}

# ../../../../specs/failure.md#assert-is-control-flow
func shown_default(return_type: Analysis.SpiteType): String {
    var scalar = types.as_scalar(return_type)
    if scalar {
        return scalar_default(scalar.kind)
    }
    if types.as_string(return_type) {
        return "\"\""
    }
    var enum_type = types.as_enum(return_type)
    if enum_type {
        var first_value = enum_type.values.first()
        crash first_value
        return "'{first_value}'"
    }
    return "an object with every attribute at its default"
}

# ../../../../specs/failure.md#assert-is-control-flow
func scalar_default(kind: Analysis.Types.NumericKind): String {
    if kind == 'boolean_kind' {
        return "false"
    }
    if kind == 'float_kind' or kind == 'double_kind' {
        return "0.0"
    }
    return "0"
}

# ../../../../specs/failure.md#assert-is-control-flow
func example_answer(return_type: Analysis.SpiteType, made_answer: String): String {
    var scalar = types.as_scalar(return_type)
    if scalar {
        if scalar.kind == 'boolean_kind' {
            return "false"
        }
        if scalar.kind == 'float_kind' or scalar.kind == 'double_kind' {
            return "-1.0"
        }
        return "-1"
    }
    if types.as_string(return_type) {
        return "\"\""
    }
    var enum_type = types.as_enum(return_type)
    if enum_type {
        var first_value = enum_type.values.first()
        crash first_value
        return "'{first_value}'"
    }
    return made_answer
}

# ../../../../specs/failure.md#assert-is-control-flow
func truth_written_out(
    condition: Syntax.Expressions.Expression,
    expressions: ExpressionLowering,
): Syntax.Expressions.Expression {
    var joined = shapes.as_binary(condition)
    if joined and joined.operator == 'logical_and' {
        crash joined.left
        crash joined.right
        var left_side = joined.left
        var right_side = joined.right
        var left = truth_written_out(left_side, expressions)
        var right = truth_written_out(right_side, expressions)
        return Syntax.Expressions.BinaryExpression('logical_and', left, right)
    }
    if not expressions.is_maybe_boolean(condition) {
        return condition
    }
    var compared: Syntax.Expressions.Expression = Syntax.Expressions.TrueLiteral()
    return Syntax.Expressions.BinaryExpression('equal', condition, compared)
}

# ../../../../specs/failure.md#assert-is-control-flow
func default_answer(
    statement: Syntax.Statements.AssertStatement,
    return_type: Analysis.SpiteType,
    type_name: String,
    made_answer: String,
    answers_nothing: Boolean,
    expressions: ExpressionLowering,
) {
    assert not statement.is_crash
    assert not answers_nothing
    crash statement.value
    var written = truth_written_out(statement.value, expressions)
    var condition = printer.source_expression(written)
    var negated = negated_condition(written)
    var leaving = printer.source_expression(negated)
    var answer = example_answer(return_type, made_answer)
    var answer_choice = ""
    if not answer.is_empty() {
        answer_choice = " return a value ('if {leaving} \{ return {answer} }'),"
    }
    var nullable_choice = " make the result '{type_name}?',"
    if answer == "false" {
        nullable_choice = ""
    }
    var shown = shown_default(return_type)
    refuse(
        "this 'assert' would answer a default {type_name} ({shown}) that a caller cannot tell from a real one:{answer_choice}{nullable_choice} or 'crash {condition}' if this is a developer mistake",
    )
}

# ../../../../specs/failure.md#assert-is-control-flow
func falling_end(
    function_name: String,
    answered_name: String,
    instance_text: String,
    is_nullable: Boolean,
    body: List<Syntax.Statements.Statement>,
) {
    var path = falling_path(body)
    assert path
    var reaches = "it reaches its end without a 'return'"
    var ending = "end it with 'return <value>', or with 'crash' if it cannot get there"
    if not path.is_empty() {
        reaches = "{path} it reaches its end without a 'return'"
        ending = "end that path with 'return <value>', or with 'crash' if it cannot happen"
    }
    var answered = with_article(answered_name)
    var unwritten = answered
    if is_nullable {
        unwritten = "a null"
    }
    refuse(
        "'{function_name}' answers {answered}{instance_text}, but {reaches}, so a caller would get {unwritten} nobody wrote: {ending}",
    )
}

# ../../../../specs/failure.md#assert-is-control-flow
func falling_path(statements: List<Syntax.Statements.Statement>): String? {
    var last = statements.last()
    if last {
        return statement_falling_path(last)
    }
    return ""
}

# ../../../../specs/failure.md#assert-is-control-flow
func statement_falling_path(statement: Syntax.Statements.Statement): String? {
    switch statement {
        Syntax.Statements.ReturnStatement: return null
        Syntax.Statements.AssertStatement: return assert_falling_path(statement)
        Syntax.Statements.IfStatement: return if_falling_path(statement)
        Syntax.Statements.WhileStatement: return while_falling_path(statement)
        Syntax.Statements.SwitchStatement: return switch_falling_path(statement)
        _: return ""
    }
}

# ../../../../specs/failure.md#assert-is-control-flow
func assert_falling_path(statement: Syntax.Statements.AssertStatement): String? {
    if statement.is_crash {
        assert statement.value
        assert not shapes.is_false_literal(statement.value)
    }
    return ""
}

# ../../../../specs/failure.md#assert-is-control-flow
func while_falling_path(statement: Syntax.Statements.WhileStatement): String? {
    crash statement.condition
    assert not shapes.is_true_literal(statement.condition)
    return "when the 'while' at line {statement.line} ends"
}

# ../../../../specs/failure.md#assert-is-control-flow
func if_falling_path(if_statement: Syntax.Statements.IfStatement): String? {
    crash if_statement.condition
    var condition = printer.source_expression(if_statement.condition)
    if not if_statement.has_else_branch {
        return "when '{condition}' is false (line {if_statement.line}, an 'if' with no 'else')"
    }
    var then_path = falling_path(if_statement.then_branch)
    if then_path {
        return path_with_step("when '{condition}' is true (line {if_statement.line})", then_path)
    }
    var else_path = falling_path(if_statement.else_branch)
    assert else_path
    return path_with_step("when '{condition}' is false (line {if_statement.line})", else_path)
}

# ../../../../specs/failure.md#assert-is-control-flow
func switch_falling_path(switch_statement: Syntax.Statements.SwitchStatement): String? {
    var index = 0
    while index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[index]
        var case_path = falling_path(switch_case.body)
        if case_path {
            var label = case_label(switch_case)
            var step = "in the case {label} of the 'switch' at line {switch_statement.line}"
            return path_with_step(step, case_path)
        }
        index = index + 1
    }
    assert switch_statement.cases.is_empty()
    return ""
}

# ../../../../specs/failure.md#assert-is-control-flow
func case_label(switch_case: Syntax.Statements.SwitchCase): String {
    if switch_case.value {
        return printer.source_expression(switch_case.value)
    }
    crash switch_case.type_reference
    return printer.source_type(switch_case.type_reference)
}

# ../../../../specs/failure.md#assert-is-control-flow
func path_with_step(step: String, rest: String): String {
    if rest.is_empty() {
        return step
    }
    return "{step}, then {rest}"
}

# ../../../../specs/failure.md#nothing-fails-silently-the-rule
func operator_symbol(operator: Syntax.Expressions.BinaryOperator): String {
    switch operator {
        'add': return "+"
        'subtract': return "-"
        'multiply': return "*"
        'divide': return "/"
        'modulo': return "%"
        'equal': return "=="
        'not_equal': return "!="
        'less': return "<"
        'less_equal': return "<="
        'greater': return ">"
        'greater_equal': return ">="
        'logical_and': return "and"
        _: return "or"
    }
}

# ../../../../specs/failure.md#nothing-fails-silently-the-rule
func nullable_use(
    object_expression: Syntax.Expressions.Expression,
    found_name: String,
    how: String,
    name: String,
    expressions: ExpressionLowering,
) {
    var read_path = ""
    var bound = ""
    var indexed = shapes.as_index(object_expression)
    if indexed {
        var made = expressions.front()
        read_path = made.operand_text(object_expression)
        if not read_path.is_empty() {
            bound = read_bound(indexed)
        }
    }
    switch how {
        "read": null_read(read_path, bound, found_name, name)
        "call": null_called(read_path, bound, found_name, name)
        "store": null_assigned_through(read_path, bound, found_name, name)
        _: null_operand(read_path, bound, found_name, name)
    }
}
