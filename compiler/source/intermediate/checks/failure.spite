func Failure(starting_generator: Generation.Generator) {
    generator = starting_generator
}

# ../../../../specs/failure.md#nothing-fails-silently-the-rule
func refuse(message: String) {
    crash generator
    var quiet = generator.nested_quiet
    generator.nested_quiet = false
    generator.report(message)
    generator.nested_quiet = quiet
}

# ../../../../specs/failure.md#nothing-fails-silently-the-rule
func enter_declaration(path: String, line: Integer, owner: String) {
    crash generator
    saved_path = generator.current_path
    saved_line = generator.current_line
    saved_owner = generator.current_owner
    saved_function = generator.current_function
    generator.current_path = path
    generator.current_line = line
    generator.current_owner = owner
    generator.current_function = ""
}

# ../../../../specs/failure.md#nothing-fails-silently-the-rule
func leave_declaration() {
    crash generator
    generator.current_path = saved_path
    generator.current_line = saved_line
    generator.current_owner = saved_owner
    generator.current_function = saved_function
}

# ../../../../specs/failure.md#nothing-fails-silently-the-rule
func with_article(name: String): String {
    var first_letter = name.slice(0, 1)
    if "AEIOU".contains(first_letter) {
        return "an {name}"
    }
    return "a {name}"
}

