# ../../../../specs/failure.md#assert-is-control-flow
func flipped_comparison(operator: Syntax.Expressions.BinaryOperator): Syntax.Expressions.BinaryOperator {
    switch operator {
        'equal': return 'not_equal'
        'not_equal': return 'equal'
        'less': return 'greater_equal'
        'greater_equal': return 'less'
        'greater': return 'less_equal'
        'less_equal': return 'greater'
        'logical_and': return 'logical_or'
        'logical_or': return 'logical_and'
        _: return operator
    }
}

# ../../../../specs/failure.md#assert-is-control-flow
func negated_condition(condition: Syntax.Expressions.Expression): Syntax.Expressions.Expression {
    var unary = shapes.as_unary(condition)
    if unary and unary.operator == 'logical_not' {
        crash unary.operand
        return unary.operand
    }
    var binary = shapes.as_binary(condition)
    if binary {
        crash binary.left
        crash binary.right
        var flipped = flipped_comparison(binary.operator)
        if binary.operator == 'logical_and' or binary.operator == 'logical_or' {
            var left = negated_condition(binary.left)
            var right = negated_condition(binary.right)
            return Syntax.Expressions.BinaryExpression(flipped, left, right)
        }
        if flipped != binary.operator {
            return Syntax.Expressions.BinaryExpression(flipped, binary.left, binary.right)
        }
    }
    return Syntax.Expressions.UnaryExpression('logical_not', condition)
}

# ../../../../specs/failure.md#assert-is-control-flow
func empty_collection_text(returned: Syntax.Expressions.Expression): String? {
    var listed = shapes.as_list_literal(returned)
    if listed {
        assert listed.elements.is_empty()
        return "[]"
    }
    var made = shapes.as_generic_call(returned)
    assert made and made.arguments.is_empty()
    crash made.callee
    var made_name = printer.source_expression(made.callee)
    assert made_name == "List" or made_name == "Dictionary" or made_name == "Vector" or made_name == "Items"
    return printer.source_expression(returned)
}

# ../../../../specs/failure.md#assert-is-control-flow
func returned_default(
    if_statement: Syntax.Statements.IfStatement,
    return_type: Analysis.SpiteType,
    answers_nothing: Boolean,
): String? {
    assert not if_statement.has_else_branch and if_statement.then_branch.count() == 1
    var only = shapes.as_return_statement(if_statement.then_branch[0])
    assert only
    if not only.value {
        return ""
    }
    var returned = only.value
    if types.as_nullable(return_type) {
        if shapes.is_null_literal(returned) {
            return "null"
        }
        return null
    }
    if answers_nothing {
        return empty_collection_text(returned)
    }
    if shapes.is_false_literal(returned) {
        return "false"
    }
    var text = shapes.as_string_literal(returned)
    if text {
        if text.value.is_empty() {
            return "\"\""
        }
        return null
    }
    var integer = shapes.as_integer_literal(returned)
    if integer {
        if integer.value == 0 {
            return "0"
        }
        return null
    }
    var fraction = shapes.as_float_literal(returned)
    assert fraction
    assert fraction.value == 0.0
    return printer.source_expression(returned)
}

# ../../../../specs/failure.md#assert-is-control-flow
func default_guard(
    if_statement: Syntax.Statements.IfStatement,
    return_type: Analysis.SpiteType,
    answers_nothing: Boolean,
    is_constructor: Boolean,
) {
    assert answers_nothing or is_constructor
    var returned = returned_default(if_statement, return_type, answers_nothing)
    assert returned
    crash if_statement.condition
    var negated = negated_condition(if_statement.condition)
    var proven = printer.source_expression(negated)
    if is_constructor {
        refuse(
            "this 'if' only leaves the constructor, and a constructor is setup, not logic: take already resolved values, or write 'crash {proven}' when this is a bug",
        )
        return
    }
    if returned.is_empty() {
        refuse("this 'if' only returns: write 'assert {proven}' and let the rest run unindented")
        return
    }
    refuse(
        "this 'if' only returns the default '{returned}', which is how a guard is written: write 'assert {proven}' and let the rest run unindented",
    )
}

# ../../../../specs/failure.md#assert-is-control-flow
func terminal_if_of(body: List<Syntax.Statements.Statement>): Syntax.Statements.IfStatement? {
    var last_statement = body.last()
    assert last_statement
    var last_if = shapes.as_if_statement(last_statement)
    assert last_if
    assert not last_if.has_else_branch
    return last_if
}

# ../../../../specs/failure.md#assert-is-control-flow
func terminal_if(
    if_statement: Syntax.Statements.IfStatement,
    body: List<Syntax.Statements.Statement>,
    name: String,
    type_name: String,
    answers_nothing: Boolean,
) {
    assert not if_statement.has_else_branch
    var last = terminal_if_of(body)
    assert last == if_statement
    if not answers_nothing {
        refuse(
            "this 'if' is the last thing the function does and has no 'else', so when '{name}' is null the function answers no {type_name} at all: give that case its own 'return' after the 'if', or make the result '{type_name}?' and write 'assert {name}'",
        )
        return
    }
    refuse(
        "this 'if' is the last thing the function does and has no 'else', so it only checks that '{name}' is there: write 'assert {name}' and let the rest of the function run unindented",
    )
}

