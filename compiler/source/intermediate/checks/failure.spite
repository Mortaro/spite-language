    var object_side = indexed.object
    var index_side = indexed.index
    var object_text = printer.source_expression(object_side)
    var literal = shapes.as_integer_literal(index_side)
    if literal {
        return ", or prove the count first, 'crash {object_text}.count() > {literal.value}'"
    }
    var index_text = printer.source_expression(index_side)
    return ", or read it where a bound proves it, inside 'while {index_text} < {object_text}.count()'"
}

