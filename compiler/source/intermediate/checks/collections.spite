func items_inline_passes(form: String, item_label: String) {
    refuse(
        "'{form}' passes each item to a function, and '{item_label}' fits a Vector, so an item of these Items is borrowed from them, never passed on: give the item's class a function and call it with a member template, such as '{form}_<function>()'",
    )
}

