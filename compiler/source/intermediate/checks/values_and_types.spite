# ../../../../specs/values_and_types.md#numbers-are-classes-and-this
func wider_bitwise_operand(
    name: String,
    object: Syntax.Expressions.Expression,
    argument: Syntax.Expressions.Expression,
    receiver_type: Analysis.SpiteType,
    argument_type: Analysis.SpiteType,
) {
    assert name == "bits_and" or name == "bits_or" or name == "bits_exclusive_or"
    var receiver_scalar = types.as_scalar(receiver_type)
    var argument_scalar = types.as_scalar(argument_type)
    assert receiver_scalar and argument_scalar
    assert not literal_fits(argument, receiver_scalar.kind)
    assert is_wider(receiver_scalar.kind, argument_scalar.kind)
    var argument_text = printer.source_expression(argument)
    var receiver_text = printer.source_expression(object)
    var receiver_name = kind_name(receiver_scalar.kind)
    var argument_name = kind_name(argument_scalar.kind)
    var receiver_article = with_article(receiver_name)
    var argument_article = with_article(argument_name)
    refuse(
        "'{receiver_text}.{name}({argument_text})' works in {receiver_article}, since a bitwise function takes its receiver's type, and '{argument_text}' is {argument_article}, which would be cut to fit: store the receiver in {argument_article} first ('var wide: {argument_name} = {receiver_text}'), or store '{argument_text}' in {receiver_article} first if it fits one",
    )
}

# ../../../../specs/values_and_types.md#enums-in-full
func enum_numbers(enum_name: String, values: List<String>, written: List<String>) {
    var owners = Dictionary<String, String>()
    var next: Long = 0
    var failed = false
    var index = 0
    while index < values.count() and not failed {
        var value = values[index]
        var written_number = written[index]
        crash written_number
        var number = next
        if not written_number.is_empty() {
            var read = written_number.to_long()
            crash read
            number = read
        }
        if number < Integer.smallest or number > Integer.largest {
            enum_number_too_large(value, number, enum_name)
            failed = true
        }
        var key = number.to_string()
        var owner = owners[key]
        if owner and not failed {
            enum_number_twice(owner, value, number, enum_name)
            failed = true
        }
        owners[key] = value
        next = number + 1
        index = index + 1
    }
}

# ../../../../specs/values_and_types.md#enums-in-full
func enum_number_too_large(value: String, number: Long, enum_name: String) {
    refuse(
        "'{value}' would be number {number} of enum '{enum_name}', which does not fit an Integer: an enum value's number is an Integer",
    )
}

# ../../../../specs/values_and_types.md#enums-in-full
func enum_number_twice(owner: String, value: String, number: Long, enum_name: String) {
    refuse(
        "'{owner}' and '{value}' both have the number {number} in enum '{enum_name}': a value's number is its identity, so give one of them another",
    )
}

