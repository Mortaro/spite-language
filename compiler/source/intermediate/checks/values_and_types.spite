func case_not_in_union(case_name: String, union_name: String) {
    refuse("'{case_name}' is not a member of union '{union_name}'")
}

# ../../../../specs/values_and_types.md#unions-in-full
func case_is_value(union_name: String) {
    refuse("a case of a switch over the union '{union_name}' names one of its classes, never a value")
}

# ../../../../specs/values_and_types.md#unions-in-full
func case_names_no_class() {
    refuse("a switch case must name a class of the union")
}

# ../../../../specs/values_and_types.md#unions-in-full
func rest_case_misplaced(
    case_index: Integer,
    case_count: Integer,
    covered_count: Integer,
    member_count: Integer,
    union_name: String,
) {
    if case_index != case_count - 1 {
        refuse("'_:' answers for every member without a case of its own, so it is the last case")
    } else if covered_count == member_count {
        refuse("every member of '{union_name}' already has a case, so '_:' answers for nothing: remove it")
    }
}

# ../../../../specs/values_and_types.md#unions-in-full
func repeated_cases(switch_statement: Syntax.Statements.SwitchStatement) {
    var bodies = List<String>()
    var names = List<String>()
    var rest_body = ""
    var index = 0
    while index < switch_statement.cases.count() {
        var switch_case = switch_statement.cases[index]
        var printed = printer.source_statement_list(switch_case.body, 0)
        if is_rest_case(switch_case) {
            rest_body = printed
        } else {
            var label = printer.case_label(switch_case)
            bodies.append(printed)
            names.append(label)
        }
        index = index + 1
    }
    var first = 0
    var found = false
    while first < bodies.count() and not found {
        found = repeated_from(first, bodies, names, rest_body)
        first = first + 1
    }
}

# ../../../../specs/values_and_types.md#unions-in-full
func repeated_from(first: Integer, bodies: List<String>, names: List<String>, rest_body: String): Boolean {
    var first_name = names[first]
    crash first_name
    if not rest_body.is_empty() and bodies[first] == rest_body {
        refuse("the case '{first_name}' does the same as '_:': remove it and let '_:' answer for it")
        return true
    }
    var other = first + 1
    while other < bodies.count() and rest_body.is_empty() {
        if bodies[first] == bodies[other] {
            var other_name = names[other]
            crash other_name
            refuse(
                "the cases '{first_name}' and '{other_name}' do the same thing: write it once, as the last case '_:'",
            )
            return true
        }
        other = other + 1
    }
    return false
}

# ../../../../specs/values_and_types.md#unions-in-full
func is_rest_case(switch_case: Syntax.Statements.SwitchCase): Boolean {
    if switch_case.type_reference {
        var named = shapes.as_named_type(switch_case.type_reference)
        if named {
            return named.path.count() == 1 and named.path[0] == "_"
        }
    }
    return false
}

# ../../../../specs/values_and_types.md#unions-in-full
func single_case(switch_statement: Syntax.Statements.SwitchStatement) {
    assert switch_statement.cases.count() == 2
    var class_case = case_at(switch_statement, 0)
    var rest_case = case_at(switch_statement, 1)
    crash class_case
    crash rest_case
    assert is_rest_case(rest_case)
    assert only_returns(class_case.body) and only_returns(rest_case.body)
    crash switch_statement.subject
    var subject_expression = switch_statement.subject
    var subject = printer.source_expression(subject_expression)
    var tested = printer.case_label(class_case)
    var answer = returned_boolean(class_case.body)
    var rest_answer = returned_boolean(rest_case.body)
    if answer and rest_answer and answer != rest_answer {
        var comparison = "=="
        if answer == "false" {
            comparison = "!="
        }
        var question = "what class '{subject}' is"
        if class_case.value {
            question = "whether '{subject}' is {tested}"
        }
        refuse("this switch only asks {question}: write 'return {subject} {comparison} {tested}'")
        return
    }
    refuse(
        "a switch with one case and '_:' is an if: write 'if {subject} == {tested} \{ ... }', returning early, and then what '_:' does",
    )
}

# ../../../../specs/values_and_types.md#unions-in-full
func case_at(switch_statement: Syntax.Statements.SwitchStatement, position: Integer): Syntax.Statements.SwitchCase? {
    return switch_statement.cases[position]
}

# ../../../../specs/values_and_types.md#unions-in-full
func only_returns(body: List<Syntax.Statements.Statement>): Boolean {
    if body.count() != 1 {
        return false
    }
    return body[0] == Syntax.Statements.ReturnStatement
}

# ../../../../specs/values_and_types.md#unions-in-full
func returned_boolean(body: List<Syntax.Statements.Statement>): String? {
    assert body.count() == 1
    var returned = shapes.as_return_statement(body[0])
    assert returned
    assert returned.value
    if shapes.is_true_literal(returned.value) {
        return "true"
    }
    if shapes.is_false_literal(returned.value) {
        return "false"
    }
    return null
}

