func enum_reload_renumbered(value: String, enum_name: String, now: Integer, before: Integer) {
    refuse(
        "a reload cannot give '{value}' of enum '{enum_name}' the number {now}: the running program stores it as {before}, so restart it to renumber",
    )
}

# ../../../../specs/values_and_types.md#unions-in-full
func union_members(
    path: String,
    owner: String,
    union_name: String,
    members: List<Syntax.Types.Type>,
    value_names: List<String>,
) {
    enter_declaration(path, 0, owner)
    var index = 0
    while index < members.count() {
        union_member(union_name, members[index], value_names)
        index = index + 1
    }
    leave_declaration()
}

# ../../../../specs/values_and_types.md#unions-in-full
func union_member(union_name: String, member: Syntax.Types.Type, value_names: List<String>) {
    var named = shapes.as_named_type(member)
    assert named
    var joined_path = named.path.join(".")
    if joined_path == "String" or value_names.contains(joined_path) {
        var shown = with_article(joined_path)
        refuse(
            "'{joined_path}' cannot be a member of union '{union_name}': a union holds objects whose class a switch tests, and {shown} is a value; make the member a class of your own that keeps it in an attribute",
        )
    } else if not named.arguments.is_empty() {
        refuse(
            "a generic class cannot be a member of union '{union_name}': a switch could tell only that it is a '{joined_path}', not of what; make the member a class of your own that keeps it in an attribute",
        )
    }
}

