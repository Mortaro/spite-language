    )
}

# ../../../../specs/values_and_types.md#numbers-are-classes-and-this
func operator_through_type(symbol: String, shape_name: String) {
    refuse(
        "'{symbol}' on a value read as '{shape_name}' needs the class that fits the type, which is not known while compiling: take the value through a codegen value the type constrains, 'generic $value_type: {shape_name}'",
    )
}

# ../../../../specs/values_and_types.md#inline-types-and-duck-typing-in-full
func type_has_no_attribute(type_name: String, name: String) {
    refuse("type '{type_name}' has no attribute '{name}'")
}

# ../../../../specs/values_and_types.md#inline-types-and-duck-typing-in-full
func does_not_fit_type(subject: String, type_name: String, problem: String) {
    refuse("{subject} does not fit type '{type_name}': {problem}")
}

# ../../../../specs/values_and_types.md#numbers-are-classes-and-this
func does_not_fit_required_type(
    given_name: String,
    type_name: String,
    instance_name: String,
    constrained_name: String,
    problem: String,
) {
    refuse(
        "'{given_name}' does not fit type '{type_name}', which '{instance_name}' requires of ${constrained_name}: {problem}",
    )
}
