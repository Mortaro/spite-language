# ../../../design/proposals/desugared_high_ir.md#the-form
var c_name = ""
var qualified = ""
var information: Analysis.ClassInfo? = null
var stored_fields = List<Field>()
var is_value = false
var is_singleton = false
var arrangement = "object"

func Layout(starting_c_name: String, starting_qualified: String) {
    c_name = starting_c_name
    qualified = starting_qualified
}

func field_named(name: String): Field? {
    var found: Field? = null
    var index = 0
    while index < stored_fields.count() {
        if stored_fields[index].name == name {
            found = stored_fields[index]
        }
        index = index + 1
    }
    return found
}
