var build = Build()
var program = Program()
var last_output = ""

func is_windows(): Boolean {
    return build.operating_system == "windows"
}

func system_name(): String {
    return build.operating_system
}

func null_device(): String {
    if is_windows() {
        return "NUL"
    }
    return "/dev/null"
}

func native_path(path: String): String {
    if is_windows() {
        return path.replace("/", "\\")
    }
    return path
}

func quoted(argument: String): String {
    var no_arguments = List<String>()
    var quoting = Process("", no_arguments)
    return quoting.quoted_argument(argument)
}

func run(line: String): Integer {
    var no_arguments = List<String>()
    var process = Process(line, no_arguments)
    var status = process.run()
    last_output = process.output()
    return status
}

func create_folder(path: String) {
    var segments = path.split("/")
    var current = ""
    var index = 0
    while index < segments.count() {
        if index > 0 {
            current = "{current}/"
        }
        current = "{current}{segments[index]}"
        Directory(current).create()
        index = index + 1
    }
}

func removed_tree(path: String) {
    var native = native_path(path)
    if is_windows() {
        run("rmdir /s /q \"{native}\" 2>&1")
        return
    }
    run("rm -rf \"{native}\" 2>&1")
}

func copied_tree(from_path: String, to_path: String): Boolean {
    var native_from = native_path(from_path)
    var native_to = native_path(to_path)
    if is_windows() {
        return run("xcopy /E /I /Q /Y \"{native_from}\" \"{native_to}\" 2>&1") == 0
    }
    return run("cp -r \"{native_from}\" \"{native_to}\" 2>&1") == 0
}

func processor_count(): Integer {
    var named = program.environment("NUMBER_OF_PROCESSORS")
    if named {
        var count = named.trim().to_integer()
        if count and count > 0 {
            return count
        }
    }
    if run("getconf _NPROCESSORS_ONLN 2>&1") == 0 {
        var probed_count = last_output.trim().to_integer()
        if probed_count and probed_count > 0 {
            return probed_count
        }
    }
    return 4
}

func number_from_environment(name: String, otherwise: Integer): Integer {
    var named = program.environment(name)
    if not named {
        return otherwise
    }
    var number = named.trim().to_integer()
    crash number
    crash number > 0
    return number
}

func c_compiler(): String {
    var chosen = program.environment("CC")
    if chosen and not chosen.trim().is_empty() {
        return chosen.trim()
    }
    return "clang"
}
