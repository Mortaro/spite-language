# ../../design/backend_x86_64_encoding.md#the-table
var console = Console()
var encoder = Encoder(0)
var rows_checked = 0

func X86Encoding() {
    load "../../compiler/source/backend/x86"
    check_the_moves()
    check_the_additions()
    check_the_subtractions()
    check_the_comparisons()
    check_the_multiplications()
    check_the_divisions()
    check_the_conditional_jumps()
    check_the_jumps()
    check_the_calls()
    check_the_returns()
    check_the_pushes()
    check_the_pops()
    check_the_addresses()
    check_the_floating_moves()
    check_the_floating_arithmetic()
    console.print("{rows_checked} rows pass")
}

func compare(assembly: String, expected: String) {
    rows_checked = rows_checked + 1
    var given = bytes_as_text(encoder.bytes)
    console.print(assembly)
    crash given == expected
}

func bytes_as_text(given: Buffer): String {
    var digits = "0123456789ABCDEF"
    var text = ""
    var index = 0
    while index < given.count() {
        var one = given[index]
        crash one
        var wide: UnsignedInteger = one
        text = "{text} {digits.character_at(wide / 16)}{digits.character_at(wide % 16)}"
        index = index + 1
    }
    return text.trim()
}

func check_two(
    assembly: String,
    expected: String,
    instruction: Spite.Function<Destination, Source, Nothing>,
    destination: Destination,
    source: Source,
) {
    encoder.clear()
    instruction(destination, source)
    compare(assembly, expected)
}

func check_one(assembly: String, expected: String, instruction: Spite.Function<Source, Nothing>, operand: Source) {
    encoder.clear()
    instruction(operand)
    compare(assembly, expected)
}

func check_into(
    assembly: String,
    expected: String,
    instruction: Spite.Function<Destination, Nothing>,
    destination: Destination,
) {
    encoder.clear()
    instruction(destination)
    compare(assembly, expected)
}

func check_alone(assembly: String, expected: String, instruction: Spite.Function<Nothing>) {
    encoder.clear()
    instruction()
    compare(assembly, expected)
}

func check_by(
    assembly: String,
    expected: String,
    instruction: Spite.Function<Destination, Source, Immediate, Nothing>,
    destination: Destination,
    left: Source,
    factor: Immediate,
) {
    encoder.clear()
    instruction(destination, left, factor)
    compare(assembly, expected)
}

func check_to(assembly: String, expected: String, instruction: Spite.Function<Integer, Nothing>, target: Integer) {
    encoder.clear()
    instruction(target)
    compare(assembly, expected)
}

func check_if(assembly: String, expected: String, condition: Condition, target: Integer) {
    encoder.clear()
    encoder.jump_if(condition, target)
    compare(assembly, expected)
}

func check_the_moves() {
    var destination: Destination? = null
    var source: Source? = null
    destination = Register(0, 64)
    source = Register(3, 64)
    check_two("mov rax, rbx", "48 89 D8", encoder.move, destination, source)
    destination = Register(0, 32)
    source = Register(3, 32)
    check_two("mov eax, ebx", "89 D8", encoder.move, destination, source)
    destination = Register(1, 64)
    source = Immediate(42)
    check_two("mov rcx, 42", "48 C7 C1 2A 00 00 00", encoder.move, destination, source)
    destination = Register(1, 32)
    check_two("mov ecx, 42", "B9 2A 00 00 00", encoder.move, destination, source)
    destination = Register(0, 64)
    source = Immediate(1234605616436508552)
    check_two("mov rax, 0x1122334455667788", "48 B8 88 77 66 55 44 33 22 11", encoder.move, destination, source)
    source = Place().at_register(7, 8)
    check_two("mov rax, [rdi + 8]", "48 8B 47 08", encoder.move, destination, source)
    destination = Register(0, 32)
    check_two("mov eax, [rdi + 8]", "8B 47 08", encoder.move, destination, source)
    destination = Place().at_register(7, 8)
    source = Register(0, 64)
    check_two("mov [rdi + 8], rax", "48 89 47 08", encoder.move, destination, source)
    source = Register(0, 32)
    check_two("mov [rdi + 8], eax", "89 47 08", encoder.move, destination, source)
    destination = Place().at_register(7, 8).of_bits(32)
    source = Immediate(42)
    check_two("mov dword ptr [rdi + 8], 42", "C7 47 08 2A 00 00 00", encoder.move, destination, source)
    destination = Register(0, 64)
    source = Place().at_register(7, 0)
    check_two("mov rax, [rdi]", "48 8B 07", encoder.move, destination, source)
    source = Place().indexed_by(7, 6, 4, 0)
    check_two("mov rax, [rdi + rsi*4]", "48 8B 04 B7", encoder.move, destination, source)
    source = Place().indexed_by(7, 6, 4, 8)
    check_two("mov rax, [rdi + rsi*4 + 8]", "48 8B 44 B7 08", encoder.move, destination, source)
    source = Place().indexed_by(7, 6, 8, 2048)
    check_two("mov rax, [rdi + rsi*8 + 2048]", "48 8B 84 F7 00 08 00 00", encoder.move, destination, source)
    source = Place().at_register(4, 16)
    check_two("mov rax, [rsp + 16]", "48 8B 44 24 10", encoder.move, destination, source)
    source = Place().at_register(5, 0)
    check_two("mov rax, [rbp + 0]", "48 8B 45 00", encoder.move, destination, source)
    source = Place().at_register(7, -8)
    check_two("mov rax, [rdi - 8]", "48 8B 47 F8", encoder.move, destination, source)
    source = Place().at_register(7, 127)
    check_two("mov rax, [rdi + 127]", "48 8B 47 7F", encoder.move, destination, source)
    source = Place().at_register(7, 128)
    check_two("mov rax, [rdi + 128]", "48 8B 87 80 00 00 00", encoder.move, destination, source)
    source = Place().after_the_instruction(4096)
    check_two("mov rax, [rip + 4096]", "48 8B 05 00 10 00 00", encoder.move, destination, source)
    source = Place().at_the_address(4210688)
    check_two("mov rax, [0x404000]", "48 8B 04 25 00 40 40 00", encoder.move, destination, source)
    source = Place().at_register(12, 8)
    check_two("mov rax, [r12 + 8]", "49 8B 44 24 08", encoder.move, destination, source)
    source = Place().indexed_by(7, 12, 2, 8)
    check_two("mov rax, [rdi + r12*2 + 8]", "4A 8B 44 67 08", encoder.move, destination, source)
}

func check_the_additions() {
    var destination: Destination? = null
    var source: Source? = null
    destination = Register(0, 64)
    source = Register(3, 64)
    check_two("add rax, rbx", "48 01 D8", encoder.add, destination, source)
    destination = Register(0, 32)
    source = Register(3, 32)
    check_two("add eax, ebx", "01 D8", encoder.add, destination, source)
    destination = Register(0, 64)
    source = Immediate(5)
    check_two("add rax, 5", "48 83 C0 05", encoder.add, destination, source)
    destination = Register(3, 64)
    source = Immediate(5000)
    check_two("add rbx, 5000", "48 81 C3 88 13 00 00", encoder.add, destination, source)
    destination = Register(0, 32)
    source = Immediate(5)
    check_two("add eax, 5", "83 C0 05", encoder.add, destination, source)
    destination = Register(0, 64)
    source = Place().at_register(7, 8)
    check_two("add rax, [rdi + 8]", "48 03 47 08", encoder.add, destination, source)
    destination = Register(0, 32)
    source = Place().at_register(7, 8)
    check_two("add eax, [rdi + 8]", "03 47 08", encoder.add, destination, source)
    destination = Place().at_register(7, 8).of_bits(64)
    source = Register(0, 64)
    check_two("add qword ptr [rdi + 8], rax", "48 01 47 08", encoder.add, destination, source)
    destination = Place().at_register(7, 8).of_bits(32)
    source = Register(0, 32)
    check_two("add dword ptr [rdi + 8], eax", "01 47 08", encoder.add, destination, source)
    destination = Place().at_register(7, 8).of_bits(64)
    source = Immediate(5)
    check_two("add qword ptr [rdi + 8], 5", "48 83 47 08 05", encoder.add, destination, source)
    destination = Place().at_register(7, 8).of_bits(64)
    source = Immediate(5000)
    check_two("add qword ptr [rdi + 8], 5000", "48 81 47 08 88 13 00 00", encoder.add, destination, source)
    destination = Place().at_register(7, 8).of_bits(32)
    source = Immediate(5)
    check_two("add dword ptr [rdi + 8], 5", "83 47 08 05", encoder.add, destination, source)
    destination = Place().at_register(7, 8).of_bits(32)
    source = Immediate(5000)
    check_two("add dword ptr [rdi + 8], 5000", "81 47 08 88 13 00 00", encoder.add, destination, source)
}

