# ../../design/backend_windows_executable_format.md#the-entry-code
var console = Console()
var program = Program()

func HandBuiltExecutable() {
    load "../../compiler/source/backend/executable_writing"
    load "../../compiler/source/backend/x86"
    var imported = List<String>()
    imported.append("ExitProcess")
    var image = WindowsExecutableWriter(imported)
    var encoder = Encoder(0)
    move_the_exit_status_into_the_first_argument(encoder, 42)
    align_the_stack_for_the_call(encoder)
    reach_the_import_slot(encoder, image)
    call_through_the_slot(encoder)
    stop_if_the_call_returns(encoder)
    var path = ".\\hand_built_executable.exe"
    image.write(path, encoder.bytes)
    var no_arguments = List<String>()
    var finished = Process(path, no_arguments)
    var status = finished.run()
    console.print("the executable we wrote exited with", status)
    crash status == 42
}

func move_the_exit_status_into_the_first_argument(encoder: Encoder, status: Integer) {
    var first_argument = Register(1, 32)
    var exit_code = Immediate(status)
    encoder.move(first_argument, exit_code)
}

func align_the_stack_for_the_call(encoder: Encoder) {
    var stack = Register(4, 64)
    var room = Immediate(8)
    encoder.subtract(stack, room)
}

func reach_the_import_slot(encoder: Encoder, image: WindowsExecutableWriter) {
    var slot = image.address_of_import("ExitProcess")
    var start = image.code_address()
    var call_starts_at = 16
    var offset = slot - start - call_starts_at
    var slot_place = Place().after_the_instruction(offset)
    var slot_address = Register(0, 64)
    encoder.take_address_of(slot_address, slot_place)
}

func call_through_the_slot(encoder: Encoder) {
    var slot_place = Place().at_register(0, 0)
    encoder.call_through(slot_place)
}

func stop_if_the_call_returns(encoder: Encoder) {
    encoder.illegal_instruction()
}
