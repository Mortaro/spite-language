#!/bin/bash
# Runs the Spite compiler, rebuilding it first if the sources moved on.
#   spite thing                  build thing/thing.exe beside the program and run it
#   spite thing --c-source       write thing/thing.c as well
here="$(cd "$(dirname "$0")/.." && pwd)"
seed="$here/bootstrap/seed/spite_compiler.c"
binary="$here/.spite-cache/spite.exe"   # not in bin/, or it would shadow this launcher on PATH

find_c_compiler() {
    for candidate in cc clang gcc; do
        command -v "$candidate" >/dev/null 2>&1 && { echo "$candidate"; return; }
    done
    for found in "/c/Program Files/Microsoft Visual Studio/"*/*/VC/Tools/Llvm/x64/bin/clang.exe \
                 "/c/Program Files (x86)/Microsoft Visual Studio/"*/*/VC/Tools/Llvm/x64/bin/clang.exe; do
        [ -x "$found" ] && { echo "$found"; return; }
    done
}

# CC, when set, is a command line as the compiler uses it (it may carry arguments), and it wins over the search;
# SPITE_CC names one executable, spaces allowed, and wins over both.
if [ -n "$SPITE_CC" ] || [ -z "$CC" ]; then
    compiler="${SPITE_CC:-$(find_c_compiler)}"
    if [ -z "$compiler" ]; then
        echo "spite: no C compiler found. Set CC or SPITE_CC, or install cc, clang or gcc." >&2
        exit 1
    fi
    # The compiler shells out to CC as one string, so a path with spaces needs its short form.
    case "$compiler" in
        *\ *) export CC="$(cygpath -d "$compiler" 2>/dev/null || echo "$compiler") -Wno-deprecated-declarations" ;;
        *)    export CC="$compiler" ;;
    esac
fi
export CC

if [ ! -x "$binary" ] || [ "$seed" -nt "$binary" ]; then
    echo "spite: building the compiler" >&2
    mkdir -p "$here/.spite-cache"
    maths_library="-lm"   # the compiler folds maths with the C library's own, which Linux and macOS keep in libm
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) maths_library="" ;; esac
    # Another build may be running the old compiler, or building its own copy, at this moment: each build writes
    # its own file and swaps it in, so none of them fails on a file in use. Windows refuses to overwrite a running
    # executable but lets it be renamed, so the old one is moved aside first.
    fresh="$binary.$$.exe"
    $CC -O2 -Wno-parentheses-equality -Wno-deprecated-declarations "$seed" -o "$fresh" $maths_library || { rm -f "$fresh"; exit 1; }
    if ! mv -f "$fresh" "$binary" 2>/dev/null; then
        mv -f "$binary" "$binary.$$.old" 2>/dev/null
        mv -f "$fresh" "$binary" 2>/dev/null
    fi
    rm -f "$fresh" "$here/.spite-cache/"spite.exe.*.old 2>/dev/null   # an old one still running stays until it ends
    [ -x "$binary" ] || { echo "spite: the compiler was built but could not be put in place at $binary" >&2; exit 1; }
fi

# Git for Windows' bash rewrites every argument that looks like a POSIX path when it starts a Windows program, so
# `-- --prefixes=/Game/` would reach the program as `C:/Program Files/Git/Game/`. The launcher writes its own paths
# as Windows paths and turns the rewriting off, so everything after `--` arrives exactly as it was typed.
windows_paths=false
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) windows_paths=true; export MSYS2_ARG_CONV_EXCL="*" ;; esac

# `spite connect <port> [--command="..."]` talks to a program running with --repl-port; nothing in it is a path.
if [ "$1" == "connect" ]; then
    exec "$binary" "$@"
fi

# The compiler finds library/ and launcher/ beside its own executable, so it runs, and the program it builds
# runs, in the caller's working directory: a relative path the program opens is the caller's.
# Folder arguments and flags that name a path are made absolute, so messages name them the same way everywhere.
absolute() {
    case "$1" in
        /*|[A-Za-z]:*) native "$1" ;;
        *)             native "$(pwd)/$1" ;;
    esac
}

# A path the way the compiler reads it: `C:/...` on Windows, where it is a Windows program, and unchanged elsewhere.
native() {
    if $windows_paths; then cygpath -m "$1" 2>/dev/null || echo "$1"; else echo "$1"; fi
}

# `spite format [--check] <file-or-folder> ...` formats every .spite file it names or finds, without compiling;
# --check rewrites nothing, lists every file that would change, and fails if there is one.
if [ "$1" == "format" ]; then
    shift
    arguments=(format)
    if [ "$1" == "--check" ]; then arguments+=(--check); shift; fi
    [ $# -eq 0 ] && set -- .
    for target in "$@"; do arguments+=("$(absolute "$target")"); done
    exec "$binary" "${arguments[@]}"
fi

# `spite thing` is the common case: every output is a Build field (--c-source, --executable, --run=false, ...),
# and anything starting with - is passed through.
arguments=()
passing=false
for argument in "$@"; do
    if $passing; then arguments+=("$argument"); continue; fi
    case "$argument" in
        --)                   passing=true; arguments+=("--") ;;
        --final-classes=*)    arguments+=("--final-classes=$(absolute "${argument#*=}")") ;;
        --executable-path=*)  arguments+=("--executable-path=$(absolute "${argument#*=}")") ;;
        --c-path=*)           arguments+=("--c-path=$(absolute "${argument#*=}")") ;;
        -*=/*)                arguments+=("${argument%%=*}=$(native "${argument#*=}")") ;;
        -*)                   arguments+=("$argument") ;;
        *)                    arguments+=("$(absolute "$argument")") ;;
    esac
done

exec "$binary" "${arguments[@]}"
