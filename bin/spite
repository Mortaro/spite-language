#!/bin/bash
# Runs the Spite compiler, rebuilding it first if the sources moved on.
#   spite thing                  compile and run the program in the folder thing/
#   spite thing --mode=c         print the C instead
here="$(cd "$(dirname "$0")/.." && pwd)"
seed="$here/bootstrap/seed/spite_compiler.c"
binary="$here/.spite-cache/spite.exe"   # not in bin/, or it would shadow this launcher on PATH

find_c_compiler() {
    for candidate in cc clang gcc; do
        command -v "$candidate" >/dev/null 2>&1 && { echo "$candidate"; return; }
    done
    for found in "/c/Program Files/Microsoft Visual Studio/"*/*/VC/Tools/Llvm/x64/bin/clang.exe \
                 "/c/Program Files (x86)/Microsoft Visual Studio/"*/*/VC/Tools/Llvm/x64/bin/clang.exe; do
        [ -x "$found" ] && { echo "$found"; return; }
    done
}

compiler="${SPITE_CC:-$(find_c_compiler)}"
if [ -z "$compiler" ]; then
    echo "spite: no C compiler found. Set SPITE_CC, or install cc, clang or gcc." >&2
    exit 1
fi

# The compiler shells out to CC as one string, so a path with spaces needs its short form.
case "$compiler" in
    *\ *) export CC="$(cygpath -d "$compiler" 2>/dev/null || echo "$compiler") -Wno-deprecated-declarations" ;;
    *)    export CC="$compiler" ;;
esac

if [ ! -x "$binary" ] || [ "$seed" -nt "$binary" ]; then
    echo "spite: building the compiler" >&2
    mkdir -p "$here/.spite-cache"
    "$compiler" -O2 -Wno-parentheses-equality -Wno-deprecated-declarations "$seed" -o "$binary" || exit 1
fi

# `spite format [--check] <file-or-folder>` formats every .spite file it finds; --check rewrites nothing, lists
# every file that would change, and fails if there is one.
if [ "$1" == "format" ]; then
    shift
    mode=format
    if [ "$1" == "--check" ]; then mode=check_format; shift; fi
    target="${1:-.}"
    case "$target" in /* | [A-Za-z]:*) ;; *) target="$(pwd)/$target" ;; esac
    status=0
    while IFS= read -r file; do
        (cd "$here" && "$binary" "$file" --mode=$mode) || status=1
    done < <(if [ -d "$target" ]; then find "$target" -name "*.spite" -not -path "*/.spite-cache/*"; else echo "$target"; fi)
    exit $status
fi

# `spite connect <port> [--command="..."]` talks to a program running with --repl_port; nothing in it is a path.
if [ "$1" == "connect" ]; then
    exec "$binary" "$@"
fi

# `spite thing` is the common case; anything starting with - is passed through.
# The compiler reads runtime/*.h relative to its working directory, so it runs from the
# repository root and every file argument is made absolute first.
# A flag that names a path where output goes needs the same treatment, since the working
# directory it was written against is the caller's, not the repository's.
absolute() {
    case "$1" in
        /* | [A-Za-z]:*) echo "$1" ;;
        *)               echo "$(pwd)/$1" ;;
    esac
}
arguments=()
passing=false
for argument in "$@"; do
    if $passing; then arguments+=("$argument"); continue; fi
    case "$argument" in
        --)                 passing=true; arguments+=("--") ;;
        --final_classes=* ) arguments+=("--final_classes=$(absolute "${argument#*=}")") ;;
        --output=*)         arguments+=("--output=$(absolute "${argument#*=}")") ;;
        -*)                 arguments+=("$argument") ;;
        /*)                 arguments+=("$argument") ;;
        [A-Za-z]:*)         arguments+=("$(cygpath -u "$argument" 2>/dev/null || echo "$argument")") ;;
        *)                  arguments+=("$(pwd)/$argument") ;;
    esac
done
case " ${arguments[*]} " in *" --mode="*) ;; *) arguments=("--mode=run" "${arguments[@]}") ;; esac

cd "$here" || exit 1
exec "$binary" "${arguments[@]}"
