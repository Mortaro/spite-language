generic $system_type

enum Phase {
    'update'
}

var system = $system_type()
var found = Items<Integer>()
var console = Console()

func run(entity_count: Integer) {
    run_phases_each(entity_count)
}

func run_phase_each(phase: Symbol<$system_type.phase_each>, entity_count: Integer) {
    var entity = 0
    while entity < entity_count {
        found.clear()
        find_arguments(entity)
        system.phase_each(made_arguments(found))
        var first = made_position(found)
        console.print(first.left)
        system.phase_each(streamed_rows(found))
        entity = entity + 1
    }
}

func find_argument(argument: Symbol<$system_type.phase_each>, entity: Integer) {
    var column = Column<argument.class>()
    var dense = column.dense_index(entity)
    found.append(dense)
}

func made_argument(argument: Symbol<$system_type.phase_each>, rows: Items<Integer>): argument.class {
    return Column<argument.class>().values[rows[argument.index]]
}

func streamed_row(argument: Symbol<$system_type.phase_each>, rows: Items<Integer>): argument.class {
    return Column<argument.class>().values[rows[argument.index]]
}
