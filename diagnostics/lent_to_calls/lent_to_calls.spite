var console = Console()
var mice = Vector<Mouse>()
var input = Input()

func LentToCalls() {
    var made = Mouse()
    mice.append(made)
    crash mice[0]
    var mouse = mice[0]
    input.keep(mouse)
    input.list(mouse)
    input.hand_back(mouse)
    input.capture(mouse)
    console.print(mouse.left)
    grown()
}

func grown() {
    crash mice[0]
    var mouse = mice[0]
    input.grow(mouse)
    input.grow(mice[0])
}
