var console = Console()

func CallerTemplates() {
    var names = ["Ada", "Grace"]
    var greetings = names.map_say_hello()
    var people = List<Person>()
    people.each_is_adult()
    names.each_wave()
    names.each_greet_twice()
    names.each_count_to()
    var numbers = [1, 2]
    numbers.each_say_hello()
    var index = 0
    while index < names.count() {
        say_hello(names[index])
        index = index + 1
    }
    index = 0
    while index < people.count() {
        var person = people[index]
        index = index + 1
        greet(person)
    }
    console.print(greetings)
}

func say_hello(name: String) {
    console.print("hello, {name}")
}

func greet(person: Person) {
    console.print(person.age)
}

func is_adult(person: Person): Bool {
    return person.age > 17
}

func greet_twice(name: String, times: Int) {
    console.print(name, times)
}

func count_to(value: Int) {
    console.print(value)
}
