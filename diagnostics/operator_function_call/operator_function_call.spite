var console = Console()

func OperatorFunctionCall() {
    var point = Point()
    point.set_height(4)
    var height = point.get_height()
    var other = Point()
    var same = point.equals(other)
    var flipped = point.negate()
    var shelf = [1, 2]
    shelf.set_at(0, 3)
    var first = shelf.get_at(0)
    var ages = Dictionary<Integer>()
    var found = ages.get_at("ann")
    ages.set_at("bea", 7)
    var kind = point.get_type()
    var reader = point.get_height
    var read = reader.call_function()
    crash first
    crash found
    console.print(height, same, flipped.height, first, found, read, kind)
}
