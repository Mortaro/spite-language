union Pet {
    Cat
    Dog
}

var console = Console()

func JsonUnwritable() {
    var owner = Owner()
    var owner_json = JsonWriter<Owner>()
    var owner_text = owner_json.write(owner)
    var widget = Widget()
    var widget_json = JsonWriter<Widget>()
    var widget_text = widget_json.write(widget)
    var button_reader = JsonReader<Button>()
    var button = button_reader.read("\{}")
    crash button
    var owner_bytes = BinaryReader<Owner>(null)
    var read_owner = owner_bytes.read()
    crash read_owner
    var button_writer = BinaryWriter(button)
    var button_bytes = button_writer.write()
    var byte_count = button_bytes.count()
    console.print(owner_text, widget_text, button.label, read_owner.name, byte_count)
}
