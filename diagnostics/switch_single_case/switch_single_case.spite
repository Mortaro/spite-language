union Creature {
    Cat
    Dog
    Fish
}

var console = Console()

func SwitchSingleCase() {
    console.print(is_fish(Cat()))
    console.print(fins_of(Cat()))
    console.print(allowed(Cat()))
}

func is_fish(creature: Creature): Bool {
    switch creature {
        Fish: return true
        _: return false
    }
}

func fins_of(creature: Creature): Int {
    switch creature {
        Fish: return creature.fins
        _: return 0
    }
}

func allowed(creature: Creature): Int {
    switch creature {
        Fish: console.print("a fish")
        _: console.print("not a fish")
    }
    return 1
}
