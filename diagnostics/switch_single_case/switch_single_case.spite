union Creature {
    Cat
    Dog
    Fish
}

var console = Console()

func SwitchSingleCase() {
    var cat_is_fish = is_fish(Cat())
    var cat_fins = fins_of(Cat())
    var cat_allowed = allowed(Cat())
    console.print(cat_is_fish, cat_fins, cat_allowed)
}

func is_fish(creature: Creature): Bool {
    switch creature {
        Fish: return true
        _: return false
    }
}

func fins_of(creature: Creature): Int {
    switch creature {
        Fish: return creature.fins
        _: return 0
    }
}

func allowed(creature: Creature): Int {
    switch creature {
        Fish: console.print("a fish")
        _: console.print("not a fish")
    }
    return 1
}
