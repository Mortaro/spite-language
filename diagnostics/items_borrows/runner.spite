generic $row_type

var found = Items<Integer>()
var keeper = Keeper()

func run() {
    var row: $row_type = null
    fill_attributes(row, found)
    keeper.remove_while_moving(row)
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, rows: Items<Integer>) {
    row.attributes[attribute] = Column<attribute.class>().values[rows[attribute.index]]
}
