var console = Console()

func DebugInstances() {
    var instances = Person.instances
    var index = 0
    while index < instances.count() {
        var instance = instances[index]
        var attributes = instance.attributes
        var attribute_index = 0
        while attribute_index < attributes.count() {
            var attribute = attributes[attribute_index]
            console.print(attribute.name, attribute.class)
            attribute_index = attribute_index + 1
        }
        index = index + 1
    }
}
