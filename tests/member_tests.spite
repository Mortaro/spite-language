var creatures = List<Creature>()

func MemberTests() {
    var rat = Creature("rat", 3, true)
    creatures.append(rat)
    var dragon = Creature("dragon", 90, false)
    creatures.append(dragon)
    var bat = Creature("bat", 1, true)
    creatures.append(bat)
}

func test_filter_keeps_the_true_ones() {
    crash creatures.filter_small().count() == 2
}

func test_sum_adds_a_member() {
    crash creatures.sum_strength() == 94
}

func test_sort_by_orders_by_a_member() {
    crash creatures.sort_by_strength().first().name == "bat"
    crash creatures.sort_by_name().last().name == "rat"
}

func test_find_by_returns_the_first_match() {
    var found = creatures.find_by_name("dragon")
    crash found
    crash found.strength == 90
}

func test_a_chain_gives_what_its_steps_give() {
    var small = creatures.filter_small()
    crash creatures.filter_small().sum_strength() == small.sum_strength()
    crash creatures.filter_small().count_small() == 2
    crash creatures.filter_small().map_label().join(" ") == "rat:3 bat:1"
    var found = creatures.filter_small().find_by_name("bat")
    crash found
    crash found.strength == 1
}

func test_map_collects_a_function_result() {
    crash creatures.map_label().join(" ") == "rat:3 dragon:90 bat:1"
}
