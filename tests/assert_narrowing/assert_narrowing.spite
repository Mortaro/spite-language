# manual.md section 5, "assert narrowing": after `assert value` on a
# Nullable<T> local/parameter/field, the name is a T for the rest of that
# block and nested blocks -- reads/writes/method calls go to the value held
# inside the Nullable in place, so mutating it through the narrowed name is
# visible to anyone else who reads the same storage afterward.
var console = Console()
var stored: Nullable<Monster> = null

func find_monster(missing: Bool): Nullable<Monster> {
    if missing {
        return null
    }
    return Monster(42)
}

func set_stored(new_monster: Monster) {
    stored = new_monster
}

func bump_stored() {
    assert stored
    stored.hurt(5)
}

func read_stored_health(): Int {
    assert stored
    return stored.health
}

func AssertNarrowing() {
    var maybe_monster = find_monster(false)
    assert maybe_monster
    maybe_monster.hurt(10)
    console.print("health", maybe_monster.health)

    var another = find_monster(false)
    assert another and another.health > 0
    console.print("another health", another.health)

    set_stored(Monster(50))
    bump_stored()
    console.print("stored health", read_stored_health())

    console.print("done")
}
