var json = Json<Ship>()

func test_writes_every_kind_of_attribute() {
    var ship = full_ship()
    var text = json.write(ship)
    crash text == "\{\"name\":\"Wren\",\"length\":12,\"speed\":7.5,\"rig\":\"schooner\",\"afloat\":true,\"crew\":[\{\"name\":\"Ada\",\"knots\":[\"bowline\",\"hitch\"]},\{\"name\":\"Bo\",\"knots\":[]}],\"cargo\":\{\"rope\":3,\"tea\":40},\"captain\":\{\"name\":\"Cy\",\"knots\":[]},\"launched\":1902,\"logbook\":[[\"calm\"],[]]}"
}

func test_writes_null_for_an_empty_nullable() {
    var ship = Ship()
    var text = json.write(ship)
    crash text == "\{\"name\":\"\",\"length\":0,\"speed\":0,\"rig\":\"sloop\",\"afloat\":false,\"crew\":[],\"cargo\":\{},\"captain\":null,\"launched\":null,\"logbook\":[]}"
}

func test_reads_back_what_it_wrote() {
    var ship = full_ship()
    var text = json.write(ship)
    var read = json.read(text)
    crash read
    crash read.name == "Wren"
    crash read.length == 12
    crash read.speed == 7.5
    crash read.rig == 'schooner'
    crash read.afloat
    crash read.crew.count() == 2
    crash read.crew[0].knots.count() == 2
    crash read.cargo["tea"] == 40
    crash read.captain
    crash read.captain.name == "Cy"
    crash read.launched == 1902
    var again = json.write(read)
    crash again == text
}

func test_space_between_tokens_is_ignored() {
    var read = json.read(" \{ \"name\" : \"Wren\" ,\n\t\"crew\" : [ \{ \"name\" : \"Ada\" } ] } ")
    crash read
    crash read.name == "Wren"
    crash read.crew.count() == 1
}

func test_a_missing_attribute_keeps_its_default() {
    var read = json.read("\{\"name\":\"Wren\"}")
    crash read
    crash read.name == "Wren"
    crash read.length == 0
    crash read.rig == 'sloop'
    crash not read.captain
}

func test_an_unknown_key_is_skipped() {
    var read = json.read("\{\"flag\":\{\"colors\":[\"red\",1,true,null]},\"name\":\"Wren\",\"port\":-2.5e3}")
    crash read
    crash read.name == "Wren"
}

func test_a_mistyped_attribute_reads_nothing() {
    var wrong_number = json.read("\{\"length\":\"long\"}")
    crash not wrong_number
    var wrong_text = json.read("\{\"name\":null}")
    crash not wrong_text
    var wrong_list = json.read("\{\"crew\":\{}}")
    crash not wrong_list
    var wrong_enum = json.read("\{\"rig\":\"raft\"}")
    crash not wrong_enum
}

func test_malformed_text_reads_nothing() {
    var unclosed = json.read("\{\"name\":\"Wren\"")
    crash not unclosed
    var trailing = json.read("\{} \{}")
    crash not trailing
    var empty = json.read("")
    crash not empty
    var bare = json.read("\{name:\"Wren\"}")
    crash not bare
}

func test_text_escapes_round_trip() {
    var ship = Ship()
    ship.name = "quote \" slash \\ line\nend\ttab"
    var text = json.write(ship)
    crash text.starts_with("\{\"name\":\"quote \\\" slash \\\\ line\\nend\\ttab\",")
    var read = json.read(text)
    crash read
    crash read.name == ship.name
}

func test_unicode_escapes_become_utf8() {
    var read = json.read("\{\"name\":\"caf\\u00e9 \\ud83d\\ude00 \\/\"}")
    crash read
    crash read.name == "café 😀 /"
}

func test_values_that_are_not_classes() {
    var numbers = Json<List<Int>>()
    var list_text = numbers.write([1, -2, 3])
    crash list_text == "[1,-2,3]"
    var list_read = numbers.read(" [4, 5] ")
    crash list_read
    crash list_read.count() == 2
    var sailors = Json<Dictionary<Sailor>>()
    var roster = Dictionary<Sailor>()
    roster.set("first", Sailor("Ada"))
    var roster_text = sailors.write(roster)
    crash roster_text == "\{\"first\":\{\"name\":\"Ada\",\"knots\":[]}}"
    var roster_read = sailors.read(roster_text)
    crash roster_read
    crash roster_read["first"]
    crash roster_read["first"].name == "Ada"
    var text = Json<String>()
    var quoted = text.write("hi")
    crash quoted == "\"hi\""
}

func full_ship(): Ship {
    var ship = Ship()
    ship.name = "Wren"
    ship.length = 12
    ship.speed = 7.5
    ship.rig = 'schooner'
    ship.afloat = true
    var ada = Sailor("Ada")
    ada.knots.append("bowline")
    ada.knots.append("hitch")
    ship.crew.append(ada)
    ship.crew.append(Sailor("Bo"))
    ship.cargo.set("rope", 3)
    ship.cargo.set("tea", 40)
    ship.captain = Sailor("Cy")
    ship.launched = 1902
    ship.logbook.append(["calm"])
    ship.logbook.append(List<String>())
    return ship
}
