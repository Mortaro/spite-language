var stored: Creature? = null

func maybe_creature(present: Bool): Creature? {
    if present {
        return Creature("rat", 3, true)
    }
    return null
}

func test_if_narrows_for_the_whole_block() {
    var found = maybe_creature(true)
    if found {
        crash found.name == "rat"
    } else {
        crash
    }
}

func test_else_runs_when_there_is_nothing() {
    var missing = maybe_creature(false)
    if missing {
        crash
    } else {
        crash true
    }
}

func test_crash_narrows_for_the_rest_of_the_function() {
    var found = maybe_creature(true)
    crash found
    crash found.strength == 3
}

func test_switch_covers_both_sides() {
    var missing = maybe_creature(false)
    switch missing {
        Creature: crash
        Null: crash true
    }
}

func test_an_attribute_narrows_the_same_way() {
    stored = maybe_creature(true)
    crash stored
    crash stored.name == "rat"
    stored = null
}

func test_a_value_that_may_be_null_compares_without_narrowing() {
    var named: String? = "rat"
    var counted: Int? = 3
    crash named == "rat"
    crash counted == 3
    crash counted != 4
}

func test_null_is_not_equal_to_anything() {
    var named: String? = null
    var counted: Int? = null
    crash named != "rat"
    crash not (counted == 0)
}

func test_a_namespace_compares_with_its_name() {
    crash Spite.Class.namespace == "Spite"
    crash OptionalTests.namespace != "Spite"
}
