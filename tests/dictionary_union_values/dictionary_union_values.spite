# Regression test for a codegen bug: `Dictionary<T>_get` where `T` is a
# union handed back the dictionary's own stored copy of the active member
# `_get` branch for a value-embedded element -- a union is `isReference() ==
# false` but `needsDrop() == true`, since its active member is always a
# class reference). The dictionary's slot and the caller's `Nullable<T>`
# ended up sharing one reference count between two independent owners: the
# first side to drop its copy freed the underlying object while the other
# still pointed at it, a use-after-free/double-free that shows up as
# STATUS_HEAP_CORRUPTION in a release build. This exercises enough `.set()`
# calls to also cross the dictionary's initial capacity (growing/rehashing
# the backing arrays), plus `.get()` reads of the union values back out, so
# both the growth arithmetic and the retain-on-read fix are covered.
union Gear = {
    Sword
    Shield
}

var console = Console()

func DictionaryUnionValues() {
    var inventory = Dictionary<Gear>()
    inventory.set("a", Sword("Excalibur", 10))
    inventory.set("b", Shield("Aegis", 5))
    inventory.set("c", Sword("Rusty", 1))
    inventory.set("d", Shield("Tower", 7))
    inventory.set("e", Sword("Great", 9))
    console.print("count", inventory.count())
    var first_item = inventory.get("a")
    if first_item {
        console.print("a", first_item.name, first_item.power)
    }
    var fourth_item = inventory.get("d")
    if fourth_item {
        console.print("d", fourth_item.name, fourth_item.power)
    }
    console.print("done")
}
