# Regression test for a codegen bug: `not` (and a bare, non-`if`-narrowed
# boolean use) of a `Nullable<T>` where `T` is a union produces invalid C.
# `Nullable<T>` collapses to a bare pointer when `T` is a reference (a class,
# manual.md section 10), but is a `{ has_value; value; }` value struct when
# `T` is value-embedded (a scalar, or a union -- unions are never
# heap-allocated, see `types.Type.isReference`). The `not` operator's codegen
# used to always emit plain C `!(operand)`, which happens to still be valid
# (if backwards) for the pointer-shaped case, but is a C compile error
# ("invalid argument type ... to unary expression") for the struct-shaped
# case. This exercises all three shapes -- union, scalar, and a plain class
# reference -- so the union case is covered without losing non-regression
# coverage for the other two.
union Shape = {
    ShapeA
    ShapeB
}

var console = Console()

func try_get_shape(missing: Bool): Nullable<Shape> {
    if missing {
        return null
    }
    var shape: Shape = ShapeA(3)
    return shape
}

func try_get_number(missing: Bool): Nullable<Int> {
    if missing {
        return null
    }
    return 7
}

func try_get_instance(missing: Bool): Nullable<ShapeA> {
    if missing {
        return null
    }
    return ShapeA(9)
}

func NullableUnionNot() {
    var missing_shape = try_get_shape(true)
    if not missing_shape {
        console.print("union missing")
    }
    var present_shape = try_get_shape(false)
    if not present_shape {
        console.print("union present - wrong")
    } else {
        console.print("union present")
    }

    var missing_number = try_get_number(true)
    if not missing_number {
        console.print("scalar missing")
    }
    var present_number = try_get_number(false)
    if not present_number {
        console.print("scalar present - wrong")
    } else {
        console.print("scalar present")
    }

    var missing_instance = try_get_instance(true)
    if not missing_instance {
        console.print("reference missing")
    }
    var present_instance = try_get_instance(false)
    if not present_instance {
        console.print("reference present - wrong")
    } else {
        console.print("reference present")
    }

    console.print("done")
}
