union Holding {
    Creature
    Money
}

func held(creature: Boolean): Holding {
    if creature {
        return Creature("rat", 3, true)
    }
    return Money(25)
}

func test_switch_narrows_each_case() {
    var thing = held(true)
    switch thing {
        Creature: crash thing.name == "rat"
        Money: crash
    }
}

func test_a_union_keeps_the_class_it_holds() {
    crash held(false).class.name == "Money"
    crash held(true).class.name == "Creature"
}
