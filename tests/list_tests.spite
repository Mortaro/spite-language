func test_append_and_prepend_keep_order() {
    var numbers = [2, 3]
    numbers.append(4)
    numbers.prepend(1)
    crash numbers.count() == 4
    crash numbers[0] == 1
    crash numbers.last() == 4
}

func test_reading_out_of_range_gives_nothing() {
    var numbers = [7]
    crash numbers[5] != 0
    crash numbers[0] == 7
    var names = ["ada"]
    crash names[5] != ""
}

func test_a_proven_count_proves_the_indices_below_it() {
    var names = ["ada", "grace", "alan"]
    crash names.count() == 3
    crash names[2].length() == 4
}

func test_a_loop_over_the_count_proves_each_element() {
    var names = ["ada", "grace"]
    var letters = 0
    var index = 0
    while index < names.count() {
        letters = letters + names[index].length()
        index = index + 1
    }
    crash letters == 8
}

func test_an_element_can_be_narrowed_like_a_path() {
    var names = ["ada"]
    var position = 0
    crash names[position]
    crash names[position].upper_case() == "ADA"
}

func test_remove_last_returns_what_it_removed() {
    var names = ["ada", "grace"]
    crash names.remove_last() == "grace"
    crash names.count() == 1
}

func test_contains_finds_a_value() {
    var names = ["ada", "grace"]
    crash names.contains("ada")
    crash not names.contains("alan")
}

func test_reverse_turns_the_list_around() {
    var numbers = [1, 2, 3]
    numbers.reverse()
    crash numbers.first() == 3
    crash numbers.last() == 1
}

func test_a_list_is_shared_not_copied() {
    var original = [1]
    var same = original
    same.append(2)
    crash original.count() == 2
}

func test_a_list_can_hold_nothing() {
    var values = List<Int?>()
    values.append(3)
    values.append(null)
    crash values.count() == 2
    crash values[0] == 3
    crash not values[1]
}
