var program = Program()

func Tests() {
    var classes = Spite.Class.instances
    var index = 0
    while index < classes.count() {
        if classes[index].name.ends_with("Tests") {
            run(classes[index].functions)
        }
        index = index + 1
    }
}

func run(functions: List<Spite.Function>) {
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if function.name.starts_with("test_") {
            prove(function)
        }
        index = index + 1
    }
}

func prove(function: Spite.Function) {
    function.call_function()
    var before = program.live_allocations()
    function.call_function()
    var leaked = program.live_allocations() - before
    var balance = "{function.name} left {leaked} allocations behind"
    crash balance == "{function.name} left 0 allocations behind"
}
