func Tests() {
    var strings = StringTests()
    strings.test_length_counts_characters()
    strings.test_slice_takes_a_range()
    strings.test_split_and_join_round_trip()
    strings.test_a_number_joins_a_string()
    strings.test_comparison_is_by_content()
    strings.test_parsing_a_number_that_is_not_one_gives_zero()

    var lists = ListTests()
    lists.test_append_and_prepend_keep_order()
    lists.test_reading_out_of_range_gives_the_default()
    lists.test_remove_last_returns_what_it_removed()
    lists.test_contains_finds_a_value()
    lists.test_reverse_turns_the_list_around()
    lists.test_a_list_is_shared_not_copied()

    var dictionaries = DictionaryTests()
    dictionaries.test_a_missing_key_is_null()
    dictionaries.test_set_replaces_a_value()
    dictionaries.test_keys_keep_insertion_order()
    dictionaries.test_remove_forgets_the_key()

    var members = MemberTests()
    members.test_filter_keeps_the_true_ones()
    members.test_sum_adds_a_member()
    members.test_sort_by_orders_by_a_member()
    members.test_find_by_returns_the_first_match()
    members.test_map_collects_a_function_result()
}
