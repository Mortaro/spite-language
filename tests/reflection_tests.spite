func test_a_value_knows_its_class() {
    var creature = Creature("rat", 3, true)
    if creature.class.namespace {
        crash
    }
    crash creature.class.name == "Creature"
}

func test_a_class_object_is_the_same_object_everywhere() {
    var first = Creature("rat", 3, true)
    var second = Creature("bat", 1, true)
    crash first.class == second.class
}

func test_attributes_report_name_class_and_value() {
    var creature = Creature("rat", 3, true)
    var attributes = creature.attributes
    crash attributes.count() == 3
    crash attributes[0].name == "name"
    crash attributes[0].class.name == "String"
    crash attributes[0].value
    crash attributes[1].value
    crash attributes[0].value.to_string() == "rat"
    crash attributes[1].value.to_string() == "3"
}

func test_functions_report_their_names() {
    var creature = Creature("rat", 3, true)
    var names = creature.functions.map_names()
    crash names.contains('label')
}

func test_every_class_of_the_program_is_listed() {
    var classes = Spite.Class.instances
    crash classes.find_by_name('Creature')
}

func test_a_bare_class_identifier_is_the_class_of_self() {
    crash class.name == "ReflectionTests"
    var mine = class
    crash mine.name == "ReflectionTests"
}

func test_an_instance_method_can_ask_for_its_own_class() {
    var creature = Creature("rat", 3, true)
    crash creature.class_name() == "Creature"
}

func test_a_class_name_reads_its_own_name() {
    crash Creature.name == "Creature"
    crash ReflectionTests.name == "ReflectionTests"
}

func test_a_namespace_compares_with_its_name() {
    crash Spite.Class.namespace == "Spite"
}

func test_an_asserted_path_narrows_every_link_of_it() {
    assert Spite.Attribute.class.namespace
    crash Spite.Attribute.class.namespace.name == "Spite"
}

func test_a_path_can_be_narrowed_with_crash() {
    crash Spite.Class.namespace
    crash Spite.Class.namespace.name_with_namespaces == "Spite"
}

func test_a_null_link_fails_the_if_without_dereferencing_it() {
    var creature = Creature("rat", 3, true)
    if creature.class.namespace.parent {
        crash
    }
    crash creature.class.name == "Creature"
}
