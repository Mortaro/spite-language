func test_length_counts_characters() {
    crash "spite".length() == 5
    crash "".length() == 0
}

func test_slice_takes_a_range() {
    crash "language".slice(0, 4) == "lang"
    crash "language".slice(4, 99) == "uage"
}

func test_split_and_join_round_trip() {
    var parts = "a,b,c".split(",")
    crash parts.count() == 3
    crash parts.join(",") == "a,b,c"
}

func test_a_number_joins_a_string() {
    crash "age {3}" == "age 3"
    crash "ratio {2.5}" == "ratio 2.5"
}

func test_comparison_is_by_content() {
    var built = "abc"
    crash built == "abc"
    crash built != "abd"
    crash "abc" < "abd"
}

func test_parsing_text_that_is_not_a_number_answers_null() {
    crash "42".to_integer() == 42
    crash not "forty two".to_integer() and not "+7 days".to_integer() and not "".to_long() and not "-".to_long()
    crash not "9000000000".to_integer() and not "9223372036854775808".to_long()
    crash not "nothing".to_double() and not "1e".to_double() and not ".".to_double() and not "1.5x".to_float()
    crash not "256".to_byte() and not "-1".to_unsigned_integer() and not "128".to_tiny()
    crash not "18446744073709551616".to_unsigned_long() and not "-1".to_unsigned_long()
}

func test_searching_finds_the_first_place() {
    crash "banana".index_of("an") == 1
    crash "banana".index_of("") == 0
    crash "an".index_of("banana") == -1
    crash "banana".contains("nan")
    crash not "banana".contains("x")
    crash "banana".starts_with("ban")
    crash "banana".ends_with("ana")
    crash not "na".ends_with("banana")
}

func test_replace_changes_every_occurrence() {
    crash "a-b-c".replace("-", "+") == "a+b+c"
    crash "a-b-".replace("-", "") == "ab"
    crash "abc".replace("", "x") == "abc"
}

func test_trim_and_case() {
    crash "  spite \t\n".trim() == "spite"
    crash "   ".trim() == ""
    crash "Spite 1!".upper_case() == "SPITE 1!"
    crash "Spite 1!".lower_case() == "spite 1!"
    crash "spite".character_at(1) == "p"
    crash "spite".character_at(9) == ""
    crash "".is_empty()
}

func test_parsing_reads_a_sign_and_spaces_around_the_number() {
    crash " -12 ".to_integer() == -12 and "+7".to_integer() == 7
    crash "9000000000".to_long() == 9000000000 and "-9223372036854775808".to_long() == Long.smallest
    crash "2.5".to_double() == 2.5 and "-1.5e2".to_double() == -150.0 and ".5".to_float() == 0.5
    crash "255".to_byte() == 255 and "-128".to_tiny() == -128
    crash "18446744073709551615".to_unsigned_long() == UnsignedLong.largest
}

func test_pluralize_follows_english_rules() {
    crash "quest".pluralize() == "quests"
    crash "box".pluralize() == "boxes" and "match".pluralize() == "matches" and "class".pluralize() == "classes"
    crash "enemy".pluralize() == "enemies" and "day".pluralize() == "days"
    crash "wolf".pluralize() == "wolves" and "knife".pluralize() == "knives"
    crash "analysis".pluralize() == "analyses" and "medium".pluralize() == "media" and "tomato".pluralize() == "tomatoes"
    crash "quiz".pluralize() == "quizzes" and "bus".pluralize() == "buses" and "status".pluralize() == "statuses"
    crash "quests".pluralize() == "quests" and "".pluralize() == ""
}

func test_pluralize_knows_irregulars_and_uncountables() {
    crash "person".pluralize() == "people" and "child".pluralize() == "children" and "man".pluralize() == "men"
    crash "index".pluralize() == "indices" and "matrix".pluralize() == "matrices" and "vertex".pluralize() == "vertices"
    crash "mouse".pluralize() == "mice" and "ox".pluralize() == "oxen" and "octopus".pluralize() == "octopi"
    crash "data".pluralize() == "data" and "equipment".pluralize() == "equipment" and "sheep".pluralize() == "sheep"
    crash "people".pluralize() == "people"
}

func test_singularize_undoes_pluralize() {
    crash "quests".singularize() == "quest" and "boxes".singularize() == "box" and "enemies".singularize() == "enemy"
    crash "wolves".singularize() == "wolf" and "knives".singularize() == "knife" and "objectives".singularize() == "objective"
    crash "analyses".singularize() == "analysis" and "media".singularize() == "medium" and "statuses".singularize() == "status"
    crash "people".singularize() == "person" and "children".singularize() == "child" and "indices".singularize() == "index"
    crash "matrices".singularize() == "matrix" and "mice".singularize() == "mouse" and "oxen".singularize() == "ox"
    crash "data".singularize() == "data" and "information".singularize() == "information" and "news".singularize() == "news"
    crash "quest".singularize() == "quest" and "class".singularize() == "class" and "".singularize() == ""
}

func test_compound_names_inflect_their_last_word() {
    crash "active_quest".pluralize() == "active_quests" and "map_names".singularize() == "map_name"
    crash "party_person".pluralize() == "party_people" and "loot_data".pluralize() == "loot_data"
    crash "ActiveQuest".pluralize() == "ActiveQuests" and "Person".pluralize() == "People"
    crash "ACTIVE_QUEST".pluralize() == "ACTIVE_QUESTS" and "Enemies".singularize() == "Enemy"
}
