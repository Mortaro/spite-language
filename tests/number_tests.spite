func test_an_integer_divides_toward_zero() {
    crash 7 / 2 == 3
    crash -7 / 2 == -3
    crash 7 % 2 == 1
}

func test_a_narrow_type_keeps_a_value_that_fits() {
    var wide = 127
    var small: Tiny = wide
    crash small == 127
    var never_negative: Byte = 255
    never_negative = never_negative.wrapping_sum(1)
    crash never_negative == 0
}

func test_the_right_side_casts_toward_the_left() {
    var whole: Integer = 0
    crash -0.5 < whole
    var fraction: Float = 3.0
    crash fraction * 2 == 6.0
}

func test_a_number_becomes_text_and_back() {
    crash 7.to_string() == "7"
    crash true.to_string() == "true"
    crash "7".to_integer() == 7
    crash "7.5".to_float() == 7.5
}

func test_a_long_holds_what_an_integer_cannot() {
    var big: Long = 3000000000
    crash big > 2147483647
}

func test_a_whole_number_reads_as_its_digits() {
    var smallest: Long = -9223372036854775807 - 1
    crash 0.to_string() == "0"
    crash (-305).to_string() == "-305"
    crash smallest.to_string() == "-9223372036854775808"
}

func test_a_fraction_reads_as_its_shortest_digits() {
    var tenth: Float = 0.1
    var wide_tenth: Double = 0.1
    var wide_fifth: Double = 0.2
    var third: Double = wide_tenth * 10.0 / 3.0
    var tie: Double = 1125899906842624.25
    crash tenth.to_string() == "0.1"
    crash wide_tenth.to_string() == "0.1"
    crash (wide_tenth + wide_fifth).to_string() == "0.30000000000000004"
    crash third.to_string() == "0.3333333333333333"
    crash (-2.5).to_string() == "-2.5"
    crash 0.0001.to_string() == "0.0001"
    crash tie.to_string() == "1125899906842624.2"
}

func test_a_whole_float_reads_without_a_point() {
    var zero: Double = 0.0
    var sixteen_digits: Double = 10000000000000000.0
    var float_limit: Float = 16777216.0
    crash zero.to_string() == "0"
    crash (-zero).to_string() == "-0"
    crash 100.0.to_string() == "100"
    crash sixteen_digits.to_string() == "10000000000000000"
    crash float_limit.to_string() == "16777216"
}

func test_a_float_too_large_or_small_for_fixed_digits_reads_in_scientific_notation() {
    var large: Double = 1000000000000000000000.0
    var small: Double = 0.00001
    var small_float: Float = 0.00001
    var smallest: Double = 1.0
    while smallest / 2.0 > 0.0 {
        smallest = smallest / 2.0
    }
    crash large.to_string() == "1e+21"
    crash small.to_string() == "1.0000000000000001e-05"
    crash small_float.to_string() == "9.99999975e-06"
    crash smallest.to_string() == "4.9406564584124654e-324"
}

func test_infinity_and_not_a_number_read_as_words() {
    var huge: Double = 1.0
    while huge * 2.0 > huge {
        huge = huge * 2.0
    }
    crash huge.to_string() == "inf"
    crash (-huge).to_string() == "-inf"
    crash (huge - huge).to_string() == "nan"
}

func test_a_large_unsigned_long_reads_as_positive() {
    var largest = UnsignedLong.largest
    crash largest.to_string() == "18446744073709551615"
}
