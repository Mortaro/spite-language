var name = ""
var console = Console()

func Widget(new_name: String) {
    name = new_name
}

# `attribute.class` (manual.md section 15 item 4, moved into section 8) is a
# `Spite.Class`, not a plain String; printing it still prints just the name.
func print_attribute(attribute: Symbol) {
    console.print(attribute.class)
}
