var console = Console()
var heap = Memory.Heap()
var longs = TypedMemory<Long>()

func Naive() {
    var benchmark = Benchmark(all_rounds)
    console.print("total", benchmark.answer)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func all_rounds(): Long {
    return sum_rounds(1000000)
}

func sum_rounds(rounds: Integer): Long {
    var total: Long = 0
    var round = 0
    while round < rounds {
        var squares = sum_of_squares(32, round % 1000)
        total = total + squares
        round = round + 1
    }
    return total
}

func sum_of_squares(count: Integer, offset: Integer): Long {
    var squares = heap.allocate(count * 8)
    var index = 0
    while index < count {
        var value: Long = index + offset
        longs.write_value(squares, index, value * value)
        index = index + 1
    }
    var total: Long = 0
    index = 0
    while index < count {
        total = total + longs.read_value(squares, index)
        index = index + 1
    }
    heap.free(squares)
    return total
}
