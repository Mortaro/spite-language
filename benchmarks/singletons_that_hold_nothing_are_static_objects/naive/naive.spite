var console = Console()

func Naive() {
    var squares = make_squares(1000)
    var names = make_names(100)
    var largest = squares.last()
    crash largest
    var joined = names.join(",")
    var characters = joined.length()
    var count = squares.count()
    console.print("squares", count, "largest", largest, "characters", characters)
}

func make_squares(count: Integer): List<Long> {
    var squares = List<Long>()
    var index = 0
    while index < count {
        var wide: Long = index
        squares.append(wide * index)
        index = index + 1
    }
    return squares
}

func make_names(count: Integer): List<String> {
    var names = List<String>()
    var index = 0
    while index < count {
        names.append("name {index}")
        index = index + 1
    }
    return names
}
