var console = Console()
var clock = Clock()

func OneList() {
    var listed = List<Particle>()
    var packed = Vector<Particle>()
    var start = clock.elapsed_nanoseconds()
    var index = 0
    while index < 200000 {
        var speed: Float = index % 7
        var particle = Particle(speed)
        listed.append(particle)
        index = index + 1
    }
    var filled = clock.elapsed_nanoseconds()
    index = 0
    while index < 200000 {
        var speed: Float = index % 7
        var particle = Particle(speed)
        packed.append(particle)
        index = index + 1
    }
    var packed_filled = clock.elapsed_nanoseconds()
    var list_fill = (filled - start) / 1000
    var vector_fill = (packed_filled - filled) / 1000
    console.print("fill microseconds: List", list_fill, "Vector", vector_fill)
    var round = 0
    while round < 3 {
        time_list(listed)
        time_vector(packed)
        round = round + 1
    }
    var moved = listed.sum_position() + packed.sum_position()
    var energy = listed.sum_energy() + packed.sum_energy()
    console.print("moved", moved, "energy", energy)
}

func time_list(particles: List<Particle>) {
    var start = clock.elapsed_nanoseconds()
    var pass = 0
    while pass < 20 {
        particles.each_step()
        pass = pass + 1
    }
    var light = clock.elapsed_nanoseconds()
    pass = 0
    while pass < 20 {
        particles.parallel_each_step()
        pass = pass + 1
    }
    var light_parallel = clock.elapsed_nanoseconds()
    pass = 0
    while pass < 2 {
        particles.each_simulate()
        pass = pass + 1
    }
    var heavy = clock.elapsed_nanoseconds()
    pass = 0
    while pass < 2 {
        particles.parallel_each_simulate()
        pass = pass + 1
    }
    var heavy_parallel = clock.elapsed_nanoseconds()
    var light_one = (light - start) / 20000
    var light_many = (light_parallel - light) / 20000
    var heavy_one = (heavy - light_parallel) / 2000
    var heavy_many = (heavy_parallel - heavy) / 2000
    console.print(
        "List microseconds per pass: light",
        light_one,
        "parallel",
        light_many,
        "heavy",
        heavy_one,
        "parallel",
        heavy_many,
    )
}

func time_vector(particles: Vector<Particle>) {
    var start = clock.elapsed_nanoseconds()
    var pass = 0
    while pass < 20 {
        particles.each_step()
        pass = pass + 1
    }
    var light = clock.elapsed_nanoseconds()
    pass = 0
    while pass < 20 {
        particles.parallel_each_step()
        pass = pass + 1
    }
    var light_parallel = clock.elapsed_nanoseconds()
    pass = 0
    while pass < 2 {
        particles.each_simulate()
        pass = pass + 1
    }
    var heavy = clock.elapsed_nanoseconds()
    pass = 0
    while pass < 2 {
        particles.parallel_each_simulate()
        pass = pass + 1
    }
    var heavy_parallel = clock.elapsed_nanoseconds()
    var light_one = (light - start) / 20000
    var light_many = (light_parallel - light) / 20000
    var heavy_one = (heavy - light_parallel) / 2000
    var heavy_many = (heavy_parallel - heavy) / 2000
    console.print(
        "Vector microseconds per pass: light",
        light_one,
        "parallel",
        light_many,
        "heavy",
        heavy_one,
        "parallel",
        heavy_many,
    )
}
