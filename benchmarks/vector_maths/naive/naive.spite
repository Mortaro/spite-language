var console = Console()
var checksum: Long = 0
var ended: Long = 0

func Naive() {
    var result = Benchmark(steps)
    console.print("checksum", checksum, "ended at", ended)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func steps() {
    var position = Vector3(0.0, 0.0, 0.0)
    var velocity = Vector3(1.0, 0.5, 0.25)
    var axis = Vector3(0.0, 1.0, 0.0)
    var total = 0.0
    var step = 0
    while step < 5000000 {
        var moved = velocity.scaled(0.001)
        position = position + moved
        var turned = velocity.cross(axis)
        var nudged = velocity + turned.scaled(0.0001)
        velocity = nudged.normalized()
        total = total + position.dot(velocity)
        step = step + 1
    }
    checksum = total
    ended = position.length() * 1000.0
}
