var console = Console()
var seen: Long = 0

func FunctionValues() {
    var numbers = List<Integer>()
    var index = 0
    while index < 100000 {
        numbers.append(index % 1000)
        index = index + 1
    }
    var scorer = Scorer()
    var total: Long = 0
    var round = 0
    while round < 100 {
        numbers.each(remember)
        var scored = numbers.filter(scorer.is_even).sum(scorer.score)
        total = total + scored + numbers.count(is_large)
        round = round + 1
    }
    var applied: Long = 0
    index = 0
    while index < 200000 {
        applied = applied + apply(scorer.score, index % 100)
        index = index + 1
    }
    console.print("total", total, "seen", seen, "applied", applied)
}

func remember(value: Integer) {
    seen = seen + value
}

func is_large(value: Integer): Boolean {
    return value > 900
}

func apply(change: Spite.Function<Integer, Integer>, value: Integer): Integer {
    return change(value)
}
