var console = Console()
var clock = Clock()

func HalfPrecision() {
    var start = clock.elapsed_nanoseconds()
    var total = round_trips()
    var finish = clock.elapsed_nanoseconds()
    var milliseconds = (finish - start) / 1000000
    console.print("round trips milliseconds", milliseconds, "total", total)
}

func round_trips(): Float {
    var total = 0.0
    var index = 0
    while index < 10000000 {
        var value: Float = index
        value = value * 0.0001
        var half = value.to_half_precision()
        var back = half.half_precision_to_float()
        total = total + back
        index = index + 1
    }
    return total
}
