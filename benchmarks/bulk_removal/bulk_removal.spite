var console = Console()
var clock = Clock()
var despawns = Despawns()
var item_total = 200000
var velocities = Items<Velocity>()
var entities = List<Integer>()
var rows = List<Integer>()
var despawned = List<Integer>()

func BulkRemoval() {
    measure(5)
    measure(9)
}

func measure(removed_in_ten: Integer) {
    despawns.mark_every(item_total, removed_in_ten)
    list_despawned()
    var swapped = best_of('swap_remove_each')
    var listed = best_of('swap_remove_listed')
    var removed_where = best_of('remove_where')
    var compacted = best_of('swap_and_truncate')
    var percent = removed_in_ten * 10
    console.print(
        "{percent}% removed of {item_total}, best of 9: swap-remove walking the rows {swapped} us, swap-remove by a despawn list {listed} us, remove_where {removed_where} us, swap and truncate by mask {compacted} us",
    )
    var left = velocities.count() + entities.count()
    console.print("left", left)
}

func list_despawned() {
    despawned.clear()
    var entity = 0
    while entity < item_total {
        if despawns.marked(entity) {
            despawned.append(entity)
        }
        entity = entity + 1
    }
}

func best_of(way: Removal): Long {
    var best: Long = 0
    var attempt = 0
    while attempt < 9 {
        fill()
        var start = clock.elapsed_nanoseconds()
        remove(way)
        var took = (clock.elapsed_nanoseconds() - start) / 1000
        if attempt == 0 or took < best {
            best = took
        }
        attempt = attempt + 1
    }
    return best
}

func remove(way: Removal) {
    if way == 'swap_remove_each' {
        swap_remove_each()
    } else if way == 'swap_remove_listed' {
        swap_remove_listed()
    } else if way == 'remove_where' {
        velocities.remove_where_despawned()
        entities.remove_where(despawns.marked)
    } else {
        compact_by_mask()
    }
}

func fill() {
    velocities.clear()
    entities.clear()
    rows.clear()
    var entity = 0
    while entity < item_total {
        var despawned_now = despawns.marked(entity)
        var velocity = Velocity(entity, 1.0 * entity, despawned_now)
        velocities.append(velocity)
        entities.append(entity)
        rows.append(entity)
        entity = entity + 1
    }
}

func swap_remove_each() {
    var row = 0
    while row < entities.count() {
        var entity = entities[row]
        if despawns.marked(entity) {
            velocities.remove_swapping(row)
            var last = entities.remove_last()
            crash last
            if row < entities.count() {
                entities.set_at(row, last)
            }
        } else {
            row = row + 1
        }
    }
}

func swap_remove_listed() {
    var index = 0
    while index < despawned.count() {
        var entity = despawned[index]
        crash rows[entity]
        var row = rows[entity]
        velocities.remove_swapping(row)
        var last = entities.remove_last()
        crash last
        if row < entities.count() {
            entities.set_at(row, last)
            rows.set_at(last, row)
        }
        index = index + 1
    }
}

func compact_by_mask() {
    var kept = 0
    var row = 0
    while row < entities.count() {
        var entity = entities[row]
        if not despawns.marked(entity) {
            velocities.swap(row, kept)
            entities.swap(row, kept)
            kept = kept + 1
        }
        row = row + 1
    }
    velocities.truncate(kept)
    entities.truncate(kept)
}
