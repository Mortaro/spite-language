var across = 0.0
var down = 0.0
var moving = false
var marks = List<Integer>()

func Trail(new_across: Float, new_down: Float, new_moving: Boolean) {
    across = new_across
    down = new_down
    moving = new_moving
}

func integrate() {
    across = across + down * 0.5
}

func marked(): Integer {
    return marks.count()
}
