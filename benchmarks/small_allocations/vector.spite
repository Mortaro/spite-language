var across = 0.0
var down = 0.0

func Vector(new_across: Float, new_down: Float) {
    across = new_across
    down = new_down
}

func plus(other: Vector): Vector {
    return Vector(across + other.across, down + other.down)
}

func scaled(factor: Float): Vector {
    return Vector(across * factor, down * factor)
}
