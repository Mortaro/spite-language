var console = Console()

func SmallAllocations() {
    var sum = Displacement(0.0, 0.0)
    var kept = List<Displacement>()
    var index = 0
    while index < 3000000 {
        var step = Displacement(1.0, 0.5)
        var scaled_step = step.scaled(0.001)
        var moved = sum.plus(scaled_step)
        sum = moved
        if index % 100 == 0 {
            kept.append(moved)
        }
        if kept.count() == 700 {
            kept.clear()
        }
        index = index + 1
    }
    var copies = 0
    index = 0
    while index < 2000 {
        var copied = kept.copy()
        copies = copies + copied.count()
        index = index + 1
    }
    var across: Integer = sum.across
    console.print("sum", across, "copies", copies)
}
