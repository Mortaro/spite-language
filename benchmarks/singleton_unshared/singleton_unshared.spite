var console = Console()
var clock = Clock()
var tally = Tally()

func SingletonUnshared() {
    var worker = Worker()
    var working = Parallel(worker.run)
    var before: Integer = working
    var best: Long = 0
    var attempt = 0
    while attempt < 5 {
        var start = clock.elapsed_nanoseconds()
        var index = 0
        while index < 10000000 {
            index = tally.add(index)
        }
        var took = clock.elapsed_nanoseconds() - start
        if attempt == 0 or took < best {
            best = took
        }
        attempt = attempt + 1
    }
    var per_call_tenths = best / 1000000
    console.print(
        "10 000 000 calls to a locked singleton on the program's thread, no Parallel running: best",
        per_call_tenths,
        "ns per call",
        before,
    )
}
