var console = Console()
var clock = Clock()

func Naive() {
    var start = clock.elapsed_nanoseconds()
    var total = all_rounds(2000000)
    var microseconds = (clock.elapsed_nanoseconds() - start) / 1000
    console.print("total", total)
    console.error("microseconds {microseconds}")
}

func all_rounds(rounds: Integer): Long {
    var total: Long = 0
    var round = 0
    while round < rounds {
        var biggest = largest(round % 10, round % 7, round % 13, round % 3)
        total = total + biggest
        round = round + 1
    }
    return total
}

func largest(...values: List<Integer>): Integer {
    var biggest = 0
    var index = 0
    while index < values.count() {
        if values[index] > biggest {
            biggest = values[index]
        }
        index = index + 1
    }
    return biggest
}
