var world = World()
var console = Console()
var positions = Column<Component.Position>()
var velocities = Column<Component.Velocity>()
var healths = Column<Component.Health>()
var regenerations = Column<Component.Regeneration>()

func Stress() {
    var index = 0
    while index < 50000 {
        spawn_body(index)
        index = index + 1
    }
    var schedule = Schedule()
    var tick = 0
    while tick < 20 {
        schedule.tick()
        tick = tick + 1
    }
    var last = world.entity_count - 2
    var position = positions.of(last)
    var health = healths.of(last)
    var left: Integer = position.left
    console.print("entities", world.entity_count, "left", left, "health", health.amount)
}

func spawn_body(index: Integer) {
    var entity = world.spawn()
    positions.insert(entity, Component.Position())
    velocities.insert(entity, Component.Velocity())
    if index % 2 == 0 {
        healths.insert(entity, Component.Health())
        regenerations.insert(entity, Component.Regeneration())
    }
}
