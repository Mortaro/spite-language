generic $system_type

enum Phase {
    'update'
}

var system = $system_type()
var world = World()
var matched = true

func run() {
    run_phases_each()
}

func run_phase_each(phase: Symbol<$system_type.phase_each>) {
    var entity = 0
    while entity < world.entity_count {
        matched = true
        match_arguments(entity)
        if matched {
            system.phase_each(row_arguments())
        }
        entity = entity + 1
    }
}

func match_argument(argument: Symbol<$system_type.phase_each>, entity: Integer) {
    var row = Row<argument.class>()
    var found = row.fill(entity)
    matched = matched and found
}

func row_argument(argument: Symbol<$system_type.phase_each>): argument.class {
    var row = Row<argument.class>()
    return row.current
}
