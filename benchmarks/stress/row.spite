singleton

generic $row_type

var current = $row_type()
var matched = true

func fill(entity: Integer): Boolean {
    matched = true
    match_attributes(entity)
    if matched {
        fill_attributes(current, entity)
    }
    return matched
}

func match_attribute(attribute: Symbol<$row_type>, entity: Integer) {
    var column = Column<attribute.class>()
    var stored = column.has(entity)
    matched = matched and stored
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, entity: Integer) {
    var column = Column<attribute.class>()
    row.attributes[attribute] = column.of(entity)
}
