singleton

generic $component_type

var values = List<$component_type>()
var rows = List<Integer>()

func insert(entity: Integer, component: $component_type) {
    while rows.count() <= entity {
        rows.append(0)
    }
    values.append(component)
    rows[entity] = values.count()
}

func has(entity: Integer): Boolean {
    return entity < rows.count() and rows[entity] > 0
}

func of(entity: Integer): $component_type {
    crash rows[entity]
    var row = rows[entity] - 1
    crash values[row]
    return values[row]
}
