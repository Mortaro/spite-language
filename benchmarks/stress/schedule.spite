type Runnable {
    run()
}

var runners = List<Runnable>()

func Schedule() {
    add_systems()
}

func add_system(system: Symbol<System>) {
    var runner = Runner<system.class>()
    runners.append(runner)
}

func tick() {
    var index = 0
    while index < runners.count() {
        runners[index].run()
        index = index + 1
    }
}
