generic $system_type

enum Phase {
    'update'
}

var system = $system_type()
var found = Items<Integer>()
var missing = false

func run(entity_count: Integer) {
    run_phases_each(entity_count)
}

func run_phase_each(phase: Symbol<$system_type.phase_each>, entity_count: Integer) {
    var entity = 0
    while entity < entity_count {
        found.clear()
        missing = false
        find_arguments(entity)
        if not missing {
            copy_arguments(found)
            system.phase_each(copied_arguments())
            store_arguments(found)
        }
        entity = entity + 1
    }
}

func find_argument(argument: Symbol<$system_type.phase_each>, entity: Integer) {
    var column = Column<argument.class>()
    var dense = column.set.dense_index(entity)
    if dense < 0 {
        missing = true
    }
    found.append(dense)
}

func copy_argument(argument: Symbol<$system_type.phase_each>, rows: Items<Integer>) {
    var column = Column<argument.class>()
    var copied = Copied<argument.class>()
    copied.current = column.values[rows[argument.index]].copy()
}

func copied_argument(argument: Symbol<$system_type.phase_each>): argument.class {
    var copied = Copied<argument.class>()
    return copied.current
}

func store_argument(argument: Symbol<$system_type.phase_each>, rows: Items<Integer>) {
    var column = Column<argument.class>()
    var copied = Copied<argument.class>()
    column.values.set_at(rows[argument.index], copied.current)
}
