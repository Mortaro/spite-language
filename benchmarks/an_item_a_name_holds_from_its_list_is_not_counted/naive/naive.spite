var console = Console()
var columns = List<Column>()
var weights = List<Integer>()
var hits = 0
var last = 0

func Naive() {
    var result = Benchmark(fill_and_visit)
    console.print("hits", hits, "last weight", last)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func fill_and_visit() {
    var index = 0
    while index < 100000 {
        var made = Column(index % 3 + 1)
        columns.append(made)
        weights.append(0)
        index = index + 1
    }
    var round = 0
    while round < 100 {
        visit_all()
        round = round + 1
    }
    hits = columns.sum_hits()
    crash weights[99999]
    last = weights[99999]
}

func visit_all() {
    var index = 0
    while index < columns.count() {
        visit(index)
        index = index + 1
    }
}

func visit(index: Integer) {
    crash columns[index]
    var column = columns[index]
    column.hit()
    weights[index] = weight(column)
}

func weight(column: Column): Integer {
    return column.hits * 10
}
