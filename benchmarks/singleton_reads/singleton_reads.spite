var console = Console()
var clock = Clock()
var transforms = Column<Transform>()
var row_total = 15000

func SingletonReads() {
    var row = 0
    while row < row_total {
        var transform = Transform(1.0 * row)
        transforms.insert(transform)
        row = row + 1
    }
    var best: Long = 0
    var total = 0.0
    var tick = 0
    while tick < 20 {
        var start = clock.elapsed_nanoseconds()
        total = total + one_tick()
        var took = clock.elapsed_nanoseconds() - start
        if tick == 0 or took < best {
            best = took
        }
        var written = transforms.at(0)
        transforms.insert(written)
        tick = tick + 1
    }
    var reads = row_total * 8
    var per_row = best / reads
    var microseconds = best / 1000
    console.print(
        "8 systems reading {row_total} rows each: best tick {microseconds} us, {per_row} ns per row read",
        total > 0.0,
    )
}

func one_tick(): Float {
    var first = System(row_total)
    var first_run = Parallel(first.run)
    var second = System(row_total)
    var second_run = Parallel(second.run)
    var third = System(row_total)
    var third_run = Parallel(third.run)
    var fourth = System(row_total)
    var fourth_run = Parallel(fourth.run)
    var fifth = System(row_total)
    var fifth_run = Parallel(fifth.run)
    var sixth = System(row_total)
    var sixth_run = Parallel(sixth.run)
    var seventh = System(row_total)
    var seventh_run = Parallel(seventh.run)
    var eighth = System(row_total)
    var eighth_run = Parallel(eighth.run)
    var early: Float = first_run + second_run + third_run + fourth_run
    var late: Float = fifth_run + sixth_run + seventh_run + eighth_run
    return early + late
}
