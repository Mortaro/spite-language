var console = Console()
var clock = Clock()
var base64 = Base64()

func Naive() {
    var start = clock.elapsed_nanoseconds()
    var bytes = List<Byte>()
    var index = 0
    while index < 100000 {
        var value: Byte = index * 7 % 256
        bytes.append(value)
        index = index + 1
    }
    var total = encode_rounds(bytes)
    var microseconds = (clock.elapsed_nanoseconds() - start) / 1000
    console.print("total", total)
    console.error("microseconds {microseconds}")
}

func encode_rounds(bytes: List<Byte>): Long {
    var total: Long = 0
    var round = 0
    while round < 100 {
        var changed: Byte = round
        bytes[round] = changed
        var encoded = base64.encode(bytes)
        total = total + encoded.length() + encoded.code_at(round)
        round = round + 1
    }
    return total
}
