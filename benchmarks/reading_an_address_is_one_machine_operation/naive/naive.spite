var console = Console()
var base64 = Base64()

func Naive() {
    var benchmark = Benchmark(encode_all)
    console.print("total", benchmark.answer)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func encode_all(): Long {
    var bytes = List<Byte>()
    var index = 0
    while index < 100000 {
        var value: Byte = index * 7 % 256
        bytes.append(value)
        index = index + 1
    }
    return encode_rounds(bytes)
}

func encode_rounds(bytes: List<Byte>): Long {
    var total: Long = 0
    var round = 0
    while round < 100 {
        var changed: Byte = round
        bytes[round] = changed
        var encoded = base64.encode(bytes)
        total = total + encoded.length() + encoded.code_at(round)
        round = round + 1
    }
    return total
}
