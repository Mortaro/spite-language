var console = Console()

func Naive() {
    var result = Benchmark(mix_all)
    console.print("checksum", result.answer)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func mix_all(): Long {
    var mixer = Mixer(31)
    return checksum(mixer, 50000000)
}

func checksum(mixer: Mixer, count: Integer): Long {
    var total: Long = 0
    var index = 0
    while index < count {
        total = total + mixer.mixed(index)
        index = index + 1
    }
    return total
}
