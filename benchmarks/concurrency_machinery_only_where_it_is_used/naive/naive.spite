var console = Console()
var clock = Clock()

func Naive() {
    var start = clock.elapsed_nanoseconds()
    var notes = File(".spite/concurrency_machinery_notes.txt")
    var characters = write_and_read(notes, 50)
    var removed = notes.remove()
    var microseconds = (clock.elapsed_nanoseconds() - start) / 1000
    console.print("characters", characters, "removed", removed)
    console.error("microseconds {microseconds}")
}

func write_and_read(notes: File, rounds: Integer): Integer {
    var characters = 0
    var round = 0
    while round < rounds {
        notes.write("round {round} of the notes")
        var read = notes.read()
        crash read
        characters = characters + read.length()
        round = round + 1
    }
    return characters
}
