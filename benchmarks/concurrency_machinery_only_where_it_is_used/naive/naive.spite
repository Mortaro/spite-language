var console = Console()
var characters_read = 0
var removed = false

func Naive() {
    var benchmark = Benchmark(write_read_and_remove)
    console.print("characters", characters_read, "removed", removed)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func write_read_and_remove() {
    var notes = File(".spite/concurrency_machinery_notes.txt")
    characters_read = write_and_read(notes, 50)
    removed = notes.remove()
}

func write_and_read(notes: File, rounds: Integer): Integer {
    var characters = 0
    var round = 0
    while round < rounds {
        notes.write("round {round} of the notes")
        var read = notes.read()
        crash read
        characters = characters + read.length()
        round = round + 1
    }
    return characters
}
