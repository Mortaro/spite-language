var console = Console()
var orbits = List<Orbit>()

func Naive() {
    make_orbits(100000)
    var benchmark = Benchmark(advance_ticks)
    var turns = orbits.sum_turns()
    console.print("turns", turns)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_orbits(count: Integer) {
    var index = 0
    while index < count {
        var orbit = Orbit(index)
        orbits.append(orbit)
        index = index + 1
    }
}

func advance_ticks() {
    var tick = 0
    while tick < 10 {
        orbits.each_advance()
        tick = tick + 1
    }
}
