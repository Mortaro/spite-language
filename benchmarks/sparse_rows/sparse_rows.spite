var console = Console()
var clock = Clock()
var move = System.Move()
var regenerate = System.Regenerate()
var moving_runner = Runner<System.Move.Moving, System.Move>()
var mending_runner = Runner<System.Regenerate.Mending, System.Regenerate>()
var referenced_moving_runner = ReferenceRunner<System.Move.Moving, System.Move>()
var referenced_mending_runner = ReferenceRunner<System.Regenerate.Mending, System.Regenerate>()
var positions = Column<Component.Position>()
var velocities = Column<Component.Velocity>()
var healths = Column<Component.Health>()
var regenerations = Column<Component.Regeneration>()
var referenced_entities = ReferenceColumn<Entity>()
var referenced_positions = ReferenceColumn<Component.Position>()
var referenced_velocities = ReferenceColumn<Component.Velocity>()
var referenced_healths = ReferenceColumn<Component.Health>()
var referenced_regenerations = ReferenceColumn<Component.Regeneration>()
var entity_count = 200000

func SparseRows() {
    var entity = 0
    while entity < entity_count {
        spawn(entity)
        entity = entity + 1
    }
    var backwards = entity_count - 1
    while backwards >= 0 {
        push(backwards)
        backwards = backwards - 1
    }
    var start = clock.elapsed_nanoseconds()
    var tick = 0
    while tick < 20 {
        moving_runner.run(move, entity_count)
        mending_runner.run(regenerate, entity_count)
        tick = tick + 1
    }
    var middle = clock.elapsed_nanoseconds()
    var moving = MovingRow()
    var mending = MendingRow()
    tick = 0
    while tick < 20 {
        referenced_moving_runner.run(move, moving, entity_count)
        referenced_mending_runner.run(regenerate, mending, entity_count)
        tick = tick + 1
    }
    var end = clock.elapsed_nanoseconds()
    var sparse_microseconds = (middle - start) / 20000
    var referenced_microseconds = (end - middle) / 20000
    console.print("sparse Vector columns and walked rows, microseconds per tick", sparse_microseconds)
    console.print("sparse reference columns and a reused row object, microseconds per tick", referenced_microseconds)
    var last = positions.values.count() - 2
    var sparse_left: Integer = positions.values[last].left
    var referenced_left: Integer = referenced_positions.at(last).left
    var sparse_amount = healths.values[0].amount
    var referenced_amount = referenced_healths.at(0).amount
    console.print(
        "left",
        sparse_left,
        referenced_left,
        "health",
        sparse_amount,
        referenced_amount,
        "marked",
        move.marked,
    )
}

func spawn(entity: Integer) {
    var made = Entity(entity)
    referenced_entities.insert(entity, made)
    var position = Component.Position()
    positions.insert(entity, position)
    referenced_positions.insert(entity, position)
    if entity % 2 == 0 {
        var health = Component.Health()
        healths.insert(entity, health)
        referenced_healths.insert(entity, health)
        var regeneration = Component.Regeneration()
        regenerations.insert(entity, regeneration)
        referenced_regenerations.insert(entity, regeneration)
    }
}

func push(entity: Integer) {
    var velocity = Component.Velocity()
    velocities.insert(entity, velocity)
    referenced_velocities.insert(entity, velocity)
}
