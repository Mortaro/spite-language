generic $row_type
generic $system_type

var matcher = Matcher<$row_type>()
var found = List<Integer>()

func run(system: $system_type, entity_count: Integer) {
    var entity = 0
    while entity < entity_count {
        matcher.match(entity)
        if not matcher.missing {
            found.clear()
            var position = 0
            while position < matcher.rows.count() {
                found.append(matcher.rows[position])
                position = position + 1
            }
            var row: $row_type = null
            fill_attributes(row, found)
            system.update_each(row)
        }
        entity = entity + 1
    }
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, rows: List<Integer>) {
    crash rows[attribute.index]
    crash Column<attribute.class>().values[rows[attribute.index]]
    row.attributes[attribute] = Column<attribute.class>().values[rows[attribute.index]]
}
