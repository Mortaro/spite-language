var console = Console()
var clock = Clock()
var registry = Registry()

func Naive() {
    var start = clock.elapsed_nanoseconds()
    var counted = record_on_four(250000)
    var recorded = registry.recorded()
    var total = registry.sum()
    var microseconds = (clock.elapsed_nanoseconds() - start) / 1000
    console.print("counted", counted, "recorded", recorded, "total", total)
    console.error("microseconds {microseconds}")
}

func record_on_four(rounds: Integer): Integer {
    var first = Recorder(rounds)
    var first_run = Parallel(first.record_all)
    var second = Recorder(rounds)
    var second_run = Parallel(second.record_all)
    var third = Recorder(rounds)
    var third_run = Parallel(third.record_all)
    var fourth = Recorder(rounds)
    var fourth_run = Parallel(fourth.record_all)
    return first_run + second_run + third_run + fourth_run
}
