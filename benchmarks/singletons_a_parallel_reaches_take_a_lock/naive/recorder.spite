var registry = Registry()
var rounds = 0

func Recorder(new_rounds: Integer) {
    rounds = new_rounds
}

func record_all(): Integer {
    var index = 0
    while index < rounds {
        var weight = weight_of(index)
        registry.record(weight)
        index = index + 1
    }
    return rounds
}

func weight_of(index: Integer): Integer {
    return index % 10 + 1
}
