var console = Console()
var clock = Clock()
var entity_count = 1000000

func HeldArguments() {
    var best: Long = 0
    var total = 0
    var round = 0
    while round < 7 {
        var start = clock.elapsed_nanoseconds()
        var stream = Stream(entity_count)
        var streamed = Parallel(stream.run)
        var got: Integer = streamed
        total = got
        var took = clock.elapsed_nanoseconds() - start
        if round == 0 or took < best {
            best = took
        }
        round = round + 1
    }
    var per_entity = best / entity_count
    console.print("a Vector passed on through two calls per entity: {per_entity} ns per entity", total)
}
