var entity_count = 0

func Stream(new_entity_count: Integer) {
    entity_count = new_entity_count
}

func run(): Integer {
    var matcher = Matcher(3)
    var found = Vector<Integer>()
    found.append(0)
    found.append(0)
    found.append(0)
    return run_positions(matcher, found)
}

func run_positions(matcher: Matcher, rows: Vector<Integer>): Integer {
    var total = 0
    var entity = 0
    while entity < entity_count {
        if matcher.match_into(entity, rows) {
            total = total + rows[2]
        }
        entity = entity + 1
    }
    return total
}
