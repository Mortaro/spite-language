var console = Console()

func ReflectionWalks() {
    var everyone = List<Stats>()
    var index = 0
    while index < 20000 {
        var hero = Stats("hero{index}", index % 50)
        everyone.append(hero)
        index = index + 1
    }
    var walked: Long = 0
    var described: Long = 0
    var written: Long = 0
    var round = 0
    while round < 10 {
        index = 0
        while index < everyone.count() {
            var stats = everyone[index]
            var lines = List<String>()
            show_attributes(stats, lines)
            var joined = lines.join(",")
            walked = walked + joined.length()
            described = described + describe(stats)
            if index % 10 == 0 {
                var json = JsonWriter<Stats>()
                var text = json.write(stats)
                written = written + text.length()
            }
            index = index + 1
        }
        round = round + 1
    }
    console.print("walked", walked, "described", described, "written", written)
}

func show_attribute(attribute: Symbol<Stats>, stats: Stats, lines: List<String>) {
    lines.append("{attribute.name}={stats.attributes[attribute]}")
}

func describe(stats: Stats): Integer {
    var attributes = stats.attributes
    var total = 0
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        total = total + attribute.name.length() + text_length(attribute)
        index = index + 1
    }
    return total
}

func text_length(attribute: Spite.Attribute): Integer {
    if not attribute.value {
        return 0
    }
    var text = attribute.value.to_string()
    return text.length()
}
