var console = Console()
var origin = Point(0, 0)

func Naive() {
    var result = Benchmark(every_trial)
    console.print("total", result.answer, "origin", origin.x, origin.y)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func every_trial(): Long {
    origin = Point(3, -4)
    return all_trials(origin, 20000000)
}

func all_trials(origin: Point, trials: Integer): Long {
    var total: Long = 0
    var trial = 0
    while trial < trials {
        var moved = origin.copy()
        moved.move_by(trial % 7 - 3, trial % 5 - 2)
        total = total + moved.distance_from_origin()
        trial = trial + 1
    }
    return total
}
