var console = Console()
var scorer: Scorer? = null

func Naive() {
    var benchmark = Benchmark(make_and_apply)
    var applied = benchmark.answer
    crash scorer
    var scoring = scorer.score
    var argument_count = scoring.arguments.count()
    console.print("applied", applied, "arguments", argument_count)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_and_apply(): Long {
    var made = Scorer()
    scorer = made
    return apply_all(made, 2000000)
}

func apply_all(scorer: Scorer, count: Integer): Long {
    var applied: Long = 0
    var index = 0
    while index < count {
        var scored = apply(scorer.score, index % 100)
        applied = applied + scored
        index = index + 1
    }
    return applied
}

func apply(change: Spite.Function<Integer, Integer>, value: Integer): Integer {
    return change(value)
}
