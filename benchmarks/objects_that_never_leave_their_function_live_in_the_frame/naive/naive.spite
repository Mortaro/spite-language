var console = Console()
var ended_x = 0.0
var ended_y = 0.0
var ended_z = 0.0

func Naive() {
    var result = Benchmark(simulate_all)
    var across: Long = ended_x * 1000.0
    var up: Long = ended_y * 1000.0
    var ahead: Long = ended_z * 1000.0
    console.print("ended at", across, up, ahead)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func simulate_all() {
    var ended = simulate(20000000)
    ended_x = ended.x
    ended_y = ended.y
    ended_z = ended.z
}

func simulate(steps: Integer): Offset {
    var position = Offset(0.0, 0.0, 0.0)
    var velocity = Offset(1.0, 0.5, 0.25)
    var gravity = Offset(0.0, -0.5, 0.0)
    var step = 0
    while step < steps {
        var pulled = gravity.scaled(0.000001)
        velocity = velocity + pulled
        var moved = velocity.scaled(0.001)
        position = position + moved
        step = step + 1
    }
    return position
}
