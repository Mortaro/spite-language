var console = Console()
var evens = Evens()
var odds = Odds()

func Naive() {
    var result = Benchmark(count_both)
    console.print(evens.total, odds.total)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func count_both() {
    evens.count()
    odds.count()
}
