var console = Console()
var environment = Environment()
var spread: Long = 0
var bright = 0
var weights: Long = 0

func Naive() {
    var result = Benchmark(filter_image)
    console.print("spread", spread, "bright", bright, "weights", weights)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func filter_image() {
    var pixels = List<Pixel>()
    var seed: Long = 11
    var index = 0
    while index < environment.pixels {
        seed = seed * 48271 % 2147483647
        var pixel = Pixel(seed)
        pixels.append(pixel)
        index = index + 1
    }
    pixels.each_brighten()
    pixels.each_contrast()
    var histogram = histogram_of(pixels)
    bright = pixels.count_is_bright()
    weights = pixels.sum_weight()
    spread = spread_of(histogram)
}

func histogram_of(pixels: List<Pixel>): List<Integer> {
    var histogram = List<Integer>()
    var level = 0
    while level < 256 {
        histogram.append(0)
        level = level + 1
    }
    var index = 0
    while index < pixels.count() {
        var pixel = pixels[index]
        var luminance = pixel.luminance()
        crash histogram[luminance]
        histogram[luminance] = histogram[luminance] + 1
        index = index + 1
    }
    return histogram
}

func spread_of(histogram: List<Integer>): Long {
    var spread: Long = 0
    var level = 0
    while level < histogram.count() {
        spread = spread + histogram[level] * (level % 7 + 1)
        level = level + 1
    }
    return spread
}
