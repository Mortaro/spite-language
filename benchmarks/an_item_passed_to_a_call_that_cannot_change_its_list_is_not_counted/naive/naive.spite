var console = Console()
var playlist: Playlist = null

func Naive() {
    playlist = Playlist()
    var result = Benchmark(listen_to_all)
    console.print("total", result.answer)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func listen_to_all(): Integer {
    return playlist.listen(10000000)
}
