var console = Console()
var meter: Meter = null

func Naive() {
    meter = Meter()
    var result = Benchmark(measure_every_reading)
    console.print("total", result.answer)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func measure_every_reading(): Integer {
    return meter.measure_all(10000000)
}
