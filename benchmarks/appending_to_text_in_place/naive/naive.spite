var console = Console()

func Naive() {
    var benchmark = Benchmark(all_words)
    console.print("characters", benchmark.answer)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func all_words(): Integer {
    var total = 0
    var round = 0
    while round < 8 {
        var text = words(10000)
        total = total + text.length()
        round = round + 1
    }
    return total
}

func words(count: Integer): String {
    var text = ""
    var piece = "word "
    var index = 0
    while index < count {
        text = text + piece
        index = index + 1
    }
    return text
}
