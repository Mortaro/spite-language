var console = Console()
var desk = Desk()
var total = 0

func Naive() {
    desk.stock(100000)
    var benchmark = Benchmark(edit_every_page)
    console.print("words", total)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func edit_every_page() {
    var round = 0
    while round < 100 {
        var index = 0
        while index < 100000 {
            desk.take(index)
            desk.open.words = desk.open.words + 1
            desk.put_back()
            index = index + 1
        }
        round = round + 1
    }
    total = desk.total()
}
