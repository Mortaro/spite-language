var console = Console()

func Naive() {
    var benchmark = Benchmark(all_lines)
    console.print("characters", benchmark.answer)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func all_lines(): Long {
    var total: Long = 0
    var round = 0
    while round < 20 {
        total = total + lines(100000, round)
        round = round + 1
    }
    return total
}

func lines(count: Integer, round: Integer): Integer {
    var total = 0
    var index = 0
    while index < count {
        var line = "line {index} of {round};"
        total = total + line.length()
        index = index + 1
    }
    return total
}
