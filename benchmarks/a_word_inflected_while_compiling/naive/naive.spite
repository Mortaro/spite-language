var console = Console()

func Naive() {
    var benchmark = Benchmark(all_characters)
    console.print("characters", benchmark.answer)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func all_characters(): Long {
    return characters(1000000)
}

func characters(count: Integer): Long {
    var total: Long = 0
    var index = 0
    while index < count {
        var shown = label(index % 50)
        total = total + shown.length()
        index = index + 1
    }
    return total
}

func label(count: Integer): String {
    if count == 1 {
        return "1 cactus"
    }
    var plural = "cactus".pluralize()
    return "{count} {plural}"
}
