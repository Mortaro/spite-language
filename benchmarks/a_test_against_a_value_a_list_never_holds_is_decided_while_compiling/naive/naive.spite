var console = Console()

func Naive() {
    var benchmark = Benchmark(price_all)
    console.print("total", benchmark.answer)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func price_all(): Long {
    var checkout = Pipeline()
    checkout.add('discount')
    checkout.add('tax')
    checkout.add('discount')
    var total: Long = 0
    var index = 0
    while index < 10000000 {
        var amount = 1000 + index % 1000
        var priced = checkout.price(amount)
        total = total + priced
        index = index + 1
    }
    return total
}
