var console = Console()

func Naive() {
    var result = Benchmark(make_and_count)
    console.print("near", result.answer)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_and_count(): Long {
    var points = make_points(200000)
    return count_near(points)
}

func make_points(count: Integer): List<Point> {
    var points = List<Point>()
    var index = 0
    while index < count {
        var point = Point(index % 1000, index % 700)
        points.append(point)
        index = index + 1
    }
    return points
}

func count_near(points: List<Point>): Long {
    var near: Long = 0
    var round = 0
    while round < 20 {
        var kept = List<Point>()
        var index = 0
        while index < points.count() {
            var point = points[index]
            if point.across + point.down > round * 80 {
                kept.append(point)
            }
            index = index + 1
        }
        near = near + kept.count()
        round = round + 1
    }
    return near
}
