var column = Column<Heat>()

func run(): Float {
    var rows = column.count()
    var places = List<Integer>()
    places.append(0)
    var total = 0.0
    var row = 0
    while row < rows {
        places[0] = rows - 1 - row
        crash places[0]
        var place = places[0]
        crash column.values[place]
        total = total + column.values[place].value
        row = row + 1
    }
    return total
}
