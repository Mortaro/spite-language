var column = Column<Heat>()

func run(): Float {
    var rows = column.count()
    var places = Vector<Integer>()
    places.append(0)
    var total = 0.0
    var row = 0
    while row < rows {
        places[0] = rows - 1 - row
        total = total + column.values[places[0]].value
        row = row + 1
    }
    return total
}
