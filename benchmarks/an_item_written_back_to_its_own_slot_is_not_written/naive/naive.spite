var console = Console()
var particles = List<Particle>()

func Naive() {
    var result = Benchmark(make_and_move)
    console.print("total", result.answer)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func make_and_move(): Integer {
    var index = 0
    while index < 200000 {
        var made = Particle(index % 7 + 1)
        particles.append(made)
        index = index + 1
    }
    var tick = 0
    while tick < 200 {
        step()
        tick = tick + 1
    }
    return particles.sum_left()
}

func step() {
    var index = 0
    while index < particles.count() {
        var particle = particles[index]
        particle.left = particle.left + particle.speed
        particles[index] = particle
        index = index + 1
    }
}
