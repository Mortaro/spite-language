var console = Console()
var clock = Clock()

func Serialisation() {
    var units = List<Unit>()
    var index = 0
    while index < 100000 {
        var unit = Unit(index, "unit{index % 1000}")
        units.append(unit)
        index = index + 1
    }
    var json_start = clock.elapsed_nanoseconds()
    var texts = json_texts(units)
    var json_written = clock.elapsed_nanoseconds()
    var json_read = json_units(texts)
    var json_end = clock.elapsed_nanoseconds()
    var bytes = List<Byte>()
    binary_bytes(units, bytes)
    var binary_written = clock.elapsed_nanoseconds()
    var binary_read = binary_units(bytes)
    var binary_end = clock.elapsed_nanoseconds()
    var json_size = text_size(texts)
    var binary_size = bytes.count()
    var json_write_milliseconds = (json_written - json_start) / 1000000
    var json_read_milliseconds = (json_end - json_written) / 1000000
    var binary_write_milliseconds = (binary_written - json_end) / 1000000
    var binary_read_milliseconds = (binary_end - binary_written) / 1000000
    console.print(
        "json bytes",
        json_size,
        "write ms",
        json_write_milliseconds,
        "read ms",
        json_read_milliseconds,
        "read",
        json_read,
    )
    console.print(
        "binary bytes",
        binary_size,
        "write ms",
        binary_write_milliseconds,
        "read ms",
        binary_read_milliseconds,
        "read",
        binary_read,
    )
}

func json_texts(units: List<Unit>): List<String> {
    var texts = List<String>()
    var index = 0
    while index < units.count() {
        var writer = JsonWriter<Unit>()
        var text = writer.write(units[index])
        texts.append(text)
        index = index + 1
    }
    return texts
}

func json_units(texts: List<String>): Integer {
    var read = 0
    var index = 0
    while index < texts.count() {
        var reader = JsonReader<Unit>()
        var unit = reader.read(texts[index])
        if unit {
            read = read + 1
        }
        index = index + 1
    }
    return read
}

func binary_bytes(units: List<Unit>, bytes: List<Byte>) {
    var index = 0
    while index < units.count() {
        var writer = BinaryWriter(units[index])
        writer.append_to(bytes)
        index = index + 1
    }
}

func binary_units(bytes: List<Byte>): Integer {
    var read = 0
    var reader = BinaryReader<Unit>(bytes)
    var unit = reader.read()
    while unit {
        read = read + 1
        unit = reader.read()
    }
    return read
}

func text_size(texts: List<String>): Long {
    return texts.sum_length()
}
