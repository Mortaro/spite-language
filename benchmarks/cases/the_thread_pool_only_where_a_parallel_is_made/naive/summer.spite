var limit = 0
var offset = 0

func Summer(new_limit: Integer, new_offset: Integer) {
    limit = new_limit
    offset = new_offset
}

func total(): Long {
    var sum: Long = 0
    var index = offset
    while index < limit {
        sum = sum + index % 7
        index = index + 2
    }
    return sum
}
