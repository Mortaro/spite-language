var console = Console()
var tally = Tally()
var first = 0
var reached = 0
var total: Long = 0
var calls = 0

func Naive() {
    var benchmark = Benchmark(add_all)
    console.print("first", first, "reached", reached, "calls", calls, "total", total)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func add_all() {
    first = add_on_the_pool()
    reached = add_many(10000000)
    total = tally.sum()
    calls = tally.call_count()
}

func add_on_the_pool(): Integer {
    var worker = Worker()
    return Parallel(worker.run)
}

func add_many(count: Integer): Integer {
    var index = 0
    while index < count {
        index = tally.add(index)
    }
    return index
}
