var console = Console()
var clock = Clock()

func GameMaths() {
    var start = clock.elapsed_nanoseconds()
    var moved = vector_pass()
    var vectors_end = clock.elapsed_nanoseconds()
    var combined = matrix_pass()
    var matrices_end = clock.elapsed_nanoseconds()
    var transformed = transform_pass()
    var transforms_end = clock.elapsed_nanoseconds()
    var vector_microseconds = (vectors_end - start) / 1000
    var matrix_microseconds = (matrices_end - vectors_end) / 1000
    var transform_microseconds = (transforms_end - matrices_end) / 1000
    console.print("1 000 000 Vector3 steps (a + b.scaled(t)) microseconds", vector_microseconds, "ended at", moved)
    console.print("200 000 Matrix4 products microseconds", matrix_microseconds, "diagonal", combined)
    console.print("1 000 000 Matrix4 point transforms microseconds", transform_microseconds, "total", transformed)
}

func vector_pass(): Vector3 {
    var position = Vector3(0.0, 0.0, 0.0)
    var velocity = Vector3(1.0, 0.5, 0.25)
    var step = 0
    while step < 1000000 {
        var moved = velocity.scaled(0.001)
        position = position + moved
        step = step + 1
    }
    return position
}

func matrix_pass(): Float {
    var turn = Quaternion()
    var axis = Vector3(0.0, 1.0, 0.0)
    turn.set_axis_angle(axis, 0.001)
    var step_matrix = turn.to_matrix()
    var accumulated = Matrix4()
    var step = 0
    while step < 200000 {
        accumulated = accumulated * step_matrix
        step = step + 1
    }
    return accumulated.column_0_row_0 + accumulated.column_1_row_1 + accumulated.column_2_row_2
}

func transform_pass(): Float {
    var model = Matrix4()
    var place = Vector3(1.0, 2.0, 3.0)
    model.translation = place
    var point = Vector3(0.5, 0.5, 0.5)
    var total = 0.0
    var step = 0
    while step < 1000000 {
        var moved = model.transform_point(point)
        total = total + moved.x_value
        step = step + 1
    }
    return total
}
