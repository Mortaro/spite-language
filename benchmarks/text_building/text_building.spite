var console = Console()

func TextBuilding() {
    var total: Long = 0
    var round = 0
    while round < 20 {
        var built = ""
        var index = 0
        while index < 50000 {
            built = "{built}line {index} of {round};"
            index = index + 1
        }
        var words = List<String>()
        index = 0
        while index < 20000 {
            words.append("word{index}")
            index = index + 1
        }
        var joined = words.join(", ")
        var joined_length = joined.length()
        var line = describe(round, joined_length)
        total = total + built.length() + joined_length + line.length()
        round = round + 1
    }
    console.print("total", total)
}

func describe(round: Integer, length: Integer): String {
    var text = "round "
    text = text + round
    text = "{text} joined {length} characters"
    return text
}
