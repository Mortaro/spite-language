type Voice {
    render()
}

var console = Console()
var sine = Sine()
var square = Square()
var saw = Saw()
var voices = List<Voice>()

func Naive() {
    add_voices()
    var result = Benchmark(render_all)
    console.print(sine.level, square.level, saw.level)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func add_voices() {
    voices.append(sine)
    voices.append(square)
    voices.append(saw)
}

func render_all() {
    voices.each_render()
}
