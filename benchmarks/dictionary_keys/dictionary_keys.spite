var console = Console()

func DictionaryKeys() {
    var by_number = Dictionary<Integer>()
    var index = 0
    while index < 50000 {
        by_number[index] = index * 2
        index = index + 1
    }
    var names = List<String>()
    index = 0
    while index < 2000 {
        names.append("entity_name_{index}")
        index = index + 1
    }
    var by_name = Dictionary<Integer>()
    index = 0
    while index < names.count() {
        by_name[names[index]] = index
        index = index + 1
    }
    var total: Long = 0
    var round = 0
    while round < 10 {
        index = 0
        while index < 50000 {
            var key: String = index
            if by_number[key] {
                total = total + by_number[key]
            }
            index = index + 1
        }
        index = 0
        while index < 100000 {
            var position = index % 2000
            crash names[position]
            var name = names[position]
            if by_name[name] {
                total = total + by_name[name]
            }
            index = index + 1
        }
        round = round + 1
    }
    var counted = by_number.count() + by_name.count()
    console.print("total", total, "entries", counted)
}
