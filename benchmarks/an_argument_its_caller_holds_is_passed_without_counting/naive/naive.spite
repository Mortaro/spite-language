var console = Console()
var clock = Clock()

func Naive() {
    var start = clock.elapsed_nanoseconds()
    var total = stream_on_the_pool(3000000)
    var microseconds = (clock.elapsed_nanoseconds() - start) / 1000
    console.print("total", total)
    console.error("microseconds {microseconds}")
}

func stream_on_the_pool(entity_count: Integer): Integer {
    var stream = Stream(entity_count)
    return Parallel(stream.run)
}
