var console = Console()

func Naive() {
    var benchmark = Benchmark(stream_all)
    console.print("total", benchmark.answer)
    var microseconds = benchmark.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func stream_all(): Integer {
    return stream_on_the_pool(3000000)
}

func stream_on_the_pool(entity_count: Integer): Integer {
    var stream = Stream(entity_count)
    return Parallel(stream.run)
}
