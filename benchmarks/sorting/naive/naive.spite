var console = Console()
var sorted_in_order = false
var weighted_sum: Long = 0

func Naive() {
    var result = Benchmark(sort_and_check)
    console.print("ordered", sorted_in_order, "checksum", weighted_sum)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func sort_and_check() {
    var numbers = List<Integer>()
    var seed: Long = 42
    var index = 0
    while index < 2000000 {
        seed = seed * 48271 % 2147483647
        var number: Integer = seed % 1000000
        numbers.append(number)
        index = index + 1
    }
    var last = numbers.count() - 1
    sort(numbers, 0, last)
    var checksum: Long = 0
    var ordered = true
    index = 0
    while index < numbers.count() {
        checksum = checksum + numbers[index] * (index % 7)
        if index > 0 {
            crash numbers[index - 1]
            if numbers[index - 1] > numbers[index] {
                ordered = false
            }
        }
        index = index + 1
    }
    sorted_in_order = ordered
    weighted_sum = checksum
}

func sort(numbers: List<Integer>, low: Integer, high: Integer) {
    var left = low
    var right = high
    while left < right {
        var middle = left + (right - left) / 2
        crash numbers[middle]
        var pivot = numbers[middle]
        var lower = left
        var upper = right
        while lower <= upper {
            while lower < numbers.count() and numbers[lower] < pivot {
                lower = lower + 1
            }
            while upper >= 0 and upper < numbers.count() and numbers[upper] > pivot {
                upper = upper - 1
            }
            if lower <= upper {
                crash numbers[lower]
                crash numbers[upper]
                var swapped = numbers[lower]
                var moved = numbers[upper]
                numbers[lower] = moved
                numbers[upper] = swapped
                lower = lower + 1
                upper = upper - 1
            }
        }
        if upper - left < right - lower {
            sort(numbers, left, upper)
            left = lower
        } else {
            sort(numbers, lower, right)
            right = upper
        }
    }
}
