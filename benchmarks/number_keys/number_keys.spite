var console = Console()
var clock = Clock()
var entry_total = 100000
var lookup_rounds = 10

func NumberKeys() {
    var by_number = Dictionary<Integer>()
    var by_text = Dictionary<Integer>()
    var start = clock.elapsed_milliseconds()
    fill_numbers(by_number)
    var numbers_filled = clock.elapsed_milliseconds()
    fill_texts(by_text)
    var texts_filled = clock.elapsed_milliseconds()
    var number_total = look_up_numbers(by_number)
    var numbers_read = clock.elapsed_milliseconds()
    var text_total = look_up_texts(by_text)
    var texts_read = clock.elapsed_milliseconds()
    var number_fill = numbers_filled - start
    var text_fill = texts_filled - numbers_filled
    var number_reads = numbers_read - texts_filled
    var text_reads = texts_read - numbers_read
    console.print("fill ms: number keys", number_fill, "text keys", text_fill)
    console.print("1M lookups ms: number keys", number_reads, "text keys", text_reads)
    console.print("totals", number_total, text_total)
}

func fill_numbers(filled: Dictionary<Integer>) {
    var index = 0
    while index < entry_total {
        filled[index] = index * 2
        index = index + 1
    }
}

func fill_texts(filled: Dictionary<Integer>) {
    var index = 0
    while index < entry_total {
        var key = index.to_string()
        filled[key] = index * 2
        index = index + 1
    }
}

func look_up_numbers(read: Dictionary<Integer>): Long {
    var total: Long = 0
    var round = 0
    while round < lookup_rounds {
        var index = 0
        while index < entry_total {
            if read[index] {
                total = total + read[index]
            }
            index = index + 1
        }
        round = round + 1
    }
    return total
}

func look_up_texts(read: Dictionary<Integer>): Long {
    var total: Long = 0
    var round = 0
    while round < lookup_rounds {
        var index = 0
        while index < entry_total {
            var key = index.to_string()
            if read[key] {
                total = total + read[key]
            }
            index = index + 1
        }
        round = round + 1
    }
    return total
}
