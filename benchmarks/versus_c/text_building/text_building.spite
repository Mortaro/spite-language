var console = Console()

func TextBuilding() {
    var built = ""
    var index = 0
    while index < 3000000 {
        built = "{built}item {index},"
        index = index + 1
    }
    var words = List<String>()
    index = 0
    while index < 1000000 {
        words.append("word{index}")
        index = index + 1
    }
    var joined = words.join(", ")
    var built_length = built.length()
    var joined_length = joined.length()
    console.print("built", built_length, "joined", joined_length)
}
