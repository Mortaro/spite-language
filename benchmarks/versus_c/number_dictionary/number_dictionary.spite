var console = Console()
var clock = Clock()

func NumberDictionary() {
    var start = clock.elapsed_nanoseconds()
    var scores = Dictionary<Integer>()
    var index = 0
    while index < 500000 {
        scores[index * 7] = index
        index = index + 1
    }
    var total: Long = 0
    var found = 0
    var round = 0
    while round < 10 {
        index = 0
        while index < 500000 {
            var key = index * 3
            if scores[key] {
                total = total + scores[key]
                found = found + 1
            }
            index = index + 1
        }
        round = round + 1
    }
    var entries = scores.count()
    var microseconds = (clock.elapsed_nanoseconds() - start) / 1000
    console.print("entries", entries, "found", found, "total", total)
    console.error("microseconds {microseconds}")
}
