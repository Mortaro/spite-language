var console = Console()
var rack = Rack()
var changed = 0
var total = 0

func Naive() {
    var result = Benchmark(restock_and_total)
    console.print("changed", changed, "total", total)
    var microseconds = result.duration.total('microseconds')
    console.error("microseconds {microseconds}")
}

func restock_and_total() {
    changed = rack.restock(10000000)
    total = rack.total()
}
