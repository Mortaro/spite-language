var console = Console()

func EventBus() {
    var bus = Bus()
    var counter = Counter()
    bus.subscribe(counter.count_event)
    bus.subscribe(log_event)
    var ada_arrives = Arrival("ada")
    bus.publish(ada_arrives)
    var ada_leaves = Departure("ada")
    bus.publish(ada_leaves)
    var grace_arrives = Arrival("grace")
    bus.publish(grace_arrives)
    var joined_names = counter.names.join(",")
    console.print(counter.seen, joined_names)
    report(counter)
}

func log_event(event: Event) {
    switch event {
        Arrival: console.print("arrived", event.name)
        _: console.print("something else happened to", event.name)
    }
}

func report(counter: Counter) {
    var totals = Dictionary<String, Integer>()
    var index = 0
    while index < counter.names.count() {
        var name = counter.names[index]
        if totals.has(name) {
            crash totals[name]
            totals[name] = totals[name] + 1
        } else {
            totals[name] = 1
        }
        index = index + 1
    }
    console.print(totals["ada"] == 2, totals["grace"] == 1, totals["alan"] == 0)
}
