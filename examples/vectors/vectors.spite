var console = Console()

func Vectors() {
    var first_vector = Vector(1.0, 2.0)
    var second_vector = Vector(3.0, 4.0)

    var total = first_vector + second_vector
    console.print("sum", total.get_at(0), total.get_at(1))

    var difference = second_vector - first_vector
    console.print("difference", difference[0], difference[1])

    console.print("equal", first_vector == Vector(1.0, 2.0))
    console.print("not equal", first_vector != second_vector)

    var scaled = first_vector * 2.0
    console.print("scaled", scaled[0], scaled[1])

    first_vector[0] = 10.0
    first_vector.set_at(1, 20.0)
    console.print("mutated", first_vector[0], first_vector[1])

    console.print("length squared", second_vector.length_squared())
}
