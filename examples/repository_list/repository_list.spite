var console = Console()

func RepositoryList() {
    var repositories = List<Repository>()
    repositories.append(Repository("engine", 10, true))
    repositories.append(Repository("cookie_clicker", 3, false))
    repositories.append(Repository("compiler", 20, true))
    crash repositories[0]
    var first = repositories[0]
    first.set_stars(15)
    console.print("first stars", first.get_stars())
    console.print("active stars", repositories.filter_active().sum_stars())
    var found = repositories.find_by_name("compiler")
    if found {
        console.print("found", found.name, found.stars)
    }
    var sorted = repositories.sort_by_stars()
    var index = 0
    while index < sorted.count() {
        var repository = sorted[index]
        console.print(repository.name, repository.stars)
        index = index + 1
    }
    var attributes = first.attributes
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        console.print(attribute.name, attribute.class, attribute.value)
        attribute_index = attribute_index + 1
    }
    console.print("done")
}
