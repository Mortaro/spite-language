var console = Console()
var system = Program()
var player = Player()
var monsters = List<Monster>()
var settings = Dictionary<Int>()
var target: Monster? = null
var tick = 0

func Dungeon() {
    monsters.append(Monster("Goblin", 30))
    monsters.append(Monster("Orc", 50))
    settings.set("volume", 80)
    settings.set("difficulty", 2)
    target = Monster("Boss", 200)

    console.print("player age", player.age)

    if $serve {
        while tick < 3 {
            console.print("tick", tick)
            tick = tick + 1
            system.sleep(50)
        }
    }
}
