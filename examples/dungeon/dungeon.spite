var console = Console()
var system = Program()
var player = Player()
var monsters = List<Monster>()
var settings = Dictionary<Integer>()
var tick = 0
var environment = Environment()

func Dungeon() {
    var goblin = Monster("Goblin", 30)
    monsters.append(goblin)
    var orc = Monster("Orc", 50)
    monsters.append(orc)
    settings.set("volume", 80)
    settings.set("difficulty", 2)
    console.print("player age", player.age)
    if environment.serve {
        while tick < 3 {
            console.print("tick", tick)
            tick = tick + 1
            system.sleep(50)
        }
    }
}
