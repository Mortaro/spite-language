var console = Console()
var variables = Dictionary<Float>()
var current_tree: Expression? = null

func assign(name: String, value: Float) {
    variables.set(name, value)
}

func evaluate_tree(tree: Expression): Float {
    current_tree = tree
    var stored_tree = current_tree
    crash stored_tree
    return evaluate(stored_tree)
}

func evaluate(expression: Expression): Float {
    switch expression {
        NumberExpression: return expression.value
        VariableExpression: {
            var looked_up = variables.get(expression.name)
            if looked_up {
                return looked_up
            }
            return 0.0
        }
        BinaryExpression: {
            var left_value = 0.0
            var left = expression.left
            if left {
                left_value = evaluate(left)
            }
            var right_value = 0.0
            var right = expression.right
            if right {
                right_value = evaluate(right)
            }
            if expression.operator == 'plus' {
                return left_value + right_value
            }
            if expression.operator == 'minus' {
                return left_value - right_value
            }
            if expression.operator == 'star' {
                return left_value * right_value
            }
            return left_value / right_value
        }
    }
}

func process_line(line: String) {
    if line.is_empty() {
        return
    }
    if line.contains("=") {
        var parts = line.split("=")
        var parser = Parser(Lexer(parts[1]).tokens)
        var tree = parser.parse()
        var value = evaluate_tree(tree)
        console.print(parts[0].trim(), "=", value)
        assign(parts[0].trim(), value)
        return
    }
    var parser = Parser(Lexer(line).tokens)
    var tree = parser.parse()
    var value = evaluate_tree(tree)
    console.print("=>", value)
}
