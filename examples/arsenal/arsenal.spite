var console = Console()
var environment = Environment()

func Arsenal(arguments: Arguments) {
    var sword = Weapon<Int, true>(10)
    sword.hit()
    if environment.name == "server" {
        console.print("environment is server")
    } else {
        console.print("environment is not server")
    }
    if arguments.player {
        console.print("player", arguments.player)
    }
    console.print("argument count", arguments.count())
    console.print("first argument", arguments.get(0))
}
