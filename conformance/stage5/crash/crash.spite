var console = Console()
var names = Dictionary<String>()

func Crash() {
    names.set("ada", "Ada Lovelace")
    var name_length = name_length("ada")
    console.print(name_length)
    var three_description = describe(3)
    console.print(three_description)
    var minus_one_description = describe(0 - 1)
    console.print(minus_one_description)
}

func name_length(key: String): Int {
    var name = names.get(key)
    crash name
    return name.length()
}

func describe(value: Int): String {
    crash value > 0 - 5
    if value > 0 {
        return "positive"
    }
    if value < 1 {
        return "not positive"
    }
    crash false
}
