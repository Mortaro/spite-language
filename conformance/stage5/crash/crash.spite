var console = Console()
var names = Dictionary<String, String>()

func Crash() {
    names["ada"] = "Ada Lovelace"
    var length_of_name = name_length("ada")
    console.print(length_of_name)
    var three_description = describe(3)
    console.print(three_description)
    var minus_one_description = describe(0 - 1)
    console.print(minus_one_description)
}

func name_length(key: String): Integer {
    crash names[key]
    return names[key].length()
}

func describe(value: Integer): String {
    crash value > 0 - 5
    if value > 0 {
        return "positive"
    }
    if value < 1 {
        return "not positive"
    }
    crash
}
