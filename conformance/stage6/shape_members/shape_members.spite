type Runnable {
    name: String
    active: Boolean
    run_once()
    label(): String
}

var console = Console()

func ShapeMembers() {
    var stages = List<Runnable>()
    var physics = Stage("physics")
    stages.append(physics)
    var render = Stage("render")
    stages.append(render)
    run_first(stages)
    var names = stages.map_names()
    var labels = stages.map_labels()
    var joined_names = names.join(",")
    var joined_labels = labels.join(",")
    console.print(joined_names, joined_labels)
    var active_names = stages.filter_active().map_names()
    var joined_active = active_names.join(",")
    var total = stages.count_active()
    console.print(joined_active, total)
}

func run_first(stages: List<Runnable>) {
    assert stages[0]
    run_in_parallel(stages[0])
    var labelled = stages[0].label
    var first_name = stages[0].name
    var text = labelled()
    console.print(text, first_name)
}

func run_in_parallel(stage: Runnable) {
    stage.run_once()
    var running = List<Parallel<String>>()
    var stage_label = Parallel(stage.label)
    running.append(stage_label)
}
