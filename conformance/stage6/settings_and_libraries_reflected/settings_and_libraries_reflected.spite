var console = Console()
var build = Build()

func SettingsAndLibrariesReflected() {
    var attributes = build.attributes
    var index = 0
    while index < attributes.count() {
        if attributes[index].name == "check" or attributes[index].name == "optimized" {
            var value_text = text_of(attributes[index])
            console.print(attributes[index].name, value_text)
        }
        index = index + 1
    }
    var shelf = Shelf()
    var shelf_attributes = shelf.attributes
    var functions = console.class.functions
    var shelf_count = shelf_attributes.count()
    var held = shelf.libraries.count()
    var function_count = functions.count()
    console.print("shelf", shelf_count, held, function_count > 0)
}

func text_of(attribute: Spite.Attribute): String {
    if not attribute.value {
        return ""
    }
    return attribute.value.to_string()
}
