var console = Console()
var environment = Environment()
var build = Build()

func LiveSettings() {
    var said = greeting()
    console.print(said)
    var counted = twice()
    console.print(counted)
}

func greeting(): String {
    if build.loud {
        return "{environment.greeting_word}!"
    }
    return environment.greeting_word
}

func twice(): Integer {
    var seven = 7
    return seven.doubled()
}
