var console = Console()
var environment = Environment()

func EnvironmentFlags() {
    if environment.serve {
        console.print("serving: given to the compiler, so the other branch was never generated")
    } else {
        console.print("rendering")
    }
    console.print("workers", environment.workers, "name", environment.name)
    if environment.name == "server" and environment.workers == 3 {
        console.print("the name was read when the program ran")
    }
}
