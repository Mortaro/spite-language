var console = Console()

func DeepCopies() {
    var team = Team("red")
    team.members.append(Member("ada", 3))
    team.members.append(Member("grace", 5))
    team.scores.set("first", 10)
    team.captain = team.members[0]
    var shallow = team.copy()
    var deep = team.deep_copy()
    crash team.members[0]
    team.members[0].level = 99
    team.members.append(Member("alan", 1))
    team.scores.set("first", 11)
    crash shallow.members[0]
    crash shallow.scores["first"]
    crash deep.members[0]
    crash deep.scores["first"]
    var shallow_count = shallow.members.count()
    console.print(shallow_count, shallow.members[0].level, shallow.scores["first"])
    var deep_count = deep.members.count()
    console.print(deep_count, deep.members[0].level, deep.scores["first"], deep.name)
    report(deep.captain)
    var numbers = [1, 2, 3]
    var copied_numbers = numbers.deep_copy()
    numbers.append(4)
    var numbers_count = numbers.count()
    var copied_numbers_count = copied_numbers.count()
    console.print(numbers_count, copied_numbers_count)
}

func report(captain: Member?) {
    assert captain
    console.print("captain", captain.name, captain.level)
}
