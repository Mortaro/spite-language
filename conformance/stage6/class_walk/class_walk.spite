var console = Console()
var counter = WalkCounter()
var holder = WalkHolder()
var plain = WalkPlain()
var part = Parts.WalkPart()
var watcher = WalkWatcher()
var scribbler = WalkScribbler()

func ClassWalk() {
    counter.count_up()
    holder.note()
    var doubled = plain.doubled(part.size)
    var seen = watcher.seen()
    var marked = scribbler.scribble()
    console.print("ran", counter.total, doubled, seen, marked)
    var part_class = part.class
    var part_files = part_class.source_files
    var part_file = file_name(part_files)
    console.print("at run time", part_file)
    check_kinds()
}

func check_kind(kind: Symbol<Spite.Class>) {
    var name: String = kind.name
    if name.starts_with("Walk") or name.starts_with("Parts.") or name == "Console" or name == "Spite.Class" {
        var stateful = kind.class.has_state()
        var files = kind.class.source_files
        var shown = file_name(files)
        console.print(name, stateful, "'{shown}'")
    }
}

func file_name(files: List<File>): String {
    var first = files.first()
    crash first
    var parts = first.path.split("/")
    var last = parts.last()
    crash last
    return last
}
