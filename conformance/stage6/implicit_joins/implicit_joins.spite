var console = Console()
var names = List<String>()

func ImplicitJoins() {
    var greeting = Parallel(greet)
    console.print(greeting)
    var shouted = greeting.upper_case()
    var letters = greeting.length()
    console.print(shouted, letters)
    var counting = Concurrent(count_to_three)
    console.print(counting + 1, "and interpolated: {counting}")
    var total: Int = counting
    var twice = doubled(counting)
    console.print(total * 2, twice)
    names.append(greeting)
    var joined_names = names.join(",")
    var returned = later_count()
    console.print(joined_names, returned)
    var nothing_found = Parallel(find_nobody)
    if nothing_found {
        console.print(nothing_found)
    } else {
        console.print("nobody was found")
    }
    var someone = Concurrent(find_somebody)
    if someone {
        var someone_letters = someone.length()
        console.print("found", someone, "with", someone_letters, "letters")
    }
    var checked = Parallel(find_somebody)
    crash checked
    console.print("crash proved", checked)
    var ready = Parallel(is_ready)
    if ready and not not ready {
        console.print("ready is a Bool")
    }
}

func find_somebody(): String? {
    return "Ada"
}

func is_ready(): Bool {
    return true
}

func greet(): String {
    return "hello"
}

func count_to_three(): Int {
    return 3
}

func find_nobody(): String? {
    return null
}

func doubled(value: Int): Int {
    return value * 2
}

func later_count(): Int {
    var later = Parallel(count_to_three)
    return later
}
