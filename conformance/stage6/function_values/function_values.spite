var console = Console()

func FunctionValues() {
    var robot = Robot("unit")
    var functions = robot.functions
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        var arguments_count = function.arguments.count()
        console.print(function.name, arguments_count, function.returns)
        if function.name.starts_with("step_") {
            function.call_function()
        }
        index = index + 1
    }
    var joined_log = robot.log.join(",")
    console.print(joined_log)
    crash robot.functions[3]
    var describe = robot.functions[3]
    crash describe.arguments.count() == 2
    console.print(describe.arguments[0].name, describe.arguments[0].class, describe.arguments[1].class)
    describe.call_function()
    var log_count = robot.log.count()
    console.print(log_count)
    robot.set_name("renamed")
    var joined_map_name = robot.functions.map_name().join(" ")
    console.print(joined_map_name)
}
