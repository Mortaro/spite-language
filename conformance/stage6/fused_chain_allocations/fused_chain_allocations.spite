var console = Console()
var teams = List<Team>()

func FusedChainAllocations() {
    var ann = Person("ann", 34, false)
    teams.append(Team(4, true, ann))
    var dee = Person("dee", 71, true)
    teams.append(Team(5, true, dee))
    var total = 0
    var round = 0
    while round < 1000 {
        var size = teams.filter_active().sum_size()
        var counted = teams.filter_active().map_lead().count_retired()
        var adult = teams.map_lead().filter_is_adult().any_retired()
        var found = teams.filter_active().map_lead().filter_is_adult().find_by_name("dee")
        if found {
            total = total + size + counted + found.age
        }
        if adult {
            total = total + 1
        }
        round = round + 1
    }
    console.print(total)
}
