var console = Console()

func ClassAttributes() {
    var declarations = Sticker.attributes
    var index = 0
    while index < declarations.count() {
        var described = declarations[index]
        console.print(described.name, described.class, "{text_of(described)}|")
        index = index + 1
    }
    var sticker = Sticker("pinned")
    var values = sticker.attributes
    index = 0
    while index < values.count() {
        var value_text = text_of(values[index])
        console.print(value_text)
        index = index + 1
    }
}

func text_of(attribute: Spite.Attribute): String {
    assert attribute.value
    return attribute.value.to_string()
}
