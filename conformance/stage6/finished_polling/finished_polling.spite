var console = Console()
var program = Program()

func FinishedPolling() {
    var gate = Gate()
    var loading = Parallel(gate.wait_until_open)
    console.print("finished while the gate is shut:", loading.finished)
    gate.open()
    while not loading.finished {
        program.sleep(1)
    }
    console.print("finished once the gate opened:", loading.finished)
    console.print("it counted", loading)
    var napper = Gate()
    var napping = Concurrent(napper.nap)
    console.print("a napping Concurrent has finished:", napping.finished)
    while not napping.finished {
        program.sleep(1)
    }
    console.print("after polling it has finished:", napping.finished)
    console.print("it napped", napping, "milliseconds")
}
