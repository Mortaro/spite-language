var console = Console()

func SerializerSingletons() {
    var player = Player()
    player.score = 9
    var writer = JsonWriter(player)
    var text = writer.write()
    console.print(text)
    var reader = JsonReader<Player>("\{\"name\": \"bo\", \"console\": \{\"x\": 1}, \"_secret\": 1}")
    var read = reader.read()
    crash read
    read.shout()
    var packer = BinaryWriter(player)
    var bytes = packer.write()
    var byte_count = bytes.count()
    var unpacker = BinaryReader<Player>(bytes)
    var unpacked = unpacker.read()
    crash unpacked
    unpacked.shout()
    var same = packer.schema() == unpacker.schema()
    console.print(byte_count, same)
}
