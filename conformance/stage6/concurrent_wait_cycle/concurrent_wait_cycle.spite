var console = Console()
var board = Board()

func ConcurrentWaitCycle() {
    var ticker = Ticker()
    var ticking = Concurrent(ticker.tick)
    var first_worker = Worker(1)
    var second_worker = Worker(0)
    var first = Concurrent(first_worker.run)
    board.handles.append(first)
    var second = Concurrent(second_worker.run)
    board.handles.append(second)
    var total: Integer = first
    var ticks: Integer = ticking
    console.print("never printed", total, ticks)
}
