var console = Console()
var cache = TextureCache()

func SingletonGuard() {
    var loading = List<Parallel<Int>>()
    var start = 0
    while start < 8000 {
        var loader = Loader(start)
        loading.append(Parallel(loader.load_many))
        start = start + 2000
    }
    var frames = 0
    while frames < 1000 {
        cache.remember("frame texture", frames)
        frames = frames + 1
    }
    var loaded = 0
    var index = 0
    while index < loading.count() {
        var count: Int = loading.get_at(index)
        loaded = loaded + count
        index = index + 1
    }
    var known = cache.known()
    var total = cache.total_loads()
    console.print("loaded", loaded, "on the pool while", frames, "frames ran")
    console.print("the cache knows", known, "textures after", total, "loads")
}
