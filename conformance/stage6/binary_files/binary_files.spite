var console = Console()
var clock = Clock()

func BinaryFiles() {
    var store = File(".spite/binary_files.bin")
    var header = List<Byte>()
    header.append_integer(7)
    header.append_long(1234567890123)
    var saved = store.write_bytes(header)
    var record = List<Byte>()
    record.append_long(-42)
    var record_start = store.append_bytes(record)
    crash record_start
    var size = store.size()
    crash size
    console.print("wrote", saved, "appended at", record_start, "size", size)
    var read_back = store.read_bytes_at(4, 8)
    crash read_back
    var got = read_back.count()
    var stamp = read_back.read_long(0)
    crash stamp
    console.print("read", got, "bytes at 4:", stamp)
    var tail = store.read_bytes_at(record_start, 8)
    crash tail
    var appended = tail.read_long(0)
    crash appended
    console.print("the appended record:", appended)
    var past_end = store.read_bytes_at(size, 8)
    crash past_end
    var past_count = past_end.count()
    console.print("reading past the end gives", past_count, "bytes")
    var whole = store.read_bytes()
    crash whole
    var first = whole.read_integer(0)
    crash first
    var whole_count = whole.count()
    console.print("the whole file is", whole_count, "bytes, starting with", first)
    var written_at = store.modified()
    crash written_at
    var now = clock.now()
    var age = now - written_at
    var minute = Duration(60, 'seconds')
    var skew = Duration(-5, 'seconds')
    console.print("modified within the last minute:", age < minute and age > skew)
    var missing = File(".spite/binary_files_missing.bin")
    var nothing = missing.read_bytes_at(0, 8)
    var none_at_all = missing.read_bytes()
    var no_size = missing.size()
    var never = missing.modified()
    if nothing or none_at_all or no_size or never {
        console.print("a missing file was read")
    } else {
        console.print("a missing file answers null")
    }
    var empty = File(".spite/binary_files_empty.bin")
    var nothing_written = List<Byte>()
    empty.write_bytes(nothing_written)
    var no_bytes = empty.read_bytes()
    crash no_bytes
    var empty_count = no_bytes.count()
    console.print("an empty file is an empty list:", empty_count)
    empty.remove()
}
