var console = Console()
var heap = Memory.Heap()
var ints = TypedMemory<Integer>()
var longs = TypedMemory<Long>()
var clock = Clock()

func BinaryFiles() {
    var store = File(".spite-cache/binary_files.bin")
    var header = heap.allocate(12)
    ints.write_value(header, 0, 7)
    longs.write_value(header + 4, 0, 1234567890123)
    var saved = store.write_bytes(header, 12)
    var record = heap.allocate(8)
    longs.write_value(record, 0, -42)
    var record_start = store.append_bytes(record, 8)
    crash record_start
    var size = store.size()
    crash size
    console.print("wrote", saved, "appended at", record_start, "size", size)
    var read_back = heap.allocate(8)
    var got = store.read_bytes(4, 8, read_back)
    crash got
    var stamp = longs.read_value(read_back, 0)
    console.print("read", got, "bytes at 4:", stamp)
    var tail = store.read_bytes(record_start, 8, read_back)
    crash tail
    var appended = longs.read_value(read_back, 0)
    console.print("the appended record:", appended)
    var past_end = store.read_bytes(size, 8, read_back)
    crash past_end
    console.print("reading past the end gives", past_end, "bytes")
    var written_at = store.modified()
    crash written_at
    var now = clock.now()
    var age = now - written_at
    var minute = Duration(60, 'seconds')
    var skew = Duration(-5, 'seconds')
    console.print("modified within the last minute:", age < minute and age > skew)
    var missing = File(".spite-cache/binary_files_missing.bin")
    var nothing = missing.read_bytes(0, 8, read_back)
    var no_size = missing.size()
    var never = missing.modified()
    if nothing or no_size or never {
        console.print("a missing file was read")
    } else {
        console.print("a missing file answers null")
    }
    heap.free(header)
    heap.free(record)
    heap.free(read_back)
}
