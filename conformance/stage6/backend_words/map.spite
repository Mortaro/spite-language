var interface = "map"
var near = 1
var pascal = 0
var cdecl = ""
var default = "default"
var volatile = ["wind", "rain"]
var unix = true
var linux = 4
var errno = 5

func Map(extern: String, typedef: Integer) {
    interface = extern
    pascal = typedef
}

func far(signed: Integer, unsigned: Integer): Integer {
    var sizeof = signed * unsigned
    return sizeof + near + pascal
}

func short(struct: String): String {
    cdecl = struct
    return "{cdecl}!"
}

func register(for: Integer): Integer {
    var goto = for
    var case = goto * 2
    return case + linux + errno
}

func static(const: String): String {
    var restrict = const
    return "{restrict}/{interface}"
}
