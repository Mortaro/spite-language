func average_member(member: Spite.AttributeDeclaration<$element_type>): Float? {
    assert item_count != 0
    var total = 0.0
    var index = 0
    while index < item_count {
        var item = values.item_at(items, index)
        total = total + item.attributes[member]
        index = index + 1
    }
    return total / item_count
}
