var across = 0
var up = 0

func Vector(starting_across: Int, starting_up: Int) {
    across = starting_across
    up = starting_up
}

func sum(other: Vector): Vector {
    return Vector(across + other.across, up + other.up)
}

func subtract(other: Vector): Vector {
    return Vector(across - other.across, up - other.up)
}

func multiply(factor: Int): Vector {
    return Vector(across * factor, up * factor)
}

func negate(): Vector {
    return Vector(0 - across, 0 - up)
}

func equals(other: Vector): Bool {
    return across == other.across and up == other.up
}

func less_than(other: Vector): Bool {
    return across + up < other.across + other.up
}

func greater_than(other: Vector): Bool {
    return across + up > other.across + other.up
}

func get_at(index: Int): Int {
    if index == 0 {
        return across
    }
    if index == 1 {
        return up
    }
    return 0 - 1
}

func set_at(index: Int, value: Int) {
    if index == 0 {
        across = value
    }
    if index == 1 {
        up = value
    }
}

func describe(): String {
    return "({across}, {up})"
}
