var console = Console()

func Operators() {
    var first = Vector(1, 2)
    var second = Vector(3, 4)
    var total = first + second
    console.print(total.describe(), (first - second).describe(), (first * 3).describe())
    console.print((first + second + Vector(10, 10)).describe(), (-first).describe())
    console.print(first == Vector(1, 2), first != second, first < second, first >= second, first <= Vector(1, 2))
    console.print(total[0], total[1], total[7])
    total[0] = 40
    total[1] = total[0] + 2
    console.print(total.describe())
    var same = first
    var holder = Holder()
    console.print(holder == holder, same == first, Holder() == holder, holder != Holder())
}
