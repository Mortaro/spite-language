var console = Console()

func Operators() {
    var first = Displacement(1, 2)
    var second = Displacement(3, 4)
    var total = first + second
    var total_description = total.describe()
    var difference = first - second
    var difference_description = difference.describe()
    var scaled = first * 3
    var scaled_description = scaled.describe()
    console.print(total_description, difference_description, scaled_description)
    var combined = first + second + Displacement(10, 10)
    var sum_description = combined.describe()
    var negated = -first
    var negated_description = negated.describe()
    console.print(sum_description, negated_description)
    var equal_to_first = Displacement(1, 2)
    console.print(first == equal_to_first, first != second, first < second, first >= second, first <= equal_to_first)
    crash total[0] and total[1]
    var seventh_is_zero = total[7] == 0
    console.print(total[0], total[1], seventh_is_zero)
    total[0] = 40
    total[1] = total[0] + 2
    total_description = total.describe()
    console.print(total_description)
    var same = first
    var holder = Holder()
    var other_holder = Holder()
    var another_holder = Holder()
    console.print(holder == holder, same == first, other_holder == holder, holder != another_holder)
}
