var console = Console()

func GeneratedNames() {
    var pool = Pool()
    pool.allocate(3)
    pool.initialize()
    pool.make(2)
    pool.retain(4)
    pool.release(1)
    var copied = pool.copy()
    var pool_total = pool.total()
    var copied_total = copied.total()
    var name = pool.name()
    var class_of = pool.class_of()
    console.print(pool_total, copied_total, name, class_of)
    var deep_copy = pool.deep_copy()
    var deep_total = deep_copy.total()
    console.print(deep_total)
    pool.run(5)
    pool.run_waiting()
    pool.read_count()
    pool.call_run()
    pool.run_hot()
    pool.run_slot()
}
