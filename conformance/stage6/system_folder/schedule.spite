type Runnable {
    run()
}

var runners = List<Runnable>()
var console = Console()

func Schedule() {
    add_systems()
}

func add_system(system: Symbol<System>) {
    var runner = Runner<system.class>()
    runners.append(runner)
    console.print("found", system.name)
}

func tick() {
    runners.each_run()
}
