generic $system_type
generic $row_type

var system = $system_type()
var found = Vector<Integer>()

func run(first: Integer, end: Integer) {
    var entity = first
    while entity < end {
        found.clear()
        found.append(entity)
        found.append(entity)
        var row: $row_type = null
        fill_attributes(row, found)
        system.update_each(row)
        entity = entity + 1
    }
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, rows: Vector<Integer>) {
    if attribute.class.fits_vector() {
        row.attributes[attribute] = Column<attribute.class>().values[rows[attribute.index]]
    } else {
        row.attributes[attribute] = Column<attribute.class>().at(rows[attribute.index])
    }
}
