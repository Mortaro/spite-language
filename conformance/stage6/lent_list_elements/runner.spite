generic $system_type
generic $row_type

var system = $system_type()
var found = List<Integer>()

func run(first: Integer, end: Integer) {
    var entity = first
    while entity < end {
        found.clear()
        found.append(entity)
        found.append(entity)
        var row: $row_type = null
        fill_attributes(row, found)
        system.update_each(row)
        entity = entity + 1
    }
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, rows: List<Integer>) {
    if attribute.class.fits_vector() {
        crash rows[attribute.index]
        var stored_row = rows[attribute.index]
        crash Column<attribute.class>().values[stored_row]
        row.attributes[attribute] = Column<attribute.class>().values[stored_row]
    } else {
        crash rows[attribute.index]
        row.attributes[attribute] = Column<attribute.class>().at(rows[attribute.index])
    }
}
