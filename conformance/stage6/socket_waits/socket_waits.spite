var console = Console()
var server = Socket()

func SocketWaits() {
    crash server.listen_at("localhost", 47314)
    var serving = Concurrent(echo_once)
    var client = Socket()
    crash client.connect("127.0.0.1", 47314)
    var message: List<Byte> = [10, 20, 30, 40]
    crash client.write_bytes(message)
    var answer = List<Byte>()
    while answer.count() < 4 and not client.closed {
        var more = client.read_bytes()
        if more {
            var more_count = more.count()
            answer.append_bytes(more, 0, more_count)
        }
    }
    var received = answer.count()
    var last = answer[3]
    crash last
    console.print("the client read back", received, "bytes, the last", last)
    var line = client.read_line()
    if not line {
        console.print("no line: the server closed", client.closed)
    }
    console.print("the server echoed", serving, "bytes")
    client.close()
    server.close()
}

func echo_once(): Integer {
    var peer = server.accept_client()
    crash peer
    var buffer = List<Byte>()
    while buffer.count() < 4 and not peer.closed {
        var more = peer.read_bytes()
        if more {
            var more_count = more.count()
            buffer.append_bytes(more, 0, more_count)
        }
    }
    var echoed = peer.write_bytes(buffer)
    peer.close()
    if echoed {
        return buffer.count()
    }
    return 0
}
