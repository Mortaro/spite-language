var console = Console()

func VectorItems() {
    var velocities = Vector<Velocity>()
    var first = Velocity(1.0, 2.0, "first")
    velocities.append(first)
    var second = Velocity(3.0, 4.0, "second")
    velocities.append(second)
    var index = 0
    while index < 10 {
        var more = Velocity(0.5, 0.25, "more")
        velocities.append(more)
        index = index + 1
    }
    var velocity = velocities[1]
    velocity.across = 30.0
    console.print(velocity.name, velocity.across, velocities[1].across, second.across)
    velocities[0].down = 20.0
    velocities.each_integrate()
    var total = velocities.sum_across()
    var moving = velocities.count_moving()
    var velocity_count = velocities.count()
    console.print("total", total, "moving", moving, "count", velocity_count)
    var kept = velocities[2].copy()
    velocities.remove_at(0)
    velocity_count = velocities.count()
    console.print(velocities[0].name, velocities[0].across, kept.name, velocity_count)
    var probe_index = 0
    while probe_index < velocities.count() {
        var probed = velocities[probe_index]
        probed.down = probed.down + probe_index
        probe_index = probe_index + 1
    }
    var names = velocities.map_name()
    var name_count = names.count()
    crash names[0]
    console.print(name_count, names[0])
    var all_moving = velocities.all_moving()
    var any_fast = velocities.any_moving()
    console.print("all", all_moving, "any", any_fast)
    var chained = velocities.filter_moving().sum_down()
    var chained_count = velocities.filter_moving().count_moving()
    var chained_names = velocities.filter_moving().map_name()
    var copied = velocities.filter_moving().filter_moving()
    var copied_count = copied.count()
    var chained_name_count = chained_names.count()
    console.print("chained", chained, chained_count, chained_name_count, copied_count)
    velocities.filter_moving().each_integrate()
    velocities.parallel_each_integrate()
    var replacement = Velocity(5.0, 6.0, "replacement")
    velocities[0] = replacement
    velocities[0].name = "renamed"
    var renamed = velocities[0]
    console.print(renamed.name, renamed.across, replacement.name)
    var whole = velocities.copy()
    velocities.clear()
    velocity_count = whole.count()
    var whole_total = whole.sum_across()
    console.print("copy", velocity_count, whole_total)
    velocity_count = velocities.count()
    console.print("cleared", velocity_count)
    kept_in_an_arena(first)
    values_inline()
}

func kept_in_an_arena(item: Velocity) {
    var arena = Memory.Arena(4096)
    var placed = Vector<Velocity>()
    placed.memory.allocator = arena
    placed.append(item)
    var placed_count = placed.count()
    console.print("in an arena", placed_count)
}

func values_inline() {
    var words = Vector<String>()
    words.append("alpha")
    words.append("beta")
    words.remove_at(0)
    var word = words[0]
    var word_count = words.count()
    var numbers = Vector<Float>()
    numbers.append(1.5)
    numbers.append(2.5)
    numbers[0] = 4.0
    var number = numbers[0]
    console.print(word, word_count, number)
}
