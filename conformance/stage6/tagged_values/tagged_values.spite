enum Level {
    'low'
    'high'
}

var console = Console()
var kinds = List<String>()

func TaggedValues() {
    var count = 3
    var total: Long = 40000000000
    var ratio = 0.5
    var level: Level = 'high'
    console.print(count, total, ratio, true, level)
    var held = List<Anything>()
    held.append(count)
    held.append(total)
    held.append(level)
    held.append(true)
    var crate = Crate()
    held.append(crate)
    held.each(add_kind)
    var joined = kinds.join(" ")
    console.print(joined)
    var first: Anything? = held.first()
    if first == Integer {
        var doubled = first * 2
        console.print("first doubled", doubled)
    }
    console.debug(count, level, crate)
}

func add_kind(item: Anything) {
    if item == Integer {
        kinds.append("integer {item}")
    } else if item == Long {
        kinds.append("long")
    } else if item == Boolean {
        kinds.append("boolean")
    } else {
        kinds.append("object")
    }
}
