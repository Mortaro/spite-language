var console = Console()
var time_text = TimeText()

func TimeTextErrors() {
    refuse_instant("2024-03-10T07:00:00")
    refuse_instant("2024-03-10")
    refuse_instant("2024-02-30T00:00:00Z")
    refuse_instant("2024-03-10T24:00:00Z")
    refuse_instant("2024-03-10T07:00:00+24:00")
    refuse_instant("2024-03-10T07:00:00Z junk")
    refuse_instant("2024-03-10T07:00:00Z[America/New_York")
    refuse_instant("-000000-01-01T00:00:00Z")
    refuse_instant("")
    refuse_date_time("2024-03-10T02:30:00Z")
    refuse_date_time("2024-3-10T02:30")
    refuse_date_time("2024-03-10T2:30")
    refuse_date("2023-02-29")
    refuse_date("2024-13-01")
    refuse_date("2024-00-10")
    refuse_date("20240310")
    refuse_date("2024-04-31")
    refuse_time("25:00")
    refuse_time("12:60")
    refuse_time("12:30:00.1234567890")
    refuse_time("12")
    refuse_time("12:30:00.")
    refuse_duration("P1D")
    refuse_duration("PT")
    refuse_duration("P")
    refuse_duration("PT1.5H")
    refuse_duration("PT1S2M")
    refuse_duration("1H")
    refuse_duration("PT1H1H")
    refuse_period("PT1H")
    refuse_period("P")
    refuse_period("P1D2M")
    refuse_period("P1.5Y")
    refuse_period("P1Y1Y")
}

func refuse_instant(text: String) {
    var read = time_text.read_instant(text)
    if read {
        console.print("instant '{text}' was read as", read)
    } else {
        console.print("instant '{text}' is refused")
    }
}

func refuse_date_time(text: String) {
    var read = time_text.read_date_time(text)
    if read {
        console.print("date and time '{text}' was read as", read)
    } else {
        console.print("date and time '{text}' is refused")
    }
}

func refuse_date(text: String) {
    var read = time_text.read_date(text)
    if read {
        console.print("date '{text}' was read as", read)
    } else {
        console.print("date '{text}' is refused")
    }
}

func refuse_time(text: String) {
    var read = time_text.read_time(text)
    if read {
        console.print("time '{text}' was read as", read)
    } else {
        console.print("time '{text}' is refused")
    }
}

func refuse_duration(text: String) {
    var read = time_text.read_duration(text)
    if read {
        console.print("duration '{text}' was read as", read)
    } else {
        console.print("duration '{text}' is refused")
    }
}

func refuse_period(text: String) {
    var read = time_text.read_period(text)
    if read {
        console.print("period '{text}' was read as", read)
    } else {
        console.print("period '{text}' is refused")
    }
}
