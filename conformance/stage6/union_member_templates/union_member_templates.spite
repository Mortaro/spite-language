var console = Console()

func UnionMemberTemplates() {
    var folder = Directory("conformance/stage6/union_member_templates/tree")
    var entries = folder.entries()
    var names = entries.map_names()
    var joined_names = names.join(",")
    console.print("entries:", joined_names)
    var texts = entries.filter_name_ends_with(".txt")
    var text_count = texts.count()
    console.print("text files:", text_count)
    var files = entries.filter_files()
    var first = files.first()
    crash first
    var content = first.read()
    crash content
    var trimmed = content.trim()
    console.print("first file:", first.name, trimmed)
    var directories = entries.filter_directories()
    var inner = directories.first()
    crash inner
    var directory_count = directories.count()
    console.print("folders:", directory_count, inner.name)
    var file_count = entries.count_files()
    var any_folder = entries.any_directories()
    var all_files = entries.all_files()
    console.print("by class:", file_count, any_folder, all_files)
    entries.remove_where_directories()
    var left = entries.count()
    var only_files = entries.all_files()
    console.print("without folders:", left, only_files)
    var tasks = Dictionary<String, Task>()
    var sweep = Task("sweep", true)
    tasks["sweep"] = sweep
    var cook = Task("cook", false)
    tasks["cook"] = cook
    var done_count = tasks.count_done()
    var finished = tasks.filter_is_done()
    var finished_count = finished.count()
    console.print("done:", done_count, finished_count)
}
