func collect(handle: Concurrent<String>): String {
    var found = handle.finished_value()
    if found {
        return found
    }
    return ""
}

func join(handle: Concurrent<String>): String {
    return handle
}

func total(counting: Parallel<Integer>, _slot: Spite.Internal.ThreadSlot, _guard: Spite.Internal.Lock): Integer {
    return counting
}
