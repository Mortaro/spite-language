var console = Console()

func Reflection() {
    var monster = Creatures.Monster("rat", 7)
    crash monster.class.namespace
    console.print(monster.class, monster.class.name, "{monster.class.namespace.name_with_namespaces}|")
    var attributes = monster.attributes
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        console.print(attribute.name, attribute.class, "{text_of(attribute)}|")
        index = index + 1
    }
    var joined_map_name = monster.attributes.map_names().join(",")
    console.print(joined_map_name)
    var kind_of_health = monster.kind_of_health()
    var kind_of_name = monster.kind_of_name()
    var kind_of_friends = monster.kind_of_friends()
    console.print(kind_of_health, kind_of_name, kind_of_friends)
    var count = 3
    var class_name_text = console_class_name()
    console.print(count.class, "text".class, class_name_text)
}

func console_class_name(): String {
    var reflection = Reflection2()
    return reflection.class.name
}

func text_of(attribute: Spite.Attribute): String {
    if not attribute.value {
        return ""
    }
    return attribute.value.to_string()
}
