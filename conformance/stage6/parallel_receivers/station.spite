singleton

var memory = Memory()
var shared: Long = 0
var thread: Parallel<Nothing>? = null
var pump: Siphon? = null

func start() {
    shared = memory.allocate_bytes(16)
    memory.write_long_atomically(shared, 0, 0)
    memory.write_long_atomically(shared, 8, 0)
    var created = Siphon(shared)
    pump = created
    var started = Parallel(created.run)
    thread = started
}

func pumped(): Long {
    return memory.read_long_atomically(shared, 8)
}

func stop() {
    assert thread and pump
    memory.write_long_atomically(shared, 0, 1)
    thread = null
}

func drop() {
    memory.free(shared)
}
