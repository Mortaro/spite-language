var x: Float = 0.0
var y: Float = 0.0

func Point(starting_x: Float, starting_y: Float) {
    x = starting_x
    y = starting_y
}

func sum(other: Point): Point {
    return Point(x + other.x, y + other.y)
}

func scaled(factor: Float): Point {
    return Point(x * factor, y * factor)
}

func negate(): Point {
    return Point(-x, -y)
}

func turned(): Point {
    var result = Point(0.0, 0.0)
    result.x = -y
    result.y = x
    return result
}

func length_squared(): Float {
    return x * x + y * y
}

func move_by(offset: Point) {
    x = x + offset.x
    y = y + offset.y
}

func to_string(): String {
    return "({x}, {y})"
}
