generic $item_type: Printable

var items = List<$item_type>()

func add(item: $item_type) {
    items.append(item)
}

func describe(): String {
    var texts = List<String>()
    var index = 0
    while index < items.count() {
        var text = items[index].to_string()
        texts.append(text)
        index = index + 1
    }
    return texts.join(", ")
}
