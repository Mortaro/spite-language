var console = Console()
var kept = List<Monster>()

func LiveInstances() {
    var instances_count = Monster.instances.count()
    console.print(instances_count)
    kept.append(Monster("rat"))
    kept.append(Monster("bat"))
    spawn_and_forget()
    instances_count = Monster.instances.count()
    var joined_map_name = Monster.instances.map_name().join(",")
    console.print(instances_count, joined_map_name)
    crash kept[0]
    var copied = kept[0].copy()
    copied.name = "copy of rat"
    instances_count = Monster.instances.count()
    var newest = Monster.instances.last()
    crash newest
    var name = newest.name
    console.print(instances_count, name)
    kept.clear()
    instances_count = Monster.instances.count()
    var oldest = Monster.instances.first()
    crash oldest
    var first_name = oldest.name
    console.print(instances_count, first_name)
}

func spawn_and_forget() {
    var temporary = Monster("ghost")
    var instances_count = Monster.instances.count()
    console.print("while alive:", instances_count, temporary.name)
}
