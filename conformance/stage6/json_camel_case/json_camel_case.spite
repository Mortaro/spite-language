var console = Console()

func JsonCamelCase() {
    var camel_reader = JsonReader<ItemRecord>(
        "\{\"Name\": \"potion\", \"buyPrice\": 30, \"SellPriceEach\": 7.5, \"isStackable\": true, \"noSuchKey\": [1]}",
    )
    var camel = camel_reader.read()
    crash camel
    console.print(camel.name, camel.buy_price, camel.sell_price_each, camel.is_stackable)
    var both_reader = JsonReader<ItemRecord>("\{\"buy_price\": 1, \"buyPrice\": 2}")
    var both = both_reader.read()
    crash both
    console.print(both.buy_price)
    var list_reader = JsonReader<List<ItemRecord>>("[\{\"buyPrice\": 4}, \{\"buy_price\": 5}]")
    var records = list_reader.read()
    crash records
    var prices = records.map_buy_price()
    var joined = prices.join(" ")
    console.print(joined)
    var writer = JsonWriter(camel)
    var text = writer.write()
    console.print(text)
}
