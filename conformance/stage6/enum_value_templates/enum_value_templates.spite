var console = Console()

func EnumValueTemplates() {
    var posts = List<Post>()
    var first = Post("hello", 'published')
    posts.append(first)
    var second = Post("plans", 'draft')
    posts.append(second)
    var third = Post("old", 'archived')
    posts.append(third)
    var fourth = Post("news", 'published')
    posts.append(fourth)
    var published = posts.filter_published()
    var titles = published.map_titles()
    var joined = titles.join(", ")
    console.print("published:", joined)
    var drafts = posts.count_draft()
    var anything_archived = posts.any_archived()
    var all_published = posts.all_published()
    console.print("drafts:", drafts, "archived:", anything_archived, "all published:", all_published)
    posts.remove_where_archived()
    var left = posts.count()
    console.print("left:", left)
    var pets = List<Pet>()
    var cat = Cat()
    pets.append(cat)
    var dog = Dog()
    dog.barks = 5
    pets.append(dog)
    var calm = pets.count_calm()
    var angry = pets.filter_angry()
    var angry_count = angry.count()
    console.print("calm:", calm, "angry:", angry_count)
    var shelf = Dictionary<String, Post>()
    shelf["first"] = first
    shelf["second"] = second
    var shelved = shelf.count_published()
    console.print("shelved and published:", shelved)
}
