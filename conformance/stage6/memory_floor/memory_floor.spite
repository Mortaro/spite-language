var console = Console()
var measurer = DynamicLibrary("conformance/stage6/memory_floor/fixture.dll", 'identity', "")
var memory = Memory()

func MemoryFloor() {
    run()
    widths()
}

func run() {
    var word = "spite"
    var word_length = word.length()
    var address = memory.allocate_bytes(word_length + 1)
    var index = 0
    while index < word.length() {
        var code = word.code_at(index)
        memory.write_byte(address, index, code)
        index = index + 1
    }
    memory.write_byte(address, word_length, 0)
    var measure_as_long = measurer.measure_as_long(address)
    var text = memory.text(address, word_length)
    console.print(measure_as_long, text)
    memory.write_long(address, 0, 5000000000)
    var stored_number = memory.read_long(address, 0)
    var stored_byte = memory.read_byte(address, 5)
    console.print(stored_number, stored_byte)
    var copy = memory.allocate_bytes(8)
    memory.copy_bytes(address, copy, 8)
    var copied_number = memory.read_long(copy, 0)
    console.print(copied_number == 5000000000)
    memory.free(copy)
    memory.free(address)
}

func widths() {
    var address = memory.allocate_bytes(12)
    memory.write_float(address, 0, 1.5)
    memory.write_short(address, 4, -2)
    memory.write_unsigned_int(address, 8, 4000000000)
    var stored_float = memory.read_float(address, 0)
    var float_bits = memory.read_int(address, 0)
    console.print(stored_float, float_bits)
    var stored_short = memory.read_short(address, 4)
    var short_bits = memory.read_unsigned_short(address, 4)
    console.print(stored_short, short_bits)
    memory.write_unsigned_short(address, 6, 65535)
    var stored_unsigned_short = memory.read_unsigned_short(address, 6)
    var stored_unsigned = memory.read_unsigned_int(address, 8)
    var unsigned_bits = memory.read_int(address, 8)
    console.print(stored_unsigned_short, stored_unsigned, unsigned_bits)
    memory.free(address)
}
