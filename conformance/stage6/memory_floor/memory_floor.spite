var console = Console()
var measurer = DynamicLibrary("conformance/stage6/memory_floor/fixture.dll", 'identity', "")
var heap = Memory.Heap()
var bytes = TypedMemory<Byte>()
var longs = TypedMemory<Long>()
var ints = TypedMemory<Integer>()

func MemoryFloor() {
    run()
    widths()
}

func run() {
    var word = "spite"
    var word_length = word.length()
    var address = heap.allocate(word_length + 1)
    var index = 0
    while index < word.length() {
        var code = word.code_at(index)
        bytes.write_value(address, index, code)
        index = index + 1
    }
    bytes.write_value(address, word_length, 0)
    var measure_as_long = measurer.measure_as_long(address)
    var text = address.text(word_length)
    console.print(measure_as_long, text)
    longs.write_value(address, 0, 5000000000)
    var stored_number = longs.read_value(address, 0)
    var stored_byte = bytes.read_value(address, 5)
    console.print(stored_number, stored_byte)
    var copy = heap.allocate(8)
    address.copy_to(copy, 8)
    var copied_number = longs.read_value(copy, 0)
    console.print(copied_number == 5000000000)
    heap.free(copy)
    heap.free(address)
}

func widths() {
    var floats = TypedMemory<Float>()
    var shorts = TypedMemory<Short>()
    var unsigned_shorts = TypedMemory<UnsignedShort>()
    var unsigned_ints = TypedMemory<UnsignedInteger>()
    var address = heap.allocate(12)
    floats.write_value(address, 0, 1.5)
    shorts.write_value(address, 2, -2)
    unsigned_ints.write_value(address, 2, 4000000000)
    var stored_float = floats.read_value(address, 0)
    var float_bits = ints.read_value(address, 0)
    console.print(stored_float, float_bits)
    var stored_short = shorts.read_value(address, 2)
    var short_bits = unsigned_shorts.read_value(address, 2)
    console.print(stored_short, short_bits)
    unsigned_shorts.write_value(address, 3, 65535)
    var stored_unsigned_short = unsigned_shorts.read_value(address, 3)
    var stored_unsigned = unsigned_ints.read_value(address, 2)
    var unsigned_bits = ints.read_value(address, 2)
    console.print(stored_unsigned_short, stored_unsigned, unsigned_bits)
    heap.free(address)
}
