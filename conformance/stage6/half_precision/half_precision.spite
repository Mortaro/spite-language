var console = Console()

func HalfPrecision() {
    var values = [
        1.0
        -2.0
        0.1
        65504.0
        65519.0
        65520.0
        100000.0
        0.00006103515625
        0.000000059604645
        0.00000002
        0.0
        -0.0
        0.33333334
    ]
    values.each(show)
    var infinite = Float.infinity()
    show(infinite)
    var nothing = Float.not_a_number()
    show(nothing)
    var one: Float = 1.0
    console.print("bits of 1.0 {one.bits()}")
    var pattern: UnsignedInteger = 1078530011
    console.print("1078530011 as a Float {pattern.bits_as_float()}")
    var wide: Double = -1.5
    var wide_bits = wide.bits()
    var unsigned_bits: UnsignedLong = 4609434218613702656
    console.print("bits of -1.5 {wide_bits}, back {wide_bits.bits_as_double()}, {unsigned_bits.bits_as_double()}")
}

func show(value: Float) {
    var half = value.to_half_precision()
    var back = half.half_precision_to_float()
    console.print("{value} is {half}, back {back}")
}
