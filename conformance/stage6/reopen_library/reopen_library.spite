var console = Console()

func ReopenLibrary() {
    var monster = Monster("rat")
    var rat = Creatures.Rat(2)
    console.print(monster.class.name_with_namespaces(), rat.class.name_with_namespaces())
    var classes = Spite.Class.instances
    var index = 0
    while index < classes.count() {
        console.print(classes[index].name_with_namespaces())
        index = index + 1
    }
}
