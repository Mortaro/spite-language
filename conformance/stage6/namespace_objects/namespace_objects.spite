var console = Console()

func NamespaceObjects() {
    var gadget = Pack.Widgets.Gadget()
    var second_gadget = Pack.Widgets.Gadget()
    var cog = Pack.Widgets.Cog()
    var gear = Pack.Gear()
    console.print(gadget.class.name, second_gadget.class.name, cog.class.name, gear.class.name)
    crash gadget.class.namespace
    crash second_gadget.class.namespace
    crash gear.class.namespace
    console.print(gadget.class.namespace.name_with_namespaces, gadget.class.namespace.name)
    console.print(gear.class.namespace.name_with_namespaces, gear.class.namespace.name)
    crash gadget.class.namespace.parent
    console.print(gadget.class.namespace.parent.name)
    crash gadget.class.namespace == second_gadget.class.namespace
    if gadget.class.namespace == gear.class.namespace {
        crash
    }
    console.print(gadget.class.namespace.parent.name_with_namespaces, gadget.class.namespace.parent.name)
    if gadget.class.namespace.parent.parent {
        crash
    }
    console.print(gadget.class.namespace)
    var tree_classes = gadget.class.namespace.classes
    crash tree_classes.find_by_name('Cog')
    var tree_classes_count = tree_classes.count()
    console.print(tree_classes_count)
    var child_namespaces = gadget.class.namespace.parent.namespaces
    crash child_namespaces.find_by_name('Widgets')
    var child_namespaces_count = child_namespaces.count()
    console.print(child_namespaces_count)
}
