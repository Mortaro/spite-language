var console = Console()
var pool = ThreadPool()

func ParallelEach() {
    var particles = List<Particle>()
    var index = 0
    while index < 10000 {
        var particle = Particle(index)
        particles.append(particle)
        index = index + 1
    }
    particles.parallel_each_step()
    particles.parallel_each_step()
    var moved = particles.sum_position()
    console.print("after two steps the positions add up to", moved)
    particles.filter_awake().parallel_each_step()
    var after_filter = particles.sum_position()
    console.print("after a step of the awake ones only", after_filter)
    var workers = particles.map_workers()
    var distinct = List<Integer>()
    index = 0
    while index < workers.count() {
        var worker = workers[index]
        if not distinct.contains(worker) {
            distinct.append(worker)
        }
        index = index + 1
    }
    var size = pool.size()
    var distinct_count = distinct.count()
    console.print("every element ran on a pool worker or on this thread:", distinct_count <= size + 1)
    var few = List<Particle>()
    var only_particle = Particle(1)
    few.append(only_particle)
    few.parallel_each_step()
    var empty = List<Particle>()
    empty.parallel_each_step()
    var few_moved = few.sum_position()
    var empty_moved = empty.sum_position()
    console.print("a list of one and an empty list:", few_moved, empty_moved)
}
