var console = Console()
var transforms = Column<Transform>()

func SingletonReads() {
    add_rows(0, 2000)
    var first = Reader(2000)
    var first_run = Parallel(first.run)
    var second = Reader(2000)
    var second_run = Parallel(second.run)
    var third = Reader(2000)
    var third_run = Parallel(third.run)
    add_rows(2000, 6000)
    var read: Integer = first_run + second_run + third_run
    var last = Reader(6000)
    var everything: Integer = last.run()
    console.print("three readers saw", read, "while rows were added, and all rows add up to", everything)
}

func add_rows(first: Integer, end: Integer) {
    var row = first
    while row < end {
        var transform = Transform(row)
        transforms.insert(transform)
        row = row + 1
    }
}
