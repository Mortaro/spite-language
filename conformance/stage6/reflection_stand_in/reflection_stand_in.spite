var console = Console()

func ReflectionStandIn() {
    var gadget = Gadget("wrench")
    var fields = gadget.class.attributes
    var field_count = fields.count()
    var functions = Gadget.functions
    var function_count = functions.count()
    var instances = Gadget.instances.count()
    console.print(gadget.name, field_count, function_count, instances)
    var console_functions = console.class.functions
    var console_function_count = console_functions.count()
    var console_fields = console.class.attributes
    var console_field_count = console_fields.count()
    console.print(console_function_count > 3, console_field_count > 0)
}
