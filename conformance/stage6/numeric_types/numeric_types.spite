var console = Console()
var level: Tiny = 100
var port: UnsignedShort = 8080

func NumericTypes() {
    var wrapped: Tiny = 200
    var small: Short = 40000
    var octet: Byte = 300
    var wide: UnsignedInteger = 0 - 1
    var huge: UnsignedLong = 0 - 1
    var long_value: Long = 3000000000
    console.print(level, wrapped, small, octet, port)
    console.print(wide, huge, long_value)
    var level_wide: Integer = level
    var total = level_wide + octet
    var ratio: Double = 1.5
    var rounded: Short = ratio * 3
    var added_bytes = add_bytes(250, 10)
    console.print(total, rounded, "port {port}", added_bytes)
    var ports = List<UnsignedShort>()
    ports.append(port)
    ports.append(70000)
    crash ports.count() == 2
    var ports_count = ports.count()
    console.print(ports[0], ports[1], ports_count)
}

func add_bytes(first: Byte, second: Byte): Byte {
    return first + second
}
