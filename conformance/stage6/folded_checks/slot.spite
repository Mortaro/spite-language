generic $slot_type

var console = Console()

func entity_only(): String {
    if $slot_type != Entity {
        return ""
    }
    return "an entity"
}

func fits(): Boolean {
    crash $slot_type.fits_vector() and not $slot_type.has_function("drop_all")
    return true
}

func one_row(): Integer {
    if not $slot_type.has_function("update_each") or $slot_type.argument_count("update_each") != 1 {
        return 0
    }
    return 1
}

func report() {
    assert not $slot_type.function_waits("update_each")
    console.print("does not wait")
}

func identity(value: $slot_type): Integer {
    if $slot_type != Entity {
        return 0
    }
    return value.id
}
