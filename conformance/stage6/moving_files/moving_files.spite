var console = Console()

func MovingFiles() {
    var folder = Directory(".spite/conformance_moving")
    folder.create()
    var inner = Directory(".spite/conformance_moving/inner")
    inner.create()
    var note = File(".spite/conformance_moving/note.txt")
    note.write("hello")
    var renamed = note.move_to(".spite/conformance_moving/renamed.txt")
    var old_note = File(".spite/conformance_moving/note.txt")
    var old_exists = old_note.exists()
    console.print(renamed, old_exists, note.name)
    var moved = note.move_to(".spite/conformance_moving/inner/renamed.txt")
    var content = note.read()
    crash content
    console.print(moved, content)
    var blocker = File(".spite/conformance_moving/blocker.txt")
    blocker.write("in the way")
    var refused = note.move_to(".spite/conformance_moving/blocker.txt")
    var kept = blocker.read()
    crash kept
    console.print(refused, kept, note.name)
    var folder_moved = inner.move_to(".spite/conformance_moving/outer")
    var through = File(".spite/conformance_moving/outer/renamed.txt")
    var through_exists = through.exists()
    console.print(folder_moved, through_exists, inner.name)
    var missing = File(".spite/conformance_moving/missing.txt")
    var nothing_moved = missing.move_to(".spite/conformance_moving/anywhere.txt")
    console.print(nothing_moved)
    through.remove()
    blocker.remove()
    inner.move_to(".spite/conformance_moving/inner")
}
