var console = Console()

func MustWriteScratch() {
    load "scratch"
    var scratch = Scratch()
    var prepared = prepare(scratch)
    console.print("prepared", prepared)
    var checked = check(scratch)
    console.print("checked", checked)
    console.print("after check", scratch.marks, scratch.ready)
    report(scratch)
    var early_answer = early(scratch, false)
    var both = both_ways(scratch, true)
    guarded(scratch, 2)
    console.print("more", early_answer, both, scratch.marks, scratch.ready)
}

func early(scratch: Scratch, wanted: Boolean): Boolean {
    scratch.marks = 3
    if wanted {
        return true
    }
    return false
}

func both_ways(scratch: Scratch, wanted: Boolean): Boolean {
    if wanted {
        scratch.marks = 5
        scratch.ready = true
    } else {
        scratch.marks = 6
    }
    return true
}

func guarded(scratch: Scratch, times: Integer) {
    assert times > 0
    var index = 0
    while index < times {
        scratch.ready = false
        index = index + 1
    }
    scratch.marks = times
}

func prepare(scratch: Scratch): Boolean {
    scratch.marks = 3
    return true
}

func check(scratch: Scratch): Boolean {
    if scratch.marks == 0 {
        return false
    }
    scratch.ready = true
    return true
}

func often_not(scratch: Scratch, wanted: Boolean): Boolean {
    if wanted {
        scratch.marks = 9
        return true
    }
    return false
}

func counted(scratch: Scratch, times: Integer) {
    var index = 0
    while index < times {
        scratch.marks = scratch.marks + 1
        index = index + 1
    }
}

func report(scratch: Scratch) {
    var wanted = often_not(scratch, true)
    var unwanted = often_not(scratch, false)
    counted(scratch, 4)
    console.print("flags", wanted, unwanted)
    console.print("final", scratch.marks, scratch.ready)
}
