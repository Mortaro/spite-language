var console = Console()
var watch = StageWatch()
var connection = Socket()

func update_each() {
    var reads = 0
    while reads < 3 {
        var received = connection.read_bytes()
        crash received
        watch.note_resumed()
        var index = 0
        while index < received.count() {
            var value = received[index]
            console.print("the reader received", value)
            reads = reads + 1
            index = index + 1
        }
    }
}
