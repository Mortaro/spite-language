var console = Console()

func Accessors() {
    var account = Account("ada")
    account.balance = 50
    account.balance = 0 - 20
    var owner_length = account.owner.length()
    console.print(account.balance, account.owner, owner_length)
    account.owner = "grace"
    var joined_history = account.history.join(",")
    console.print(account.owner, joined_history)
    var plain = Plain()
    plain.label = "direct"
    plain.size = plain.size + 2
    console.print(plain.label, plain.size)
    var owner = make_account().owner
    var balance = make_account().balance
    console.print(owner, balance)
}

func make_account(): Account {
    var account = Account("temporary")
    account.balance = 9
    return account
}
