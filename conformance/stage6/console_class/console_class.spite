var console = Console()

func ConsoleClass() {
    var another = Console()
    var containing = console.class.namespace
    var namespace_text = ""
    if containing {
        namespace_text = containing.name_with_namespaces
    }
    console.print(console == another, console.class.name, "{namespace_text}|")
    another.write("written")
    another.write(" and written again")
    console.print("")
    var greeter = Greeter()
    greeter.greet()
    Console().print("a Console made on the spot prints too")
}
