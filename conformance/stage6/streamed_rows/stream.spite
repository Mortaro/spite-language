generic $system_type
generic $row_type

enum Phase {
    'update'
}

var found = List<Integer>()

func run(system: $system_type, entity_count: Integer) {
    run_phases_each(system, entity_count)
}

func run_phase_each(phase: Symbol<$system_type.phase_each>, system: $system_type, entity_count: Integer) {
    var entity = 0
    while entity < entity_count {
        found.clear()
        find_attributes(entity)
        system.phase_each(streamed_arguments(found))
        entity = entity + 1
    }
}

func find_attribute(attribute: Symbol<$row_type>, entity: Integer) {
    var column = Column<attribute.class>()
    var dense = column.dense_index(entity)
    found.append(dense)
}

func streamed_argument(argument: Symbol<$system_type.phase_each>, rows: List<Integer>): argument.class {
    if argument.class == $row_type {
        var row: $row_type = null
        fill_attributes(row, rows)
        return row
    }
    var other: argument.class = null
    return other
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, rows: List<Integer>) {
    crash rows[attribute.index]
    crash Column<attribute.class>().values[rows[attribute.index]]
    row.attributes[attribute] = Column<attribute.class>().values[rows[attribute.index]]
}
