var console = Console()

func Singletons() {
    var first = Journal()
    first.record("from the entry")
    var worker = Worker()
    worker.work()
    var again = Journal()
    console.print(again.entries.join(", "), first == again, again.opened)
    var plain_one = Worker()
    console.print(plain_one == worker)
    var reader = JournalReader()
    reader.report(first.class)
    reader.report(worker.class)
}
