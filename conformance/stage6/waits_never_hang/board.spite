singleton

var handles = List<Concurrent<Integer>>()
var ready = false
var starters = List<Concurrent<Integer>>()
var readers = List<Concurrent<Integer>>()

func value_of(index: Integer): Integer {
    crash handles[index]
    var handle = handles[index]
    var value: Integer = handle
    return value
}

func starter_value(): Integer {
    crash starters[0]
    var starter = starters[0]
    var value: Integer = starter
    return value
}

func reader_value(): Integer {
    crash readers[0]
    var reader = readers[0]
    var value: Integer = reader
    return value
}
