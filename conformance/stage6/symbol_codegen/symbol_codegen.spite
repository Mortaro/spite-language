var console = Console()

func SymbolCodegen() {
    var person = Person("Ada", 36)
    person.set_age(37)
    person.set_name("Ada Lovelace")
    var person_name = person.get_name()
    var person_age = person.get_age()
    console.print(person_name, person_age)
    var describe_age = person.describe_age()
    var describe_name = person.describe_name()
    console.print(describe_age, describe_name)
    person.set_tags(["math", "engines"])
    var joined_tags = person.get_tags().join("+")
    console.print(joined_tags)
    person.birthday()
    person_age = person.get_age()
    console.print(person_age)
}
