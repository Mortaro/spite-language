var console = Console()

func SymbolCodegen() {
    var person = Person("Ada", 36)
    person.set_age(37)
    person.set_name("Ada Lovelace")
    console.print(person.get_name(), person.get_age())
    console.print(person.describe_age(), person.describe_name())
    person.set_tags(["math", "engines"])
    console.print(person.get_tags().join("+"))
    person.birthday()
    console.print(person.get_age())
}
