var console = Console()
var points = List<Point>()

func ClassPools() {
    var maker = Maker(1000)
    var marked = Parallel(maker.total)
    var total = 0
    var letters = 0
    var round = 0
    while round < 3 {
        letters = letters + fill(1000 + round * 500)
        total = total + sum()
        points.clear()
        round = round + 1
    }
    var kept = Point(7, 8)
    points.append(kept)
    total = total + sum()
    var left = points.count()
    console.print("total", total, "letters", letters, "points", left, "marked", marked)
}

func fill(count: Integer): Integer {
    var letters = 0
    var index = 0
    while index < count {
        var point = Point(index, index * 2)
        points.append(point)
        var label = Label("between")
        letters = letters + label.text.length()
        index = index + 1
    }
    return letters
}

func sum(): Integer {
    var total = 0
    var index = 0
    while index < points.count() {
        var point = points[index]
        total = total + point.across + point.down
        index = index + 1
    }
    return total
}
