var console = Console()
var cookbook = Recipes.Cookbook()

func NestedTypeFromOutside() {
    var soup = Recipes.Soup()
    cookbook.add(soup)
    var bread = Recipes.Bread()
    cookbook.add(bread)
    var task = Recipes.CookTask(cookbook.recipes)
    var task_soup = Recipes.Soup()
    task.add(task_soup)
    task.run()
    var cooked = task.recipes.count()
    console.print("cooked", cooked, "recipes")
}
