var console = Console()
var time_text = TimeText()

func TimeTextRoundTrips() {
    instant_round_trip("2024-03-10T07:00:00Z")
    instant_round_trip("2024-03-10T07:00:00.5Z")
    instant_round_trip("1969-12-31T23:59:59.999999999Z")
    instant_round_trip("0001-01-01T00:00:00Z")
    instant_round_trip("+010000-01-01T00:00:00Z")
    date_round_trip("2024-02-29")
    date_round_trip("0000-01-01")
    date_round_trip("-000001-12-31")
    date_round_trip("+012345-06-07")
    time_round_trip("00:00:00")
    time_round_trip("23:59:59.999999999")
    time_round_trip("12:30:00.25")
    date_time_round_trip("2024-03-10T02:30:00")
    date_time_round_trip("1970-01-01T00:00:00.000001")
    duration_round_trip("PT0S")
    duration_round_trip("PT1H30M")
    duration_round_trip("-PT0.5S")
    duration_round_trip("PT36H")
    duration_round_trip("PT1M0.000000001S")
    period_round_trip("P0D")
    period_round_trip("P1Y2M3D")
    period_round_trip("P14D")
    period_round_trip("P-1M")
    period_round_trip("P-1Y2M")
    other_spellings()
}

func instant_round_trip(text: String) {
    var read = time_text.read_instant(text)
    crash read
    var written = read.to_string()
    crash written == text
    console.print("instant", written)
}

func date_round_trip(text: String) {
    var read = time_text.read_date(text)
    crash read
    var written = read.to_string()
    crash written == text
    console.print("date", written)
}

func time_round_trip(text: String) {
    var read = time_text.read_time(text)
    crash read
    var written = read.to_string()
    crash written == text
    console.print("time", written)
}

func date_time_round_trip(text: String) {
    var read = time_text.read_date_time(text)
    crash read
    var written = read.to_string()
    crash written == text
    console.print("date and time", written)
}

func duration_round_trip(text: String) {
    var read = time_text.read_duration(text)
    crash read
    var written = read.to_string()
    crash written == text
    console.print("duration", written)
}

func period_round_trip(text: String) {
    var read = time_text.read_period(text)
    crash read
    var written = read.to_string()
    crash written == text
    console.print("period", written)
}

func other_spellings() {
    show_instant("2024-03-10T02:00:00-05:00")
    show_instant("2024-03-10T12:30:00+05:30")
    show_instant("2024-03-10T03:00:00-04:00[America/New_York]")
    show_instant("2024-03-10t07:00:00z")
    show_instant("2024-03-10 07:00:00,5Z")
    show_instant("2024-03-10T06:59:60Z")
    var local = time_text.read_date_time("2024-03-10 02:30")
    var ninety = time_text.read_duration("PT90M")
    var fortnight = time_text.read_period("P2W")
    var later = time_text.read_period("-P1Y-2M")
    crash local and ninety and fortnight and later
    console.print(local, ninety, fortnight, later)
}

func show_instant(text: String) {
    var read = time_text.read_instant(text)
    crash read
    console.print(text, "is", read)
}
