var console = Console()

func BoundProofs() {
    var spans = [2, 0, 4, 5, 1, 3, 9, 9]
    var records = records_of(spans)
    console.print("records", records)
    var counted = counted_total(spans)
    console.print("counted", counted)
    var names = ["ada", "bo"]
    var found = guarded_name(names, 1)
    var missing = guarded_name(names, 7)
    console.print("guarded", found, missing)
    var shown = backwards(spans)
    console.print("backwards", shown)
}

func records_of(spans: List<Integer>): Integer {
    var total = 0
    var at = 0
    while at + 2 < spans.count() {
        total = total + spans[at] * spans[at + 1] + spans[at + 2]
        at = at + 3
    }
    return total
}

func counted_total(values: List<Integer>): Integer {
    var count = values.count()
    var total = 0
    var index = 0
    while index < count {
        total = total + values[index]
        index = index + 1
    }
    return total
}

func guarded_name(names: List<String>, wanted: Integer): String {
    if wanted >= names.count() {
        return "none"
    }
    return names[wanted].upper_case()
}

func backwards(values: List<Integer>): String {
    var shown = List<Integer>()
    var index = values.count() - 1
    crash values[index]
    var last = values[index]
    shown.append(last)
    index = index - 1
    while index >= 0 {
        crash values[index]
        shown.append(values[index])
        index = index - 2
    }
    return shown.join(" ")
}
