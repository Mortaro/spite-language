var console = Console()
var ledger = Ledger()

func ParallelStages() {
    var runners = List<Runner>()
    var index = 0
    while index < 4 {
        runners.append(Runner(index + 1))
        index = index + 1
    }
    var tick = 0
    while tick < 12 {
        run_stage(runners)
        tick = tick + 1
    }
    var claimed = ledger.claimed()
    var mismatches = ledger.mismatches()
    console.print("claimed", claimed, "ids in 12 stages of 4 runners")
    console.print("next id", ledger.next_id, "and", mismatches, "runners read another thread's buffer")
}

func run_stage(stage: List<Runner>) {
    var running = List<Parallel<Nothing>>()
    var last = stage.count() - 1
    var index = 0
    while index < last {
        crash stage[index]
        start_threaded(stage[index], running)
        index = index + 1
    }
    crash stage[last]
    stage[last].run_once()
    running.clear()
}

func start_threaded(runner: Runner, running: List<Parallel<Nothing>>) {
    var thread = Parallel(runner.run_once)
    running.append(thread)
}
