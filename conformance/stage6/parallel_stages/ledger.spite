singleton

var buffer = ThreadLocal<Integer>()
var id_lock = Lock()
var next_id = 0
var claims = 0
var wrong_buffers = 0

func claim(): Integer {
    id_lock.lock()
    var id = next_id
    next_id = next_id + 1
    id_lock.unlock()
    return id
}

func use_buffer(runner: Integer) {
    buffer.set(runner)
}

func check_buffer(runner: Integer) {
    var seen = buffer.get()
    crash seen
    if seen != runner {
        wrong_buffers = wrong_buffers + 1
    }
    claims = claims + 1
}

func claimed(): Integer {
    return claims
}

func mismatches(): Integer {
    return wrong_buffers
}
