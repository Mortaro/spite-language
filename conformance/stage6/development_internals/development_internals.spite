var console = Console()
var heap = Memory.Heap()
var longs = TypedMemory<Long>()
var build = Build()

func DevelopmentInternals() {
    var address = heap.allocate(8)
    longs.write_value(address, 0, 42)
    var stored = longs.read_value(address, 0)
    heap.free(address)
    console.print("stored:", stored)
    var heaps = Memory.Heap.instances.count()
    console.print("Memory.Heap objects:", heaps)
    var builds = Build.instances.count()
    console.print("Build objects:", builds)
    console.print("development build:", build.development)
}
