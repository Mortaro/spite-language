union Shape {
    Circle
    Square
}

var console = Console()
var favorite: Shape? = null

func ClassTest() {
    var shape: Shape = Circle()
    console.print(shape == Circle)
    console.print(shape == Square)
    console.print(shape != Square)
    console.print(favorite == Circle)
    favorite = Square()
    console.print(favorite == Square)
    console.print(Circle() == Circle)
    var circle_description = describe(Circle())
    console.print(circle_description)
    var square_description = describe(Square())
    console.print(square_description)
}

func describe(shape: Shape): String {
    if shape == Circle {
        return "a circle of radius {shape.radius}"
    }
    return "not a circle"
}
