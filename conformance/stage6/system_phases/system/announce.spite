type Patient {
    health: Component.Health
    label: Component.Label
}

var console = Console()

func render_all(patients: List<Patient>) {
    var total = sum_all(patients)
    var patients_count = patients.count()
    console.print(patients_count, "patients with", total, "health")
}

func sum_all(patients: List<Patient>): Integer {
    var total = 0
    var index = 0
    while index < patients.count() {
        total = total + patients[index].health.amount
        index = index + 1
    }
    return total
}
