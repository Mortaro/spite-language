var console = Console()
var program = Program()
var server = Socket()

func SocketBytes() {
    crash server.listen_at("127.0.0.1", 47313)
    var nobody = server.accept_client_now()
    if not nobody {
        console.print("nobody is connecting yet")
    }
    var client = Socket()
    crash client.connect("localhost", 47313)
    var peer = accept_eventually()
    var nothing = peer.read_bytes_now()
    var nothing_count = nothing.count()
    console.print("nothing yet:", nothing_count, peer.closed)
    send(client, 1, 2, 250)
    var received = receive(peer, 3)
    var first = received[0]
    crash first
    var third = received[2]
    crash third
    var received_count = received.count()
    console.print("peer received:", received_count, first, third)
    send(peer, 7, 8, 9)
    received = receive(client, 3)
    var second = received[1]
    crash second
    received_count = received.count()
    console.print("client received:", received_count, second)
    crash peer.write_line("hello over the wire")
    var line = client.read_line_now()
    while not line {
        program.sleep(1)
        line = client.read_line_now()
    }
    crash line
    console.print("client read the line:", line)
    client.close()
    var after = peer.read_bytes_now()
    while not peer.closed {
        program.sleep(1)
        after = peer.read_bytes_now()
    }
    var after_count = after.count()
    console.print("peer closed:", after_count, peer.closed)
    var last_line = peer.read_line_now()
    if not last_line {
        console.print("no line after the close")
    }
    peer.close()
    server.close()
}

func accept_eventually(): Socket {
    var accepted = server.accept_client_now()
    while not accepted {
        program.sleep(1)
        accepted = server.accept_client_now()
    }
    crash accepted
    return accepted
}

func send(socket: Socket, first: Byte, second: Byte, third: Byte) {
    var message = [first, second, third]
    var sent = socket.write_bytes_now(message)
    console.print("sent without waiting:", sent)
}

func receive(socket: Socket, wanted: Integer): List<Byte> {
    var received = socket.read_bytes_now()
    while received.count() < wanted and not socket.closed {
        program.sleep(1)
        var more = socket.read_bytes_now()
        var more_count = more.count()
        received.append_bytes(more, 0, more_count)
    }
    return received
}
