var console = Console()
var program = Program()
var log = List<String>()

func ConcurrentWaits() {
    var slow_sleeper = Sleeper("slow", 150, log)
    var fast_sleeper = Sleeper("fast", 10, log)
    var slow = Concurrent(slow_sleeper.nap)
    var fast = Concurrent(fast_sleeper.nap)
    log.append("both are waiting")
    log.append("{slow} and {fast} are back")
    var reading = Concurrent(read_itself)
    if reading {
        log.append("read itself: {reading.starts_with("var console")}")
    }
    var nested = Concurrent(outer)
    log.append("outer counted {nested}")
    ring_and_forget()
    log.append("ring was joined when its handle was dropped")
    var joined_log = log.join("\n")
    console.print(joined_log)
}

func read_itself(): String? {
    return File("conformance/stage6/concurrent_waits/concurrent_waits.spite").read()
}

func outer(): Integer {
    var inner = Concurrent(inner_count)
    program.sleep(5)
    return inner + 1
}

func inner_count(): Integer {
    program.sleep(5)
    return 41
}

func ring_and_forget() {
    var ringing = Concurrent(ring)
    log.append("ring has finished: {ringing.finished}")
}

func ring() {
    program.sleep(5)
    log.append("ring")
}
