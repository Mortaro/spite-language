var console = Console()

func AssertDefault() {
    report(safe_divide(10, 2))
    report(safe_divide(10, 0))
    announce(0 - 5)
    announce(5)
}

func safe_divide(numerator: Int, denominator: Int): Int? {
    assert denominator != 0
    return numerator / denominator
}

func report(result: Int?) {
    assert result
    console.print(result)
}

func announce(value: Int) {
    assert value > 0
    console.print("positive", value)
}
