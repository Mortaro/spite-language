var console = Console()

func AssertDefault() {
    var ten_by_two = safe_divide(10, 2)
    report(ten_by_two)
    var ten_by_zero = safe_divide(10, 0)
    report(ten_by_zero)
    announce(0 - 5)
    announce(5)
}

func safe_divide(numerator: Int, denominator: Int): Int? {
    assert denominator != 0
    return numerator / denominator
}

func report(result: Int?) {
    assert result
    console.print(result)
}

func announce(value: Int) {
    assert value > 0
    console.print("positive", value)
}
