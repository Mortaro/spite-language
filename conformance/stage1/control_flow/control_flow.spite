var console = Console()

func ControlFlow() {
    var index = 0
    while index < 5 {
        console.print(index)
        index = index + 1
    }
    var value = 7
    if value > 5 {
        console.print("big")
    } else {
        console.print("small")
    }
    if value < 5 {
        console.print("unreachable")
    } else {
        console.print("also big")
    }
    var flag = true
    if flag and value > 0 {
        console.print("both true")
    }
    if flag or value < 0 {
        console.print("at least one true")
    }
    if not flag {
        console.print("unreachable too")
    } else {
        console.print("flag was true")
    }
}
