union Shape {
    Circle
    Square
}

var console = Console()
var shapes = List<Shape>()
var favorite: Shape? = null

func Unions() {
    shapes.append(Circle(2))
    shapes.append(Square(3))
    var index = 0
    while index < shapes.count() {
        var describe = describe(shapes[index])
        var area = shapes[index].area()
        console.print(describe, area, shapes[index].name)
        index = index + 1
    }
    var shape: Shape = Square(4)
    grow(shape)
    var describe = describe(shape)
    console.print(describe)
    favorite = shape
    var current = favorite
    if current {
        var area = current.area()
        console.print("favorite", area)
    }
    var name = pick(true).name
    var pick_name = pick(false).name
    console.print(name, pick_name)
    var lookup = Dictionary<Shape>()
    lookup.set("round", Circle(1))
    var found = lookup.get("round")
    if found {
        var found_description = describe(found)
        console.print(found_description)
    }
    console.print("done")
}

func describe(shape: Shape): String {
    switch shape {
        Circle: return "circle of radius {shape.radius}"
        Square: {
            var side = shape.side
            return "square of side {side}"
        }
    }
}

func grow(shape: Shape) {
    switch shape {
        Circle: shape.radius = shape.radius * 2
        Square: shape.side = shape.side * 2
    }
}

func pick(round: Bool): Shape {
    if round {
        return Circle(9)
    }
    return Square(9)
}
