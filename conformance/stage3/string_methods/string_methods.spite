var console = Console()

func StringMethods() {
    var text = "  Hello, Spite World  "
    var trimmed = text.trim()
    var trimmed_length = trimmed.length()
    var trimmed_is_empty = trimmed.is_empty()
    var nothing_is_empty = "".is_empty()
    console.print(trimmed_length, trimmed_is_empty, nothing_is_empty)
    var upper_case_trimmed = trimmed.upper_case()
    var lower_case_trimmed = trimmed.lower_case()
    console.print(upper_case_trimmed, lower_case_trimmed)
    var trimmed_slice = trimmed.slice(7, 12)
    var first_character = trimmed.character_at(0)
    var first_code = trimmed.code_at(0)
    console.print(trimmed_slice, first_character, first_code, "{trimmed.character_at(99)}|")
    var trimmed_contains = trimmed.contains("Spite")
    var trimmed_starts_with = trimmed.starts_with("Hello")
    var trimmed_ends_with = trimmed.ends_with("x")
    var spite_index = trimmed.index_of("Spite")
    var absent_index = trimmed.index_of("absent")
    console.print(trimmed_contains, trimmed_starts_with, trimmed_ends_with, spite_index, absent_index)
    var replaced = trimmed.replace("World", "Compiler").replace("Hello", "Bye")
    console.print(replaced)
    var parts = "a,b,,c".split(",")
    var parts_count = parts.count()
    var joined_parts = parts.join("|")
    console.print(parts_count, joined_parts)
    var rows = "one\ntwo\nthree".lines()
    var rows_count = rows.count()
    var last_row = rows.last()
    console.print(rows_count, last_row)
    var letters = "abc".split("")
    crash letters.count() == 3
    var letters_count = letters.count()
    console.print(letters_count, letters[1])
    var forty_two = "42".to_int()
    var seven = "7".to_long()
    var two_and_a_half = "2.5".to_float()
    var one_and_a_quarter = "1.25".to_double()
    var oops_number = "oops".to_int()
    console.print(forty_two + 1, seven, two_and_a_half, one_and_a_quarter, oops_number)
    var number: Int = "12"
    console.print(number * 2)
    var joined_length = ("x{1}").length()
    var built_upper_case = build("q").upper_case()
    console.print(joined_length, built_upper_case)
    console.print("abc" < "abd", "abc" == "abc", "b" > "a", "abc" != "abc")
}

func build(prefix: String): String {
    return "{prefix}-{prefix.length()}"
}
