    print_shown("\{''")
    print_shown("{number}\{''")
    console.print("[{shown("\{''")}]")
    console.print("[{shown("<{shown("\{''")}>")}]")
    print_shown("\{'\{")
    print_shown("{number}\{'\{")
    console.print("[{shown("\{'\{")}]")
    console.print("[{shown("<{shown("\{'\{")}>")}]")
    print_shown("\{\{\n")
    print_shown("{number}\{\{\n")
    console.print("[{shown("\{\{\n")}]")
    console.print("[{shown("<{shown("\{\{\n")}>")}]")
    print_shown("\{\{\t")
    print_shown("{number}\{\{\t")
    console.print("[{shown("\{\{\t")}]")
    console.print("[{shown("<{shown("\{\{\t")}>")}]")
    print_shown("\{\{\r")
    print_shown("{number}\{\{\r")
    console.print("[{shown("\{\{\r")}]")
    console.print("[{shown("<{shown("\{\{\r")}>")}]")
    print_shown("\{\{\\")
    print_shown("{number}\{\{\\")
    console.print("[{shown("\{\{\\")}]")
    console.print("[{shown("<{shown("\{\{\\")}>")}]")
    print_shown("\{\{\"")
    print_shown("{number}\{\{\"")
    console.print("[{shown("\{\{\"")}]")
    console.print("[{shown("<{shown("\{\{\"")}>")}]")
    print_shown("\{\{'")
    print_shown("{number}\{\{'")
    console.print("[{shown("\{\{'")}]")
    console.print("[{shown("<{shown("\{\{'")}>")}]")
    print_shown("\{\{\{")
    print_shown("{number}\{\{\{")
    console.print("[{shown("\{\{\{")}]")
    console.print("[{shown("<{shown("\{\{\{")}>")}]")
}

func print_shown(text: String) {
    var visible = shown(text)
    console.print(visible)
}

func shown(text: String): String {
    return text.replace("\n", "<n>").replace("\t", "<t>").replace("\r", "<r>")
}
