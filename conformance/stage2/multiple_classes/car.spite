var console = Console()
var name = ""
var engine: Engine? = null

func Car(starting_name: String, starting_engine: Engine) {
    name = starting_name
    engine = starting_engine
}

func accelerate(amount: Integer) {
    assert engine
    engine.push(amount)
}

func describe() {
    assert engine
    console.print("{name}: {engine.report()}")
}
