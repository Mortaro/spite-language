var console = Console()

func Temporaries() {
    console.print("abcd")
    var made_greeting = make_greeting("world")
    console.print(made_greeting)
    var unwrap_label = Wrapper(Inner("deep")).unwrap_label()
    console.print(unwrap_label)
    var first = Wrapper(Inner("first")).label()
    var second = Wrapper(Inner("second")).label()
    console.print("{first} and {second}")
}

func make_greeting(name: String): String {
    return "hello, {name}"
}
