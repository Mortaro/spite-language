var console = Console()

func System(arguments: Arguments) {
    console.print(arguments.count(), "{arguments.get(3)}|")
    if arguments.nothing_here {
        console.print("unexpected", arguments.nothing_here)
    } else {
        console.print("no such argument")
    }
    var folder = Directory(".spite-cache/conformance_system")
    console.print(folder.create(), folder.exists())
    var file = File(".spite-cache/conformance_system/note.txt")
    console.print(file.write("first line\n"), file.append("second line"), file.exists())
    report(file)
    console.print(folder.files().join(","), folder.folders().count())
    console.print(file.remove(), file.exists())
    report(file)
    var c_compiler = Program().environment("CC")
    if c_compiler {
        console.print("CC is set")
    } else {
        console.print("CC is not set")
    }
    var never_set = Program().environment("SPITE_CONFORMANCE_NEVER_SET")
    if never_set {
        console.print("unexpected")
    }
    var process = Process("git", ["--version"])
    var exit_code = process.run()
    console.print(exit_code, process.output().trim().is_empty())
    Program().sleep(1)
    console.print("done")
}

func report(file: File) {
    var content = file.read()
    if content {
        console.print(content.lines().count(), content.lines().last())
    } else {
        console.print("cannot read")
    }
}
