# Build caches and outputs. Nothing here is source; all of it regenerates.
.spite-cache/

# Compiled programs and debug symbols, wherever they land.
*.exe
*.pdb
*.obj
*.o
*.lib
*.ilk

# What a build writes beside its executable, which by default sits beside the program (D129).
*.crashes
*.reload_host
*.reload_files
*_reload_*.files

# Generated C: the compiler's own --c-source output, and a manual run at the repository root.
# bootstrap/seed/spite_compiler.c is NOT ignored: it is the committed fixpoint.
/bootstrap/bootstrap.c
/next.c
/gen*.c
# foreign library fixtures check.sh builds
conformance/**/fixture.dll
conformance/**/fixture.lib
conformance/**/fixture.exp
conformance/**/fixture.so
conformance/**/fixture.dylib
