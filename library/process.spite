var command = ""
var arguments = List<String>()
var working_directory = ""
var environment_variables = Dictionary<String>()
var last_output = ""
var heap = Memory.Heap()

func Process(starting_command: String, starting_arguments: List<String>) {
    command = starting_command
    arguments = starting_arguments
}

func run(): Integer {
    var command_text = command_line()
    var handle = open_process(command_text)
    if handle == 0 {
        last_output = ""
        return -1
    }
    var output_text = ""
    var chunk = heap.allocate(4096)
    var got = read_into(chunk, 4096, handle)
    while got > 0 {
        var piece = chunk.text(got)
        output_text = output_text + piece
        got = read_into(chunk, 4096, handle)
    }
    heap.free(chunk)
    last_output = output_text
    return close_process(handle)
}

func output(): String {
    return last_output
}

func command_line(): String {
    var command_is_path = command.contains(" ") and File(command).exists()
    var line = command
    if command_is_path {
        line = "\"{command}\""
    }
    var index = 0
    while index < arguments.count() {
        var quoted = quoted_argument(arguments[index])
        line = "{line} {quoted}"
        index = index + 1
    }
    var prefix = settings_prefix()
    return shell_line("{prefix}{line}")
}

func settings_prefix(): String {
    var prefix = ""
    if not working_directory.is_empty() {
        var changed = change_directory(working_directory)
        prefix = "{changed} && "
    }
    var names = environment_variables.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        crash environment_variables[name]
        var assigned = set_variable(name, environment_variables[name])
        prefix = "{prefix}{assigned} && "
        index = index + 1
    }
    return prefix
}
