var command = ""
var arguments = List<String>()
var last_output = ""
var heap = Memory.Heap()

func Process(starting_command: String, starting_arguments: List<String>) {
    command = starting_command
    arguments = starting_arguments
}

func run(): Int {
    var command_line = command_line()
    var handle = open_process(command_line)
    if handle == 0 {
        last_output = ""
        return -1
    }
    var output = ""
    var chunk = heap.allocate(4096)
    var got = read_into(chunk, 4096, handle)
    while got > 0 {
        output = "{output}{chunk.text(got)}"
        got = read_into(chunk, 4096, handle)
    }
    heap.free(chunk)
    last_output = output
    return close_process(handle)
}

func output(): String {
    return last_output
}

func command_line(): String {
    var command_is_path = command.contains(" ") and File(command).exists()
    var line = command
    if command_is_path {
        line = "\"{command}\""
    }
    var index = 0
    while index < arguments.count() {
        line = "{line} \"{arguments[index]}\""
        index = index + 1
    }
    return shell_line(line, command_is_path)
}
