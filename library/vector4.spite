generic $number_type: Number

var x: $number_type = 0
var y: $number_type = 0
var z: $number_type = 0
var w: $number_type = 0

func Vector4(starting_x: $number_type, starting_y: $number_type, starting_z: $number_type, starting_w: $number_type) {
    x = starting_x
    y = starting_y
    z = starting_z
    w = starting_w
}

func sum(other: Vector4<$number_type>): Vector4<$number_type> {
    return Vector4(x + other.x, y + other.y, z + other.z, w + other.w)
}

func subtract(other: Vector4<$number_type>): Vector4<$number_type> {
    return Vector4(x - other.x, y - other.y, z - other.z, w - other.w)
}

func multiply(other: Vector4<$number_type>): Vector4<$number_type> {
    return Vector4(x * other.x, y * other.y, z * other.z, w * other.w)
}

func divide(other: Vector4<$number_type>): Vector4<$number_type> {
    return Vector4(x / other.x, y / other.y, z / other.z, w / other.w)
}

func negate(): Vector4<$number_type> {
    return Vector4(-x, -y, -z, -w)
}

func equals(other: Vector4<$number_type>): Boolean {
    return x == other.x and y == other.y and z == other.z and w == other.w
}

func scaled(factor: $number_type): Vector4<$number_type> {
    return Vector4(x * factor, y * factor, z * factor, w * factor)
}

func dot(other: Vector4<$number_type>): $number_type {
    return x * other.x + y * other.y + z * other.z + w * other.w
}

func length_squared(): $number_type {
    return x * x + y * y + z * z + w * w
}

func length(): $number_type {
    var squared = x * x + y * y + z * z + w * w
    return _square_root(squared)
}

func normalized(): Vector4<$number_type> {
    var squared = x * x + y * y + z * z + w * w
    if squared == 0 {
        return Vector4<$number_type>(0, 0, 0, 0)
    }
    if $number_type == Float or $number_type == Double {
        var one: $number_type = 1
        var inverse_length = one / squared.square_root()
        return Vector4(x * inverse_length, y * inverse_length, z * inverse_length, w * inverse_length)
    }
    var size = _square_root(squared)
    return Vector4(x / size, y / size, z / size, w / size)
}

func distance_to(other: Vector4<$number_type>): $number_type {
    var x_part = other.x - x
    var y_part = other.y - y
    var z_part = other.z - z
    var w_part = other.w - w
    var squared = x_part * x_part + y_part * y_part + z_part * z_part + w_part * w_part
    return _square_root(squared)
}

func distance_squared_to(other: Vector4<$number_type>): $number_type {
    var x_part = other.x - x
    var y_part = other.y - y
    var z_part = other.z - z
    var w_part = other.w - w
    return x_part * x_part + y_part * y_part + z_part * z_part + w_part * w_part
}

func linear_interpolate(target: Vector4<$number_type>, amount: $number_type): Vector4<$number_type> {
    return Vector4(
        x + (target.x - x) * amount,
        y + (target.y - y) * amount,
        z + (target.z - z) * amount,
        w + (target.w - w) * amount,
    )
}

func minimum(other: Vector4<$number_type>): Vector4<$number_type> {
    var x_part = x.minimum(other.x)
    var y_part = y.minimum(other.y)
    var z_part = z.minimum(other.z)
    var w_part = w.minimum(other.w)
    return Vector4(x_part, y_part, z_part, w_part)
}

func maximum(other: Vector4<$number_type>): Vector4<$number_type> {
    var x_part = x.maximum(other.x)
    var y_part = y.maximum(other.y)
    var z_part = z.maximum(other.z)
    var w_part = w.maximum(other.w)
    return Vector4(x_part, y_part, z_part, w_part)
}

func absolute(): Vector4<$number_type> {
    var x_part = x.absolute()
    var y_part = y.absolute()
    var z_part = z.absolute()
    var w_part = w.absolute()
    return Vector4(x_part, y_part, z_part, w_part)
}

func _square_root(squared: $number_type): $number_type {
    if $number_type == Float or $number_type == Double {
        return squared.square_root()
    }
    var root: $number_type = squared.to_double().square_root()
    return root
}

func to_string(): String {
    return "({x}, {y}, {z}, {w})"
}
