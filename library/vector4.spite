var x_value: Float = 0.0
var y_value: Float = 0.0
var z_value: Float = 0.0
var w_value: Float = 0.0

func Vector4(starting_x: Float, starting_y: Float, starting_z: Float, starting_w: Float) {
    x_value = starting_x
    y_value = starting_y
    z_value = starting_z
    w_value = starting_w
}

func sum(other: Vector4): Vector4 {
    return Vector4(x_value + other.x_value, y_value + other.y_value, z_value + other.z_value, w_value + other.w_value)
}

func subtract(other: Vector4): Vector4 {
    return Vector4(x_value - other.x_value, y_value - other.y_value, z_value - other.z_value, w_value - other.w_value)
}

func multiply(other: Vector4): Vector4 {
    return Vector4(x_value * other.x_value, y_value * other.y_value, z_value * other.z_value, w_value * other.w_value)
}

func divide(other: Vector4): Vector4 {
    return Vector4(x_value / other.x_value, y_value / other.y_value, z_value / other.z_value, w_value / other.w_value)
}

func negate(): Vector4 {
    return Vector4(-x_value, -y_value, -z_value, -w_value)
}

func equals(other: Vector4): Boolean {
    return x_value == other.x_value and y_value == other.y_value and z_value == other.z_value and w_value == other.w_value
}

func scaled(factor: Float): Vector4 {
    return Vector4(x_value * factor, y_value * factor, z_value * factor, w_value * factor)
}

func dot(other: Vector4): Float {
    return x_value * other.x_value + y_value * other.y_value + z_value * other.z_value + w_value * other.w_value
}

func length_squared(): Float {
    return x_value * x_value + y_value * y_value + z_value * z_value + w_value * w_value
}

func length(): Float {
    var squared = x_value * x_value + y_value * y_value + z_value * z_value + w_value * w_value
    return squared.square_root()
}

func normalized(): Vector4 {
    var squared = x_value * x_value + y_value * y_value + z_value * z_value + w_value * w_value
    if squared == 0.0 {
        return Vector4(0.0, 0.0, 0.0, 0.0)
    }
    var inverse_length = 1.0 / squared.square_root()
    return Vector4(
        x_value * inverse_length,
        y_value * inverse_length,
        z_value * inverse_length,
        w_value * inverse_length,
    )
}

func distance_to(other: Vector4): Float {
    var x_part = other.x_value - x_value
    var y_part = other.y_value - y_value
    var z_part = other.z_value - z_value
    var w_part = other.w_value - w_value
    var squared = x_part * x_part + y_part * y_part + z_part * z_part + w_part * w_part
    return squared.square_root()
}

func distance_squared_to(other: Vector4): Float {
    var x_part = other.x_value - x_value
    var y_part = other.y_value - y_value
    var z_part = other.z_value - z_value
    var w_part = other.w_value - w_value
    return x_part * x_part + y_part * y_part + z_part * z_part + w_part * w_part
}

func linear_interpolate(target: Vector4, amount: Float): Vector4 {
    return Vector4(
        x_value + (target.x_value - x_value) * amount,
        y_value + (target.y_value - y_value) * amount,
        z_value + (target.z_value - z_value) * amount,
        w_value + (target.w_value - w_value) * amount,
    )
}

func minimum(other: Vector4): Vector4 {
    var x_part = x_value.minimum(other.x_value)
    var y_part = y_value.minimum(other.y_value)
    var z_part = z_value.minimum(other.z_value)
    var w_part = w_value.minimum(other.w_value)
    return Vector4(x_part, y_part, z_part, w_part)
}

func maximum(other: Vector4): Vector4 {
    var x_part = x_value.maximum(other.x_value)
    var y_part = y_value.maximum(other.y_value)
    var z_part = z_value.maximum(other.z_value)
    var w_part = w_value.maximum(other.w_value)
    return Vector4(x_part, y_part, z_part, w_part)
}

func absolute(): Vector4 {
    var x_part = x_value.absolute()
    var y_part = y_value.absolute()
    var z_part = z_value.absolute()
    var w_part = w_value.absolute()
    return Vector4(x_part, y_part, z_part, w_part)
}

func to_string(): String {
    return "({x_value}, {y_value}, {z_value}, {w_value})"
}
