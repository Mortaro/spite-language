generic $value_type

var text = ""

func JsonReader(new_text: String) {
    text = new_text
}

func read(): $value_type? {
    var cursor = JsonCursor(text)
    var parsed = parse(cursor)
    cursor.finish()
    assert not cursor.failed()
    return parsed
}

func read_or_crash(): $value_type {
    var cursor = JsonCursor(text)
    var parsed = parse(cursor)
    cursor.finish()
    var failure = cursor.failure
    crash failure == ""
    return parsed
}

func parse(cursor: JsonCursor): $value_type {
    if $value_type == String {
        return cursor.read_text()
    } else if $value_type == Boolean {
        return cursor.read_boolean()
    } else if $value_type == Integer or $value_type == Long or $value_type == Float or $value_type == Double or $value_type == Tiny or $value_type == Short or $value_type == Byte or $value_type == UnsignedShort or $value_type == UnsignedInteger or $value_type == UnsignedLong {
        var number_text = cursor.read_number()
        var number: $value_type = number_text
        return number
    } else if $value_type == Symbol {
        return read_symbol(cursor)
    } else if $value_type == Null {
        assert not cursor.read_null()
        var inner = JsonReader<$value_type.value_type>("")
        return inner.parse(cursor)
    } else if $value_type == List {
        var list: $value_type = null
        var element_json = JsonReader<$value_type.element_type>("")
        cursor.expect("[")
        var more = not cursor.consume("]")
        while more and not cursor.failed() {
            var element = element_json.parse(cursor)
            list.append(element)
            more = cursor.consume(",")
            if not more {
                cursor.expect("]")
            }
        }
        return list
    } else if $value_type == Dictionary {
        var dictionary: $value_type = null
        var entry_json = JsonReader<$value_type.value_type>("")
        cursor.expect("\{")
        var more = not cursor.consume("}")
        while more and not cursor.failed() {
            var key: $value_type.key_type = cursor.read_text()
            cursor.expect(":")
            var entry = entry_json.parse(cursor)
            dictionary.set(key, entry)
            more = cursor.consume(",")
            if not more {
                cursor.expect("}")
            }
        }
        return dictionary
    } else {
        var created: $value_type = null
        cursor.expect("\{")
        var more = not cursor.consume("}")
        while more and not cursor.failed() {
            var key = cursor.read_text()
            cursor.expect(":")
            cursor.matched = false
            read_attributes(created, key, cursor)
            if not cursor.matched {
                cursor.skip_value()
            }
            more = cursor.consume(",")
            if not more {
                cursor.expect("}")
            }
        }
        return created
    }
}

func read_symbol(cursor: JsonCursor): $value_type {
    var name = cursor.read_text()
    if $value_type == Enum {
        var symbol: $value_type = name
        if symbol.to_string() != name {
            cursor.fail("one of the names of {symbol.class.name}")
        }
        return symbol
    }
    var found = Symbol(name)
    if found {
        return found
    }
    cursor.fail("a name the program already uses as a Symbol")
}

func read_attribute(attribute: Symbol<$value_type>, created: $value_type, key: String, cursor: JsonCursor) {
    if key == attribute.name {
        var attribute_json = JsonReader<attribute.class>("")
        created.attributes[attribute] = attribute_json.parse(cursor)
        cursor.matched = true
    }
}
