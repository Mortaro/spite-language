singleton

var console = Console()
var heap = Memory.Heap()
var scheduler = Scheduler()
var build = Build()
var folder = ""
var ready: Memory.Address = 0
var compiling = Lock()
var handing = Lock()
var ready_library = ""
var ready_state = ""
var ready_told = ""
var ready_problem = ""
var in_flight = false
var compiled_for_request = false
var published: Long = 0
var ready_stamp: Long = 0
var requested_stamp: Long = 0
var installed_stamp: Long = 0
var succeeded = false
var last = "nothing has been reloaded yet"
var answered = false
var answer = ""
var reported = false
var swaps = Reload()
var program = Program()
var compiled_files = Dictionary<String>()
var settled_for_request = false
var breakpoints = List<String>()
var prompts = 0
var settle_problem: String? = null

func start() {
    folder = build.program
    restart_state()
    ready = heap.allocate(24)
    ready.write_long(0, 0)
    ready.write_long(8, 0)
    ready.write_long(16, 0)
    compiled_files = files_seen()
    scheduler.start()
    scheduler.serving = true
    scheduler.reloads = install_if_ready
    var entry = watcher_entry()
    var no_argument: Long = 0
    var watcher_thread = scheduler.start_thread(entry, no_argument)
    crash watcher_thread != 0
    while ready.read_long_atomically(16) == 0 {
        program.sleep(1)
    }
}

func drop() {
    if ready != 0 {
        heap.free(ready)
    }
}

func watch() {
    var watcher = FileSystemWatcher()
    var watching = watch_folders(watcher)
    ready.write_long_atomically(16, 1)
    assert watching
    while true {
        watcher.wait_for_changes()
        watcher.changes()
        compile_changes()
    }
}

func watch_folders(watcher: FileSystemWatcher): Boolean {
    var loaded = loaded_folders().split("\n")
    var index = 0
    while index < loaded.count() {
        if not loaded[index].is_empty() {
            var loaded_folder = Directory(loaded[index])
            watcher.watch_for_changes(loaded_folder)
        }
        index = index + 1
    }
    var program_folder = Directory(folder)
    return watcher.watch_for_changes(program_folder)
}

func compile_for_request() {
    requested_stamp = compile_changes()
    compiled_for_request = true
}

func compile_changes(): Long {
    compiling.lock()
    ready.write_long_atomically(8, 1)
    swap_in_flight()
    var seen = files_seen()
    var arguments = build_arguments().split("\n")
    var running = program_file()
    var breaks_base = running_base(running)
    var requested_breaks = breakpoints.join("\n")
    File("{breaks_base}.reload_breaks").write(requested_breaks)
    arguments.prepend("reload")
    arguments.append("--executable-path={running}")
    var compiler_path = compiler()
    var rebuilding = Process(compiler_path, arguments)
    var exit_code = rebuilding.run()
    var output = rebuilding.output().trim()
    if exit_code != 0 {
        publish("", "", "", "the program keeps the code it runs: {output}")
    } else if output != "unchanged" {
        publish_library(output)
    } else {
        publish_unchanged()
    }
    var stamp = published
    handing.lock()
    compiled_files = seen
    handing.unlock()
    ready.write_long_atomically(8, 0)
    compiling.unlock()
    scheduler.signal()
    return stamp
}

func swap_in_flight() {
    var on_main_thread = scheduler.current_thread() == scheduler.scheduler_thread
    while library_in_flight() {
        if on_main_thread {
            crash ready.read_long_atomically(0) == 1
            install_ready()
        } else {
            program.sleep(10)
        }
    }
}

func library_in_flight(): Boolean {
    handing.lock()
    var flying = in_flight
    handing.unlock()
    return flying
}

func publish_library(output: String) {
    var told = List<String>()
    var library_path = ""
    var state_path = ""
    var lines = output.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        var line_length = line.length()
        if line.starts_with("library ") {
            library_path = line.slice(8, line_length)
        } else if line.starts_with("state ") {
            state_path = line.slice(6, line_length)
        } else {
            told.append(line)
        }
        index = index + 1
    }
    var joined = told.join("\n")
    publish(library_path, state_path, joined, "")
}

func publish_unchanged() {
    handing.lock()
    if ready.read_long_atomically(0) == 0 {
        published = published + 1
        ready_stamp = published
        ready_library = ""
        ready_state = ""
        ready_told = ""
        ready_problem = ""
        ready.write_long_atomically(0, 1)
    }
    handing.unlock()
}

func publish(library_path: String, state_path: String, told: String, problem: String) {
    handing.lock()
    crash not in_flight
    in_flight = not library_path.is_empty()
    published = published + 1
    ready_stamp = published
    ready_library = library_path
    ready_state = state_path
    ready_told = told
    ready_problem = problem
    ready.write_long_atomically(0, 1)
    handing.unlock()
}

func install_if_ready() {
    assert ready.read_long_atomically(0) == 1
    install_ready()
    if reported {
        console.error("spite: {answer}")
    }
}

func reload() {
    if not compiled_for_request {
        requested_stamp = compile_changes()
    }
    compiled_for_request = false
    if ready.read_long_atomically(0) == 1 {
        install_ready()
    }
    assert installed_stamp < requested_stamp
    answered = true
    answer = "nothing changed since the code the program runs"
}

func compile_prompt(code: String, answering: Boolean): String {
    compiling.lock()
    prompts = prompts + 1
    var name = "prompt_run_{prompts}"
    var text = "func {name}() \{\n    {code}\n}\n"
    if answering {
        name = "prompt_answer_{prompts}"
        text = "func {name}(): String \{\n    var prompt_value: String = {code}\n    return prompt_value\n}\n"
    }
    compiling.unlock()
    return compiled_prompt(name, text)
}

func compile_made(code: String, class_name: String): String {
    compiling.lock()
    prompts = prompts + 1
    var name = "prompt_made_{prompts}"
    var text = "func {name}(): {class_name} \{\n    var prompt_value = {code}\n    return prompt_value\n}\n"
    compiling.unlock()
    return compiled_prompt(name, text)
}

func compiled_prompt(name: String, text: String): String {
    compiling.lock()
    var running = program_file()
    var base = running_base(running)
    File("{base}.reload_prompt").write(text)
    compiling.unlock()
    compile_for_request()
    compiling.lock()
    File("{base}.reload_prompt").write("")
    compiling.unlock()
    return name
}

func compile_with_renames(renames: String) {
    compiling.lock()
    var running = program_file()
    var base = running_base(running)
    File("{base}.reload_renames").write(renames)
    compiling.unlock()
    compile_for_request()
    compiling.lock()
    File("{base}.reload_renames").write("")
    compiling.unlock()
}

func change_breakpoints(request: String, adding: Boolean) {
    compiling.lock()
    if adding {
        if not breakpoints.contains(request) {
            breakpoints.append(request)
        }
    } else if request.is_empty() {
        breakpoints.clear()
    } else {
        var index = 0
        while index < breakpoints.count() {
            if breakpoints[index] == request {
                breakpoints.remove_at(index)
            } else {
                index = index + 1
            }
        }
    }
    compiling.unlock()
}

func listed_breakpoints(): String {
    compiling.lock()
    var listed = breakpoints.join("\n")
    compiling.unlock()
    return listed
}

func settle(): String? {
    var waited = 0
    while not settled() {
        if waited >= 600000 {
            return "the watcher has not swapped in the saved files after 10 minutes: 'reload' compiles them now"
        }
        program.sleep(50)
        waited = waited + 50
    }
    return null
}

func settled(): Boolean {
    if ready.read_long_atomically(8) == 1 {
        return false
    }
    var same = true
    handing.lock()
    var paths = compiled_files.keys()
    var index = 0
    while index < paths.count() and same {
        var path = paths[index]
        same = compiled_files[path] == file_stamp(path)
        index = index + 1
    }
    handing.unlock()
    return same
}

func files_seen(): Dictionary<String> {
    var running = program_file()
    var base = running_base(running)
    var state = File("{base}.reload_files").read()
    crash state
    var seen = Dictionary<String>()
    var lines = state.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        if line.starts_with("file ") {
            var line_length = line.length()
            var after_hash = line.slice(5, line_length).index_of(" ")
            if after_hash > 0 {
                var path = line.slice(6 + after_hash, line_length)
                seen[path] = file_stamp(path)
            }
        }
        index = index + 1
    }
    return seen
}

func file_stamp(path: String): String {
    var file = File(path)
    if not file.exists() {
        return "gone"
    }
    var size = file.size()
    var modified = file.modified()
    if not size or not modified {
        return "unreadable"
    }
    return "{size} {modified}"
}

func settle_for_request() {
    settle_problem = settle()
    settled_for_request = true
}

func wait_for_watcher() {
    if not settled_for_request {
        settle_problem = settle()
    }
    settled_for_request = false
    var problem = settle_problem
    if problem {
        answered = false
        answer = problem
        return
    }
    if ready.read_long_atomically(0) == 1 {
        install_ready()
    }
    answered = succeeded
    answer = last
}

func install_ready() {
    handing.lock()
    var library_path = ready_library
    var state_path = ready_state
    var told = ready_told
    var problem = ready_problem
    installed_stamp = ready_stamp
    ready.write_long_atomically(0, 0)
    handing.unlock()
    reported = false
    if not problem.is_empty() {
        tell(false, problem)
        return
    }
    if library_path.is_empty() {
        answered = true
        answer = "nothing changed since the code the program runs"
        return
    }
    scheduler.paused = true
    swap_in(library_path, state_path, told)
    scheduler.paused = false
    handing.lock()
    in_flight = false
    handing.unlock()
}

func tell(worked: Boolean, text: String) {
    answered = worked
    answer = text
    succeeded = worked
    last = text
    reported = true
}

func swap_in(library_path: String, state_path: String, told: String) {
    var library = open(library_path)
    if library == 0 {
        tell(false, "the program keeps the code it runs: '{library_path}' could not be loaded")
        return
    }
    var missing = install(library)
    if not missing.is_empty() {
        tell(false, "the program keeps the code it runs: it has no '{missing}', which the new code calls")
        return
    }
    var running = program_file()
    commit(running, state_path)
    swaps.note_swap(told)
    tell(true, told)
}

func commit(running: String, state_path: String) {
    var state = File(state_path).read()
    assert state
    var base = running_base(running)
    File("{base}.reload_files").write(state)
    var state_length = state_path.length()
    var library_base = state_path.slice(0, state_length - 6)
    var baseline = File("{library_base}.baseline").read()
    assert baseline
    if not baseline.is_empty() {
        File("{base}.reload_baseline").write(baseline)
    }
}

func restart_state() {
    var running = program_file()
    var base = running_base(running)
    var built = File("{base}.reload_start").read()
    crash built
    File("{base}.reload_files").write(built)
    File("{base}.reload_baseline").write("")
    File("{base}.reload_breaks").write("")
    File("{base}.reload_prompt").write("")
    File("{base}.reload_renames").write("")
}

func running_base(running: String): String {
    if running.ends_with(".exe") {
        var running_length = running.length()
        return running.slice(0, running_length - 4)
    }
    return running
}
