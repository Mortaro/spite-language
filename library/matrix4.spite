func transform_point(point: Vector3): Vector3 {
    var x_part = column_0_row_0 * point.x + column_1_row_0 * point.y + column_2_row_0 * point.z + column_3_row_0
    var y_part = column_0_row_1 * point.x + column_1_row_1 * point.y + column_2_row_1 * point.z + column_3_row_1
    var z_part = column_0_row_2 * point.x + column_1_row_2 * point.y + column_2_row_2 * point.z + column_3_row_2
    return Vector3(x_part, y_part, z_part)
}

func project_point(point: Vector3): Vector3 {
    var x_part = column_0_row_0 * point.x + column_1_row_0 * point.y + column_2_row_0 * point.z + column_3_row_0
    var y_part = column_0_row_1 * point.x + column_1_row_1 * point.y + column_2_row_1 * point.z + column_3_row_1
    var z_part = column_0_row_2 * point.x + column_1_row_2 * point.y + column_2_row_2 * point.z + column_3_row_2
    var w_part = column_0_row_3 * point.x + column_1_row_3 * point.y + column_2_row_3 * point.z + column_3_row_3
    var inverse_w = 1.0 / w_part
    return Vector3(x_part * inverse_w, y_part * inverse_w, z_part * inverse_w)
}

func transform_direction(direction: Vector3): Vector3 {
    var x_part = column_0_row_0 * direction.x + column_1_row_0 * direction.y + column_2_row_0 * direction.z
    var y_part = column_0_row_1 * direction.x + column_1_row_1 * direction.y + column_2_row_1 * direction.z
    var z_part = column_0_row_2 * direction.x + column_1_row_2 * direction.y + column_2_row_2 * direction.z
    return Vector3(x_part, y_part, z_part)
}

func set_translation(offset: Vector3) {
    set_identity()
    column_3_row_0 = offset.x
    column_3_row_1 = offset.y
    column_3_row_2 = offset.z
}

func set_scale(factor: Vector3) {
    set_identity()
    column_0_row_0 = factor.x
    column_1_row_1 = factor.y
    column_2_row_2 = factor.z
}

func set_rotation(rotation: Quaternion) {
    var x_x = rotation.x * rotation.x
    var y_y = rotation.y * rotation.y
    var z_z = rotation.z * rotation.z
    var x_y = rotation.x * rotation.y
    var x_z = rotation.x * rotation.z
    var y_z = rotation.y * rotation.z
    var w_x = rotation.w * rotation.x
    var w_y = rotation.w * rotation.y
    var w_z = rotation.w * rotation.z
    column_0_row_0 = 1.0 - 2.0 * (y_y + z_z)
    column_0_row_1 = 2.0 * (x_y + w_z)
    column_0_row_2 = 2.0 * (x_z - w_y)
    column_1_row_0 = 2.0 * (x_y - w_z)
    column_1_row_1 = 1.0 - 2.0 * (x_x + z_z)
    column_1_row_2 = 2.0 * (y_z + w_x)
    column_2_row_0 = 2.0 * (x_z + w_y)
    column_2_row_1 = 2.0 * (y_z - w_x)
    column_2_row_2 = 1.0 - 2.0 * (x_x + y_y)
    column_0_row_3 = 0.0
    column_1_row_3 = 0.0
    column_2_row_3 = 0.0
    column_3_row_0 = 0.0
    column_3_row_1 = 0.0
    column_3_row_2 = 0.0
    column_3_row_3 = 1.0
}

func set_transform(translation: Vector3, rotation: Quaternion, scale: Vector3) {
    set_rotation(rotation)
    column_0_row_0 = column_0_row_0 * scale.x
    column_0_row_1 = column_0_row_1 * scale.x
    column_0_row_2 = column_0_row_2 * scale.x
    column_1_row_0 = column_1_row_0 * scale.y
    column_1_row_1 = column_1_row_1 * scale.y
    column_1_row_2 = column_1_row_2 * scale.y
    column_2_row_0 = column_2_row_0 * scale.z
    column_2_row_1 = column_2_row_1 * scale.z
    column_2_row_2 = column_2_row_2 * scale.z
    column_3_row_0 = translation.x
    column_3_row_1 = translation.y
    column_3_row_2 = translation.z
}

func translation_part(): Vector3 {
    return Vector3(column_3_row_0, column_3_row_1, column_3_row_2)
}

func scale_part(): Vector3 {
    var x_squared = column_0_row_0 * column_0_row_0 + column_0_row_1 * column_0_row_1 + column_0_row_2 * column_0_row_2
    var x_part = x_squared.square_root()
    var y_squared = column_1_row_0 * column_1_row_0 + column_1_row_1 * column_1_row_1 + column_1_row_2 * column_1_row_2
    var y_part = y_squared.square_root()
    var z_squared = column_2_row_0 * column_2_row_0 + column_2_row_1 * column_2_row_1 + column_2_row_2 * column_2_row_2
    var z_part = z_squared.square_root()
    var handedness = column_0_row_0 * (column_1_row_1 * column_2_row_2 - column_2_row_1 * column_1_row_2) - column_1_row_0 * (column_0_row_1 * column_2_row_2 - column_2_row_1 * column_0_row_2) + column_2_row_0 * (column_0_row_1 * column_1_row_2 - column_1_row_1 * column_0_row_2)
    if handedness < 0.0 {
        x_part = -x_part
    }
    return Vector3(x_part, y_part, z_part)
}

func rotation_part(): Quaternion {
    var scale = scale_part()
    var rotation = Quaternion()
    if scale.x == 0.0 or scale.y == 0.0 or scale.z == 0.0 {
        return rotation
    }
    var inverse_x = 1.0 / scale.x
    var inverse_y = 1.0 / scale.y
    var inverse_z = 1.0 / scale.z
    var rotation_0_0 = column_0_row_0 * inverse_x
    var rotation_0_1 = column_0_row_1 * inverse_x
    var rotation_0_2 = column_0_row_2 * inverse_x
    var rotation_1_0 = column_1_row_0 * inverse_y
    var rotation_1_1 = column_1_row_1 * inverse_y
    var rotation_1_2 = column_1_row_2 * inverse_y
    var rotation_2_0 = column_2_row_0 * inverse_z
    var rotation_2_1 = column_2_row_1 * inverse_z
    var rotation_2_2 = column_2_row_2 * inverse_z
    rotation.set_rotation_columns(
        rotation_0_0,
        rotation_0_1,
        rotation_0_2,
        rotation_1_0,
        rotation_1_1,
        rotation_1_2,
        rotation_2_0,
        rotation_2_1,
        rotation_2_2,
    )
    return rotation
}

func set_look_at(eye: Vector3, target: Vector3, up: Vector3) {
    var toward = target - eye
    var forward = toward.normalized()
    var sideways = forward.cross(up)
    var side = sideways.normalized()
    var true_up = side.cross(forward)
    column_0_row_0 = side.x
    column_1_row_0 = side.y
    column_2_row_0 = side.z
    column_0_row_1 = true_up.x
    column_1_row_1 = true_up.y
    column_2_row_1 = true_up.z
    column_0_row_2 = -forward.x
    column_1_row_2 = -forward.y
    column_2_row_2 = -forward.z
    column_0_row_3 = 0.0
    column_1_row_3 = 0.0
    column_2_row_3 = 0.0
    column_3_row_0 = 0.0 - side.dot(eye)
    column_3_row_1 = 0.0 - true_up.dot(eye)
    column_3_row_2 = forward.dot(eye)
    column_3_row_3 = 1.0
}

func set_perspective(field_of_view: Float, aspect: Float, near: Float, far: Float) {
    var half_angle = field_of_view * 0.5
    var focal = 1.0 / half_angle.tangent()
    set_identity()
    column_0_row_0 = focal / aspect
    column_1_row_1 = -focal
    column_2_row_2 = far / (near - far)
    column_2_row_3 = -1.0
    column_3_row_2 = near * far / (near - far)
    column_3_row_3 = 0.0
}

func set_orthographic(left: Float, right: Float, bottom: Float, top: Float, near: Float, far: Float) {
    set_identity()
    column_0_row_0 = 2.0 / (right - left)
    column_1_row_1 = -2.0 / (top - bottom)
    column_2_row_2 = -1.0 / (far - near)
    column_3_row_0 = -(right + left) / (right - left)
    column_3_row_1 = (top + bottom) / (top - bottom)
    column_3_row_2 = -near / (far - near)
}

func normal_matrix(): Matrix3? {
    var upper = Matrix3()
    upper.column_0_row_0 = column_0_row_0
    upper.column_0_row_1 = column_0_row_1
    upper.column_0_row_2 = column_0_row_2
    upper.column_1_row_0 = column_1_row_0
    upper.column_1_row_1 = column_1_row_1
    upper.column_1_row_2 = column_1_row_2
    upper.column_2_row_0 = column_2_row_0
    upper.column_2_row_1 = column_2_row_1
    upper.column_2_row_2 = column_2_row_2
    var inverted = upper.inverse()
    assert inverted
    return inverted.transposed()
}
