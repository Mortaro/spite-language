    product.column_1_row_0 = column_0_row_0 * other.column_1_row_0 + column_1_row_0 * other.column_1_row_1 + column_2_row_0 * other.column_1_row_2 + column_3_row_0 * other.column_1_row_3
    product.column_1_row_1 = column_0_row_1 * other.column_1_row_0 + column_1_row_1 * other.column_1_row_1 + column_2_row_1 * other.column_1_row_2 + column_3_row_1 * other.column_1_row_3
    product.column_1_row_2 = column_0_row_2 * other.column_1_row_0 + column_1_row_2 * other.column_1_row_1 + column_2_row_2 * other.column_1_row_2 + column_3_row_2 * other.column_1_row_3
    product.column_1_row_3 = column_0_row_3 * other.column_1_row_0 + column_1_row_3 * other.column_1_row_1 + column_2_row_3 * other.column_1_row_2 + column_3_row_3 * other.column_1_row_3
