func multiply(other: Matrix4): Matrix4 {
    var product = Matrix4()
    product.column_0_row_0 = column_0_row_0 * other.column_0_row_0 + column_1_row_0 * other.column_0_row_1 + column_2_row_0 * other.column_0_row_2 + column_3_row_0 * other.column_0_row_3
    product.column_0_row_1 = column_0_row_1 * other.column_0_row_0 + column_1_row_1 * other.column_0_row_1 + column_2_row_1 * other.column_0_row_2 + column_3_row_1 * other.column_0_row_3
