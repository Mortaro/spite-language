func determinant(): Float {
    var cofactor_0 = column_1_row_1 * column_2_row_2 * column_3_row_3 - column_1_row_1 * column_2_row_3 * column_3_row_2 - column_2_row_1 * column_1_row_2 * column_3_row_3 + column_2_row_1 * column_1_row_3 * column_3_row_2 + column_3_row_1 * column_1_row_2 * column_2_row_3 - column_3_row_1 * column_1_row_3 * column_2_row_2
    var cofactor_4 = 0.0 - column_1_row_0 * column_2_row_2 * column_3_row_3 + column_1_row_0 * column_2_row_3 * column_3_row_2 + column_2_row_0 * column_1_row_2 * column_3_row_3 - column_2_row_0 * column_1_row_3 * column_3_row_2 - column_3_row_0 * column_1_row_2 * column_2_row_3 + column_3_row_0 * column_1_row_3 * column_2_row_2
    var cofactor_8 = column_1_row_0 * column_2_row_1 * column_3_row_3 - column_1_row_0 * column_2_row_3 * column_3_row_1 - column_2_row_0 * column_1_row_1 * column_3_row_3 + column_2_row_0 * column_1_row_3 * column_3_row_1 + column_3_row_0 * column_1_row_1 * column_2_row_3 - column_3_row_0 * column_1_row_3 * column_2_row_1
    var cofactor_12 = 0.0 - column_1_row_0 * column_2_row_1 * column_3_row_2 + column_1_row_0 * column_2_row_2 * column_3_row_1 + column_2_row_0 * column_1_row_1 * column_3_row_2 - column_2_row_0 * column_1_row_2 * column_3_row_1 - column_3_row_0 * column_1_row_1 * column_2_row_2 + column_3_row_0 * column_1_row_2 * column_2_row_1
    return column_0_row_0 * cofactor_0 + column_0_row_1 * cofactor_4 + column_0_row_2 * cofactor_8 + column_0_row_3 * cofactor_12
}

