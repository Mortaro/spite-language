    inverted.column_2_row_1 = 0.0 - column_0_row_0 * column_2_row_1 * column_3_row_3 + column_0_row_0 * column_2_row_3 * column_3_row_1 + column_2_row_0 * column_0_row_1 * column_3_row_3 - column_2_row_0 * column_0_row_3 * column_3_row_1 - column_3_row_0 * column_0_row_1 * column_2_row_3 + column_3_row_0 * column_0_row_3 * column_2_row_1
