func transform(vector: Vector4): Vector4 {
    var x_part = column_0_row_0 * vector.x + column_1_row_0 * vector.y + column_2_row_0 * vector.z + column_3_row_0 * vector.w
    var y_part = column_0_row_1 * vector.x + column_1_row_1 * vector.y + column_2_row_1 * vector.z + column_3_row_1 * vector.w
    var z_part = column_0_row_2 * vector.x + column_1_row_2 * vector.y + column_2_row_2 * vector.z + column_3_row_2 * vector.w
    var w_part = column_0_row_3 * vector.x + column_1_row_3 * vector.y + column_2_row_3 * vector.z + column_3_row_3 * vector.w
