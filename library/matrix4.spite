    inverted.column_0_row_2 = column_0_row_1 * column_1_row_2 * column_3_row_3 - column_0_row_1 * column_1_row_3 * column_3_row_2 - column_1_row_1 * column_0_row_2 * column_3_row_3 + column_1_row_1 * column_0_row_3 * column_3_row_2 + column_3_row_1 * column_0_row_2 * column_1_row_3 - column_3_row_1 * column_0_row_3 * column_1_row_2
    inverted.column_1_row_2 = 0.0 - column_0_row_0 * column_1_row_2 * column_3_row_3 + column_0_row_0 * column_1_row_3 * column_3_row_2 + column_1_row_0 * column_0_row_2 * column_3_row_3 - column_1_row_0 * column_0_row_3 * column_3_row_2 - column_3_row_0 * column_0_row_2 * column_1_row_3 + column_3_row_0 * column_0_row_3 * column_1_row_2
    inverted.column_2_row_2 = column_0_row_0 * column_1_row_1 * column_3_row_3 - column_0_row_0 * column_1_row_3 * column_3_row_1 - column_1_row_0 * column_0_row_1 * column_3_row_3 + column_1_row_0 * column_0_row_3 * column_3_row_1 + column_3_row_0 * column_0_row_1 * column_1_row_3 - column_3_row_0 * column_0_row_3 * column_1_row_1
    inverted.column_3_row_2 = 0.0 - column_0_row_0 * column_1_row_1 * column_3_row_2 + column_0_row_0 * column_1_row_2 * column_3_row_1 + column_1_row_0 * column_0_row_1 * column_3_row_2 - column_1_row_0 * column_0_row_2 * column_3_row_1 - column_3_row_0 * column_0_row_1 * column_1_row_2 + column_3_row_0 * column_0_row_2 * column_1_row_1
    inverted.column_0_row_3 = 0.0 - column_0_row_1 * column_1_row_2 * column_2_row_3 + column_0_row_1 * column_1_row_3 * column_2_row_2 + column_1_row_1 * column_0_row_2 * column_2_row_3 - column_1_row_1 * column_0_row_3 * column_2_row_2 - column_2_row_1 * column_0_row_2 * column_1_row_3 + column_2_row_1 * column_0_row_3 * column_1_row_2
    inverted.column_1_row_3 = column_0_row_0 * column_1_row_2 * column_2_row_3 - column_0_row_0 * column_1_row_3 * column_2_row_2 - column_1_row_0 * column_0_row_2 * column_2_row_3 + column_1_row_0 * column_0_row_3 * column_2_row_2 + column_2_row_0 * column_0_row_2 * column_1_row_3 - column_2_row_0 * column_0_row_3 * column_1_row_2
    inverted.column_2_row_3 = 0.0 - column_0_row_0 * column_1_row_1 * column_2_row_3 + column_0_row_0 * column_1_row_3 * column_2_row_1 + column_1_row_0 * column_0_row_1 * column_2_row_3 - column_1_row_0 * column_0_row_3 * column_2_row_1 - column_2_row_0 * column_0_row_1 * column_1_row_3 + column_2_row_0 * column_0_row_3 * column_1_row_1
    inverted.column_3_row_3 = column_0_row_0 * column_1_row_1 * column_2_row_2 - column_0_row_0 * column_1_row_2 * column_2_row_1 - column_1_row_0 * column_0_row_1 * column_2_row_2 + column_1_row_0 * column_0_row_2 * column_2_row_1 + column_2_row_0 * column_0_row_1 * column_1_row_2 - column_2_row_0 * column_0_row_2 * column_1_row_1
    var whole = column_0_row_0 * inverted.column_0_row_0 + column_0_row_1 * inverted.column_1_row_0 + column_0_row_2 * inverted.column_2_row_0 + column_0_row_3 * inverted.column_3_row_0
    assert whole != 0.0
    var scale = 1.0 / whole
    inverted.column_0_row_0 = inverted.column_0_row_0 * scale
    inverted.column_0_row_1 = inverted.column_0_row_1 * scale
    inverted.column_0_row_2 = inverted.column_0_row_2 * scale
