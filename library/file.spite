var path = ""
var heap = Memory.Heap()

func File(starting_path: String) {
    path = starting_path
}

func move_to(new_path: String): Boolean {
    var file_there = File(new_path)
    var folder_there = Directory(new_path)
    if file_there.exists() or folder_there.exists() {
        return false
    }
    if not rename_to(new_path) {
        return false
    }
    path = new_path
    return true
}

func get_name(): String {
    var end = path.length()
    while end > 1 and path.code_at(end - 1) == 47 {
        end = end - 1
    }
    var start = end
    while start > 0 and path.code_at(start - 1) != 47 and path.code_at(start - 1) != 92 {
        start = start - 1
    }
    return path.slice(start, end)
}

func read(): String? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var length = tell(handle)
    seek(handle, 0, 0)
    var buffer = heap.allocate(length + 1)
    var got = read_into(buffer, length, handle)
    close_file(handle)
    var content = buffer.text(got)
    heap.free(buffer)
    return content
}

func write(text: String): Boolean {
    return put(text, "wb")
}

func append(text: String): Boolean {
    return put(text, "ab")
}

func exists(): Boolean {
    var handle = open_file("rb")
    if handle == 0 {
        return false
    }
    close_file(handle)
    return true
}

func to_string(): String {
    return path
}

func size(): Long? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var bytes = tell(handle)
    close_file(handle)
    return bytes
}

func modified(): Instant? {
    var nanoseconds = modified_nanoseconds()
    assert nanoseconds
    var whole = Duration(nanoseconds / 1000000000, 'seconds')
    var part = Duration(nanoseconds % 1000000000, 'nanoseconds')
    return Instant(whole + part)
}

func read_bytes(position: Long, count: Long, address: Long): Long? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, position, 0)
    var got = read_into(address, count, handle)
    close_file(handle)
    return got
}

func write_bytes(address: Long, count: Long): Boolean {
    var handle = open_file("wb")
    if handle == 0 {
        return false
    }
    var written = write_from(address, count, handle)
    close_file(handle)
    return written == count
}

func append_bytes(address: Long, count: Long): Long? {
    var handle = open_file("ab")
    assert handle != 0
    seek(handle, 0, 2)
    var start = tell(handle)
    var written = write_from(address, count, handle)
    close_file(handle)
    assert written == count
    return start
}

func put(text: String, mode: String): Boolean {
    var handle = open_file(mode)
    if handle == 0 {
        return false
    }
    var written = write_text(text, handle)
    close_file(handle)
    return written == text.length()
}
