var path = ""
var heap = Memory.Heap()

func File(starting_path: String) {
    path = starting_path
}

func move_to(new_path: String): Boolean {
    var file_there = File(new_path)
    var folder_there = Directory(new_path)
    if file_there.exists() or folder_there.exists() {
        return false
    }
    if not rename_to(new_path) {
        return false
    }
    path = new_path
    return true
}

func get_name(): String {
    var end = path.length()
    while end > 1 and path.code_at(end - 1) == 47 {
        end = end - 1
    }
    var start = end
    while start > 0 and path.code_at(start - 1) != 47 and path.code_at(start - 1) != 92 {
        start = start - 1
    }
    return path.slice(start, end)
}

func read(): String? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var length = tell(handle)
    seek(handle, 0, 0)
    var buffer = heap.allocate(length + 1)
    var got = read_into(buffer, length, handle)
    close_file(handle)
    var content = buffer.text(got)
    heap.free(buffer)
    return content
}

func write(text: String): Boolean {
    return put(text, "wb")
}

func append(text: String): Boolean {
    return put(text, "ab")
}

func exists(): Boolean {
    var handle = open_file("rb")
    if handle == 0 {
        return false
    }
    close_file(handle)
    return true
}

func to_string(): String {
    return path
}

func size(): Long? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var bytes = tell(handle)
    close_file(handle)
    return bytes
}

func modified(): Instant? {
    var nanoseconds = modified_nanoseconds()
    assert nanoseconds
    var whole = Duration(nanoseconds / 1000000000, 'seconds')
    var part = Duration(nanoseconds % 1000000000, 'nanoseconds')
    return Instant(whole + part)
}

func read_bytes(): List<Byte>? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var length = tell(handle)
    seek(handle, 0, 0)
    var bytes = _read_list(handle, length)
    close_file(handle)
    assert length == bytes.count()
    return bytes
}

func read_bytes_at(position: Long, count: Integer): List<Byte>? {
    crash position >= 0 and count >= 0
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var available = tell(handle) - position
    if available > count {
        available = count
    }
    seek(handle, position, 0)
    var bytes = _read_list(handle, available)
    close_file(handle)
    return bytes
}

func write_bytes(bytes: List<Byte>): Boolean {
    var handle = open_file("wb")
    if handle == 0 {
        return false
    }
    var written = _write_list(bytes, handle)
    close_file(handle)
    return written == bytes.count()
}

func append_bytes(bytes: List<Byte>): Long? {
    var handle = open_file("ab")
    assert handle != 0
    seek(handle, 0, 2)
    var start = tell(handle)
    var written = _write_list(bytes, handle)
    close_file(handle)
    assert written == bytes.count()
    return start
}

func _read_list(handle: Long, wanted: Long): List<Byte> {
    var bytes = List<Byte>()
    if wanted > 0 {
        var counted: Integer = wanted
        bytes.reserve(counted)
        var got = read_into(bytes.items, counted, handle)
        bytes.item_count = got
    }
    return bytes
}

func _write_list(bytes: List<Byte>, handle: Long): Long {
    var counted = bytes.count()
    if counted == 0 {
        return 0
    }
    return write_from(bytes.items, counted, handle)
}

func put(text: String, mode: String): Boolean {
    var handle = open_file(mode)
    if handle == 0 {
        return false
    }
    var written = write_text(text, handle)
    close_file(handle)
    return written == text.length()
}
