var path = ""
var memory = Memory()

func File(starting_path: String) {
    path = starting_path
}

func read(): String? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var size = tell(handle)
    seek(handle, 0, 0)
    var buffer = memory.allocate_bytes(size + 1)
    var got = read_into(buffer, size, handle)
    close_file(handle)
    var content = memory.text(buffer, got)
    memory.free(buffer)
    return content
}

func write(text: String): Bool {
    return put(text, "wb")
}

func append(text: String): Bool {
    return put(text, "ab")
}

func exists(): Bool {
    var handle = open_file("rb")
    if handle == 0 {
        return false
    }
    close_file(handle)
    return true
}

func put(text: String, mode: String): Bool {
    var handle = open_file(mode)
    if handle == 0 {
        return false
    }
    var written = write_text(text, handle)
    close_file(handle)
    return written == text.length()
}
