var path = ""
var heap = Memory.Heap()

func File(starting_path: String) {
    path = starting_path
}

func read(): String? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var size = tell(handle)
    seek(handle, 0, 0)
    var buffer = heap.allocate(size + 1)
    var got = read_into(buffer, size, handle)
    close_file(handle)
    var content = buffer.text(got)
    heap.free(buffer)
    return content
}

func write(text: String): Bool {
    return put(text, "wb")
}

func append(text: String): Bool {
    return put(text, "ab")
}

func exists(): Bool {
    var handle = open_file("rb")
    assert handle != 0
    close_file(handle)
    return true
}

func put(text: String, mode: String): Bool {
    var handle = open_file(mode)
    assert handle != 0
    var written = write_text(text, handle)
    close_file(handle)
    return written == text.length()
}
