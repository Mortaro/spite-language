var path = ""
var memory = Memory()

func File(starting_path: String) {
    path = starting_path
}

func read(): String? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var size = tell(handle)
    seek(handle, 0, 0)
    var buffer = memory.allocate_bytes(size + 1)
    var got = read_into(buffer, size, handle)
    close_file(handle)
    var content = memory.text(buffer, got)
    memory.free(buffer)
    return content
}

func write(text: String): Bool {
    return put(text, "wb")
}

func append(text: String): Bool {
    return put(text, "ab")
}

func exists(): Bool {
    var handle = open_file("rb")
    assert handle != 0
    close_file(handle)
    return true
}

func size(): Long? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, 0, 2)
    var bytes = tell(handle)
    close_file(handle)
    return bytes
}

func modified(): Instant? {
    var nanoseconds = modified_nanoseconds()
    assert nanoseconds
    var whole = Duration(nanoseconds / 1000000000, 'seconds')
    var part = Duration(nanoseconds % 1000000000, 'nanoseconds')
    return Instant(whole + part)
}

func read_bytes(position: Long, count: Long, address: Long): Long? {
    var handle = open_file("rb")
    assert handle != 0
    seek(handle, position, 0)
    var got = read_into(address, count, handle)
    close_file(handle)
    return got
}

func write_bytes(address: Long, count: Long): Bool {
    var handle = open_file("wb")
    assert handle != 0
    var written = write_from(address, count, handle)
    close_file(handle)
    return written == count
}

func append_bytes(address: Long, count: Long): Long? {
    var handle = open_file("ab")
    assert handle != 0
    seek(handle, 0, 2)
    var start = tell(handle)
    var written = write_from(address, count, handle)
    close_file(handle)
    assert written == count
    return start
}

func put(text: String, mode: String): Bool {
    var handle = open_file(mode)
    assert handle != 0
    var written = write_text(text, handle)
    close_file(handle)
    return written == text.length()
}
