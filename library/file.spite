var path = ""
var runtime = CRuntime()
var memory = Memory()

func File(starting_path: String) {
    path = starting_path
}

func read(): String? {
    var handle = runtime.open_file(path, "rb")
    assert handle != 0
    runtime.seek(handle, 0, 2)
    var size = runtime.tell(handle)
    runtime.seek(handle, 0, 0)
    var buffer = memory.allocate_bytes(size + 1)
    var got = runtime.read_into(buffer, size, handle)
    runtime.close_file(handle)
    var content = memory.text(buffer, got)
    memory.free(buffer)
    return content
}

func write(text: String): Bool {
    return put(text, "wb")
}

func append(text: String): Bool {
    return put(text, "ab")
}

func exists(): Bool {
    var handle = runtime.open_file(path, "rb")
    if handle == 0 {
        return false
    }
    runtime.close_file(handle)
    return true
}

func remove(): Bool {
    return runtime.remove_file(path) == 0
}

func put(text: String, mode: String): Bool {
    var handle = runtime.open_file(path, mode)
    if handle == 0 {
        return false
    }
    var written = runtime.write_text(text, handle)
    runtime.close_file(handle)
    return written == text.length()
}
