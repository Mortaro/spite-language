type Answer {
    succeeded: Boolean
    text: String
    class_name: String
}

var console = Console()
var heap = Memory.Heap()
var unresolved = ""
var consumed = 0
var server = Socket()
var scheduler = Scheduler()
var running_program = Program()
var build = Build()
var hot_reload = HotReload()
var inspector = Memory.Inspector()
var thread: Long = 0
var handover: Memory.Address = 0
var pending_command = ""
var answered: Answer? = null
var served: Spite.Attribute? = null

func step(program: Spite.Attribute): Boolean {
    console.write("spite> ")
    var line = console.read_line()
    if line {
        var trimmed_line = line.trim()
        if trimmed_line != "exit" {
            var answered = answer(trimmed_line, program)
            if not answered.text.is_empty() or answered.class_name != "" and answered.class_name != "Nothing" {
                console.print(answered.text)
            }
            return true
        }
    }
    console.print("")
    return false
}

func listen_in_background(port: Integer, entry: Long) {
    if not server.listen_locally(port) {
        console.error("error: the REPL could not listen on 127.0.0.1:{port}")
        running_program.exit(1)
        return
    }
    handover = heap.allocate(16)
    handover.write_long(0, 0)
    handover.write_long(8, 0)
    scheduler.start()
    scheduler.serving = true
    scheduler.commands = answer_pending
    thread = start_thread(entry)
    if thread == 0 {
        console.error("error: the REPL could not start its thread")
        running_program.exit(1)
    }
}

func wait_for_exit() {
    while handover.read_long_atomically(8) == 0 {
        scheduler.idle()
    }
    scheduler.serving = false
    scheduler.commands = null
    join_thread(thread)
}

func drop() {
    if handover != 0 {
        heap.free(handover)
    }
}

func serve(program: Spite.Attribute) {
    served = program
    var serving = true
    while serving {
        var client = server.accept_client()
        if client {
            serve_client(client)
        } else {
            serving = false
        }
    }
    handover.write_long_atomically(8, 1)
    scheduler.signal()
}

func serve_client(client: Socket) {
    var connected = true
    while connected {
        var line = client.read_line()
        if line {
            var trimmed_line = line.trim()
            var answered = handed_over(trimmed_line)
            if trimmed_line == "exit" {
                client.write_line("\{\"ok\":true,\"value\":\"\",\"type\":\"\"}")
                client.close()
                running_program.exit(0)
                return
            }
            var json_answer = json_line(answered)
            connected = client.write_line(json_answer)
        } else {
            connected = false
        }
    }
    client.close()
}

func handed_over(command: String): Answer {
    if build.hot_reload {
        compile_before_reload(command)
    }
    pending_command = command
    handover.write_long_atomically(0, 1)
    scheduler.signal()
    while handover.read_long_atomically(0) != 2 {
        pause_briefly()
    }
    crash answered
    handover.write_long_atomically(0, 0)
    return answered
}

func compile_before_reload(command: String) {
    if command == "reload" {
        hot_reload.compile_for_request()
    }
}

func answer_pending() {
    if handover.read_long_atomically(0) == 1 {
        handover.write_long_atomically(0, 3)
        crash served
        answered = answer(pending_command, served)
        handover.write_long_atomically(0, 2)
        if pending_command == "exit" {
            while true {
                pause_briefly()
            }
        }
    }
}

func json_line(answered: Answer): String {
    var text = json_text(answered.text)
    if answered.succeeded {
        var class_name = json_text(answered.class_name)
        return "\{\"ok\":true,\"value\":\"{text}\",\"type\":\"{class_name}\"}"
    }
    return "\{\"ok\":false,\"error\":\"{text}\"}"
}

func json_text(text: String): String {
    var pieces = List<String>()
    var start = 0
    var index = 0
    var text_length = text.length()
    while index < text_length {
        var code = text.code_at(index)
        var escape = json_escape(code)
        if not escape.is_empty() {
            var piece = text.slice(start, index)
            pieces.append(piece)
            pieces.append(escape)
            start = index + 1
        }
        index = index + 1
    }
    var rest = text.slice(start, text_length)
    pieces.append(rest)
    return pieces.join("")
}

func json_escape(code: Integer): String {
    switch code {
        34: return "\\\""
        92: return "\\\\"
        10: return "\\n"
        13: return "\\r"
        9: return "\\t"
        _: {
            if code < 0 or code >= 32 {
                return ""
            }
            var digits = "0123456789abcdef"
            return "\\u00{digits.character_at(code / 16)}{digits.character_at(code % 16)}"
        }
    }
}

func success(text: String, class_name: String): Answer {
    return {succeeded: true, text: text, class_name: class_name}
}

func failure(text: String): Answer {
    return {succeeded: false, text: text, class_name: ""}
}

func answer(command: String, program: Spite.Attribute): Answer {
    if command == "help" {
        return success(
            "attributes, functions, classes (and attributes or functions of a path), a path such as player.health or World().entity_count(), a path = a literal, a call such as player.heal(3), bytes of a path or 'bytes 0x1f2a40 64', reload, last_reload, help, exit",
            "",
        )
    }
    if command == "reload" or command == "last_reload" {
        return reloaded(command)
    }
    if command == "classes" {
        var class_listing = listed_classes()
        return success(class_listing, "")
    }
    if command == "bytes" or command.starts_with("bytes ") {
        return bytes_of(command, program)
    }
    if command == "attributes" or command.starts_with("attributes ") {
        return attributes_of(command, program)
    }
    if command == "functions" or command.starts_with("functions ") {
        return functions_of(command, program)
    }
    if assignment_at(command) >= 0 {
        return assign(command, program)
    }
    if command.is_empty() {
        return success("", "")
    }
    return evaluate(command, program)
}

func attributes_of(command: String, program: Spite.Attribute): Answer {
    var command_length = command.length()
    var target = command.slice(10, command_length).trim()
    var found = found_at(target, program)
    if not found {
        return failure(unresolved)
    }
    var value_attributes = found.value_attributes()
    if value_attributes.is_empty() {
        return success("{found.name} is {described(found.class.name)}, which has no attributes", "")
    }
    var attribute_listing = listed_attributes(value_attributes)
    return success(attribute_listing, "")
}

func functions_of(command: String, program: Spite.Attribute): Answer {
    var command_length = command.length()
    var target = command.slice(9, command_length).trim()
    var found = found_at(target, program)
    if not found {
        return failure(unresolved)
    }
    var value_functions = found.value_functions()
    var function_listing = listed_functions(value_functions)
    if function_listing.is_empty() and target.is_empty() {
        return success(
            "{found.name} is {described(found.class.name)}, which has no function the prompt can call: 'classes' lists the singletons, whose functions the prompt can call, such as World().entity_count()",
            "",
        )
    }
    if function_listing.is_empty() {
        return success("{found.name} is {described(found.class.name)}, which has no function the prompt can call", "")
    }
    return success(function_listing, "")
}

func listed_classes(): String {
    var lines = List<String>()
    var held = singletons()
    var index = 0
    while index < held.count() {
        if held[index].value {
            lines.append("{held[index].name}()")
        } else {
            lines.append("{held[index].name}() not made yet")
        }
        index = index + 1
    }
    var names = class_names()
    if not names.is_empty() {
        lines.append(names)
    }
    return lines.join("\n")
}

func evaluate(command: String, program: Spite.Attribute): Answer {
    var parts = parts_of(command)
    var root = root_of(parts, program)
    if not root {
        return failure(unresolved)
    }
    var part_count = parts.count()
    var last_index = part_count - 1
    var last_part = parts[last_index]
    if consumed > last_index or not last_part or not is_call(last_part) {
        var found = walk(root, parts, consumed, part_count)
        if found {
            var shown_text = shown(found, false)
            return success(shown_text, found.class.name)
        }
        return failure(unresolved)
    }
    var owner = walk(root, parts, consumed, last_index)
    if not owner {
        return failure(unresolved)
    }
    var callee = written(parts, last_index)
    return answered_call(owner, last_part, callee)
}

func found_at(text: String, program: Spite.Attribute): Spite.Attribute? {
    var parts = parts_of(text)
    var root = root_of(parts, program)
    assert root
    var part_count = parts.count()
    return walk(root, parts, consumed, part_count)
}

func parts_of(text: String): List<String> {
    var parts = List<String>()
    var trimmed = text.trim()
    if trimmed.is_empty() {
        return parts
    }
    var start = 0
    var depth = 0
    var quoted = false
    var index = 0
    var trimmed_length = trimmed.length()
    while index < trimmed_length {
        var code = trimmed.code_at(index)
        if code == 34 {
            quoted = not quoted
        }
        if not quoted {
            depth = depth + nesting(code, false)
        }
        var splits = not quoted and depth == 0
        if splits and code == 46 {
            var named_part = trimmed.slice(start, index).trim()
            parts.append(named_part)
            start = index + 1
        }
        if splits and code == 91 and index > start {
            var before_bracket = trimmed.slice(start, index).trim()
            parts.append(before_bracket)
            start = index
        }
        index = index + 1
    }
    var rest = trimmed.slice(start, trimmed_length).trim()
    parts.append(rest)
    return parts
}

func is_call(part: String): Boolean {
    return part.ends_with(")") and part.contains("(") and not part.starts_with("[")
}

func called_name(part: String): String {
    var opening = part.index_of("(")
    return part.slice(0, opening).trim()
}

func inside_of(part: String): String {
    var opening = part.index_of("(")
    var part_length = part.length()
    return part.slice(opening + 1, part_length - 1).trim()
}

func member_name(part: String): String {
    if part.starts_with("[") and part.ends_with("]") {
        var part_length = part.length()
        var key = part.slice(1, part_length - 1).trim()
        if key.length() >= 2 and key.starts_with("\"") and key.ends_with("\"") {
            var key_length = key.length()
            return key.slice(1, key_length - 1)
        }
        return key
    }
    return part
}

func written(parts: List<String>, last: Integer): String {
    var pieces = List<String>()
    var index = 0
    while index <= last and index < parts.count() {
        var part = parts[index]
        if index == last and is_call(part) {
            part = called_name(part)
        }
        if index > 0 and not part.starts_with("[") {
            pieces.append(".")
        }
        pieces.append(part)
        index = index + 1
    }
    return pieces.join("")
}

func root_of(parts: List<String>, program: Spite.Attribute): Spite.Attribute? {
    consumed = 0
    if parts.is_empty() {
        return program
    }
    if parts[0] == "program" {
        consumed = 1
        return program
    }
    var index = 0
    while index < parts.count() and not is_call(parts[index]) and not parts[index].starts_with("[") {
        index = index + 1
    }
    var head = parts[index]
    if head and is_call(head) {
        var call_name = called_name(head)
        if starts_with_capital(call_name) {
            var names = parts.copy()
            names.truncate(index)
            names.append(call_name)
            consumed = index + 1
            var qualified = names.join(".")
            var inside = inside_of(head)
            return singleton_named(qualified, inside)
        }
    }
    return program
}

func starts_with_capital(name: String): Boolean {
    if name.is_empty() {
        return false
    }
    var code = name.code_at(0)
    return code >= 65 and code <= 90
}

func singleton_named(name: String, inside: String): Spite.Attribute? {
    var typed = name.replace(" ", "")
    if not inside.is_empty() {
        unresolved = "'{typed}' is a singleton, so it takes no arguments: there is one instance, and the prompt reads it"
        return null
    }
    var held = singletons()
    var index = 0
    while index < held.count() {
        if held[index].name == typed {
            return made_singleton(held[index])
        }
        index = index + 1
    }
    var matches = List<Spite.Attribute>()
    var matched_names = List<String>()
    index = 0
    while index < held.count() {
        var held_name: String = held[index].name
        if unqualified(held_name) == typed {
            matches.append(held[index])
            matched_names.append(held_name)
        }
        index = index + 1
    }
    if matches.count() == 1 {
        return made_singleton(matches[0])
    }
    if matches.count() > 1 {
        unresolved = "'{typed}' names more than one singleton, {matched_names.join(" and ")}: write the whole name"
        return null
    }
    var class_lines = class_names().split("\n")
    index = 0
    while index < class_lines.count() {
        if class_lines[index] == typed or unqualified(class_lines[index]) == typed {
            unresolved = "'{typed}' is a class, not a singleton: the prompt never makes an object, it reads the ones the program holds, and 'classes' lists the singletons"
            return null
        }
        index = index + 1
    }
    unresolved = "no singleton '{typed}' in the program: 'classes' lists them"
    return null
}

func made_singleton(held: Spite.Attribute): Spite.Attribute? {
    if held.value {
        return held
    }
    unresolved = "{held.name} has not been made yet: nothing in the program has asked for it, and the prompt never makes one"
    return null
}

func unqualified(name: String): String {
    var opening = name.index_of("<")
    var name_length = name.length()
    var head = name
    var tail = ""
    if opening >= 0 {
        head = name.slice(0, opening)
        tail = name.slice(opening, name_length)
    }
    var segments = head.split(".")
    var last_segment = segments.last()
    crash last_segment
    return "{last_segment}{tail}"
}

func walk(root: Spite.Attribute, parts: List<String>, from: Integer, to: Integer): Spite.Attribute? {
    var current = root
    var index = from
    while index < to {
        var part = parts[index]
        crash part
        var callee = written(parts, index)
        if part.is_empty() {
            unresolved = "a path names an attribute after each '.', and '{callee}' names none"
            return null
        }
        if is_call(part) {
            var called = call_in_path(current, part, callee)
            assert called
            current = called
        } else {
            var member = member_name(part)
            var child = child_named(current, member)
            assert child
            current = child
        }
        index = index + 1
    }
    return current
}

func child_named(current: Spite.Attribute, name: String): Spite.Attribute? {
    var children = current.value_attributes()
    var names = List<String>()
    var position = 0
    while position < children.count() {
        if children[position].name == name {
            return children[position]
        }
        names.append(children[position].name)
        position = position + 1
    }
    if kind_of(current) == "list" {
        unresolved = "index {name} is out of range: {current.name} holds {held_count(current)}"
    } else if names.is_empty() {
        unresolved = "{current.name} is {described(current.class.name)}, which has no attributes"
    } else {
        unresolved = "no attribute '{name}' in {current.name}: {names.join(", ")}"
    }
    return null
}

func function_named(owner: Spite.Attribute, name: String): Spite.Function? {
    assert is_public_function(name)
    var functions = owner.value_functions()
    var symbol = Symbol(name)
    assert symbol
    return functions.find_by_name(symbol)
}

func is_public_function(name: String): Boolean {
    return not name.starts_with("_") and name != "drop"
}

func uncallable(owner: Spite.Attribute, name: String, callee: String): String {
    if name.starts_with("_") {
        return "'{name}' is private to {owner.name}, and the prompt calls what code outside the class may call"
    }
    if name == "drop" {
        return "'drop' runs when {owner.name} is released, and the prompt never runs it"
    }
    var attributes = owner.value_attributes()
    var index = 0
    while index < attributes.count() {
        if attributes[index].name == name {
            return "{callee} is not callable"
        }
        index = index + 1
    }
    return "no function '{name}' in {owner.name}: 'functions' lists them"
}

func call_in_path(owner: Spite.Attribute, part: String, callee: String): Spite.Attribute? {
    var name = called_name(part)
    var inside = inside_of(part)
    var literals = split_arguments(inside)
    var function = function_named(owner, name)
    if not function {
        unresolved = uncallable(owner, name, callee)
        return null
    }
    var result = call_found(function, literals)
    assert result
    if result.class.name == "Nothing" {
        unresolved = "{callee}() ran, and it answers nothing, so nothing can follow it"
        return null
    }
    return result
}

func answered_call(owner: Spite.Attribute, part: String, callee: String): Answer {
    var name = called_name(part)
    var inside = inside_of(part)
    var literals = split_arguments(inside)
    var function = function_named(owner, name)
    if function {
        var result = call_found(function, literals)
        if not result {
            return failure(unresolved)
        }
        if result.class.name == "Nothing" {
            return success("", "Nothing")
        }
        var shown_text = shown(result, false)
        return success(shown_text, result.class.name)
    }
    var kind = kind_of(owner)
    if name == "count" and literals.is_empty() and (kind == "list" or kind == "dictionary") {
        var held_total = held_count(owner)
        return success(held_total, "Integer")
    }
    var refusal = uncallable(owner, name, callee)
    return failure(refusal)
}

func reloaded(command: String): Answer {
    if build.hot_reload {
        if command == "reload" {
            hot_reload.reload()
            if hot_reload.answered {
                return success(hot_reload.answer, "")
            }
            return failure(hot_reload.answer)
        }
        if hot_reload.succeeded {
            return success(hot_reload.last, "")
        }
        return failure(hot_reload.last)
    }
    return failure(
        "'{command}' answers in a program built with --hot-reload, which swaps its code while it runs, and this one was not",
    )
}

func assignment_at(command: String): Integer {
    var depth = 0
    var quoted = false
    var index = 0
    var command_length = command.length()
    while index < command_length {
        var code = command.code_at(index)
        if code == 34 {
            quoted = not quoted
        }
        if not quoted {
            depth = depth + nesting(code, true)
        }
        if code == 61 and not quoted and depth == 0 {
            return index
        }
        index = index + 1
    }
    return -1
}

func nesting(code: Integer, brackets: Boolean): Integer {
    switch code {
        40: return 1
        41: return -1
        60: return 1
        62: return -1
        91: {
            if brackets {
                return 1
            }
            return 0
        }
        93: {
            if brackets {
                return -1
            }
            return 0
        }
        _: return 0
    }
}

func listed_attributes(attributes: List<Spite.Attribute>): String {
    var lines = List<String>()
    var index = 0
    while index < attributes.count() {
        lines.append("{attributes[index].name}: {attributes[index].class.name} = {shown(attributes[index], true)}")
        index = index + 1
    }
    return lines.join("\n")
}

func listed_functions(functions: List<Spite.Function>): String {
    var lines = List<String>()
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        var listed_name: String = function.name
        if is_public_function(listed_name) {
            var line = function_line(function)
            lines.append(line)
        }
        index = index + 1
    }
    return lines.join("\n")
}

func function_line(function: Spite.Function): String {
    var arguments = List<String>()
    var position = 0
    while position < function.arguments.count() {
        var argument = function.arguments[position]
        arguments.append("{argument.name}: {argument.class.name}")
        position = position + 1
    }
    return "{function.name}({arguments.join(", ")}): {function.returns.name}"
}

func kind_of(attribute: Spite.Attribute): String {
    var class_name: String = attribute.class.name
    if class_name == "String" or class_name == "Symbol" {
        return "text"
    }
    if class_name.starts_with("List<") {
        return "list"
    }
    if class_name.starts_with("Dictionary<") {
        return "dictionary"
    }
    if not attribute.value {
        return "null"
    }
    var held_attributes = attribute.value_attributes()
    var held_functions = attribute.value_functions()
    if held_attributes.is_empty() and held_functions.is_empty() {
        return "scalar"
    }
    return "instance"
}

func text_of(attribute: Spite.Attribute): String {
    if not attribute.value {
        return ""
    }
    return attribute.value.to_string()
}

func held_count(attribute: Spite.Attribute): Integer {
    var held = attribute.value_attributes()
    return held.count()
}

func shown(attribute: Spite.Attribute, nested: Boolean): String {
    var kind = kind_of(attribute)
    var class_name: String = attribute.class.name
    if kind == "list" or kind == "dictionary" {
        return "{class_name}({held_count(attribute)})"
    }
    if kind == "null" {
        return "null"
    }
    if kind != "instance" {
        return text_of(attribute)
    }
    if class_name.ends_with("?") {
        var class_name_length = class_name.length()
        class_name = class_name.slice(0, class_name_length - 1)
    }
    if nested {
        return "{class_name} \{...}"
    }
    var children = attribute.value_attributes()
    var parts = List<String>()
    var index = 0
    while index < children.count() {
        parts.append("{children[index].name}: {shown(children[index], true)}")
        index = index + 1
    }
    if parts.is_empty() {
        return "{class_name} \{}"
    }
    return "{class_name} \{ {parts.join(", ")} }"
}

func literal_text(literal: String, class_name: String): String? {
    if class_name == "String" {
        if literal.length() >= 2 and literal.starts_with("\"") and literal.ends_with("\"") {
            var literal_length = literal.length()
            return literal.slice(1, literal_length - 1)
        }
        return null
    }
    if class_name == "Boolean" {
        if literal == "true" or literal == "false" {
            return literal
        }
        return null
    }
    if class_name == "Float" or class_name == "Double" {
        if is_number(literal, true) {
            return literal
        }
        return null
    }
    if is_whole_class(class_name) {
        if is_number(literal, false) {
            return literal
        }
        return null
    }
    if literal.length() >= 2 and literal.starts_with("'") and literal.ends_with("'") {
        var literal_length = literal.length()
        return literal.slice(1, literal_length - 1)
    }
    return null
}

func is_whole_class(class_name: String): Boolean {
    var wholes = ["Integer", "Long", "Tiny", "Short", "Byte", "UnsignedShort", "UnsignedInteger", "UnsignedLong"]
    return wholes.contains(class_name)
}

func is_number(literal: String, fraction: Boolean): Boolean {
    var index = 0
    if literal.starts_with("-") {
        index = 1
    }
    var digits = 0
    var points = 0
    while index < literal.length() {
        var code = literal.code_at(index)
        if code >= 48 and code <= 57 {
            digits = digits + 1
        } else if code == 46 and fraction {
            points = points + 1
        } else {
            return false
        }
        index = index + 1
    }
    return digits > 0 and points <= 1
}

func assign(command: String, program: Spite.Attribute): Answer {
    var equals = assignment_at(command)
    var target = command.slice(0, equals).trim()
    var command_length = command.length()
    var literal = command.slice(equals + 1, command_length).trim()
    var parts = parts_of(target)
    if parts.is_empty() or target == "program" {
        return failure("program itself cannot be assigned: name one of its attributes")
    }
    var last_part = parts.last()
    crash last_part
    if is_call(last_part) {
        return failure("{target} is a call, which the loop cannot assign: name an attribute")
    }
    var found = found_at(target, program)
    if not found {
        return failure(unresolved)
    }
    var kind = kind_of(found)
    if kind != "scalar" and kind != "text" {
        return failure("{target} is {described(found.class.name)}, which the loop cannot assign")
    }
    var text = literal_text(literal, found.class.name)
    if not text {
        return failure("type mismatch: {target} is {described(found.class.name)}, and {literal} is not one")
    }
    if not found.assign(text) {
        return failure("{literal} is not {described(found.class.name)}, or {target} cannot be assigned")
    }
    var updated = found_at(target, program)
    if updated {
        var shown_text = shown(updated, false)
        return success(shown_text, updated.class.name)
    }
    return failure(unresolved)
}

func call_found(function: Spite.Function, literals: List<String>): Spite.Attribute? {
    if literals.count() != function.arguments.count() {
        unresolved = "'{function.name}' takes {function.arguments.count()} argument(s), and this call passes {literals.count()}"
        return null
    }
    var texts = List<String>()
    var index = 0
    while index < literals.count() and index < function.arguments.count() {
        var argument = function.arguments[index]
        var text = literal_text(literals[index], argument.class.name)
        if text {
            texts.append(text)
        } else {
            unresolved = "type mismatch: {argument.name} is {described(argument.class.name)}, and {literals[index]} is not one"
            return null
        }
        index = index + 1
    }
    var result = function.call_with_text(texts)
    if not result {
        unresolved = "'{function.name}' cannot take ({literals.join(", ")}): the loop writes numbers, Boolean, text and an enum's own values"
        return null
    }
    return result
}

func split_arguments(inside: String): List<String> {
    var literals = List<String>()
    if inside.is_empty() {
        return literals
    }
    var start = 0
    var quoted = false
    var index = 0
    while index < inside.length() {
        var code = inside.code_at(index)
        if code == 34 {
            quoted = not quoted
        } else if code == 44 and not quoted {
            var trimmed_slice = inside.slice(start, index).trim()
            literals.append(trimmed_slice)
            start = index + 1
        }
        index = index + 1
    }
    var inside_length = inside.length()
    var trimmed_slice = inside.slice(start, inside_length).trim()
    literals.append(trimmed_slice)
    return literals
}

func described(class_name: String): String {
    if class_name.is_empty() {
        return "a value"
    }
    var vowels = ["A", "E", "I", "O", "U"]
    var first_letter = class_name.character_at(0)
    if vowels.contains(first_letter) {
        return "an {class_name}"
    }
    return "a {class_name}"
}

func bytes_of(command: String, program: Spite.Attribute): Answer {
    var command_length = command.length()
    var target = command.slice(6, command_length).trim()
    if target.starts_with("0x") {
        return range_bytes(target)
    }
    var found = found_at(target, program)
    if not found {
        return failure(unresolved)
    }
    var held = found.held_memory()
    if held {
        return object_bytes(found, held)
    }
    var stored = found.stored_memory()
    if stored {
        return stored_bytes(target, found, stored)
    }
    return failure(
        "{target} is {described(found.class.name)} the loop reached through a call, so it is stored nowhere the loop can name: 'bytes' the attribute or element that holds it",
    )
}

func object_bytes(found: Spite.Attribute, held: Spite.Memory): Answer {
    var shown_count: Integer = held.bytes
    if shown_count > inspector.most_bytes() {
        shown_count = inspector.most_bytes()
    }
    var hex = inspector.hex_at(held.address, shown_count)
    var parts = List<String>()
    parts.append("\"class\":\"{json_text(found.class.name)}\"")
    parts.append("\"address\":\"{inspector.address_text(held.address)}\"")
    parts.append("\"bytes\":{held.bytes}")
    if hex {
        parts.append("\"hex\":\"{hex}\"")
    } else {
        parts.append("\"unreadable\":true")
    }
    if kind_of(found) == "instance" {
        var fields = field_entries(found, held.address)
        parts.append("\"fields\":[{fields}]")
    }
    var buffer = found.buffer_memory()
    if buffer {
        var buffer_entry = buffer_bytes(buffer)
        parts.append("\"buffer\":{buffer_entry}")
    }
    return success("\{{parts.join(",")}}", "")
}

func field_entries(found: Spite.Attribute, start: Long): String {
    var entries = List<String>()
    var children = found.value_attributes()
    var index = 0
    while index < children.count() {
        var child = children[index]
        var stored = child.stored_memory()
        if stored {
            var entry = field_entry(child, stored, start)
            entries.append(entry)
        }
        index = index + 1
    }
    return entries.join(",")
}

func field_entry(child: Spite.Attribute, stored: Spite.Memory, start: Long): String {
    var offset = stored.address - start
    var shown_value = shown(child, true)
    var name_text = json_text(child.name)
    var class_text = json_text(child.class.name)
    var value_text = json_text(shown_value)
    return "\{\"name\":\"{name_text}\",\"class\":\"{class_text}\",\"offset\":{offset},\"bytes\":{stored.bytes},\"value\":\"{value_text}\"}"
}

func buffer_bytes(buffer: Spite.Memory): String {
    var shown_count: Integer = buffer.bytes
    if shown_count > inspector.most_bytes() {
        shown_count = inspector.most_bytes()
    }
    var address_text = inspector.address_text(buffer.address)
    var hex = inspector.hex_at(buffer.address, shown_count)
    if not hex {
        return "\{\"address\":\"{address_text}\",\"bytes\":{buffer.bytes},\"unreadable\":true}"
    }
    return "\{\"address\":\"{address_text}\",\"bytes\":{buffer.bytes},\"shown\":{shown_count},\"hex\":\"{hex}\"}"
}

func stored_bytes(target: String, found: Spite.Attribute, stored: Spite.Memory): Answer {
    var byte_count: Integer = stored.bytes
    var address_text = inspector.address_text(stored.address)
    var hex = inspector.hex_at(stored.address, byte_count)
    if not hex {
        return failure("unreadable: {address_text} for {byte_count} bytes, which {target} names")
    }
    var shown_value = shown(found, true)
    var class_text = json_text(found.class.name)
    var value_text = json_text(shown_value)
    return success(
        "\{\"class\":\"{class_text}\",\"address\":\"{address_text}\",\"bytes\":{byte_count},\"hex\":\"{hex}\",\"value\":\"{value_text}\"}",
        "",
    )
}

func range_bytes(target: String): Answer {
    var words = target.split(" ")
    var usage = "'bytes' reads an address as 'bytes 0x1f2a40 64': an address in hexadecimal and a number of bytes"
    if words.count() != 2 {
        return failure(usage)
    }
    var address_word = words[0]
    var count_word = words[1]
    var address = hex_number(address_word)
    var byte_count = count_word.to_integer()
    if not address or not byte_count {
        return failure(usage)
    }
    if byte_count < 1 or byte_count > inspector.most_bytes() {
        return failure("'bytes' reads from 1 to {inspector.most_bytes()} bytes at a time, and {byte_count} is not in that range")
    }
    var address_text = inspector.address_text(address)
    var hex = inspector.hex_at(address, byte_count)
    if not hex {
        return failure("unreadable: {address_text} for {byte_count} bytes")
    }
    return success("\{\"address\":\"{address_text}\",\"bytes\":{byte_count},\"hex\":\"{hex}\"}", "")
}

func hex_number(text: String): Long? {
    var digits = "0123456789abcdef"
    var text_length = text.length()
    assert text_length >= 3 and text_length <= 18
    var value: Long = 0
    var index = 2
    while index < text_length {
        var character = text.character_at(index)
        var digit = digits.index_of(character)
        assert digit >= 0
        value = value * 16 + digit
        index = index + 1
    }
    return value
}
