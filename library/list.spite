generic $element_type

var heap = Memory.Heap()
var values = TypedMemory<$element_type>()
var items: Memory.Address = 0
var item_count = 0
var capacity = 0

func count(): Integer {
    return item_count
}

func is_empty(): Boolean {
    return item_count == 0
}

func append(value: $element_type) {
    make_room()
    values.write_value(items, item_count, value)
    item_count = item_count + 1
}

func prepend(value: $element_type) {
    insert(0, value)
}

func insert(index: Integer, value: $element_type) {
    var position = index
    if position < 0 {
        position = 0
    }
    if position > item_count {
        position = item_count
    }
    make_room()
    move_items(position, position + 1, item_count - position)
    values.write_value(items, position, value)
    item_count = item_count + 1
}

func get_at(index: Integer): $element_type? {
    if index >= 0 and index < item_count {
        return values.read_value(items, index)
    }
    return null
}

func set_at(index: Integer, value: $element_type) {
    crash index >= 0 and index < item_count
    values.release_value(items, index)
    values.write_value(items, index, value)
}

func remove_at(index: Integer) {
    crash index >= 0 and index < item_count
    values.release_value(items, index)
    move_items(index + 1, index, item_count - index - 1)
    item_count = item_count - 1
}

func remove_swapping(index: Integer) {
    crash index >= 0 and index < item_count
    values.release_value(items, index)
    var final_index = item_count - 1
    if index != final_index {
        var bytes = values.value_bytes()
        var final_item: Memory.Address = items + bytes * final_index
        final_item.copy_to(items + bytes * index, bytes)
    }
    item_count = final_index
}

func remove_last(): $element_type? {
    if item_count > 0 {
        var last_item = values.read_value(items, item_count - 1)
        values.release_value(items, item_count - 1)
        item_count = item_count - 1
        return last_item
    }
    return null
}

func remove_first(): $element_type? {
    if item_count > 0 {
        var first_item = values.read_value(items, 0)
        remove_at(0)
        return first_item
    }
    return null
}

func truncate(kept_count: Integer) {
    if kept_count >= 0 and kept_count < item_count {
        var index = kept_count
        while index < item_count {
            values.release_value(items, index)
            index = index + 1
        }
        item_count = kept_count
    }
}

func swap(first_index: Integer, second_index: Integer) {
    var first_in = first_index >= 0 and first_index < item_count
    if first_in and second_index >= 0 and second_index < item_count {
        values.swap_values(items, first_index, second_index)
    }
}

func first(): $element_type? {
    if item_count > 0 {
        return values.read_value(items, 0)
    }
    return null
}

func last(): $element_type? {
    if item_count > 0 {
        return values.read_value(items, item_count - 1)
    }
    return null
}

func clear() {
    var index = 0
    while index < item_count {
        values.release_value(items, index)
        index = index + 1
    }
    item_count = 0
}

func reverse() {
    if item_count > 1 {
        var bytes = values.value_bytes()
        var spare = heap.allocate(bytes)
        var front: Long = 0
        var back: Long = item_count - 1
        while front < back {
            var front_item: Memory.Address = items + front * bytes
            var back_item: Memory.Address = items + back * bytes
            front_item.copy_to(spare, bytes)
            back_item.copy_to(front_item, bytes)
            spare.copy_to(items + back * bytes, bytes)
            front = front + 1
            back = back - 1
        }
        heap.free(spare)
    }
}

func contains(value: $element_type): Boolean {
    var index = 0
    while index < item_count {
        if values.read_value(items, index) == value {
            return true
        }
        index = index + 1
    }
    return false
}

func index_of(value: $element_type): Integer? {
    var index = 0
    while index < item_count {
        if values.read_value(items, index) == value {
            return index
        }
        index = index + 1
    }
    return null
}

func join(separator: String): String {
    var pieces = List<String>()
    var total: Long = 0
    var index = 0
    while index < item_count {
        var piece: String = values.read_value(items, index)
        total = total + piece.length()
        pieces.append(piece)
        index = index + 1
    }
    if item_count > 1 {
        total = total + separator.length() * (item_count - 1)
    }
    var address = heap.allocate(total + 1)
    var position: Long = 0
    index = 0
    while index < pieces.count() {
        if index > 0 {
            position = write_text(separator, address, position)
        }
        var next_piece = pieces[index]
        position = write_text(next_piece, address, position)
        index = index + 1
    }
    var joined = address.text(total)
    heap.free(address)
    return joined
}

func to_utf8_text(): String? {
    crash $element_type == Byte
    var index = 0
    while index < item_count {
        var sequence_length = _utf8_length_at(index)
        assert sequence_length != 0
        index = index + sequence_length
    }
    if item_count == 0 {
        return ""
    }
    return items.text(item_count)
}

func _utf8_length_at(index: Integer): Integer {
    var lead: Integer = values.read_value(items, index)
    var length = _utf8_length_of(lead)
    if length <= 1 {
        return length
    }
    if index + length > item_count {
        return 0
    }
    var second: Integer = values.read_value(items, index + 1)
    if second < _utf8_lowest_second(lead) or second > _utf8_highest_second(lead) {
        return 0
    }
    var position = 2
    while position < length {
        var following: Integer = values.read_value(items, index + position)
        if following < 128 or following > 191 {
            return 0
        }
        position = position + 1
    }
    return length
}

func _utf8_length_of(lead: Integer): Integer {
    if lead < 128 {
        return 1
    }
    if lead >= 194 and lead <= 223 {
        return 2
    }
    if lead >= 224 and lead <= 239 {
        return 3
    }
    if lead >= 240 and lead <= 244 {
        return 4
    }
    return 0
}

func _utf8_lowest_second(lead: Integer): Integer {
    if lead == 224 {
        return 160
    }
    if lead == 240 {
        return 144
    }
    return 128
}

func _utf8_highest_second(lead: Integer): Integer {
    if lead == 237 {
        return 159
    }
    if lead == 244 {
        return 143
    }
    return 191
}

func write_text(text: String, address: Memory.Address, position: Long): Long {
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        address.write_byte(position + index, code)
        index = index + 1
    }
    return position + text.length()
}

func copy(): List<$element_type> {
    var copied = List<$element_type>()
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        copied.append(item)
        index = index + 1
    }
    return copied
}

func filter_member(member: Spite.AttributeDeclaration<$element_type>): List<$element_type> {
    var filtered = List<$element_type>()
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        if item.attributes[member] {
            filtered.append(item)
        }
        index = index + 1
    }
    return filtered
}

func remove_where_member(member: Spite.AttributeDeclaration<$element_type>) {
    var kept = 0
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        var keep = true
        if item.attributes[member] {
            keep = false
        }
        if keep {
            if kept != index and index < item_count {
                values.swap_values(items, kept, index)
            }
            kept = kept + 1
        }
        index = index + 1
    }
    truncate(kept)
}

func count_member(member: Spite.AttributeDeclaration<$element_type>): Integer {
    var counted = 0
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        if item.attributes[member] {
            counted = counted + 1
        }
        index = index + 1
    }
    return counted
}

func any_member(member: Spite.AttributeDeclaration<$element_type>): Boolean {
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        if item.attributes[member] {
            return true
        }
        index = index + 1
    }
    return false
}

func all_member(member: Spite.AttributeDeclaration<$element_type>): Boolean {
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        if not item.attributes[member] {
            return false
        }
        index = index + 1
    }
    return true
}

func sum_member(member: Spite.AttributeDeclaration<$element_type>): member.class {
    var total: member.class = 0
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        total = total + item.attributes[member]
        index = index + 1
    }
    return total
}

func each_member(member: Spite.AttributeDeclaration<$element_type>) {
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        item.attributes[member]
        index = index + 1
    }
}

func map_members(member: Spite.AttributeDeclaration<$element_type>): List<member.class> {
    var mapped = List<member.class>()
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        var value = item.attributes[member]
        mapped.append(value)
        index = index + 1
    }
    return mapped
}

func find_by_member(member: Spite.AttributeDeclaration<$element_type>, value: member.class): $element_type? {
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        if item.attributes[member] == value {
            return item
        }
        index = index + 1
    }
    return null
}

func find_index_by_member(member: Spite.AttributeDeclaration<$element_type>, value: member.class): Integer? {
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        if item.attributes[member] == value {
            return index
        }
        index = index + 1
    }
    return null
}

func sort_by_member(member: Spite.AttributeDeclaration<$element_type>): List<$element_type> {
    var keys = List<member.class>()
    var order = List<Integer>()
    var index = 0
    while index < item_count {
        var item = values.read_value(items, index)
        var key = item.attributes[member]
        keys.append(key)
        order.append(index)
        index = index + 1
    }
    var merged = order.copy()
    var width = 1
    while width < item_count {
        var start = 0
        while start < item_count {
            var middle = start + width
            if middle > item_count {
                middle = item_count
            }
            var end = middle + width
            if end > item_count {
                end = item_count
            }
            var left = start
            var right = middle
            var placed = start
            while placed < end {
                var takes_left = right >= end
                if left < middle and not takes_left {
                    crash order[left]
                    crash order[right]
                    var left_position = order[left]
                    var right_position = order[right]
                    crash keys[left_position]
                    crash keys[right_position]
                    var left_key = keys[left_position]
                    var right_key = keys[right_position]
                    var right_first = left_key > right_key
                    takes_left = not right_first
                }
                var taken = right
                if takes_left {
                    taken = left
                    left = left + 1
                } else {
                    right = right + 1
                }
                crash order[taken]
                var position = order[taken]
                merged[placed] = position
                placed = placed + 1
            }
            start = end
        }
        var previous = order
        order = merged
        merged = previous
        width = width * 2
    }
    var sorted = List<$element_type>()
    index = 0
    while index < item_count {
        crash order[index]
        var source = order[index]
        var item = values.read_value(items, source)
        sorted.append(item)
        index = index + 1
    }
    return sorted
}

func drop() {
    clear()
    if items != 0 {
        memory.allocator.free(items)
    }
}

func reserve(wanted: Integer) {
    if wanted > capacity {
        var grown = capacity * 2
        if grown < wanted {
            grown = wanted
        }
        var bytes = values.value_bytes()
        items = _resized(bytes * capacity, bytes * grown)
        capacity = grown
    }
}

func make_room() {
    if item_count == capacity {
        _grow()
    }
}

func _grow() {
    var grown = capacity * 2
    if capacity == 0 {
        grown = 4
    }
    var bytes = values.value_bytes()
    items = _resized(bytes * capacity, bytes * grown)
    capacity = grown
}

func _resized(old_bytes: Long, new_bytes: Long): Memory.Address {
    if memory.allocator == Memory.Heap {
        return heap.resize(items, new_bytes)
    }
    var moved = memory.allocator.allocate(new_bytes)
    if items != 0 {
        items.copy_to(moved, old_bytes)
        memory.allocator.free(items)
    }
    return moved
}

func move_items(from: Integer, to: Integer, moved_count: Integer) {
    var bytes = values.value_bytes()
    var moved_items: Memory.Address = items + bytes * from
    moved_items.copy_to(items + bytes * to, bytes * moved_count)
}
