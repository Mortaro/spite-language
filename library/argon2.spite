func hash(password: String): String {
    var salt = random.bytes(16)
    var secret = password.to_bytes()
    var tag = derive(secret, salt, 3, 65536, 1, 32)
    return _encoded(salt, tag, 3, 65536, 1)
}

func verify(password: String, encoded: String): Boolean? {
    var fields = encoded.split("$")
    assert fields.count() == 6
    assert fields[0] == "" and fields[2] == "v=19"
    var variant = _type_named(fields[1])
    assert variant >= 0
    var costs = fields[3].split(",")
    assert costs.count() == 3
    var memory_cost = _cost(costs[0], "m=")
    var time_cost = _cost(costs[1], "t=")
    var lanes = _cost(costs[2], "p=")
    assert memory_cost and time_cost and lanes
    assert memory_cost > 0 and time_cost > 0 and lanes > 0
    var salt = _unpadded(fields[4])
    var expected = _unpadded(fields[5])
    assert salt and expected
    assert expected.count() >= 4 and salt.count() >= 8
    var secret = password.to_bytes()
    var nothing = Buffer(0)
    var tag_length = expected.count()
    var tag = _derived(variant, secret, salt, nothing, nothing, time_cost, memory_cost, lanes, tag_length)
    return _same_bytes(tag, expected)
}

func derive(
    password: Buffer,
    salt: Buffer,
    time_cost: Integer,
    memory_cost: Integer,
    lanes: Integer,
    tag_length: Integer,
): Buffer {
    var nothing = Buffer(0)
    return _derived(2, password, salt, nothing, nothing, time_cost, memory_cost, lanes, tag_length)
}

func _type_named(name: String): Integer {
    switch name {
        "argon2d": return 0
        "argon2i": return 1
        "argon2id": return 2
        _: return -1
    }
}

func _cost(field: String, prefix: String): Integer? {
    assert field.starts_with(prefix)
    var field_length = field.length()
    var digits = field.slice(2, field_length)
    return digits.to_integer()
}

func _unpadded(text: String): Buffer? {
    var padded = text
    while padded.length() % 4 != 0 {
        padded = "{padded}="
    }
    return base64.decode(padded)
}

func _encoded(salt: Buffer, tag: Buffer, time_cost: Integer, memory_cost: Integer, lanes: Integer): String {
    var salt_text = base64.encode(salt)
    var tag_text = base64.encode(tag)
    var salt_bare = salt_text.replace("=", "")
    var tag_bare = tag_text.replace("=", "")
    return "$argon2id$v=19$m={memory_cost},t={time_cost},p={lanes}${salt_bare}${tag_bare}"
}

func _same_bytes(left: Buffer, right: Buffer): Boolean {
    var left_count = left.count()
    crash left_count == right.count()
    var difference = 0
    var index = 0
    while index < left_count {
        var left_byte: Integer = _byte(left, index)
        var right_byte: Integer = _byte(right, index)
        var differing = left_byte.bits_exclusive_or(right_byte)
        difference = difference.bits_or(differing)
        index = index + 1
    }
    return difference == 0
}

func _byte(bytes: Buffer, index: Integer): Byte {
    var value = bytes[index]
    crash value
    return value
}

func _long_at(bytes: Buffer, at: Integer): Long {
    var value = bytes.read_long_little_endian_at(at)
    crash value
    return value
}

func _word(words: List<Long>, index: Integer): Long {
    var value = words[index]
    crash value
    return value
}

func _derived(
    variant: Integer,
    password: Buffer,
    salt: Buffer,
    secret: Buffer,
    associated: Buffer,
    time_cost: Integer,
    memory_cost: Integer,
    lanes: Integer,
    tag_length: Integer,
): Buffer {
    crash lanes >= 1 and time_cost >= 1 and tag_length >= 4
    crash memory_cost >= 8 * lanes
    var password_count = password.count()
    var salt_count = salt.count()
    var secret_count = secret.count()
    var associated_count = associated.count()
    var parameters = Buffer(40 + password_count + salt_count + secret_count + associated_count)
    _append_word(parameters, lanes)
    _append_word(parameters, tag_length)
    _append_word(parameters, memory_cost)
    _append_word(parameters, time_cost)
    _append_word(parameters, 19)
    _append_word(parameters, variant)
    _append_counted(parameters, password)
    _append_counted(parameters, salt)
    _append_counted(parameters, secret)
    _append_counted(parameters, associated)
    var engine = List<Long>()
    engine.reserve(24)
    var cleared_engine = 0
    while cleared_engine < 24 {
        engine.append(0)
        cleared_engine = cleared_engine + 1
    }
    var tail = Buffer(128)
    var prefixed = Buffer(1028)
    var digest = Buffer(64)
    var chain = Buffer(64)
    var hashed = Buffer(1024)
    var seeded = Buffer(1024)
    _blake2b(engine, tail, parameters, 64, digest)
    seeded.append_bytes(digest, 0, 64)
    var segment_length = memory_cost / (4 * lanes)
    var lane_length = segment_length * 4
    var block_count = lane_length * lanes
    var work = block_count * 128
    var memory = List<Long>()
    memory.reserve(work + 640)
    var cleared = 0
    while cleared < work + 640 {
        memory.append(0)
        cleared = cleared + 1
    }
    var lane = 0
    while lane < lanes {
        var column = 0
        while column < 2 {
            seeded.truncate(64)
            seeded.append_integer_little_endian(column)
            seeded.append_integer_little_endian(lane)
            hashed.clear()
            _long_hash(engine, tail, prefixed, digest, chain, seeded, 1024, hashed)
            var target = _block(lane * lane_length + column)
            var word = 0
            while word < 128 {
                memory[target + word] = _long_at(hashed, word * 8)
                word = word + 1
            }
            column = column + 1
        }
        lane = lane + 1
    }
    var pass = 0
    while pass < time_cost {
        var slice = 0
        while slice < 4 {
            lane = 0
            while lane < lanes {
                _fill_segment(
                    variant,
                    memory,
                    work,
                    pass,
                    slice,
                    lane,
                    lanes,
                    lane_length,
                    segment_length,
                    time_cost,
                    block_count,
                )
                lane = lane + 1
            }
            slice = slice + 1
        }
        pass = pass + 1
    }
    var last = _block(lane_length - 1)
    var word = 0
    while word < 128 {
        memory[work + word] = _word(memory, last + word)
        word = word + 1
    }
    lane = 1
    while lane < lanes {
        var lane_last = _block(lane * lane_length + lane_length - 1)
        _xor_into(memory, work, lane_last)
        lane = lane + 1
    }
    seeded.clear()
    word = 0
    while word < 128 {
        var held = memory[work + word]
        crash held
        seeded.append_long_little_endian(held)
        word = word + 1
    }
    var tag = Buffer(tag_length)
    _long_hash(engine, tail, prefixed, digest, chain, seeded, tag_length, tag)
    return tag
}

func _append_word(bytes: Buffer, value: Integer) {
    var shift = 0
    while shift < 32 {
        var piece: Byte = value.shifted_right(shift).bits_and(255)
        bytes.append(piece)
        shift = shift + 8
    }
}

func _append_counted(bytes: Buffer, added: Buffer) {
    var added_count = added.count()
    _append_word(bytes, added_count)
    bytes.append_bytes(added, 0, added_count)
}

func _block(index: Integer): Integer {
    return index * 128
}

func _xor_into(memory: List<Long>, target: Integer, source: Integer) {
    var offset = 0
    while offset < 128 {
        var held = memory[target + offset]
        crash held
        var other = memory[source + offset]
        crash other
        var mixed = held.bits_exclusive_or(other)
        memory[target + offset] = mixed
        offset = offset + 1
    }
}

func _fill_segment(
    variant: Integer,
    memory: List<Long>,
    work: Integer,
    pass: Integer,
    slice: Integer,
    lane: Integer,
    lanes: Integer,
    lane_length: Integer,
    segment_length: Integer,
    time_cost: Integer,
    block_count: Integer,
) {
    var independent = variant == 1 or variant == 2 and pass == 0 and slice < 2
    var zero_block = work + 128
    var address_block = work + 256
    var input_block = work
    if independent {
        _clear(memory, zero_block)
        _clear(memory, input_block)
        memory[input_block] = pass
        memory[input_block + 1] = lane
        memory[input_block + 2] = slice
        memory[input_block + 3] = block_count
        memory[input_block + 4] = time_cost
        memory[input_block + 5] = variant
    }
    var index = 0
    if pass == 0 and slice == 0 {
        index = 2
        if independent {
            _next_addresses(memory, input_block, zero_block, address_block)
        }
    }
    while index < segment_length {
        var column = slice * segment_length + index
        var current = lane * lane_length + column
        var previous = current - 1
        if column == 0 {
            previous = current + lane_length - 1
        }
        var random_value: Long = 0
        if independent {
            if index % 128 == 0 {
                _next_addresses(memory, input_block, zero_block, address_block)
            }
            var slot = index % 128
            var random_value_raw = memory[address_block + slot]
            crash random_value_raw
            random_value = random_value_raw
        } else {
            var previous_block = _block(previous)
            var random_value_raw = memory[previous_block]
            crash random_value_raw
            random_value = random_value_raw
        }
        var reference_lane = lane
        if pass > 0 or slice > 0 {
            var high = random_value.bits_as_unsigned()
            var lane_pick = high.shifted_right(32) % lanes
            reference_lane = lane_pick
        }
        var same_lane = reference_lane == lane
        var area = _reference_area(pass, slice, index, same_lane, lane_length, segment_length)
        var low = random_value.bits_as_unsigned()
        low = low.bits_and(4294967295)
        var squared = low * low
        squared = squared.shifted_right(32)
        var wide_area: UnsignedLong = area
        var scaled = wide_area * squared
        scaled = scaled.shifted_right(32)
        var relative: Long = area - 1
        relative = relative - scaled
        var start: Long = 0
        if pass > 0 and slice < 3 {
            start = (slice + 1) * segment_length
        }
        var reference_column = (start + relative) % lane_length
        var reference: Long = reference_lane * lane_length
        reference = reference + reference_column
        var reference_index: Integer = reference
        var mixed = work + 384
        var previous_at = _block(previous)
        var reference_at = _block(reference_index)
        var current_at = _block(current)
        _compress(memory, previous_at, reference_at, current_at, pass > 0, mixed)
        index = index + 1
    }
}

func _reference_area(
    pass: Integer,
    slice: Integer,
    index: Integer,
    same_lane: Boolean,
    lane_length: Integer,
    segment_length: Integer,
): Long {
    var finished: Long = slice * segment_length
    if pass > 0 {
        finished = lane_length - segment_length
    }
    if pass == 0 and slice == 0 or same_lane {
        return finished + index - 1
    }
    if index == 0 {
        return finished - 1
    }
    return finished
}

func _clear(memory: List<Long>, block: Integer) {
    var offset = 0
    while offset < 128 {
        memory[block + offset] = 0
        offset = offset + 1
    }
}

func _next_addresses(memory: List<Long>, input_block: Integer, zero_block: Integer, address_block: Integer) {
    var counter = memory[input_block + 6]
    crash counter
    memory[input_block + 6] = counter + 1
    var mixed = input_block + 384
    _compress(memory, zero_block, input_block, address_block, false, mixed)
    _compress(memory, zero_block, address_block, address_block, false, mixed)
}

func _compress(
    memory: List<Long>,
    previous: Integer,
    reference: Integer,
    target: Integer,
    keep: Boolean,
    mixed: Integer,
) {
    var saved = mixed + 128
    var offset = 0
    while offset < 128 {
        var left = memory[previous + offset]
        crash left
        var right = memory[reference + offset]
        crash right
        var both = left.bits_exclusive_or(right)
        memory[mixed + offset] = both
        if keep {
            var old = memory[target + offset]
            crash old
            both = both.bits_exclusive_or(old)
        }
        memory[saved + offset] = both
        offset = offset + 1
    }
    var row = 0
    while row < 8 {
        var row_start = mixed + row * 16
        _permute(memory, row_start, 2, 1)
        row = row + 1
    }
    var column = 0
    while column < 8 {
        var column_start = mixed + column * 2
        _permute(memory, column_start, 16, 1)
        column = column + 1
    }
    offset = 0
    while offset < 128 {
        var kept = memory[saved + offset]
        crash kept
        var permuted = memory[mixed + offset]
        crash permuted
        var result = kept.bits_exclusive_or(permuted)
        memory[target + offset] = result
        offset = offset + 1
    }
}

func _offset(word: Integer, pair_step: Integer, word_step: Integer): Integer {
    return word / 2 * pair_step + word % 2 * word_step
}

func _permute(memory: List<Long>, start: Integer, pair_step: Integer, word_step: Integer) {
    var step = 0
    while step < 8 {
        var lane = step % 4
        var first = lane
        var second = 4 + lane
        var third = 8 + lane
        var fourth = 12 + lane
        if step >= 4 {
            second = 4 + (lane + 1) % 4
            third = 8 + (lane + 2) % 4
            fourth = 12 + (lane + 3) % 4
        }
        var at_a = start + _offset(first, pair_step, word_step)
        var at_b = start + _offset(second, pair_step, word_step)
        var at_c = start + _offset(third, pair_step, word_step)
        var at_d = start + _offset(fourth, pair_step, word_step)
        var word_a_raw = memory[at_a]
        crash word_a_raw
        var word_b_raw = memory[at_b]
        crash word_b_raw
        var word_c_raw = memory[at_c]
        crash word_c_raw
        var word_d_raw = memory[at_d]
        crash word_d_raw
        var word_a = word_a_raw.bits_as_unsigned()
        var word_b = word_b_raw.bits_as_unsigned()
        var word_c = word_c_raw.bits_as_unsigned()
        var word_d = word_d_raw.bits_as_unsigned()
        word_a = _multiplied_sum(word_a, word_b)
        word_d = _rotated_exclusive_or(word_d, word_a, 32)
        word_c = _multiplied_sum(word_c, word_d)
        word_b = _rotated_exclusive_or(word_b, word_c, 24)
        word_a = _multiplied_sum(word_a, word_b)
        word_d = _rotated_exclusive_or(word_d, word_a, 16)
        word_c = _multiplied_sum(word_c, word_d)
        word_b = _rotated_exclusive_or(word_b, word_c, 63)
        var signed_a = word_a.bits_as_signed()
        memory[at_a] = signed_a
        var signed_b = word_b.bits_as_signed()
        memory[at_b] = signed_b
        var signed_c = word_c.bits_as_signed()
        memory[at_c] = signed_c
        var signed_d = word_d.bits_as_signed()
        memory[at_d] = signed_d
        step = step + 1
    }
}

func _multiplied_sum(left: UnsignedLong, right: UnsignedLong): UnsignedLong {
    var low_left = left.bits_and(4294967295)
    var low_right = right.bits_and(4294967295)
    var product = low_left * low_right
    return left.wrapping_sum(right).wrapping_sum(product).wrapping_sum(product)
}

func _rotated_exclusive_or(value: UnsignedLong, other: UnsignedLong, count: Integer): UnsignedLong {
    var mixed = value.bits_exclusive_or(other)
    var right = mixed.shifted_right(count)
    var left = mixed.shifted_left(64 - count)
    return right.bits_or(left)
}

func _long_hash(
    engine: List<Long>,
    tail: Buffer,
    prefixed: Buffer,
    digest: Buffer,
    chain: Buffer,
    input: Buffer,
    output_length: Integer,
    output: Buffer,
) {
    var input_count = input.count()
    prefixed.clear()
    prefixed.append_integer_little_endian(output_length)
    prefixed.append_bytes(input, 0, input_count)
    digest.clear()
    if output_length <= 64 {
        _blake2b(engine, tail, prefixed, output_length, digest)
        output.append_bytes(digest, 0, output_length)
        return
    }
    chain.clear()
    _blake2b(engine, tail, prefixed, 64, chain)
    output.append_bytes(chain, 0, 32)
    var written = 32
    while output_length - written > 64 {
        digest.clear()
        _blake2b(engine, tail, chain, 64, digest)
        chain.clear()
        chain.append_bytes(digest, 0, 64)
        output.append_bytes(chain, 0, 32)
        written = written + 32
    }
    var last_length = output_length - written
    digest.clear()
    _blake2b(engine, tail, chain, last_length, digest)
    output.append_bytes(digest, 0, last_length)
}

func _blake2b(engine: List<Long>, tail: Buffer, input: Buffer, output_length: Integer, digest: Buffer) {
    var input_length = input.count()
    var index = 0
    while index < 8 {
        crash _blake_initial[index]
        var initial = _blake_initial[index]
        engine[index] = initial
        index = index + 1
    }
    var first: Long = _word(engine, 0)
    var parameter: Long = output_length
    parameter = parameter.bits_or(16842752)
    first = first.bits_exclusive_or(parameter)
    engine[0] = first
    var offset = 0
    while input_length - offset > 128 {
        offset = offset + 128
        var counter: Long = offset
        var block_start = offset - 128
        _blake_compress(engine, input, block_start, counter, false)
    }
    tail.clear()
    var remaining = input_length - offset
    tail.append_bytes(input, offset, remaining)
    while tail.count() < 128 {
        tail.append(0)
    }
    var total: Long = input_length
    _blake_compress(engine, tail, 0, total, true)
    index = 0
    while index < 8 {
        var held = engine[index]
        crash held
        digest.append_long_little_endian(held)
        index = index + 1
    }
    digest.truncate(output_length)
}

func _blake_compress(engine: List<Long>, block: Buffer, base: Integer, counter: Long, last: Boolean) {
    var index = 0
    while index < 8 {
        var held = engine[index]
        crash held
        engine[8 + index] = held
        crash _blake_initial[index]
        var initial = _blake_initial[index]
        engine[16 + index] = initial
        index = index + 1
    }
    var twelfth: Long = _word(engine, 20)
    twelfth = twelfth.bits_exclusive_or(counter)
    engine[20] = twelfth
    if last {
        var fifteenth: Long = _word(engine, 22)
        fifteenth = fifteenth.bits_inverted()
        engine[22] = fifteenth
    }
    var round = 0
    while round < 12 {
        var order = round % 10 * 16
        _blake_mix(engine, block, base, 8, 12, 16, 20, order)
        _blake_mix(engine, block, base, 9, 13, 17, 21, order + 2)
        _blake_mix(engine, block, base, 10, 14, 18, 22, order + 4)
        _blake_mix(engine, block, base, 11, 15, 19, 23, order + 6)
        _blake_mix(engine, block, base, 8, 13, 18, 23, order + 8)
        _blake_mix(engine, block, base, 9, 14, 19, 20, order + 10)
        _blake_mix(engine, block, base, 10, 15, 16, 21, order + 12)
        _blake_mix(engine, block, base, 11, 12, 17, 22, order + 14)
        round = round + 1
    }
    index = 0
    while index < 8 {
        var held = engine[index]
        crash held
        var low = engine[8 + index]
        crash low
        var high = engine[16 + index]
        crash high
        var mixed = held.bits_exclusive_or(low).bits_exclusive_or(high)
        engine[index] = mixed
        index = index + 1
    }
}

func _blake_mix(
    work: List<Long>,
    block: Buffer,
    base: Integer,
    first: Integer,
    second: Integer,
    third: Integer,
    fourth: Integer,
    order: Integer,
) {
    crash _blake_order[order]
    var x_index = _blake_order[order]
    crash _blake_order[order + 1]
    var y_index = _blake_order[order + 1]
    var message_x_raw = block.read_long_little_endian_at(base + x_index * 8)
    crash message_x_raw
    var message_x = message_x_raw.bits_as_unsigned()
    var message_y_raw = block.read_long_little_endian_at(base + y_index * 8)
    crash message_y_raw
    var message_y = message_y_raw.bits_as_unsigned()
    var word_a_raw = work[first]
    crash word_a_raw
    var word_a = word_a_raw.bits_as_unsigned()
    var word_b_raw = work[second]
    crash word_b_raw
    var word_b = word_b_raw.bits_as_unsigned()
    var word_c_raw = work[third]
    crash word_c_raw
    var word_c = word_c_raw.bits_as_unsigned()
    var word_d_raw = work[fourth]
    crash word_d_raw
    var word_d = word_d_raw.bits_as_unsigned()
    word_a = word_a.wrapping_sum(word_b).wrapping_sum(message_x)
    word_d = _rotated_exclusive_or(word_d, word_a, 32)
    word_c = word_c.wrapping_sum(word_d)
    word_b = _rotated_exclusive_or(word_b, word_c, 24)
    word_a = word_a.wrapping_sum(word_b).wrapping_sum(message_y)
    word_d = _rotated_exclusive_or(word_d, word_a, 16)
    word_c = word_c.wrapping_sum(word_d)
    word_b = _rotated_exclusive_or(word_b, word_c, 63)
    var signed_a = word_a.bits_as_signed()
    work[first] = signed_a
    var signed_b = word_b.bits_as_signed()
    work[second] = signed_b
    var signed_c = word_c.bits_as_signed()
    work[third] = signed_c
    var signed_d = word_d.bits_as_signed()
    work[fourth] = signed_d
}
