generic $result_type

var _pool = ThreadPool()
var _heap = Memory.Heap()
var _call = ParallelCall<$result_type>()
var _state = _heap.allocate(8)

func Parallel(starting_work: Spite.Function<$result_type>) {
    _call.work = starting_work
    _pool.submit(_call.run, 0, 0, _state)
}

func get_finished(): Boolean {
    return _state.read_long_atomically(0) == 2
}

func _result(): $result_type {
    _join()
    return _call.results.get_at(0)
}

func _join() {
    if not get_finished() {
        _pool.join(_state)
    }
}

func drop() {
    _join()
    _heap.free(_state)
}
