var path = ""

func Directory(starting_path: String) {
    path = starting_path
}

func files(): List<String> {
    return sorted(entries(false))
}

func folders(): List<String> {
    return sorted(entries(true))
}

func sorted(names: List<String>): List<String> {
    var result = List<String>()
    var index = 0
    while index < names.count() {
        var position = result.count()
        var placed = false
        while position > 0 and not placed {
            var before = position - 1
            crash before < result.count()
            if result[before] > names[index] {
                position = before
            } else {
                placed = true
            }
        }
        result.insert(position, names[index])
        index = index + 1
    }
    return result
}
