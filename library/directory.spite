union Entry {
    Directory
    File
}

var path = ""

func Directory(starting_path: String) {
    path = starting_path
}

func get_name(): String {
    var end = path.length()
    while end > 1 and path.code_at(end - 1) == 47 {
        end = end - 1
    }
    var start = end
    while start > 0 and path.code_at(start - 1) != 47 and path.code_at(start - 1) != 92 {
        start = start - 1
    }
    return path.slice(start, end)
}

func files(): List<String> {
    var names = entry_names(false)
    return sorted(names)
}

func folders(): List<String> {
    var names = entry_names(true)
    return sorted(names)
}

func entries(): List<Entry> {
    var result = List<Entry>()
    var folder_names = folders()
    var index = 0
    while index < folder_names.count() {
        var folder_name = folder_names[index]
        var folder_path = inside(folder_name)
        var directory = Directory(folder_path)
        result.append(directory)
        index = index + 1
    }
    var file_names = files()
    index = 0
    while index < file_names.count() {
        var file_name = file_names[index]
        var file_path = inside(file_name)
        var file = File(file_path)
        result.append(file)
        index = index + 1
    }
    return result
}

func inside(name: String): String {
    if path.ends_with("/") {
        return "{path}{name}"
    }
    return "{path}/{name}"
}

func sorted(names: List<String>): List<String> {
    return names.sort_by(name_of)
}

func name_of(name: String): String {
    return name
}
