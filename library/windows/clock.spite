var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var _ticks_per_second: Long = 1

func Clock() {
    var frequency = heap.allocate(8)
    kernel.QueryPerformanceFrequency(frequency)
    _ticks_per_second = frequency.read_long(0)
    heap.free(frequency)
}

func elapsed_nanoseconds(): Long {
    var counter = heap.allocate(8)
    kernel.QueryPerformanceCounter(counter)
    var ticks = counter.read_long(0)
    heap.free(counter)
    return ticks / _ticks_per_second * 1000000000 + ticks % _ticks_per_second * 1000000000 / _ticks_per_second
}

func now(): Instant {
    var file_time = heap.allocate(8)
    kernel.GetSystemTimeAsFileTime(file_time)
    var hundreds_of_nanoseconds = file_time.read_long(0)
    heap.free(file_time)
    var whole = Duration(hundreds_of_nanoseconds / 10000000 - 11644473600, 'seconds')
    var part = Duration(hundreds_of_nanoseconds % 10000000 * 100, 'nanoseconds')
    return Instant(whole + part)
}
