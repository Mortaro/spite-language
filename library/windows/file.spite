var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func open_file(mode: String): Long {
    return library.fopen_as_long(path, mode)
}

func close_file(handle: Long) {
    library.fclose(handle)
}

func seek(handle: Long, offset: Long, origin: Int) {
    library._fseeki64(handle, offset, origin)
}

func tell(handle: Long): Long {
    return library._ftelli64_as_long(handle)
}

func read_into(buffer: Long, bytes: Long, handle: Long): Long {
    return library.fread_as_long(buffer, 1, bytes, handle)
}

func write_from(address: Long, bytes: Long, handle: Long): Long {
    return library.fwrite_as_long(address, 1, bytes, handle)
}

func write_text(text: String, handle: Long): Long {
    var text_length = text.length()
    return library.fwrite_as_long(text, 1, text_length, handle)
}

func modified_nanoseconds(): Long? {
    var data = heap.allocate(40)
    var standard_information = 0
    var found = kernel.GetFileAttributesExA(path, standard_information, data)
    var written = data.read_long(20)
    heap.free(data)
    assert found != 0
    return (written - 116444736000000000) * 100
}

func remove(): Bool {
    return library.remove(path) == 0
}
