var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func open_file(mode: String): Long {
    return library.fopen_as_long(path, mode)
}

func close_file(handle: Long) {
    library.fclose(handle)
}

func seek(handle: Long, offset: Long, origin: Integer) {
    library._fseeki64(handle, offset, origin)
}

func tell(handle: Long): Long {
    return library._ftelli64_as_long(handle)
}

func read_into(buffer: Long, bytes: Long, handle: Long): Long {
    return library.fread_as_long(buffer, 1, bytes, handle)
}

func write_from(address: Long, bytes: Long, handle: Long): Long {
    return library.fwrite_as_long(address, 1, bytes, handle)
}

func write_text(text: String, handle: Long): Long {
    var text_length = text.length()
    return library.fwrite_as_long(text, 1, text_length, handle)
}

func modified_nanoseconds(): Long? {
    var data = heap.allocate(40)
    var standard_information = 0
    var found = kernel.GetFileAttributesExA(path, standard_information, data)
    var written = data.read_long(20)
    heap.free(data)
    assert found != 0
    return (written - 116444736000000000) * 100
}

func remove(): Boolean {
    return library.remove(path) == 0
}

func map(): MappedFile? {
    var no_value: Long = 0
    var generic_read = 2147483648
    var share_read = 1
    var open_existing = 3
    var normal_attributes = 128
    var handle = kernel.CreateFileA_as_long(
        path,
        generic_read,
        share_read,
        no_value,
        open_existing,
        normal_attributes,
        no_value,
    )
    assert handle != -1
    var size_cell = heap.allocate(8)
    var sized = kernel.GetFileSizeEx(handle, size_cell)
    var bytes = size_cell.read_long(0)
    heap.free(size_cell)
    var mapping: Long = 0
    if sized != 0 and bytes > 0 {
        var read_only_pages = 2
        mapping = kernel.CreateFileMappingA_as_long(handle, no_value, read_only_pages, 0, 0, no_value)
    }
    kernel.CloseHandle(handle)
    assert sized != 0
    var view: Memory.Address = 0
    if mapping != 0 {
        var read_access = 4
        view = kernel.MapViewOfFile_as_long(mapping, read_access, 0, 0, 0)
        kernel.CloseHandle(mapping)
    }
    assert bytes == 0 or view != 0
    return MappedFile(view, bytes)
}

func rename_to(new_path: String): Boolean {
    var copy_across_volumes = 2
    return kernel.MoveFileExA(path, new_path, copy_across_volumes) != 0
}
