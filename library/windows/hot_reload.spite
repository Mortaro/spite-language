var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func watch_folder(path: String): Long {
    return kernel.FindFirstChangeNotificationA_as_long(path, 0, 17)
}

func wait_for_change(watched: Long, milliseconds: Int): Bool {
    var signaled = kernel.WaitForSingleObject(watched, milliseconds) == 0
    if signaled {
        kernel.FindNextChangeNotification(watched)
    }
    return signaled
}
