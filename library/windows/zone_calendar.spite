var icu = DynamicLibrary("icu.dll", 'identity', "")
var heap = Memory.Heap()
var _name = ""
var _handle: Long = 0

func ZoneCalendar(name: String) {
    _name = name
    if name.is_empty() {
        _name = _default_name()
    }
    _handle = _opened()
}

func get_name(): String {
    return _name
}

func get_is_open(): Bool {
    return _handle != 0
}

func offset_seconds_at(unix_seconds: Long): Int {
    var status = heap.allocate(4)
    status.write_int(0, 0)
    var milliseconds: Double = unix_seconds * 1000
    icu.ucal_setMillis(_handle, milliseconds, status)
    var zone = icu.ucal_get(_handle, 15, status)
    var daylight = icu.ucal_get(_handle, 16, status)
    heap.free(status)
    return (zone + daylight) / 1000
}

func drop() {
    if _handle != 0 {
        icu.ucal_close(_handle)
    }
}

func _opened(): Long {
    var length = _name.length()
    var characters = heap.allocate(length * 2 + 2)
    var index = 0
    while index < length {
        var code = _name.code_at(index)
        characters.write_short(index * 2, code)
        index = index + 1
    }
    var status = heap.allocate(4)
    var is_system = heap.allocate(4)
    var canonical = heap.allocate(512)
    status.write_int(0, 0)
    is_system.write_int(0, 0)
    icu.ucal_getCanonicalTimeZoneID(characters, length, canonical, 256, is_system, status)
    var handle: Long = 0
    if status.read_int(0) <= 0 and is_system.read_byte(0) != 0 {
        handle = icu.ucal_open_as_long(characters, length, "", 1, status)
    }
    if status.read_int(0) > 0 {
        handle = 0
    }
    heap.free(canonical)
    heap.free(is_system)
    heap.free(status)
    heap.free(characters)
    return handle
}

func _default_name(): String {
    var characters = heap.allocate(512)
    var status = heap.allocate(4)
    status.write_int(0, 0)
    var length = icu.ucal_getDefaultTimeZone(characters, 256, status)
    if status.read_int(0) > 0 {
        length = 0
    }
    var bytes = heap.allocate(length + 1)
    var index = 0
    while index < length {
        var code = characters.read_unsigned_short(index * 2)
        bytes.write_byte(index, code)
        index = index + 1
    }
    var name = bytes.text(length)
    heap.free(bytes)
    heap.free(status)
    heap.free(characters)
    return name
}
