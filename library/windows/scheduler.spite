var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func current_thread(): Long {
    return kernel.GetCurrentThreadId_as_long()
}

func create_event(event_loop: SchedulerLoop) {
    var no_value: Long = 0
    event_loop.wake = kernel.CreateEventA_as_long(no_value, 0, 0, no_value)
    event_loop.wake_signal = event_loop.wake
}

func signal_event(event_loop: SchedulerLoop) {
    kernel.SetEvent(event_loop.wake_signal)
}

func wait_event(event_loop: SchedulerLoop, milliseconds: Integer) {
    kernel.WaitForSingleObject(event_loop.wake, milliseconds)
}

func clock(): Long {
    return kernel.GetTickCount64_as_long()
}

func start_thread(entry: Long, argument: Long): Long {
    var no_value: Long = 0
    return kernel.CreateThread_as_long(no_value, no_value, entry, argument, 0, no_value)
}

func end_thread(thread: Long) {
    kernel.WaitForSingleObject(thread, -1)
    kernel.CloseHandle(thread)
}
