var library = DynamicLibrary("ucrtbase.dll", 'identity', "")
var system = DynamicLibrary("kernel32.dll", 'identity', "")
var memory = Memory()
var foreign_text = ForeignText()

func open_file(path: String, mode: String): Long {
    return library.fopen_as_long(path, mode)
}

func close_file(handle: Long) {
    library.fclose(handle)
}

func seek(handle: Long, offset: Long, origin: Int) {
    library.fseek(handle, offset, origin)
}

func tell(handle: Long): Long {
    return library.ftell(handle)
}

func read_into(buffer: Long, bytes: Long, handle: Long): Long {
    return library.fread_as_long(buffer, 1, bytes, handle)
}

func write_text(text: String, handle: Long): Long {
    return library.fwrite_as_long(text, 1, text.length(), handle)
}

func remove_file(path: String): Int {
    return library.remove(path)
}

func directory_entries(path: String, want_folders: Bool): List<String> {
    var entries = List<String>()
    var found = memory.allocate_bytes(600)
    var search = system.FindFirstFileA_as_long("{path}/*", found)
    if search != -1 {
        var more = true
        while more {
            var is_folder = memory.read_int(found, 0) % 32 >= 16
            var name = foreign_text.read(found + 44)
            if is_folder == want_folders and name != "." and name != ".." {
                entries.append(name)
            }
            more = system.FindNextFileA(search, found) != 0
        }
        system.FindClose(search)
    }
    memory.free(found)
    return entries
}

func directory_exists(path: String): Bool {
    var attributes = system.GetFileAttributesA(path)
    return attributes != -1 and attributes % 32 >= 16
}

func create_directory(path: String): Bool {
    return system.CreateDirectoryA(path, 0) != 0 or directory_exists(path)
}

func open_process(line: String): Long {
    return library._popen_as_long(line, "r")
}

func close_process(handle: Long): Int {
    return library._pclose(handle)
}

func shell_line(line: String, command_is_quoted: Bool): String {
    if command_is_quoted {
        return "\"{line}\""
    }
    return line
}

func is_singleton(): Bool {
    return true
}
