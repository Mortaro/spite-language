var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var memory = Memory()
var foreign_text = ForeignText()

func exists(): Bool {
    var attributes = kernel.GetFileAttributesA(path)
    return attributes != -1 and attributes % 32 >= 16
}

func create(): Bool {
    return kernel.CreateDirectoryA(path, 0) != 0 or exists()
}

func entry_names(want_folders: Bool): List<String> {
    var names = List<String>()
    var found = memory.allocate_bytes(600)
    var search = kernel.FindFirstFileA_as_long("{path}/*", found)
    if search != -1 {
        var more = true
        while more {
            var is_folder = memory.read_int(found, 0) % 32 >= 16
            var name = foreign_text.read(found + 44)
            if is_folder == want_folders and name != "." and name != ".." {
                names.append(name)
            }
            more = kernel.FindNextFileA(search, found) != 0
        }
        kernel.FindClose(search)
    }
    memory.free(found)
    return names
}
