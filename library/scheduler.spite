singleton

var started = false
var scheduler_thread: Long = 0
var tasks = List<Long>()
var deadlines = List<Long>()
var offloads_running = 0
var serving = false
var commands: Spite.Function<Nothing>? = null
var reloads: Spite.Function<Nothing>? = null
var paused = false
var resumes_when_asked = false
var wake: Long = 0

func start() {
    if not started {
        started = true
        scheduler_thread = current_thread()
        wake = create_event()
    }
}

func resume_only_when_asked() {
    resumes_when_asked = true
}

func waits_here(): Boolean {
    assert started and not paused and (not tasks.is_empty() and not resumes_when_asked or serving)
    return current_thread() == scheduler_thread
}

func begin(frame: Long) {
    start()
    if not run_frame(frame) {
        tasks.append(frame)
    }
}

func run_frame(frame: Memory.Address): Boolean {
    frame.write_integer(12, 1)
    var done = step_frame(frame)
    if done {
        frame.write_integer(12, 2)
        release_work(frame)
    } else {
        frame.write_integer(12, 0)
    }
    return done
}

func frame_done(frame: Memory.Address): Boolean {
    return frame.read_integer(12) == 2
}

func run_ready(): Integer {
    assert started and current_thread() == scheduler_thread
    return step_ready()
}

func step_ready(): Integer {
    var finished = 0
    var index = 0
    while index < tasks.count() {
        var frame: Memory.Address = tasks[index]
        if frame.read_integer(12) == 0 and run_frame(frame) {
            remove_one(tasks, frame)
            finished = finished + 1
        } else {
            index = index + 1
        }
    }
    return finished
}

func wait_for(frame: Long) {
    while not frame_done(frame) {
        idle_stepping(true)
    }
}

func timer_start(milliseconds: Integer): Long {
    var deadline = clock() + milliseconds
    deadlines.append(deadline)
    return deadline
}

func timer_over(deadline: Long): Boolean {
    assert clock() >= deadline
    remove_one(deadlines, deadline)
    return true
}

func remove_one(values: List<Long>, value: Long) {
    var index = 0
    while index < values.count() and values[index] != value {
        index = index + 1
    }
    if index < values.count() {
        values.remove_at(index)
    }
}

func check_point() {
    assert started and current_thread() == scheduler_thread and _take_check_point()
    if commands {
        commands()
    }
    reload_at_check_point()
}

func reload_at_check_point() {
    assert reloads
    reloads()
}

func yield_now() {
    if commands {
        commands()
    }
    if reloads {
        reloads()
    }
    if not resumes_when_asked {
        step_ready()
    }
}

func sleep(milliseconds: Integer) {
    var deadline = timer_start(milliseconds)
    while not timer_over(deadline) {
        idle()
    }
}

func offload(call: Memory.Address, entry: Long): Boolean {
    var thread = offload_start(call, entry)
    while not offload_over(call, thread) {
        idle()
    }
    return true
}

func offload_start(call: Memory.Address, entry: Long): Long {
    var thread = start_thread(entry, call)
    crash thread != 0
    offloads_running = offloads_running + 1
    return thread
}

func offload_over(call: Memory.Address, thread: Long): Boolean {
    assert call.read_long_atomically(0) == 1
    end_thread(thread)
    offloads_running = offloads_running - 1
    return true
}

func offload_done(call: Memory.Address) {
    call.write_long_atomically(0, 1)
    signal()
}

func signal() {
    _want_check_point()
    signal_event()
}

func idle() {
    idle_stepping(not resumes_when_asked)
}

func idle_stepping(steps: Boolean) {
    if commands {
        commands()
    }
    if reloads {
        reloads()
    }
    var finished = 0
    if steps {
        finished = step_ready()
    }
    if finished == 0 {
        var wait_limit = timeout()
        crash wait_limit >= 0 or offloads_running > 0 or serving
        wait_event(wait_limit)
    }
}

func timeout(): Integer {
    if deadlines.is_empty() {
        return -1
    }
    var now = clock()
    crash deadlines[0]
    var earliest = deadlines[0]
    var index = 1
    while index < deadlines.count() {
        var deadline = deadlines[index]
        if deadline < earliest {
            earliest = deadline
        }
        index = index + 1
    }
    assert earliest > now
    return earliest - now
}
