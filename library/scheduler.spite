singleton

var started = false
var scheduler_thread: Long = 0
var serving = false
var waits_begun = 0
var check_points_passed = 0
var answering_in_wait = false
var commands: Spite.Function<Nothing>? = null
var reloads: Spite.Function<Nothing>? = null
var paused = false
var _loops = ThreadLocal<SchedulerLoop>()
var _every_loop = List<SchedulerLoop>()
var _loops_lock = Lock()

func loop(): SchedulerLoop {
    var found = _loops.get()
    if found {
        return found
    }
    var made = SchedulerLoop()
    made.thread = current_thread()
    _loops.set(made)
    _loops_lock.lock()
    _every_loop.append(made)
    _loops_lock.unlock()
    return made
}

func start() {
    var here: SchedulerLoop = loop()
    if not here.started {
        here.started = true
        create_event(here)
    }
    if not started {
        started = true
        scheduler_thread = here.thread
    }
}

func resume_only_when_asked() {
    var here: SchedulerLoop = loop()
    here.resumes_when_asked = true
}

func on_main_thread(): Boolean {
    return started and current_thread() == scheduler_thread
}

func waits_here(): Boolean {
    var here: SchedulerLoop = loop()
    var serves_here = serving and on_main_thread()
    if not here.started or paused or (here.tasks.is_empty() or here.resumes_when_asked) and not serves_here {
        return false
    }
    return true
}

func begin(frame: Long) {
    start()
    if not run_frame(frame) {
        var here: SchedulerLoop = loop()
        here.tasks.append(frame)
    }
}

func run_frame(frame: Memory.Address): Boolean {
    var here: SchedulerLoop = loop()
    here.unfinished_polls_with_no_frame_stepped = 0
    frame.write_integer(12, 1)
    var outer = here.stepping
    here.stepping = frame
    var done = step_frame(frame)
    here.stepping = outer
    if done {
        frame.write_integer(12, 2)
        forget_wait(frame)
        release_work(frame)
    } else {
        frame.write_integer(12, 0)
    }
    return done
}

func frame_done(frame: Memory.Address): Boolean {
    return frame.read_integer(12) == 2
}

func joins(frame: Long): Boolean {
    var here: SchedulerLoop = loop()
    if frame_done(frame) {
        forget_wait(here.stepping)
        return true
    }
    forget_wait(here.stepping)
    here.waiting_frames.append(here.stepping)
    here.awaited_frames.append(frame)
    var awaited = frame
    var hops = 0
    while awaited != 0 and hops <= here.waiting_frames.count() {
        var joins_a_concurrent_that_waits_for_this_one = awaited == here.stepping
        crash not joins_a_concurrent_that_waits_for_this_one
        awaited = awaited_by(awaited)
        hops = hops + 1
    }
    return false
}

func awaited_by(frame: Long): Long {
    var here: SchedulerLoop = loop()
    var index = 0
    while index < here.waiting_frames.count() {
        if here.waiting_frames[index] == frame {
            crash here.awaited_frames[index]
            return here.awaited_frames[index]
        }
        index = index + 1
    }
    return 0
}

func forget_wait(frame: Long) {
    var here: SchedulerLoop = loop()
    var index = 0
    while index < here.waiting_frames.count() {
        if here.waiting_frames[index] == frame {
            here.waiting_frames.remove_at(index)
            here.awaited_frames.remove_at(index)
            return
        }
        index = index + 1
    }
}

func polled_unfinished() {
    var here: SchedulerLoop = loop()
    here.unfinished_polls_with_no_frame_stepped = here.unfinished_polls_with_no_frame_stepped + 1
    crash here.unfinished_polls_with_no_frame_stepped < 1000000
}

func run_ready(): Integer {
    var here: SchedulerLoop = loop()
    if not here.started {
        return 0
    }
    return step_ready()
}

func step_ready(): Integer {
    var here: SchedulerLoop = loop()
    var finished = 0
    var index = 0
    while index < here.tasks.count() {
        var frame: Memory.Address = here.tasks[index]
        if frame.read_integer(12) == 0 and run_frame(frame) {
            remove_one(here.tasks, frame)
            finished = finished + 1
        } else {
            index = index + 1
        }
    }
    return finished
}

func wait_for(frame: Long): Boolean {
    if runs_below(frame) {
        return false
    }
    begin_wait()
    while not frame_done(frame) {
        idle_stepping(true)
    }
    return true
}

func runs_below(frame: Memory.Address): Boolean {
    var here: SchedulerLoop = loop()
    return frame.read_integer(12) == 1 and here.started
}

func timer_start(milliseconds: Integer): Long {
    var here: SchedulerLoop = loop()
    var deadline = clock() + milliseconds
    here.deadlines.append(deadline)
    return deadline
}

func timer_over(deadline: Long): Boolean {
    if clock() < deadline {
        return false
    }
    var here: SchedulerLoop = loop()
    remove_one(here.deadlines, deadline)
    return true
}

func remove_one(values: List<Long>, value: Long) {
    var index = 0
    while index < values.count() and values[index] != value {
        index = index + 1
    }
    if index < values.count() {
        values.remove_at(index)
    }
}

func check_point() {
    assert on_main_thread() and _take_check_point()
    if serving {
        check_points_passed = check_points_passed + 1
    }
    if commands {
        commands()
    }
    reload_at_check_point()
}

func reload_at_check_point() {
    assert reloads
    reloads()
}

func yield_now() {
    var main = on_main_thread()
    if commands and main {
        commands()
    }
    if reloads and main {
        reloads()
    }
    var here: SchedulerLoop = loop()
    if not here.resumes_when_asked {
        step_ready()
    }
}

func sleep(milliseconds: Integer) {
    begin_wait()
    var deadline = timer_start(milliseconds)
    while not timer_over(deadline) {
        idle()
    }
}

func offload(call: Memory.Address, entry: Long): Boolean {
    begin_wait()
    var thread = offload_start(call, entry)
    while not offload_over(call, thread) {
        idle()
    }
    return true
}

func offload_start(call: Memory.Address, entry: Long): Long {
    var thread = start_thread(entry, call)
    crash thread != 0
    var here: SchedulerLoop = loop()
    here.offloads_running = here.offloads_running + 1
    return thread
}

func offload_over(call: Memory.Address, thread: Long): Boolean {
    if call.read_long_atomically(0) != 1 {
        return false
    }
    end_thread(thread)
    var here: SchedulerLoop = loop()
    here.offloads_running = here.offloads_running - 1
    return true
}

func offload_done(call: Memory.Address) {
    call.write_long_atomically(0, 1)
    signal()
}

func begin_wait() {
    if serving and on_main_thread() {
        waits_begun = waits_begun + 1
    }
}

func ask_check_point() {
    _want_check_point()
}

func will_wake(): Boolean {
    var here: SchedulerLoop = loop()
    return not here.deadlines.is_empty() or here.offloads_running > 0
}

func signal() {
    _want_check_point()
    _loops_lock.lock()
    var index = 0
    while index < _every_loop.count() {
        var each_loop: SchedulerLoop = _every_loop[index]
        if each_loop.started {
            signal_event(each_loop)
        }
        index = index + 1
    }
    _loops_lock.unlock()
}

func idle() {
    var here: SchedulerLoop = loop()
    idle_stepping(not here.resumes_when_asked)
}

func idle_stepping(steps: Boolean) {
    var main = on_main_thread()
    if commands and main {
        answering_in_wait = true
        commands()
        answering_in_wait = false
    }
    if reloads and main {
        reloads()
    }
    var finished = 0
    if steps {
        finished = step_ready()
    }
    if finished == 0 {
        var here: SchedulerLoop = loop()
        var wait_limit = timeout()
        crash wait_limit >= 0 or here.offloads_running > 0 or serving and main
        wait_event(here, wait_limit)
    }
}

func timeout(): Integer {
    var here: SchedulerLoop = loop()
    if here.deadlines.is_empty() {
        return -1
    }
    var now = clock()
    var earliest = here.deadlines[0]
    var index = 1
    while index < here.deadlines.count() {
        var deadline = here.deadlines[index]
        if deadline < earliest {
            earliest = deadline
        }
        index = index + 1
    }
    if earliest <= now {
        return 0
    }
    return earliest - now
}
