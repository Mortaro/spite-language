singleton

var started = false
var scheduler_thread: Long = 0
var tasks = List<Long>()
var deadlines = List<Long>()
var offloads_running = 0
var serving = false
var waits_begun = 0
var check_points_passed = 0
var stepping: Long = 0
var waiting_frames = List<Long>()
var awaited_frames = List<Long>()
var answering_in_wait = false
var commands: Spite.Function<Nothing>? = null
var reloads: Spite.Function<Nothing>? = null
var paused = false
var resumes_when_asked = false
var unfinished_polls_with_no_frame_stepped = 0
var wake: Long = 0

func start() {
    if not started {
        started = true
        scheduler_thread = current_thread()
        wake = create_event()
    }
}

func resume_only_when_asked() {
    resumes_when_asked = true
}

func waits_here(): Boolean {
    if not started or paused or (tasks.is_empty() or resumes_when_asked) and not serving {
        return false
    }
    return current_thread() == scheduler_thread
}

func begin(frame: Long) {
    start()
    if not run_frame(frame) {
        tasks.append(frame)
    }
}

func run_frame(frame: Memory.Address): Boolean {
    unfinished_polls_with_no_frame_stepped = 0
    frame.write_integer(12, 1)
    var outer = stepping
    stepping = frame
    var done = step_frame(frame)
    stepping = outer
    if done {
        frame.write_integer(12, 2)
        forget_wait(frame)
        release_work(frame)
    } else {
        frame.write_integer(12, 0)
    }
    return done
}

func frame_done(frame: Memory.Address): Boolean {
    return frame.read_integer(12) == 2
}

func joins(frame: Long): Boolean {
    if frame_done(frame) {
        forget_wait(stepping)
        return true
    }
    forget_wait(stepping)
    waiting_frames.append(stepping)
    awaited_frames.append(frame)
    var awaited = frame
    var hops = 0
    while awaited != 0 and hops <= waiting_frames.count() {
        var joins_a_concurrent_that_waits_for_this_one = awaited == stepping
        crash not joins_a_concurrent_that_waits_for_this_one
        awaited = awaited_by(awaited)
        hops = hops + 1
    }
    return false
}

func awaited_by(frame: Long): Long {
    var index = 0
    while index < waiting_frames.count() {
        if waiting_frames[index] == frame {
            crash awaited_frames[index]
            return awaited_frames[index]
        }
        index = index + 1
    }
    return 0
}

func forget_wait(frame: Long) {
    var index = 0
    while index < waiting_frames.count() {
        if waiting_frames[index] == frame {
            waiting_frames.remove_at(index)
            awaited_frames.remove_at(index)
            return
        }
        index = index + 1
    }
}

func polled_unfinished() {
    unfinished_polls_with_no_frame_stepped = unfinished_polls_with_no_frame_stepped + 1
    crash unfinished_polls_with_no_frame_stepped < 1000000
}

func run_ready(): Integer {
    if not started or current_thread() != scheduler_thread {
        return 0
    }
    return step_ready()
}

func step_ready(): Integer {
    var finished = 0
    var index = 0
    while index < tasks.count() {
        var frame: Memory.Address = tasks[index]
        if frame.read_integer(12) == 0 and run_frame(frame) {
            remove_one(tasks, frame)
            finished = finished + 1
        } else {
            index = index + 1
        }
    }
    return finished
}

func wait_for(frame: Long): Boolean {
    if runs_below(frame) {
        return false
    }
    begin_wait()
    while not frame_done(frame) {
        idle_stepping(true)
    }
    return true
}

func runs_below(frame: Memory.Address): Boolean {
    return frame.read_integer(12) == 1 and started and current_thread() == scheduler_thread
}

func timer_start(milliseconds: Integer): Long {
    var deadline = clock() + milliseconds
    deadlines.append(deadline)
    return deadline
}

func timer_over(deadline: Long): Boolean {
    if clock() < deadline {
        return false
    }
    remove_one(deadlines, deadline)
    return true
}

func remove_one(values: List<Long>, value: Long) {
    var index = 0
    while index < values.count() and values[index] != value {
        index = index + 1
    }
    if index < values.count() {
        values.remove_at(index)
    }
}

func check_point() {
    assert started and current_thread() == scheduler_thread and _take_check_point()
    if serving {
        check_points_passed = check_points_passed + 1
    }
    if commands {
        commands()
    }
    reload_at_check_point()
}

func reload_at_check_point() {
    assert reloads
    reloads()
}

func yield_now() {
    if commands {
        commands()
    }
    if reloads {
        reloads()
    }
    if not resumes_when_asked {
        step_ready()
    }
}

func sleep(milliseconds: Integer) {
    begin_wait()
    var deadline = timer_start(milliseconds)
    while not timer_over(deadline) {
        idle()
    }
}

func offload(call: Memory.Address, entry: Long): Boolean {
    begin_wait()
    var thread = offload_start(call, entry)
    while not offload_over(call, thread) {
        idle()
    }
    return true
}

func offload_start(call: Memory.Address, entry: Long): Long {
    var thread = start_thread(entry, call)
    crash thread != 0
    offloads_running = offloads_running + 1
    return thread
}

func offload_over(call: Memory.Address, thread: Long): Boolean {
    if call.read_long_atomically(0) != 1 {
        return false
    }
    end_thread(thread)
    offloads_running = offloads_running - 1
    return true
}

func offload_done(call: Memory.Address) {
    call.write_long_atomically(0, 1)
    signal()
}

func begin_wait() {
    if serving {
        waits_begun = waits_begun + 1
    }
}

func ask_check_point() {
    _want_check_point()
}

func will_wake(): Boolean {
    return not deadlines.is_empty() or offloads_running > 0
}

func signal() {
    _want_check_point()
    signal_event()
}

func idle() {
    idle_stepping(not resumes_when_asked)
}

func idle_stepping(steps: Boolean) {
    if commands {
        answering_in_wait = true
        commands()
        answering_in_wait = false
    }
    if reloads {
        reloads()
    }
    var finished = 0
    if steps {
        finished = step_ready()
    }
    if finished == 0 {
        var wait_limit = timeout()
        crash wait_limit >= 0 or offloads_running > 0 or serving
        wait_event(wait_limit)
    }
}

func timeout(): Integer {
    if deadlines.is_empty() {
        return -1
    }
    var now = clock()
    var earliest = deadlines[0]
    var index = 1
    while index < deadlines.count() {
        var deadline = deadlines[index]
        if deadline < earliest {
            earliest = deadline
        }
        index = index + 1
    }
    if earliest <= now {
        return 0
    }
    return earliest - now
}
