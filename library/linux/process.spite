var library = DynamicLibrary("libc.so.6", 'identity', "")

func run_attached(): Integer {
    _flush_output()
    var command_text = command_line()
    var status = library.system(command_text)
    return _exit_code(status)
}

func open_process(line: String): Long {
    return library.popen_as_long(line, "r")
}

func read_into(buffer: Long, bytes: Long, handle: Long): Long {
    return library.fread_as_long(buffer, 1, bytes, handle)
}

func close_process(handle: Long): Integer {
    var status = library.pclose(handle)
    return _exit_code(status)
}

func _exit_code(status: Integer): Integer {
    var signal = status.bits_and(127)
    if signal != 0 {
        return 128 + signal
    }
    return status.shifted_right(8).bits_and(255)
}

func shell_line(line: String): String {
    return line
}

func change_directory(folder: String): String {
    var quoted_folder = quoted_argument(folder)
    return "cd {quoted_folder}"
}

func set_variable(name: String, value: String): String {
    var quoted_value = quoted_argument(value)
    return "export {name}={quoted_value}"
}

func quoted_argument(argument: String): String {
    var escaped = argument.replace("'", "'\\''")
    return "'{escaped}'"
}
