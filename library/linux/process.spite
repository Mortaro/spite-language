var library = DynamicLibrary("libc.so.6", 'identity', "")

func run_attached(): Integer {
    var command_text = command_line()
    return library.system(command_text)
}

func open_process(line: String): Long {
    return library.popen_as_long(line, "r")
}

func read_into(buffer: Long, bytes: Long, handle: Long): Long {
    return library.fread_as_long(buffer, 1, bytes, handle)
}

func close_process(handle: Long): Integer {
    var status = library.pclose(handle)
    return status.shifted_right(8).bits_and(255)
}

func shell_line(line: String, _command_is_quoted: Boolean): String {
    return line
}
