var _library = DynamicLibrary("libc.so.6", 'identity', "")

func _fill(filled: Buffer, count: Integer) {
    var written = 0
    while written < count {
        var at = filled.items + written
        var wanted = count - written
        var got: Integer = _library.getrandom_as_long(at, wanted, 0)
        crash got > 0
        written = written + got
    }
    filled.item_count = count
}
