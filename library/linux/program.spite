var library = DynamicLibrary("libc.so.6", 'identity', "")

func sleep(milliseconds: Integer) {
    library.usleep(milliseconds * 1000)
}

func exit_process(code: Integer) {
    library.exit(code)
}

func environment_address(name: String): Long {
    return library.getenv_as_long(name)
}

func executable_path(): String {
    var buffer = heap.allocate(1024)
    var length = library.readlink_as_long("/proc/self/exe", buffer, 1023)
    var path = buffer.text(length)
    heap.free(buffer)
    return path
}

func working_directory(): String {
    var buffer = heap.allocate(1024)
    buffer.write_byte(0, 0)
    library.getcwd_as_long(buffer, 1024)
    var path = buffer.terminated_text()
    heap.free(buffer)
    return path
}
