var library = DynamicLibrary("libc.so.6", 'identity', "")

func sleep(milliseconds: Int) {
    library.usleep(milliseconds * 1000)
}

func exit_process(code: Int) {
    library.exit(code)
}

func environment_address(name: String): Long {
    return library.getenv_as_long(name)
}

func executable_path(): String {
    var buffer = memory.allocate_bytes(1024)
    var length = library.readlink_as_long("/proc/self/exe", buffer, 1023)
    var path = memory.text(buffer, length)
    memory.free(buffer)
    return path
}
