var _library = DynamicLibrary("libc.so.6", 'identity', "")

func _open_handle(family: Integer): Long {
    var opened = _library.socket(family, 2, 17)
    if opened != -1 and family == _addresses.ipv6_family() {
        _addresses.allow_ipv4_too(opened)
    }
    return opened
}

func _bind(address: Memory.Address): Boolean {
    var length = _addresses.address_length(address)
    return _library.bind(handle, address, length) == 0
}

func _send(address: Memory.Address, buffer: Memory.Address, count: Integer): Integer {
    var length = _addresses.address_length(address)
    var wanted: Long = count
    return _library.sendto_as_long(handle, buffer, wanted, 0, address, length)
}

func _receive_from(buffer: Memory.Address, count: Integer, sender: Memory.Address): Integer {
    var length_slot = sender + 28
    var wanted: Long = count
    return _library.recvfrom_as_long(handle, buffer, wanted, 0, sender, length_slot)
}

func _ready_now(): Boolean {
    var watched = heap.allocate(8)
    var descriptor: Integer = handle
    watched.write_integer(0, descriptor)
    watched.write_short(4, 1)
    watched.write_short(6, 0)
    var count: Long = 1
    var ready = _library.poll(watched, count, 0)
    heap.free(watched)
    return ready > 0
}

func _close_handle() {
    _library.close(handle)
}

func _local_port(): Integer {
    var address = heap.allocate(32)
    address.write_integer(28, 28)
    var length_slot = address + 28
    var asked = _library.getsockname(handle, address, length_slot)
    var port = _addresses.read_port(address)
    heap.free(address)
    crash asked == 0
    return port
}
