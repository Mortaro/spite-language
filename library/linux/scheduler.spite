var library = DynamicLibrary("libc.so.6", 'identity', "")
var heap = Memory.Heap()
var signal_ending = 0
var signal_byte: Long = 0

func current_thread(): Long {
    return library.pthread_self_as_long()
}

func create_event(): Long {
    var ends = heap.allocate(8)
    library.pipe(ends)
    var reading = ends.read_int(0)
    signal_ending = ends.read_int(4)
    heap.free(ends)
    signal_byte = heap.allocate(8)
    return reading
}

func signal_event() {
    library.write(signal_ending, signal_byte, 1)
}

func wait_event(milliseconds: Int) {
    var watched = heap.allocate(8)
    watched.write_int(0, wake)
    watched.write_int(4, 1)
    if library.poll(watched, 1, milliseconds) > 0 {
        var drained = heap.allocate(64)
        library.read(wake, drained, 64)
        heap.free(drained)
    }
    heap.free(watched)
}

func clock(): Long {
    var time = heap.allocate(16)
    library.clock_gettime(1, time)
    var seconds = time.read_long(0)
    var nanoseconds = time.read_long(8)
    heap.free(time)
    return seconds * 1000 + nanoseconds / 1000000
}

func start_thread(entry: Long, argument: Long): Long {
    var slot = heap.allocate(8)
    var no_value: Long = 0
    var created = library.pthread_create(slot, no_value, entry, argument)
    var thread = slot.read_long(0)
    heap.free(slot)
    assert created == 0
    return thread
}

func end_thread(thread: Long) {
    var no_value: Long = 0
    library.pthread_join(thread, no_value)
}
