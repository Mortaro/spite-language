var library = DynamicLibrary("libc.so.6", 'identity', "")
var memory = Memory()
var foreign_text = ForeignText()
var input: Long = 0

func open_file(path: String, mode: String): Long {
    return library.fopen_as_long(path, mode)
}

func close_file(handle: Long) {
    library.fclose(handle)
}

func seek(handle: Long, offset: Long, origin: Int) {
    library.fseek(handle, offset, origin)
}

func tell(handle: Long): Long {
    return library.ftell_as_long(handle)
}

func read_into(buffer: Long, bytes: Long, handle: Long): Long {
    return library.fread_as_long(buffer, 1, bytes, handle)
}

func write_text(text: String, handle: Long): Long {
    return library.fwrite_as_long(text, 1, text.length(), handle)
}

func remove_file(path: String): Int {
    return library.remove(path)
}

func directory_entries(path: String, want_folders: Bool): List<String> {
    var entries = List<String>()
    var directory = library.opendir_as_long(path)
    if directory != 0 {
        var entry = library.readdir_as_long(directory)
        while entry != 0 {
            var is_folder = memory.read_byte(entry, 18) == 4
            var name = foreign_text.read(entry + 19)
            if is_folder == want_folders and name != "." and name != ".." {
                entries.append(name)
            }
            entry = library.readdir_as_long(directory)
        }
        library.closedir(directory)
    }
    return entries
}

func directory_exists(path: String): Bool {
    var directory = library.opendir_as_long(path)
    if directory == 0 {
        return false
    }
    library.closedir(directory)
    return true
}

func create_directory(path: String): Bool {
    return library.mkdir(path, 511) == 0 or directory_exists(path)
}

func open_process(line: String): Long {
    return library.popen_as_long(line, "r")
}

func close_process(handle: Long): Int {
    return library.pclose(handle) / 256 % 256
}

func shell_line(line: String, _command_is_quoted: Bool): String {
    return line
}

func exit_program(code: Int) {
    library.exit(code)
}

func environment_value(name: String): Long {
    return library.getenv_as_long(name)
}

func pause(milliseconds: Int) {
    library.usleep(milliseconds * 1000)
}

func platform(): String {
    return "linux"
}

func run_attached(line: String): Int {
    return library.system(line)
}

func read_line_into(buffer: Long, bytes: Int): Bool {
    if input == 0 {
        input = library.fdopen_as_long(0, "r")
    }
    return library.fgets_as_long(buffer, bytes, input) != 0
}

func is_singleton(): Bool {
    return true
}
