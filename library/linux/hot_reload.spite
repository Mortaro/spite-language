var library = DynamicLibrary("libc.so.6", 'identity', "")

func watch_folder(path: String): Long {
    var watcher = library.inotify_init()
    if watcher >= 0 {
        library.inotify_add_watch(watcher, path, 970)
    }
    return watcher
}

func wait_for_change(watched: Long, milliseconds: Int): Bool {
    var polled = memory.allocate_bytes(8)
    memory.write_int(polled, 0, watched)
    memory.write_int(polled, 4, 1)
    var ready = library.poll(polled, 1, milliseconds) > 0
    memory.free(polled)
    if ready {
        var events = memory.allocate_bytes(4096)
        library.read(watched, events, 4096)
        memory.free(events)
    }
    return ready
}
