var _memory = Memory().allocate_bytes(8)

func to_string(): String {
    return shortest_text(9007199254740992, -1074, 17)
}

func shortest_text(significand_limit: Long, lowest_exponent: Long, most_digits: Long): String {
    var bits = bits()
    if bits < 0 {
        var magnitude_value = -this
        var magnitude = magnitude_value.shortest_text(significand_limit, lowest_exponent, most_digits)
        if magnitude == "nan" {
            return magnitude
        }
        return "-{magnitude}"
    }
    var field = bits / 4503599627370496
    var significand = bits % 4503599627370496
    if field == 2047 {
        if significand == 0 {
            return "inf"
        }
        return "nan"
    }
    if bits == 0 {
        return "0"
    }
    var exponent: Long = -1074
    if field > 0 {
        significand = significand + 4503599627370496
        exponent = field - 1075
    }
    while significand >= significand_limit or exponent < lowest_exponent {
        significand = significand / 2
        exponent = exponent + 1
    }
    var number_text = NumberText()
    var digits = number_text.exact_digits(significand, exponent)
    var digits_exponent = number_text.decimal_exponent(digits, exponent)
    var upper = number_text.exact_digits(significand * 2 + 1, exponent - 1)
    var upper_exponent = number_text.decimal_exponent(upper, exponent - 1)
    var lower = number_text.exact_digits(significand * 2 - 1, exponent - 1)
    var lower_exponent = number_text.decimal_exponent(lower, exponent - 1)
    if significand * 2 == significand_limit and exponent > lowest_exponent {
        lower = number_text.exact_digits(significand * 4 - 1, exponent - 2)
        lower_exponent = number_text.decimal_exponent(lower, exponent - 2)
    }
    var even = significand % 2 == 0
    var precision: Long = 1
    while precision <= most_digits {
        var candidate = number_text.rounded_digits(digits, precision)
        var candidate_exponent = digits_exponent + candidate.length() - precision
        if candidate.length() > precision {
            candidate = candidate.slice(0, precision)
        }
        candidate = number_text.without_trailing_zeros(candidate)
        if number_text.is_fixed(candidate_exponent, precision) {
            var above_lower = number_text.compared(candidate, candidate_exponent, lower, lower_exponent)
            var below_upper = number_text.compared(upper, upper_exponent, candidate, candidate_exponent)
            if (above_lower > 0 or above_lower == 0 and even) and (below_upper > 0 or below_upper == 0 and even) {
                return number_text.fixed_text(candidate, candidate_exponent)
            }
        }
        precision = precision + 1
    }
    var fallback = number_text.rounded_digits(digits, most_digits)
    var fallback_exponent = digits_exponent + fallback.length() - most_digits
    if fallback.length() > most_digits {
        fallback = fallback.slice(0, most_digits)
    }
    fallback = number_text.without_trailing_zeros(fallback)
    if number_text.is_fixed(fallback_exponent, most_digits) {
        return number_text.fixed_text(fallback, fallback_exponent)
    }
    return number_text.scientific_text(fallback, fallback_exponent)
}

func bits(): Long {
    var memory = Memory()
    var address = memory.allocate_bytes(8)
    memory.write_double(address, 0, this)
    var bits = memory.read_long(address, 0)
    memory.free(address)
    return bits
}
