func is_empty(): Bool {
    return length() == 0
}

func character_at(index: Int): String {
    return slice(index, index + 1)
}

func matches_at(text: String, start: Int): Bool {
    assert start >= 0 and start + text.length() <= length()
    var index = 0
    while index < text.length() {
        assert code_at(start + index) == text.code_at(index)
        index = index + 1
    }
    return true
}

func index_of(text: String): Int {
    var start = 0
    while start + text.length() <= length() {
        if matches_at(text, start) {
            return start
        }
        start = start + 1
    }
    return -1
}

func contains(text: String): Bool {
    return index_of(text) >= 0
}

func starts_with(text: String): Bool {
    return matches_at(text, 0)
}

func ends_with(text: String): Bool {
    var own_length = length()
    var text_length = text.length()
    return matches_at(text, own_length - text_length)
}

func split(separator: String): List<String> {
    var pieces = List<String>()
    if separator.is_empty() {
        var character_index = 0
        while character_index < length() {
            var character = character_at(character_index)
            pieces.append(character)
            character_index = character_index + 1
        }
        return pieces
    }
    var piece_start = 0
    var index = 0
    while index <= length() - separator.length() {
        if matches_at(separator, index) {
            var piece = slice(piece_start, index)
            pieces.append(piece)
            index = index + separator.length()
            piece_start = index
        } else {
            index = index + 1
        }
    }
    var own_length = length()
    var rest = slice(piece_start, own_length)
    pieces.append(rest)
    return pieces
}

func lines(): List<String> {
    return split("\n")
}

func replace(from: String, to: String): String {
    if from.is_empty() {
        var own_length = length()
        return slice(0, own_length)
    }
    return split(from).join(to)
}

func is_space_at(index: Int): Bool {
    var code = code_at(index)
    return code == 32 or code >= 9 and code <= 13
}

func trim(): String {
    var start = 0
    var end = length()
    while start < end and is_space_at(start) {
        start = start + 1
    }
    while end > start and is_space_at(end - 1) {
        end = end - 1
    }
    return slice(start, end)
}

func upper_case(): String {
    return shifted_case(97, 122, -32)
}

func lower_case(): String {
    return shifted_case(65, 90, 32)
}

func shifted_case(first: Int, last: Int, shift: Int): String {
    var memory = Memory()
    var own_length = length()
    var address = memory.allocate_bytes(own_length + 1)
    var index = 0
    while index < length() {
        var code = code_at(index)
        if code >= first and code <= last {
            code = code + shift
        }
        memory.write_byte(address, index, code)
        index = index + 1
    }
    own_length = length()
    var result = memory.text(address, own_length)
    memory.free(address)
    return result
}

func to_long(): Long {
    var index = 0
    while index < length() and is_space_at(index) {
        index = index + 1
    }
    var negative = false
    if index < length() and (code_at(index) == 45 or code_at(index) == 43) {
        negative = code_at(index) == 45
        index = index + 1
    }
    var value: Long = 0
    while index < length() and code_at(index) >= 48 and code_at(index) <= 57 {
        value = value * 10 + code_at(index) - 48
        index = index + 1
    }
    if negative {
        return -value
    }
    return value
}

func to_int(): Int {
    return to_long()
}

func to_float(): Float {
    return to_double()
}
