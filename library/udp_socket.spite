var handle: Long = -1
var _sender_host = ""
var _sender_port = 0
var heap = Memory.Heap()
var _addresses = Socket()

func open(): Boolean {
    var address = _addresses.any_address(0)
    return _bound(address)
}

func open_locally(port: Integer): Boolean {
    var address = _addresses.local_address(port)
    return _bound(address)
}

func open_everywhere(port: Integer): Boolean {
    var address = _addresses.any_address(port)
    return _bound(address)
}

func send_to(host: String, port: Integer, bytes: List<Byte>): Boolean {
    crash handle != -1
    var address = _addresses.resolved_address(host, port)
    if address == 0 {
        return false
    }
    var counted = bytes.count()
    var sent = _send(address, bytes.items, counted)
    heap.free(address)
    return sent == counted
}

func receive(): List<Byte>? {
    assert handle != -1
    return _received()
}

func receive_now(): List<Byte>? {
    assert handle != -1
    assert _ready_now()
    return _received()
}

func sender_host(): String {
    return _sender_host
}

func sender_port(): Integer {
    return _sender_port
}

func close() {
    if handle != -1 {
        _close_handle()
        handle = -1
    }
}

func drop() {
    close()
}

func _bound(address: Memory.Address): Boolean {
    close()
    _addresses.start_sockets()
    handle = _open_handle()
    var bound = handle != -1 and _bind(address)
    heap.free(address)
    if not bound {
        close()
    }
    return bound
}

func _received(): List<Byte>? {
    var buffer = heap.allocate(65536)
    var sender = heap.allocate(20)
    sender.write_integer(16, 16)
    var received = _receive_from(buffer, 65536, sender)
    if received < 0 {
        heap.free(buffer)
        heap.free(sender)
        return null
    }
    var bytes = List<Byte>()
    bytes.reserve(received)
    buffer.copy_to(bytes.items, received)
    bytes.item_count = received
    var first: Integer = sender.read_byte(4)
    var second: Integer = sender.read_byte(5)
    var third: Integer = sender.read_byte(6)
    var fourth: Integer = sender.read_byte(7)
    _sender_host = "{first}.{second}.{third}.{fourth}"
    var port_high: Integer = sender.read_byte(2)
    var port_low: Integer = sender.read_byte(3)
    _sender_port = port_high * 256 + port_low
    heap.free(buffer)
    heap.free(sender)
    return bytes
}
