singleton

var file_name = ""
var handle: Long = 0

func DynamicLibrary(file: String, _naming: Symbol, _header: String) {
    file_name = file
    handle = open_library(file)
}

func drop() {
    close_library(handle)
}

func to_debug(): String {
    var quoted_file_name = file_name.to_debug()
    return "DynamicLibrary \{ file_name: {quoted_file_name} }"
}
