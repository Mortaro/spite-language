singleton

var _program = Program()
var _console = Console()

func setting(name: String): String? {
    var arguments = Arguments()
    var flag = "--{name}="
    var index = 0
    while index < arguments.count() and arguments.get(index) != "--" {
        var argument = arguments.get(index)
        if argument.starts_with(flag) {
            var flag_length = flag.length()
            var argument_length = argument.length()
            return argument.slice(flag_length, argument_length)
        }
        index = index + 1
    }
    var upper_case_name = name.upper_case()
    return _program.environment(upper_case_name)
}

func reject_misspelled_settings(...declared: List<String>) {
    var arguments = Arguments()
    var index = 0
    while index < arguments.count() and arguments.get(index) != "--" {
        var argument = arguments.get(index)
        reject_misspelled(argument, declared)
        index = index + 1
    }
}

func reject_misspelled(argument: String, declared: List<String>) {
    assert argument.starts_with("--")
    var written = setting_written(argument)
    assert written.contains("-")
    var field = written.replace("-", "_")
    assert declared.contains(field)
    _console.error(
        "error: '--{written}' is written '--{field}': a program's setting is spelled like its field, Environment.{field}, so '--{written}' would be ignored",
    )
    _program.exit(1)
}

func setting_written(argument: String): String {
    var argument_length = argument.length()
    var equals_position = argument.index_of("=")
    if equals_position > 2 {
        return argument.slice(2, equals_position)
    }
    return argument.slice(2, argument_length)
}

func boolean_setting(name: String, declared: Boolean): Boolean {
    var text = setting(name)
    if text {
        crash text == "true" or text == "false"
        return text == "true"
    }
    return declared
}

func integer_setting(name: String, declared: Integer): Integer {
    var text = setting(name)
    if text {
        crash is_whole_number(text)
        return text.to_integer()
    }
    return declared
}

func text_setting(name: String, declared: String): String {
    var text = setting(name)
    if text {
        return text
    }
    return declared
}

func is_whole_number(text: String): Boolean {
    var index = 0
    if text.starts_with("-") {
        index = 1
    }
    if index == text.length() {
        return false
    }
    while index < text.length() {
        if text.code_at(index) < 48 or text.code_at(index) > 57 {
            return false
        }
        index = index + 1
    }
    return true
}
