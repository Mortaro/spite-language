singleton

func setting(name: String): String? {
    var arguments = Arguments()
    var flag = "--{name}="
    var index = 0
    while index < arguments.count() and arguments.get(index) != "--" {
        var argument = arguments.get(index)
        if argument.starts_with(flag) {
            var flag_length = flag.length()
            var argument_length = argument.length()
            return argument.slice(flag_length, argument_length)
        }
        index = index + 1
    }
    var upper_case_name = name.upper_case()
    var program = Program()
    return program.environment(upper_case_name)
}

func boolean_setting(name: String, declared: Boolean): Boolean {
    var text = setting(name)
    if text {
        crash text == "true" or text == "false"
        return text == "true"
    }
    return declared
}

func integer_setting(name: String, declared: Integer): Integer {
    var text = setting(name)
    if text {
        crash is_whole_number(text)
        return text.to_integer()
    }
    return declared
}

func text_setting(name: String, declared: String): String {
    var text = setting(name)
    if text {
        return text
    }
    return declared
}

func is_whole_number(text: String): Boolean {
    var index = 0
    if text.starts_with("-") {
        index = 1
    }
    assert index != text.length()
    while index < text.length() {
        assert text.code_at(index) >= 48 and text.code_at(index) <= 57
        index = index + 1
    }
    return true
}
