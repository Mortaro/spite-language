generic $result_type

var _scheduler = Scheduler()
var _work: Spite.Function<$result_type>? = null
var _results = List<$result_type>()
var _frame: Long = 0
var _finished = true

func Concurrent(starting_work: Spite.Function<$result_type>) {
    _work = starting_work
    _frame = _start_frame()
    if _frame == 0 {
        _run()
    } else {
        _finished = false
        _scheduler.begin(_frame)
        _collect()
    }
    _work = null
}

func get_finished(): Boolean {
    _collect()
    return _finished
}

func finished_value(): $result_type? {
    assert get_finished()
    return _results.first()
}

func to_debug(): String {
    if not get_finished() {
        return "running"
    }
    var finished = finished_value()
    if finished {
        var result_debug = Spite.Debug<$result_type>()
        return result_debug.text(finished)
    }
    return "null"
}

func _run() {
    assert _work
    var value: $result_type = _work()
    _results.append(value)
}

func _collect() {
    assert _frame != 0 and _scheduler.frame_done(_frame)
    var value: $result_type = _frame_result()
    _results.append(value)
    _frame = 0
    _finished = true
}

func _result(): $result_type {
    _join()
    return _results.get_at(0)
}

func _join() {
    if not _finished {
        _scheduler.wait_for(_frame)
        _collect()
    }
}

func drop() {
    _join()
}
