var work: Spite.Function<$result_type>? = null
var results = List<$result_type>()
var scheduler = Scheduler()
var fiber: Long = 0
var finished = false
var waiter: Long = 0

func Concurrent<$result_type>(starting_work: Spite.Function<$result_type>) {
    work = starting_work
    var entry = entry_address()
    var instance = address()
    fiber = scheduler.spawn(entry, instance)
    if fiber == 0 {
        run()
        finished = true
    }
}

func run() {
    assert work
    var value: $result_type = work()
    results.append(value)
}

func finish() {
    finished = true
    scheduler.finish_fiber(waiter)
}

func wait(): $result_type {
    join()
    return results.get_at(0)
}

func join() {
    if not finished {
        waiter = scheduler.current_fiber()
        scheduler.suspend()
    }
    if fiber != 0 {
        scheduler.delete_fiber(fiber)
        fiber = 0
    }
}

func drop() {
    join()
}
