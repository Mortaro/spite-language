singleton

var memory = Memory()
var console = Console()

func exit(code: Int) {
    console.flush()
    exit_process(code)
}

func environment(name: String): String? {
    var address = environment_address(name)
    assert address != 0
    return memory.terminated_text(address)
}

func live_allocations(): Int {
    return memory.live_allocations()
}
