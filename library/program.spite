singleton

var heap = Memory.Heap()

func exit(code: Integer) {
    _flush_output()
    exit_process(code)
}

func environment(name: String): String? {
    var address: Memory.Address = environment_address(name)
    assert address != 0
    return address.terminated_text()
}

func live_allocations(): Integer {
    return heap.live_allocations()
}

func live_bytes(): Long {
    return heap.live_bytes()
}
