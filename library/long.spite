var heap = Memory.Heap()
var _memory = heap.allocate(8)

func to_string(): String {
    if this == 0 {
        return "0"
    }
    var heap = Memory.Heap()
    var buffer_bytes: Long = 24
    var address = heap.allocate(buffer_bytes)
    var position = buffer_bytes
    var rest = this
    while rest != 0 {
        var digit = rest % 10
        if digit < 0 {
            digit = -digit
        }
        position = position - 1
        address.write_byte(position, digit + 48)
        rest = rest / 10
    }
    if this < 0 {
        position = position - 1
        address.write_byte(position, 45)
    }
    var text = (address + position).text(buffer_bytes - position)
    heap.free(address)
    return text
}
