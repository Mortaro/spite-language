func read(text: String): Color? {
    var cleaned = text.trim().lower_case()
    if cleaned.starts_with("#") {
        return _read_hex(cleaned)
    }
    if cleaned.starts_with("rgb") or cleaned.starts_with("hsl") {
        return _read_function(cleaned)
    }
    var named = named_hex(cleaned)
    assert not named.is_empty()
    return _read_hex(named)
}

func _read_hex(text: String): Color? {
    var text_length = text.length()
    var digits = text.slice(1, text_length)
    var count = digits.length()
    assert count == 3 or count == 4 or count == 6 or count == 8
    assert _all_hex(digits)
    if count <= 4 {
        var short_red = _hex_value(digits, 0) * 17
        var short_green = _hex_value(digits, 1) * 17
        var short_blue = _hex_value(digits, 2) * 17
        var short_alpha = 255
        if count == 4 {
            short_alpha = _hex_value(digits, 3) * 17
        }
        return _from_bytes(short_red, short_green, short_blue, short_alpha)
    }
    var long_red = _hex_value(digits, 0) * 16 + _hex_value(digits, 1)
    var long_green = _hex_value(digits, 2) * 16 + _hex_value(digits, 3)
    var long_blue = _hex_value(digits, 4) * 16 + _hex_value(digits, 5)
    var long_alpha = 255
    if count == 8 {
        long_alpha = _hex_value(digits, 6) * 16 + _hex_value(digits, 7)
    }
    return _from_bytes(long_red, long_green, long_blue, long_alpha)
}

func _all_hex(digits: String): Boolean {
    var index = 0
    var valid = true
    while valid and index < digits.length() {
        valid = _hex_value(digits, index) >= 0
        index = index + 1
    }
    return valid
}

func _hex_value(digits: String, position: Integer): Integer {
    var code = digits.code_at(position)
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 102 {
        return code - 87
    }
    return -1
}

func _from_bytes(red_byte: Integer, green_byte: Integer, blue_byte: Integer, alpha_byte: Integer): Color {
    var red: Float = red_byte
    var green: Float = green_byte
    var blue: Float = blue_byte
    var alpha: Float = alpha_byte
    return Color(red / 255.0, green / 255.0, blue / 255.0, alpha / 255.0)
}

func _read_function(text: String): Color? {
    var open = text.index_of("(")
    assert open > 0 and text.ends_with(")")
    var function_name = text.slice(0, open)
    var is_hue = function_name == "hsl" or function_name == "hsla"
    assert is_hue or function_name == "rgb" or function_name == "rgba"
    var text_length = text.length()
    var inside = text.slice(open + 1, text_length - 1)
    var spaced = inside.replace(",", " ").replace("/", " ")
    var pieces = spaced.split(" ")
    var parts = pieces.filter(has_text)
    var part_count = parts.count()
    assert part_count == 3 or part_count == 4
    assert parts[0]
    assert parts[1]
    assert parts[2]
    assert _is_number(parts[0]) and _is_number(parts[1]) and _is_number(parts[2])
    var alpha = 1.0
    if part_count == 4 {
        assert parts[3]
        assert _is_number(parts[3])
        alpha = _fraction(parts[3], 1.0)
    }
    if is_hue {
        var hue = _number_of(parts[0])
        var saturation = _fraction(parts[1], 100.0)
        var lightness = _fraction(parts[2], 100.0)
        return _from_hue(hue, saturation, lightness, alpha)
    }
    var red = _fraction(parts[0], 255.0)
    var green = _fraction(parts[1], 255.0)
    var blue = _fraction(parts[2], 255.0)
    return Color(red, green, blue, alpha)
}

func has_text(piece: String): Boolean {
    return not piece.is_empty()
}

func _is_number(part: String): Boolean {
    var body = _without_unit(part)
    var index = 0
    var digits = 0
    var points = 0
    var valid = not body.is_empty()
    while valid and index < body.length() {
        var code = body.code_at(index)
        if code >= 48 and code <= 57 {
            digits = digits + 1
        } else if code == 46 {
            points = points + 1
        } else {
            valid = index == 0 and (code == 45 or code == 43)
        }
        index = index + 1
    }
    return valid and digits > 0 and points <= 1
}

func _without_unit(part: String): String {
    var part_length = part.length()
    if part.ends_with("%") {
        return part.slice(0, part_length - 1)
    }
    if part.ends_with("deg") {
        return part.slice(0, part_length - 3)
    }
    return part
}

func _number_of(part: String): Float {
    var body = _without_unit(part)
    var value: Float = body
    return value
}

func _fraction(part: String, whole: Float): Float {
    var value = _number_of(part)
    var share = value / whole
    if part.ends_with("%") {
        share = value / 100.0
    }
    return share.clamp(0.0, 1.0)
}

func _from_hue(hue: Float, saturation: Float, lightness: Float, alpha: Float): Color {
    var turns = hue / 360.0
    var whole_turns = turns.floor()
    var sector = (turns - whole_turns) * 6.0
    var lightness_share = 1.0 - (2.0 * lightness - 1.0).absolute()
    var chroma = lightness_share * saturation
    var half_sector = sector * 0.5
    var within_pair = (half_sector - half_sector.floor()) * 2.0
    var sector_share = within_pair - 1.0
    var middle = chroma * (1.0 - sector_share.absolute())
    var red = 0.0
    var green = 0.0
    var blue = 0.0
    if sector < 1.0 {
        red = chroma
        green = middle
    } else if sector < 2.0 {
        red = middle
        green = chroma
    } else if sector < 3.0 {
        green = chroma
        blue = middle
    } else if sector < 4.0 {
        green = middle
        blue = chroma
    } else if sector < 5.0 {
        red = middle
        blue = chroma
    } else {
        red = chroma
        blue = middle
    }
    var lift = lightness - chroma * 0.5
    return Color(red + lift, green + lift, blue + lift, alpha)
}

