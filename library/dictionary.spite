generic $value_type
generic $key_type

var entry_keys = List<$key_type>()
var entry_values = List<$value_type>()
var heap = Memory.Heap()
var slots: Memory.Address = 0
var slot_count = 0
var used_slots = 0

func set_at(key: $key_type, value: $value_type) {
    var existing = index_of_key(key)
    if existing >= 0 {
        entry_values[existing] = value
    } else {
        make_room()
        var position = entry_keys.count()
        place(key, position)
        entry_keys.append(key)
        entry_values.append(value)
    }
}

func get_at(key: $key_type): $value_type? {
    var existing = index_of_key(key)
    if existing >= 0 {
        return entry_values[existing]
    }
    return null
}

func has(key: $key_type): Boolean {
    var existing = index_of_key(key)
    return existing >= 0
}

func remove(key: $key_type) {
    var slot = find_slot(key)
    if slot >= 0 {
        var position = slots.read_integer(slot * 8) - 1
        slots.write_integer(slot * 8, -1)
        entry_values.remove_at(position)
        entry_keys.remove_at(position)
        close_gap(position)
    }
}

func count(): Integer {
    return entry_keys.count()
}

func keys(): List<$key_type> {
    return entry_keys.copy()
}

func values(): List<$value_type> {
    return entry_values.copy()
}

func copy(): Dictionary<$value_type> {
    var copied = Dictionary<$value_type>()
    var index = 0
    while index < entry_keys.count() {
        crash entry_values[index]
        var key = entry_keys[index]
        var value = entry_values[index]
        copied[key] = value
        index = index + 1
    }
    return copied
}

func filter_member(member: Spite.AttributeDeclaration<$value_type>): List<$value_type> {
    var listed = values()
    var filtered = List<$value_type>()
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        if item.attributes[member] {
            filtered.append(item)
        }
        index = index + 1
    }
    return filtered
}

func count_member(member: Spite.AttributeDeclaration<$value_type>): Integer {
    var listed = values()
    var counted = 0
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        if item.attributes[member] {
            counted = counted + 1
        }
        index = index + 1
    }
    return counted
}

func any_member(member: Spite.AttributeDeclaration<$value_type>): Boolean {
    var listed = values()
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        if item.attributes[member] {
            return true
        }
        index = index + 1
    }
    return false
}

func all_member(member: Spite.AttributeDeclaration<$value_type>): Boolean {
    var listed = values()
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        if not item.attributes[member] {
            return false
        }
        index = index + 1
    }
    return true
}

func sum_member(member: Spite.AttributeDeclaration<$value_type>): member.class {
    var listed = values()
    var total: member.class = 0
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        total = total + item.attributes[member]
        index = index + 1
    }
    return total
}

func each_member(member: Spite.AttributeDeclaration<$value_type>) {
    var listed = values()
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        item.attributes[member]
        index = index + 1
    }
}

func map_members(member: Spite.AttributeDeclaration<$value_type>): List<member.class> {
    var listed = values()
    var mapped = List<member.class>()
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        var value = item.attributes[member]
        mapped.append(value)
        index = index + 1
    }
    return mapped
}

func find_by_member(member: Spite.AttributeDeclaration<$value_type>, value: member.class): $value_type? {
    var listed = values()
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        if item.attributes[member] == value {
            return item
        }
        index = index + 1
    }
    return null
}

func sort_by_member(member: Spite.AttributeDeclaration<$value_type>): List<$value_type> {
    var listed = values()
    var item_count = listed.count()
    var member_keys = List<member.class>()
    var order = List<Integer>()
    var index = 0
    while index < listed.count() {
        var item = listed[index]
        var key = item.attributes[member]
        member_keys.append(key)
        order.append(index)
        index = index + 1
    }
    var merged = order.copy()
    var width = 1
    while width < item_count {
        var start = 0
        while start < item_count {
            var middle = start + width
            if middle > item_count {
                middle = item_count
            }
            var end = middle + width
            if end > item_count {
                end = item_count
            }
            var left = start
            var right = middle
            var placed = start
            while placed < end {
                var takes_left = right >= end
                if left < middle and not takes_left {
                    crash order[left]
                    crash order[right]
                    var left_position = order[left]
                    var right_position = order[right]
                    crash member_keys[left_position]
                    crash member_keys[right_position]
                    var left_key = member_keys[left_position]
                    var right_key = member_keys[right_position]
                    var right_first = left_key > right_key
                    takes_left = not right_first
                }
                var taken = right
                if takes_left {
                    taken = left
                    left = left + 1
                } else {
                    right = right + 1
                }
                crash order[taken]
                var position = order[taken]
                merged[placed] = position
                placed = placed + 1
            }
            start = end
        }
        var previous = order
        order = merged
        merged = previous
        width = width * 2
    }
    var sorted = List<$value_type>()
    index = 0
    while index < item_count {
        crash order[index]
        var source = order[index]
        crash listed[source]
        var item = listed[source]
        sorted.append(item)
        index = index + 1
    }
    return sorted
}

func drop() {
    if slots != 0 {
        heap.free(slots)
    }
}

func index_of_key(key: $key_type): Integer {
    var slot = find_slot(key)
    if slot < 0 {
        return -1
    }
    return slots.read_integer(slot * 8) - 1
}

func find_slot(key: $key_type): Integer {
    if slot_count == 0 {
        return -1
    }
    var hash = hash_of(key)
    var fragment = fragment_of(hash)
    var slot = home_slot(hash)
    var stored = slots.read_integer(slot * 8)
    while stored != 0 {
        if $key_type == String {
            if stored > 0 and slots.read_integer(slot * 8 + 4) == fragment and entry_keys[stored - 1] == key {
                return slot
            }
        } else if stored > 0 and entry_keys[stored - 1] == key {
            return slot
        }
        slot = next_slot(slot)
        stored = slots.read_integer(slot * 8)
    }
    return -1
}

func place(key: $key_type, position: Integer) {
    var hash = hash_of(key)
    var slot = home_slot(hash)
    var stored = slots.read_integer(slot * 8)
    while stored > 0 {
        slot = next_slot(slot)
        stored = slots.read_integer(slot * 8)
    }
    if stored == 0 {
        used_slots = used_slots + 1
    }
    slots.write_integer(slot * 8, position + 1)
    var fragment = fragment_of(hash)
    slots.write_integer(slot * 8 + 4, fragment)
}

func close_gap(position: Integer) {
    var slot = 0
    while slot < slot_count {
        var stored = slots.read_integer(slot * 8)
        if stored > position + 1 {
            slots.write_integer(slot * 8, stored - 1)
        }
        slot = slot + 1
    }
}

func make_room() {
    if (used_slots + 1) * 2 > slot_count {
        rebuild_slots()
    }
}

func rebuild_slots() {
    var grown = 8
    while grown < (entry_keys.count() + 1) * 4 {
        grown = grown * 2
    }
    if slots != 0 {
        heap.free(slots)
    }
    slots = heap.allocate(grown * 8)
    slot_count = grown
    used_slots = 0
    var slot = 0
    while slot < slot_count {
        slots.write_long(slot * 8, 0)
        slot = slot + 1
    }
    var position = 0
    while position < entry_keys.count() {
        var key = entry_keys[position]
        place(key, position)
        position = position + 1
    }
}

func hash_of(key: $key_type): UnsignedLong {
    if $key_type == String {
        var hash: UnsignedLong = 1469598103934665603
        var key_length = key.length()
        var index = 0
        while index < key_length {
            var code = key.code_at(index)
            var mixed = hash.bits_exclusive_or(code)
            hash = mixed.wrapping_multiply(1099511628211)
            index = index + 1
        }
        return hash
    } else if $key_type == Tiny or $key_type == Short or $key_type == Integer or $key_type == Long {
        var bits = key.bits_as_unsigned()
        var number: UnsignedLong = bits
        return number.wrapping_multiply(6364136223846793005)
    } else {
        var number: UnsignedLong = key
        return number.wrapping_multiply(6364136223846793005)
    }
}

func home_slot(hash: UnsignedLong): Integer {
    var high = hash.shifted_right(29)
    var mixed = hash.bits_exclusive_or(high)
    var slot: Integer = mixed.bits_and(slot_count - 1)
    return slot
}

func fragment_of(hash: UnsignedLong): Integer {
    var fragment: Integer = hash.shifted_right(33)
    return fragment
}

func next_slot(slot: Integer): Integer {
    if slot + 1 == slot_count {
        return 0
    }
    return slot + 1
}
