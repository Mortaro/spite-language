generic $value_type

var entry_keys = List<String>()
var entry_values = List<$value_type>()
var heap = Memory.Heap()
var slots: Memory.Address = 0
var slot_count = 0
var used_slots = 0

func set(key: String, value: $value_type) {
    var existing = index_of_key(key)
    if existing >= 0 {
        entry_values.set_at(existing, value)
    } else {
        make_room()
        var position = entry_keys.count()
        place(key, position)
        entry_keys.append(key)
        entry_values.append(value)
    }
}

func get(key: String): $value_type? {
    var existing = index_of_key(key)
    if existing >= 0 {
        return entry_values.get_at(existing)
    }
    return null
}

func has(key: String): Boolean {
    var existing = index_of_key(key)
    return existing >= 0
}

func remove(key: String) {
    var slot = find_slot(key)
    if slot >= 0 {
        var position = slots.read_integer(slot * 8) - 1
        slots.write_integer(slot * 8, -1)
        entry_values.remove_at(position)
        entry_keys.remove_at(position)
        close_gap(position)
    }
}

func count(): Integer {
    return entry_keys.count()
}

func keys(): List<String> {
    return entry_keys.copy()
}

func values(): List<$value_type> {
    return entry_values.copy()
}

func copy(): Dictionary<$value_type> {
    var copied = Dictionary<$value_type>()
    var index = 0
    while index < entry_keys.count() {
        var key = entry_keys.get_at(index)
        var value = entry_values.get_at(index)
        copied.set(key, value)
        index = index + 1
    }
    return copied
}

func drop() {
    if slots != 0 {
        heap.free(slots)
    }
}

func index_of_key(key: String): Integer {
    var slot = find_slot(key)
    if slot < 0 {
        return -1
    }
    return slots.read_integer(slot * 8) - 1
}

func find_slot(key: String): Integer {
    if slot_count == 0 {
        return -1
    }
    var hash = hash_of(key)
    var fragment = fragment_of(hash)
    var slot = home_slot(hash)
    var stored = slots.read_integer(slot * 8)
    while stored != 0 {
        if stored > 0 and slots.read_integer(slot * 8 + 4) == fragment and entry_keys.get_at(stored - 1) == key {
            return slot
        }
        slot = next_slot(slot)
        stored = slots.read_integer(slot * 8)
    }
    return -1
}

func place(key: String, position: Integer) {
    var hash = hash_of(key)
    var slot = home_slot(hash)
    var stored = slots.read_integer(slot * 8)
    while stored > 0 {
        slot = next_slot(slot)
        stored = slots.read_integer(slot * 8)
    }
    if stored == 0 {
        used_slots = used_slots + 1
    }
    slots.write_integer(slot * 8, position + 1)
    var fragment = fragment_of(hash)
    slots.write_integer(slot * 8 + 4, fragment)
}

func close_gap(position: Integer) {
    var slot = 0
    while slot < slot_count {
        var stored = slots.read_integer(slot * 8)
        if stored > position + 1 {
            slots.write_integer(slot * 8, stored - 1)
        }
        slot = slot + 1
    }
}

func make_room() {
    if (used_slots + 1) * 2 > slot_count {
        rebuild_slots()
    }
}

func rebuild_slots() {
    var grown = 8
    while grown < (entry_keys.count() + 1) * 4 {
        grown = grown * 2
    }
    if slots != 0 {
        heap.free(slots)
    }
    slots = heap.allocate(grown * 8)
    slot_count = grown
    used_slots = 0
    var slot = 0
    while slot < slot_count {
        slots.write_long(slot * 8, 0)
        slot = slot + 1
    }
    var position = 0
    while position < entry_keys.count() {
        var key = entry_keys.get_at(position)
        place(key, position)
        position = position + 1
    }
}

func hash_of(key: String): UnsignedLong {
    var hash: UnsignedLong = 1469598103934665603
    var key_length = key.length()
    var index = 0
    while index < key_length {
        var code = key.code_at(index)
        hash = hash.bits_exclusive_or(code) * 1099511628211
        index = index + 1
    }
    return hash
}

func home_slot(hash: UnsignedLong): Integer {
    var high = hash.shifted_right(29)
    var mixed = hash.bits_exclusive_or(high)
    var slot: Integer = mixed.bits_and(slot_count - 1)
    return slot
}

func fragment_of(hash: UnsignedLong): Integer {
    var fragment: Integer = hash.shifted_right(32)
    return fragment
}

func next_slot(slot: Integer): Integer {
    assert slot + 1 != slot_count
    return slot + 1
}
