generic $value_type

var path = ""
var _members: List<String>? = null

func write(value: $value_type?): String {
    if $value_type == Null {
        var inner = JsonWriter<$value_type.value_type>()
        inner.path = path
        return inner.write(value)
    } else if $value_type == Boolean {
        if value == true {
            return "true"
        }
        if value == false {
            return "false"
        }
        return "null"
    }
    if value {
        return _written(value)
    }
    return "null"
}

func _written(shown: $value_type): String {
    if $value_type == String {
        return quoted(shown)
    } else if $value_type == Float or $value_type == Double {
        return written_decimal(shown)
    } else if $value_type == Number {
        return shown
    } else if $value_type == Symbol {
        var name: String = shown
        return quoted(name)
    } else if $value_type == List {
        var element_json = JsonWriter<$value_type.element_type>()
        var elements = List<String>()
        var index = 0
        while index < shown.count() {
            element_json.path = "{path}[{index}]"
            var element_text = element_json.write(shown[index])
            elements.append(element_text)
            index = index + 1
        }
        var joined_elements = elements.join(",")
        return "[{joined_elements}]"
    } else if $value_type == Dictionary {
        var entry_json = JsonWriter<$value_type.value_type>()
        var key_json = JsonWriter<$value_type.key_type>()
        var keys = shown.keys()
        var values = shown.values()
        var entries = List<String>()
        var index = 0
        while index < keys.count() {
            var quoted_key = key_json.key_text(keys[index])
            entry_json.path = "{path}[{quoted_key}]"
            var entry_text = entry_json.write(values[index])
            entries.append("{quoted_key}:{entry_text}")
            index = index + 1
        }
        var joined_entries = entries.join(",")
        return "\{{joined_entries}}"
    } else {
        var members = List<String>()
        _members = members
        if $value_type.namespace != Spite {
            shown.attributes.each(write_attribute)
        }
        _members = null
        var joined_members = members.join(",")
        return "\{{joined_members}}"
    }
}

func write_attribute(attribute: Spite.Attribute) {
    if not attribute.name.starts_with("_") and not attribute.is_singleton {
        var attribute_json = JsonWriter<attribute.class>()
        attribute_json.path = "{$value_type.name}.{attribute.name}"
        var attribute_text = attribute_json.write(attribute.value)
        crash _members
        _members.append("\"{attribute.name}\":{attribute_text}")
    }
}

func written_decimal(shown: $value_type): String {
    crash shown - shown == 0
    return shown
}

func quoted(text: String): String {
    var pieces = List<String>()
    var start = 0
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        var escape = escape_of(code)
        if not escape.is_empty() {
            var run = text.slice(start, index)
            pieces.append(run)
            pieces.append(escape)
            start = index + 1
        }
        index = index + 1
    }
    var text_length = text.length()
    var rest = text.slice(start, text_length)
    pieces.append(rest)
    var joined = pieces.join("")
    return "\"{joined}\""
}

func escape_of(code: Integer): String {
    switch code {
        34: return "\\\""
        92: return "\\\\"
        10: return "\\n"
        13: return "\\r"
        9: return "\\t"
        _: {
            if code >= 32 {
                return ""
            }
            var digits = "0123456789abcdef"
            var high = digits.character_at(code / 16)
            var low = digits.character_at(code % 16)
            return "\\u00{high}{low}"
        }
    }
}

func key_text(key: $value_type?): String {
    crash key
    if $value_type == String {
        return quoted(key)
    }
    return "\"{key}\""
}
