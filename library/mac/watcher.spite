var library = DynamicLibrary("libSystem.dylib", 'identity', "")
var queue = -1
var descriptors = List<Integer>()
var paths = List<String>()
var is_folders = List<Boolean>()

func watch_folder(path: String): Boolean {
    return add_folder(path, false)
}

func watch_file(path: String): Boolean {
    return add_entry(path, false)
}

func add_folder(path: String, report_files: Boolean): Boolean {
    var added = add_entry(path, true)
    if not added {
        return false
    }
    var directory = Directory(path)
    var names = directory.files()
    var file_index = 0
    while file_index < names.count() {
        var name = names.get_at(file_index)
        var file_path = joined(path, name)
        add_entry(file_path, false)
        if report_files {
            note(file_path)
        }
        file_index = file_index + 1
    }
    var inner = directory.folders()
    var index = 0
    while index < inner.count() {
        var name = inner.get_at(index)
        var inner_path = joined(path, name)
        add_folder(inner_path, report_files)
        index = index + 1
    }
    return true
}

func add_entry(path: String, is_folder: Boolean): Boolean {
    if queue == -1 {
        queue = library.kqueue()
    }
    if queue == -1 or paths.contains(path) {
        return false
    }
    var opened = library.open(path, 32768)
    if opened == -1 {
        return false
    }
    var change = heap.allocate(32)
    change.write_long(0, opened)
    change.write_short(8, -4)
    change.write_unsigned_short(10, 33)
    change.write_integer(12, 47)
    change.write_long(16, 0)
    change.write_long(24, 0)
    var no_value: Long = 0
    library.kevent(queue, change, 1, no_value, 0, no_value)
    heap.free(change)
    descriptors.append(opened)
    paths.append(path)
    is_folders.append(is_folder)
    return true
}

func collect() {
    assert queue != -1
    var no_wait = heap.allocate(16)
    no_wait.write_long(0, 0)
    no_wait.write_long(8, 0)
    var event = heap.allocate(32)
    var no_value: Long = 0
    while library.kevent(queue, no_value, 0, event, 1, no_wait) > 0 {
        var descriptor = event.read_long(0)
        var flags = event.read_integer(12)
        note_event(descriptor, flags)
    }
    heap.free(event)
    heap.free(no_wait)
}

func note_event(descriptor: Long, flags: Integer) {
    var index = 0
    var found = -1
    while index < descriptors.count() {
        if descriptor == descriptors.get_at(index) {
            found = index
        }
        index = index + 1
    }
    assert found != -1
    var path = paths.get_at(found)
    var is_folder = is_folders.get_at(found)
    if is_folder and flags.bits_and(2) != 0 {
        add_new_entries(path)
    }
    if not is_folder or flags.bits_and(33) != 0 {
        note(path)
    }
    if flags.bits_and(33) != 0 {
        library.close(descriptor)
        descriptors.remove_at(found)
        paths.remove_at(found)
        is_folders.remove_at(found)
        if not is_folder {
            add_entry(path, false)
        }
    }
}

func add_new_entries(path: String) {
    var directory = Directory(path)
    var names = directory.files()
    var file_index = 0
    while file_index < names.count() {
        var name = names.get_at(file_index)
        var file_path = joined(path, name)
        if not paths.contains(file_path) {
            add_entry(file_path, false)
            note(file_path)
        }
        file_index = file_index + 1
    }
    var inner = directory.folders()
    var index = 0
    while index < inner.count() {
        var name = inner.get_at(index)
        var inner_path = joined(path, name)
        if not paths.contains(inner_path) {
            add_folder(inner_path, true)
            note(inner_path)
        }
        index = index + 1
    }
}

func wait_for_event(milliseconds: Long) {
    assert queue != -1
    var timeout = heap.allocate(16)
    timeout.write_long(0, milliseconds / 1000)
    timeout.write_long(8, milliseconds % 1000 * 1000000)
    var waiting: Long = timeout
    if milliseconds < 0 {
        waiting = 0
    }
    var event = heap.allocate(32)
    var no_value: Long = 0
    var ready = library.kevent(queue, no_value, 0, event, 1, waiting)
    if ready > 0 {
        var descriptor = event.read_long(0)
        var flags = event.read_integer(12)
        note_event(descriptor, flags)
    }
    heap.free(event)
    heap.free(timeout)
}

func drop() {
    var index = 0
    while index < descriptors.count() {
        var descriptor = descriptors.get_at(index)
        library.close(descriptor)
        index = index + 1
    }
    if queue != -1 {
        library.close(queue)
    }
}
