var library = DynamicLibrary("libSystem.dylib", 'identity', "")

func open_file(mode: String): Long {
    return library.fopen_as_long(path, mode)
}

func close_file(handle: Long) {
    library.fclose(handle)
}

func seek(handle: Long, offset: Long, origin: Integer) {
    library.fseek(handle, offset, origin)
}

func tell(handle: Long): Long {
    return library.ftell_as_long(handle)
}

func read_into(buffer: Long, bytes: Long, handle: Long): Long {
    return library.fread_as_long(buffer, 1, bytes, handle)
}

func write_from(address: Long, bytes: Long, handle: Long): Long {
    return library.fwrite_as_long(address, 1, bytes, handle)
}

func write_text(text: String, handle: Long): Long {
    var text_length = text.length()
    return library.fwrite_as_long(text, 1, text_length, handle)
}

func modified_nanoseconds(): Long? {
    var status = heap.allocate(256)
    var found = library.stat(path, status)
    var seconds = status.read_long(48)
    var nanoseconds = status.read_long(56)
    heap.free(status)
    assert found == 0
    return seconds * 1000000000 + nanoseconds
}

func remove(): Boolean {
    return library.remove(path) == 0
}

func map(): MappedFile? {
    var read_only = 0
    var descriptor = library.open(path, read_only)
    assert descriptor >= 0
    var from_end = 2
    var bytes: Long = library.lseek_as_long(descriptor, 0, from_end)
    var view: Memory.Address = 0
    if bytes > 0 {
        var no_value: Long = 0
        var readable = 1
        var private_pages = 2
        view = library.mmap_as_long(no_value, bytes, readable, private_pages, descriptor, 0)
    }
    library.close(descriptor)
    assert bytes >= 0 and view != -1
    return MappedFile(view, bytes)
}
