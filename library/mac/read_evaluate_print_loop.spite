var library = DynamicLibrary("libSystem.dylib", 'identity', "")
var heap = Memory.Heap()

func start_thread(entry: Long): Long {
    var slot = heap.allocate(8)
    var no_value: Long = 0
    var created = library.pthread_create(slot, no_value, entry, no_value)
    var started = slot.read_long(0)
    heap.free(slot)
    assert created == 0
    return started
}

func join_thread(started: Long) {
    var no_value: Long = 0
    library.pthread_join(started, no_value)
}

func pause_briefly() {
    library.usleep(1000)
}
