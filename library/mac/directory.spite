var library = DynamicLibrary("libSystem.dylib", 'identity', "")
var memory = Memory()

func exists(): Bool {
    var directory = library.opendir_as_long(path)
    assert directory != 0
    library.closedir(directory)
    return true
}

func create(): Bool {
    return library.mkdir(path, 511) == 0 or exists()
}

func entry_names(want_folders: Bool): List<String> {
    var names = List<String>()
    var directory = library.opendir_as_long(path)
    if directory != 0 {
        var entry = library.readdir_as_long(directory)
        while entry != 0 {
            var is_folder = memory.read_byte(entry, 20) == 4
            var name = memory.terminated_text(entry + 21)
            if is_folder == want_folders and name != "." and name != ".." {
                names.append(name)
            }
            entry = library.readdir_as_long(directory)
        }
        library.closedir(directory)
    }
    return names
}
