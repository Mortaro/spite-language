var library = DynamicLibrary("libSystem.dylib", 'identity', "")

func start_sockets() {}

func open_socket(family: Integer): Long {
    var opened = library.socket(family, 1, 6)
    if opened >= 0 and family == ipv6_family() {
        allow_ipv4_too(opened)
    }
    if opened >= 0 {
        enable_option(opened, 4)
    }
    return opened
}

func enable_option(opened: Integer, option: Integer) {
    var enabled = heap.allocate(4)
    enabled.write_integer(0, 1)
    library.setsockopt(opened, 65535, option, enabled, 4)
    heap.free(enabled)
}

func write_family(address: Memory.Address, family: Integer) {
    var length = 16
    if family == ipv6_family() {
        length = 28
    }
    address.write_byte(0, length)
    address.write_byte(1, family)
}

func read_family(address: Memory.Address): Integer {
    var family: Integer = address.read_byte(1)
    return family
}

func ipv4_family(): Integer {
    return 2
}

func ipv6_family(): Integer {
    return 30
}

func allow_ipv4_too(opened: Long) {
    var disabled = heap.allocate(4)
    disabled.write_integer(0, 0)
    library.setsockopt(opened, 41, 27, disabled, 4)
    heap.free(disabled)
}

func resolve_name(host: String, hints: Memory.Address, found: Memory.Address): Integer {
    var no_service: Long = 0
    return library.getaddrinfo(host, no_service, hints, found)
}

func resolved_address_offset(): Integer {
    return 32
}

func free_resolved(first: Memory.Address) {
    library.freeaddrinfo(first)
}

func bind_address(address: Memory.Address): Boolean {
    var length = address_length(address)
    return library.bind(handle, address, length) == 0
}

func listen_for_clients(): Boolean {
    return library.listen(handle, 64) == 0
}

func accept_handle(): Long {
    var no_address: Long = 0
    var accepted = library.accept(handle, no_address, no_address)
    if accepted >= 0 {
        enable_option(accepted, 4130)
    }
    return accepted
}

func connect_address(address: Memory.Address): Boolean {
    enable_option(handle, 4130)
    var length = address_length(address)
    return library.connect(handle, address, length) == 0
}

func receive_into(buffer: Long, bytes: Integer): Integer {
    var wanted: Long = bytes
    return library.recv_as_long(handle, buffer, wanted, 0)
}

func send_text(text: String): Integer {
    var text_length: Long = text.length()
    return library.send_as_long(handle, text, text_length, 0)
}

func send_from(buffer: Long, bytes: Integer): Integer {
    var wanted: Long = bytes
    return library.send_as_long(handle, buffer, wanted, 0)
}

func use_blocking_calls() {}

func accept_now(): Long {
    var waiting = heap.allocate(8)
    var descriptor: Integer = handle
    waiting.write_integer(0, descriptor)
    waiting.write_short(4, 1)
    waiting.write_short(6, 0)
    var ready = library.poll(waiting, 1, 0)
    heap.free(waiting)
    if ready <= 0 {
        return -1
    }
    var no_address: Long = 0
    var accepted = library.accept(handle, no_address, no_address)
    if accepted >= 0 {
        enable_option(accepted, 4130)
    }
    return accepted
}

func receive_now(buffer: Long, bytes: Integer): Integer {
    var wanted: Long = bytes
    var received = library.recv_as_long(handle, buffer, wanted, 128)
    if received > 0 {
        return received
    }
    if received < 0 and would_block() {
        return 0
    }
    return -1
}

func send_now(buffer: Long, bytes: Integer): Integer {
    var wanted: Long = bytes
    var sent = library.send_as_long(handle, buffer, wanted, 128)
    if sent >= 0 {
        return sent
    }
    if would_block() {
        return 0
    }
    return -1
}

func would_block(): Boolean {
    var error: Memory.Address = library.__error_as_long()
    var code = error.read_integer(0)
    return code == 35 or code == 4
}

func close_handle() {
    library.close(handle)
}

func first_readable(handles: List<Long>, milliseconds: Integer): Integer {
    var count = handles.count()
    var watched = heap.allocate(count * 8)
    var index = 0
    while index < count {
        var watched_handle = handles[index]
        var descriptor: Integer = watched_handle
        watched.write_integer(index * 8, descriptor)
        watched.write_short(index * 8 + 4, 1)
        watched.write_short(index * 8 + 6, 0)
        index = index + 1
    }
    var watched_count: Long = count
    var ready = library.poll(watched, watched_count, milliseconds)
    var found = -1
    if ready < 0 {
        found = -2
    }
    index = 0
    while ready > 0 and found < 0 and index < count {
        if watched.read_short(index * 8 + 6) != 0 {
            found = index
        }
        index = index + 1
    }
    heap.free(watched)
    return found
}
