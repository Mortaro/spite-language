var library = DynamicLibrary("libSystem.dylib", 'identity', "")

func start_sockets() {}

func open_socket(): Long {
    var opened = library.socket(2, 1, 6)
    if opened >= 0 {
        enable_option(opened, 4)
    }
    return opened
}

func enable_option(opened: Int, option: Int) {
    var enabled = heap.allocate(4)
    enabled.write_int(0, 1)
    library.setsockopt(opened, 65535, option, enabled, 4)
    heap.free(enabled)
}

func write_family(address: Memory.Address) {
    address.write_byte(0, 16)
    address.write_byte(1, 2)
}

func bind_address(address: Memory.Address): Bool {
    return library.bind(handle, address, 16) == 0
}

func listen_for_clients(): Bool {
    return library.listen(handle, 1) == 0
}

func accept_handle(): Long {
    var no_address: Long = 0
    var accepted = library.accept(handle, no_address, no_address)
    if accepted >= 0 {
        enable_option(accepted, 4130)
    }
    return accepted
}

func connect_address(address: Memory.Address): Bool {
    enable_option(handle, 4130)
    return library.connect(handle, address, 16) == 0
}

func receive_into(buffer: Long, bytes: Int): Int {
    var wanted: Long = bytes
    return library.recv_as_long(handle, buffer, wanted, 0)
}

func send_text(text: String): Int {
    var text_length: Long = text.length()
    return library.send_as_long(handle, text, text_length, 0)
}

func close_handle() {
    library.close(handle)
}
