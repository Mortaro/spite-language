var library = DynamicLibrary("libSystem.dylib", 'identity', "")
var heap = Memory.Heap()

func current_thread(): Long {
    return library.pthread_self_as_long()
}

func create_event(event_loop: SchedulerLoop) {
    var ends = heap.allocate(8)
    library.pipe(ends)
    event_loop.wake = ends.read_integer(0)
    event_loop.wake_signal = ends.read_integer(4)
    heap.free(ends)
}

func signal_event(event_loop: SchedulerLoop) {
    library.write(event_loop.wake_signal, "!", 1)
}

func wait_event(event_loop: SchedulerLoop, milliseconds: Integer) {
    var watched = heap.allocate(8)
    watched.write_integer(0, event_loop.wake)
    watched.write_integer(4, 1)
    if library.poll(watched, 1, milliseconds) > 0 {
        var drained = heap.allocate(64)
        library.read(event_loop.wake, drained, 64)
        heap.free(drained)
    }
    heap.free(watched)
}

func clock(): Long {
    var time = heap.allocate(16)
    library.clock_gettime(6, time)
    var seconds = time.read_long(0)
    var nanoseconds = time.read_long(8)
    heap.free(time)
    return seconds * 1000 + nanoseconds / 1000000
}

func start_thread(entry: Long, argument: Long): Long {
    var slot = heap.allocate(8)
    var no_value: Long = 0
    var created = library.pthread_create(slot, no_value, entry, argument)
    var thread = slot.read_long(0)
    heap.free(slot)
    if created != 0 {
        return 0
    }
    return thread
}

func end_thread(thread: Long) {
    var no_value: Long = 0
    library.pthread_join(thread, no_value)
}
