var library = DynamicLibrary("libSystem.dylib", 'identity', "")

func elapsed_nanoseconds(): Long {
    return read_clock(6)
}

func now(): Instant {
    var time = heap.allocate(16)
    library.clock_gettime(0, time)
    var seconds = time.read_long(0)
    var nanoseconds = time.read_long(8)
    heap.free(time)
    var whole = Duration(seconds, 'seconds')
    var part = Duration(nanoseconds, 'nanoseconds')
    return Instant(whole + part)
}

func read_clock(clock: Int): Long {
    var time = heap.allocate(16)
    library.clock_gettime(clock, time)
    var seconds = time.read_long(0)
    var nanoseconds = time.read_long(8)
    heap.free(time)
    return seconds * 1000000000 + nanoseconds
}
