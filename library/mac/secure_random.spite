var _library = DynamicLibrary("libSystem.dylib", 'identity', "")

func _fill(filled: Buffer, count: Integer) {
    var written = 0
    while written < count {
        var at = filled.items + written
        var wanted = count - written
        if wanted > 256 {
            wanted = 256
        }
        var status = _library.getentropy(at, wanted)
        crash status == 0
        written = written + wanted
    }
    filled.item_count = count
}
