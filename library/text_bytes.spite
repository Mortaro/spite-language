var memory = Memory()

func concat(left: String, right: String): String {
    var total = left.length() + right.length()
    var address = memory.allocate_bytes(total + 1)
    var left_address = memory.address_of(left)
    var left_length = left.length()
    memory.copy_bytes(left_address, address, left_length)
    var right_address = memory.address_of(right)
    var right_length = right.length()
    memory.copy_bytes(right_address, address + left_length, right_length)
    return memory.take_text(address, total)
}

func equals(left: String, right: String): Bool {
    if left.length() != right.length() {
        return false
    }
    var left_address = memory.address_of(left)
    var right_address = memory.address_of(right)
    var left_length = left.length()
    return memory.compare_bytes(left_address, right_address, left_length) == 0
}

func less(left: String, right: String): Bool {
    var shortest = left.length()
    if right.length() < shortest {
        shortest = right.length()
    }
    var left_address = memory.address_of(left)
    var right_address = memory.address_of(right)
    var comparison = memory.compare_bytes(left_address, right_address, shortest)
    if comparison != 0 {
        return comparison < 0
    }
    return left.length() < right.length()
}

func slice(text: String, start: Int, end: Int): String {
    var text_length = text.length()
    var first = clamped(start, text_length)
    var last = clamped(end, text_length)
    if last <= first {
        return ""
    }
    var text_address = memory.address_of(text)
    return memory.text(text_address + first, last - first)
}

func clamped(position: Int, length: Int): Int {
    if position < 0 {
        return 0
    }
    if position > length {
        return length
    }
    return position
}

func is_singleton(): Bool {
    return true
}
