var memory = Memory()

func concat(left: String, right: String): String {
    var total = left.length() + right.length()
    var address = memory.allocate_bytes(total + 1)
    memory.copy_bytes(memory.address_of(left), address, left.length())
    memory.copy_bytes(memory.address_of(right), address + left.length(), right.length())
    return memory.take_text(address, total)
}

func equals(left: String, right: String): Bool {
    if left.length() != right.length() {
        return false
    }
    return memory.compare_bytes(memory.address_of(left), memory.address_of(right), left.length()) == 0
}

func less(left: String, right: String): Bool {
    var shortest = left.length()
    if right.length() < shortest {
        shortest = right.length()
    }
    var comparison = memory.compare_bytes(memory.address_of(left), memory.address_of(right), shortest)
    if comparison != 0 {
        return comparison < 0
    }
    return left.length() < right.length()
}

func slice(text: String, start: Int, end: Int): String {
    var first = clamped(start, text.length())
    var last = clamped(end, text.length())
    if last <= first {
        return ""
    }
    return memory.text(memory.address_of(text) + first, last - first)
}

func clamped(position: Int, length: Int): Int {
    if position < 0 {
        return 0
    }
    if position > length {
        return length
    }
    return position
}

func is_singleton(): Bool {
    return true
}
