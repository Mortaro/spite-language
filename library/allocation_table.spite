var heap = Memory.Heap()
var console = Console()
var slots: Memory.Address = 0
var capacity: Long = 0
var divisor: UnsignedLong = 0
var live_count: Long = 0
var live_byte_count: Long = 0
var used_count: Long = 0
var allocations: Long = 0
var frees: Long = 0
var kinds: Memory.Address = 0
var sizes: Memory.Address = 0
var class_names: Memory.Address = 0
var class_name_count: Long = 0

func resize(address: Long, bytes: Long): Long {
    var kept_bytes: Long = 0
    if address == 0 {
        allocations = allocations + 1
    } else {
        kept_bytes = size_of(address)
        forget_live(address, "reallocating a pointer that was already freed (or never allocated)")
    }
    var result: Memory.Address = heap.resize(address, bytes)
    if result != 0 {
        remember(result, bytes)
        fill_unwritten(result, kept_bytes, bytes)
    }
    return result
}

func size_of(address: Long): Long {
    var slot = find(address)
    if slot < 0 {
        return 0
    }
    return sizes.read_long(slot * 8)
}

func fill_unwritten(address: Memory.Address, from: Long, bytes: Long) {
    var position = from
    while position + 8 <= bytes {
        address.write_long(position, -6510615555426900571)
        position = position + 8
    }
    while position < bytes {
        var pattern: Byte = 165
        address.write_byte(position, pattern)
        position = position + 1
    }
}

func free(address: Long) {
    forget_live(address, "double free (or freeing an unknown pointer)")
    frees = frees + 1
    heap.free(address)
}

func live_allocations(): Long {
    return live_count
}

func live_bytes(): Long {
    return live_byte_count
}

func register_object(address: Long, class_id: Integer) {
    var slot = find(address)
    if slot >= 0 {
        kinds.write_long(slot * 8, class_id)
    }
}

func name_classes(names: Long, count: Long) {
    class_names = names
    class_name_count = count
}

func report() {
    if allocations != frees {
        report_leaks()
    }
    console.print("allocations:", allocations, "frees:", frees)
}

func report_leaks() {
    console.error("spite: --debug-memory:", allocations - frees, "allocation(s) leaked")
    var class_id: Long = 0
    while class_id < class_name_count {
        var leaked = leaked_objects(class_id)
        if leaked > 0 {
            var class_name_address: Memory.Address = class_names.read_long(class_id * 8)
            console.error("  {class_name_address.terminated_text()}:", leaked, "leaked object(s)")
        }
        class_id = class_id + 1
    }
}

func leaked_objects(class_id: Long): Long {
    var leaked: Long = 0
    var slot: Long = 0
    while slot < capacity {
        var kept = slots.read_long(slot * 8)
        if kept != 0 and kept != 1 and kinds.read_long(slot * 8) == class_id {
            leaked = leaked + 1
        }
        slot = slot + 1
    }
    return leaked
}

func forget_live(address: Long, mistake: String) {
    var was_live = forget(address)
    if not was_live {
        console.error("spite: --debug-memory: {mistake} (an ownership bug)")
    }
    crash was_live
}

func remember(address: Long, bytes: Long) {
    if (used_count + 1) * 2 >= capacity {
        grow()
    }
    place(address, -1, bytes)
    live_count = live_count + 1
    live_byte_count = live_byte_count + bytes
    used_count = used_count + 1
}

func forget(address: Long): Boolean {
    var slot = find(address)
    if slot < 0 {
        return false
    }
    live_byte_count = live_byte_count - sizes.read_long(slot * 8)
    slots.write_long(slot * 8, 1)
    live_count = live_count - 1
    return true
}

func find(address: Long): Long {
    if capacity == 0 {
        return -1
    }
    var slot = slot_of(address)
    var kept = slots.read_long(slot * 8)
    while kept != 0 {
        if kept == address {
            return slot
        }
        slot = next_slot(slot)
        kept = slots.read_long(slot * 8)
    }
    return -1
}

func place(address: Long, kind: Long, bytes: Long) {
    var slot = slot_of(address)
    var kept = slots.read_long(slot * 8)
    while kept != 0 and kept != 1 {
        slot = next_slot(slot)
        kept = slots.read_long(slot * 8)
    }
    slots.write_long(slot * 8, address)
    kinds.write_long(slot * 8, kind)
    sizes.write_long(slot * 8, bytes)
}

func grow() {
    var new_capacity: Long = 1024
    if capacity > 0 {
        new_capacity = capacity * 2
    }
    while (live_count + 1) * 4 >= new_capacity * 3 {
        new_capacity = new_capacity * 2
    }
    var old_slots = slots
    var old_kinds = kinds
    var old_sizes = sizes
    var old_capacity = capacity
    slots = heap.allocate(new_capacity * 8)
    kinds = heap.allocate(new_capacity * 8)
    sizes = heap.allocate(new_capacity * 8)
    capacity = new_capacity
    var span: UnsignedLong = new_capacity
    var largest: UnsignedLong = 0 - 1
    divisor = largest / span + 1
    var index: Long = 0
    while index < new_capacity {
        slots.write_long(index * 8, 0)
        index = index + 1
    }
    index = 0
    while index < old_capacity {
        var kept = old_slots.read_long(index * 8)
        if kept != 0 and kept != 1 {
            var kind = old_kinds.read_long(index * 8)
            var kept_bytes = old_sizes.read_long(index * 8)
            place(kept, kind, kept_bytes)
        }
        index = index + 1
    }
    heap.free(old_slots)
    heap.free(old_kinds)
    heap.free(old_sizes)
    used_count = live_count
}

func slot_of(address: Long): Long {
    var hashed: UnsignedLong = address
    return hashed.wrapping_multiply(6364136223846793005) / divisor
}

func next_slot(slot: Long): Long {
    if slot + 1 == capacity {
        return 0
    }
    return slot + 1
}
