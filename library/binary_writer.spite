generic $value_type

var format = BinaryFormat<$value_type>()

func write(value: $value_type): List<Byte> {
    var bytes = List<Byte>()
    append_to(value, bytes)
    return bytes
}

func append_to(value: $value_type, bytes: List<Byte>) {
    var output = BinaryOutput(bytes)
    format.write(value, output)
}
