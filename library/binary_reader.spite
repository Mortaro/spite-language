generic $value_type

var bytes: Vector<Byte>? = null
var position = 0
var format = BinaryFormat<$value_type>()
var input = BinaryInput()

func BinaryReader(source: Vector<Byte>?) {
    bytes = source
}

func read(): $value_type? {
    assert bytes
    input.address = bytes.items
    input.count = bytes.count()
    return read_input()
}

func read_memory(address: Memory.Address, count: Integer): $value_type? {
    input.address = address
    input.count = count
    position = 0
    return read_input()
}

func remaining(): Integer {
    if bytes {
        return bytes.count() - position
    }
    return input.count - position
}

func read_input(): $value_type? {
    assert position < input.count
    input.position = position
    input.failed = false
    var read_value = format.read(input)
    assert not input.failed
    position = input.position
    return read_value
}
