generic $value_type

var position = 0
var format = BinaryFormat<$value_type>()

func read(bytes: Buffer): $value_type? {
    var read_value = read_from(bytes, 0)
    assert position == bytes.count()
    return read_value
}

func read_from(bytes: Buffer, start: Integer): $value_type? {
    crash start >= 0
    crash start <= bytes.count()
    var cursor = BinaryCursor(bytes)
    cursor.position = start
    var read_value = format.read(cursor)
    assert not cursor.failed
    position = cursor.position
    return read_value
}

func read_memory(address: Memory.Address, count: Integer): $value_type?
