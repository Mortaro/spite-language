var _address: Long = 0
var _context: Long = 0
var _function: Spite.Function? = null
var _registration: Memory.Address = 0

func ForeignCallback(function: Spite.Function, _where_context: Symbol) {
    _function = function
}

func get_address(): Long {
    return _address
}

func get_context(): Long {
    return _context
}

func drop() {
    if _registration != 0 {
        _registration.write_long_atomically(0, 0)
    }
}
