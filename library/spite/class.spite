var _name: Symbol = 'Nothing'
var _namespace: Spite.Namespace? = null
var _singleton = false
var _attributes = List<Spite.Attribute>()
var _functions = List<Spite.Function>()

func Class(starting_name: Symbol) {
    _name = starting_name
}

func get_name(): Symbol {
    return _name
}

func get_namespace(): Spite.Namespace? {
    return _namespace
}

func get_attributes(): List<Spite.Attribute> {
    return _attributes
}

func get_functions(): List<Spite.Function> {
    return _functions
}

func is_singleton(): Boolean {
    return _singleton
}

func has_function(name: String): Boolean {
    var found = false
    var index = 0
    while not found and index < _functions.count() {
        found = _functions[index].name_fits(name)
        index = index + 1
    }
    return found
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
