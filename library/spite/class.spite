var _name: Symbol = 'Nothing'
var _namespace: Spite.Namespace? = null
var _singleton = false
var _fits_vector = false
var _source_folder = ""
var _package_folder = ""
var _attributes = List<Spite.Attribute>()
var _functions = List<Spite.Function>()
var _unbound_functions: List<Spite.Function>? = null

func Class(starting_name: Symbol) {
    _name = starting_name
}

func get_name(): Symbol {
    return _name
}

func get_namespace(): Spite.Namespace? {
    return _namespace
}

func get_attributes(): List<Spite.Attribute> {
    return _attributes
}

func get_functions(): List<Spite.Function> {
    return _functions
}

func is_singleton(): Boolean {
    return _singleton
}

func get_is_singleton(): Boolean {
    return _singleton
}

func get_is_fixed_size(): Boolean {
    return _fits_vector
}

func has_function(name: String): Boolean {
    var found = false
    var index = 0
    while not found and index < _functions.count() {
        found = _functions[index].name_fits(name)
        index = index + 1
    }
    return found
}

func source_folder(): String {
    return _source_folder
}

func package_folder(): String {
    return _package_folder
}

func fits_vector(): Boolean {
    return _fits_vector
}

func function_waits(name: String): Boolean {
    if _unbound_functions {
        return _any_function_waits(_unbound_functions, name)
    }
    return _any_function_waits(_functions, name)
}

func argument_count(name: String): Integer {
    if _unbound_functions {
        return _first_argument_count(_unbound_functions, name)
    }
    return _first_argument_count(_functions, name)
}

func _first_argument_count(functions: List<Spite.Function>, name: String): Integer {
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        if function.name_fits(name) {
            return function.argument_count()
        }
        index = index + 1
    }
    return 0
}

func _any_function_waits(functions: List<Spite.Function>, name: String): Boolean {
    var found = false
    var index = 0
    while not found and index < functions.count() {
        var function = functions[index]
        found = function.name_fits(name) and function.waits()
        index = index + 1
    }
    return found
}

func to_string(): String {
    return _name
}

func to_debug(): String {
    return _name
}
