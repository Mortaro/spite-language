var _name: Symbol = 'unnamed'
var _arguments = List<Spite.Argument>()
var _returns = Spite.Class('Nothing')
var _waits = false
var _returned_literal = ""
var _has_returned_literal = false
var _accessed = ""
var _accessed_names: List<Symbol>? = null
var _accessed_classes: List<Spite.Class>? = null

func Function(starting_name: Symbol, starting_returns: Spite.Class) {
    _name = starting_name
    _returns = starting_returns
}

func get_name(): Symbol {
    return _name
}

func get_arguments(): List<Spite.Argument> {
    return _arguments
}

func get_returns(): Spite.Class {
    return _returns
}

func argument_count(): Integer {
    var described = get_arguments()
    return described.count()
}

func waits(): Boolean {
    return _waits
}

func get_is_resumable(): Boolean {
    return _waits
}

func get_returned_literal(): String {
    crash _has_returned_literal
    return _returned_literal
}

func get_accesses(): Dictionary<Spite.Access> {
    crash _accessed_names
    crash _accessed_classes
    var accesses = Dictionary<Spite.Access>()
    var entries = _accessed.split(";")
    var index = 0
    while index < _accessed_names.count() {
        var name = _accessed_names[index]
        var described = _accessed_classes[index]
        crash described
        var entry = entries[index]
        crash entry
        var read = entry.character_at(1) == "r"
        var written = entry.character_at(2) == "w"
        if entry.starts_with("a") {
            var attribute = Spite.Attribute(name, described)
            accesses[name] = Spite.Access(attribute, read, written)
        } else {
            var argument = Spite.Argument(name, described)
            accesses[name] = Spite.Access(argument, read, written)
        }
        index = index + 1
    }
    return accesses
}

func name_fits(pattern: String): Boolean {
    var opening = pattern.index_of("<")
    var closing = pattern.index_of(">")
    if opening < 0 or closing < opening {
        return _name == pattern
    }
    var pattern_length = pattern.length()
    var prefix = pattern.slice(0, opening)
    var suffix = pattern.slice(closing + 1, pattern_length)
    var prefix_length = prefix.length()
    var suffix_length = suffix.length()
    var name_length = _name.length()
    return name_length > prefix_length + suffix_length and _name.starts_with(prefix) and _name.ends_with(suffix)
}
