type Object {
}

var _name: Symbol = 'unnamed'
var _class = Spite.Class('Nothing')
var _value = ""
var _object: Object? = null

func Attribute(starting_name: Symbol, starting_class: Spite.Class, starting_value: String) {
    _name = starting_name
    _class = starting_class
    _value = starting_value
}

func get_name(): Symbol {
    return _name
}

func get_class(): Spite.Class {
    return _class
}

func get_value(): String {
    return _value
}

func get_object(): Object? {
    return _object
}
