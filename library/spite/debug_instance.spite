singleton

generic $value_type

var _trail = List<$value_type>()
var _parts: List<String>? = null
var _guard = DebugGuard()

func text(value: $value_type): String {
    _guard.enter()
    var walked = _walked(value)
    _guard.leave()
    return walked
}

func _walked(value: $value_type): String {
    var name = value.class.name
    var index = 0
    while index < _trail.count() {
        if _trail[index] == value {
            return "{name} \{...}"
        }
        index = index + 1
    }
    _trail.append(value)
    var parts = List<String>()
    var outer_parts = _parts
    _parts = parts
    if $value_type.namespace != Spite {
        value.attributes.each(debug_attribute)
    }
    _parts = outer_parts
    _trail.remove_last()
    if parts.is_empty() {
        return "{name} \{}"
    }
    var joined_parts = parts.join(", ")
    return "{name} \{ {joined_parts} }"
}

func debug_attribute(attribute: Spite.Attribute) {
    if not attribute.name.starts_with("_") {
        var attribute_debug = Debug<attribute.class>()
        var attribute_text = attribute_debug.text(attribute.value)
        crash _parts
        _parts.append("{attribute.name}: {attribute_text}")
    }
}
