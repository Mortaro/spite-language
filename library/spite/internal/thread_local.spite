generic $value_type

var _slot = ThreadSlot()
var _lock = Lock()
var _heap = Memory.Heap()
var _values = TypedMemory<$value_type>()
var _published = _heap.allocate(8)
var _count = 0
var _capacity = 0
var _retired = List<Memory.Address>()

func ThreadLocal() {
    _published.write_long_atomically(0, 0)
}

func get(): $value_type? {
    var position = _slot.read()
    assert position != 0
    var items: Memory.Address = _published.read_long_atomically(0)
    return _values.read_value(items, position - 1)
}

func set(value: $value_type) {
    var position = _slot.read()
    _lock.lock()
    if position == 0 {
        var items = _make_room()
        _values.write_value(items, _count, value)
        _count = _count + 1
        _slot.write(_count)
    } else {
        var items: Memory.Address = _published.read_long_atomically(0)
        _values.release_value(items, position - 1)
        _values.write_value(items, position - 1, value)
    }
    _lock.unlock()
}

func _make_room(): Memory.Address {
    var items: Memory.Address = _published.read_long_atomically(0)
    if _count == _capacity {
        var grown = _capacity * 2
        if _capacity == 0 {
            grown = 4
        }
        var bytes = _values.value_bytes()
        var larger = _heap.allocate(bytes * grown)
        if items != 0 {
            items.copy_to(larger, bytes * _count)
            _retired.append(items)
        }
        _published.write_long_atomically(0, larger)
        _capacity = grown
        items = larger
    }
    return items
}

func drop() {
    var items: Memory.Address = _published.read_long_atomically(0)
    if items != 0 {
        var index = 0
        while index < _count {
            _values.release_value(items, index)
            index = index + 1
        }
        _heap.free(items)
    }
    while not _retired.is_empty() {
        var old_items = _retired.remove_last()
        crash old_items
        _heap.free(old_items)
    }
    _heap.free(_published)
}
