var name = ""
var name_with_namespaces = ""
var parent: Spite.Namespace? = null
var classes = List<Spite.Class>()
var namespaces = List<Spite.Namespace>()

func Namespace(starting_name: String, starting_name_with_namespaces: String) {
    name = starting_name
    name_with_namespaces = starting_name_with_namespaces
}
