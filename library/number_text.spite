singleton

var heap = Memory.Heap()

func exact_digits(multiplier: Long, exponent: Long): String {
    var twos: Long = 0
    var fives: Long = 0
    if exponent > 0 {
        twos = exponent
    } else {
        fives = -exponent
    }
    var capacity = (twos / 3 + fives * 3 / 4 + 20) / 9 + 2
    var limbs = heap.allocate(capacity * 8)
    var count: Long = 0
    var rest = multiplier
    while rest > 0 {
        limbs.write_long(count * 8, rest % 1000000000)
        rest = rest / 1000000000
        count = count + 1
    }
    while twos > 0 {
        var step = twos
        if step > 30 {
            step = 30
        }
        var power_of_two = power(2, step)
        count = multiplied(limbs, count, power_of_two)
        twos = twos - step
    }
    while fives > 0 {
        var step = fives
        if step > 13 {
            step = 13
        }
        var power_of_five = power(5, step)
        count = multiplied(limbs, count, power_of_five)
        fives = fives - step
    }
    var size = count * 9
    var address = heap.allocate(size)
    var limb_index: Long = 0
    while limb_index < count {
        var limb = limbs.read_long(limb_index * 8)
        var position = size - limb_index * 9
        var place = 0
        while place < 9 {
            position = position - 1
            address.write_byte(position, limb % 10 + 48)
            limb = limb / 10
            place = place + 1
        }
        limb_index = limb_index + 1
    }
    heap.free(limbs)
    var start: Long = 0
    while address.read_byte(start) == 48 {
        start = start + 1
    }
    var text = (address + start).text(size - start)
    heap.free(address)
    return text
}

func multiplied(limbs: Memory.Address, count: Long, factor: Long): Long {
    var carry: Long = 0
    var index: Long = 0
    while index < count {
        var product = limbs.read_long(index * 8) * factor + carry
        limbs.write_long(index * 8, product % 1000000000)
        carry = product / 1000000000
        index = index + 1
    }
    var grown = count
    while carry > 0 {
        limbs.write_long(grown * 8, carry % 1000000000)
        carry = carry / 1000000000
        grown = grown + 1
    }
    return grown
}

func power(base: Long, times: Long): Long {
    var result: Long = 1
    var remaining = times
    while remaining > 0 {
        result = result * base
        remaining = remaining - 1
    }
    return result
}

func decimal_exponent(digits: String, exponent: Long): Long {
    if exponent > 0 {
        return digits.length() - 1
    }
    return exponent + digits.length() - 1
}

func rounded_digits(digits: String, count: Long): String {
    if digits.length() <= count {
        return digits
    }
    var address = heap.allocate(count + 1)
    address.write_byte(0, 48)
    var index: Long = 0
    while index < count {
        var code_of_digit = digits.code_at(index)
        address.write_byte(index + 1, code_of_digit)
        index = index + 1
    }
    if rounds_up(digits, count) {
        var position = count
        while address.read_byte(position) == 57 {
            address.write_byte(position, 48)
            position = position - 1
        }
        var digit_byte = address.read_byte(position)
        address.write_byte(position, digit_byte + 1)
    }
    var start: Long = 1
    if address.read_byte(0) != 48 {
        start = 0
    }
    var text = (address + start).text(count + 1 - start)
    heap.free(address)
    return text
}

func rounds_up(digits: String, count: Long): Boolean {
    var next = digits.code_at(count)
    if next != 53 {
        return next > 53
    }
    var index = count + 1
    while index < digits.length() {
        if digits.code_at(index) != 48 {
            return true
        }
        index = index + 1
    }
    return digits.code_at(count - 1) % 2 == 1
}

func without_trailing_zeros(digits: String): String {
    var end = digits.length()
    while end > 1 and digits.code_at(end - 1) == 48 {
        end = end - 1
    }
    return digits.slice(0, end)
}

func is_fixed(exponent: Long, precision: Long): Boolean {
    return exponent >= -4 and exponent < precision
}

func compared(left: String, left_exponent: Long, right: String, right_exponent: Long): Long {
    if left_exponent != right_exponent {
        if left_exponent > right_exponent {
            return 1
        }
        return -1
    }
    var index = 0
    while index < left.length() or index < right.length() {
        var left_code = digit_code(left, index)
        var right_code = digit_code(right, index)
        if left_code != right_code {
            if left_code > right_code {
                return 1
            }
            return -1
        }
        index = index + 1
    }
    return 0
}

func digit_code(digits: String, index: Long): Long {
    if index < digits.length() {
        return digits.code_at(index)
    }
    return 48
}

func zeros(count: Long): String {
    var text = ""
    var index: Long = 0
    while index < count {
        text = "{text}0"
        index = index + 1
    }
    return text
}

func fixed_text(digits: String, exponent: Long): String {
    if exponent < 0 {
        return "0.{zeros(-exponent - 1)}{digits}"
    }
    if digits.length() <= exponent + 1 {
        var digits_length = digits.length()
        return "{digits}{zeros(exponent + 1 - digits_length)}"
    }
    var digits_length = digits.length()
    return "{digits.slice(0, exponent + 1)}.{digits.slice(exponent + 1, digits_length)}"
}

func scientific_text(digits: String, exponent: Long): String {
    var mantissa = digits.slice(0, 1)
    if digits.length() > 1 {
        var digits_length = digits.length()
        mantissa = "{mantissa}.{digits.slice(1, digits_length)}"
    }
    var sign = "+"
    var magnitude = exponent
    if exponent < 0 {
        sign = "-"
        magnitude = -exponent
    }
    var padding = ""
    if magnitude < 10 {
        padding = "0"
    }
    return "{mantissa}e{sign}{padding}{magnitude}"
}
