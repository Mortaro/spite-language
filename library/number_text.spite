var memory = Memory()

func long_text(value: Long): String {
    if value == 0 {
        return "0"
    }
    var address = memory.allocate_bytes(24)
    var position: Long = 24
    var rest = value
    while rest != 0 {
        var digit = rest % 10
        if digit < 0 {
            digit = -digit
        }
        position = position - 1
        memory.write_byte(address, position, 48 + digit)
        rest = rest / 10
    }
    if value < 0 {
        position = position - 1
        memory.write_byte(address, position, 45)
    }
    var text = memory.text(address + position, 24 - position)
    memory.free(address)
    return text
}

func double_text(value: Double): String {
    return decimal_text(value, 9007199254740992, -1074, 17)
}

func float_text(value: Float): String {
    var wide: Double = value
    return decimal_text(wide, 16777216, -149, 9)
}

func decimal_text(value: Double, significand_limit: Long, lowest_exponent: Long, most_digits: Long): String {
    var bits = bits_of(value)
    if bits < 0 {
        var magnitude = decimal_text(-value, significand_limit, lowest_exponent, most_digits)
        if magnitude == "nan" {
            return magnitude
        }
        return "-{magnitude}"
    }
    var field = bits / 4503599627370496
    var significand = bits % 4503599627370496
    if field == 2047 {
        if significand == 0 {
            return "inf"
        }
        return "nan"
    }
    if bits == 0 {
        return "0"
    }
    var exponent: Long = -1074
    if field > 0 {
        significand = significand + 4503599627370496
        exponent = field - 1075
    }
    while significand >= significand_limit or exponent < lowest_exponent {
        significand = significand / 2
        exponent = exponent + 1
    }
    var digits = exact_digits(significand, exponent)
    var digits_exponent = decimal_exponent(digits, exponent)
    var upper = exact_digits(significand * 2 + 1, exponent - 1)
    var upper_exponent = decimal_exponent(upper, exponent - 1)
    var lower = exact_digits(significand * 2 - 1, exponent - 1)
    var lower_exponent = decimal_exponent(lower, exponent - 1)
    if significand * 2 == significand_limit and exponent > lowest_exponent {
        lower = exact_digits(significand * 4 - 1, exponent - 2)
        lower_exponent = decimal_exponent(lower, exponent - 2)
    }
    var even = significand % 2 == 0
    var precision: Long = 1
    while precision <= most_digits {
        var candidate = rounded_digits(digits, precision)
        var candidate_exponent = digits_exponent + candidate.length() - precision
        if candidate.length() > precision {
            candidate = candidate.slice(0, precision)
        }
        candidate = without_trailing_zeros(candidate)
        if is_fixed(candidate_exponent, precision) {
            var above_lower = compared(candidate, candidate_exponent, lower, lower_exponent)
            var below_upper = compared(upper, upper_exponent, candidate, candidate_exponent)
            if (above_lower > 0 or above_lower == 0 and even) and (below_upper > 0 or below_upper == 0 and even) {
                return fixed_text(candidate, candidate_exponent)
            }
        }
        precision = precision + 1
    }
    var fallback = rounded_digits(digits, most_digits)
    var fallback_exponent = digits_exponent + fallback.length() - most_digits
    if fallback.length() > most_digits {
        fallback = fallback.slice(0, most_digits)
    }
    fallback = without_trailing_zeros(fallback)
    if is_fixed(fallback_exponent, most_digits) {
        return fixed_text(fallback, fallback_exponent)
    }
    return scientific_text(fallback, fallback_exponent)
}

func bits_of(value: Double): Long {
    var address = memory.allocate_bytes(8)
    memory.write_double(address, 0, value)
    var bits = memory.read_long(address, 0)
    memory.free(address)
    return bits
}

func exact_digits(multiplier: Long, exponent: Long): String {
    var twos: Long = 0
    var fives: Long = 0
    if exponent > 0 {
        twos = exponent
    } else {
        fives = -exponent
    }
    var capacity = (twos / 3 + fives * 3 / 4 + 20) / 9 + 2
    var limbs = memory.allocate_bytes(capacity * 8)
    var count: Long = 0
    var rest = multiplier
    while rest > 0 {
        memory.write_long(limbs, count * 8, rest % 1000000000)
        rest = rest / 1000000000
        count = count + 1
    }
    while twos > 0 {
        var step = twos
        if step > 30 {
            step = 30
        }
        var power_of_two = power(2, step)
        count = multiplied(limbs, count, power_of_two)
        twos = twos - step
    }
    while fives > 0 {
        var step = fives
        if step > 13 {
            step = 13
        }
        var power_of_five = power(5, step)
        count = multiplied(limbs, count, power_of_five)
        fives = fives - step
    }
    var size = count * 9
    var address = memory.allocate_bytes(size)
    var limb_index: Long = 0
    while limb_index < count {
        var limb = memory.read_long(limbs, limb_index * 8)
        var position = size - limb_index * 9
        var place = 0
        while place < 9 {
            position = position - 1
            memory.write_byte(address, position, 48 + limb % 10)
            limb = limb / 10
            place = place + 1
        }
        limb_index = limb_index + 1
    }
    memory.free(limbs)
    var start: Long = 0
    while memory.read_byte(address, start) == 48 {
        start = start + 1
    }
    var text = memory.text(address + start, size - start)
    memory.free(address)
    return text
}

func multiplied(limbs: Long, count: Long, factor: Long): Long {
    var carry: Long = 0
    var index: Long = 0
    while index < count {
        var product = memory.read_long(limbs, index * 8) * factor + carry
        memory.write_long(limbs, index * 8, product % 1000000000)
        carry = product / 1000000000
        index = index + 1
    }
    var grown = count
    while carry > 0 {
        memory.write_long(limbs, grown * 8, carry % 1000000000)
        carry = carry / 1000000000
        grown = grown + 1
    }
    return grown
}

func power(base: Long, times: Long): Long {
    var result: Long = 1
    var remaining = times
    while remaining > 0 {
        result = result * base
        remaining = remaining - 1
    }
    return result
}

func decimal_exponent(digits: String, exponent: Long): Long {
    if exponent > 0 {
        return digits.length() - 1
    }
    return exponent + digits.length() - 1
}

func rounded_digits(digits: String, count: Long): String {
    if digits.length() <= count {
        return digits
    }
    var address = memory.allocate_bytes(count + 1)
    memory.write_byte(address, 0, 48)
    var index: Long = 0
    while index < count {
        var digit_code = digits.code_at(index)
        memory.write_byte(address, index + 1, digit_code)
        index = index + 1
    }
    if rounds_up(digits, count) {
        var position = count
        while memory.read_byte(address, position) == 57 {
            memory.write_byte(address, position, 48)
            position = position - 1
        }
        var digit_byte = memory.read_byte(address, position)
        memory.write_byte(address, position, digit_byte + 1)
    }
    var start: Long = 1
    if memory.read_byte(address, 0) != 48 {
        start = 0
    }
    var text = memory.text(address + start, count + 1 - start)
    memory.free(address)
    return text
}

func rounds_up(digits: String, count: Long): Bool {
    var next = digits.code_at(count)
    if next != 53 {
        return next > 53
    }
    var index = count + 1
    while index < digits.length() {
        if digits.code_at(index) != 48 {
            return true
        }
        index = index + 1
    }
    return digits.code_at(count - 1) % 2 == 1
}

func without_trailing_zeros(digits: String): String {
    var end = digits.length()
    while end > 1 and digits.code_at(end - 1) == 48 {
        end = end - 1
    }
    return digits.slice(0, end)
}

func is_fixed(exponent: Long, precision: Long): Bool {
    return exponent >= -4 and exponent < precision
}

func compared(left: String, left_exponent: Long, right: String, right_exponent: Long): Long {
    if left_exponent != right_exponent {
        if left_exponent > right_exponent {
            return 1
        }
        return -1
    }
    var index = 0
    while index < left.length() or index < right.length() {
        var left_code = digit_code(left, index)
        var right_code = digit_code(right, index)
        if left_code != right_code {
            if left_code > right_code {
                return 1
            }
            return -1
        }
        index = index + 1
    }
    return 0
}

func digit_code(digits: String, index: Long): Long {
    if index < digits.length() {
        return digits.code_at(index)
    }
    return 48
}

func zeros(count: Long): String {
    var text = ""
    var index: Long = 0
    while index < count {
        text = "{text}0"
        index = index + 1
    }
    return text
}

func fixed_text(digits: String, exponent: Long): String {
    if exponent < 0 {
        return "0.{zeros(-exponent - 1)}{digits}"
    }
    if digits.length() <= exponent + 1 {
        var digits_length = digits.length()
        return "{digits}{zeros(exponent + 1 - digits_length)}"
    }
    var digits_length = digits.length()
    return "{digits.slice(0, exponent + 1)}.{digits.slice(exponent + 1, digits_length)}"
}

func scientific_text(digits: String, exponent: Long): String {
    var mantissa = digits.slice(0, 1)
    if digits.length() > 1 {
        var digits_length = digits.length()
        mantissa = "{mantissa}.{digits.slice(1, digits_length)}"
    }
    var sign = "+"
    var magnitude = exponent
    if exponent < 0 {
        sign = "-"
        magnitude = -exponent
    }
    var padding = ""
    if magnitude < 10 {
        padding = "0"
    }
    return "{mantissa}e{sign}{padding}{magnitude}"
}

func is_singleton(): Bool {
    return true
}
