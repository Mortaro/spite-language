singleton

func compress(bytes: Buffer): Buffer {
    var deflate = Deflate()
    var body = deflate.compress(bytes)
    var output = Buffer()
    var body_count = body.count()
    output.reserve(body_count + 6)
    output.append(120)
    output.append(156)
    output.append_bytes(body, 0, body_count)
    var checksum = _adler32(bytes)
    _append_big_endian(output, checksum)
    return output
}

func decompress(bytes: Buffer): Buffer? {
    var total = bytes.count()
    assert total >= 6
    var method: Integer = _byte(bytes, 0)
    var flags: Integer = _byte(bytes, 1)
    assert method.bits_and(15) == 8
    assert method.shifted_right(4) <= 7
    assert (method * 256 + flags) % 31 == 0
    assert flags.bits_and(32) == 0
    var body = bytes.read_bytes_at(2, total - 6)
    crash body
    var deflate = Deflate()
    var output = deflate.decompress(body)
    assert output
    var expected = _read_big_endian(bytes, total - 4)
    var computed = _adler32(output)
    assert expected == computed
    return output
}

func _byte(bytes: Buffer, index: Integer): Byte {
    var value = bytes[index]
    crash value
    return value
}

func _adler32(bytes: Buffer): UnsignedInteger {
    var low: UnsignedInteger = 1
    var high: UnsignedInteger = 0
    var total = bytes.count()
    var index = 0
    while index < total {
        var chunk_limit = index + 5552
        var chunk_end = chunk_limit.minimum(total)
        while index < chunk_end {
            var value: UnsignedInteger = _byte(bytes, index)
            low = low + value
            high = high + low
            index = index + 1
        }
        low = low % 65521
        high = high % 65521
    }
    return high.shifted_left(16).bits_or(low)
}

func _read_big_endian(bytes: Buffer, at: Integer): UnsignedInteger {
    var value: UnsignedInteger = 0
    var index = 0
    while index < 4 {
        var part: UnsignedInteger = _byte(bytes, at + index)
        value = value.shifted_left(8).bits_or(part)
        index = index + 1
    }
    return value
}

func _append_big_endian(output: Buffer, value: UnsignedInteger) {
    var shift = 24
    while shift >= 0 {
        var part: Byte = value.shifted_right(shift).bits_and(255)
        output.append(part)
        shift = shift - 8
    }
}
