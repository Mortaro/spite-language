var _time_text = TimeText()
var _hour = 0
var _minute = 0
var _second = 0
var _nanosecond = 0

func Time(hour: Integer, minute: Integer, second: Integer, nanosecond: Integer) {
    crash hour >= 0 and hour <= 23
    crash minute >= 0 and minute <= 59
    crash second >= 0 and second <= 59
    crash nanosecond >= 0 and nanosecond <= 999999999
    _hour = hour
    _minute = minute
    _second = second
    _nanosecond = nanosecond
}

func get_hour(): Integer {
    return _hour
}

func get_minute(): Integer {
    return _minute
}

func get_second(): Integer {
    return _second
}

func get_nanosecond(): Integer {
    return _nanosecond
}

func get_second_of_day(): Integer {
    return _hour * 3600 + _minute * 60 + _second
}

func equals(other: Time): Boolean {
    return get_second_of_day() == other.second_of_day and _nanosecond == other._nanosecond
}

func less_than(other: Time): Boolean {
    var second_of_day = get_second_of_day()
    if second_of_day != other.second_of_day {
        return second_of_day < other.second_of_day
    }
    return _nanosecond < other._nanosecond
}

func greater_than(other: Time): Boolean {
    return other < this
}

func to_string(): String {
    var hour = _time_text.write_digits(_hour, 2)
    var minute = _time_text.write_digits(_minute, 2)
    var second = _time_text.write_digits(_second, 2)
    var fraction = _time_text.write_fraction(_nanosecond)
    return "{hour}:{minute}:{second}{fraction}"
}
