generic $element_type

var heap = Memory.Heap()
var inline = InlineMemory<$element_type>()
var references = TypedMemory<$element_type>()
var items: Memory.Address = 0
var item_count = 0
var capacity = 0

func count(): Integer {
    return item_count
}

func is_empty(): Boolean {
    return item_count == 0
}

func append(value: $element_type) {
    _make_room()
    if $element_type.fits_vector() {
        inline.write_item(items, item_count, value)
    } else {
        references.write_value(items, item_count, value)
    }
    item_count = item_count + 1
}

func get_at(index: Integer): $element_type? {
    assert index >= 0 and index < item_count
    if $element_type.fits_vector() {
        return inline.item_at(items, index)
    }
    return references.read_value(items, index)
}

func set_at(index: Integer, value: $element_type) {
    if index < 0 or index >= item_count {
        _out_of_range(index)
    }
    if $element_type.fits_vector() {
        inline.release_item(items, index)
        inline.write_item(items, index, value)
    } else {
        references.release_value(items, index)
        references.write_value(items, index, value)
    }
}

func remove_at(index: Integer) {
    crash index >= 0 and index < item_count
    _release(index)
    var bytes = _item_bytes()
    var start = items + _item_start()
    (start + bytes * (index + 1)).copy_to(start + bytes * index, bytes * (item_count - index - 1))
    item_count = item_count - 1
}

func remove_swapping(index: Integer) {
    crash index >= 0 and index < item_count
    _release(index)
    var last = item_count - 1
    if index != last {
        var bytes = _item_bytes()
        var start = items + _item_start()
        (start + bytes * last).copy_to(start + bytes * index, bytes)
    }
    item_count = last
}

func truncate(kept_count: Integer) {
    if kept_count >= 0 and kept_count < item_count {
        var index = kept_count
        while index < item_count {
            _release(index)
            index = index + 1
        }
        item_count = kept_count
    }
}

func swap(first_index: Integer, second_index: Integer) {
    var first_in = first_index >= 0 and first_index < item_count
    if first_in and second_index >= 0 and second_index < item_count {
        _swap(first_index, second_index)
    }
}

func clear() {
    var index = 0
    while index < item_count {
        _release(index)
        index = index + 1
    }
    item_count = 0
}

func copy(): Items<$element_type> {
    var copied = Items<$element_type>()
    copied._reserve_exactly(item_count)
    var index = 0
    while index < item_count {
        copied._append_copy(items, index)
        index = index + 1
    }
    return copied
}

func deep_copy(): Items<$element_type> {
    if $element_type.fits_vector() {
        return copy()
    }
    var copied = Items<$element_type>()
    copied._reserve_exactly(item_count)
    var index = 0
    while index < item_count {
        var item = references.read_value(items, index)
        var item_copy = item.deep_copy()
        copied.append(item_copy)
        index = index + 1
    }
    return copied
}

func _append_copy(source: Memory.Address, index: Integer) {
    if $element_type.fits_vector() {
        _make_room()
        inline.copy_item(source, index, items, item_count)
        item_count = item_count + 1
    } else {
        var item = references.read_value(source, index)
        append(item)
    }
}

func filter_member(member: Spite.AttributeDeclaration<$element_type>): Items<$element_type> {
    var filtered = Items<$element_type>()
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            if item.attributes[member] {
                filtered._append_copy(items, index)
            }
        } else {
            var item = references.read_value(items, index)
            if item.attributes[member] {
                filtered.append(item)
            }
        }
        index = index + 1
    }
    return filtered
}

func remove_where_member(member: Spite.AttributeDeclaration<$element_type>) {
    var kept = 0
    var index = 0
    while index < item_count {
        var keep = true
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            if item.attributes[member] {
                keep = false
            }
        } else {
            var item = references.read_value(items, index)
            if item.attributes[member] {
                keep = false
            }
        }
        if keep {
            if kept != index and index < item_count {
                _swap(kept, index)
            }
            kept = kept + 1
        }
        index = index + 1
    }
    truncate(kept)
}

func count_member(member: Spite.AttributeDeclaration<$element_type>): Integer {
    var counted = 0
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            if item.attributes[member] {
                counted = counted + 1
            }
        } else {
            var item = references.read_value(items, index)
            if item.attributes[member] {
                counted = counted + 1
            }
        }
        index = index + 1
    }
    return counted
}

func any_member(member: Spite.AttributeDeclaration<$element_type>): Boolean {
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            if item.attributes[member] {
                return true
            }
        } else {
            var item = references.read_value(items, index)
            if item.attributes[member] {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func all_member(member: Spite.AttributeDeclaration<$element_type>): Boolean {
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            assert item.attributes[member]
        } else {
            var item = references.read_value(items, index)
            assert item.attributes[member]
        }
        index = index + 1
    }
    return true
}

func sum_member(member: Spite.AttributeDeclaration<$element_type>): member.class {
    var total: member.class = 0
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            total = total + item.attributes[member]
        } else {
            var item = references.read_value(items, index)
            total = total + item.attributes[member]
        }
        index = index + 1
    }
    return total
}

func each_member(member: Spite.AttributeDeclaration<$element_type>) {
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            item.attributes[member]
        } else {
            var item = references.read_value(items, index)
            item.attributes[member]
        }
        index = index + 1
    }
}

func map_members(member: Spite.AttributeDeclaration<$element_type>): List<member.class> {
    var mapped = List<member.class>()
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            var value = item.attributes[member]
            mapped.append(value)
        } else {
            var item = references.read_value(items, index)
            var value = item.attributes[member]
            mapped.append(value)
        }
        index = index + 1
    }
    return mapped
}

func find_by_member(member: Spite.AttributeDeclaration<$element_type>, value: member.class): $element_type? {
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            if item.attributes[member] == value {
                return inline.item_at(items, index)
            }
        } else {
            var item = references.read_value(items, index)
            if item.attributes[member] == value {
                return item
            }
        }
        index = index + 1
    }
    return null
}

func sort_by_member(member: Spite.AttributeDeclaration<$element_type>): Items<$element_type> {
    var keys = List<member.class>()
    var order = List<Integer>()
    var index = 0
    while index < item_count {
        if $element_type.fits_vector() {
            var item = inline.item_at(items, index)
            var key = item.attributes[member]
            keys.append(key)
        } else {
            var item = references.read_value(items, index)
            var key = item.attributes[member]
            keys.append(key)
        }
        order.append(index)
        index = index + 1
    }
    var merged = order.copy()
    var width = 1
    while width < item_count {
        var start = 0
        while start < item_count {
            var middle = start + width
            if middle > item_count {
                middle = item_count
            }
            var end = middle + width
            if end > item_count {
                end = item_count
            }
            var left = start
            var right = middle
            var placed = start
            while placed < end {
                var takes_left = right >= end
                if left < middle and not takes_left {
                    crash order[left]
                    crash order[right]
                    var left_position = order[left]
                    var right_position = order[right]
                    crash keys[left_position]
                    crash keys[right_position]
                    var left_key = keys[left_position]
                    var right_key = keys[right_position]
                    var right_first = left_key > right_key
                    takes_left = not right_first
                }
                var taken = right
                if takes_left {
                    taken = left
                    left = left + 1
                } else {
                    right = right + 1
                }
                crash order[taken]
                var position = order[taken]
                merged[placed] = position
                placed = placed + 1
            }
            start = end
        }
        var previous = order
        order = merged
        merged = previous
        width = width * 2
    }
    var sorted = Items<$element_type>()
    sorted._reserve_exactly(item_count)
    index = 0
    while index < item_count {
        crash order[index]
        var source = order[index]
        sorted._append_copy(items, source)
        index = index + 1
    }
    return sorted
}

func drop() {
    clear()
    if items != 0 {
        memory.allocator.free(items)
    }
}

func _out_of_range(index: Integer) {
    crash index >= 0 and index < item_count
}

func _release(index: Integer) {
    if $element_type.fits_vector() {
        inline.release_item(items, index)
    } else {
        references.release_value(items, index)
    }
}

func _swap(first_index: Integer, second_index: Integer) {
    if $element_type.fits_vector() {
        inline.swap_items(items, first_index, second_index)
    } else {
        references.swap_values(items, first_index, second_index)
    }
}

func _item_bytes(): Long {
    if $element_type.fits_vector() {
        return inline.item_bytes()
    }
    return references.value_bytes()
}

func _item_start(): Long {
    if $element_type.fits_vector() {
        return inline.item_start()
    }
    return 0
}

func _block_bytes(wanted: Integer): Long {
    if $element_type.fits_vector() {
        return inline.block_bytes(wanted)
    }
    return references.value_bytes() * wanted
}

func _reserve_exactly(wanted: Integer) {
    if wanted > capacity {
        var old_bytes = _block_bytes(capacity)
        var bytes = _block_bytes(wanted)
        items = _resized(old_bytes, bytes)
        capacity = wanted
    }
}

func _make_room() {
    if item_count == capacity {
        var grown = capacity * 2
        if capacity == 0 {
            grown = 4
        }
        var old_bytes = _block_bytes(capacity)
        var bytes = _block_bytes(grown)
        items = _resized(old_bytes, bytes)
        capacity = grown
    }
}

func _resized(old_bytes: Long, new_bytes: Long): Memory.Address {
    if memory.allocator == Memory.Heap {
        return heap.resize(items, new_bytes)
    }
    var moved = memory.allocator.allocate(new_bytes)
    if items != 0 {
        items.copy_to(moved, old_bytes)
        memory.allocator.free(items)
    }
    return moved
}
