func read_bytes(wanted: Integer): Buffer? {
    var run = read_bytes_at(position, wanted)
    if run {
        position = position + wanted
    }
    return run
}

func read_bytes_at(at: Integer, wanted: Integer): Buffer? {
    crash wanted >= 0
    assert _inside(at, wanted)
    var run = Buffer(wanted)
    if wanted > 0 {
        var from: Memory.Address = items + at
        from.copy_to(run.items, wanted)
        run.item_count = wanted
    }
    return run
}

func append_bytes(other: Buffer, start: Integer, wanted: Integer) {
    crash start >= 0 and wanted >= 0 and start <= other.item_count - wanted
    if wanted > 0 {
        reserve(item_count + wanted)
        var from: Memory.Address = other.items + start
        from.copy_to(items + item_count, wanted)
        item_count = item_count + wanted
    }
}

func to_utf8_text(): String? {
    var index = 0
    while index < item_count {
        var sequence_length = _utf8_length_at(index)
        assert sequence_length != 0
        index = index + sequence_length
    }
    if item_count == 0 {
        return ""
    }
    return items.text(item_count)
}

func text(at: Integer, wanted: Integer): String? {
    assert at >= 0 and wanted >= 0 and at <= item_count - wanted
    var end = at + wanted
    var index = at
    while index < end {
        var sequence_length = _utf8_length_before(index, end)
        assert sequence_length != 0
        index = index + sequence_length
    }
    if wanted == 0 {
        return ""
    }
    var start: Memory.Address = items + at
    return start.text(wanted)
}

func _utf8_length_at(index: Integer): Integer {
    return _utf8_length_before(index, item_count)
}

func _utf8_length_before(index: Integer, limit: Integer): Integer {
    var lead: Integer = items.read_byte(index)
    var length = _utf8_length_of(lead)
    if length <= 1 {
        return length
    }
    if index + length > limit {
        return 0
    }
    var second: Integer = items.read_byte(index + 1)
    if second < _utf8_lowest_second(lead) or second > _utf8_highest_second(lead) {
        return 0
    }
    var place = 2
    while place < length {
        var following: Integer = items.read_byte(index + place)
        if following < 128 or following > 191 {
            return 0
        }
        place = place + 1
    }
    return length
}

func _utf8_length_of(lead: Integer): Integer {
    if lead < 128 {
        return 1
    }
    if lead >= 194 and lead <= 223 {
        return 2
    }
    if lead >= 224 and lead <= 239 {
        return 3
    }
    if lead >= 240 and lead <= 244 {
        return 4
    }
    return 0
}

func _utf8_lowest_second(lead: Integer): Integer {
    if lead == 224 {
        return 160
    }
    if lead == 240 {
        return 144
    }
    return 128
}

func _utf8_highest_second(lead: Integer): Integer {
    if lead == 237 {
        return 159
    }
    if lead == 244 {
        return 143
    }
    return 191
}

func _load_short(at: Integer, big: Boolean): Short {
    if big {
        return items.read_short_big_endian(at)
    }
    return items.read_short(at)
}

func _store_short(at: Integer, value: Short, big: Boolean) {
    if big {
        items.write_short_big_endian(at, value)
        return
    }
    items.write_short(at, value)
}

func _load_unsigned_short(at: Integer, big: Boolean): UnsignedShort {
    if big {
        return items.read_unsigned_short_big_endian(at)
    }
    return items.read_unsigned_short(at)
}

func _store_unsigned_short(at: Integer, value: UnsignedShort, big: Boolean) {
    if big {
        items.write_unsigned_short_big_endian(at, value)
        return
    }
    items.write_unsigned_short(at, value)
}

func _load_integer(at: Integer, big: Boolean): Integer {
    if big {
        return items.read_integer_big_endian(at)
    }
    return items.read_integer(at)
}

func _store_integer(at: Integer, value: Integer, big: Boolean) {
    if big {
        items.write_integer_big_endian(at, value)
        return
    }
    items.write_integer(at, value)
}

func _load_unsigned_integer(at: Integer, big: Boolean): UnsignedInteger {
    if big {
        return items.read_unsigned_integer_big_endian(at)
    }
    return items.read_unsigned_integer(at)
}

func _store_unsigned_integer(at: Integer, value: UnsignedInteger, big: Boolean) {
    if big {
        items.write_unsigned_integer_big_endian(at, value)
        return
    }
    items.write_unsigned_integer(at, value)
}

func _load_long(at: Integer, big: Boolean): Long {
    if big {
        return items.read_long_big_endian(at)
    }
    return items.read_long(at)
}

func _store_long(at: Integer, value: Long, big: Boolean) {
    if big {
        items.write_long_big_endian(at, value)
        return
    }
    items.write_long(at, value)
