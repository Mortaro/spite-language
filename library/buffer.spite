func append_unsigned_short_order(order: Spite.AttributeDeclaration<ByteOrder>, value: UnsignedShort) {
    reserve(item_count + 2)
    _store_unsigned_short(item_count, value, order.name == "big_endian")
    item_count = item_count + 2
}

func write_unsigned_short_order_at(order: Spite.AttributeDeclaration<ByteOrder>, at: Integer, value: UnsignedShort) {
    crash _inside(at, 2)
    _store_unsigned_short(at, value, order.name == "big_endian")
}

