enum ByteOrder {
    'little_endian'
    'big_endian'
}

var heap = Memory.Heap()
var items: Memory.Address = 0
var item_count = 0
var capacity = 0
var position = 0

func Buffer(size: Integer) {
    crash size >= 0
    reserve(size)
}

func count(): Integer {
    return item_count
}

func is_empty(): Boolean {
    return item_count == 0
}

func remaining(): Integer {
    return item_count - position
}

func get_at(index: Integer): Byte? {
    if index >= 0 and index < item_count {
        return items.read_byte(index)
    }
    return null
}

func set_at(index: Integer, value: Byte) {
    crash index >= 0 and index < item_count
    items.write_byte(index, value)
}

func append(value: Byte) {
    make_room()
    items.write_byte(item_count, value)
    item_count = item_count + 1
}

func truncate(kept_count: Integer) {
    if kept_count >= 0 and kept_count < item_count {
        item_count = kept_count
        if position > item_count {
            position = item_count
        }
    }
}

func clear() {
    item_count = 0
    position = 0
}

func reserve(wanted: Integer) {
    if wanted > capacity {
        var grown = capacity * 2
        if grown < wanted {
            grown = wanted
        }
        items = _resized(capacity, grown)
        capacity = grown
    }
}

func make_room() {
    if item_count == capacity {
        var grown = capacity * 2
        if capacity == 0 {
            grown = 4
        }
        items = _resized(capacity, grown)
        capacity = grown
    }
}

func _resized(old_count: Integer, new_count: Integer): Memory.Address {
    if memory.allocator == Memory.Heap {
        return heap.resize(items, new_count)
    }
    var moved = memory.allocator.allocate(new_count)
    if items != 0 and old_count > 0 {
        items.copy_to(moved, old_count)
        memory.allocator.free(items)
    }
    return moved
}

func drop() {
    clear()
    if items != 0 {
        memory.allocator.free(items)
        items = 0
        capacity = 0
    }
}

func copy(): Buffer {
    var copied = Buffer(item_count)
    if item_count > 0 {
        items.copy_to(copied.items, item_count)
        copied.item_count = item_count
    }
    return copied
}

func _inside(at: Integer, width: Integer): Boolean {
    return at >= 0 and at <= item_count - width
}

func read_byte(): Byte? {
    assert _inside(position, 1)
    var read = items.read_byte(position)
    position = position + 1
    return read
}

func read_tiny(): Tiny? {
    assert _inside(position, 1)
    var read = items.read_tiny(position)
    position = position + 1
    return read
}

func read_byte_at(at: Integer): Byte? {
    assert _inside(at, 1)
    return items.read_byte(at)
}

func read_tiny_at(at: Integer): Tiny? {
    assert _inside(at, 1)
    return items.read_tiny(at)
}

func append_tiny(value: Tiny) {
    reserve(item_count + 1)
    items.write_tiny(item_count, value)
    item_count = item_count + 1
}

func write_byte_at(at: Integer, value: Byte) {
    crash _inside(at, 1)
    items.write_byte(at, value)
}

func write_tiny_at(at: Integer, value: Tiny) {
    crash _inside(at, 1)
    items.write_tiny(at, value)
}

func read_short_order(order: Spite.AttributeDeclaration<ByteOrder>): Short? {
    assert _inside(position, 2)
    var read = _load_short(position, order.name == "big_endian")
    position = position + 2
    return read
}

func read_short_order_at(order: Spite.AttributeDeclaration<ByteOrder>, at: Integer): Short? {
    assert _inside(at, 2)
    return _load_short(at, order.name == "big_endian")
}

func append_short_order(order: Spite.AttributeDeclaration<ByteOrder>, value: Short) {
    reserve(item_count + 2)
    _store_short(item_count, value, order.name == "big_endian")
    item_count = item_count + 2
}

func write_short_order_at(order: Spite.AttributeDeclaration<ByteOrder>, at: Integer, value: Short) {
    crash _inside(at, 2)
    _store_short(at, value, order.name == "big_endian")
}

func read_unsigned_short_order(order: Spite.AttributeDeclaration<ByteOrder>): UnsignedShort? {
    assert _inside(position, 2)
    var read = _load_unsigned_short(position, order.name == "big_endian")
    position = position + 2
    return read
}

func read_unsigned_short_order_at(order: Spite.AttributeDeclaration<ByteOrder>, at: Integer): UnsignedShort? {
    assert _inside(at, 2)
    return _load_unsigned_short(at, order.name == "big_endian")
