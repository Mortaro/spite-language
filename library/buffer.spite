enum ByteOrder {
    'little_endian'
    'big_endian'
}

var heap = Memory.Heap()
var items: Memory.Address = 0
var item_count = 0
var capacity = 0
var byte_order: ByteOrder = 'little_endian'
var position = 0

func Buffer(...orders: List<ByteOrder>) {
    crash orders.count() <= 1
    if not orders.is_empty() {
        byte_order = orders[0]
    }
}

func count(): Integer {
    return item_count
}

func is_empty(): Boolean {
    return item_count == 0
}

func remaining(): Integer {
    return item_count - position
}

func get_at(index: Integer): Byte? {
    if index >= 0 and index < item_count {
        return items.read_byte(index)
    }
    return null
}

func set_at(index: Integer, value: Byte) {
    crash index >= 0 and index < item_count
    items.write_byte(index, value)
}

func append(value: Byte) {
    make_room()
    items.write_byte(item_count, value)
    item_count = item_count + 1
}

func truncate(kept_count: Integer) {
    if kept_count >= 0 and kept_count < item_count {
        item_count = kept_count
        if position > item_count {
            position = item_count
        }
    }
}

func clear() {
    item_count = 0
    position = 0
}

func reserve(wanted: Integer) {
    if wanted > capacity {
        var grown = capacity * 2
        if grown < wanted {
            grown = wanted
        }
        items = _resized(capacity, grown)
        capacity = grown
    }
}

func make_room() {
    if item_count == capacity {
        var grown = capacity * 2
        if capacity == 0 {
            grown = 4
        }
        items = _resized(capacity, grown)
        capacity = grown
    }
}

func _resized(old_count: Integer, new_count: Integer): Memory.Address {
    if memory.allocator == Memory.Heap {
        return heap.resize(items, new_count)
    }
    var moved = memory.allocator.allocate(new_count)
    if items != 0 and old_count > 0 {
        items.copy_to(moved, old_count)
        memory.allocator.free(items)
    }
    return moved
}

func drop() {
    clear()
    if items != 0 {
        memory.allocator.free(items)
        items = 0
        capacity = 0
    }
}

func copy(): Buffer {
    var copied = Buffer(byte_order)
    if item_count > 0 {
        copied.reserve(item_count)
        items.copy_to(copied.items, item_count)
        copied.item_count = item_count
    }
    return copied
}

func _inside(at: Integer, width: Integer): Boolean {
    return at >= 0 and at <= item_count - width
}

func read_byte(): Byte? {
    assert _inside(position, 1)
    var read = items.read_byte(position)
    position = position + 1
    return read
}

func read_tiny(): Tiny? {
    assert _inside(position, 1)
    var read = items.read_tiny(position)
    position = position + 1
    return read
}

func read_short(): Short? {
    assert _inside(position, 2)
    var read = _read_short(position)
    position = position + 2
    return read
}

func read_unsigned_short(): UnsignedShort? {
    assert _inside(position, 2)
    var read = items.read_unsigned_short(position)
    position = position + 2
    return read
}

func read_integer(): Integer? {
    assert _inside(position, 4)
    var read = items.read_integer(position)
    position = position + 4
    return read
}

func read_unsigned_integer(): UnsignedInteger? {
    assert _inside(position, 4)
    var read = items.read_unsigned_integer(position)
    position = position + 4
    return read
}

func read_long(): Long? {
    assert _inside(position, 8)
    var read = items.read_long(position)
    position = position + 8
    return read
}

func read_unsigned_long(): UnsignedLong? {
    assert _inside(position, 8)
    var read = items.read_unsigned_long(position)
    position = position + 8
    return read
}

func read_float(): Float? {
    assert _inside(position, 4)
    var read = _read_float(position)
    position = position + 4
    return read
}

func read_double(): Double? {
    assert _inside(position, 8)
    var read = _read_double(position)
    position = position + 8
    return read
}

func read_byte_at(at: Integer): Byte? {
    assert _inside(at, 1)
    return items.read_byte(at)
}

func read_tiny_at(at: Integer): Tiny? {
    assert _inside(at, 1)
    return items.read_tiny(at)
}

func read_short_at(at: Integer): Short? {
    assert _inside(at, 2)
    return _read_short(at)
}

func read_unsigned_short_at(at: Integer): UnsignedShort? {
    assert _inside(at, 2)
    return items.read_unsigned_short(at)
}

func read_integer_at(at: Integer): Integer? {
    assert _inside(at, 4)
    return items.read_integer(at)
}

func read_unsigned_integer_at(at: Integer): UnsignedInteger? {
    assert _inside(at, 4)
    return items.read_unsigned_integer(at)
}

func read_long_at(at: Integer): Long? {
    assert _inside(at, 8)
    return items.read_long(at)
}

func read_unsigned_long_at(at: Integer): UnsignedLong? {
    assert _inside(at, 8)
    return items.read_unsigned_long(at)
}

func read_float_at(at: Integer): Float? {
    assert _inside(at, 4)
    return _read_float(at)
}

func read_double_at(at: Integer): Double? {
    assert _inside(at, 8)
    return _read_double(at)
}

func append_tiny(value: Tiny) {
    reserve(item_count + 1)
    items.write_tiny(item_count, value)
    item_count = item_count + 1
}

func append_short(value: Short) {
    reserve(item_count + 2)
    _write_short(item_count, value)
    item_count = item_count + 2
}

func append_unsigned_short(value: UnsignedShort) {
    reserve(item_count + 2)
    items.write_unsigned_short(item_count, value)
    item_count = item_count + 2
}

func append_integer(value: Integer) {
    reserve(item_count + 4)
    items.write_integer(item_count, value)
    item_count = item_count + 4
}

func append_unsigned_integer(value: UnsignedInteger) {
    reserve(item_count + 4)
    items.write_unsigned_integer(item_count, value)
    item_count = item_count + 4
}

func append_long(value: Long) {
    reserve(item_count + 8)
    items.write_long(item_count, value)
    item_count = item_count + 8
}

func append_unsigned_long(value: UnsignedLong) {
    reserve(item_count + 8)
    items.write_unsigned_long(item_count, value)
    item_count = item_count + 8
}

func append_float(value: Float) {
    reserve(item_count + 4)
    _write_float(item_count, value)
    item_count = item_count + 4
}

func append_double(value: Double) {
    reserve(item_count + 8)
    _write_double(item_count, value)
    item_count = item_count + 8
}

func write_byte_at(at: Integer, value: Byte) {
    crash _inside(at, 1)
    items.write_byte(at, value)
}

func write_tiny_at(at: Integer, value: Tiny) {
    crash _inside(at, 1)
    items.write_tiny(at, value)
}

func write_short_at(at: Integer, value: Short) {
    crash _inside(at, 2)
    _write_short(at, value)
}

func write_unsigned_short_at(at: Integer, value: UnsignedShort) {
    crash _inside(at, 2)
    items.write_unsigned_short(at, value)
}

func write_integer_at(at: Integer, value: Integer) {
    crash _inside(at, 4)
    items.write_integer(at, value)
}

func write_unsigned_integer_at(at: Integer, value: UnsignedInteger) {
    crash _inside(at, 4)
    items.write_unsigned_integer(at, value)
}

func write_long_at(at: Integer, value: Long) {
    crash _inside(at, 8)
    items.write_long(at, value)
}

func write_unsigned_long_at(at: Integer, value: UnsignedLong) {
    crash _inside(at, 8)
    items.write_unsigned_long(at, value)
}

func write_float_at(at: Integer, value: Float) {
    crash _inside(at, 4)
    _write_float(at, value)
}

func write_double_at(at: Integer, value: Double) {
    crash _inside(at, 8)
    _write_double(at, value)
}

func read_bytes(wanted: Integer): Buffer? {
    var run = read_bytes_at(position, wanted)
    if run {
        position = position + wanted
    }
    return run
}

func read_bytes_at(at: Integer, wanted: Integer): Buffer? {
    crash wanted >= 0
    assert _inside(at, wanted)
    var run = Buffer(byte_order)
    if wanted > 0 {
        run.reserve(wanted)
        var from: Memory.Address = items + at
        from.copy_to(run.items, wanted)
        run.item_count = wanted
    }
    return run
}

func append_bytes(other: Buffer, start: Integer, wanted: Integer) {
    crash start >= 0 and wanted >= 0 and start <= other.item_count - wanted
    if wanted > 0 {
        reserve(item_count + wanted)
        var from: Memory.Address = other.items + start
        from.copy_to(items + item_count, wanted)
        item_count = item_count + wanted
    }
}

func to_utf8_text(): String? {
    var index = 0
    while index < item_count {
        var sequence_length = _utf8_length_at(index)
        assert sequence_length != 0
        index = index + sequence_length
    }
    if item_count == 0 {
        return ""
    }
    return items.text(item_count)
}

func _utf8_length_at(index: Integer): Integer {
    var lead: Integer = items.read_byte(index)
    var length = _utf8_length_of(lead)
    if length <= 1 {
        return length
    }
    if index + length > item_count {
        return 0
    }
    var second: Integer = items.read_byte(index + 1)
    if second < _utf8_lowest_second(lead) or second > _utf8_highest_second(lead) {
        return 0
    }
    var place = 2
    while place < length {
        var following: Integer = items.read_byte(index + place)
        if following < 128 or following > 191 {
            return 0
        }
        place = place + 1
    }
    return length
}

func _utf8_length_of(lead: Integer): Integer {
    if lead < 128 {
        return 1
    }
    if lead >= 194 and lead <= 223 {
        return 2
    }
    if lead >= 224 and lead <= 239 {
        return 3
    }
    if lead >= 240 and lead <= 244 {
        return 4
    }
    return 0
}

func _utf8_lowest_second(lead: Integer): Integer {
    if lead == 224 {
        return 160
    }
    if lead == 240 {
        return 144
    }
    return 128
}

func _utf8_highest_second(lead: Integer): Integer {
    if lead == 237 {
        return 159
    }
    if lead == 244 {
        return 143
    }
    return 191
}

func _read_short(at: Integer): Short {
    if byte_order == 'big_endian' {
        return items.read_short_big_endian(at)
    }
    return items.read_short(at)
}

func _write_short(at: Integer, value: Short) {
    if byte_order == 'big_endian' {
        items.write_short_big_endian(at, value)
        return
    }
    items.write_short(at, value)
}

func _read_float(at: Integer): Float {
    var pattern = _float_pattern(at)
    return pattern.bits_as_float()
}

func _write_float(at: Integer, value: Float) {
    var pattern = value.bits()
    if byte_order == 'big_endian' {
        items.write_unsigned_integer_big_endian(at, pattern)
        return
    }
    items.write_unsigned_integer(at, pattern)
}

func _read_double(at: Integer): Double {
    var pattern = _double_pattern(at)
    return pattern.bits_as_double()
}

func _write_double(at: Integer, value: Double) {
    var pattern = value.bits()
    if byte_order == 'big_endian' {
        items.write_unsigned_long_big_endian(at, pattern)
        return
    }
    items.write_unsigned_long(at, pattern)
}

func _float_pattern(at: Integer): UnsignedInteger {
    if byte_order == 'big_endian' {
        return items.read_unsigned_integer_big_endian(at)
    }
    return items.read_unsigned_integer(at)
}

func _double_pattern(at: Integer): Long {
    if byte_order == 'big_endian' {
        return items.read_unsigned_long_big_endian(at).bits_as_signed()
    }
    return items.read_long(at)
}
