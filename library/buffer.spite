}

func _store_unsigned_long(at: Integer, value: UnsignedLong, big: Boolean) {
    if big {
        items.write_unsigned_long_big_endian(at, value)
        return
    }
    items.write_unsigned_long(at, value)
}

func _load_float(at: Integer, big: Boolean): Float {
    if big {
        var pattern = items.read_unsigned_integer_big_endian(at)
        return pattern.bits_as_float()
    }
    return items.read_float(at)
}

func _store_float(at: Integer, value: Float, big: Boolean) {
    if big {
        var pattern = value.bits()
        items.write_unsigned_integer_big_endian(at, pattern)
        return
    }
    items.write_float(at, value)
}

func _load_double(at: Integer, big: Boolean): Double {
    if big {
        var pattern = items.read_unsigned_long_big_endian(at)
        return pattern.bits_as_double()
    }
    return items.read_double(at)
}

func _store_double(at: Integer, value: Double, big: Boolean) {
    if big {
        var pattern = value.bits()
        items.write_unsigned_long_big_endian(at, pattern)
        return
    }
    items.write_double(at, value)
}
