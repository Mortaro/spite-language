singleton

enum Stream {
    'output'
    'error'
}

type Printable {
    to_string(): String
}

type Debuggable {
    to_debug(): String
}

var heap = Memory.Heap()

func print(...values: List<Printable>) {
    _write_values(values, 'output')
    _write_output("\n")
    flush()
}

func write(...values: List<Printable>) {
    _write_values(values, 'output')
}

func error(...values: List<Printable>) {
    _write_values(values, 'error')
    _write_error("\n")
    flush()
}

func debug(...values: List<Debuggable>) {
    var index = 0
    while index < values.count() {
        if index > 0 {
            _write_output(" ")
        }
        var text = values[index].to_debug()
        _write_output(text)
        index = index + 1
    }
    _write_output("\n")
    flush()
}

func _write_values(values: List<Printable>, stream: Stream) {
    var index = 0
    while index < values.count() {
        if index > 0 {
            _write_to(" ", stream)
        }
        var text = values[index].to_string()
        _write_to(text, stream)
        index = index + 1
    }
}

func _write_to(text: String, stream: Stream) {
    if stream == 'error' {
        _write_error(text)
    } else {
        _write_output(text)
    }
}

func read_line(): String? {
    var buffer = heap.allocate(256)
    var line = ""
    var read_anything = false
    var more = read_line_into(buffer, 256)
    while more {
        read_anything = true
        var piece = buffer.terminated_text()
        if piece.ends_with("\n") {
            var piece_length = piece.length()
            line = "{line}{piece.slice(0, piece_length - 1)}"
            more = false
        } else {
            line = "{line}{piece}"
            more = read_line_into(buffer, 256)
        }
    }
    heap.free(buffer)
    assert read_anything
    if line.ends_with("\r") {
        var line_length = line.length()
        return line.slice(0, line_length - 1)
    }
    return line
}
