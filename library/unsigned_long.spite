var _memory = Memory.Bytes(8)

func to_string(): String {
    if this == 0 {
        return "0"
    }
    var heap = Memory.Heap()
    var buffer_bytes: Long = 24
    var address = heap.allocate(buffer_bytes)
    var position = buffer_bytes
    var rest = this
    while rest != 0 {
        position = position - 1
        address.write_byte(position, rest % 10 + 48)
        rest = rest / 10
    }
    var first_digit: Memory.Address = address + position
    var text = first_digit.text(buffer_bytes - position)
    heap.free(address)
    return text
}
