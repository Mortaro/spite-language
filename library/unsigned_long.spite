var memory = Memory()
var _memory = memory.allocate_bytes(8)

func to_string(): String {
    if this == 0 {
        return "0"
    }
    var memory = Memory()
    var buffer_bytes: Long = 24
    var address = memory.allocate_bytes(buffer_bytes)
    var position = buffer_bytes
    var rest = this
    while rest != 0 {
        position = position - 1
        memory.write_byte(address, position, rest % 10 + 48)
        rest = rest / 10
    }
    var text = memory.text(address + position, buffer_bytes - position)
    memory.free(address)
    return text
}
