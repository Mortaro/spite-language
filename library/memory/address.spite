var heap = Memory.Heap()
var _memory = heap.allocate(8)

func text(length: Long): String

func terminated_text(): String {
    var length: Long = 0
    while read_byte(length) != 0 {
        length = length + 1
    }
    return text(length)
}

func to_string(): String {
    var number: Long = this
    return number.to_string()
}
