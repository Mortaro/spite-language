singleton

var heap = Memory.Heap()
var workers: Memory.Address = 0
var worker_count = 0
var worker_threads: Memory.Address = 0
var registered = 0
var jobs = List<ThreadPoolJob>()
var queue_lock: Long = 0
var work_ready: Long = 0
var work_done: Long = 0
var stopping = false

func size(): Integer {
    start()
    return worker_count
}

func worker_index(): Integer {
    if worker_count == 0 {
        return -1
    }
    var current = current_thread()
    lock_queue()
    var index = registered - 1
    while index >= 0 and worker_threads.read_long(index * 8) != current {
        index = index - 1
    }
    unlock_queue()
    return index
}

func submit(job: Spite.Function<Integer, Integer, Nothing>, first: Integer, end: Integer, state: Memory.Address) {
    start()
    state.write_long_atomically(0, 0)
    var queued = ThreadPoolJob()
    queued.work = job
    queued.first = first
    queued.end = end
    queued.state = state
    _task_begun()
    lock_queue()
    jobs.append(queued)
    signal_one(work_ready)
    unlock_queue()
}

func is_done(state: Memory.Address): Boolean {
    return state.read_long_atomically(0) == 2
}

func join(state: Memory.Address) {
    lock_queue()
    var position = jobs.count() - 1
    while position >= 0 and position < jobs.count() and jobs[position].state != state {
        position = position - 1
    }
    if position >= 0 {
        run_queued(position)
    }
    while not is_done(state) {
        wait_for_signal(work_done)
    }
    unlock_queue()
}

func run_pieces(piece: Spite.Function<Integer, Integer, Nothing>, count: Integer) {
    var pieces = (size() + 1) * 4
    if pieces > count {
        pieces = count
    }
    if pieces < 2 {
        piece(0, count)
        return
    }
    var block = heap.allocate(pieces * 8)
    var base = count / pieces
    var extra = count % pieces
    var index = 1
    while index < pieces {
        var first = piece_start(index, base, extra)
        var end = piece_start(index + 1, base, extra)
        submit(piece, first, end, block + index * 8)
        index = index + 1
    }
    var first_end = piece_start(1, base, extra)
    piece(0, first_end)
    index = 1
    while index < pieces {
        join(block + index * 8)
        index = index + 1
    }
    heap.free(block)
}

func piece_start(index: Integer, base: Integer, extra: Integer): Integer {
    if index < extra {
        return index * base + index
    }
    return index * base + extra
}

func start() {
    if worker_count == 0 {
        queue_lock = create_lock()
        work_ready = create_condition()
        work_done = create_condition()
        var wanted = processor_count() - 1
        if wanted < 1 {
            wanted = 1
        }
        workers = heap.allocate(wanted * 8)
        worker_threads = heap.allocate(wanted * 8)
        var entry = entry_address()
        var pool = address()
        var index = 0
        while index < wanted {
            var thread = start_thread(entry, pool)
            crash thread != 0
            workers.write_long(index * 8, thread)
            index = index + 1
        }
        worker_count = wanted
    }
}

func _serve() {
    var thread = current_thread()
    lock_queue()
    worker_threads.write_long(registered * 8, thread)
    registered = registered + 1
    while not stopping or not jobs.is_empty() {
        if jobs.is_empty() {
            wait_for_signal(work_ready)
        } else {
            run_queued(0)
        }
    }
    unlock_queue()
}

func run_queued(position: Integer) {
    crash jobs[position]
    var job = jobs[position]
    jobs.remove_at(position)
    job.state.write_long_atomically(0, 1)
    unlock_queue()
    crash job.work
    _world_enter()
    job.work.call_function(job.first, job.end)
    _world_leave()
    _task_ended()
    lock_queue()
    job.state.write_long_atomically(0, 2)
    signal_all(work_done)
}

func drop() {
    if worker_count > 0 {
        lock_queue()
        stopping = true
        signal_all(work_ready)
        unlock_queue()
        var index = 0
        while index < worker_count {
            var worker = workers.read_long(index * 8)
            join_thread(worker)
            index = index + 1
        }
        heap.free(workers)
        heap.free(worker_threads)
        destroy_condition(work_ready)
        destroy_condition(work_done)
        destroy_lock(queue_lock)
    }
}

func run_marked(piece: Spite.Function<Integer, Integer, Nothing>, count: Integer, marks: Memory.Address) {
    var last = count - 1
    while last >= 0 and marks.read_long(last * 8) == 0 {
        last = last - 1
    }
    var block = heap.allocate(count * 8)
    var index = 0
    while index < count {
        if index != last and marks.read_long(index * 8) != 0 {
            submit(piece, index, index + 1, block + index * 8)
        } else {
            piece(index, index + 1)
        }
        index = index + 1
    }
    index = 0
    while index < count {
        if index != last and marks.read_long(index * 8) != 0 {
            join(block + index * 8)
        }
        index = index + 1
    }
    heap.free(block)
}

func run_bands(piece: Spite.Function<Integer, Integer, Nothing>, count: Integer) {
    var bands = size() + 1
    if bands > count {
        bands = count
    }
    if bands < 2 {
        piece(0, count)
        return
    }
    var block = heap.allocate(bands * 8)
    var base = count / bands
    var extra = count % bands
    var index = 1
    while index < bands {
        var first = piece_start(index, base, extra)
        var end = piece_start(index + 1, base, extra)
        submit(piece, first, end, block + index * 8)
        index = index + 1
    }
    var first_end = piece_start(1, base, extra)
    piece(0, first_end)
    index = 1
    while index < bands {
        join(block + index * 8)
        index = index + 1
    }
    heap.free(block)
}
